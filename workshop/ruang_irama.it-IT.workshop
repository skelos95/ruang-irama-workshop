		Count Of(Filtered Array(All Giocatori(All Squadre), And(Attuale Array Element != Event Giocatore, And(Giocatore Variable(Attuale Array Element, Manusia) == True, Giocatore Variable(Attuale Array Element, PrivasiNasibAktif) == True)))) > 0;
	}

	azioni
	{
		Create In-World Text(Filtered Array(All Giocatori(All Squadre), And(Attuale Array Element != Event Giocatore, And(Giocatore Variable(Attuale Array Element, Manusia) == True, Giocatore Variable(Attuale Array Element, PrivasiNasibAktif) == True))), Custom String("{0}", Event Giocatore), Eye Posizione(Event Giocatore) + Vector(0, 0.450, 0), 1.100, Do Not Clip, Visibile a Posizione  String and Color, Event Giocatore.Manusia == True ? Event Giocatore.WarnaNama : Color(Orange), Visibile Mai);
		Event Giocatore.TeksVisiNasib = Last Text ID;
	}
