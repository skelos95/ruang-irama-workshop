regola("99n - Subrutin: Terapkan halaman Mode Hantu / Terbang")
{
	evento
	{
		Subroutine;
		TerapkanHalamanHantuTerbang;
	}

	azioni
	{
		If((Globale.PemainPemicu.KursorHantuTerbang == 0));
		Globale.PemainPemicu.ModeHantuAktif = Not(Globale.PemainPemicu.ModeHantuAktif);
		Else;
		Globale.PemainPemicu.ModeTerbangAktif = Not(Globale.PemainPemicu.ModeTerbangAktif);
		End;
		Globale.PemainPemicu.FisikaHantuTerbangDiterapkan = False;
		Call Subroutine(TerapkanFisikaHantuTerbang);
	}
}

regola("99o - Subrutin: Terapkan fisika Mode Hantu / Terbang")
{
	evento
	{
		Subroutine;
		TerapkanFisikaHantuTerbang;
	}

	azioni
	{
		If(Globale.PemainPemicu.ModeHantuAktif);
		Disable Movement Collision With Environment(Globale.PemainPemicu, False);
		Else;
		Enable Movement Collision With Environment(Globale.PemainPemicu);
		End;
		Globale.PemainPemicu.WaktuMulaiTerbangMaju = -1;
		Stop Transforming Throttle(Globale.PemainPemicu);
		If(Globale.PemainPemicu.ModeTerbangAktif);
		If(Or((Globale.PemainPemicu.EfekNasib != 2), (Globale.PemainPemicu.EfekNasibBerakhir <= Total Time Elapsed)));
		Set Move Speed(Globale.PemainPemicu, 0);
		End;
		Set Gravity(Globale.PemainPemicu, 0);
		Else;
		If(Or((Globale.PemainPemicu.EfekNasib != 2), (Globale.PemainPemicu.EfekNasibBerakhir <= Total Time Elapsed)));
		Set Move Speed(Globale.PemainPemicu, 100);
		If((Magnitude Of(Velocity Of(Globale.PemainPemicu)) > 0.010));
		Apply Impulse(Globale.PemainPemicu, (Velocity Of(Globale.PemainPemicu) * -1), Magnitude Of(Velocity Of(Globale.PemainPemicu)), To World, Incorporate Contrary Motion);
		End;
		End;
		Set Gravity(Globale.PemainPemicu, 100);
		End;
		Globale.PemainPemicu.FisikaHantuTerbangDiterapkan = True;
	}
}

regola("11 - Menu: Isi ulang kembali dari submenu ke menu utama")
{
	evento
	{
		Subroutine;
		Pengatur11;
	}

	azioni
	{
		If(Not(And(Is Alive(Globale.PemainPemicu), And(Globale.PemainPemicu.MenuTerbuka, And((Globale.PemainPemicu.HalamanMenu != -1), (Globale.PemainPemicu.PerintahMenu == 2))))));
		Globale.PemainPemicu.StatusPengatur[16] = 0;
		Abort;
		End;
		Abort If((Globale.PemainPemicu.StatusPengatur[16] == 1));
		Globale.PemainPemicu.StatusPengatur[16] = 1;
		Globale.PemainPemicu.HalamanMenu = -1;
		Call Subroutine(GambarMenu);
	}
}

regola("12c - Kamera: Tahan Interaksi setengah detik untuk beralih")
{
	evento
	{
		Subroutine;
		Pengatur12c;
	}

	azioni
	{
		If(Not(And(Has Spawned(Globale.PemainPemicu), And(Is Alive(Globale.PemainPemicu), And(Not(Globale.PemainPemicu.InteraksiKameraDipakai), And(Not(Is Button Held(Globale.PemainPemicu, Button(Crouch))), Is Button Held(Globale.PemainPemicu, Button(Interact))))))));
		Globale.PemainPemicu.WaktuPengatur[17] = 0;
		Abort;
		End;
		If((Globale.PemainPemicu.WaktuPengatur[17] == 0));
		Globale.PemainPemicu.WaktuPengatur[17] = (Total Time Elapsed + 0.500);
		Abort;
		End;
		Abort If((Total Time Elapsed < Globale.PemainPemicu.WaktuPengatur[17]));
		Globale.PemainPemicu.WaktuPengatur[17] = 0;
		Globale.PemainPemicu.InteraksiKameraDipakai = True;
		If((Globale.PemainPemicu.ModeKamera == 0));
		Globale.PemainPemicu.TargetKamera = Globale.PemainPemicu;
		Globale.PemainPemicu.ModeKamera = 1;
		Call Subroutine(MulaiKamera);
		Else;
		Stop Camera(Globale.PemainPemicu);
		Globale.PemainPemicu.ModeKamera = 0;
		Globale.PemainPemicu.TargetKamera = Null;
		End;
	}
}

