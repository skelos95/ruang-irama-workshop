		Disable Built-In Game Mode Announcer;
		Disable Built-In Game Mode Music;
		Disable Inspector Recording;
		Create HUD Text(Globale.PemainManusia, Null, Null, Custom String("COZYWATCH [{0}]", Globale.TeksWaktuServer), Top, 0, Color(Bianco), Color(Bianco), Globale.RGB, Visible To String and Color, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null, ((Player Variable(Local Player, IndeksBahasa) == 0) ? Custom String("LOCATION: {0}", Globale.NamaLokasiInggris[Globale.IndeksLokasiServer]) : ((Player Variable(Local Player, IndeksBahasa) == 1) ? Custom String("LOKASI SERVER: {0}", Globale.NamaLokasiIndonesia[Globale.IndeksLokasiServer]) : Custom String("ที่ตั้งเซิร์ฟเวอร์: {0}", Globale.NamaLokasiThai[Globale.IndeksLokasiServer]))), Null, Top, 1, Color(Bianco), Custom Color(255, 205, 110, 255), Globale.RGB, Visible To String and Color, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null, Null, Custom String("  "), Top, 2, Color(Bianco), Color(Bianco), Globale.RGB, Visible To String and Color, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null, ((Player Variable(Local Player, IndeksBahasa) == 0) ? Custom String("Hold {0}: hero + HP", Input Binding String(Button(Crouch))) : ((Player Variable(Local Player, IndeksBahasa) == 1) ? Custom String("Tahan {0}: cek pahlawan + HP", Input Binding String(Button(Crouch))) : Custom String("กด {0} ค้าง: ดูฮีโร่ + HP", Input Binding String(Button(Crouch))))), Null, Left, -2, Color(Bianco), Custom Color(185, 225, 255, 255), Custom Color(70, 225, 255, 255), Visible To and String, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null, Custom String(" "), Null, Left, -1, Color(Bianco), Custom Color(185, 225, 255, 255), Custom Color(70, 225, 255, 255), Visible To and String, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null, ((Globale.NamaPemimpinPilihan != Custom String("")) ? ((Player Variable(Local Player, IndeksBahasa) == 0) ? Custom String("\nCHILL STAR: {0}", Globale.NamaPemimpinPilihan) : ((Player Variable(Local Player, IndeksBahasa) == 1) ? Custom String("\nBINTANG CHILL: {0}", Globale.NamaPemimpinPilihan) : Custom String("\nดาวสายชิล: {0}", Globale.NamaPemimpinPilihan))) : Custom String("")), Null, Left, 13, Color(Bianco), Globale.WarnaPemimpinPilihan, Color(Bianco), Visible To String and Color, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null, ((Player Variable(Local Player, IndeksBahasa) == 0) ? Custom String("Hold {0} 0.5s: Arcade | Hold {1} 0.5s: Camera", Input Binding String(Button(Melee)), Input Binding String(Button(Interact))) : ((Player Variable(Local Player, IndeksBahasa) == 1) ? Custom String("Tahan {0} 0,5 dtk: Menu | Tahan {1} 0,5 dtk: Kamera", Input Binding String(Button(Melee)), Input Binding String(Button(Interact))) : Custom String("กด {0} ค้าง 0.5 วิ: เมนูอาร์เคด | กด {1} ค้าง 0.5 วิ: กล้อง", Input Binding String(Button(Melee)), Input Binding String(Button(Interact))))), Null, Right, -16, Color(Bianco), Custom Color(235, 195, 255, 255), Custom Color(210, 110, 255, 255), Visible To and String, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null, Null, ((Player Variable(Local Player, IndeksBahasa) == 0) ? Custom String("PLAYER VIBES") : ((Player Variable(Local Player, IndeksBahasa) == 1) ? Custom String("MUSIK PEMAIN") : Custom String("เพลงของผู้เล่น"))), Left, 0, Color(Bianco), Custom Color(235, 195, 255, 255), Custom Color(210, 110, 255, 255), Visible To and String, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null, Null, (Entity Exists(Host Player) ? Custom String(" \n{0} {1} {2}\n ", ((Player Variable(Local Player, IndeksBahasa) == 0) ? Custom String("Host:") : ((Player Variable(Local Player, IndeksBahasa) == 1) ? Custom String("Host:") : Custom String("โฮสต์:"))), Hero Icon String(Hero Of(Host Player)), (And((Player Variable(Host Player, NamaTampilan) != Null), (Player Variable(Host Player, NamaTampilan) != Custom String(""))) ? Player Variable(Host Player, NamaTampilan) : Custom String("{0}", Host Player))) : Custom String("")), Right, 0, Color(Bianco), Color(Bianco), Globale.RGB, Visible To String and Color, Visible Never);
		Globale.PemilikIkonPilar = Mapped Array(Globale.SlotHUDTersedia, Null);
		Globale.EntitasIkonPilar = Mapped Array(Globale.SlotHUDTersedia, 0);
