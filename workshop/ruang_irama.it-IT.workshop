		Globale.IndeksLokasiServer = Workshop Setting Combo(Custom String("COZYWATCH"), Custom String("Location / Lokasi / ตำแหน่ง (Asia)"), 6, Array(Custom String("Bangladesh"), Custom String("Bhutan"), Custom String("Brunei"), Custom String("Cambodia"), Custom String("Hong Kong"), Custom String("India"), Custom String("Indonesia"), Custom String("Japan"), Custom String("Kazakhstan"), Custom String("Kyrgyzstan"), Custom String("Laos"), Custom String("Malaysia"), Custom String("Maldives"), Custom String("Myanmar"), Custom String("Mongolia"), Custom String("Nepal"), Custom String("Pakistan"), Custom String("Philippines"), Custom String("Singapore"), Custom String("South Korea"), Custom String("Sri Lanka"), Custom String("Tajikistan"), Custom String("Taiwan"), Custom String("Thailand"), Custom String("Uzbekistan"), Custom String("Vietnam")), 1);
		Globale.DiagnostikPerforma = Workshop Setting Toggle(Custom String("COZYWATCH"), Custom String("Diagnostics / Diagnostik / การวินิจฉัย"), False, 2);
		Globale.WaktuAkhirServer = (Total Time Elapsed + (Globale.DurasiServerMenit * 60));
