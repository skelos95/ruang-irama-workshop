	{
		Globale.Siap == True;
		Or(Is Dummy Bot(Event Giocatore), Event Giocatore.BotOtomatis) == True;
		Has Generato(Event Giocatore) == True;
		Is Vivo(Event Giocatore) == True;
		Or(Event Giocatore.KunciBotAktif == False, Eroe Of(Event Giocatore) != Event Giocatore.PahlawanBotTerakhir) == True;
	}

	azioni
	{
		Call Subroutine(KunciBot);
	}
}

regola("04 - Pemain Keluar: Tenangkan lalu bersihkan pendaftaran")
{
	evento
	{
		Giocatore Sinistra Match;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Is Dummy Bot(Event Giocatore) == False;
		Event Giocatore.BotOtomatis == False;
		Or(Event Giocatore.Manusia == True, Array Contains(Globale.PemainManusia, Event Giocatore)) == True;
	}

	azioni
	{
		Call Subroutine(TenangkanPemain);
		Attendi(0.050, Ignora condizione);
		Call Subroutine(BersihkanPemain);
	}
}

regola("04g - Utama global: Penjadwal pusat 20 Hz")
{
	evento
	{
		Ongoing - Globale;
	}

	condizioni
	{
		Globale.Siap == True;
	}

	azioni
	{
		"Langkah 0,05 detik adalah satu-satunya sumber tick dan satu-satunya Loop di seluruh skrip."
		Globale.LangkahPenjadwal = (Globale.LangkahPenjadwal + 1) % 200;
		If(Globale.LangkahPenjadwal % 2 == 0);
			Globale.RGB = Custom Color(
				80 + (Globale.RGBFase < 255 ? 255 : Globale.RGBFase < 510 ? 510 - Globale.RGBFase : Globale.RGBFase < 1020 ? 0 : Globale.RGBFase < 1275 ? Globale.RGBFase - 1020 : 255) * 0.686,
				80 + (Globale.RGBFase < 255 ? Globale.RGBFase : Globale.RGBFase < 765 ? 255 : Globale.RGBFase < 1020 ? 1020 - Globale.RGBFase : 0) * 0.686,
				80 + (Globale.RGBFase < 510 ? 0 : Globale.RGBFase < 765 ? Globale.RGBFase - 510 : Globale.RGBFase < 1275 ? 255 : 1530 - Globale.RGBFase) * 0.686,
				255);
			Globale.RGBFase = (Globale.RGBFase + 3) % 1530;
		End;
		If(And(Globale.LangkahPenjadwal % 20 == 0, Globale.MulaiUlangSudahDiminta == False));
			Globale.SisaWaktuServer = Massimo(0, Round To Integer(Globale.WaktuAkhirServer - Totale Tempo Elapsed, Su));
			Globale.TeksWaktuServer = Globale.SisaWaktuServer % 60 < 10 ? Custom String("{0}:0{1}", Round To Integer(Globale.SisaWaktuServer / 60, Giù),
				Globale.SisaWaktuServer % 60) : Custom String("{0}:{1}", Round To Integer(Globale.SisaWaktuServer / 60, Giù), Globale.SisaWaktuServer % 60);
		End;
		"Indeks dan pemain aktif hanya dimiliki penjadwal; tidak ada jeda selama pemindaian."
		For Globale Variable(IndeksPemainGlobal, 0, Count Of(All Giocatori(All Squadre)), 1);
			Globale.PemainAktif = All Giocatori(All Squadre)[Globale.IndeksPemainGlobal];
			Call Subroutine(ProsesCepatPemain);
			Call Subroutine(ProsesNasibPemain);
			If(Globale.LangkahPenjadwal % 2 == 0);
				Call Subroutine(ProsesSiklusPemain);
			End;
			If(Globale.LangkahPenjadwal % 20 == 0);
				Call Subroutine(ProsesCachePemain);
			End;
			If(And(Globale.LangkahPenjadwal == 0, And(Globale.PemainAktif.Manusia == True, Entity Exists(Globale.PemainAktif))));
				Set Giocatore Variable(Globale.PemainAktif, MenitLobi, Massimo(0, Round To Integer((Totale Tempo Elapsed - Globale.PemainAktif.WaktuMasuk) / 60, Giù)));
			End;
		End;
		Globale.PemainAktif = Null;
		Attendi(0.050, Ignora condizione);
		Loop If Condizione Is True;
	}
}

regola("05 - Menu: Tahan serangan jarak dekat 0,5 detik untuk buka atau tutup")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.Manusia == True;
		Event Giocatore.BotOtomatis == False;
		Is Dummy Bot(Event Giocatore) == False;
		Is Vivo(Event Giocatore) == True;
		Event Giocatore.SeranganDekatDipakai == False;
		Event Giocatore.TeleportasiJongkokAktif == False;
		Event Giocatore.KartuNasibAktif == False;
		Is Button Held(Event Giocatore, Button(Melee)) == True;
	}

	azioni
	{
		Attendi(0.500, Annulla quando è False);
		Event Giocatore.SeranganDekatDipakai = True;
		If(Event Giocatore.MenuTerbuka == True);
			Call Subroutine(TutupMenu);
			Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Arcade Menu closed. Back to professionally doing nothing.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Menu Arcade ditutup. Kembali CHILL dengan penuh tanggung jawab.") : Custom String("ปิดเมนูอาร์เคดแล้ว กลับไป CHILL อย่างมืออาชีพได้"));
		Else;
			Event Giocatore.MenuTerbuka = True;
			Event Giocatore.HalamanMenu = -1;
			Call Subroutine(GambarMenu);
			Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Arcade Menu online. Twelve extremely important decisions await.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Menu Arcade online. Dua belas keputusan yang sangat penting menunggu.") : Custom String("เปิดเมนูอาร์เคดแล้ว มีสิบสองตัวเลือกสำคัญรอคุณอยู่"));
		End;
	}
}

regola("05b - Menu: Lepaskan serangan jarak dekat sebelum pakai lagi")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.Manusia == True;
		Event Giocatore.BotOtomatis == False;
		Is Dummy Bot(Event Giocatore) == False;
		Event Giocatore.SeranganDekatDipakai == True;
		Is Button Held(Event Giocatore, Button(Melee)) == False;
	}

	azioni
	{
		If(Event Giocatore.MenuTerbuka == False);
			Allow Button(Event Giocatore, Button(Melee));
		End;
		Event Giocatore.SeranganDekatDipakai = False;
	}
}

regola("05c - Menu: Pengatur masukan dengan prioritas tetap")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Is Vivo(Event Giocatore) == True;
		Event Giocatore.Manusia == True;
		Event Giocatore.MenuTerbuka == True;
		Is Button Held(Event Giocatore, Button(Accovacciati)) == True;
		Event Giocatore.PerintahMenu == 0;
		Event Giocatore.InteraksiKameraDipakai == False;
		Event Giocatore.KartuNasibAktif == False;
		Or(Or(Is Button Held(Event Giocatore, Button(Interagisci)), And(Is Button Held(Event Giocatore, Button(Reload)), Event Giocatore.HalamanMenu != -1)), Or(Or(Is Button Held(Event Giocatore, Button(Fuoco Primario)), Is Button Held(Event Giocatore, Button(Secondary Fire))), And(Event Giocatore.HalamanMenu == 0, Or(Is Button Held(Event Giocatore, Button(Abilità 1)), Is Button Held(Event Giocatore, Button(Abilità 2)))))) == True;
	}

	azioni
	{
		If(Is Button Held(Event Giocatore, Button(Interagisci)));
			Event Giocatore.InteraksiKameraDipakai = True;
			Event Giocatore.PerintahMenu = 1;
		Else If(And(Is Button Held(Event Giocatore, Button(Reload)), Event Giocatore.HalamanMenu != -1));
			Event Giocatore.PerintahMenu = 2;
		Else If(Is Button Held(Event Giocatore, Button(Fuoco Primario)));
			Event Giocatore.PerintahMenu = 3;
		Else If(Is Button Held(Event Giocatore, Button(Secondary Fire)));
			Event Giocatore.PerintahMenu = 4;
		Else If(And(Is Button Held(Event Giocatore, Button(Abilità 1)), Event Giocatore.HalamanMenu == 0));
			Event Giocatore.PerintahMenu = 5;
		Else If(And(Is Button Held(Event Giocatore, Button(Abilità 2)), Event Giocatore.HalamanMenu == 0));
			Event Giocatore.PerintahMenu = 6;
		End;
	}
}

regola("05d - Menu: Lepaskan pengatur setelah semua masukan dilepas")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.Manusia == True;
		Event Giocatore.PerintahMenu != 0;
		And(And(Is Button Held(Event Giocatore, Button(Interagisci)) == False, Is Button Held(Event Giocatore, Button(Reload)) == False), And(And(Is Button Held(Event Giocatore, Button(Fuoco Primario)) == False, Is Button Held(Event Giocatore, Button(Secondary Fire)) == False), And(Is Button Held(Event Giocatore, Button(Abilità 1)) == False, Is Button Held(Event Giocatore, Button(Abilità 2)) == False))) == True;
	}

	azioni
	{
		"Aktifkan kembali pengatur segera setelah semua tombol dilepas; pengunci tetap mencegah pengulangan saat tombol ditahan."
		Event Giocatore.PerintahMenu = 0;
	}
}

regola("05e - Menu: Crouch mengunci masukan pahlawan hanya saat navigasi")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.Manusia == True;
		Event Giocatore.MenuTerbuka == True;
		Event Giocatore.InputMenuDikunci == False;
		Is Button Held(Event Giocatore, Button(Accovacciati)) == True;
	}

	azioni
	{
		Event Giocatore.InputMenuDikunci = True;
		Disallow Button(Event Giocatore, Button(Fuoco Primario));
		Disallow Button(Event Giocatore, Button(Secondary Fire));
		Disallow Button(Event Giocatore, Button(Interagisci));
		Disallow Button(Event Giocatore, Button(Reload));
		Disallow Button(Event Giocatore, Button(Abilità 1));
		Disallow Button(Event Giocatore, Button(Abilità 2));
		Disallow Button(Event Giocatore, Button(Ultimate));
	}
}

regola("05f - Menu: Lepaskan Crouch dan segera pulihkan masukan pahlawan")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.InputMenuDikunci == True;
		Or(Event Giocatore.MenuTerbuka == False, Is Button Held(Event Giocatore, Button(Accovacciati)) == False) == True;
	}

	azioni
	{
		Allow Button(Event Giocatore, Button(Fuoco Primario));
		Allow Button(Event Giocatore, Button(Secondary Fire));
		Allow Button(Event Giocatore, Button(Interagisci));
		Allow Button(Event Giocatore, Button(Reload));
		Allow Button(Event Giocatore, Button(Abilità 1));
		Allow Button(Event Giocatore, Button(Abilità 2));
		Allow Button(Event Giocatore, Button(Ultimate));
		Event Giocatore.InputMenuDikunci = False;
		Event Giocatore.PerintahMenu = 0;
	}
}

regola("06 - Menu: Navigasi berikutnya dan sebelumnya")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Is Vivo(Event Giocatore) == True;
		Event Giocatore.Manusia == True;
		Event Giocatore.BotOtomatis == False;
		Is Dummy Bot(Event Giocatore) == False;
		Event Giocatore.MenuTerbuka == True;
		Or(Event Giocatore.PerintahMenu == 3, Event Giocatore.PerintahMenu == 4) == True;
	}

	azioni
	{
		If(Event Giocatore.HalamanMenu == -1);
			Event Giocatore.KursorUtama = (Event Giocatore.KursorUtama + (Event Giocatore.PerintahMenu == 3 ? 1 : 11)) % 12;
		Else If(Event Giocatore.HalamanMenu == 0);
			Event Giocatore.KursorGenre = (Event Giocatore.KursorGenre + (Event Giocatore.PerintahMenu == 3 ? 1 : 99)) % 100;
		Else If(Event Giocatore.HalamanMenu == 1);
			Call Subroutine(SegarkanTargetKamera);
			Event Giocatore.KursorKamera = (Event Giocatore.KursorKamera + (Event Giocatore.PerintahMenu == 3 ? 1 : Count Of(Event Giocatore.DaftarTargetKamera) + 1)) % (Count Of(Event Giocatore.DaftarTargetKamera) + 2);
		Else If(Event Giocatore.HalamanMenu == 2);
			Event Giocatore.KursorWarna = (Event Giocatore.KursorWarna + (Event Giocatore.PerintahMenu == 3 ? 1 : Count Of(Globale.DaftarWarna) - 1)) % Count Of(Globale.DaftarWarna);
		Else If(Event Giocatore.HalamanMenu == 3);
			Event Giocatore.KursorBahasa = (Event Giocatore.KursorBahasa + (Event Giocatore.PerintahMenu == 3 ? 1 : 2)) % 3;
		Else If(Event Giocatore.HalamanMenu == 4);
			Call Subroutine(SegarkanTargetBalasDendam);
			If(Count Of(Event Giocatore.DaftarTargetBalasDendam) > 0);
				Event Giocatore.KursorBalasDendam = (Event Giocatore.KursorBalasDendam + (Event Giocatore.PerintahMenu == 3 ? 1 : Count Of(Event Giocatore.DaftarTargetBalasDendam) - 1)) % Count Of(Event Giocatore.DaftarTargetBalasDendam);
			End;
		Else If(Event Giocatore.HalamanMenu == 5);
			Event Giocatore.KursorKebal = (Event Giocatore.KursorKebal + (Event Giocatore.PerintahMenu == 3 ? 1 : 2)) % 3;
		Else If(Event Giocatore.HalamanMenu == 6);
			Event Giocatore.KursorSuara = (Event Giocatore.KursorSuara + (Event Giocatore.PerintahMenu == 3 ? 1 : 4)) % 5;
		Else If(Event Giocatore.HalamanMenu == 7);
			Event Giocatore.KursorIkon = (Event Giocatore.KursorIkon + (Event Giocatore.PerintahMenu == 3 ? 1 : Count Of(Globale.DaftarIkon) - 1)) % Count Of(Globale.DaftarIkon);
		Else If(Event Giocatore.HalamanMenu == 8);
			Event Giocatore.KursorTeleportasiJongkok = (Event Giocatore.KursorTeleportasiJongkok + 1) % 2;
		Else If(Event Giocatore.HalamanMenu == 9);
			Event Giocatore.KursorPrivasiInspeksi = (Event Giocatore.KursorPrivasiInspeksi + 1) % 2;
		Else If(Event Giocatore.HalamanMenu == 11);
			If(Count Of(Globale.PemainManusia) > 0);
				Event Giocatore.KursorPilihan = (Event Giocatore.KursorPilihan + (Event Giocatore.PerintahMenu == 3 ? 1 : Count Of(Globale.PemainManusia) - 1)) % Count Of(Globale.PemainManusia);
			End;
		End;
		Call Subroutine(TransisiWarnaMenu);
	}
}

regola("08 - Menu musik: Lompat maju atau mundur sepuluh genre")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Is Vivo(Event Giocatore) == True;
		Event Giocatore.Manusia == True;
		Event Giocatore.BotOtomatis == False;
		Is Dummy Bot(Event Giocatore) == False;
		Event Giocatore.MenuTerbuka == True;
		Event Giocatore.HalamanMenu == 0;
		Or(Event Giocatore.PerintahMenu == 5, Event Giocatore.PerintahMenu == 6) == True;
	}

	azioni
	{
		Event Giocatore.KursorGenre = (Event Giocatore.KursorGenre + (Event Giocatore.PerintahMenu == 5 ? 10 : 90)) % 100;
	}
}

regola("10 - Menu: Terapkan halaman aktif")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Is Vivo(Event Giocatore) == True;
		Event Giocatore.Manusia == True;
		Event Giocatore.BotOtomatis == False;
		Is Dummy Bot(Event Giocatore) == False;
		Event Giocatore.MenuTerbuka == True;
		Event Giocatore.PerintahMenu == 1;
	}

	azioni
	{
		If(Event Giocatore.HalamanMenu == -1);
			Event Giocatore.HalamanMenu = Event Giocatore.KursorUtama;
			If(Event Giocatore.HalamanMenu == 1);
				Call Subroutine(SegarkanTargetKamera);
			Else If(Event Giocatore.HalamanMenu == 4);
				Call Subroutine(SegarkanTargetBalasDendam);
			Else If(Event Giocatore.HalamanMenu == 5);
				Event Giocatore.KursorKebal = Event Giocatore.ModeKebal;
			Else If(Event Giocatore.HalamanMenu == 11);
				Event Giocatore.KursorPilihan = And(Event Giocatore.PemainDipilih != Null, Array Contains(Globale.PemainManusia, Event Giocatore.PemainDipilih)) ? Index Of Array Value(Globale.PemainManusia, Event Giocatore.PemainDipilih) : Minimo(Event Giocatore.KursorPilihan, Massimo(0, Count Of(Globale.PemainManusia) - 1));
			End;
			Call Subroutine(GambarMenu);
			Call Subroutine(TransisiWarnaMenu);
		Else If(Event Giocatore.HalamanMenu == 0);
			Call Subroutine(TerapkanHalamanMusik);
		Else If(Event Giocatore.HalamanMenu == 1);
			Call Subroutine(TerapkanHalamanKamera);
		Else If(Event Giocatore.HalamanMenu == 2);
			Call Subroutine(TerapkanHalamanWarna);
		Else If(Event Giocatore.HalamanMenu == 3);
			Call Subroutine(TerapkanHalamanBahasa);
		Else If(Event Giocatore.HalamanMenu == 4);
			Call Subroutine(TerapkanHalamanBalasDendam);
		Else If(Event Giocatore.HalamanMenu == 5);
			Call Subroutine(TerapkanHalamanKebal);
		Else If(Event Giocatore.HalamanMenu == 6);
			Call Subroutine(TerapkanHalamanSuara);
		Else If(Event Giocatore.HalamanMenu == 7);
			Call Subroutine(TerapkanHalamanIkon);
		Else If(Event Giocatore.HalamanMenu == 8);
			Call Subroutine(TerapkanTeleportasiJongkok);
		Else If(Event Giocatore.HalamanMenu == 9);
			Call Subroutine(TerapkanHalamanPrivasiInspeksi);
		Else If(Event Giocatore.HalamanMenu == 10);
			Call Subroutine(TerapkanHalamanNasib);
		Else If(Event Giocatore.HalamanMenu == 11);
			Call Subroutine(TerapkanHalamanPilihan);
		End;
	}
}

regola("99a - Subrutin: Terapkan halaman musik")
{
	evento
	{
		Subroutine;
		TerapkanHalamanMusik;
	}

	azioni
	{
		If(Event Giocatore.IndeksGenre != Event Giocatore.KursorGenre);
			Event Giocatore.IndeksGenre = Event Giocatore.KursorGenre;
			Call Subroutine(EfekTerapkan);
			Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Soundtrack: {0}. Great taste. Probably.", Globale.DaftarGenre[Event Giocatore.IndeksGenre]) : Event Giocatore.IndeksBahasa == 1 ? Custom String("Musik: {0}. Selera bagus. Mungkin.", Globale.DaftarGenre[Event Giocatore.IndeksGenre]) : Custom String("เลือกเพลง: {0} รสนิยมดี...น่าจะนะ", Globale.DaftarGenre[Event Giocatore.IndeksGenre]));
		End;
	}
}

regola("99b - Subrutin: Terapkan halaman kamera")
{
	evento
	{
		Subroutine;
		TerapkanHalamanKamera;
	}

	azioni
	{
		Call Subroutine(SegarkanTargetKamera);
		Event Giocatore.KursorKamera %= Count Of(Event Giocatore.DaftarTargetKamera) + 2;
		If(Event Giocatore.KursorKamera == 0);
			If(Event Giocatore.ModeKamera != 0);
				Interrompi Camera(Event Giocatore);
				Event Giocatore.ModeKamera = 0;
				Event Giocatore.TargetKamera = Null;
				Call Subroutine(EfekPulihkan);
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("First person restored. Nobody saw that.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Kamera normal lagi. Anggap tak terjadi.") : Custom String("กลับมุมมองปกติแล้ว ไม่มีใครเห็นหรอก"));
			End;
		Else If(Event Giocatore.KursorKamera == 1);
			If(Or(Event Giocatore.ModeKamera != 1, Event Giocatore.TargetKamera != Event Giocatore));
				Event Giocatore.TargetKamera = Event Giocatore;
				Event Giocatore.ModeKamera = 1;
				Call Subroutine(MulaiKamera);
				Call Subroutine(EfekTerapkan);
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Third person on. Ego responsibly.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Kamera 3P aktif. Jangan narsis berlebihan.") : Custom String("เปิดกล้องบุคคลที่สามแล้ว อย่าหลงตัวเองเกินไป"));
			End;
		Else;
			If(Event Giocatore.KursorKamera - 2 < Count Of(Event Giocatore.DaftarTargetKamera));
				Event Giocatore.CalonTargetKamera = Event Giocatore.DaftarTargetKamera[Event Giocatore.KursorKamera - 2];
			Else;
				Event Giocatore.CalonTargetKamera = Null;
			End;
			If(And(Event Giocatore.CalonTargetKamera != Null, Entity Exists(Event Giocatore.CalonTargetKamera)));
				If(Or(Event Giocatore.ModeKamera != 2, Event Giocatore.TargetKamera != Event Giocatore.CalonTargetKamera));
					Event Giocatore.TargetKamera = Event Giocatore.CalonTargetKamera;
					Event Giocatore.ModeKamera = 2;
					Call Subroutine(MulaiKamera);
					Call Subroutine(EfekTerapkan);
					Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Watching {0}. Definitely not stalking.", Event Giocatore.TargetKamera) : Event Giocatore.IndeksBahasa == 1 ? Custom String("Menonton {0}. Bukan stalking. Serius.", Event Giocatore.TargetKamera) : Custom String("กำลังดู {0} อยู่ ไม่ได้สะกดรอยนะ จริง ๆ", Event Giocatore.TargetKamera));
				End;
			Else;
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("That player disappeared. Very on-brand for CHILL.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Pemainnya menghilang. Sangat sesuai tema CHILL.") : Custom String("ผู้เล่นคนนั้นหายไปแล้ว สมกับเป็นห้อง CHILL จริง ๆ"));
			End;
		End;
	}
}

regola("99c - Subrutin: Terapkan halaman warna")
{
	evento
	{
		Subroutine;
		TerapkanHalamanWarna;
	}

	azioni
	{
		If(Event Giocatore.IndeksWarna != Event Giocatore.KursorWarna);
			Event Giocatore.IndeksWarna = Event Giocatore.KursorWarna;
			Event Giocatore.WarnaNama = Globale.DaftarWarna[Event Giocatore.IndeksWarna];
			If(Event Giocatore.IndeksWarna == 0);
				Call Subroutine(EfekPulihkan);
			Else;
				Call Subroutine(EfekTerapkan);
			End;
			Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Name color: {0}. Subtlety optional.", Globale.NamaWarnaInggris[Event Giocatore.IndeksWarna]) : Event Giocatore.IndeksBahasa == 1 ? Custom String("Warna nama: {0}. Boleh norak.", Globale.NamaWarna[Event Giocatore.IndeksWarna]) : Custom String("สีชื่อ: {0} เด่นได้ตามใจ", Globale.NamaWarnaThai[Event Giocatore.IndeksWarna]));
		End;
	}
}

regola("99d - Subrutin: Terapkan halaman bahasa")
{
	evento
	{
		Subroutine;
		TerapkanHalamanBahasa;
	}

	azioni
	{
		If(Event Giocatore.IndeksBahasa != Event Giocatore.KursorBahasa);
			Event Giocatore.IndeksBahasa = Event Giocatore.KursorBahasa;
			Call Subroutine(EfekTerapkan);
			Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("HUD language: English.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Bahasa HUD: Bahasa Indonesia.") : Custom String("ภาษา HUD: ไทย"));
		End;
	}
}

regola("99e - Subrutin: Terapkan halaman balas dendam")
{
	evento
	{
		Subroutine;
		TerapkanHalamanBalasDendam;
	}

	azioni
	{
		Call Subroutine(SegarkanTargetBalasDendam);
		If(Count Of(Event Giocatore.DaftarTargetBalasDendam) == 0);
			Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("No revenge targets. Peace has won, temporarily.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Tidak ada target balas dendam. Damai menang... sementara.") : Custom String("ไม่มีเป้าหมายล้างแค้น ความสงบชนะแล้ว...ชั่วคราว"));
		Else;
			Event Giocatore.KursorBalasDendam %= Count Of(Event Giocatore.DaftarTargetBalasDendam);
			Event Giocatore.TargetBalasDendamTerkunci = Event Giocatore.DaftarTargetBalasDendam[Event Giocatore.KursorBalasDendam];
			Event Giocatore.IndeksBalasDendam = Index Of Array Value(Event Giocatore.PembunuhBalasDendam, Event Giocatore.TargetBalasDendamTerkunci);
			If(Event Giocatore.IndeksBalasDendam < 0);
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("That player owes you nothing. Suspiciously peaceful.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Pemain itu tidak punya utang. Damainya mencurigakan sekali.") : Custom String("ผู้เล่นคนนั้นไม่ได้ติดหนี้คุณ สงบเกินจนน่าสงสัย"));
			Else If(Event Giocatore.JumlahBalasDendam[Event Giocatore.IndeksBalasDendam] <= 0);
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Revenge debt cleared. Case closed.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Utang balas dendam lunas. Kasus ditutup.") : Custom String("ชำระหนี้ล้างแค้นหมดแล้ว ปิดคดี"));
			Else If(Or(Entity Exists(Event Giocatore.TargetBalasDendamTerkunci) == False, Is Vivo(Event Giocatore.TargetBalasDendamTerkunci) == False));
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Target is already down. Revenge has office hours.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Target sudah tumbang. Balas dendam juga punya jam kerja.") : Custom String("เป้าหมายล้มอยู่แล้ว การล้างแค้นก็มีเวลาทำการนะ"));
			Else;
				Set Giocatore Variable(Event Giocatore.TargetBalasDendamTerkunci, KematianBalasDendam, True);
				Uccisione(Event Giocatore.TargetBalasDendamTerkunci, Event Giocatore);
				Modify Giocatore Variable At Index(Event Giocatore, JumlahBalasDendam, Event Giocatore.IndeksBalasDendam, Subtract, 1);
				Call Subroutine(EfekTerapkan);
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Revenge claimed on {0}. Remaining: {1}.", Event Giocatore.TargetBalasDendamTerkunci, Event Giocatore.JumlahBalasDendam[Event Giocatore.IndeksBalasDendam]) : Event Giocatore.IndeksBahasa == 1 ? Custom String("Balas dendam dibayar pada {0}. Sisa: {1}.", Event Giocatore.TargetBalasDendamTerkunci, Event Giocatore.JumlahBalasDendam[Event Giocatore.IndeksBalasDendam]) : Custom String("ล้างแค้น {0} สำเร็จ เหลือ: {1}", Event Giocatore.TargetBalasDendamTerkunci, Event Giocatore.JumlahBalasDendam[Event Giocatore.IndeksBalasDendam]));
				Event Giocatore.TargetBalasDendamTerkunci = Null;
			End;
		End;
	}
}

regola("99f - Subrutin: Terapkan halaman kebal")
{
	evento
	{
		Subroutine;
		TerapkanHalamanKebal;
	}

	azioni
	{
		If(Event Giocatore.ModeKebal != Event Giocatore.KursorKebal);
			If(And(Event Giocatore.KursorKebal == 1, Is In Genera Room(Event Giocatore) == True));
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Unkillable: 1 HP (HEALABLE) is unavailable in Spawn Room. FULL HP is still available.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Kebal: 1 HP (BISA SEMBUH) tidak tersedia di ruang muncul. FULL HP tetap tersedia.") : Custom String("ใช้โหมดฆ่าไม่ตาย: 1 HP (รักษาได้) ในห้องเกิดไม่ได้ แต่ FULL HP ยังใช้ได้"));
			Else;
				Event Giocatore.ModeKebal = Event Giocatore.KursorKebal;
				Event Giocatore.KebalAktif = Event Giocatore.ModeKebal != 0;
				If(Event Giocatore.ModeKebal == 0);
					Call Subroutine(EfekPulihkan);
					Clear Stato(Event Giocatore, Unkillable);
					Set Danni subiti(Event Giocatore, 100);
					If(Is Vivo(Event Giocatore) == True);
						Set Giocatore Salute(Event Giocatore, Massimo Salute(Event Giocatore));
					End;
					If(Event Giocatore.IkonKebal != Null);
						Distruggi Icon(Event Giocatore.IkonKebal);
						Event Giocatore.IkonKebal = Null;
					End;
					Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Unkillable disabled.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Mode Kebal nonaktif.") : Custom String("ปิดโหมดฆ่าไม่ตายแล้ว"));
				Else;
					Call Subroutine(EfekTerapkan);
					Clear Stato(Event Giocatore, Unkillable);
					Set Stato(Event Giocatore, Null, Unkillable, 9999);
					If(Event Giocatore.ModeKebal == 1);
						Set Danni subiti(Event Giocatore, 100);
						If(Is Vivo(Event Giocatore) == True);
							Set Giocatore Salute(Event Giocatore, 1);
						End;
						Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Unkillable: 1 HP (HEALABLE) enabled.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Kebal: 1 HP (BISA SEMBUH) aktif.") : Custom String("เปิดโหมดฆ่าไม่ตาย: 1 HP (รักษาได้) แล้ว"));
					Else;
						Set Danni subiti(Event Giocatore, 0);
						If(Is Vivo(Event Giocatore) == True);
							Set Giocatore Salute(Event Giocatore, Massimo Salute(Event Giocatore));
						End;
						Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Unkillable: FULL HP enabled.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Kebal: FULL HP aktif.") : Custom String("เปิดโหมดฆ่าไม่ตาย: FULL HP แล้ว"));
					End;
					If(Event Giocatore.IkonKebal != Null);
						Distruggi Icon(Event Giocatore.IkonKebal);
						Event Giocatore.IkonKebal = Null;
					End;
					If(Event Giocatore.ModeKebal == 1);
						Create Icon(All Giocatori(All Squadre), Event Giocatore, Attenzione, Visibile a and Posizione, Custom Color(255, 80, 80, 255), True);
					Else;
						Create Icon(All Giocatori(All Squadre), Event Giocatore, Halo, Visibile a and Posizione, Globale.RGB, True);
					End;
					Event Giocatore.IkonKebal = Last Created Entity;
				End;
			End;
		End;
	}
}

regola("99g - Subrutin: Terapkan halaman suara pahlawan")
{
	evento
	{
		Subroutine;
		TerapkanHalamanSuara;
	}

	azioni
	{
		If(Event Giocatore.IndeksSuara != Event Giocatore.KursorSuara);
			Event Giocatore.IndeksSuara = Event Giocatore.KursorSuara;
			If(Event Giocatore.IndeksSuara == 0);
				Call Subroutine(EfekPulihkan);
			Else;
				Call Subroutine(EfekTerapkan);
			End;
			If(Event Giocatore.IndeksSuara == 0);
				Interrompi Modifying Eroe Voice Lines(Event Giocatore);
			Else If(Event Giocatore.IndeksSuara == 1);
				Avvio Modifying Eroe Voice Lines(Event Giocatore, 0.500, False);
			Else If(Event Giocatore.IndeksSuara == 2);
				Avvio Modifying Eroe Voice Lines(Event Giocatore, 0.750, False);
			Else If(Event Giocatore.IndeksSuara == 3);
				Avvio Modifying Eroe Voice Lines(Event Giocatore, 1.250, False);
			Else;
				Avvio Modifying Eroe Voice Lines(Event Giocatore, 1.500, False);
			End;
			Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Hero voice updated. Science!") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Suara pahlawan diubah. Demi sains!") : Custom String("ปรับเสียงฮีโร่แล้ว วิทยาศาสตร์!"));
		End;
	}
}

regola("99h - Subrutin: Terapkan halaman ikon pemain")
{
	evento
	{
		Subroutine;
		TerapkanHalamanIkon;
	}

	azioni
	{
		If(Event Giocatore.IndeksIkon != Event Giocatore.KursorIkon);
			Event Giocatore.IndeksIkon = Event Giocatore.KursorIkon;
			Call Subroutine(EfekTerapkan);
			Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Player icon: {0}.", Globale.NamaIkonInggris[Event Giocatore.IndeksIkon]) : Event Giocatore.IndeksBahasa == 1 ? Custom String("Ikon pemain: {0}.", Globale.NamaIkonIndonesia[Event Giocatore.IndeksIkon]) : Custom String("ไอคอนผู้เล่น: {0}", Globale.NamaIkonThai[Event Giocatore.IndeksIkon]));
		End;
	}
}

regola("99i - Subrutin: Terapkan halaman teleportasi Jongkok")
{
	evento
	{
		Subroutine;
		TerapkanTeleportasiJongkok;
	}

	azioni
	{
		If(Event Giocatore.TeleportasiJongkokDiaktifkan != (Event Giocatore.KursorTeleportasiJongkok == 1));
			Event Giocatore.TeleportasiJongkokDiaktifkan = Event Giocatore.KursorTeleportasiJongkok == 1;
			If(Event Giocatore.TeleportasiJongkokDiaktifkan == True);
				Call Subroutine(EfekTerapkan);
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Crouch Teleport enabled.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Teleport Jongkok aktif.") : Custom String("เปิดเทเลพอร์ตตอนย่อแล้ว"));
			Else;
				Call Subroutine(EfekPulihkan);
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Crouch Teleport disabled.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Teleport Jongkok nonaktif.") : Custom String("ปิดเทเลพอร์ตตอนย่อแล้ว"));
			End;
		End;
	}
}

regola("99j - Subrutin: Terapkan halaman privasi inspeksi")
{
	evento
	{
		Subroutine;
		TerapkanHalamanPrivasiInspeksi;
	}

	azioni
	{
		If(Event Giocatore.PrivasiInspeksiAktif != (Event Giocatore.KursorPrivasiInspeksi == 1));
			Event Giocatore.PrivasiInspeksiAktif = Event Giocatore.KursorPrivasiInspeksi == 1;
			If(Event Giocatore.PrivasiInspeksiAktif == True);
				Call Subroutine(EfekTerapkan);
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Crouch privacy enabled. Info hidden; custom camera observers blocked.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Privasi Jongkok aktif. Info disembunyikan; pengamat kamera kustom diblokir.") : Custom String("เปิดความเป็นส่วนตัวตอนย่อ ซ่อนข้อมูลและบล็อกผู้ชมกล้องกำหนดเอง"));
			Else;
				Call Subroutine(EfekPulihkan);
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Crouch privacy disabled. Info and custom camera access restored.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Privasi Jongkok nonaktif. Info dan akses kamera kustom dipulihkan.") : Custom String("ปิดความเป็นส่วนตัวตอนย่อ คืนข้อมูลและการเข้าถึงกล้องกำหนดเองแล้ว"));
			End;
		End;
	}
}

regola("99k - Subrutin: Terapkan halaman coba nasib")
{
	evento
	{
		Subroutine;
		TerapkanHalamanNasib;
	}

	azioni
	{
		If(Event Giocatore.KartuNasibAktif == True);
			Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Try Your Luck is still active. Wait for it to finish.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Coba Nasib masih aktif. Tunggu sampai selesai.") : Custom String("เสี่ยงโชคยังทำงานอยู่ รอให้จบก่อน"));
		Else;
			Event Giocatore.KartuNasibAktif = True;
			Event Giocatore.EfekNasib = Casuale Integer(1, 6);
			Event Giocatore.PutaranKartuNasib = Casuale Integer(20, 24);
			Event Giocatore.JedaKartuNasib = 0.080;
			Event Giocatore.EfekNasibBerakhir = 0;
			Event Giocatore.WaktuBakarNasibBerikut = 0;
			Event Giocatore.WaktuPutaranNasibBerikut = Totale Tempo Elapsed;
			Event Giocatore.WaktuIkonNasibBerakhir = 0;
			Event Giocatore.PrivasiNasibAktif = False;
			Event Giocatore.MenuNasibHarusDibuka = False;
			If(Event Giocatore.IkonKartuNasib != Null);
				Distruggi Icon(Event Giocatore.IkonKartuNasib);
			End;
			Event Giocatore.IkonKartuNasib = Null;
			"Setiap putaran Coba Nasib mematikan Kebal; pemain dapat mengaktifkannya kembali dari halaman Kebal."
			Event Giocatore.KebalAktif = False;
			Event Giocatore.ModeKebal = 0;
			Event Giocatore.KursorKebal = 0;
			Clear Stato(Event Giocatore, Unkillable);
			Set Danni subiti(Event Giocatore, 100);
			If(Is Vivo(Event Giocatore) == True);
				Set Giocatore Salute(Event Giocatore, Massimo Salute(Event Giocatore));
			End;
			If(Event Giocatore.IkonKebal != Null);
				Distruggi Icon(Event Giocatore.IkonKebal);
			End;
			Event Giocatore.IkonKebal = Null;
			Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Try Your Luck: six outcomes are rolling.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Coba Nasib: enam hasil sedang diacak.") : Custom String("เสี่ยงโชค: กำลังสุ่มหกผลลัพธ์"));
		End;
	}
}

regola("99l - Subrutin: Terapkan halaman pilihan pemain")
{
	evento
	{
		Subroutine;
		TerapkanHalamanPilihan;
	}

	azioni
	{
		If(Count Of(Globale.PemainManusia) > 0);
			Event Giocatore.KursorPilihan %= Count Of(Globale.PemainManusia);
			If(Event Giocatore.PemainDipilih != Globale.PemainManusia[Event Giocatore.KursorPilihan]);
				"Setiap pemain memiliki tepat satu pilihan aktif; pilihan lama dikurangi sebelum pilihan baru ditambahkan. Memilih diri sendiri diperbolehkan."
				If(And(Event Giocatore.PemainDipilih != Null, Array Contains(Globale.PemainManusia, Event Giocatore.PemainDipilih)));
					Modify Giocatore Variable(Globale.PemainManusia[Index Of Array Value(Globale.PemainManusia, Event Giocatore.PemainDipilih)], JumlahPilihan, Subtract, 1);
					If(Globale.PemainManusia[Index Of Array Value(Globale.PemainManusia, Event Giocatore.PemainDipilih)].JumlahPilihan < 0);
						Set Giocatore Variable(Globale.PemainManusia[Index Of Array Value(Globale.PemainManusia, Event Giocatore.PemainDipilih)], JumlahPilihan, 0);
					End;
				End;
				Event Giocatore.PemainDipilih = Globale.PemainManusia[Event Giocatore.KursorPilihan];
				Modify Giocatore Variable(Globale.PemainManusia[Event Giocatore.KursorPilihan], JumlahPilihan, Add, 1);
				Call Subroutine(HitungPilihan);
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Vote registered for {0}.", Event Giocatore.PemainDipilih) : Event Giocatore.IndeksBahasa == 1 ? Custom String("Pilihan untuk {0} tersimpan.", Event Giocatore.PemainDipilih) : Custom String("โหวตให้ {0} แล้ว", Event Giocatore.PemainDipilih));
			End;
		End;
	}
}

regola("11 - Menu: Isi ulang kembali dari submenu ke menu utama")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Is Vivo(Event Giocatore) == True;
		Event Giocatore.Manusia == True;
		Event Giocatore.BotOtomatis == False;
		Is Dummy Bot(Event Giocatore) == False;
		Event Giocatore.MenuTerbuka == True;
		Event Giocatore.HalamanMenu != -1;
		Event Giocatore.PerintahMenu == 2;
	}

	azioni
	{
		Event Giocatore.HalamanMenu = -1;
		Call Subroutine(GambarMenu);
		Call Subroutine(TransisiWarnaMenu);
	}
}

regola("12c - Kamera: Tahan Interact setengah detik untuk beralih")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.Manusia == True;
		Event Giocatore.BotOtomatis == False;
		Is Dummy Bot(Event Giocatore) == False;
		Has Generato(Event Giocatore) == True;
		Is Vivo(Event Giocatore) == True;
		Event Giocatore.InteraksiKameraDipakai == False;
		Is Button Held(Event Giocatore, Button(Accovacciati)) == False;
		Is Button Held(Event Giocatore, Button(Interagisci)) == True;
	}

	azioni
	{
		Attendi(0.500, Annulla quando è False);
		Event Giocatore.InteraksiKameraDipakai = True;
		If(Event Giocatore.ModeKamera == 0);
			Event Giocatore.TargetKamera = Event Giocatore;
			Event Giocatore.ModeKamera = 1;
			Call Subroutine(MulaiKamera);
			Call Subroutine(EfekTerapkan);
			Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Third person enabled.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Kamera orang ketiga aktif.") : Custom String("เปิดมุมมองบุคคลที่สามแล้ว"));
		Else;
			Interrompi Camera(Event Giocatore);
			Event Giocatore.ModeKamera = 0;
			Event Giocatore.TargetKamera = Null;
			Call Subroutine(EfekPulihkan);
			Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("First person restored.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Kamera orang pertama kembali.") : Custom String("กลับสู่มุมมองบุคคลที่หนึ่งแล้ว"));
		End;
	}
}

