		Globale.TeksWaktuServer = (((Globale.SisaWaktuServer % 60) < 10) ? Custom String("{0}:0{1}", Round To Integer((Globale.SisaWaktuServer / 60), Down), (Globale.SisaWaktuServer % 60)) : Custom String("{0}:{1}", Round To Integer((Globale.SisaWaktuServer / 60), Down), (Globale.SisaWaktuServer % 60)));
