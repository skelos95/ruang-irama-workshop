regola("91g - Subrutin: Gambar menu teleportasi")
{
	evento
	{
		Subroutine;
		GambarTeleportasi;
	}

	azioni
	{
		If(Event Player.HudMenu != Null);
			Destroy HUD Text(Event Player.HudMenu);
		End;
		Event Player.HudMenu = Null;
		If(Index Of Array Value(Globale.PemainManusia, Event Player) >= 0);
			If(Index Of Array Value(Globale.PemainManusia, Event Player) < Count Of(Globale.HudMenuPemain));
				Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Event Player)] = 0;
			End;
		End;
		Event Player.KursorTeleportasi %= 5;
		Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}
{1}", Custom String("HOLD {0} | {1}: NEXT | {2}: PREV", Input Binding String(Button(Crouch)), Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}
{1}", Custom String("{0}: EXECUTE | RELEASE {1}: CLOSE", Input Binding String(Button(Interact)), Input Binding String(Button(Crouch))), Custom String("{0} + {1}: DETACH (ATTACH PAGE)", Input Binding String(Button(Crouch)), Input Binding String(Button(Reload))))) : Event Player.IndeksBahasa == 1 ? Custom String("{0}
{1}", Custom String("TAHAN {0} | {1}: MAJU | {2}: MUNDUR", Input Binding String(Button(Crouch)), Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}
{1}", Custom String("{0}: JALANKAN | LEPAS {1}: TUTUP", Input Binding String(Button(Interact)), Input Binding String(Button(Crouch))), Custom String("{0} + {1}: LEPAS (HALAMAN TEMPEL)", Input Binding String(Button(Crouch)), Input Binding String(Button(Reload))))) : Custom String("{0}
{1}", Custom String("กด {0} ค้าง | {1}: ถัดไป | {2}: ก่อนหน้า", Input Binding String(Button(Crouch)), Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}
{1}", Custom String("{0}: ใช้ | ปล่อย {1}: ปิด", Input Binding String(Button(Interact)), Input Binding String(Button(Crouch))), Custom String("{0} + {1}: ปล่อย (หน้าเกาะ)", Input Binding String(Button(Crouch)), Input Binding String(Button(Reload))))), Event Player.IndeksBahasa == 0 ? Event Player.KursorTeleportasi == 0 ? Custom String("1/5 | TELEPORT: SPAWN ROOM
TO: YOUR TEAM'S SPAWN ROOM
ACTION: TELEPORT") : Event Player.KursorTeleportasi == 1 ? Custom String("2/5 | TELEPORT: ACTIVE OBJECTIVE
TO: OBJECTIVE / ENEMY FLAG
ACTION: TELEPORT NEARBY") : Event Player.KursorTeleportasi == 2 ? Custom String("3/5 | TELEPORT: PLAYER/BOT
TO: BESIDE SELECTED TARGET
TARGET: {0}
ACTION: TELEPORT NEARBY", Event Player.CalonTargetTeleportasi != Null ? Event Player.CalonTargetTeleportasi : Custom String("NO PUBLIC TARGET AVAILABLE")) : Event Player.KursorTeleportasi == 3 ? Custom String("4/5 | ATTACH: PLAYER/BOT
ABOVE SELECTED TARGET
TARGET: {0}
ACTION: ATTACH", Event Player.CalonTargetTeleportasi != Null ? Event Player.CalonTargetTeleportasi : Custom String("NO PUBLIC TARGET AVAILABLE")) : Custom String("5/5 | SELF ELIMINATION
EFFECT: ELIMINATE CURRENT HERO FORM
ACTION: ELIMINATE SELF
COOLDOWN: 3s PER PLAYER") : Event Player.IndeksBahasa == 1 ? Event Player.KursorTeleportasi == 0 ? Custom String("1/5 | TELEPORT: RUANG MUNCUL
TUJUAN: RUANG MUNCUL TIMMU
AKSI: TELEPORT") : Event Player.KursorTeleportasi == 1 ? Custom String("2/5 | TELEPORT: OBJEKTIF AKTIF
TUJUAN: OBJEKTIF / BENDERA MUSUH
AKSI: TELEPORT KE DEKAT TUJUAN") : Event Player.KursorTeleportasi == 2 ? Custom String("3/5 | TELEPORT: PLAYER / BOT
TUJUAN: DI SAMPING TARGET TERPILIH
TARGET: {0}
AKSI: TELEPORT KE DEKAT TARGET", Event Player.CalonTargetTeleportasi != Null ? Event Player.CalonTargetTeleportasi : Custom String("TAK ADA TARGET PUBLIK")) : Event Player.KursorTeleportasi == 3 ? Custom String("4/5 | KAITKAN: PLAYER / BOT
POSISI: DI ATAS TARGET TERPILIH
TARGET: {0}
AKSI: KAITKAN", Event Player.CalonTargetTeleportasi != Null ? Event Player.CalonTargetTeleportasi : Custom String("TAK ADA TARGET PUBLIK")) : Custom String("5/5 | ELIMINASI DIRI
EFEK: ELIMINASI WUJUD HERO AKTIF
AKSI: ELIMINASI DIRI
COOLDOWN: 3 DTK PER PLAYER") : Event Player.KursorTeleportasi == 0 ? Custom String("1/5 | วาร์ปกลับห้องเกิด
ปลายทาง: ห้องเกิดทีมคุณ") : Event Player.KursorTeleportasi == 1 ? Custom String("2/5 | วาร์ปใกล้ภารกิจ
ปลายทาง: จุดภารกิจปัจจุบัน / ธงศัตรู") : Event Player.KursorTeleportasi == 2 ? Custom String("3/5 | วาร์ป: ผู้เล่น / บอต
ไปข้างเป้าหมาย: {0}", Event Player.CalonTargetTeleportasi != Null ? Event Player.CalonTargetTeleportasi : Custom String("ไม่มีเป้าหมายที่เปิดให้ใช้")) : Event Player.KursorTeleportasi == 3 ? Custom String("4/5 | เกาะ: ผู้เล่น / บอต
เกาะเหนือเป้าหมาย: {0}", Event Player.CalonTargetTeleportasi != Null ? Event Player.CalonTargetTeleportasi : Custom String("ไม่มีเป้าหมายที่เปิดให้ใช้")) : Custom String("5/5 | กำจัดตัวเอง
กำจัดร่างฮีโร่ปัจจุบัน
คูลดาวน์: 3 วิต่อผู้เล่น"), Top, 3, Custom Color(255, 255, 255, 255), Custom Color(190 + X Component Of(Event Player.WarnaMenu) * 0.250, 190 + Y Component Of(Event Player.WarnaMenu) * 0.250, 190 + Z Component Of(Event Player.WarnaMenu) * 0.250, 255), Custom Color(X Component Of(Event Player.WarnaMenu), Y Component Of(Event Player.WarnaMenu), Z Component Of(Event Player.WarnaMenu), 255), Visible To String and Color, Visible Never);
		Event Player.HudMenu = Last Text ID;
		If(Index Of Array Value(Globale.PemainManusia, Event Player) >= 0);
			If(Index Of Array Value(Globale.PemainManusia, Event Player) < Count Of(Globale.HudMenuPemain));
				Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Event Player)] = Event Player.HudMenu;
			End;
		End;
	}
}

