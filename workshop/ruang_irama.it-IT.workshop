regola("19e - Teleportasi Jongkok: Interaksi menjalankan halaman aktif")
{
	evento
	{
		Subroutine;
		Pengatur19e;
	}

	azioni
	{
		If(Not(And(Not(Globale.PemainPemicu.PindahTimDiproses), And(Not(Globale.PemainPemicu.SiklusPemainAktif), And(Globale.PemainPemicu.TeleportasiJongkokAktif, (Globale.PemainPemicu.PerintahTeleportasi == 3))))));
		Globale.PemainPemicu.StatusPengatur[32] = 0;
		Abort;
		End;
		Abort If((Globale.PemainPemicu.StatusPengatur[32] == 1));
		Globale.PemainPemicu.StatusPengatur[32] = 1;
		Globale.PemainPemicu.JenisTeleportasiTerkunci = Globale.PemainPemicu.KursorTeleportasi;
		Globale.PemainPemicu.TargetTeleportasiTerkunci = Null;
		If(Or((Globale.PemainPemicu.JenisTeleportasiTerkunci == 2), (Globale.PemainPemicu.JenisTeleportasiTerkunci == 3)));
		Call Subroutine(SegarkanTargetTeleportasi);
		Globale.PemainPemicu.TargetTeleportasiTerkunci = Globale.PemainPemicu.CalonTargetTeleportasi;
		End;
		If((Globale.PemainPemicu.JenisTeleportasiTerkunci == 0));
		Call Subroutine(TeleportasiKeRuangMuncul);
		Else If((Globale.PemainPemicu.JenisTeleportasiTerkunci == 1));
		Call Subroutine(TeleportasiKeObjektif);
		Else If((Globale.PemainPemicu.JenisTeleportasiTerkunci == 2));
		Call Subroutine(TeleportasiKeTarget);
		Else If((Globale.PemainPemicu.JenisTeleportasiTerkunci == 3));
		Globale.PemainPemicu.RantaiLampiran = Globale.PemainPemicu.TargetTeleportasiTerkunci;
		Globale.PemainPemicu.SiklusLampiran = False;
		For Player Variable(Globale.PemainPemicu, IndeksRantaiLampiran, 0, (Count Of(All Players(All Teams)) + 1), 1);
		If((Globale.PemainPemicu.RantaiLampiran != Null));
		If((Globale.PemainPemicu.RantaiLampiran == Globale.PemainPemicu));
		Globale.PemainPemicu.SiklusLampiran = True;
		Globale.PemainPemicu.RantaiLampiran = Null;
		Else If(Player Variable(Globale.PemainPemicu.RantaiLampiran, LampiranTeleportasiAktif));
		Globale.PemainPemicu.RantaiLampiran = Player Variable(Globale.PemainPemicu.RantaiLampiran, TargetLampiranTeleportasi);
		Else;
		Globale.PemainPemicu.RantaiLampiran = Null;
		End;
		End;
		End;
		If((Globale.PemainPemicu.RantaiLampiran != Null));
		Globale.PemainPemicu.SiklusLampiran = True;
		End;
		If(Or(Or((Globale.PemainPemicu.TargetTeleportasiTerkunci == Null), Not(Entity Exists(Globale.PemainPemicu.TargetTeleportasiTerkunci))), Or(Not(Has Spawned(Globale.PemainPemicu.TargetTeleportasiTerkunci)), Not(Is Alive(Globale.PemainPemicu.TargetTeleportasiTerkunci)))));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Attach target unavailable.") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Target tempel tak tersedia.") : Custom String("เกาะไม่ได้: เป้าหมายไม่พร้อม"))));
		Else If(Globale.PemainPemicu.SiklusLampiran);
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Attach blocked: no loops allowed!") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Tak bisa tempel: rantainya jadi melingkar!") : Custom String("เกาะไม่ได้: จะวนเป็นวง"))));
		Else;
		If(Globale.PemainPemicu.LampiranTeleportasiAktif);
		Detach Players(Globale.PemainPemicu);
		End;
		Globale.PemainPemicu.TargetLampiranTeleportasi = Globale.PemainPemicu.TargetTeleportasiTerkunci;
		Globale.PemainPemicu.PahlawanLampiranSendiri = Hero Of(Globale.PemainPemicu);
		Globale.PemainPemicu.PahlawanLampiranTarget = Hero Of(Globale.PemainPemicu.TargetLampiranTeleportasi);
		Globale.PemainPemicu.LampiranTeleportasiAktif = True;
		Attach Players(Evaluate Once(Globale.PemainPemicu), Player Variable(Evaluate Once(Globale.PemainPemicu), TargetLampiranTeleportasi), Vector(0, ((Y Component Of(Eye Position(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetLampiranTeleportasi))) - Y Component Of(Position Of(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetLampiranTeleportasi)))) + 0.750), 0));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Attached to {0}. CROUCH + RELOAD: detach.", Globale.PemainPemicu.TargetLampiranTeleportasi) : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Nempel di atas {0}. JONGKOK + ISI ULANG: lepas.", Globale.PemainPemicu.TargetLampiranTeleportasi) : Custom String("เกาะเหนือ {0} แล้ว! ย่อ + รีโหลด: ปล่อย", Globale.PemainPemicu.TargetLampiranTeleportasi))));
		End;
		Else;
		If((Total Time Elapsed >= Globale.PemainPemicu.WaktuBunuhDiriBerikut));
		Globale.PemainPemicu.WaktuBunuhDiriBerikut = (Total Time Elapsed + 3);
		Clear Status(Globale.PemainPemicu, Unkillable);
		Set Damage Received(Globale.PemainPemicu, 100);
		Kill(Globale.PemainPemicu, Null);
		Else;
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Self Elimination: ready in {0}s.", Round To Integer((Globale.PemainPemicu.WaktuBunuhDiriBerikut - Total Time Elapsed), Up)) : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Eliminasi diri siap {0} dtk lagi.", Round To Integer((Globale.PemainPemicu.WaktuBunuhDiriBerikut - Total Time Elapsed), Up)) : Custom String("กำจัดตัวเองได้ใน {0} วิ", Round To Integer((Globale.PemainPemicu.WaktuBunuhDiriBerikut - Total Time Elapsed), Up)))));
		End;
		End;
		Globale.PemainPemicu.JenisTeleportasiTerkunci = -1;
		Globale.PemainPemicu.TargetTeleportasiTerkunci = Null;
	}
}

regola("19f - Teleportasi Jongkok: Isi ulang melepas lampiran")
{
	evento
	{
		Subroutine;
		Pengatur19f;
	}

	azioni
	{
		Abort If(Not(And(Not(Globale.PemainPemicu.PindahTimDiproses), And(Not(Globale.PemainPemicu.SiklusPemainAktif), And(Globale.PemainPemicu.LampiranTeleportasiAktif, And(Not(Globale.PemainPemicu.MenuTerbuka), And(Is Button Held(Globale.PemainPemicu, Button(Crouch)), Is Button Held(Globale.PemainPemicu, Button(Reload)))))))));
		Detach Players(Globale.PemainPemicu);
		Set Player Variable(Globale.PemainPemicu, LampiranTeleportasiAktif, False);
		Set Player Variable(Globale.PemainPemicu, TargetLampiranTeleportasi, Null);
		Set Player Variable(Globale.PemainPemicu, PahlawanLampiranSendiri, Null);
		Set Player Variable(Globale.PemainPemicu, PahlawanLampiranTarget, Null);
	}
}

