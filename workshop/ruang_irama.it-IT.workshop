regola("91s - Subrutin: Gambar Mode Hantu / Terbang")
{
	evento
	{
		Subroutine;
		GambarHantuTerbang;
	}

	azioni
	{
		Create HUD Text(Event Player, Null,
			Event Player.IndeksBahasa == 0 ? Event Player.HalamanMenu == -1 ? Custom String("{0}\n{1}", Custom String("Hold CROUCH + command\n{0}: next | {1}: prev", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: open | hold {1} 0.5s: close", Input Binding String(Button(Interact)), Input Binding String(Button(Melee)))) : Custom String("{0}\n{1}", Custom String("Hold CROUCH + command\n{0}: next | {1}: prev", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: toggle | {1}: back", Input Binding String(Button(Interact)), Input Binding String(Button(Reload))))
			: Event Player.IndeksBahasa == 1 ? Event Player.HalamanMenu == -1 ? Custom String("{0}\n{1}", Custom String("Tahan JONGKOK + tombol\n{0}: maju | {1}: mundur", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: buka | tahan {1} 0,5 dtk: tutup", Input Binding String(Button(Interact)), Input Binding String(Button(Melee)))) : Custom String("{0}\n{1}", Custom String("Tahan JONGKOK + tombol\n{0}: maju | {1}: mundur", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: ubah | {1}: kembali", Input Binding String(Button(Interact)), Input Binding String(Button(Reload))))
			: Event Player.HalamanMenu == -1 ? Custom String("{0}\n{1}", Custom String("ย่อค้าง + ปุ่มคำสั่ง\n{0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: เปิด | กด {1} ค้าง 0.5 วิ: ปิด", Input Binding String(Button(Interact)), Input Binding String(Button(Melee)))) : Custom String("{0}\n{1}", Custom String("ย่อค้าง + ปุ่มคำสั่ง\n{0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: สลับ | {1}: กลับ", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))),
			Event Player.IndeksBahasa == 0 ? Event Player.HalamanMenu == -1 ? Custom String("13 - GHOST MODE / FLY\nWALL PHASING: {0}\nFLY MODE: {1}", Event Player.ModeHantuAktif ? Custom String("ON") : Custom String("OFF"), Event Player.ModeTerbangAktif ? Custom String("ON") : Custom String("OFF")) : Custom String("{0}\n> {1}", Custom String("13 - GHOST MODE / FLY {0}/2\nWALL PHASING: {1}\nFLY MODE: {2}", Event Player.KursorHantuTerbang + 1, Event Player.ModeHantuAktif ? Custom String("ON") : Custom String("OFF"), Event Player.ModeTerbangAktif ? Custom String("ON") : Custom String("OFF")), Event Player.KursorHantuTerbang == 0 ? Custom String("WALL PHASING - {0}\nFloors stay solid", Event Player.ModeHantuAktif ? Custom String("TURN OFF") : Custom String("TURN ON")) : Custom String("FLY MODE - {0}\nLOOK TO STEER | HOLD FORWARD: 100% > 500% IN 25s", Event Player.ModeTerbangAktif ? Custom String("TURN OFF") : Custom String("TURN ON")))
			: Event Player.IndeksBahasa == 1 ? Event Player.HalamanMenu == -1 ? Custom String("13 - HANTU / TERBANG\nTEMBUS DINDING: {0}\nTERBANG: {1}", Event Player.ModeHantuAktif ? Custom String("AKTIF") : Custom String("MATI"), Event Player.ModeTerbangAktif ? Custom String("AKTIF") : Custom String("MATI")) : Custom String("{0}\n> {1}", Custom String("13 - HANTU / TERBANG {0}/2\nTEMBUS DINDING: {1}\nTERBANG: {2}", Event Player.KursorHantuTerbang + 1, Event Player.ModeHantuAktif ? Custom String("AKTIF") : Custom String("MATI"), Event Player.ModeTerbangAktif ? Custom String("AKTIF") : Custom String("MATI")), Event Player.KursorHantuTerbang == 0 ? Custom String("TEMBUS DINDING - {0}\nLantai tetap kokoh!", Event Player.ModeHantuAktif ? Custom String("MATIKAN") : Custom String("AKTIFKAN")) : Custom String("TERBANG - {0}\nARAHKAN BIDIKAN | TAHAN MAJU: 100% > 500% DALAM 25 dtk", Event Player.ModeTerbangAktif ? Custom String("MATIKAN") : Custom String("AKTIFKAN")))
			: Event Player.HalamanMenu == -1 ? Custom String("13 - โหมดผี / บิน\nทะลุกำแพง: {0}\nบิน: {1}", Event Player.ModeHantuAktif ? Custom String("เปิด") : Custom String("ปิด"), Event Player.ModeTerbangAktif ? Custom String("เปิด") : Custom String("ปิด")) : Custom String("{0}\n> {1}", Custom String("13 - โหมดผี / บิน {0}/2\nทะลุกำแพง: {1}\nบิน: {2}", Event Player.KursorHantuTerbang + 1, Event Player.ModeHantuAktif ? Custom String("เปิด") : Custom String("ปิด"), Event Player.ModeTerbangAktif ? Custom String("เปิด") : Custom String("ปิด")), Event Player.KursorHantuTerbang == 0 ? Custom String("ทะลุกำแพง - {0}\nยังยืนบนพื้นได้", Event Player.ModeHantuAktif ? Custom String("ปิด") : Custom String("เปิด")) : Custom String("โหมดบิน - {0}\nมองเพื่อเลี้ยว | เดินหน้าค้าง: 100% > 500% ใน 25 วิ", Event Player.ModeTerbangAktif ? Custom String("ปิด") : Custom String("เปิด"))),
			Top, 3, Custom Color(255, 255, 255, 255), Custom Color(215, 235, 255, 255), Custom Color(X Component Of(Event Player.WarnaMenu), Y Component Of(Event Player.WarnaMenu), Z Component Of(Event Player.WarnaMenu), 255), Visible To String and Color, Visible Never);
		Event Player.HudMenu = Last Text ID;
	}
