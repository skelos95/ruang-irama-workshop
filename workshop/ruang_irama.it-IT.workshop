m String("BELUM ADA"))), ((Count Of(Globale.PemainManusia) > 0) ? Custom String("{0} - {1} SUARA", Globale.PemainManusia[Player Variable(Local Player, KursorPilihan)], Globale.PemainManusia[Player Variable(Local Player, KursorPilihan)].JumlahPilihan) : Custom String("TIDAK ADA PEMAIN"))) : Custom String("{0}\n> {1}", Custom String("11 - โหวตผู้เล่น {0}/{1}\nเลือก: {2}", (Player Variable(Local Player, KursorPilihan) + 1), Count Of(Globale.PemainManusia), ((Player Variable(Local Player, PemainDipilih) != Null) ? Player Variable(Local Player, PemainDipilih) : Custom String("ยังไม่โหวต"))), ((Count Of(Globale.PemainManusia) > 0) ? Custom String("{0} - {1} โหวต", Globale.PemainManusia[Player Variable(Local Player, KursorPilihan)], Globale.PemainManusia[Player Variable(Local Player, KursorPilihan)].JumlahPilihan) : Custom String("ไม่มีผู้เล่น"))))), Top, 3, Color(Bianco), Custom Color(235, 230, 190, 255), Custom Color(X Component Of(Player Variable(Local Player, WarnaMenu)), Y Component Of(Player Variable(Local Player, WarnaMenu)), Z Component Of(Player Variable(Local Player, WarnaMenu)), 255), Visible To String and Color, Visible Never);
		Globale.PemainPemicu.HudMenu = Last Text ID;
	}
}

regola("91s - Subrutin: Gambar Mode Hantu / Terbang")
{
	evento
	{
		Subroutine;
		GambarHantuTerbang;
	}

	azioni
	{
		Create HUD Text(Evaluate Once(Globale.PemainPemicu), Null, ((Player Variable(Local Player, IndeksBahasa) == 0) ? Custom String("{0}\n{1}", Custom String("Hold CROUCH | {0}: next | {1}: prev", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: toggle | {1}: back", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))) : ((Player Variable(Local Player, IndeksBahasa) == 1) ? Custom String("{0}\n{1}", Custom String("Tahan JONGKOK | {0}: maju | {1}: mundur", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: ubah | {1}: kembali", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))) : Custom String("{0}\n{1}", Custom String("ย่อค้าง | {0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: สลับ | {1}: กลับ", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))))), ((Player Variable(Local Player, IndeksBahasa) == 0) ? Custom String("{0}\n> {1}", Custom String("13 - GHOST MODE / FLY {0}/2\nWALL PHASING: {1} | FLY MODE: {2}", (Player Variable(Local Player, KursorHantuTerbang) + 1), (Player Variable(Local Player, ModeHantuAktif) ? Custom String("ON") : Custom String("OFF")), (Player Variable(Local Player, ModeTerbangAktif) ? Custom String("ON") : Custom String("OFF"))), ((Player Variable(Local Player, KursorHantuTerbang) == 0) ? Custom String("WALL PHASING - {0}", (Player Variable(Local Player, ModeHantuAktif) ? Custom String("TURN OFF") : Custom String("TURN ON"))) : Custom String("FLY MODE - {0}\nKEEP MOVING: 100% > 1000% / 20s", (Player Variable(Local Player, ModeTerbangAktif) ? Custom String("TURN OFF") : Custom String("TURN ON"))))) : ((Player Variable(Local Player, IndeksBahasa) == 1) ? Custom String("{0}\n> {1}", Custom String("13 - HANTU / TERBANG {0}/2\nTEMBUS DINDING: {1} | TERBANG: {2}", (Player Variable(Local Player, KursorHantuTerbang) + 1), (Player Variable(Local Player, ModeHantuAktif) ? Custom String("AKTIF") : Custom String("MATI")), (Player Variable(Local Player, ModeTerbangAktif) ? Custom String("AKTIF") : Custom String("MATI"))), ((Player Variable(Local Player, KursorHantuTerbang) == 0) ? Custom String("TEMBUS DINDING - {0}", (Player Variable(Local Player, ModeHantuAktif) ? Custom String("MATIKAN") : Custom String("AKTIFKAN"))) : Custom String("TERBANG - {0}\nTERUS BERGERAK: 100% > 1000% / 20 dtk", (Player Variable(Local Player, ModeTerbangAktif) ? Custom String("MATIKAN") : Custom String("AKTIFKAN"))))) : Custom String("{0}\n> {1}", Custom String("13 - โหมดผี / บิน {0}/2\nทะลุกำแพง: {1} | บิน: {2}", (Player Variable(Local Player, KursorHantuTerbang) + 1), (Player Variable(Local Player, ModeHantuAktif) ? Custom String("เปิด") : Custom String("ปิด")), (Player Variable(Local Player, ModeTerbangAktif) ? Custom String("เปิด") : Custom String("ปิด"))), ((Player Variable(Local Player, KursorHantuTerbang) == 0) ? Custom String("ทะลุกำแพง - {0}", (Player Variable(Local Player, ModeHantuAktif) ? Custom String("ปิด") : Custom String("เปิด"))) : Custom String("โหมดบิน - {0}\nขยับต่อเนื่อง: 100% > 1000% / 20 วิ", (Player Variable(Local Player, ModeTerbangAktif) ? Custom String("ปิด") : Custom String("เปิด"))))))), Top, 3, Color(Bianco), Custom Color(215, 235, 255, 255), Custom Color(X Component Of(Player Variable(Local Player, WarnaMenu)), Y Component Of(Player Variable(Local Player, WarnaMenu)), Z Component Of(Player Variable(Local Player, WarnaMenu)), 255), Visible To String and Color, Visible Never);
		Globale.PemainPemicu.HudMenu = Last Text ID;
	}
}

regola("91q - Subrutin: Hitung ulang pilihan dan pemimpin tunggal")
{
	evento
	{
		Subroutine;
		HitungPilihan;
	}

	azioni
	{
		For Global Variable(IndeksPemilih, 0, Count Of(Globale.PemainManusia), 1);
		Set Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], JumlahPilihan, Count Of(Filtered Array(Globale.PemainManusia, (Player Variable(Current Array Element, PemainDipilih) == Globale.PemainManusia[Globale.IndeksPemilih]))));
		End;
		Globale.PemimpinPilihan = Null;
		Globale.PilihanTerbanyak = 0;
		Globale.PilihanSeri = False;
		Globale.NamaPemimpinPilihan = Custom String("");
		Globale.WarnaPemimpinPilihan = Color(Bianco);
		If((Count Of(Globale.PemainManusia) > 0));
		Globale.PemimpinPilihan = First Of(Sorted Array(Globale.PemainManusia, (0 - Player Variable(Current Array Element, JumlahPilihan))));
		Globale.PilihanTerbanyak = Player Variable(Globale.PemimpinPilihan, JumlahPilihan);
		If((Globale.PilihanTerbanyak > 0));
		Globale.PilihanSeri = (Count Of(Filtered Array(Globale.PemainManusia, (Player Variable(Current Array Element, JumlahPilihan) == Globale.PilihanTerbanyak))) > 1);
		If(Globale.PilihanSeri);
		Globale.PemimpinPilihan = Null;
		End;
		Else;
		Globale.PemimpinPilihan = Null;
		End;
		End;
		If((Globale.PemimpinPilihan != Null));
		Globale.NamaPemimpinPilihan = Player Variable(Globale.PemimpinPilihan, NamaTampilan);
		Globale.WarnaPemimpinPilihan = Player Variable(Globale.PemimpinPilihan, WarnaNama);
		End;
	}
}

regola("93 - Subrutin: Mulai kamera dinamis di bahu kiri")
{
	evento
	{
		Subroutine;
		MulaiKamera;
	}

	azioni
	{
		Abort If((Globale.PemainPemicu.TargetKamera == Null));
		Abort If(Not(Entity Exists(Globale.PemainPemicu.TargetKamera)));
		Start Camera(Evaluate Once(Globale.PemainPemicu), Update Every Frame(First Of(Mapped Array(Array(Ray Cast Hit Position((Eye Position(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetKamera)) + Vector(0, Min(0.750, Max(0.450, (0.450 + ((Max Health(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetKamera)) - 200) * 0.0006)))), 0)), (((Eye Position(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetKamera)) + Vector(0, Min(0.750, Max(0.450, (0.450 + ((Max Health(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetKamera)) - 200) * 0.0006)))), 0)) - (Facing Direction Of(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetKamera)) * Min(4.500, Max(Globale.JarakKamera, (Globale.JarakKamera + ((Max Health(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetKamera)) - 200) * 0.0055)))))) + (Cross Product(Direction From Angles(Horizontal Facing Angle Of(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetKamera)), 0), Vector(0, 1, 0)) * Min(1.350, Max(Globale.GeserKamera, (Globale.GeserKamera + ((Max Health(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetKamera)) - 200) * 0.0016)))))), Empty Array, Empty Array, False)), (Current Array Element + (Direction Towards(Current Array Element, (Eye Position(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetKamera)) + Vector(0, Min(0.750, Max(0.450, (0.450 + ((Max Health(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetKamera)) - 200) * 0.0006)))), 0))) * Min(Globale.BantalanDinding, (Distance Between(Current Array Element, (Eye Position(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetKamera)) + Vector(0, Min(0.750, Max(0.450, (0.450 + ((Max Health(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetKamera)) - 200) * 0.0006)))), 0))) * 0.250))))))), Update Every Frame((Eye Position(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetKamera)) + (Facing Direction Of(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetKamera)) * Globale.JarakBidik))), 0);
	}
}

regola("93b2 - Subrutin: Tenangkan pemicu sebelum pembersihan")
{
	evento
	{
		Subroutine;
		TenangkanPemain;
	}

	azioni
	{
		Globale.PemainPukulanSuper = Remove From Array(Globale.PemainPukulanSuper, Globale.PemainPemicu);
		Call Subroutine(TutupMenu);
		Call Subroutine(BersihkanIkonPilar);
		Allow Button(Globale.PemainPemicu, Button(Melee));
		Stop Camera(Globale.PemainPemicu);
		Stop Modifying Hero Voice Lines(Globale.PemainPemicu);
		Stop Chasing Player Variable(Globale.PemainPemicu, WarnaMenu);
		If(Globale.PemainPemicu.LampiranTeleportasiAktif);
		Detach Players(Globale.PemainPemicu);
		End;
		Globale.PemainPemicu.LampiranTeleportasiAktif = False;
		Globale.PemainPemicu.TargetLampiranTeleportasi = Null;
		Globale.PemainPemicu.PahlawanLampiranSendiri = Null;
		Globale.PemainPemicu.PahlawanLampiranTarget = Null;
		If(Globale.PemainPemicu.PelatNamaDinonaktifkan);
		Enable Nameplates(All Players(All Teams), Globale.PemainPemicu);
		End;
		Globale.PemainPemicu.PelatNamaDinonaktifkan = False;
		Globale.PemainPemicu.KebalAktif = False;
		Globale.PemainPemicu.ModeKebal = 0;
		Globale.PemainPemicu.KursorKebal = 0;
		Call Subroutine(PulihkanNasibPemain);
		Stop Accelerating(Globale.PemainPemicu);
		Stop Transforming Throttle(Globale.PemainPemicu);
		Set Move Speed(Globale.PemainPemicu, 100);
		Set Gravity(Globale.PemainPemicu, 100);
		Enable Movement Collision With Environment(Globale.PemainPemicu);
		Globale.PemainPemicu.WaktuPaksaBerikut = 0;
		Globale.PemainPemicu.WaktuPaksaBerakhir = 0;
		Globale.PemainPemicu.MenuNasibHarusDibuka = False;
		Globale.PemainPemicu.KematianBalasDendam = False;
		Globale.PemainPemicu.PenagihBalasDendam = Null;
		Globale.PemainPemicu.SudahSiap = False;
		Globale.PemainPemicu.Manusia = False;
		Globale.PemainPemicu.PerintahMenu = 0;
		Globale.PemainPemicu.MasukanMenuDikunci = False;
		Globale.PemainPemicu.SeranganDekatDipakai = False;
		Globale.PemainPemicu.MenuTerbuka = False;
		Globale.PemainPemicu.TeleportasiJongkokAktif = False;
		Globale.PemainPemicu.PerintahTeleportasi = 0;
		Globale.PemainPemicu.InspeksiAktif = False;
		Globale.PemainPemicu.WaktuTeksTargetBerikut = 0;
		Globale.PemainPemicu.BangkitPerluTeleportasi = False;
		Globale.PemainPemicu.TargetInspeksi = Null;
		Globale.PemainPemicu.InteraksiKameraDipakai = False;
		Globale.PemainPemicu.IzinkanBotBuatanMengikuti = False;
		Globale.PemainPemicu.WaktuTeleportasiBotBuatan = 0;
		Globale.PemainPemicu.KursorTeleportasiBotBuatan = 0;
		Globale.PemainPemicu.ModeHantuAktif = False;
		Globale.PemainPemicu.ModeTerbangAktif = False;
		Globale.PemainPemicu.KursorHantuTerbang = 0;
		Globale.PemainPemicu.ModeLompatGanda = False;
		Globale.PemainPemicu.KursorLompatGanda = 0;
		Globale.PemainPemicu.TingkatLompatGanda = 1;
		Globale.PemainPemicu.LompatGandaDipakai = False;
		Globale.PemainPemicu.LompatDiTanah = True;
		Globale.PemainPemicu.WaktuLompatGandaBerikut = 0;
		Globale.PemainPemicu.PosisiIkonPilar = Vector(0, 0.500, 0);
		Globale.PemainPemicu.FisikaHantuTerbangDiterapkan = False;
		Globale.PemainPemicu.WaktuBunuhDiriBerikut = 0;
		Globale.PemainPemicu.WaktuMulaiTerbangMaju = -1;
		Globale.PemainPemicu.PersenTerbang = 100;
		Globale.PemainPemicu.ArahTerbang = Vector(0, 0, 0);
		Globale.PemainPemicu.DeltaTerbang = Vector(0, 0, 0);
		Globale.PemainPemicu.RantaiLampiran = Null;
		Globale.PemainPemicu.IndeksRantaiLampiran = 0;
		Globale.PemainPemicu.SiklusLampiran = False;
		Globale.PemainPemicu.HudKiri = Null;
		Globale.PemainPemicu.HudMenu = Null;
		Globale.PemainPemicu.HudPemainDibuat = False;
		Globale.PemainPemicu.SudahDiperiksa = False;
		Globale.PemainPemicu.BotOtomatis = False;
	}
}

regola("93c - Subrutin: Bersihkan referensi pemain yang benar-benar keluar")
{
	evento
	{
		Subroutine;
		BersihkanPemain;
	}

	azioni
	{
		Globale.PemainPukulanSuper = Remove From Array(Globale.PemainPukulanSuper, Globale.PemainPemicu);
		Globale.PemainPembersihan = Globale.PemainPemicu;
		Call Subroutine(BersihkanIkonPilar);
		Globale.IndeksKeluar = Index Of Array Value(Globale.PemainManusia, Globale.PemainPembersihan);
		If((Globale.IndeksKeluar > -1));
		If(Or((Globale.IndeksKeluar >= Count Of(Globale.SlotHUDPemain)), Or((Globale.IndeksKeluar >= Count Of(Globale.HudKiriPemain)), Or((Globale.IndeksKeluar >= Count Of(Globale.HudMenuPemain)), (Globale.IndeksKeluar >= Count Of(Globale.TeksDuniaPemain))))));
		Globale.IndeksPembersihan = Globale.IndeksKeluar;
		Globale.IndeksKeluar = -2;
		End;
		If((Globale.IndeksKeluar >= 0));
		Globale.IndeksPembersihan = Globale.IndeksKeluar;
		Globale.IndeksUtangKeluar = Globale.SlotHUDPemain[Globale.IndeksPembersihan];
		Globale.WaktuHilangHUD[Globale.IndeksUtangKeluar] = 0;
		If((Globale.IkonKartuNasibPemain[Globale.IndeksUtangKeluar] != 0));
		Destroy Icon(Globale.IkonKartuNasibPemain[Globale.IndeksUtangKeluar]);
		End;
		Globale.IkonKartuNasibPemain[Globale.IndeksUtangKeluar] = 0;
		If((Globale.IkonKebalPemain[Globale.IndeksUtangKeluar] != 0));
		Destroy Icon(Globale.IkonKebalPemain[Globale.IndeksUtangKeluar]);
		End;
		Globale.IkonKebalPemain[Globale.IndeksUtangKeluar] = 0;
		If((Globale.PemainPembersihan.HudEfekNasib != Null));
		If((Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan) >= 0));
		If((Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan)] == Globale.PemainPembersihan.HudEfekNasib));
		Destroy HUD Text(Globale.PemainPembersihan.HudEfekNasib);
		Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan)] = 0;
		End;
		End;
		End;
		If((Globale.PemainPembersihan.TeksVisiNasib != Null));
		If((Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan) >= 0));
		If((Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan)] == Globale.PemainPembersihan.TeksVisiNasib));
		Destroy In-World Text(Globale.PemainPembersihan.TeksVisiNasib);
		Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan)] = 0;
		End;
		End;
		End;
		If((Globale.PemainPembersihan.TeksTeleportasi != Null));
		If((Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan) >= 0));
		If((Globale.TeksTeleportasiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan)] == Globale.PemainPembersihan.TeksTeleportasi));
		Destroy In-World Text(Globale.PemainPembersihan.TeksTeleportasi);
		Globale.TeksTeleportasiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan)] = 0;
		End;
		End;
		End;
		Globale.PemainPembersihan.IkonKartuNasib = Null;
		Globale.PemainPembersihan.IkonKebal = Null;
		Globale.PemainPembersihan.HudEfekNasib = Null;
		Globale.PemainPembersihan.TeksVisiNasib = Null;
		Globale.PemainPembersihan.TeksTeleportasi = Null;
		Globale.PemainPembersihan.HudKiri = Null;
		Globale.PemainPembersihan.HudMenu = Null;
		Globale.PemainPembersihan.TeksDunia = Null;
		Globale.PemainPembersihan.HudPemainDibuat = False;
		Globale.PemainPembersihan.SudahDiperiksa = False;
		Set Player Variable(Filtered Array(Globale.PemainManusia, (Player Variable(Current Array Element, PemainDipilih) == Globale.PemainPembersihan)), PemainDipilih, Null);
		For Global Variable(IndeksPemilih, 0, Count Of(Globale.PemainManusia), 1);
		If((Globale.PemainManusia[Globale.IndeksPemilih] != Globale.PemainPembersihan));
		Globale.IndeksDendamKeluar = Index Of Array Value(Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], PembunuhBalasDendam), Globale.PemainPembersihan);
		If(And((Globale.IndeksDendamKeluar >= 0), (Globale.IndeksDendamKeluar < Count Of(Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], JumlahBalasDendam)))));
		Modify Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], PembunuhBalasDendam, Remove From Array By Index, Globale.IndeksDendamKeluar);
		Modify Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], JumlahBalasDendam, Remove From Array By Index, Globale.IndeksDendamKeluar);
		End;
		If((Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], TargetBalasDendamTerkunci) == Globale.PemainPembersihan));
		Set Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], TargetBalasDendamTerkunci, Null);
		End;
		If((Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], TargetBalasDendamDipilih) == Globale.PemainPembersihan));
		Set Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], TargetBalasDendamDipilih, Null);
		End;
		If((Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], PenagihBalasDendam) == Globale.PemainPembersihan));
		Set Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], PenagihBalasDendam, Null);
		Set Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], KematianBalasDendam, False);
		Set Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], WaktuPaksaBerikut, 0);
		Set Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], WaktuPaksaBerakhir, 0);
		End;
		End;
		End;
		If((Globale.HudKiriPemain[Globale.IndeksPembersihan] != 0));
		Destroy HUD Text(Globale.HudKiriPemain[Globale.IndeksPembersihan]);
		End;
		If((Globale.HudMenuPemain[Globale.IndeksPembersihan] != 0));
		Destroy HUD Text(Globale.HudMenuPemain[Globale.IndeksPembersihan]);
		End;
		If((Globale.TeksDuniaPemain[Globale.IndeksPembersihan] != 0));
		Destroy In-World Text(Globale.TeksDuniaPemain[Globale.IndeksPembersihan]);
		End;
		Globale.SlotHUDTersedia = Sorted Array(Append To Array(Globale.SlotHUDTersedia, Globale.IndeksUtangKeluar), Current Array Element);
		Modify Global Variable(HudKiriPemain, Remove From Array By Index, Globale.IndeksPembersihan);
		Modify Global Variable(HudMenuPemain, Remove From Array By Index, Globale.IndeksPembersihan);
		Modify Global Variable(TeksDuniaPemain, Remove From Array By Index, Globale.IndeksPembersihan);
		Modify Global Variable(SlotHUDPemain, Remove From Array By Index, Globale.IndeksPembersihan);
		Modify Global Variable(PemainManusia, Remove From Array By Index, Globale.IndeksPembersihan);
		Globale.IndeksPemilih = Count Of(Globale.SlotHUDPemain);
		Globale.SlotHUDTerakhir = ((Globale.IndeksPemilih == 0) ? -1 : Last Of(Sorted Array(Globale.SlotHUDPemain, Current Array Element)));
		Globale.PilihanPerluDihitung = True;
		End;
		If((Globale.IndeksKeluar == -2));
		If((Globale.IndeksPembersihan < Count Of(Globale.SlotHUDPemain)));
		Destroy Icon(Globale.IkonKartuNasibPemain[Globale.SlotHUDPemain[Globale.IndeksPembersihan]]);
		Globale.IkonKartuNasibPemain[Globale.SlotHUDPemain[Globale.IndeksPembersihan]] = 0;
		End;
		If((Globale.IndeksPembersihan < Count Of(Globale.SlotHUDPemain)));
		Destroy Icon(Globale.IkonKebalPemain[Globale.SlotHUDPemain[Globale.IndeksPembersihan]]);
		Globale.IkonKebalPemain[Globale.SlotHUDPemain[Globale.IndeksPembersihan]] = 0;
		End;
		If((Globale.PemainPemicu.HudEfekNasib != Null));
		If((Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu) >= 0));
		If((Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu)] == Globale.PemainPemicu.HudEfekNasib));
		Destroy HUD Text(Globale.PemainPemicu.HudEfekNasib);
		Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu)] = 0;
		End;
		End;
		End;
		If((Globale.PemainPemicu.TeksVisiNasib != Null));
		If((Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu) >= 0));
		If((Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu)] == Globale.PemainPemicu.TeksVisiNasib));
		Destroy In-World Text(Globale.PemainPemicu.TeksVisiNasib);
		Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu)] = 0;
		End;
		End;
		End;
		If((Globale.PemainPemicu.TeksTeleportasi != Null));
		If((Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu) >= 0));
		If((Globale.TeksTeleportasiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu)] == Globale.PemainPemicu.TeksTeleportasi));
		Destroy In-World Text(Globale.PemainPemicu.TeksTeleportasi);
		Globale.TeksTeleportasiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu)] = 0;
		End;
		End;
		End;
		Globale.PemainPemicu.IkonKartuNasib = Null;
		Globale.PemainPemicu.IkonKebal = Null;
		Globale.PemainPemicu.HudEfekNasib = Null;
		Globale.PemainPemicu.TeksVisiNasib = Null;
		Globale.PemainPemicu.TeksTeleportasi = Null;
		Globale.PemainPemicu.HudKiri = Null;
		Globale.PemainPemicu.HudMenu = Null;
		Globale.PemainPemicu.TeksDunia = Null;
		Globale.PemainPemicu.HudPemainDibuat = False;
		Globale.PemainPemicu.SudahDiperiksa = False;
		If((Globale.IndeksPembersihan < Count Of(Globale.HudKiriPemain)));
		If((Globale.HudKiriPemain[Globale.IndeksPembersihan] != 0));
		Destroy HUD Text(Globale.HudKiriPemain[Globale.IndeksPembersihan]);
		End;
		Modify Global Variable(HudKiriPemain, Remove From Array By Index, Globale.IndeksPembersihan);
		End;
		If((Globale.IndeksPembersihan < Count Of(Globale.HudMenuPemain)));
		If((Globale.HudMenuPemain[Globale.IndeksPembersihan] != 0));
		Destroy HUD Text(Globale.HudMenuPemain[Globale.IndeksPembersihan]);
		End;
		Modify Global Variable(HudMenuPemain, Remove From Array By Index, Globale.IndeksPembersihan);
		End;
		If((Globale.IndeksPembersihan < Count Of(Globale.TeksDuniaPemain)));
		If((Globale.TeksDuniaPemain[Globale.IndeksPembersihan] != 0));
		Destroy In-World Text(Globale.TeksDuniaPemain[Globale.IndeksPembersihan]);
		End;
		Modify Global Variable(TeksDuniaPemain, Remove From Array By Index, Globale.IndeksPembersihan);
		End;
		If((Globale.IndeksPembersihan < Count Of(Globale.SlotHUDPemain)));
		Globale.IndeksUtangKeluar = Globale.SlotHUDPemain[Globale.IndeksPembersihan];
		Globale.WaktuHilangHUD[Globale.IndeksUtangKeluar] = 0;
		Modify Global Variable(SlotHUDPemain, Remove From Array By Index, Globale.IndeksPembersihan);
		Globale.SlotHUDTersedia = Append To Array(Globale.SlotHUDTersedia, Globale.IndeksUtangKeluar);
		Globale.SlotHUDTersedia = Sorted Array(Globale.SlotHUDTersedia, Current Array Element);
		End;
		Modify Global Variable(PemainManusia, Remove From Array By Index, Globale.IndeksPembersihan);
		Globale.IndeksPemilih = Count Of(Globale.SlotHUDPemain);
		Globale.SlotHUDTerakhir = ((Globale.IndeksPemilih == 0) ? -1 : Last Of(Sorted Array(Globale.SlotHUDPemain, Current Array Element)));
		Globale.PilihanPerluDihitung = True;
		End;
		End;
		Globale.PemainTeksPembersihan = Globale.PemainPemicu;
		Call Subroutine(BersihkanTeksYatim);
		Globale.IndeksKeluar = -1;
		Globale.IndeksPembersihan = -1;
		Globale.IndeksUtangKeluar = -1;
		Globale.IndeksDendamKeluar = -1;
		Globale.IndeksPemilih = 0;
		Globale.PemainPembersihan = Null;
	}
}

regola("93d - Subrutin: Bersihkan teks yatim")
{
	evento
	{
		Subroutine;
		BersihkanTeksYatim;
	}

	azioni
	{
		For Global Variable(KursorTeksPembersihan, 0, Count Of(Globale.PemilikTeksSementara), 1);
		If(Or((Globale.PemilikTeksSementara[Globale.KursorTeksPembersihan] != Null), Or((Globale.HudEfekSementara[Globale.KursorTeksPembersihan] != 0), Or((Globale.TeksTeleportasiSementara[Globale.KursorTeksPembersihan] != 0), (Globale.TeksVisiSementara[Globale.KursorTeksPembersihan] != 0)))));
		If(Or(Not(Entity Exists(Globale.PemilikTeksSementara[Globale.KursorTeksPembersihan])), And((Globale.PemainTeksPembersihan != Null), (Globale.PemilikTeksSementara[Globale.KursorTeksPembersihan] == Globale.PemainTeksPembersihan))));
		If((Globale.HudEfekSementara[Globale.KursorTeksPembersihan] != 0));
		Destroy HUD Text(Globale.HudEfekSementara[Globale.KursorTeksPembersihan]);
		End;
		If((Globale.TeksTeleportasiSementara[Globale.KursorTeksPembersihan] != 0));
		Destroy In-World Text(Globale.TeksTeleportasiSementara[Globale.KursorTeksPembersihan]);
		End;
		If((Globale.TeksVisiSementara[Globale.KursorTeksPembersihan] != 0));
		Destroy In-World Text(Globale.TeksVisiSementara[Globale.KursorTeksPembersihan]);
		End;
		Globale.HudEfekSementara[Globale.KursorTeksPembersihan] = 0;
		Globale.TeksTeleportasiSementara[Globale.KursorTeksPembersihan] = 0;
		Globale.TeksVisiSementara[Globale.KursorTeksPembersihan] = 0;
		Globale.PemilikTeksSementara[Globale.KursorTeksPembersihan] = Null;
		End;
		End;
		End;
		Globale.PemainTeksPembersihan = Null;
		Globale.IndeksTeksPembersihan = -1;
		Globale.KursorTeksPembersihan = 0;
	}
}

regola("94 - Subrutin: Siapkan pemain dari ujung rambut sampai variabel")
{
	evento
	{
		Subroutine;
		SiapkanPemain;
	}

	azioni
	{
		Abort If(Is Dummy Bot(Globale.PemainPemicu));
		Set Damage Received(Globale.PemainPemicu, 100);
		Set Knockback Received(Globale.PemainPemicu, 100);
		Enable Movement Collision With Players(Globale.PemainPemicu);
		Stop Accelerating(Globale.PemainPemicu);
		Stop Transforming Throttle(Globale.PemainPemicu);
		Set Move Speed(Globale.PemainPemicu, 100);
		Set Gravity(Globale.PemainPemicu, 100);
		Enable Movement Collision With Environment(Globale.PemainPemicu);
		Globale.PemainPemicu.WaktuPilihPahlawan = 0;
		Globale.PemainPemicu.PilihanPahlawanSelesai = True;
		Globale.PemainPemicu.SudahDiperiksa = False;
		Globale.PemainPemicu.BotOtomatis = False;
		Globale.PemainPemicu.Manusia = False;
		Globale.PemainPemicu.IndeksGenre = -1;
		Globale.PemainPemicu.MusikKhusus = Null;
		Globale.PemainPemicu.PembaruanDaftarTertunda = False;
		If(Or((Globale.PemainPemicu.NamaTampilan == Null), (Globale.PemainPemicu.NamaTampilan == Custom String(""))));
		Globale.PemainPemicu.NamaTampilan = Null;
		End;
		Globale.PemainPemicu.UrutanHUD = -1;
		Globale.PemainPemicu.HudKiri = Null;
		Globale.PemainPemicu.HudPemainDibuat = False;
		Globale.PemainPemicu.MenuTerbuka = False;
		Globale.PemainPemicu.KursorGenre = 0;
		Globale.PemainPemicu.HudMenu = Null;
		Globale.PemainPemicu.InspeksiAktif = False;
		Globale.PemainPemicu.WaktuTeksTargetBerikut = 0;
		Globale.PemainPemicu.TargetInspeksi = Null;
		Globale.PemainPemicu.TeksDunia = Null;
		Globale.PemainPemicu.ModeKamera = 0;
		Globale.PemainPemicu.TargetKamera = Null;
		Globale.PemainPemicu.SeranganDekatDipakai = False;
		Globale.PemainPemicu.HalamanMenu = -1;
		Globale.PemainPemicu.KursorUtama = 0;
		Globale.PemainPemicu.KursorKamera = 0;
		Globale.PemainPemicu.KursorWarna = 0;
		Globale.PemainPemicu.IndeksWarna = 0;
		Globale.PemainPemicu.WarnaNama = Color(Bianco);
		Globale.PemainPemicu.CalonTargetKamera = Null;
		Globale.PemainPemicu.IndeksBahasa = 0;
		Globale.PemainPemicu.KursorBahasa = 0;
		Globale.PemainPemicu.DaftarTargetKamera = Empty Array;
		Globale.PemainPemicu.KursorBalasDendam = 0;
		Globale.PemainPemicu.DaftarTargetBalasDendam = Empty Array;
		Globale.PemainPemicu.PembunuhBalasDendam = Empty Array;
		Globale.PemainPemicu.JumlahBalasDendam = Empty Array;
		Globale.PemainPemicu.IndeksBalasDendam = -1;
		Globale.PemainPemicu.KematianBalasDendam = False;
		Globale.PemainPemicu.PenagihBalasDendam = Null;
		Globale.PemainPemicu.WaktuPaksaBerikut = 0;
		Globale.PemainPemicu.WaktuPaksaBerakhir = 0;
		Globale.PemainPemicu.KursorTeleportasi = 0;
		Globale.PemainPemicu.DaftarTargetTeleportasi = Empty Array;
		Globale.PemainPemicu.CalonTargetTeleportasi = Null;
		Globale.PemainPemicu.TargetTeleportasiTeks = Null;
		Globale.PemainPemicu.TeksTeleportasi = Null;
		Globale.PemainPemicu.MasukanMenuDikunci = False;
		Globale.PemainPemicu.TargetBalasDendamTerkunci = Null;
		Globale.PemainPemicu.TargetBalasDendamDipilih = Null;
		Globale.PemainPemicu.PelatNamaDinonaktifkan = False;
		Globale.PemainPemicu.KunciBotAktif = False;
		Globale.PemainPemicu.PahlawanTerakhir = Null;
		Globale.PemainPemicu.DaftarTargetInspeksi = Empty Array;
		Globale.PemainPemicu.PerintahMenu = 0;
		Globale.PemainPemicu.JenisTeleportasiTerkunci = -1;
		Globale.PemainPemicu.TargetTeleportasiTerkunci = Null;
		Globale.PemainPemicu.KebalAktif = False;
		Globale.PemainPemicu.KursorKebal = 0;
		Globale.PemainPemicu.IndeksSuara = 0;
		Globale.PemainPemicu.KursorSuara = 0;
		Globale.PemainPemicu.TeleportasiJongkokAktif = False;
		Globale.PemainPemicu.PerintahTeleportasi = 0;
		Globale.PemainPemicu.InteraksiKameraDipakai = False;
		Globale.PemainPemicu.PosisiMati = Vector(0, 0, 0);
		Globale.PemainPemicu.PosisiBangkitAman = Vector(0, 0, 0);
		Globale.PemainPemicu.BangkitPerluTeleportasi = False;
		Globale.PemainPemicu.BangkitLompatDipakai = False;
		Globale.PemainPemicu.IndeksIkon = 0;
		Globale.PemainPemicu.KursorIkon = 0;
		Globale.PemainPemicu.WarnaMenu = Vector(255, 255, 255);
		Globale.PemainPemicu.TeleportasiJongkokDiaktifkan = False;
		Globale.PemainPemicu.PrivasiInspeksiAktif = False;
		Globale.PemainPemicu.ModeKebal = 0;
		Globale.PemainPemicu.IkonKebal = Null;
		If(Array Contains(Globale.PemainManusia, Globale.PemainPemicu));
		Globale.IkonKebalPemain[Globale.SlotHUDPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)]] = 0;
		End;
		Globale.PemainPemicu.KartuNasibAktif = False;
		Globale.PemainPemicu.IkonKartuNasib = Null;
		If(Array Contains(Globale.PemainManusia, Globale.PemainPemicu));
		Globale.IkonKartuNasibPemain[Globale.SlotHUDPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)]] = 0;
		End;
		Globale.PemainPemicu.KursorPilihan = 0;
		Globale.PemainPemicu.PemainDipilih = Null;
		Globale.PemainPemicu.JumlahPilihan = 0;
		Globale.PemainPemicu.PutaranKartuNasib = 0;
		Globale.PemainPemicu.JedaKartuNasib = 0;
		Globale.PemainPemicu.EfekNasib = 0;
		Globale.PemainPemicu.EfekNasibBerakhir = 0;
		Globale.PemainPemicu.PrivasiNasibAktif = False;
		Globale.PemainPemicu.WaktuBakarNasibBerikut = 0;
		Globale.PemainPemicu.WaktuPutaranNasibBerikut = 0;
		Globale.PemainPemicu.WaktuIkonNasibBerakhir = 0;
		Globale.PemainPemicu.MenuNasibHarusDibuka = False;
		Globale.PemainPemicu.HudEfekNasib = Null;
		Globale.PemainPemicu.TeksVisiNasib = Null;
		Globale.PemainPemicu.TimTerakhir = Team Of(Globale.PemainPemicu);
		Globale.PemainPemicu.TimSiklusTarget = Team Of(Globale.PemainPemicu);
		Globale.PemainPemicu.WaktuTeleportasiBotBuatan = 0;
		Globale.PemainPemicu.KursorTeleportasiBotBuatan = 0;
		Globale.PemainPemicu.IzinkanBotBuatanMengikuti = False;
		Globale.PemainPemicu.TargetIkutiBotBuatan = Null;
		Globale.PemainPemicu.ModeHantuAktif = False;
		Globale.PemainPemicu.ModeTerbangAktif = False;
		Globale.PemainPemicu.KursorHantuTerbang = 0;
		Globale.PemainPemicu.ModeLompatGanda = False;
		Globale.PemainPemicu.KursorLompatGanda = 0;
		Globale.PemainPemicu.TingkatLompatGanda = 1;
		Globale.PemainPemicu.LompatGandaDipakai = False;
		Globale.PemainPemicu.LompatDiTanah = True;
		Globale.PemainPemicu.WaktuLompatGandaBerikut = 0;
		Globale.PemainPemicu.PosisiIkonPilar = Vector(0, 0.500, 0);
		Globale.PemainPemicu.FisikaHantuTerbangDiterapkan = False;
		Globale.PemainPemicu.WaktuBunuhDiriBerikut = 0;
		Globale.PemainPemicu.WaktuMulaiTerbangMaju = -1;
		Globale.PemainPemicu.PersenTerbang = 100;
		Globale.PemainPemicu.ArahTerbang = Vector(0, 0, 0);
		Globale.PemainPemicu.DeltaTerbang = Vector(0, 0, 0);
		Globale.PemainPemicu.RantaiLampiran = Null;
		Globale.PemainPemicu.IndeksRantaiLampiran = 0;
		Globale.PemainPemicu.SiklusLampiran = False;
		Globale.PemainPemicu.CalonTargetInspeksi = Null;
		Globale.PemainPemicu.PosisiTujuanTeleportasi = Vector(0, 0, 0);
		Globale.PemainPemicu.TargetLampiranTeleportasi = Null;
		Globale.PemainPemicu.LampiranTeleportasiAktif = False;
		Globale.PemainPemicu.PahlawanLampiranSendiri = Null;
		Globale.PemainPemicu.PahlawanLampiranTarget = Null;
		Globale.PemainPemicu.WaktuSiklusTim = 0;
		Globale.PemainPemicu.PernahDisiapkan = True;
		Globale.PemainPemicu.PindahTimDiproses = True;
		Globale.PemainPemicu.SiklusPemainAktif = False;
		Globale.PemainPemicu.SudahSiap = True;
	}
}

regola("95 - Subrutin: Segarkan daftar tontonan, termasuk para bot")
{
	evento
	{
		Subroutine;
		SegarkanTargetKamera;
	}

	azioni
	{
		If(And((Globale.PemainPemicu.KursorKamera >= 2), ((Globale.PemainPemicu.KursorKamera - 2) < Count Of(Globale.PemainPemicu.DaftarTargetKamera))));
		Globale.PemainPemicu.CalonTargetKamera = Globale.PemainPemicu.DaftarTargetKamera[(Globale.PemainPemicu.KursorKamera - 2)];
		Else;
		Globale.PemainPemicu.CalonTargetKamera = Null;
		End;
		Call Subroutine(SegarkanTargetPublikPemain);
		Globale.PemainPemicu.DaftarTargetKamera = Filtered Array(Globale.PemainPemicu.DaftarTargetInspeksi, Has Spawned(Current Array Element));
		If(And((Globale.PemainPemicu.CalonTargetKamera != Null), Array Contains(Globale.PemainPemicu.DaftarTargetKamera, Globale.PemainPemicu.CalonTargetKamera)));
		Globale.PemainPemicu.KursorKamera = (Index Of Array Value(Globale.PemainPemicu.DaftarTargetKamera, Globale.PemainPemicu.CalonTargetKamera) + 2);
		Else If((Globale.PemainPemicu.KursorKamera >= (Count Of(Globale.PemainPemicu.DaftarTargetKamera) + 2)));
		Globale.PemainPemicu.KursorKamera = 0;
		End;
	}
}

regola("96 - Subrutin: Cari target publik terdekat dari bidikan")
{
	evento
	{
		Subroutine;
		SegarkanTargetInspeksi;
	}

	azioni
	{
		If(Or((Globale.PemainPemicu.CalonTargetInspeksi == Null), Or(Not(Entity Exists(Globale.PemainPemicu.CalonTargetInspeksi)), Or(Not(Has Spawned(Globale.PemainPemicu.CalonTargetInspeksi)), Or(Not(Is Alive(Globale.PemainPemicu.CalonTargetInspeksi)), And(And(Not(Is Dummy Bot(Globale.PemainPemicu.CalonTargetInspeksi)), Not(Player Variable(Globale.PemainPemicu.CalonTargetInspeksi, BotOtomatis))), Or(Not(Player Variable(Globale.PemainPemicu.CalonTargetInspeksi, Manusia)), Or(Player Variable(Globale.PemainPemicu.CalonTargetInspeksi, PrivasiInspeksiAktif), Player Variable(Globale.PemainPemicu.CalonTargetInspeksi, PembaruanDaftarTertunda)))))))));
		Globale.PemainPemicu.CalonTargetInspeksi = Null;
		Globale.PemainPemicu.TargetInspeksi = Null;
		Else;
		Globale.PemainPemicu.TargetInspeksi = Globale.PemainPemicu.CalonTargetInspeksi;
		End;
	}
}

regola("97 - Subrutin: Segarkan daftar target balas dendam")
{
	evento
	{
		Subroutine;
		SegarkanTargetBalasDendam;
	}

	azioni
	{
		If((Globale.PemainPemicu.KursorBalasDendam < Count Of(Globale.PemainPemicu.DaftarTargetBalasDendam)));
		Globale.PemainPemicu.TargetBalasDendamDipilih = Globale.PemainPemicu.DaftarTargetBalasDendam[Globale.PemainPemicu.KursorBalasDendam];
		Else;
		Globale.PemainPemicu.TargetBalasDendamDipilih = Null;
		End;
		Globale.PemainPemicu.DaftarTargetBalasDendam = Filtered Array(Globale.PemainManusia, (Current Array Element != Globale.PemainPemicu));
		If((Count Of(Globale.PemainPemicu.DaftarTargetBalasDendam) == 0));
		Globale.PemainPemicu.KursorBalasDendam = 0;
		Else If(And((Globale.PemainPemicu.TargetBalasDendamDipilih != Null), Array Contains(Globale.PemainPemicu.DaftarTargetBalasDendam, Globale.PemainPemicu.TargetBalasDendamDipilih)));
		Globale.PemainPemicu.KursorBalasDendam = Index Of Array Value(Globale.PemainPemicu.DaftarTargetBalasDendam, Globale.PemainPemicu.TargetBalasDendamDipilih);
		Else If((Globale.PemainPemicu.KursorBalasDendam >= Count Of(Globale.PemainPemicu.DaftarTargetBalasDendam)));
		Globale.PemainPemicu.KursorBalasDendam = 0;
		End;
	}
}

regola("98 - Subrutin: Cari target teleportasi publik terdekat dari bidikan")
{
	evento
	{
		Subroutine;
		SegarkanTargetTeleportasi;
	}

	azioni
	{
		Call Subroutine(SegarkanTargetPublikPemain);
		Globale.PemainPemicu.DaftarTargetTeleportasi = Globale.PemainPemicu.DaftarTargetInspeksi;
		If((Count Of(Globale.PemainPemicu.DaftarTargetTeleportasi) == 0));
		Globale.PemainPemicu.CalonTargetTeleportasi = Null;
		Else;
		Globale.PemainPemicu.CalonTargetTeleportasi = First Of(Sorted Array(Globale.PemainPemicu.DaftarTargetTeleportasi, Angle Between Vectors(Facing Direction Of(Globale.PemainPemicu), Direction Towards(Eye Position(Globale.PemainPemicu), Eye Position(Current Array Element)))));
		End;
	}
}

regola("98a - Subrutin: Pulihkan status Nasib untuk pemain pemicu")
{
	evento
	{
		Subroutine;
		PulihkanNasibPemain;
	}

	azioni
	{
		If((Globale.PemainPemicu.IkonKartuNasib != Null));
		Destroy Icon(Globale.PemainPemicu.IkonKartuNasib);
		End;
		If((Globale.PemainPemicu.HudEfekNasib != Null));
		If((Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu) >= 0));
		If((Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu)] == Globale.PemainPemicu.HudEfekNasib));
		Destroy HUD Text(Globale.PemainPemicu.HudEfekNasib);
		Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu)] = 0;
		End;
		End;
		End;
		If((Globale.PemainPemicu.TeksVisiNasib != Null));
		If((Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu) >= 0));
		If((Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu)] == Globale.PemainPemicu.TeksVisiNasib));
		Destroy In-World Text(Globale.PemainPemicu.TeksVisiNasib);
		Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu)] = 0;
		End;
		End;
		End;
		Globale.PemainPemicu.IkonKartuNasib = Null;
		If(Array Contains(Globale.PemainManusia, Globale.PemainPemicu));
		Globale.IkonKartuNasibPemain[Globale.SlotHUDPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)]] = 0;
		End;
		Globale.PemainPemicu.HudEfekNasib = Null;
		Globale.PemainPemicu.TeksVisiNasib = Null;
		Clear Status(Globale.PemainPemicu, Burning);
		Clear Status(Globale.PemainPemicu, Hacked);
		Clear Status(Globale.PemainPemicu, Unkillable);
		If((Globale.PemainPemicu.EfekNasib == 2));
		Stop Accelerating(Globale.PemainPemicu);
		Set Move Speed(Globale.PemainPemicu, 100);
		End;
		Set Damage Received(Globale.PemainPemicu, 100);
		Set Knockback Received(Globale.PemainPemicu, 100);
		Enable Movement Collision With Players(Globale.PemainPemicu);
		Set Jump Vertical Speed(Globale.PemainPemicu, 100);
		Set Projectile Speed(Globale.PemainPemicu, 100);
		Globale.PemainPemicu.KartuNasibAktif = False;
		Globale.PemainPemicu.PutaranKartuNasib = 0;
		Globale.PemainPemicu.JedaKartuNasib = 0;
		Globale.PemainPemicu.EfekNasib = 0;
		Globale.PemainPemicu.EfekNasibBerakhir = 0;
		Globale.PemainPemicu.PrivasiNasibAktif = False;
		Globale.PemainPemicu.WaktuBakarNasibBerikut = 0;
		Globale.PemainPemicu.WaktuPutaranNasibBerikut = 0;
		Globale.PemainPemicu.WaktuIkonNasibBerakhir = 0;
		Globale.PemainPemicu.WaktuPaksaBerikut = 0;
		Globale.PemainPemicu.WaktuPaksaBerakhir = 0;
		Globale.PemainPemicu.MenuNasibHarusDibuka = False;
		Globale.PemainPemicu.KebalAktif = (Globale.PemainPemicu.ModeKebal != 0);
		Globale.PemainPemicu.MasukanMenuDikunci = False;
		Globale.PemainPemicu.PerintahMenu = 0;
		Allow Button(Globale.PemainPemicu, Button(Primary Fire));
		Allow Button(Globale.PemainPemicu, Button(Secondary Fire));
		Allow Button(Globale.PemainPemicu, Button(Interact));
		Allow Button(Globale.PemainPemicu, Button(Reload));
		Allow Button(Globale.PemainPemicu, Button(Ability 1));
		Allow Button(Globale.PemainPemicu, Button(Ability 2));
		Allow Button(Globale.PemainPemicu, Button(Ultimate));
	}
}

regola("98b - Subrutin: Pulihkan status Nasib untuk pemain aktif global")
{
	evento
	{
		Subroutine;
		PulihkanNasibAktif;
	}

	azioni
	{
		Abort If(Or((Globale.PemainAktif == Null), Not(Entity Exists(Globale.PemainAktif))));
		If((Globale.PemainAktif.IkonKartuNasib != Null));
		Destroy Icon(Globale.PemainAktif.IkonKartuNasib);
		End;
		If((Globale.PemainAktif.HudEfekNasib != Null));
		If((Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainAktif) >= 0));
		If((Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainAktif)] == Globale.PemainAktif.HudEfekNasib));
		Destroy HUD Text(Globale.PemainAktif.HudEfekNasib);
		Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainAktif)] = 0;
		End;
		End;
		End;
		If((Globale.PemainAktif.TeksVisiNasib != Null));
		If((Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainAktif) >= 0));
		If((Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainAktif)] == Globale.PemainAktif.TeksVisiNasib));
		Destroy In-World Text(Globale.PemainAktif.TeksVisiNasib);
		Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainAktif)] = 0;
		End;
		End;
		End;
		Globale.PemainAktif.IkonKartuNasib = Null;
		If(Array Contains(Globale.PemainManusia, Globale.PemainAktif));
		Globale.IkonKartuNasibPemain[Globale.SlotHUDPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif)]] = 0;
		End;
		Globale.PemainAktif.HudEfekNasib = Null;
		Globale.PemainAktif.TeksVisiNasib = Null;
		Clear Status(Globale.PemainAktif, Burning);
		Clear Status(Globale.PemainAktif, Hacked);
		If(Or((Globale.PemainAktif.ModeKebal == 0), Not(Is Alive(Globale.PemainAktif))));
		Clear Status(Globale.PemainAktif, Unkillable);
		Set Damage Received(Globale.PemainAktif, 100);
		Set Knockback Received(Globale.PemainAktif, 100);
		Enable Movement Collision With Players(Globale.PemainAktif);
		End;
		If((Globale.PemainAktif.EfekNasib == 2));
		Stop Accelerating(Globale.PemainAktif);
		Set Move Speed(Globale.PemainAktif, 100);
		End;
		Set Jump Vertical Speed(Globale.PemainAktif, 100);
		Set Projectile Speed(Globale.PemainAktif, 100);
		Globale.PemainAktif.KartuNasibAktif = False;
		Globale.PemainAktif.PutaranKartuNasib = 0;
		Globale.PemainAktif.JedaKartuNasib = 0;
		Globale.PemainAktif.EfekNasib = 0;
		Globale.PemainAktif.EfekNasibBerakhir = 0;
		Globale.PemainAktif.PrivasiNasibAktif = False;
		Globale.PemainAktif.WaktuBakarNasibBerikut = 0;
		Globale.PemainAktif.WaktuPutaranNasibBerikut = 0;
		Globale.PemainAktif.WaktuIkonNasibBerakhir = 0;
		Globale.PemainAktif.WaktuPaksaBerikut = 0;
		Globale.PemainAktif.WaktuPaksaBerakhir = 0;
		Globale.PemainAktif.MenuNasibHarusDibuka = False;
		Globale.PemainAktif.KebalAktif = (Globale.PemainAktif.ModeKebal != 0);
		Globale.PemainAktif.MasukanMenuDikunci = False;
		Globale.PemainAktif.PerintahMenu = 0;
		Allow Button(Globale.PemainAktif, Button(Primary Fire));
		Allow Button(Globale.PemainAktif, Button(Secondary Fire));
		Allow Button(Globale.PemainAktif, Button(Interact));
		Allow Button(Globale.PemainAktif, Button(Reload));
		Allow Button(Globale.PemainAktif, Button(Ability 1));
		Allow Button(Globale.PemainAktif, Button(Ability 2));
		Allow Button(Globale.PemainAktif, Button(Ultimate));
	}
}

regola("98c - Subrutin: Segarkan daftar target publik untuk pemain pemicu")
{
	evento
	{
		Subroutine;
		SegarkanTargetPublikPemain;
	}

	azioni
	{
		Globale.PemainPemicu.DaftarTargetInspeksi = Filtered Array(All Players(All Teams), And((Current Array Element != Globale.PemainPemicu), And(Entity Exists(Current Array Element), And(Is Alive(Current Array Element), Or(Is Dummy Bot(Current Array Element), Or(Player Variable(Current Array Element, BotOtomatis), And(Player Variable(Current Array Element, Manusia), And(Not(Player Variable(Current Array Element, PrivasiInspeksiAktif)), Not(Player Variable(Current Array Element, PembaruanDaftarTertunda))))))))));
	}
}

regola("98d - Subrutin: Segarkan daftar target publik untuk pemain aktif global")
{
	evento
	{
		Subroutine;
		SegarkanTargetPublikAktif;
	}

	azioni
	{
		Abort If(Or((Globale.PemainAktif == Null), Not(Entity Exists(Globale.PemainAktif))));
		Set Player Variable(Globale.PemainAktif, DaftarTargetInspeksi, Filtered Array(All Players(All Teams), And((Current Array Element != Globale.PemainAktif), And(Entity Exists(Current Array Element), And(Is Alive(Current Array Element), Or(Is Dummy Bot(Current Array Element), Or(Player Variable(Current Array Element, BotOtomatis), And(Player Variable(Current Array Element, Manusia), And(Not(Player Variable(Current Array Element, PrivasiInspeksiAktif)), Not(Player Variable(Current Array Element, PembaruanDaftarTertunda)))))))))));
	}
}

regola("98e - Subrutin: Buat bot buatan sesuai tim aktif")
{
	evento
	{
		Subroutine;
		BuatBotBuatanTim;
	}

	azioni
	{
		Create Dummy Bot(Tutti gli eroi, Globale.TimBotBuatanAktif, -1, Position Of(First Of(Spawn Points(Globale.TimBotBuatanAktif))), Vector(0, 0, 1));
	}
}

regola("98f - Subrutin: Lepas bot buatan sesuai tim aktif")
{
	evento
	{
		Subroutine;
		LepasBotBuatanTim;
	}

	azioni
	{
		Abort If((Count Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element))) == 0));
		If((Player Variable(First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element))), TeksVisiNasib) != Null));
		If((Index Of Array Value(Globale.PemilikTeksSementara, First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element)))) >= 0));
		If((Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element))))] == Player Variable(First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element))), TeksVisiNasib)));
		Destroy In-World Text(Player Variable(First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element))), TeksVisiNasib));
		Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element))))] = 0;
		End;
		End;
		End;
		Stop Facing(First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element))));
		Stop Throttle In Direction(First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element))));
		Destroy Dummy Bot(Globale.TimBotBuatanAktif, Slot Of(First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element)))));
	}
}

regola("98g - Subrutin: Teleportasi ke ruang muncul")
{
	evento
	{
		Subroutine;
		TeleportasiKeRuangMuncul;
	}

	azioni
	{
		If(Is In Spawn Room(Globale.PemainPemicu));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Already in Spawn Room. Home sweet home!") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Sudah di ruang muncul. Beres!") : Custom String("อยู่ในห้องเกิดแล้ว ถึงที่หมาย!"))));
		Else If((Count Of(Spawn Points(Team Of(Globale.PemainPemicu))) == 0));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Spawn Room unavailable.") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Ruang muncul belum tersedia di peta ini.") : Custom String("ห้องเกิดในแผนที่นี้ยังไม่พร้อม"))));
		Else;
		Teleport(Globale.PemainPemicu, Position Of(First Of(Spawn Points(Team Of(Globale.PemainPemicu)))));
		End;
	}
}

regola("98h - Subrutin: Teleportasi ke objektif")
{
	evento
	{
		Subroutine;
		TeleportasiKeObjektif;
	}

	azioni
	{
		Globale.PemainPemicu.PosisiTujuanTeleportasi = Objective Position(Objective Index);
		If((Distance Between(Globale.PemainPemicu.PosisiTujuanTeleportasi, Vector(0, 0, 0)) <= 0.100));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Objective unavailable.") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Posisi objektif belum tersedia.") : Custom String("จุดภารกิจยังไม่พร้อม"))));
		Abort;
		End;
		Call Subroutine(CariPosisiTeleportasiAman);
		If((Distance Between(Globale.PemainPemicu.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("No safe walkable spot near the objective.") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Tak ada pijakan aman dekat objektif.") : Custom String("ไม่มีจุดเดินที่ปลอดภัยใกล้ภารกิจ"))));
		Abort;
		End;
		Teleport(Globale.PemainPemicu, Globale.PemainPemicu.PosisiBangkitAman);
	}
}

regola("98i - Subrutin: Teleportasi ke target pemain")
{
	evento
	{
		Subroutine;
		TeleportasiKeTarget;
	}

	azioni
	{
		If(Or(Or((Globale.PemainPemicu.TargetTeleportasiTerkunci == Null), Not(Entity Exists(Globale.PemainPemicu.TargetTeleportasiTerkunci))), Or(Not(Is Alive(Globale.PemainPemicu.TargetTeleportasiTerkunci)), Not(Array Contains(Globale.PemainPemicu.DaftarTargetTeleportasi, Globale.PemainPemicu.TargetTeleportasiTerkunci)))));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Target unavailable. Teleport has standards.") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Target tak tersedia. Teleportasi ikut rehat!") : Custom String("เป้าหมายไม่พร้อม วาร์ปพักก่อน!"))));
		Abort;
		End;
		Globale.PemainPemicu.PosisiTujuanTeleportasi = (Position Of(Globale.PemainPemicu.TargetTeleportasiTerkunci) - (Facing Direction Of(Globale.PemainPemicu.TargetTeleportasiTerkunci) * 2.250));
		Call Subroutine(CariPosisiTeleportasiAman);
		If((Distance Between(Globale.PemainPemicu.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100));
		Globale.PemainPemicu.PosisiTujuanTeleportasi = (Position Of(Globale.PemainPemicu.TargetTeleportasiTerkunci) + (Facing Direction Of(Globale.PemainPemicu.TargetTeleportasiTerkunci) * 2.250));
		Call Subroutine(CariPosisiTeleportasiAman);
		End;
		If((Distance Between(Globale.PemainPemicu.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100));
		Globale.PemainPemicu.PosisiTujuanTeleportasi = (Position Of(Globale.PemainPemicu.TargetTeleportasiTerkunci) + Vector(2.250, 0, 0));
		Call Subroutine(CariPosisiTeleportasiAman);
		End;
		If((Distance Between(Globale.PemainPemicu.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100));
		Globale.PemainPemicu.PosisiTujuanTeleportasi = (Position Of(Globale.PemainPemicu.TargetTeleportasiTerkunci) + Vector(-2.250, 0, 0));
		Call Subroutine(CariPosisiTeleportasiAman);
		End;
		If((Distance Between(Globale.PemainPemicu.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100));
		Globale.PemainPemicu.PosisiTujuanTeleportasi = (Position Of(Globale.PemainPemicu.TargetTeleportasiTerkunci) + Vector(0, 0, 2.250));
		Call Subroutine(CariPosisiTeleportasiAman);
		End;
		If((Distance Between(Globale.PemainPemicu.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100));
		Globale.PemainPemicu.PosisiTujuanTeleportasi = (Position Of(Globale.PemainPemicu.TargetTeleportasiTerkunci) + Vector(0, 0, -2.250));
		Call Subroutine(CariPosisiTeleportasiAman);
		End;
		If((Distance Between(Globale.PemainPemicu.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("No safe walkable spot near that target.") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Tak ada pijakan aman dekat target itu.") : Custom String("ไม่มีจุดเดินที่ปลอดภัยใกล้เป้าหมาย"))));
		Abort;
		End;
		Teleport(Globale.PemainPemicu, Globale.PemainPemicu.PosisiBangkitAman);
	}
}

regola("98j - Subrutin: Cari posisi teleportasi aman")
{
	evento
	{
		Subroutine;
		CariPosisiTeleportasiAman;
	}

	azioni
	{
		Globale.PemainPemicu.PosisiBangkitAman = Vector(0, 0, 0);
		Abort If((Distance Between(Globale.PemainPemicu.PosisiTujuanTeleportasi, Vector(0, 0, 0)) <= 0.100));
		Globale.PemainPemicu.PosisiBangkitAman = Nearest Walkable Position(Globale.PemainPemicu.PosisiTujuanTeleportasi);
		If((Distance Between(Globale.PemainPemicu.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100));
		Globale.PemainPemicu.PosisiBangkitAman = Vector(0, 0, 0);
		Abort;
		End;
		If((Distance Between(Ray Cast Hit Position((Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 1, 0)), (Globale.PemainPemicu.PosisiBangkitAman + Vector(1.500, 1, 0)), Empty Array, Empty Array, False), (Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 1, 0))) < 1.250));
		Globale.PemainPemicu.PosisiBangkitAman = Nearest Walkable Position((Globale.PemainPemicu.PosisiBangkitAman + Vector(-1.500, 0, 0)));
		End;
		If((Distance Between(Ray Cast Hit Position((Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 1, 0)), (Globale.PemainPemicu.PosisiBangkitAman + Vector(-1.500, 1, 0)), Empty Array, Empty Array, False), (Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 1, 0))) < 1.250));
		Globale.PemainPemicu.PosisiBangkitAman = Nearest Walkable Position((Globale.PemainPemicu.PosisiBangkitAman + Vector(1.500, 0, 0)));
		End;
		If((Distance Between(Ray Cast Hit Position((Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 1, 0)), (Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 1, 1.500)), Empty Array, Empty Array, False), (Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 1, 0))) < 1.250));
		Globale.PemainPemicu.PosisiBangkitAman = Nearest Walkable Position((Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 0, -1.500)));
		End;
		If((Distance Between(Ray Cast Hit Position((Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 1, 0)), (Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 1, -1.500)), Empty Array, Empty Array, False), (Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 1, 0))) < 1.250));
		Globale.PemainPemicu.PosisiBangkitAman = Nearest Walkable Position((Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 0, 1.500)));
		End;
		If((Distance Between(Globale.PemainPemicu.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100));
		Globale.PemainPemicu.PosisiBangkitAman = Vector(0, 0, 0);
		Abort;
		End;
		If((Distance Between(Ray Cast Hit Position((Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 1, 0)), (Globale.PemainPemicu.PosisiBangkitAman + Vector(1.000, 1, 0)), Empty Array, Empty Array, False), (Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 1, 0))) < 0.850));
