regola("17 - Balas Dendam: Catat hanya pembunuh langsung")
{
	evento
	{
		Giocatore Died;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.Manusia == True;
	}

	azioni
	{
		If(Event Giocatore.KematianBalasDendam == True);
			Event Giocatore.KematianBalasDendam = False;
			Abort;
		End;
		Abort If(Attacker == Null);
		Abort If(Attacker == Event Giocatore);
		Abort If(Giocatore Variable(Attacker, Manusia) == False);
		Event Giocatore.IndeksBalasDendam = Index Of Array Value(Event Giocatore.PembunuhBalasDendam, Attacker);
		If(Event Giocatore.IndeksBalasDendam < 0);
			Event Giocatore.PembunuhBalasDendam = Append To Array(Event Giocatore.PembunuhBalasDendam, Attacker);
			Event Giocatore.JumlahBalasDendam = Append To Array(Event Giocatore.JumlahBalasDendam, 1);
		Else;
			Modify Giocatore Variable At Index(Event Giocatore, JumlahBalasDendam, Event Giocatore.IndeksBalasDendam, Add, 1);
		End;
	}
}

regola("18c - Kebal: Nonaktifkan hanya mode 1 HP di Ruang Muncul")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.Manusia == True;
		Event Giocatore.ModeKebal == 1;
		Is In Genera Room(Event Giocatore) == True;
	}

	azioni
	{
		Event Giocatore.KebalAktif = False;
		Event Giocatore.ModeKebal = 0;
		Event Giocatore.KursorKebal = 1;
		Call Subroutine(EfekPulihkan);
		Clear Stato(Event Giocatore, Unkillable);
		Set Danni subiti(Event Giocatore, 100);
		If(Is Vivo(Event Giocatore) == True);
			Set Giocatore Salute(Event Giocatore, Massimo Salute(Event Giocatore));
		End;
		If(Event Giocatore.IkonKebal != Null);
			Distruggi Icon(Event Giocatore.IkonKebal);
			Event Giocatore.IkonKebal = Null;
		End;
		Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Unkillable: 1 HP (HEALABLE) disabled in Spawn Room.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Kebal: 1 HP (BISA SEMBUH) dimatikan di ruang muncul.") : Custom String("ปิดโหมดฆ่าไม่ตาย: 1 HP (รักษาได้) ในห้องเกิดแล้ว"));
	}
}

regola("18f - Nasib: Bersihkan efek saat mati")
{
	evento
	{
		Giocatore Died;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Or(Event Giocatore.KartuNasibAktif == True, Or(Event Giocatore.PutaranKartuNasib > 0, Event Giocatore.EfekNasib != 0)) == True;
	}

	azioni
	{
		If(Event Giocatore.IkonKartuNasib != Null);
			Distruggi Icon(Event Giocatore.IkonKartuNasib);
		End;
		Clear Stato(Event Giocatore, Bruciatura in Corso);
		Clear Stato(Event Giocatore, Sabotato);
		Interrompi Accelerating(Event Giocatore);
		If(Event Giocatore.HudEfekNasib != Null);
			Distruggi HUD Text(Event Giocatore.HudEfekNasib);
		End;
		Event Giocatore.HudEfekNasib = Null;
		Set Move Velocità Non Direzionale(Event Giocatore, 100);
		Event Giocatore.PrivasiNasibAktif = False;
		Event Giocatore.EfekNasib = 0;
		Event Giocatore.EfekNasibBerakhir = 0;
		Event Giocatore.WaktuBakarNasibBerikut = 0;
		Event Giocatore.WaktuPutaranNasibBerikut = 0;
		Event Giocatore.WaktuIkonNasibBerakhir = 0;
		Event Giocatore.IkonKartuNasib = Null;
		Event Giocatore.KartuNasibAktif = False;
		Event Giocatore.PutaranKartuNasib = 0;
		Event Giocatore.JedaKartuNasib = 0;
		Event Giocatore.MenuNasibHarusDibuka = Event Giocatore.MenuTerbuka == False;
		Clear Stato(Event Giocatore, Unkillable);
		Event Giocatore.KebalAktif = False;
		Event Giocatore.ModeKebal = 0;
		Event Giocatore.KursorKebal = 0;
		Set Danni subiti(Event Giocatore, 100);
		If(Event Giocatore.IkonKebal != Null);
			Distruggi Icon(Event Giocatore.IkonKebal);
			Event Giocatore.IkonKebal = Null;
		End;
	}
}

