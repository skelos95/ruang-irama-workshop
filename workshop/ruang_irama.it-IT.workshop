regola("91p - Subrutin: Gambar halaman aktif")
{
	evento
	{
		Subroutine;
		GambarHalamanAktif;
	}

	azioni
	{
		If(Event Giocatore.HalamanMenu == -1);
			Call Subroutine(GambarUtama);
		Else If(Event Giocatore.HalamanMenu == 0);
			Call Subroutine(GambarMusik);
		Else If(Event Giocatore.HalamanMenu == 1);
			Call Subroutine(GambarKamera);
		Else If(Event Giocatore.HalamanMenu == 2);
			Call Subroutine(GambarWarna);
		Else If(Event Giocatore.HalamanMenu == 3);
			Call Subroutine(GambarBahasa);
		Else If(Event Giocatore.HalamanMenu == 4);
			Call Subroutine(GambarBalasDendam);
		Else If(Event Giocatore.HalamanMenu == 5);
			Call Subroutine(GambarKebal);
		Else If(Event Giocatore.HalamanMenu == 6);
			Call Subroutine(GambarSuara);
		Else If(Event Giocatore.HalamanMenu == 7);
			Call Subroutine(GambarIkon);
		Else If(Event Giocatore.HalamanMenu == 8);
			Call Subroutine(GambarSakelarTeleportasi);
		Else If(Event Giocatore.HalamanMenu == 9);
			Call Subroutine(GambarPrivasiInspeksi);
		Else If(Event Giocatore.HalamanMenu == 10);
			Call Subroutine(GambarNasib);
		Else If(Event Giocatore.HalamanMenu == 11);
			Call Subroutine(GambarPilihan);
		End;
	}
}

regola("91k - Subrutin: Transisi warna menu tanpa lompatan")
{
	evento
	{
		Subroutine;
		TransisiWarnaMenu;
	}

	azioni
	{
		"Setiap menu memiliki warna identitas sendiri. Hanya Warna Nama mengikuti warna yang sedang dipilih; semuanya berubah secara bertahap."
		Segui Giocatore Variable Sopra Tempo(Event Giocatore, WarnaMenu, (Event Giocatore.HalamanMenu == -1 ? Event Giocatore.KursorUtama : Event Giocatore.HalamanMenu) == 0 ? Vector(55, 235, 245) : (Event Giocatore.HalamanMenu == -1 ? Event Giocatore.KursorUtama : Event Giocatore.HalamanMenu) == 1 ? Vector(70, 135, 255) : (Event Giocatore.HalamanMenu == -1 ? Event Giocatore.KursorUtama : Event Giocatore.HalamanMenu) == 2 ? Globale.DaftarWarnaRGB[Event Giocatore.KursorWarna] : (Event Giocatore.HalamanMenu == -1 ? Event Giocatore.KursorUtama : Event Giocatore.HalamanMenu) == 3 ? Vector(185, 105, 255) : (Event Giocatore.HalamanMenu == -1 ? Event Giocatore.KursorUtama : Event Giocatore.HalamanMenu) == 4 ? Vector(255, 75, 85) : (Event Giocatore.HalamanMenu == -1 ? Event Giocatore.KursorUtama : Event Giocatore.HalamanMenu) == 5 ? Vector(255, 145, 55) : (Event Giocatore.HalamanMenu == -1 ? Event Giocatore.KursorUtama : Event Giocatore.HalamanMenu) == 6 ? Vector(255, 80, 205) : (Event Giocatore.HalamanMenu == -1 ? Event Giocatore.KursorUtama : Event Giocatore.HalamanMenu) == 7 ? Vector(170, 240, 85) : (Event Giocatore.HalamanMenu == -1 ? Event Giocatore.KursorUtama : Event Giocatore.HalamanMenu) == 8 ? Vector(65, 225, 130) : (Event Giocatore.HalamanMenu == -1 ? Event Giocatore.KursorUtama : Event Giocatore.HalamanMenu) == 9 ? Vector(55, 190, 170) : (Event Giocatore.HalamanMenu == -1 ? Event Giocatore.KursorUtama : Event Giocatore.HalamanMenu) == 10 ? Vector(255, 210, 70) : (Event Giocatore.HalamanMenu == -1 ? Event Giocatore.KursorUtama : Event Giocatore.HalamanMenu) == 11 ? Vector(255, 120, 155) : Vector(55, 235, 245), 0.180, Destination and Duration);
	}
}

regola("92 - Subrutin: Kunci bot/dummy, kaki tetap bisa bergerak")
{
	evento
	{
		Subroutine;
		KunciBot;
	}

	azioni
	{
		Abort If(Entity Exists(Event Giocatore) == False);
		Abort If(Is Vivo(Event Giocatore) == False);
		Event Giocatore.MenuTerbuka = False;
		Event Giocatore.SeranganDekatDipakai = False;
		Event Giocatore.HalamanMenu = -1;
		Set Fuoco Primario Enabled(Event Giocatore, False);
		Set Secondary Fire Enabled(Event Giocatore, False);
		Set Abilità 1 Enabled(Event Giocatore, False);
		Set Abilità 2 Enabled(Event Giocatore, False);
		Set Abilità Ultra Enabled(Event Giocatore, False);
		Set Melee Enabled(Event Giocatore, False);
		Disallow Button(Event Giocatore, Button(Fuoco Primario));
		Disallow Button(Event Giocatore, Button(Secondary Fire));
		Disallow Button(Event Giocatore, Button(Abilità 1));
		Disallow Button(Event Giocatore, Button(Abilità 2));
		Disallow Button(Event Giocatore, Button(Ultimate));
		Disallow Button(Event Giocatore, Button(Melee));
		Disallow Button(Event Giocatore, Button(Reload));
		Disallow Button(Event Giocatore, Button(Interagisci));
		Set Danni inflitti(Event Giocatore, 0);
		Set Cure fornite(Event Giocatore, 0);
		Set Knockback Distribuito(Event Giocatore, 0);
		Set Move Velocità Non Direzionale(Event Giocatore, 10);
		Event Giocatore.PahlawanBotTerakhir = Eroe Of(Event Giocatore);
		Event Giocatore.KunciBotAktif = True;
		Disable Nameplates(Event Giocatore, Filtered Array(Globale.PemainManusia, Giocatore Variable(Attuale Array Element, InspeksiAktif) == True));
	}
}

regola("91o - Subrutin: Gambar menu pilihan pemain")
{
	evento
	{
		Subroutine;
		GambarPilihan;
	}

	azioni
	{
		Create HUD Text(Event Giocatore, Null, Event Giocatore.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String("Hold CROUCH + command\n{0}: next | {1}: previous", Input Binding String(Button(Fuoco Primario)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: vote | {1}: back", Input Binding String(Button(Interagisci)), Input Binding String(Button(Reload)))) : Event Giocatore.IndeksBahasa == 1 ? Custom String("{0}\n{1}", Custom String("Tahan JONGKOK + perintah\n{0}: berikutnya | {1}: sebelumnya", Input Binding String(Button(Fuoco Primario)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: pilih | {1}: kembali", Input Binding String(Button(Interagisci)), Input Binding String(Button(Reload)))) : Custom String("{0}\n{1}", Custom String("กด ย่อ + คำสั่ง\n{0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Fuoco Primario)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: โหวต | {1}: กลับ", Input Binding String(Button(Interagisci)), Input Binding String(Button(Reload)))), Event Giocatore.IndeksBahasa == 0 ? Custom String("{0}\n> {1}", Custom String("11 - VOTE PLAYER {0}/{1}\nYOUR VOTE: {2}", Event Giocatore.KursorPilihan + 1, Count Of(Globale.PemainManusia), Event Giocatore.PemainDipilih != Null ? Event Giocatore.PemainDipilih : Custom String("NONE")), Count Of(Globale.PemainManusia) > 0 ? Custom String("{0} - {1} VOTES", Globale.PemainManusia[Event Giocatore.KursorPilihan], Globale.PemainManusia[Event Giocatore.KursorPilihan].JumlahPilihan) : Custom String("NO PLAYERS")) : Event Giocatore.IndeksBahasa == 1 ? Custom String("{0}\n> {1}", Custom String("11 - PILIH PEMAIN {0}/{1}\nPILIHAN KAMU: {2}", Event Giocatore.KursorPilihan + 1, Count Of(Globale.PemainManusia), Event Giocatore.PemainDipilih != Null ? Event Giocatore.PemainDipilih : Custom String("BELUM ADA")), Count Of(Globale.PemainManusia) > 0 ? Custom String("{0} - {1} SUARA", Globale.PemainManusia[Event Giocatore.KursorPilihan], Globale.PemainManusia[Event Giocatore.KursorPilihan].JumlahPilihan) : Custom String("TIDAK ADA PEMAIN")) : Custom String("{0}\n> {1}", Custom String("11 - โหวตผู้เล่น {0}/{1}\nโหวตของคุณ: {2}", Event Giocatore.KursorPilihan + 1, Count Of(Globale.PemainManusia), Event Giocatore.PemainDipilih != Null ? Event Giocatore.PemainDipilih : Custom String("ยังไม่ได้โหวต")), Count Of(Globale.PemainManusia) > 0 ? Custom String("{0} - {1} โหวต", Globale.PemainManusia[Event Giocatore.KursorPilihan], Globale.PemainManusia[Event Giocatore.KursorPilihan].JumlahPilihan) : Custom String("ไม่มีผู้เล่น")), Top, 100, Color(Bianco), Custom Color(235, 230, 190, 255), Custom Color(X Component Of(Event Giocatore.WarnaMenu), Y Component Of(Event Giocatore.WarnaMenu), Z Component Of(Event Giocatore.WarnaMenu), 255), Visibile a  String and Color, Visibile Mai);
		Event Giocatore.HudMenu = Last Text ID;
	}
}

regola("91q - Subrutin: Hitung ulang pilihan dan pemimpin tunggal")
{
	evento
	{
		Subroutine;
		HitungPilihan;
	}

	azioni
	{
		"JumlahPilihan tidak dihitung ulang di sini; nilainya diperbarui secara transaksional tepat saat pilihan diterapkan."
		Globale.PemimpinPilihan = Null;
		Globale.PilihanTerbanyak = 0;
		Globale.PilihanSeri = False;
		If(Count Of(Globale.PemainManusia) > 0);
			Globale.PemimpinPilihan = Primo Of(Sorted Array(Globale.PemainManusia, 0 - Giocatore Variable(Attuale Array Element, JumlahPilihan)));
			Globale.PilihanTerbanyak = Giocatore Variable(Globale.PemimpinPilihan, JumlahPilihan);
			If(Globale.PilihanTerbanyak > 0);
				Globale.PilihanSeri = Count Of(Filtered Array(Globale.PemainManusia, Giocatore Variable(Attuale Array Element, JumlahPilihan) == Globale.PilihanTerbanyak)) > 1;
				If(Globale.PilihanSeri == True);
					Globale.PemimpinPilihan = Null;
				End;
			Else;
				Globale.PemimpinPilihan = Null;
			End;
		End;
	}
}

regola("93 - Subrutin: Mulai kamera dinamis di bahu kiri")
{
	evento
	{
		Subroutine;
		MulaiKamera;
	}

	azioni
	{
		Abort If(Event Giocatore.TargetKamera == Null);
		Abort If(Entity Exists(Event Giocatore.TargetKamera) == False);
		"Ganti kamera langsung tanpa Stop Camera agar perpindahan target tidak berkedip satu bingkai."
		Avvio Camera(Event Giocatore, Update Every Frame(Primo Of(Mapped Array(Array(Ray Cast Colpisci Posizione(Eye Posizione(Event Giocatore.TargetKamera) + Vector(0, Minimo(0.750, Massimo(0.450, 0.450 + (Massimo Salute(Event Giocatore.TargetKamera) - 200) * 0.0006)), 0), Eye Posizione(Event Giocatore.TargetKamera) + Vector(0, Minimo(0.750, Massimo(0.450, 0.450 + (Massimo Salute(Event Giocatore.TargetKamera) - 200) * 0.0006)), 0) - Sguardo in Corso Direction Of(Event Giocatore.TargetKamera) * Minimo(4.500, Massimo(Globale.JarakKamera, Globale.JarakKamera + (Massimo Salute(Event Giocatore.TargetKamera) - 200) * 0.0055)) + Cross Product(Direction From Angles(Horizontal Sguardo in Corso Angolo Of(Event Giocatore.TargetKamera), 0), Vector(0, 1, 0)) * Minimo(1.350, Massimo(Globale.GeserKamera, Globale.GeserKamera + (Massimo Salute(Event Giocatore.TargetKamera) - 200) * 0.0016)), Empty Array, Empty Array, False)), Attuale Array Element + Direction Towards(Attuale Array Element, Eye Posizione(Event Giocatore.TargetKamera) + Vector(0, Minimo(0.750, Massimo(0.450, 0.450 + (Massimo Salute(Event Giocatore.TargetKamera) - 200) * 0.0006)), 0)) * Minimo(Globale.BantalanDinding, Distanza Between(Attuale Array Element, Eye Posizione(Event Giocatore.TargetKamera) + Vector(0, Minimo(0.750, Massimo(0.450, 0.450 + (Massimo Salute(Event Giocatore.TargetKamera) - 200) * 0.0006)), 0)) * 0.250)))), Update Every Frame(Eye Posizione(Event Giocatore.TargetKamera) + Sguardo in Corso Direction Of(Event Giocatore.TargetKamera) * Globale.JarakBidik), 0);
	}
}

regola("93a - Subrutin: Efek perubahan diterapkan")
{
	evento
	{
		Subroutine;
		EfekTerapkan;
	}

	azioni
	{
		Gioca Effect(All Giocatori(All Squadre), Ring Explosion, Globale.RGB, Posizione Of(Event Giocatore) + Vector(0, 1, 0), 3);
	}
}

regola("93b - Subrutin: Efek pengaturan dipulihkan")
{
	evento
	{
		Subroutine;
		EfekPulihkan;
	}

	azioni
	{
		Gioca Effect(All Giocatori(All Squadre), Ring Explosion, Globale.RGB, Posizione Of(Event Giocatore) + Vector(0, 1, 0), 3);
	}
}

regola("93b2 - Subrutin: Tenangkan pemicu sebelum pembersihan")
{
	evento
	{
		Subroutine;
		TenangkanPemain;
	}

	azioni
	{
		"Bersihkan Coba Nasib segera sebelum pendaftaran tim baru; bagian ini tidak pernah menjeda pemindaian."
		If(Event Giocatore.IkonKartuNasib != Null);
			Distruggi Icon(Event Giocatore.IkonKartuNasib);
		End;
		If(Event Giocatore.HudEfekNasib != Null);
			Distruggi HUD Text(Event Giocatore.HudEfekNasib);
		End;
		If(Event Giocatore.IkonKebal != Null);
			Distruggi Icon(Event Giocatore.IkonKebal);
		End;
		Clear Stato(Event Giocatore, Bruciatura in Corso);
		Clear Stato(Event Giocatore, Sabotato);
		Clear Stato(Event Giocatore, Unkillable);
		Interrompi Accelerating(Event Giocatore);
		Set Danni subiti(Event Giocatore, 100);
		Set Move Velocità Non Direzionale(Event Giocatore, 100);
		Set Velocità verticale di salto(Event Giocatore, 100);
		Set Velocità dei proiettili(Event Giocatore, 100);
		Set Gravity(Event Giocatore, 100);
		Event Giocatore.KebalAktif = False;
		Event Giocatore.ModeKebal = 0;
		Event Giocatore.KursorKebal = 0;
		Event Giocatore.IkonKebal = Null;
		Event Giocatore.IkonKartuNasib = Null;
		Event Giocatore.HudEfekNasib = Null;
		Event Giocatore.KartuNasibAktif = False;
		Event Giocatore.PutaranKartuNasib = 0;
		Event Giocatore.JedaKartuNasib = 0;
		Event Giocatore.EfekNasib = 0;
		Event Giocatore.EfekNasibBerakhir = 0;
		Event Giocatore.PrivasiNasibAktif = False;
		Event Giocatore.WaktuBakarNasibBerikut = 0;
		Event Giocatore.WaktuPutaranNasibBerikut = 0;
		Event Giocatore.WaktuIkonNasibBerakhir = 0;
		Event Giocatore.MenuNasibHarusDibuka = False;
		"Matikan semua pemicu sebelum acara keluar atau masuk menyelesaikan pembersihan dan pendaftaran baru."
		Event Giocatore.SudahSiap = False;
		Event Giocatore.Manusia = False;
		Event Giocatore.PerintahMenu = 0;
		Event Giocatore.InputMenuDikunci = False;
		Event Giocatore.SeranganDekatDipakai = False;
		Event Giocatore.MenuTerbuka = False;
		Event Giocatore.TeleportasiJongkokAktif = False;
		Event Giocatore.PerintahTeleportasi = 0;
		Event Giocatore.InspeksiAktif = False;
		Event Giocatore.TargetInspeksi = Null;
		Event Giocatore.InteraksiKameraDipakai = False;
	}
}

regola("93c - Subrutin: Bersihkan pemain saat keluar atau pindah tim")
{
	evento
	{
		Subroutine;
		BersihkanPemain;
	}

	azioni
	{
		"Pemicu sudah mati; pulihkan sistem dalam kelompok kecil lalu lakukan pembersihan atomik."
		Interrompi Camera(Event Giocatore);
		Interrompi Inseguimento in Corso Giocatore Variable(Event Giocatore, WarnaMenu);
		Clear Stato(Event Giocatore, Unkillable);
		Set Danni subiti(Event Giocatore, 100);
		Set Move Velocità Non Direzionale(Event Giocatore, 100);
		Set Velocità verticale di salto(Event Giocatore, 100);
		Set Velocità dei proiettili(Event Giocatore, 100);
		Set Gravity(Event Giocatore, 100);
		Interrompi Accelerating(Event Giocatore);
		Interrompi Forcing Giocatore Outlines(All Giocatori(All Squadre), Event Giocatore);
		Enable Movement Collision With Environment(Event Giocatore);
		Clear Stato(Event Giocatore, Bruciatura in Corso);
		Clear Stato(Event Giocatore, Sabotato);
		Interrompi Modifying Eroe Voice Lines(Event Giocatore);
		Allow Button(Event Giocatore, Button(Melee));
		Allow Button(Event Giocatore, Button(Salta));
		Allow Button(Event Giocatore, Button(Accovacciati));
		Allow Button(Event Giocatore, Button(Fuoco Primario));
		Allow Button(Event Giocatore, Button(Secondary Fire));
		Allow Button(Event Giocatore, Button(Interagisci));
		Allow Button(Event Giocatore, Button(Reload));
		Allow Button(Event Giocatore, Button(Abilità 1));
		Allow Button(Event Giocatore, Button(Abilità 2));
		Allow Button(Event Giocatore, Button(Ultimate));
		Set Fuoco Primario Enabled(Event Giocatore, True);
		Set Secondary Fire Enabled(Event Giocatore, True);
		Set Abilità 1 Enabled(Event Giocatore, True);
		Set Abilità 2 Enabled(Event Giocatore, True);
		Set Abilità Ultra Enabled(Event Giocatore, True);
		Set Melee Enabled(Event Giocatore, True);
		Enable Partita Mode HUD(Event Giocatore);
		Enable Partita Mode In-World UI(Event Giocatore);
		If(And(Event Giocatore.PemainDipilih != Null, And(Event Giocatore.PemainDipilih != Event Giocatore, Array Contains(Globale.PemainManusia, Event Giocatore.PemainDipilih))));
			Modify Giocatore Variable(Globale.PemainManusia[Index Of Array Value(Globale.PemainManusia, Event Giocatore.PemainDipilih)], JumlahPilihan, Subtract, 1);
			If(Globale.PemainManusia[Index Of Array Value(Globale.PemainManusia, Event Giocatore.PemainDipilih)].JumlahPilihan < 0);
				Set Giocatore Variable(Globale.PemainManusia[Index Of Array Value(Globale.PemainManusia, Event Giocatore.PemainDipilih)], JumlahPilihan, 0);
			End;
		End;
		Event Giocatore.PemainDipilih = Null;
		Event Giocatore.JumlahPilihan = 0;
		Event Giocatore.SudahSiap = False;
		Event Giocatore.SudahDiperiksa = False;
		Event Giocatore.Manusia = False;
		Event Giocatore.MenuTerbuka = False;
		Event Giocatore.InputMenuDikunci = False;
		Event Giocatore.HudPemainDibuat = False;
		If(Event Giocatore.IkonKartuNasib != Null);
			Distruggi Icon(Event Giocatore.IkonKartuNasib);
		End;
		If(Event Giocatore.HudEfekNasib != Null);
			Distruggi HUD Text(Event Giocatore.HudEfekNasib);
		End;
		If(Event Giocatore.TeksVisiNasib != Null);
			Distruggi In-World Text(Event Giocatore.TeksVisiNasib);
		End;
		Event Giocatore.IkonKartuNasib = Null;
		Event Giocatore.HudEfekNasib = Null;
		Event Giocatore.TeksVisiNasib = Null;
		Event Giocatore.KartuNasibAktif = False;
		Event Giocatore.PutaranKartuNasib = 0;
		Event Giocatore.JedaKartuNasib = 0;
		Event Giocatore.EfekNasib = 0;
		Event Giocatore.EfekNasibBerakhir = 0;
		Event Giocatore.PrivasiNasibAktif = False;
		Event Giocatore.WaktuBakarNasibBerikut = 0;
		Event Giocatore.WaktuPutaranNasibBerikut = 0;
		Event Giocatore.WaktuIkonNasibBerakhir = 0;
		Event Giocatore.MenuNasibHarusDibuka = False;
		If(Event Giocatore.TeksTeleportasi != Null);
			Distruggi In-World Text(Event Giocatore.TeksTeleportasi);
		End;
		Event Giocatore.TeksTeleportasi = Null;
		Event Giocatore.TargetTeleportasiTeks = Null;
		"Satu jeda sebelum bagian kritis; setelah variabel kerja Global dipakai, pembersihan harus atomik tanpa Wait."
		Attendi(0.016, Ignora condizione);
		Globale.IndeksKeluar = Index Of Array Value(Globale.PemainManusia, Event Giocatore);
		If(And(Globale.IndeksKeluar < 0, Event Giocatore.UrutanHUD >= 0));
			Globale.IndeksKeluar = Index Of Array Value(Globale.SlotHUDPemain, Event Giocatore.UrutanHUD);
		End;
		If(Globale.IndeksKeluar < 0);
			Globale.IndeksKeluar = Index Of Array Value(Mapped Array(Globale.PemainManusia, Custom String("{0}", Attuale Array Element)), Custom String("{0}", Event Giocatore));
		End;
		Globale.PemainPembersihan = Globale.IndeksKeluar >= 0 ? Globale.PemainManusia[Globale.IndeksKeluar] : Event Giocatore;
		If(Globale.IndeksKeluar >= 0);
			If(Event Giocatore.IkonKebal != Null);
				Distruggi Icon(Event Giocatore.IkonKebal);
				Event Giocatore.IkonKebal = Null;
			End;
			If(Event Giocatore.PelatNamaDinonaktifkan == True);
				Enable Nameplates(All Giocatori(All Squadre), Event Giocatore);
			End;
			Distruggi HUD Text(Globale.HudKiriPemain[Globale.IndeksKeluar]);
			Distruggi HUD Text(Globale.HudKananPemain[Globale.IndeksKeluar]);
			If(Giocatore Variable(Globale.PemainPembersihan, HudMenu) != Null);
				Distruggi HUD Text(Giocatore Variable(Globale.PemainPembersihan, HudMenu));
			End;
			Globale.PemainPembersihan.HudMenu = Null;
			If(Globale.TeksDuniaPemain[Globale.IndeksKeluar] != 0);
				Distruggi In-World Text(Globale.TeksDuniaPemain[Globale.IndeksKeluar]);
			End;
			Globale.SlotHUDTersedia = Sorted Array(Append To Array(Globale.SlotHUDTersedia, Globale.SlotHUDPemain[Globale.IndeksKeluar]), Attuale Array Element);
			Modify Globale Variable(HudKiriPemain, Remove From Array By Index, Globale.IndeksKeluar);
			Modify Globale Variable(HudKananPemain, Remove From Array By Index, Globale.IndeksKeluar);
			Modify Globale Variable(HudMenuPemain, Remove From Array By Index, Globale.IndeksKeluar);
			Modify Globale Variable(TeksDuniaPemain, Remove From Array By Index, Globale.IndeksKeluar);
			Modify Globale Variable(SlotHUDPemain, Remove From Array By Index, Globale.IndeksKeluar);
			Modify Globale Variable(PemainManusia, Remove From Array By Index, Globale.IndeksKeluar);
			Globale.SlotHUDTerakhir = Count Of(Globale.SlotHUDPemain) == 0 ? -1 : Last Of(Sorted Array(Globale.SlotHUDPemain, Attuale Array Element));
		End;
		For Globale Variable(IndeksPemilih, 0, Count Of(Globale.PemainManusia), 1);
			If(Globale.PemainManusia[Globale.IndeksPemilih].PemainDipilih == Globale.PemainPembersihan);
				Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPemilih], PemainDipilih, Null);
			End;
			Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPemilih], KursorPilihan, Count Of(Globale.PemainManusia) == 0 ? 0 : Minimo(Giocatore Variable(Globale.PemainManusia[Globale.IndeksPemilih], KursorPilihan), Count Of(Globale.PemainManusia) - 1));
		End;
		Call Subroutine(HitungPilihan);
		"Bersihkan semua referensi pemain yang keluar dari utang balas dendam milik pemain yang masih ada."
		For Globale Variable(IndeksPembersihan, 0, Count Of(Globale.PemainManusia), 1);
			Globale.IndeksUtangKeluar = Index Of Array Value(Globale.PemainManusia[Globale.IndeksPembersihan].PembunuhBalasDendam, Globale.PemainPembersihan);
			If(Globale.IndeksUtangKeluar >= 0);
				Modify Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], PembunuhBalasDendam, Remove From Array By Index, Globale.IndeksUtangKeluar);
				Modify Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], JumlahBalasDendam, Remove From Array By Index, Globale.IndeksUtangKeluar);
			End;
			If(Globale.PemainManusia[Globale.IndeksPembersihan].TargetKamera == Globale.PemainPembersihan);
				Interrompi Camera(Globale.PemainManusia[Globale.IndeksPembersihan]);
				Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], ModeKamera, 0);
				Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], TargetKamera, Null);
			End;
			If(Globale.PemainManusia[Globale.IndeksPembersihan].TargetInspeksi == Globale.PemainPembersihan);
				Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], TargetInspeksi, Null);
			End;
			Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetKamera, Filtered Array(Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetKamera), Attuale Array Element != Globale.PemainPembersihan));
			Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetBalasDendam, Filtered Array(Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetBalasDendam), Attuale Array Element != Globale.PemainPembersihan));
			Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetTeleportasi, Filtered Array(Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetTeleportasi), Attuale Array Element != Globale.PemainPembersihan));
			Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetInspeksi, Filtered Array(Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetInspeksi), Attuale Array Element != Globale.PemainPembersihan));
			Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], KursorKamera, Minimo(Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], KursorKamera), Count Of(Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetKamera)) + 1));
			Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], KursorBalasDendam, Count Of(Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetBalasDendam)) == 0 ? 0 : Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], KursorBalasDendam) % Count Of(Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetBalasDendam)));
			Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], KursorTeleportasi, Count Of(Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetTeleportasi)) == 0 ? 0 : Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], KursorTeleportasi) % Count Of(Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetTeleportasi)));
			If(Globale.PemainManusia[Globale.IndeksPembersihan].CalonTargetKamera == Globale.PemainPembersihan);
				Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], CalonTargetKamera, Null);
			End;
			If(Globale.PemainManusia[Globale.IndeksPembersihan].CalonTargetTeleportasi == Globale.PemainPembersihan);
				Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], CalonTargetTeleportasi, Null);
			End;
			If(Globale.PemainManusia[Globale.IndeksPembersihan].TargetTeleportasiTerkunci == Globale.PemainPembersihan);
				Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], TargetTeleportasiTerkunci, Null);
			End;
			If(Globale.PemainManusia[Globale.IndeksPembersihan].TargetBalasDendamDipilih == Globale.PemainPembersihan);
				Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], TargetBalasDendamDipilih, Null);
			End;
			If(Globale.PemainManusia[Globale.IndeksPembersihan].TargetBalasDendamTerkunci == Globale.PemainPembersihan);
				Set Giocatore Variable(Globale.PemainManusia[Globale.IndeksPembersihan], TargetBalasDendamTerkunci, Null);
			End;
		End;
		Globale.IndeksKeluar = -1;
		Globale.PemainPembersihan = Null;
	}
}

regola("94 - Subrutin: Siapkan pemain dari ujung rambut sampai variabel")
{
	evento
	{
		Subroutine;
		SiapkanPemain;
	}

	azioni
	{
		Abort If(Is Dummy Bot(Event Giocatore));
		Event Giocatore.WaktuMasuk = Totale Tempo Elapsed;
		Event Giocatore.SudahDiperiksa = False;
		Event Giocatore.BotOtomatis = False;
		Event Giocatore.Manusia = False;
		Event Giocatore.MenitLobi = 0;
		Event Giocatore.IndeksGenre = -1;
		Event Giocatore.UrutanHUD = -1;
		Event Giocatore.HudKiri = Null;
		Event Giocatore.HudKanan = Null;
		Event Giocatore.HudPemainDibuat = False;
		Event Giocatore.MenuTerbuka = False;
		Event Giocatore.KursorGenre = 0;
		Event Giocatore.HudMenu = Null;
		Event Giocatore.InspeksiAktif = False;
		Event Giocatore.TargetInspeksi = Null;
		Event Giocatore.TeksDunia = Null;
		Event Giocatore.ModeKamera = 0;
		Event Giocatore.TargetKamera = Null;
		Event Giocatore.SeranganDekatDipakai = False;
		Event Giocatore.HalamanMenu = -1;
		Event Giocatore.KursorUtama = 0;
		Event Giocatore.KursorKamera = 0;
		Event Giocatore.KursorWarna = 0;
		Event Giocatore.IndeksWarna = 0;
		Event Giocatore.WarnaNama = Color(Bianco);
		Event Giocatore.CalonTargetKamera = Null;
		Event Giocatore.IndeksBahasa = 0;
		Event Giocatore.KursorBahasa = 0;
		Event Giocatore.DaftarTargetKamera = Empty Array;
		Event Giocatore.KursorBalasDendam = 0;
		Event Giocatore.DaftarTargetBalasDendam = Empty Array;
		Event Giocatore.PembunuhBalasDendam = Empty Array;
		Event Giocatore.JumlahBalasDendam = Empty Array;
		Event Giocatore.IndeksBalasDendam = -1;
		Event Giocatore.KematianBalasDendam = False;
		Event Giocatore.KursorTeleportasi = 0;
		Event Giocatore.DaftarTargetTeleportasi = Empty Array;
		Event Giocatore.CalonTargetTeleportasi = Null;
		Event Giocatore.TargetTeleportasiTeks = Null;
		Event Giocatore.TeksTeleportasi = Null;
		Event Giocatore.InputMenuDikunci = False;
		Event Giocatore.TargetBalasDendamTerkunci = Null;
		Event Giocatore.TargetBalasDendamDipilih = Null;
		Event Giocatore.PelatNamaDinonaktifkan = False;
		Event Giocatore.KunciBotAktif = False;
		Event Giocatore.PahlawanBotTerakhir = Null;
		Event Giocatore.DaftarTargetInspeksi = Empty Array;
		Event Giocatore.PerintahMenu = 0;
		Event Giocatore.JenisTeleportasiTerkunci = -1;
		Event Giocatore.TargetTeleportasiTerkunci = Null;
		Event Giocatore.KebalAktif = False;
		Event Giocatore.KursorKebal = 0;
		Event Giocatore.IndeksSuara = 0;
		Event Giocatore.KursorSuara = 0;
		Event Giocatore.TeleportasiJongkokAktif = False;
		Event Giocatore.PerintahTeleportasi = 0;
		Event Giocatore.InteraksiKameraDipakai = False;
		Event Giocatore.PosisiMati = Vector(0, 0, 0);
		Event Giocatore.PosisiBangkitAman = Vector(0, 0, 0);
		Event Giocatore.BangkitLompatDipakai = False;
		Event Giocatore.IndeksIkon = 0;
		Event Giocatore.KursorIkon = 0;
		Event Giocatore.WarnaMenu = Vector(55, 235, 245);
		Event Giocatore.TeleportasiJongkokDiaktifkan = False;
		Event Giocatore.KursorTeleportasiJongkok = 0;
		Event Giocatore.PrivasiInspeksiAktif = True;
		Event Giocatore.KursorPrivasiInspeksi = 1;
		Event Giocatore.ModeKebal = 0;
		Event Giocatore.IkonKebal = Null;
		Event Giocatore.KartuNasibAktif = False;
		Event Giocatore.IkonKartuNasib = Null;
		Event Giocatore.KursorPilihan = 0;
		Event Giocatore.PemainDipilih = Null;
		Event Giocatore.JumlahPilihan = 0;
		Event Giocatore.PutaranKartuNasib = 0;
		Event Giocatore.JedaKartuNasib = 0;
		Event Giocatore.EfekNasib = 0;
		Event Giocatore.EfekNasibBerakhir = 0;
		Event Giocatore.PrivasiNasibAktif = False;
		Event Giocatore.WaktuBakarNasibBerikut = 0;
		Event Giocatore.WaktuPutaranNasibBerikut = 0;
		Event Giocatore.WaktuIkonNasibBerakhir = 0;
		Event Giocatore.MenuNasibHarusDibuka = False;
		Event Giocatore.HudEfekNasib = Null;
		Event Giocatore.TeksVisiNasib = Null;
		Event Giocatore.TimTerakhir = Squadra Of(Event Giocatore);
		Event Giocatore.PernahDisiapkan = True;
		Event Giocatore.PindahTimDiproses = True;
		Event Giocatore.SiklusPemainAktif = False;
		Event Giocatore.SudahSiap = True;
	}
}

regola("95 - Subrutin: Segarkan daftar tontonan, termasuk para bot")
{
	evento
	{
		Subroutine;
		SegarkanTargetKamera;
	}

	azioni
	{
		If(And(Event Giocatore.KursorKamera >= 2, Event Giocatore.KursorKamera - 2 < Count Of(Event Giocatore.DaftarTargetKamera)));
			Event Giocatore.CalonTargetKamera = Event Giocatore.DaftarTargetKamera[Event Giocatore.KursorKamera - 2];
		Else;
			Event Giocatore.CalonTargetKamera = Null;
		End;
		Event Giocatore.DaftarTargetKamera = Filtered Array(All Giocatori(All Squadre), And(Attuale Array Element != Event Giocatore, And(Entity Exists(Attuale Array Element), And(Has Generato(Attuale Array Element), And(Is Vivo(Attuale Array Element), Or(Is Dummy Bot(Attuale Array Element) == True, Or(Giocatore Variable(Attuale Array Element, BotOtomatis) == True, And(Giocatore Variable(Attuale Array Element, Manusia) == True, Giocatore Variable(Attuale Array Element, PrivasiInspeksiAktif) == False))))))));
		If(And(Event Giocatore.CalonTargetKamera != Null, Array Contains(Event Giocatore.DaftarTargetKamera, Event Giocatore.CalonTargetKamera)));
			Event Giocatore.KursorKamera = Index Of Array Value(Event Giocatore.DaftarTargetKamera, Event Giocatore.CalonTargetKamera) + 2;
		Else If(Event Giocatore.KursorKamera >= Count Of(Event Giocatore.DaftarTargetKamera) + 2);
			Event Giocatore.KursorKamera = 0;
		End;
	}
}

regola("96 - Subrutin: Cari target publik terdekat dari bidikan")
{
	evento
	{
		Subroutine;
		SegarkanTargetInspeksi;
	}

	azioni
	{
		Event Giocatore.DaftarTargetInspeksi = Filtered Array(All Giocatori(All Squadre), And(Attuale Array Element != Event Giocatore, And(Entity Exists(Attuale Array Element), And(Is Vivo(Attuale Array Element), Or(Is Dummy Bot(Attuale Array Element) == True, Or(Giocatore Variable(Attuale Array Element, BotOtomatis) == True, Or(Event Giocatore.PrivasiNasibAktif == True, And(Giocatore Variable(Attuale Array Element, Manusia) == True, Giocatore Variable(Attuale Array Element, PrivasiInspeksiAktif) == False))))))));
		If(Count Of(Event Giocatore.DaftarTargetInspeksi) == 0);
			Event Giocatore.TargetInspeksi = Null;
		Else;
			Event Giocatore.TargetInspeksi = Primo Of(Sorted Array(Event Giocatore.DaftarTargetInspeksi, Angolo Between Vectors(Sguardo in Corso Direction Of(Event Giocatore), Direction Towards(Eye Posizione(Event Giocatore), Eye Posizione(Attuale Array Element)))));
		End;
	}
}

regola("97 - Subrutin: Segarkan daftar target balas dendam")
{
	evento
	{
		Subroutine;
		SegarkanTargetBalasDendam;
	}

	azioni
	{
		If(Event Giocatore.KursorBalasDendam < Count Of(Event Giocatore.DaftarTargetBalasDendam));
			Event Giocatore.TargetBalasDendamDipilih = Event Giocatore.DaftarTargetBalasDendam[Event Giocatore.KursorBalasDendam];
		Else;
			Event Giocatore.TargetBalasDendamDipilih = Null;
		End;
		Event Giocatore.DaftarTargetBalasDendam = Filtered Array(Globale.PemainManusia, Attuale Array Element != Event Giocatore);
		If(Count Of(Event Giocatore.DaftarTargetBalasDendam) == 0);
			Event Giocatore.KursorBalasDendam = 0;
		Else If(And(Event Giocatore.TargetBalasDendamDipilih != Null, Array Contains(Event Giocatore.DaftarTargetBalasDendam, Event Giocatore.TargetBalasDendamDipilih)));
			Event Giocatore.KursorBalasDendam = Index Of Array Value(Event Giocatore.DaftarTargetBalasDendam, Event Giocatore.TargetBalasDendamDipilih);
		Else If(Event Giocatore.KursorBalasDendam >= Count Of(Event Giocatore.DaftarTargetBalasDendam));
			Event Giocatore.KursorBalasDendam = 0;
		End;
	}
}

regola("98 - Subrutin: Cari target teleport publik terdekat dari bidikan")
{
	evento
	{
		Subroutine;
		SegarkanTargetTeleportasi;
	}

	azioni
	{
		Event Giocatore.DaftarTargetTeleportasi = Filtered Array(All Giocatori(All Squadre), And(Attuale Array Element != Event Giocatore, And(Entity Exists(Attuale Array Element), And(Is Vivo(Attuale Array Element), Or(Is Dummy Bot(Attuale Array Element) == True, Or(Giocatore Variable(Attuale Array Element, BotOtomatis) == True, And(Giocatore Variable(Attuale Array Element, Manusia) == True, Giocatore Variable(Attuale Array Element, PrivasiInspeksiAktif) == False)))))));
		If(Count Of(Event Giocatore.DaftarTargetTeleportasi) == 0);
			Event Giocatore.CalonTargetTeleportasi = Null;
		Else;
			Event Giocatore.CalonTargetTeleportasi = Primo Of(Sorted Array(Event Giocatore.DaftarTargetTeleportasi, Angolo Between Vectors(Sguardo in Corso Direction Of(Event Giocatore), Direction Towards(Eye Posizione(Event Giocatore), Eye Posizione(Attuale Array Element)))));
		End;
	}
}
