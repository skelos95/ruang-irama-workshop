regola("18i - Nasib: Visi menampilkan semua nama pemain dan bot")
{
	evento
	{
		Ongoing - Each Player;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Or(Event Player.TeksVisiNasib == Null, Event Player.TeksVisiNasib == 0) == True;
		Is Alive(Event Player) == True;
		Or(Is Dummy Bot(Event Player) == True, Or(Event Player.BotOtomatis == True, Event Player.Manusia == True)) == True;
		Count Of(Filtered Array(All Players(All Teams), And(Current Array Element != Event Player, And(Player Variable(Current Array Element, Manusia) == True, Player Variable(Current Array Element, PrivasiNasibAktif) == True)))) > 0;
	}

	azioni
	{
		Create In-World Text(Filtered Array(All Players(All Teams), And(Current Array Element != Event Player, And(Player Variable(Current Array Element, Manusia) == True, Player Variable(Current Array Element, PrivasiNasibAktif) == True))), Custom String("{0} {1} | {2}", Hero Icon String(Is Duplicating(Event Player) ? Hero Being Duplicated(Event Player) : Hero Of(Event Player)), Event Player.Manusia == True ? Event Player.NamaTampilan : Custom String("{0}", Event Player), Round To Integer(Health(Event Player), Down)), Update Every Frame(Eye Position(Evaluate Once(Event Player)) + Vector(0, 0.450, 0)), 1.100, Do Not Clip, Visible To Position String and Color, Event Player.Manusia == True ? Event Player.WarnaNama : Custom Color(236, 153, 0, 255), Visible Never);
		Event Player.TeksVisiNasib = Last Text ID;
	}
}

regola("18j - Nasib: Bersihkan nama visi saat tidak diperlukan")
{
	evento
	{
		Ongoing - Each Player;
		Tutti;
		Tutti;
	}

	condizioni
	{
		And(Event Player.TeksVisiNasib != Null, Event Player.TeksVisiNasib != 0) == True;
		Or(Is Alive(Event Player) == False, Count Of(Filtered Array(All Players(All Teams), And(Current Array Element != Event Player, And(Player Variable(Current Array Element, Manusia) == True, Player Variable(Current Array Element, PrivasiNasibAktif) == True)))) == 0) == True;
	}

	azioni
	{
		Destroy In-World Text(Event Player.TeksVisiNasib);
		Event Player.TeksVisiNasib = Null;
	}
}

regola("18k - Nasib: HUD efek dan durasi saat menu tertutup")
{
	evento
	{
		Ongoing - Each Player;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Player.Manusia == True;
		Event Player.KartuNasibAktif == True;
		Event Player.PutaranKartuNasib == 0;
		Event Player.EfekNasibBerakhir > 0;
		Event Player.HudEfekNasib == Null;
		Is Alive(Event Player) == True;
	}

	azioni
	{
		Create HUD Text(Event Player, Null, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Event Player.EfekNasib == 1 ? Custom String("VISION: ALL PLAYER / BOT NAMES") : Event Player.EfekNasib == 2 ? Custom String("AIM-STEERED ACCELERATION") : Event Player.EfekNasib == 5 ? Custom String("BURNING: 5% MAX HP / SEC") : Custom String("HACKED"), Custom String("{0}s REMAINING", Max(0, Round To Integer(Event Player.EfekNasibBerakhir - Total Time Elapsed, Up)))) : Event Player.IndeksBahasa == 1 ? Custom String("{0}\n{1}", Event Player.EfekNasib == 1 ? Custom String("VISI: SEMUA NAMA PLAYER / BOT") : Event Player.EfekNasib == 2 ? Custom String("AKSELERASI MENGIKUTI BIDIKAN") : Event Player.EfekNasib == 5 ? Custom String("TERBAKAR: 5% HP MAKS / DETIK") : Custom String("DIRETAS"), Custom String("TERSISA {0}dtk", Max(0, Round To Integer(Event Player.EfekNasibBerakhir - Total Time Elapsed, Up)))) : Custom String("{0}\n{1}", Event Player.EfekNasib == 1 ? Custom String("วิสัยทัศน์: ชื่อผู้เล่นทั้งหมด / บอต") : Event Player.EfekNasib == 2 ? Custom String("เร่งความเร็วตามทิศเล็ง") : Event Player.EfekNasib == 5 ? Custom String("ไฟไหม้: 5% HP สูงสุด / วินาที") : Custom String("ถูกแฮ็ก"), Custom String("เหลือ {0} วินาที", Max(0, Round To Integer(Event Player.EfekNasibBerakhir - Total Time Elapsed, Up)))), Top, 3, Custom Color(255, 255, 255, 255), Custom Color(255, 255, 255, 255), Globale.RGB, Visible To String and Color, Visible Never);
		Event Player.HudEfekNasib = Last Text ID;
	}
}

regola("19 - Teleportasi Jongkok: Buka lima halaman selama Jongkok ditahan")
{
	evento
	{
		Ongoing - Each Player;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Event Player.MenuTerbuka == False;
		Event Player.KartuNasibAktif == False;
		Event Player.PrivasiNasibAktif == False;
		Event Player.TeleportasiJongkokAktif == False;
		Event Player.TeleportasiJongkokDiaktifkan == True;
		Has Spawned(Event Player) == True;
		Is Alive(Event Player) == True;
		Is Button Held(Event Player, Button(Crouch)) == True;
	}

	azioni
	{
		Event Player.TeleportasiJongkokAktif = True;
		Event Player.PerintahTeleportasi = 0;
		Event Player.DaftarTargetTeleportasi = Empty Array;
		Event Player.CalonTargetTeleportasi = Null;
		Event Player.JenisTeleportasiTerkunci = -1;
		Event Player.TargetTeleportasiTerkunci = Null;
		Disallow Button(Event Player, Button(Primary Fire));
		Disallow Button(Event Player, Button(Secondary Fire));
		Disallow Button(Event Player, Button(Interact));
		Call Subroutine(TransisiWarnaMenu);
		Call Subroutine(GambarTeleportasi);
	}
}

regola("19a - Teleportasi Jongkok: Primary maju, Secondary mundur, Interact jalankan")
{
	evento
	{
		Ongoing - Each Player;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Player.TeleportasiJongkokAktif == True;
		Event Player.PerintahTeleportasi == 0;
		Is Button Held(Event Player, Button(Crouch)) == True;
		Or(Or(Is Button Held(Event Player, Button(Primary Fire)), Is Button Held(Event Player, Button(Secondary Fire))), Is Button Held(Event Player, Button(Interact))) == True;
	}

	azioni
	{
		If(Is Button Held(Event Player, Button(Primary Fire)));
			Event Player.PerintahTeleportasi = 1;
		Else If(Is Button Held(Event Player, Button(Secondary Fire)));
			Event Player.PerintahTeleportasi = 2;
		Else;
			Event Player.PerintahTeleportasi = 3;
		End;
	}
}

regola("19b - Teleportasi Jongkok: Lepaskan pengunci navigasi dan aksi")
{
	evento
	{
		Ongoing - Each Player;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Player.TeleportasiJongkokAktif == True;
		Event Player.PerintahTeleportasi != 0;
		Is Button Held(Event Player, Button(Primary Fire)) == False;
		Is Button Held(Event Player, Button(Secondary Fire)) == False;
		Is Button Held(Event Player, Button(Interact)) == False;
	}

	azioni
	{
		Event Player.PerintahTeleportasi = 0;
	}
}

regola("19c - Teleportasi Jongkok: Primary maju dan Secondary mundur lima halaman")
{
	evento
	{
		Ongoing - Each Player;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Player.TeleportasiJongkokAktif == True;
		Or(Event Player.PerintahTeleportasi == 1, Event Player.PerintahTeleportasi == 2) == True;
	}

	azioni
	{
		Event Player.KursorTeleportasi = (Event Player.KursorTeleportasi + (Event Player.PerintahTeleportasi == 1 ? 1 : 4)) % 5;
		If(And(Event Player.KursorTeleportasi != 2, Event Player.KursorTeleportasi != 3));
			Event Player.CalonTargetTeleportasi = Null;
			If(Event Player.TeksTeleportasi != Null);
				Destroy In-World Text(Event Player.TeksTeleportasi);
			End;
			Event Player.TeksTeleportasi = Null;
			Event Player.TargetTeleportasiTeks = Null;
			If(Event Player.PelatNamaDinonaktifkan == True);
				Enable Nameplates(All Players(All Teams), Event Player);
				Event Player.PelatNamaDinonaktifkan = False;
			End;
		Else;
			If(Event Player.TeksDunia != Null);
				Destroy In-World Text(Event Player.TeksDunia);
			End;
			If(Index Of Array Value(Globale.PemainManusia, Event Player) >= 0);
				Globale.TeksDuniaPemain[Index Of Array Value(Globale.PemainManusia, Event Player)] = 0;
			End;
			Event Player.TeksDunia = Null;
			Event Player.TargetInspeksi = Null;
			Event Player.InspeksiAktif = False;
			If(Event Player.TeksTeleportasi != Null);
				Destroy In-World Text(Event Player.TeksTeleportasi);
			End;
			Event Player.TeksTeleportasi = Null;
			Event Player.TargetTeleportasiTeks = Null;
			Call Subroutine(SegarkanTargetTeleportasi);
		End;
		Call Subroutine(TransisiWarnaMenu);
		Call Subroutine(GambarTeleportasi);
	}
}

regola("19d - Teleportasi Jongkok: Buat ulang nama saat target berubah")
{
	evento
	{
		Ongoing - Each Player;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Player.Manusia == True;
		Event Player.TeleportasiJongkokAktif == True;
		Or(Event Player.KursorTeleportasi == 2, Event Player.KursorTeleportasi == 3) == True;
		Is Alive(Event Player) == True;
		Is Button Held(Event Player, Button(Crouch)) == True;
		Event Player.TargetTeleportasiTeks != Event Player.CalonTargetTeleportasi;
	}

	azioni
	{
		If(Event Player.TeksTeleportasi != Null);
			Destroy In-World Text(Event Player.TeksTeleportasi);
		End;
		Event Player.TeksTeleportasi = Null;
		If(Event Player.CalonTargetTeleportasi == Null);
			Event Player.TargetTeleportasiTeks = Null;
			Abort;
		End;
		Disable Nameplates(All Players(All Teams), Event Player);
		Event Player.PelatNamaDinonaktifkan = True;
		Create In-World Text(Event Player, Custom String("{0} {1} | {2}", Hero Icon String(Is Duplicating(Event Player.CalonTargetTeleportasi) ? Hero Being Duplicated(Event Player.CalonTargetTeleportasi) : Hero Of(Event Player.CalonTargetTeleportasi)), Player Variable(Event Player.CalonTargetTeleportasi, Manusia) == True ? Player Variable(Event Player.CalonTargetTeleportasi, NamaTampilan) : Custom String("{0}", Event Player.CalonTargetTeleportasi), Round To Integer(Health(Event Player.CalonTargetTeleportasi), Down)), Update Every Frame(Eye Position(Evaluate Once(Event Player.CalonTargetTeleportasi)) + Vector(0, 0.450, 0)), 1.100, Do Not Clip, Visible To Position String and Color, Player Variable(Event Player.CalonTargetTeleportasi, Manusia) == True ? Player Variable(Event Player.CalonTargetTeleportasi, WarnaNama) : Custom Color(236, 153, 0, 255), Visible Never);
		Event Player.TeksTeleportasi = Last Text ID;
		Event Player.TargetTeleportasiTeks = Event Player.CalonTargetTeleportasi;
	}
}

regola("19e - Teleportasi Jongkok: Interact menjalankan halaman aktif")
{
	evento
	{
		Ongoing - Each Player;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Player.TeleportasiJongkokAktif == True;
		Event Player.PerintahTeleportasi == 3;
	}

	azioni
	{
		Event Player.JenisTeleportasiTerkunci = Event Player.KursorTeleportasi;
		Event Player.TargetTeleportasiTerkunci = Null;
		If(Or(Event Player.JenisTeleportasiTerkunci == 2, Event Player.JenisTeleportasiTerkunci == 3));
			Call Subroutine(SegarkanTargetTeleportasi);
			Event Player.TargetTeleportasiTerkunci = Event Player.CalonTargetTeleportasi;
		End;
		If(Event Player.JenisTeleportasiTerkunci == 0);
			Call Subroutine(TeleportKeSpawn);
		Else If(Event Player.JenisTeleportasiTerkunci == 1);
			Call Subroutine(TeleportKeObjektif);
		Else If(Event Player.JenisTeleportasiTerkunci == 2);
			Call Subroutine(TeleportKeTarget);
		Else If(Event Player.JenisTeleportasiTerkunci == 3);
			If(Or(Or(Event Player.TargetTeleportasiTerkunci == Null, Entity Exists(Event Player.TargetTeleportasiTerkunci) == False), Or(Has Spawned(Event Player.TargetTeleportasiTerkunci) == False, Is Alive(Event Player.TargetTeleportasiTerkunci) == False)));
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Attach target unavailable.") : Event Player.IndeksBahasa == 1 ? Custom String("Target tempel tidak tersedia.") : Custom String("เป้าหมายสำหรับเกาะไม่พร้อมใช้งาน"));
			Else If(And(Player Variable(Event Player.TargetTeleportasiTerkunci, LampiranTeleportasiAktif) == True, Player Variable(Event Player.TargetTeleportasiTerkunci, TargetLampiranTeleportasi) == Event Player));
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Attach refused: that would create a loop.") : Event Player.IndeksBahasa == 1 ? Custom String("Tempel ditolak: itu akan membuat lingkaran.") : Custom String("ไม่สามารถเกาะได้ เพราะจะเกิดวงวน"));
			Else;
				If(Event Player.LampiranTeleportasiAktif == True);
					Detach Players(Event Player);
				End;
				Event Player.TargetLampiranTeleportasi = Event Player.TargetTeleportasiTerkunci;
				Event Player.PahlawanLampiranSendiri = Hero Of(Event Player);
				Event Player.PahlawanLampiranTarget = Hero Of(Event Player.TargetLampiranTeleportasi);
				Event Player.LampiranTeleportasiAktif = True;
				Attach Players(Event Player, Event Player.TargetLampiranTeleportasi, Vector(0, Y Component Of(Eye Position(Event Player.TargetLampiranTeleportasi)) - Y Component Of(Position Of(Event Player.TargetLampiranTeleportasi)) + 0.750, 0));
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Attached to {0}. CROUCH + RELOAD: detach.", Event Player.TargetLampiranTeleportasi) : Event Player.IndeksBahasa == 1 ? Custom String("Menempel di atas {0}. JONGKOK + RELOAD untuk lepas.", Event Player.TargetLampiranTeleportasi) : Custom String("เกาะอยู่เหนือ {0} กดย่อ + รีโหลดเพื่อปล่อย", Event Player.TargetLampiranTeleportasi));
			End;
		Else;
			If(Total Time Elapsed >= Event Player.WaktuBunuhDiriBerikut);
				Event Player.WaktuBunuhDiriBerikut = Total Time Elapsed + 3;
				Clear Status(Event Player, Unkillable);
				Set Damage Received(Event Player, 100);
				Kill(Event Player, Null);
			Else;
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Self Elimination ready in {0}s.", Round To Integer(Event Player.WaktuBunuhDiriBerikut - Total Time Elapsed, Up)) : Event Player.IndeksBahasa == 1 ? Custom String("Bunuh Diri siap dalam {0} dtk.", Round To Integer(Event Player.WaktuBunuhDiriBerikut - Total Time Elapsed, Up)) : Custom String("ฆ่าตัวเองได้อีกครั้งใน {0} วินาที", Round To Integer(Event Player.WaktuBunuhDiriBerikut - Total Time Elapsed, Up)));
			End;
		End;
		Event Player.JenisTeleportasiTerkunci = -1;
		Event Player.TargetTeleportasiTerkunci = Null;
	}
}

regola("19f - Teleportasi Jongkok: Reload melepas lampiran")
{
	evento
	{
		Ongoing - Each Player;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Player.LampiranTeleportasiAktif == True;
		Event Player.MenuTerbuka == False;
		Is Button Held(Event Player, Button(Crouch)) == True;
		Is Button Held(Event Player, Button(Reload)) == True;
	}

	azioni
	{
		Detach Players(Event Player);
		Set Player Variable(Event Player, LampiranTeleportasiAktif, False);
		Set Player Variable(Event Player, TargetLampiranTeleportasi, Null);
		Set Player Variable(Event Player, PahlawanLampiranSendiri, Null);
		Set Player Variable(Event Player, PahlawanLampiranTarget, Null);
	}
}

regola("19h - Teleportasi Jongkok: Lepas lampiran saat state berubah")
{
	evento
	{
		Ongoing - Each Player;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Player.LampiranTeleportasiAktif == True;
	}

	azioni
	{
		If(Or(Has Spawned(Event Player) == False, Is Alive(Event Player) == False));
		Detach Players(Event Player);
		Set Player Variable(Event Player, LampiranTeleportasiAktif, False);
		Set Player Variable(Event Player, TargetLampiranTeleportasi, Null);
		Set Player Variable(Event Player, PahlawanLampiranSendiri, Null);
		Set Player Variable(Event Player, PahlawanLampiranTarget, Null);
			Abort;
		End;
		If(Or(Event Player.TargetLampiranTeleportasi == Null, Entity Exists(Event Player.TargetLampiranTeleportasi) == False));
		Detach Players(Event Player);
		Set Player Variable(Event Player, LampiranTeleportasiAktif, False);
		Set Player Variable(Event Player, TargetLampiranTeleportasi, Null);
		Set Player Variable(Event Player, PahlawanLampiranSendiri, Null);
		Set Player Variable(Event Player, PahlawanLampiranTarget, Null);
			Abort;
		End;
		If(Or(Has Spawned(Event Player.TargetLampiranTeleportasi) == False, Is Alive(Event Player.TargetLampiranTeleportasi) == False));
		Detach Players(Event Player);
		Set Player Variable(Event Player, LampiranTeleportasiAktif, False);
		Set Player Variable(Event Player, TargetLampiranTeleportasi, Null);
		Set Player Variable(Event Player, PahlawanLampiranSendiri, Null);
		Set Player Variable(Event Player, PahlawanLampiranTarget, Null);
			Abort;
		End;
		If(Or(Hero Of(Event Player) != Event Player.PahlawanLampiranSendiri, Hero Of(Event Player.TargetLampiranTeleportasi) != Event Player.PahlawanLampiranTarget));
		Detach Players(Event Player);
		Set Player Variable(Event Player, LampiranTeleportasiAktif, False);
		Set Player Variable(Event Player, TargetLampiranTeleportasi, Null);
		Set Player Variable(Event Player, PahlawanLampiranSendiri, Null);
		Set Player Variable(Event Player, PahlawanLampiranTarget, Null);
			Abort;
		End;
		If(And(Player Variable(Event Player.TargetLampiranTeleportasi, Manusia) == True, Player Variable(Event Player.TargetLampiranTeleportasi, PrivasiInspeksiAktif) == True));
		Detach Players(Event Player);
		Set Player Variable(Event Player, LampiranTeleportasiAktif, False);
		Set Player Variable(Event Player, TargetLampiranTeleportasi, Null);
		Set Player Variable(Event Player, PahlawanLampiranSendiri, Null);
		Set Player Variable(Event Player, PahlawanLampiranTarget, Null);
		End;
	}
}

regola("19g - Teleportasi Jongkok: Tutup saat Jongkok dilepas")
{
	evento
	{
		Ongoing - Each Player;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Player.TeleportasiJongkokAktif == True;
		Or(Or(Or(Is Button Held(Event Player, Button(Crouch)) == False, Event Player.MenuTerbuka == True), Or(Has Spawned(Event Player) == False, Is Alive(Event Player) == False)), Event Player.PrivasiNasibAktif == True) == True;
	}

	azioni
	{
		If(Event Player.HudMenu != Null);
			Destroy HUD Text(Event Player.HudMenu);
		End;
		If(Index Of Array Value(Globale.PemainManusia, Event Player) >= 0);
			Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Event Player)] = 0;
		End;
		Event Player.HudMenu = Null;
		Event Player.TeleportasiJongkokAktif = False;
		Event Player.PerintahTeleportasi = 0;
		Event Player.DaftarTargetTeleportasi = Empty Array;
		Event Player.CalonTargetTeleportasi = Null;
		If(Event Player.TeksTeleportasi != Null);
			Destroy In-World Text(Event Player.TeksTeleportasi);
		End;
		Event Player.TeksTeleportasi = Null;
		Event Player.TargetTeleportasiTeks = Null;
		Event Player.JenisTeleportasiTerkunci = -1;
		Event Player.TargetTeleportasiTerkunci = Null;
		If(Event Player.PelatNamaDinonaktifkan == True);
			Enable Nameplates(All Players(All Teams), Event Player);
			Event Player.PelatNamaDinonaktifkan = False;
		End;
		If(Event Player.TeksDunia != Null);
			Destroy In-World Text(Event Player.TeksDunia);
		End;
		If(Index Of Array Value(Globale.PemainManusia, Event Player) >= 0);
			Globale.TeksDuniaPemain[Index Of Array Value(Globale.PemainManusia, Event Player)] = 0;
		End;
		Event Player.TeksDunia = Null;
		Event Player.TargetInspeksi = Null;
		Event Player.DaftarTargetInspeksi = Empty Array;
		Event Player.InspeksiAktif = False;
		Allow Button(Event Player, Button(Primary Fire));
		Allow Button(Event Player, Button(Secondary Fire));
		Allow Button(Event Player, Button(Interact));
	}
}

regola("89a - Subrutin: Proses status cepat pemain")
{
	evento
	{
		Subroutine;
		ProsesCepatPemain;
	}

	azioni
	{
		If(And(Array Contains(Globale.PemainManusia, Globale.PemainAktif) == True, And(Or(Globale.PemainAktif.NamaTampilan == Null, Globale.PemainAktif.NamaTampilan == Custom String("")), Custom String("{0}", Globale.PemainAktif) != Custom String(""))));
			Globale.PemainAktif.NamaTampilan = Evaluate Once(Custom String("{0}", Globale.PemainAktif));
		End;
		If(And(Is Dummy Bot(Globale.PemainAktif) == False, And(Globale.PemainAktif.BotOtomatis == False, And(Array Contains(Globale.PemainManusia, Globale.PemainAktif) == True, Or(Globale.PemainAktif.Manusia == False, Globale.PemainAktif.PernahDisiapkan == False)))));
			If(And(Or(Globale.PemainAktif.NamaTampilan == Null, Globale.PemainAktif.NamaTampilan == Custom String("")), Custom String("{0}", Globale.PemainAktif) != Custom String("")));
				Globale.PemainAktif.NamaTampilan = Evaluate Once(Custom String("{0}", Globale.PemainAktif));
			End;
			If(Custom String("{0}", Globale.PemainAktif) == Custom String("งูแท้"));
				Globale.PemainAktif.MusikKhusus = Custom String("Caladan Brood");
				If(Globale.PemainAktif.PernahDisiapkan == False);
					Globale.PemainAktif.IndeksWarna = 1;
					Globale.PemainAktif.KursorWarna = 1;
					Globale.PemainAktif.WarnaNama = Globale.DaftarWarna[1];
					Globale.PemainAktif.WarnaMenu = Globale.DaftarWarnaRGB[1];
					Globale.PemainAktif.IndeksIkon = 23;
					Globale.PemainAktif.KursorIkon = 23;
				End;
			End;
			Globale.PemainAktif.Manusia = True;
			Globale.PemainAktif.SudahDiperiksa = True;
			Globale.PemainAktif.SudahSiap = True;
			Globale.PemainAktif.PernahDisiapkan = True;
		End;
		If(And(Is Dummy Bot(Globale.PemainAktif) == False, And(Globale.PemainAktif.BotOtomatis == False, And(Array Contains(Globale.PemainManusia, Globale.PemainAktif) == True, Globale.PemainAktif.TimTerakhir != Team Of(Globale.PemainAktif)))));
			"Perubahan tim pemain terdaftar kini menjalankan reset penuh agar slot roster, HUD, dan status lama benar-benar dilepas."
			Call Subroutine(TenangkanPemain);
			Call Subroutine(BersihkanPemain);
			Globale.PemainAktif.SegarkanRosterTertunda = False;
			Globale.PemainAktif.HudPemainDibuat = False;
			Globale.PemainAktif.HudKiri = Null;
			Globale.PemainAktif.HudKanan = Null;
			Globale.PemainAktif.HudMenu = Null;
			Globale.PemainAktif.InputMenuDikunci = False;
			Globale.PemainAktif.SudahDiperiksa = False;
			Globale.PemainAktif.BotOtomatis = False;
			Globale.PemainAktif.PindahTimDiproses = False;
			Globale.PemainAktif.SiklusPemainAktif = False;
			Globale.PemainAktif.TimTerakhir = Team Of(Globale.PemainAktif);
			Globale.PemainAktif.TimSiklusTarget = Team Of(Globale.PemainAktif);
			Globale.PemainAktif.WaktuSiklusTim = Total Time Elapsed + 0.250;
			If(Globale.PemainSiklusGlobal == Globale.PemainAktif);
				Globale.PemainSiklusGlobal = Null;
				Globale.WaktuSiklusGlobal = Total Time Elapsed + 0.250;
			End;
		End;
		If(And(Is Dummy Bot(Globale.PemainAktif) == False, And(Globale.PemainAktif.BotOtomatis == False, And(Array Contains(Globale.PemainManusia, Globale.PemainAktif) == False, Globale.PemainAktif.PindahTimDiproses == False))));
			Globale.PemainAktif.PindahTimDiproses = True;
			Globale.PemainAktif.SiklusPemainAktif = False;
			Globale.PemainAktif.SudahSiap = False;
			Globale.PemainAktif.Manusia = False;
			Globale.PemainAktif.TimSiklusTarget = Team Of(Globale.PemainAktif);
			Globale.PemainAktif.WaktuSiklusTim = Total Time Elapsed + 0.250;
		End;
		If(And(Globale.PemainSiklusGlobal == Null, And(Globale.PemainAktif.PindahTimDiproses == True, And(Globale.PemainAktif.BotOtomatis == False, And(Array Contains(Globale.PemainManusia, Globale.PemainAktif) == False, And(Entity Exists(Globale.PemainAktif) == True, And(Has Spawned(Globale.PemainAktif) == True, Total Time Elapsed >= Globale.WaktuSiklusGlobal)))))));
			Globale.PemainSiklusGlobal = Globale.PemainAktif;
		End;
		If(And(Globale.PemainAktif.Manusia == True, Or(Globale.PemainAktif.KematianBalasDendam == True, And(Globale.PemainAktif.KartuNasibAktif == True, And(Globale.PemainAktif.EfekNasib == 3, And(Globale.PemainAktif.PutaranKartuNasib == 0, Globale.PemainAktif.WaktuPaksaBerakhir > 0))))));
			If(And(Globale.PemainAktif.KematianBalasDendam == True, Or(Globale.PemainAktif.PenagihBalasDendam == Null, Or(Entity Exists(Globale.PemainAktif.PenagihBalasDendam) == False, Player Variable(Globale.PemainAktif.PenagihBalasDendam, Manusia) == False))));
				Globale.PemainAktif.KematianBalasDendam = False;
				Globale.PemainAktif.PenagihBalasDendam = Null;
				Globale.PemainAktif.WaktuPaksaBerikut = 0;
				Globale.PemainAktif.WaktuPaksaBerakhir = 0;
			Else If(And(Globale.PemainAktif.WaktuPaksaBerakhir > 0, Total Time Elapsed >= Globale.PemainAktif.WaktuPaksaBerakhir));
				If(Globale.PemainAktif.KematianBalasDendam == True);
					Small Message(Globale.PemainAktif.PenagihBalasDendam, Player Variable(Globale.PemainAktif.PenagihBalasDendam, IndeksBahasa) == 0 ? Custom String("Revenge could not complete. No debt was consumed.") : Player Variable(Globale.PemainAktif.PenagihBalasDendam, IndeksBahasa) == 1 ? Custom String("Balas dendam tidak dapat diselesaikan. Tidak ada utang yang dipakai.") : Custom String("การล้างแค้นไม่สำเร็จ ไม่มีการใช้หนี้"));
					Set Player Variable(Globale.PemainAktif.PenagihBalasDendam, TargetBalasDendamTerkunci, Null);
					Globale.PemainAktif.KematianBalasDendam = False;
					Globale.PemainAktif.PenagihBalasDendam = Null;
				Else;
					Call Subroutine(PulihkanNasibAktif);
					Globale.PemainAktif.MenuNasibHarusDibuka = Globale.PemainAktif.MenuTerbuka == False;
					Small Message(Globale.PemainAktif, Globale.PemainAktif.IndeksBahasa == 0 ? Custom String("SKULL could not complete. The menu was restored.") : Globale.PemainAktif.IndeksBahasa == 1 ? Custom String("TENGKORAK tidak dapat diselesaikan. Menu dipulihkan.") : Custom String("กะโหลกทำงานไม่สำเร็จ คืนค่าเมนูแล้ว"));
				End;
				Globale.PemainAktif.WaktuPaksaBerikut = 0;
				Globale.PemainAktif.WaktuPaksaBerakhir = 0;
			Else If(And(Has Spawned(Globale.PemainAktif) == True, And(Is Alive(Globale.PemainAktif) == True, Total Time Elapsed >= Globale.PemainAktif.WaktuPaksaBerikut)));
				Globale.PemainAktif.WaktuPaksaBerikut = Total Time Elapsed + 0.250;
				Clear Status(Globale.PemainAktif, Unkillable);
				Set Damage Received(Globale.PemainAktif, 100);
				Kill(Globale.PemainAktif, Globale.PemainAktif.KematianBalasDendam == True ? Globale.PemainAktif.PenagihBalasDendam : Null);
			End;
		End;
		If(And(Globale.PemainAktif.Manusia == True, And(Globale.PemainAktif.KebalAktif == True, And(Globale.PemainAktif.KematianBalasDendam == False, And(And(And(Globale.PemainAktif.KartuNasibAktif == True, Globale.PemainAktif.PutaranKartuNasib == 0), Or(And(Globale.PemainAktif.EfekNasib == 3, Globale.PemainAktif.WaktuPaksaBerakhir > 0), And(Globale.PemainAktif.EfekNasib == 5, Globale.PemainAktif.EfekNasibBerakhir > Total Time Elapsed))) == False, And(Has Spawned(Globale.PemainAktif) == True, Is Alive(Globale.PemainAktif) == True))))));
			If(And(Globale.PemainAktif.ModeKebal == 1, Is In Spawn Room(Globale.PemainAktif) == False));
				If(Has Status(Globale.PemainAktif, Unkillable) == False);
					Set Status(Globale.PemainAktif, Null, Unkillable, 9999);
				End;
				Set Damage Received(Globale.PemainAktif, 100);
				Set Knockback Received(Globale.PemainAktif, 100);
				Enable Movement Collision With Players(Globale.PemainAktif);
				If(Health(Globale.PemainAktif) >= Max Health(Globale.PemainAktif));
					Set Player Health(Globale.PemainAktif, 1);
				End;
			Else If(Globale.PemainAktif.ModeKebal == 2);
				If(Has Status(Globale.PemainAktif, Unkillable) == False);
					Set Status(Globale.PemainAktif, Null, Unkillable, 9999);
				End;
				Set Damage Received(Globale.PemainAktif, 0);
				Set Knockback Received(Globale.PemainAktif, 0);
				Disable Movement Collision With Players(Globale.PemainAktif);
				If(Health(Globale.PemainAktif) < Max Health(Globale.PemainAktif));
					Set Player Health(Globale.PemainAktif, Max Health(Globale.PemainAktif));
				End;
			End;
			If(Or(Globale.PemainAktif.IkonKebal == Null, Entity Exists(Globale.PemainAktif.IkonKebal) == False));
				If(Globale.PemainAktif.ModeKebal == 1);
					Create Icon(All Players(All Teams), Evaluate Once(Globale.PemainAktif), Warning, Visible To and Position, Custom Color(255, 80, 80, 255), True);
				Else;
					Create Icon(All Players(All Teams), Evaluate Once(Globale.PemainAktif), Halo, Visible To and Position, Globale.RGB, True);
				End;
				Globale.PemainAktif.IkonKebal = Last Created Entity;
			End;
		End;
	}
}

regola("89a2 - Subrutin: Mesin terbang 3D per pemain 20 Hz")
{
	evento
	{
		Subroutine;
		ProsesTerbangPemain;
	}

	azioni
	{
		If(And(Globale.PemainAktif.Manusia == True, And(Globale.PemainAktif.BotOtomatis == False, And(Is Dummy Bot(Globale.PemainAktif) == False, And(Has Spawned(Globale.PemainAktif) == True, And(Is Alive(Globale.PemainAktif) == True, And(Globale.PemainAktif.ModeTerbangAktif == True, Globale.PemainAktif.FisikaHantuTerbangDiterapkan == True)))))));
			If(And(Globale.PemainAktif.EfekNasib == 2, Globale.PemainAktif.EfekNasibBerakhir > Total Time Elapsed));
				"Acceleration Coba Nasib tetap memiliki gerak; motor Fly tidak menimpa kecepatannya."
				Globale.PemainAktif.WaktuMulaiTerbangMaju = -1;
				Globale.PemainAktif.PersenTerbang = 100;
				Globale.PemainAktif.ArahTerbang = Vector(0, 0, 0);
				Globale.PemainAktif.DeltaTerbang = Vector(0, 0, 0);
			Else;
				"Gerak native dinonaktifkan; impuls 3D mengatur kecepatan dunia, termasuk naik dan turun."
				Set Move Speed(Globale.PemainAktif, 0);
				If(And(Z Component Of(Throttle Of(Globale.PemainAktif)) > 0.050, And(X Component Of(Throttle Of(Globale.PemainAktif)) >= -0.050, X Component Of(Throttle Of(Globale.PemainAktif)) <= 0.050)));
					If(Globale.PemainAktif.WaktuMulaiTerbangMaju < 0);
						Globale.PemainAktif.WaktuMulaiTerbangMaju = Total Time Elapsed;
					End;
					Globale.PemainAktif.PersenTerbang = Min(500, 100 + Max(0, Total Time Elapsed - Globale.PemainAktif.WaktuMulaiTerbangMaju) * 16);
				Else;
					Globale.PemainAktif.WaktuMulaiTerbangMaju = -1;
					Globale.PemainAktif.PersenTerbang = 100;
				End;
				"Throttle Z maju memakai pitch bidikan, sedangkan mundur/strafe tetap pada bidang horizontal."
				Globale.PemainAktif.ArahTerbang = Facing Direction Of(Globale.PemainAktif) * Max(0, Z Component Of(Throttle Of(Globale.PemainAktif))) + Direction From Angles(Horizontal Facing Angle Of(Globale.PemainAktif), 0) * Min(0, Z Component Of(Throttle Of(Globale.PemainAktif))) + Cross Product(Direction From Angles(Horizontal Facing Angle Of(Globale.PemainAktif), 0), Vector(0, 1, 0)) * X Component Of(Throttle Of(Globale.PemainAktif));
				If(Magnitude Of(Globale.PemainAktif.ArahTerbang) > 0.050);
					"100% Fly = 5.5 m/s, 500% = 27.5 m/s; diagonal dibatasi dan kekuatan analog tetap dipakai."
					Globale.PemainAktif.DeltaTerbang = Normalize(Globale.PemainAktif.ArahTerbang) * 5.500 * Globale.PemainAktif.PersenTerbang / 100 * Min(1, Magnitude Of(Throttle Of(Globale.PemainAktif))) - Velocity Of(Globale.PemainAktif);
				Else;
					Globale.PemainAktif.DeltaTerbang = Velocity Of(Globale.PemainAktif) * -1;
				End;
				If(Magnitude Of(Globale.PemainAktif.DeltaTerbang) > 0.010);
					Apply Impulse(Globale.PemainAktif, Globale.PemainAktif.DeltaTerbang, Magnitude Of(Globale.PemainAktif.DeltaTerbang), To World, Incorporate Contrary Motion);
				End;
			End;
		End;
	}
}

regola("89b - Subrutin: Proses siklus pemain 10 Hz")
{
	evento
	{
		Subroutine;
		ProsesSiklusPemain;
	}

	azioni
	{
		"Target dummy dan bidikan berat dihitung pada siklus 10 Hz, bukan di evaluasi per-frame."
		If(And(Is Dummy Bot(Globale.PemainAktif) == True, And(Has Spawned(Globale.PemainAktif) == True, Is Alive(Globale.PemainAktif) == True)));
			Set Player Variable(Globale.PemainAktif, DaftarTargetInspeksi, Filtered Array(Globale.PemainManusia, And(Entity Exists(Current Array Element), And(Player Variable(Current Array Element, Manusia) == True, And(Player Variable(Current Array Element, IzinkanDummyMengikuti) == True, And(Has Spawned(Current Array Element), And(Is Alive(Current Array Element), Team Of(Current Array Element) == Opposite Team Of(Team Of(Globale.PemainAktif)))))))));
			If(Count Of(Globale.PemainAktif.DaftarTargetInspeksi) > 0);
				Set Player Variable(Globale.PemainAktif, TargetDummyIkuti, First Of(Sorted Array(Globale.PemainAktif.DaftarTargetInspeksi, Distance Between(Globale.PemainAktif, Current Array Element))));
			Else;
				Set Player Variable(Globale.PemainAktif, TargetDummyIkuti, Null);
			End;
		End;
		If(And(Globale.PemainAktif.Manusia == True, And(Globale.PemainAktif.BotOtomatis == False, And(Is Dummy Bot(Globale.PemainAktif) == False, Or(Has Spawned(Globale.PemainAktif) == False, Is Alive(Globale.PemainAktif) == False)))));
			Globale.PemainAktif.WaktuMulaiTerbangMaju = -1;
			If(Or(Globale.PemainAktif.EfekNasib != 2, Globale.PemainAktif.EfekNasibBerakhir <= Total Time Elapsed));
				Set Move Speed(Globale.PemainAktif, 100);
			End;
			If(Globale.PemainAktif.FisikaHantuTerbangDiterapkan == True);
				"Kematian atau transisi spawn menormalkan mesin, tetapi kedua toggle tetap tersimpan untuk respawn."
				Stop Transforming Throttle(Globale.PemainAktif);
				Set Gravity(Globale.PemainAktif, 100);
				Enable Movement Collision With Environment(Globale.PemainAktif);
				Globale.PemainAktif.FisikaHantuTerbangDiterapkan = False;
			End;
		End;
		If(And(Globale.PemainAktif.Manusia == True, And(Globale.PemainAktif.BotOtomatis == False, And(Is Dummy Bot(Globale.PemainAktif) == False, And(Has Spawned(Globale.PemainAktif) == True, Is Alive(Globale.PemainAktif) == True)))));
			If(Globale.PemainAktif.FisikaHantuTerbangDiterapkan == False);
				Globale.PemainAktif.WaktuMulaiTerbangMaju = -1;
				If(Or(Globale.PemainAktif.EfekNasib != 2, Globale.PemainAktif.EfekNasibBerakhir <= Total Time Elapsed));
					Set Move Speed(Globale.PemainAktif, Globale.PemainAktif.ModeTerbangAktif == True ? 0 : 100);
				End;
				Stop Transforming Throttle(Globale.PemainAktif);
				Set Gravity(Globale.PemainAktif, 100);
				Enable Movement Collision With Environment(Globale.PemainAktif);
				If(Globale.PemainAktif.ModeHantuAktif == True);
					Disable Movement Collision With Environment(Globale.PemainAktif, False);
				End;
				If(Globale.PemainAktif.ModeTerbangAktif == True);
					Set Gravity(Globale.PemainAktif, 0);
				End;
				Globale.PemainAktif.FisikaHantuTerbangDiterapkan = True;
			End;
		End;
		If(And(Globale.PemainAktif.Manusia == True, And(Has Spawned(Globale.PemainAktif) == True, Is Alive(Globale.PemainAktif) == True)));
			If(And(Globale.PemainAktif.MenuTerbuka == False, And(Globale.PemainAktif.PrivasiNasibAktif == False, And(Globale.PemainAktif.TeleportasiJongkokAktif == False, And(Globale.PemainAktif.TeleportasiJongkokDiaktifkan == False, And(Globale.PemainAktif.ModeKamera != 2, Is Button Held(Globale.PemainAktif, Button(Crouch)) == True))))));
				Call Subroutine(SegarkanTargetPublikAktif);
				Set Player Variable(Globale.PemainAktif, CalonTargetInspeksi, Count Of(Globale.PemainAktif.DaftarTargetInspeksi) == 0 ? Null : First Of(Sorted Array(Globale.PemainAktif.DaftarTargetInspeksi, Angle Between Vectors(Facing Direction Of(Globale.PemainAktif), Direction Towards(Eye Position(Globale.PemainAktif), Eye Position(Current Array Element))))));
			Else;
				Set Player Variable(Globale.PemainAktif, CalonTargetInspeksi, Null);
			End;
			If(And(Globale.PemainAktif.TeleportasiJongkokAktif == True, And(Or(Globale.PemainAktif.KursorTeleportasi == 2, Globale.PemainAktif.KursorTeleportasi == 3), Is Button Held(Globale.PemainAktif, Button(Crouch)) == True)));
				Call Subroutine(SegarkanTargetPublikAktif);
				Set Player Variable(Globale.PemainAktif, DaftarTargetTeleportasi, Globale.PemainAktif.DaftarTargetInspeksi);
				Set Player Variable(Globale.PemainAktif, CalonTargetTeleportasi, Count Of(Globale.PemainAktif.DaftarTargetTeleportasi) == 0 ? Null : First Of(Sorted Array(Globale.PemainAktif.DaftarTargetTeleportasi, Angle Between Vectors(Facing Direction Of(Globale.PemainAktif), Direction Towards(Eye Position(Globale.PemainAktif), Eye Position(Current Array Element))))));
			End;
		End;
		If(And(Globale.PemainAktif.PindahTimDiproses == True, Or(And(Globale.PemainAktif.Manusia == True, And(Has Spawned(Globale.PemainAktif) == True, Globale.PemainAktif.HudPemainDibuat == True)), And(Globale.PemainAktif.BotOtomatis == True, And(Globale.PemainAktif.SudahDiperiksa == True, And(Has Spawned(Globale.PemainAktif) == True, And(Is Alive(Globale.PemainAktif) == True, Globale.PemainAktif.KunciBotAktif == True)))))));
			"Pendaftaran manusia dilepas setelah HUD stabil; bot otomatis dilepas hanya setelah klasifikasi dan penguncian selesai."
			Globale.PemainAktif.PindahTimDiproses = False;
			Globale.PemainAktif.SiklusPemainAktif = False;
			Globale.PemainAktif.WaktuSiklusTim = 0;
			If(Globale.PemainSiklusGlobal == Globale.PemainAktif);
				Globale.PemainSiklusGlobal = Null;
				Globale.WaktuSiklusGlobal = Total Time Elapsed + 0.250;
			End;
		End;
		If(And(Globale.PemainAktif.Manusia == True, And(Has Spawned(Globale.PemainAktif) == True, Hero Of(Globale.PemainAktif) != Globale.PemainAktif.PahlawanTerakhir)));
			"Perubahan pahlawan manusia dibersihkan oleh scheduler global tanpa membuat aturan Each Player baru."
			Globale.PemainAktif.PahlawanTerakhir = Hero Of(Globale.PemainAktif);
			Globale.PemainAktif.FisikaHantuTerbangDiterapkan = False;
			Globale.PemainAktif.WaktuMulaiTerbangMaju = -1;
			If(Or(Globale.PemainAktif.EfekNasib != 2, Globale.PemainAktif.EfekNasibBerakhir <= Total Time Elapsed));
				Set Move Speed(Globale.PemainAktif, 100);
			End;
			If(Or(Globale.PemainAktif.KartuNasibAktif == True, Or(Globale.PemainAktif.PutaranKartuNasib > 0, Globale.PemainAktif.EfekNasib != 0)));
				Call Subroutine(PulihkanNasibAktif);
				Globale.PemainAktif.MenuNasibHarusDibuka = Globale.PemainAktif.MenuTerbuka == False;
			End;
		End;
		If(And(Globale.Siap == True, And(Or(Is Dummy Bot(Globale.PemainAktif), Globale.PemainAktif.BotOtomatis) == True, And(Globale.PemainAktif.KunciBotAktif == True, Or(Has Spawned(Globale.PemainAktif) == False, Is Alive(Globale.PemainAktif) == False)))));
			Globale.PemainAktif.KunciBotAktif = False;
		End;
		If(Globale.PemainAktif.ModeKamera == 2);
			If(Or(Or(Or(Globale.PemainAktif.TargetKamera == Null, Entity Exists(Globale.PemainAktif.TargetKamera) == False), Or(Has Spawned(Globale.PemainAktif.TargetKamera) == False, Is Alive(Globale.PemainAktif.TargetKamera) == False)), And(Globale.PemainAktif.TargetKamera.Manusia == True, Globale.PemainAktif.TargetKamera.PrivasiInspeksiAktif == True)));
				Stop Camera(Globale.PemainAktif);
				Set Player Variable(Globale.PemainAktif, ModeKamera, 0);
				Set Player Variable(Globale.PemainAktif, TargetKamera, Null);
				Play Effect(All Players(All Teams), Ring Explosion, Globale.RGB, Position Of(Globale.PemainAktif) + Vector(0, 1, 0), 3);
				Small Message(Globale.PemainAktif, Globale.PemainAktif.IndeksBahasa == 0 ? Custom String("Camera target unavailable or private.") : Globale.PemainAktif.IndeksBahasa == 1 ? Custom String("Target kamera tidak tersedia atau privat. Kembali normal.") : Custom String("เป้าหมายกล้องไม่พร้อมใช้งานหรือเป็นส่วนตัว กลับมุมมองปกติแล้ว"));
			End;
		End;
		If(And(Globale.PemainAktif.InspeksiAktif == True, Or(Or(Or(Or(Or(Or(Is Button Held(Globale.PemainAktif, Button(Crouch)) == False, Globale.PemainAktif.MenuTerbuka == True), Has Spawned(Globale.PemainAktif) == False), Is Alive(Globale.PemainAktif) == False), Globale.PemainAktif.ModeKamera == 2), And(Globale.PemainAktif.TeleportasiJongkokAktif == True, And(Globale.PemainAktif.KursorTeleportasi != 2, Globale.PemainAktif.KursorTeleportasi != 3))), Globale.PemainAktif.PrivasiNasibAktif == True)));
			If(Globale.PemainAktif.PelatNamaDinonaktifkan == True);
				Enable Nameplates(All Players(All Teams), Globale.PemainAktif);
				Globale.PemainAktif.PelatNamaDinonaktifkan = False;
			End;
			If(Globale.PemainAktif.TeksDunia != Null);
				Destroy In-World Text(Globale.PemainAktif.TeksDunia);
			End;
			If(Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif) >= 0);
				Globale.TeksDuniaPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif)] = 0;
			End;
			Globale.PemainAktif.TeksDunia = Null;
			Globale.PemainAktif.TargetInspeksi = Null;
			Globale.PemainAktif.DaftarTargetInspeksi = Empty Array;
			Globale.PemainAktif.InspeksiAktif = False;
		End;
	}
}

regola("89c - Subrutin: Proses simpanan pemain 1 Hz")
{
	evento
	{
		Subroutine;
		ProsesCachePemain;
	}

	azioni
	{
		If(And(Globale.PemainAktif.Manusia == True, Entity Exists(Globale.PemainAktif)));
			If(And(Globale.PemainAktif.MenuTerbuka == True, Globale.PemainAktif.HalamanMenu == 1));
				If(And(Globale.PemainAktif.KursorKamera >= 2, Globale.PemainAktif.KursorKamera - 2 < Count Of(Globale.PemainAktif.DaftarTargetKamera)));
					Set Player Variable(Globale.PemainAktif, CalonTargetKamera, Globale.PemainAktif.DaftarTargetKamera[Globale.PemainAktif.KursorKamera - 2]);
				Else;
					Set Player Variable(Globale.PemainAktif, CalonTargetKamera, Null);
				End;
				Call Subroutine(SegarkanTargetPublikAktif);
				Set Player Variable(Globale.PemainAktif, DaftarTargetKamera, Globale.PemainAktif.DaftarTargetInspeksi);
				If(And(Globale.PemainAktif.CalonTargetKamera != Null, Array Contains(Globale.PemainAktif.DaftarTargetKamera, Globale.PemainAktif.CalonTargetKamera)));
					Set Player Variable(Globale.PemainAktif, KursorKamera, Index Of Array Value(Globale.PemainAktif.DaftarTargetKamera, Globale.PemainAktif.CalonTargetKamera) + 2);
				Else If(Globale.PemainAktif.KursorKamera >= Count Of(Globale.PemainAktif.DaftarTargetKamera) + 2);
					Set Player Variable(Globale.PemainAktif, KursorKamera, 0);
				End;
			End;
			If(And(Globale.PemainAktif.MenuTerbuka == True, Globale.PemainAktif.HalamanMenu == 4));
				If(Globale.PemainAktif.KursorBalasDendam < Count Of(Globale.PemainAktif.DaftarTargetBalasDendam));
					Set Player Variable(Globale.PemainAktif, TargetBalasDendamDipilih, Globale.PemainAktif.DaftarTargetBalasDendam[Globale.PemainAktif.KursorBalasDendam]);
				Else;
					Set Player Variable(Globale.PemainAktif, TargetBalasDendamDipilih, Null);
				End;
				Set Player Variable(Globale.PemainAktif, DaftarTargetBalasDendam, Filtered Array(Globale.PemainManusia, Current Array Element != Globale.PemainAktif));
				If(Count Of(Globale.PemainAktif.DaftarTargetBalasDendam) == 0);
					Set Player Variable(Globale.PemainAktif, KursorBalasDendam, 0);
				Else If(And(Globale.PemainAktif.TargetBalasDendamDipilih != Null, Array Contains(Globale.PemainAktif.DaftarTargetBalasDendam, Globale.PemainAktif.TargetBalasDendamDipilih)));
					Set Player Variable(Globale.PemainAktif, KursorBalasDendam, Index Of Array Value(Globale.PemainAktif.DaftarTargetBalasDendam, Globale.PemainAktif.TargetBalasDendamDipilih));
				Else If(Globale.PemainAktif.KursorBalasDendam >= Count Of(Globale.PemainAktif.DaftarTargetBalasDendam));
					Set Player Variable(Globale.PemainAktif, KursorBalasDendam, 0);
				End;
			End;
		End;
	}
}

regola("89d - Subrutin: Proses mesin status Coba Nasib")
{
	evento
	{
		Subroutine;
		ProsesNasibPemain;
	}

	azioni
	{
		If(And(Globale.PemainAktif.Manusia == True, And(Globale.PemainAktif.KartuNasibAktif == True, And(Has Spawned(Globale.PemainAktif) == True, Is Alive(Globale.PemainAktif) == True))));
			If(And(Globale.PemainAktif.PutaranKartuNasib > 0, Total Time Elapsed >= Globale.PemainAktif.WaktuPutaranNasibBerikut));
				If(Globale.PemainAktif.IkonKartuNasib != Null);
					Destroy Icon(Globale.PemainAktif.IkonKartuNasib);
				End;
				Globale.PemainAktif.EfekNasib = Random Integer(1, 6);
				If(Globale.PemainAktif.EfekNasib == 1);
					Create Icon(Globale.PemainManusia, Update Every Frame(Eye Position(Evaluate Once(Globale.PemainAktif)) + Facing Direction Of(Evaluate Once(Globale.PemainAktif)) * 4), Eye, Visible To and Position, Custom Color(0, 234, 234, 255), True);
				Else If(Globale.PemainAktif.EfekNasib == 2);
					Create Icon(Globale.PemainManusia, Update Every Frame(Eye Position(Evaluate Once(Globale.PemainAktif)) + Facing Direction Of(Evaluate Once(Globale.PemainAktif)) * 4), Dizzy, Visible To and Position, Custom Color(100, 50, 255, 255), True);
				Else If(Globale.PemainAktif.EfekNasib == 3);
					Create Icon(Globale.PemainManusia, Update Every Frame(Eye Position(Evaluate Once(Globale.PemainAktif)) + Facing Direction Of(Evaluate Once(Globale.PemainAktif)) * 4), Skull, Visible To and Position, Custom Color(255, 70, 70, 255), True);
				Else If(Globale.PemainAktif.EfekNasib == 4);
					Create Icon(Globale.PemainManusia, Update Every Frame(Eye Position(Evaluate Once(Globale.PemainAktif)) + Facing Direction Of(Evaluate Once(Globale.PemainAktif)) * 4), Heart, Visible To and Position, Custom Color(70, 255, 110, 255), True);
				Else If(Globale.PemainAktif.EfekNasib == 5);
					Create Icon(Globale.PemainManusia, Update Every Frame(Eye Position(Evaluate Once(Globale.PemainAktif)) + Facing Direction Of(Evaluate Once(Globale.PemainAktif)) * 4), Fire, Visible To and Position, Custom Color(236, 153, 0, 255), True);
				Else;
					Create Icon(Globale.PemainManusia, Update Every Frame(Eye Position(Evaluate Once(Globale.PemainAktif)) + Facing Direction Of(Evaluate Once(Globale.PemainAktif)) * 4), Poison 2, Visible To and Position, Custom Color(170, 80, 255, 255), True);
				End;
				Globale.PemainAktif.IkonKartuNasib = Last Created Entity;
				Modify Player Variable(Globale.PemainAktif, PutaranKartuNasib, Subtract, 1);
				Globale.PemainAktif.WaktuPutaranNasibBerikut = Total Time Elapsed + Globale.PemainAktif.JedaKartuNasib;
				Modify Player Variable(Globale.PemainAktif, JedaKartuNasib, Add, 0.045);
			End;
			If(And(Globale.PemainAktif.PutaranKartuNasib == 0, And(Globale.PemainAktif.WaktuIkonNasibBerakhir == 0, And(Globale.PemainAktif.WaktuPutaranNasibBerikut > 0, Total Time Elapsed >= Globale.PemainAktif.WaktuPutaranNasibBerikut))));
				"Hasil akhir diterapkan satu kali setelah ikon terakhir selesai, tanpa Wait per pemain."
				Globale.PemainAktif.EfekNasibBerakhir = 0;
				Globale.PemainAktif.WaktuBakarNasibBerikut = 0;
				Globale.PemainAktif.MenuNasibHarusDibuka = False;
				If(Or(Or(Globale.PemainAktif.EfekNasib == 1, Globale.PemainAktif.EfekNasib == 2), Or(Globale.PemainAktif.EfekNasib == 5, Globale.PemainAktif.EfekNasib == 6)));
					If(Globale.PemainAktif.HudMenu != Null);
						Destroy HUD Text(Globale.PemainAktif.HudMenu);
					End;
					If(Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif) >= 0);
						Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif)] = 0;
					End;
					Globale.PemainAktif.HudMenu = Null;
					Globale.PemainAktif.MenuTerbuka = False;
					Globale.PemainAktif.InputMenuDikunci = False;
					Globale.PemainAktif.PerintahMenu = 0;
					Globale.PemainAktif.HalamanMenu = -1;
					Allow Button(Globale.PemainAktif, Button(Primary Fire));
					Allow Button(Globale.PemainAktif, Button(Secondary Fire));
					Allow Button(Globale.PemainAktif, Button(Interact));
					Allow Button(Globale.PemainAktif, Button(Reload));
					Allow Button(Globale.PemainAktif, Button(Ability 1));
					Allow Button(Globale.PemainAktif, Button(Ability 2));
					Allow Button(Globale.PemainAktif, Button(Ultimate));
				End;
				If(Globale.PemainAktif.EfekNasib == 1);
					Globale.PemainAktif.PrivasiNasibAktif = True;
					Globale.PemainAktif.EfekNasibBerakhir = Total Time Elapsed + 15;
					Small Message(Globale.PemainAktif, Globale.PemainAktif.IndeksBahasa == 0 ? Custom String("TRY YOUR LUCK: ALL PLAYER / BOT NAMES — 15s") : Globale.PemainAktif.IndeksBahasa == 1 ? Custom String("COBA NASIB: SEMUA NAMA PLAYER / BOT — 15dtk") : Custom String("เสี่ยงโชค: ชื่อผู้เล่นทั้งหมด / บอต — 15 วินาที"));
				Else If(Globale.PemainAktif.EfekNasib == 2);
					Set Move Speed(Globale.PemainAktif, 1000);
					Start Accelerating(Globale.PemainAktif, Facing Direction Of(Evaluate Once(Globale.PemainAktif)), 50, 25, To World, Direction Rate and Max Speed);
					Globale.PemainAktif.EfekNasibBerakhir = Total Time Elapsed + 10;
					Small Message(Globale.PemainAktif, Globale.PemainAktif.IndeksBahasa == 0 ? Globale.PemainAktif.ModeTerbangAktif == True ? Custom String("TRY YOUR LUCK: FLY SPEED BOOST — 10s") : Custom String("TRY YOUR LUCK: AIM-STEERED ACCELERATION — 10s") : Globale.PemainAktif.IndeksBahasa == 1 ? Globale.PemainAktif.ModeTerbangAktif == True ? Custom String("COBA NASIB: BOOST KECEPATAN TERBANG — 10dtk") : Custom String("COBA NASIB: AKSELERASI MENGIKUTI BIDIKAN — 10dtk") : Globale.PemainAktif.ModeTerbangAktif == True ? Custom String("เสี่ยงโชค: เพิ่มความเร็วบิน — 10 วินาที") : Custom String("เสี่ยงโชค: เร่งความเร็วตามทิศเล็ง — 10 วินาที"));
				Else If(Globale.PemainAktif.EfekNasib == 3);
					Small Message(Globale.PemainAktif, Globale.PemainAktif.IndeksBahasa == 0 ? Custom String("TRY YOUR LUCK: SKULL") : Globale.PemainAktif.IndeksBahasa == 1 ? Custom String("COBA NASIB: TENGKORAK") : Custom String("เสี่ยงโชค: กะโหลก"));
					Globale.PemainAktif.WaktuPaksaBerikut = Total Time Elapsed;
					Globale.PemainAktif.WaktuPaksaBerakhir = Total Time Elapsed + 5;
				Else If(Globale.PemainAktif.EfekNasib == 4);
					Set Player Health(All Living Players(Team Of(Globale.PemainAktif)), 9999);
					Small Message(Globale.PemainAktif, Globale.PemainAktif.IndeksBahasa == 0 ? Custom String("TRY YOUR LUCK: HEART — TEAM FULL HEAL") : Globale.PemainAktif.IndeksBahasa == 1 ? Custom String("COBA NASIB: HATI — SEMBUH PENUH SATU TIM") : Custom String("เสี่ยงโชค: หัวใจ — ฮีลเต็มทีม"));
					Globale.PemainAktif.EfekNasib = 0;
					Globale.PemainAktif.KartuNasibAktif = False;
				Else If(Globale.PemainAktif.EfekNasib == 5);
					Set Status(Globale.PemainAktif, Null, Burning, 10);
					Clear Status(Globale.PemainAktif, Unkillable);
					Set Damage Received(Globale.PemainAktif, 100);
					Globale.PemainAktif.EfekNasibBerakhir = Total Time Elapsed + 10;
					Globale.PemainAktif.WaktuBakarNasibBerikut = Total Time Elapsed;
					Small Message(Globale.PemainAktif, Globale.PemainAktif.IndeksBahasa == 0 ? Custom String("TRY YOUR LUCK: BURNING — 5% MAX HP / SEC — 10s") : Globale.PemainAktif.IndeksBahasa == 1 ? Custom String("COBA NASIB: TERBAKAR — 5% HP MAKS / DETIK — 10dtk") : Custom String("เสี่ยงโชค: ไฟไหม้ — 5% HP สูงสุด / วินาที — 10 วินาที"));
				Else;
					Set Status(Globale.PemainAktif, Null, Hacked, 5);
					Globale.PemainAktif.EfekNasibBerakhir = Total Time Elapsed + 5;
					Small Message(Globale.PemainAktif, Globale.PemainAktif.IndeksBahasa == 0 ? Custom String("TRY YOUR LUCK: HACKED — 5s") : Globale.PemainAktif.IndeksBahasa == 1 ? Custom String("COBA NASIB: DIRETAS — 5dtk") : Custom String("เสี่ยงโชค: ถูกแฮ็ก — 5 วินาที"));
				End;
				Globale.PemainAktif.WaktuPutaranNasibBerikut = 0;
				Globale.PemainAktif.WaktuIkonNasibBerakhir = Total Time Elapsed + 1;
			End;
		End;
		If(Globale.PemainAktif.Manusia == True);
			If(Globale.PemainAktif.EfekNasib == 5);
				If(Globale.PemainAktif.EfekNasibBerakhir > Total Time Elapsed);
					If(Globale.PemainAktif.WaktuBakarNasibBerikut <= Total Time Elapsed);
						If(Has Spawned(Globale.PemainAktif) == True);
							If(Is Alive(Globale.PemainAktif) == True);
								Clear Status(Globale.PemainAktif, Unkillable);
								Set Damage Received(Globale.PemainAktif, 100);
								Damage(Globale.PemainAktif, Globale.PemainAktif, Max Health(Globale.PemainAktif) * 0.050);
								Globale.PemainAktif.WaktuBakarNasibBerikut = Total Time Elapsed + 1.000;
							End;
						End;
					End;
				End;
			End;
		End;
		If(Globale.PemainAktif.Manusia == True);
			If(Globale.PemainAktif.KartuNasibAktif == True);
				If(Globale.PemainAktif.PutaranKartuNasib == 0);
					If(Globale.PemainAktif.EfekNasibBerakhir > 0);
						If(Total Time Elapsed >= Globale.PemainAktif.EfekNasibBerakhir);
							Clear Status(Globale.PemainAktif, Burning);
							Clear Status(Globale.PemainAktif, Hacked);
							If(Globale.PemainAktif.EfekNasib == 2);
								Stop Accelerating(Globale.PemainAktif);
								Set Move Speed(Globale.PemainAktif, 100);
							End;
							If(Globale.PemainAktif.HudEfekNasib != Null);
								Destroy HUD Text(Globale.PemainAktif.HudEfekNasib);
							End;
							Globale.PemainAktif.HudEfekNasib = Null;
							Globale.PemainAktif.PrivasiNasibAktif = False;
							Globale.PemainAktif.EfekNasib = 0;
							Globale.PemainAktif.EfekNasibBerakhir = 0;
							Globale.PemainAktif.WaktuBakarNasibBerikut = 0;
							Globale.PemainAktif.KartuNasibAktif = False;
							Globale.PemainAktif.MenuNasibHarusDibuka = True;
						End;
					End;
				End;
			End;
		End;
		If(Globale.PemainAktif.WaktuIkonNasibBerakhir > 0);
			If(Total Time Elapsed >= Globale.PemainAktif.WaktuIkonNasibBerakhir);
				If(Globale.PemainAktif.IkonKartuNasib != Null);
					Destroy Icon(Globale.PemainAktif.IkonKartuNasib);
				End;
				Globale.PemainAktif.IkonKartuNasib = Null;
				Globale.PemainAktif.WaktuIkonNasibBerakhir = 0;
				If(Globale.PemainAktif.KartuNasibAktif == False);
					If(Globale.PemainAktif.MenuTerbuka == False);
						Globale.PemainAktif.MenuNasibHarusDibuka = True;
					End;
				End;
			End;
		End;
	}
}

regola("90 - Subrutin: Tutup menu dan pulihkan tombol")
{
	evento
	{
		Subroutine;
		TutupMenu;
	}

	azioni
	{
		If(Event Player.HudMenu != Null);
			Destroy HUD Text(Event Player.HudMenu);
		End;
		If(Index Of Array Value(Globale.PemainManusia, Event Player) >= 0);
			Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Event Player)] = 0;
		End;
		Event Player.HudMenu = Null;
		Event Player.MenuTerbuka = False;
		Event Player.PerintahMenu = 0;
		Event Player.HalamanMenu = -1;
		If(Is Button Held(Event Player, Button(Melee)));
			Event Player.SeranganDekatDipakai = True;
		Else;
			Allow Button(Event Player, Button(Melee));
			Event Player.SeranganDekatDipakai = False;
		End;
		Allow Button(Event Player, Button(Jump));
		Allow Button(Event Player, Button(Crouch));
		Allow Button(Event Player, Button(Primary Fire));
		Allow Button(Event Player, Button(Secondary Fire));
		Allow Button(Event Player, Button(Interact));
		Allow Button(Event Player, Button(Reload));
		Allow Button(Event Player, Button(Ability 1));
		Allow Button(Event Player, Button(Ability 2));
		Allow Button(Event Player, Button(Ultimate));
	}
}

regola("91 - Subrutin: Gambar satu HUD menu aktif")
{
	evento
	{
		Subroutine;
		GambarMenu;
	}

	azioni
	{
		If(Event Player.HudMenu != Null);
			Destroy HUD Text(Event Player.HudMenu);
			Event Player.HudMenu = Null;
		End;
		Call Subroutine(GambarHalamanAktif);
		Call Subroutine(TransisiWarnaMenu);
		If(Index Of Array Value(Globale.PemainManusia, Event Player) >= 0);
			Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Event Player)] = Event Player.HudMenu;
		End;
	}
}

regola("91a - Subrutin: Gambar menu utama")
{
	evento
	{
		Subroutine;
		GambarUtama;
	}

	azioni
	{
		Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String("Hold CROUCH + command\n{0}: next | {1}: previous", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: open | hold {1} 0.5 sec: close", Input Binding String(Button(Interact)), Input Binding String(Button(Melee)))) : Event Player.IndeksBahasa == 1 ? Custom String("{0}\n{1}", Custom String("Tahan JONGKOK + perintah\n{0}: berikutnya | {1}: sebelumnya", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: buka | tahan {1} 0,5 dtk: tutup", Input Binding String(Button(Interact)), Input Binding String(Button(Melee)))) : Custom String("{0}\n{1}", Custom String("กด ย่อ + คำสั่ง\n{0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: เปิด | กด {1} ค้าง 0.5 วินาที: ปิด", Input Binding String(Button(Interact)), Input Binding String(Button(Melee)))), Event Player.IndeksBahasa == 0 ? Event Player.KursorUtama == 0 ? Custom String("0 - NAME COLOR\nCURRENT: {0}", Globale.NamaWarnaInggris[Event Player.IndeksWarna]) : Event Player.KursorUtama == 1 ? Custom String("1 - THIRD-PERSON\nCURRENT: {0}", Event Player.ModeKamera == 0 ? Custom String("off") : Event Player.ModeKamera == 1 ? Custom String("your hero") : Custom String("watching {0}", Event Player.TargetKamera)) : Event Player.KursorUtama == 2 ? Custom String("2 - SOUNDTRACK\nCURRENT: {0}", Event Player.MusikKhusus != Null ? Event Player.MusikKhusus : Event Player.IndeksGenre >= 0 ? Globale.DaftarGenre[Event Player.IndeksGenre] : Custom String("no soundtrack yet")) : Event Player.KursorUtama == 3 ? Custom String("3 - LANGUAGE\nCURRENT: {0}", Globale.NamaBahasa[Event Player.IndeksBahasa]) : Event Player.KursorUtama == 4 ? Custom String("4 - REVENGE\nSETTLE YOUR SCORE") : Event Player.KursorUtama == 5 ? Custom String("5 - UNKILLABLE\nCURRENT: {0}", Event Player.ModeKebal == 0 ? Custom String("OFF") : Event Player.ModeKebal == 1 ? Custom String("1 HP (HEALABLE)") : Custom String("FULL HP")) : Event Player.KursorUtama == 6 ? Custom String("6 - HERO VOICE\nCURRENT: {0}", Event Player.IndeksSuara == 0 ? Custom String("NORMAL") : Event Player.IndeksSuara == 1 ? Custom String("LOW 0.50x") : Event Player.IndeksSuara == 2 ? Custom String("LOW 0.75x") : Event Player.IndeksSuara == 3 ? Custom String("HIGH 1.25x") : Custom String("HIGH 1.50x")) : Event Player.KursorUtama == 7 ? Event Player.IndeksIkon == 0 ? Custom String("7 - ICON\nCURRENT: NOTHING") : Custom String("7 - ICON\nCURRENT: {0} {1}", Globale.DaftarIkon[Event Player.IndeksIkon], Globale.NamaIkonInggris[Event Player.IndeksIkon]) : Event Player.KursorUtama == 8 ? Custom String("8 - CROUCH TRAVEL & ATTACH\nCURRENT: {0}", Event Player.TeleportasiJongkokDiaktifkan ? Custom String("ON") : Custom String("OFF")) : Event Player.KursorUtama == 9 ? Custom String("9 - CROUCH PRIVACY\nCURRENT: {0}", Event Player.PrivasiInspeksiAktif ? Custom String("ON") : Custom String("OFF")) : Event Player.KursorUtama == 10 ? Custom String("10 - TRY YOUR LUCK\nSTATUS: {0}", Event Player.KartuNasibAktif ? Event Player.PutaranKartuNasib > 0 ? Custom String("ROLLING") : Custom String("ACTIVE") : Custom String("READY")) : Event Player.KursorUtama == 11 ? Custom String("11 - VOTE PLAYER\nYOUR VOTE: {0}", Event Player.PemainDipilih != Null ? Event Player.PemainDipilih : Custom String("NONE")) : Event Player.KursorUtama == 12 ? Custom String("12 - DUMMY FOLLOW\nCURRENT: {0}", Event Player.IzinkanDummyMengikuti ? Custom String("ON") : Custom String("OFF")) : Custom String("13 - GHOST MODE / FLY\nWALL PHASING: {0}\nFLY MODE: {1}", Event Player.ModeHantuAktif ? Custom String("ON") : Custom String("OFF"), Event Player.ModeTerbangAktif ? Custom String("ON") : Custom String("OFF")) : Event Player.IndeksBahasa == 1 ? Event Player.KursorUtama == 0 ? Custom String("0 - WARNA NA