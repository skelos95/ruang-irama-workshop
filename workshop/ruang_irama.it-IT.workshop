regola("99k - Subrutin: Terapkan halaman coba nasib")
{
	evento
	{
		Subroutine;
		TerapkanHalamanNasib;
	}

	azioni
	{
		If(Globale.PemainPemicu.KartuNasibAktif);
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Try Your Luck already active.") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Coba Nasib masih aktif. Sabar, ya!") : Custom String("เสี่ยงโชคอยู่ รอจบก่อน"))));
		Else If(Globale.PemainPemicu.KematianBalasDendam);
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Under Revenge. Try Your Luck is locked.") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Tunggu balas dendam selesai, baru Coba Nasib.") : Custom String("กำลังโดนล้างแค้น รอจบก่อนเสี่ยงโชค"))));
		Else;
		Globale.PemainPemicu.KartuNasibAktif = True;
		Globale.PemainPemicu.EfekNasib = Random Integer(1, 6);
		Globale.PemainPemicu.PutaranKartuNasib = Random Integer(20, 24);
		Globale.PemainPemicu.JedaKartuNasib = 0.080;
		Globale.PemainPemicu.EfekNasibBerakhir = 0;
		Globale.PemainPemicu.WaktuBakarNasibBerikut = 0;
		Globale.PemainPemicu.WaktuPutaranNasibBerikut = Total Time Elapsed;
		Globale.PemainPemicu.WaktuIkonNasibBerakhir = 0;
		Globale.PemainPemicu.PrivasiNasibAktif = False;
		Globale.PemainPemicu.MenuNasibHarusDibuka = False;
		If((Globale.PemainPemicu.IkonKartuNasib != Null));
		Destroy Icon(Globale.PemainPemicu.IkonKartuNasib);
		End;
		Globale.PemainPemicu.IkonKartuNasib = Null;
		If(Array Contains(Globale.PemainManusia, Globale.PemainPemicu));
		Globale.IkonKartuNasibPemain[Globale.SlotHUDPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)]] = 0;
		End;
		End;
	}
}

