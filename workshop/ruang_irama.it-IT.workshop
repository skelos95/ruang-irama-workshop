regola("91g - Subrutin: Gambar menu teleportasi")
{
	evento
	{
		Subroutine;
		GambarTeleportasi;
	}

	azioni
	{
		If(Event Giocatore.HudMenu != Null);
			Distruggi HUD Text(Event Giocatore.HudMenu);
		End;
		Event Giocatore.HudMenu = Null;
		If(Index Of Array Value(Globale.PemainManusia, Event Giocatore) >= 0);
			Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Event Giocatore)] = 0;
		End;
		Event Giocatore.KursorTeleportasi %= 3;
		Create HUD Text(Event Giocatore, Null, Event Giocatore.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String("{0}: teleport | {1}: next page", Input Binding String(Button(Fuoco Primario)), Input Binding String(Button(Secondary Fire))), Custom String("release {0}: close", Input Binding String(Button(Accovacciati)))) : Event Giocatore.IndeksBahasa == 1 ? Custom String("{0}\n{1}", Custom String("{0}: teleport | {1}: halaman berikutnya", Input Binding String(Button(Fuoco Primario)), Input Binding String(Button(Secondary Fire))), Custom String("lepas {0}: tutup", Input Binding String(Button(Accovacciati)))) : Custom String("{0}\n{1}", Custom String("{0}: เทเลพอร์ต | {1}: หน้าถัดไป", Input Binding String(Button(Fuoco Primario)), Input Binding String(Button(Secondary Fire))), Custom String("ปล่อย {0}: ปิด", Input Binding String(Button(Accovacciati)))), Event Giocatore.IndeksBahasa == 0 ? Event Giocatore.KursorTeleportasi == 0 ? Custom String("TELEPORT 1/3\n> SPAWN ROOM\n{0}", Is In Genera Room(Event Giocatore) ? Custom String("YOU ARE ALREADY HERE") : Custom String("PRIMARY FIRE: TELEPORT")) : Event Giocatore.KursorTeleportasi == 1 ? Custom String("TELEPORT 2/3\n> OBJECTIVE / FLAG\nPRIMARY FIRE: TELEPORT") : Custom String("TELEPORT 3/3\n> ALL PLAYERS\nTARGET: {0}\nAIM AT A VISIBLE NAME", Event Giocatore.CalonTargetTeleportasi != Null ? Event Giocatore.CalonTargetTeleportasi : Custom String("NO PUBLIC TARGET")) : Event Giocatore.IndeksBahasa == 1 ? Event Giocatore.KursorTeleportasi == 0 ? Custom String("TELEPORT 1/3\n> RUANG MUNCUL\n{0}", Is In Genera Room(Event Giocatore) ? Custom String("KAMU SUDAH DI SINI") : Custom String("PRIMARY FIRE: TELEPORT")) : Event Giocatore.KursorTeleportasi == 1 ? Custom String("TELEPORT 2/3\n> OBJEKTIF / BENDERA\nPRIMARY FIRE: TELEPORT") : Custom String("TELEPORT 3/3\n> SEMUA PLAYER\nTARGET: {0}\nARAHKAN KE NAMA YANG TERLIHAT", Event Giocatore.CalonTargetTeleportasi != Null ? Event Giocatore.CalonTargetTeleportasi : Custom String("TIDAK ADA TARGET PUBLIK")) : Event Giocatore.KursorTeleportasi == 0 ? Custom String("เทเลพอร์ต 1/3\n> ห้องเกิด\n{0}", Is In Genera Room(Event Giocatore) ? Custom String("คุณอยู่ที่นี่แล้ว") : Custom String("ยิงหลัก: เทเลพอร์ต")) : Event Giocatore.KursorTeleportasi == 1 ? Custom String("เทเลพอร์ต 2/3\n> เป้าหมาย / ธง\nยิงหลัก: เทเลพอร์ต") : Custom String("เทเลพอร์ต 3/3\n> ผู้เล่นทั้งหมด\nเป้าหมาย: {0}\nเล็งไปที่ชื่อที่มองเห็น", Event Giocatore.CalonTargetTeleportasi != Null ? Event Giocatore.CalonTargetTeleportasi : Custom String("ไม่มีเป้าหมายสาธารณะ")), Top, 100, Color(Bianco), Custom Color(205, 255, 225, 255), Custom Color(80, 255, 160, 255), Visibile a and String, Visibile Mai);
		Event Giocatore.HudMenu = Last Text ID;
		If(Index Of Array Value(Globale.PemainManusia, Event Giocatore) >= 0);
			Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Event Giocatore)] = Event Giocatore.HudMenu;
		End;
	}
