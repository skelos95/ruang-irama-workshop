regola("91p - Subrutin: Gambar halaman aktif")
{
	evento
	{
		Subroutine;
		GambarHalamanAktif;
	}

	azioni
	{
		If(Event Player.HalamanMenu == -1);
			Call Subroutine(GambarUtama);
		Else If(Event Player.HalamanMenu == 0);
			Call Subroutine(GambarWarna);
		Else If(Event Player.HalamanMenu == 1);
			Call Subroutine(GambarKamera);
		Else If(Event Player.HalamanMenu == 2);
			Call Subroutine(GambarMusik);
		Else If(Event Player.HalamanMenu == 3);
			Call Subroutine(GambarBahasa);
		Else If(Event Player.HalamanMenu == 4);
			Call Subroutine(GambarBalasDendam);
		Else If(Event Player.HalamanMenu == 5);
			Call Subroutine(GambarKebal);
		Else If(Event Player.HalamanMenu == 6);
			Call Subroutine(GambarSuara);
		Else If(Event Player.HalamanMenu == 7);
			Call Subroutine(GambarIkon);
		Else If(Event Player.HalamanMenu == 8);
			Call Subroutine(GambarSakelarTeleportasi);
		Else If(Event Player.HalamanMenu == 9);
			Call Subroutine(GambarPrivasiInspeksi);
		Else If(Event Player.HalamanMenu == 10);
			Call Subroutine(GambarNasib);
		Else If(Event Player.HalamanMenu == 11);
			Call Subroutine(GambarPilihan);
		Else If(Event Player.HalamanMenu == 12);
			Call Subroutine(GambarIkutiDummy);
		Else If(Event Player.HalamanMenu == 13);
			Call Subroutine(GambarHantuTerbang);
		End;
	}
}

regola("91k - Subrutin: Transisi warna menu tanpa lompatan")
{
	evento
	{
		Subroutine;
		TransisiWarnaMenu;
	}

	azioni
	{
		If(Event Player.TeleportasiJongkokAktif == True);
			Chase Player Variable Over Time(Event Player, WarnaMenu, Event Player.KursorTeleportasi == 0 ? Vector(80, 255, 160) : Event Player.KursorTeleportasi == 1 ? Vector(65, 225, 255) : Event Player.KursorTeleportasi == 2 ? Vector(95, 150, 255) : Event Player.KursorTeleportasi == 3 ? Vector(195, 100, 255) : Vector(255, 85, 135), 0.180, Destination and Duration);
		Else;
		"Setiap halaman punya nuansa sendiri, tetapi semuanya berangkat dari Name Color aktif."
		Chase Player Variable Over Time(Event Player, WarnaMenu, (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 0 ? Globale.DaftarWarnaRGB[Event Player.KursorWarna] : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 1 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.700 + Vector(70, 135, 255) * 0.300 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 2 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.680 + Vector(55, 235, 245) * 0.320 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 3 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.720 + Vector(185, 105, 255) * 0.280 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 4 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.690 + Vector(255, 75, 85) * 0.310 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 5 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.700 + Vector(255, 145, 55) * 0.300 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 6 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.680 + Vector(255, 80, 205) * 0.320 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 7 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.730 + Vector(170, 240, 85) * 0.270 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 8 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.700 + Vector(65, 225, 130) * 0.300 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 9 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.720 + Vector(55, 190, 170) * 0.280 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 10 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.660 + Vector(255, 210, 70) * 0.340 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 11 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.720 + Vector(255, 120, 155) * 0.280 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 12 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.700 + Vector(70, 220, 175) * 0.300 : Globale.DaftarWarnaRGB[Event Player.IndeksWarna], 0.180, Destination and Duration);
		If((Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 13);
			Chase Player Variable Over Time(Event Player, WarnaMenu, Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.680 + Vector(110, 170, 255) * 0.320, 0.180, Destination and Duration);
		End;
		End;
	}
}

regola("92 - Subrutin: Kunci bot/dummy, kaki tetap bisa bergerak")
{
	evento
	{
		Subroutine;
		KunciBot;
	}

	azioni
	{
		Abort If(Entity Exists(Event Player) == False);
		Abort If(Is Alive(Event Player) == False);
		Event Player.MenuTerbuka = False;
		Event Player.SeranganDekatDipakai = False;
		Event Player.HalamanMenu = -1;
		Set Primary Fire Enabled(Event Player, False);
		Set Secondary Fire Enabled(Event Player, False);
		Set Ability 1 Enabled(Event Player, False);
		Set Ability 2 Enabled(Event Player, False);
		Set Ultimate Ability Enabled(Event Player, False);
		Set Melee Enabled(Event Player, False);
		Disallow Button(Event Player, Button(Primary Fire));
		Disallow Button(Event Player, Button(Secondary Fire));
		Disallow Button(Event Player, Button(Ability 1));
		Disallow Button(Event Player, Button(Ability 2));
		Disallow Button(Event Player, Button(Ultimate));
		Disallow Button(Event Player, Button(Melee));
		Disallow Button(Event Player, Button(Jump));
		Disallow Button(Event Player, Button(Reload));
		Disallow Button(Event Player, Button(Interact));
		Set Damage Dealt(Event Player, 0);
		Set Healing Dealt(Event Player, 0);
		Set Knockback Dealt(Event Player, 0);
		Set Damage Received(Event Player, 100);
		Set Knockback Received(Event Player, 100);
		Set Move Speed(Event Player, 20);
		Event Player.PahlawanTerakhir = Hero Of(Event Player);
		Event Player.TargetDummyIkuti = Null;
		Event Player.KunciBotAktif = True;
		Disable Nameplates(Event Player, Filtered Array(Globale.PemainManusia, Player Variable(Current Array Element, InspeksiAktif) == True));
	}
}

