regola("18i - Nasib: Visi menampilkan semua nama pemain dan bot")
{
	evento
	{
		Subroutine;
		Pengatur18i;
	}

	azioni
	{
		Abort If(Not(And(Or(Array Contains(Globale.PemilikTeksSementara, Globale.PemainPemicu), Array Contains(Globale.PemilikTeksSementara, Null)), And(Or((Globale.PemainPemicu.TeksVisiNasib == Null), (Globale.PemainPemicu.TeksVisiNasib == 0)), And(Is Alive(Globale.PemainPemicu), And(Or(Is Dummy Bot(Globale.PemainPemicu), Or(Globale.PemainPemicu.BotOtomatis, Globale.PemainPemicu.Manusia)), (Count Of(Filtered Array(Globale.PenontonVisiNasib, And((Current Array Element != Globale.PemainPemicu), And(Entity Exists(Current Array Element), And(Player Variable(Current Array Element, Manusia), Player Variable(Current Array Element, PrivasiNasibAktif)))))) > 0)))))));
		Globale.IndeksTeksPembersihan = Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu);
		If((Globale.IndeksTeksPembersihan < 0));
		Globale.IndeksTeksPembersihan = Index Of Array Value(Globale.PemilikTeksSementara, Null);
		If((Globale.IndeksTeksPembersihan < 0));
		Globale.PemainTeksPembersihan = Null;
		Call Subroutine(BersihkanTeksYatim);
		Globale.IndeksTeksPembersihan = Index Of Array Value(Globale.PemilikTeksSementara, Null);
		End;
		Abort If((Globale.IndeksTeksPembersihan < 0));
		If(Or((Globale.HudEfekSementara[Globale.IndeksTeksPembersihan] != 0), Or((Globale.TeksTeleportasiSementara[Globale.IndeksTeksPembersihan] != 0), (Globale.TeksVisiSementara[Globale.IndeksTeksPembersihan] != 0))));
		Globale.PemainTeksPembersihan = Null;
		Call Subroutine(BersihkanTeksYatim);
		Globale.IndeksTeksPembersihan = Index Of Array Value(Globale.PemilikTeksSementara, Null);
		End;
		Abort If((Globale.IndeksTeksPembersihan < 0));
		Globale.PemilikTeksSementara[Globale.IndeksTeksPembersihan] = Globale.PemainPemicu;
		End;
		Create In-World Text(Filtered Array(Globale.PenontonVisiNasib, And((Current Array Element != Evaluate Once(Globale.PemainPemicu)), And(Entity Exists(Current Array Element), And(Player Variable(Current Array Element, Manusia), Player Variable(Current Array Element, PrivasiNasibAktif))))), Custom String("{0} {1} | {2}", Hero Icon String((Is Duplicating(Evaluate Once(Globale.PemainPemicu)) ? Hero Being Duplicated(Evaluate Once(Globale.PemainPemicu)) : Hero Of(Evaluate Once(Globale.PemainPemicu)))), (Player Variable(Evaluate Once(Globale.PemainPemicu), Manusia) ? Player Variable(Evaluate Once(Globale.PemainPemicu), NamaTampilan) : Custom String("{0}", Evaluate Once(Globale.PemainPemicu))), Round To Integer(Health(Evaluate Once(Globale.PemainPemicu)), Down)), Update Every Frame((Eye Position(Evaluate Once(Globale.PemainPemicu)) + Vector(0, 0.450, 0))), 1.100, Do Not Clip, Visible To Position String and Color, (Player Variable(Evaluate Once(Globale.PemainPemicu), Manusia) ? Player Variable(Evaluate Once(Globale.PemainPemicu), WarnaNama) : Color(Orange)), Visible Never);
		Globale.PemainPemicu.TeksVisiNasib = Last Text ID;
		Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu)] = Globale.PemainPemicu.TeksVisiNasib;
	}
}

regola("18j - Nasib: Bersihkan nama visi saat tidak diperlukan")
{
	evento
	{
		Subroutine;
		Pengatur18j;
	}

	azioni
	{
		Abort If(Not(And(Not(Globale.PemainPemicu.PindahTimDiproses), And(Not(Globale.PemainPemicu.SiklusPemainAktif), And(And((Globale.PemainPemicu.TeksVisiNasib != Null), (Globale.PemainPemicu.TeksVisiNasib != 0)), Or(Not(Is Alive(Globale.PemainPemicu)), (Count Of(Filtered Array(Globale.PenontonVisiNasib, And((Current Array Element != Globale.PemainPemicu), And(Entity Exists(Current Array Element), And(Player Variable(Current Array Element, Manusia), Player Variable(Current Array Element, PrivasiNasibAktif)))))) == 0)))))));
		If((Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu) >= 0));
		If((Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu)] == Globale.PemainPemicu.TeksVisiNasib));
		Destroy In-World Text(Globale.PemainPemicu.TeksVisiNasib);
		Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu)] = 0;
		End;
		End;
		Globale.PemainPemicu.TeksVisiNasib = Null;
	}
}

regola("18k - Nasib: HUD efek dan durasi saat menu tertutup")
{
	evento
	{
		Subroutine;
		Pengatur18k;
	}

	azioni
	{
		Abort If(Not(And(Or(Array Contains(Globale.PemilikTeksSementara, Globale.PemainPemicu), Array Contains(Globale.PemilikTeksSementara, Null)), And(Globale.PemainPemicu.KartuNasibAktif, And((Globale.PemainPemicu.PutaranKartuNasib == 0), And((Globale.PemainPemicu.EfekNasibBerakhir > 0), And((Globale.PemainPemicu.HudEfekNasib == Null), Is Alive(Globale.PemainPemicu))))))));
		Globale.IndeksTeksPembersihan = Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu);
		If((Globale.IndeksTeksPembersihan < 0));
		Globale.IndeksTeksPembersihan = Index Of Array Value(Globale.PemilikTeksSementara, Null);
		If((Globale.IndeksTeksPembersihan < 0));
		Globale.PemainTeksPembersihan = Null;
		Call Subroutine(BersihkanTeksYatim);
		Globale.IndeksTeksPembersihan = Index Of Array Value(Globale.PemilikTeksSementara, Null);
		End;
		Abort If((Globale.IndeksTeksPembersihan < 0));
		If(Or((Globale.HudEfekSementara[Globale.IndeksTeksPembersihan] != 0), Or((Globale.TeksTeleportasiSementara[Globale.IndeksTeksPembersihan] != 0), (Globale.TeksVisiSementara[Globale.IndeksTeksPembersihan] != 0))));
		Globale.PemainTeksPembersihan = Null;
		Call Subroutine(BersihkanTeksYatim);
		Globale.IndeksTeksPembersihan = Index Of Array Value(Globale.PemilikTeksSementara, Null);
		End;
		Abort If((Globale.IndeksTeksPembersihan < 0));
		Globale.PemilikTeksSementara[Globale.IndeksTeksPembersihan] = Globale.PemainPemicu;
		End;
		Create HUD Text(Evaluate Once(Globale.PemainPemicu), Null, Null, ((Player Variable(Local Player, IndeksBahasa) == 0) ? Custom String("{0}\n{1}", ((Player Variable(Local Player, EfekNasib) == 1) ? Custom String("VISION: ALL PLAYER/BOT NAMES") : ((Player Variable(Local Player, EfekNasib) == 2) ? Custom String("AIM-STEERED ACCELERATION") : ((Player Variable(Local Player, EfekNasib) == 5) ? Custom String("BURNING: 5% MAX HP/s") : Custom String("HACKED")))), Custom String("{0}s LEFT", Max(0, Round To Integer((Player Variable(Local Player, EfekNasibBerakhir) - Total Time Elapsed), Up)))) : ((Player Variable(Local Player, IndeksBahasa) == 1) ? Custom String("{0}\n{1}", ((Player Variable(Local Player, EfekNasib) == 1) ? Custom String("VISI: NAMA SEMUA PEMAIN / BOT") : ((Player Variable(Local Player, EfekNasib) == 2) ? Custom String("AKSELERASI SESUAI BIDIKAN") : ((Player Variable(Local Player, EfekNasib) == 5) ? Custom String("TERBAKAR: 5% HP MAKS / DTK") : Custom String("DIRETAS")))), Custom String("SISA {0} dtk", Max(0, Round To Integer((Player Variable(Local Player, EfekNasibBerakhir) - Total Time Elapsed), Up)))) : Custom String("{0}\n{1}", ((Player Variable(Local Player, EfekNasib) == 1) ? Custom String("มองเห็นชื่อผู้เล่น / บอตทั้งหมด") : ((Player Variable(Local Player, EfekNasib) == 2) ? Custom String("เร่งตามทิศเล็ง") : ((Player Variable(Local Player, EfekNasib) == 5) ? Custom String("ไฟไหม้: 5% HP สูงสุด/วิ") : Custom String("ถูกแฮ็ก")))), Custom String("เหลือ {0} วิ", Max(0, Round To Integer((Player Variable(Local Player, EfekNasibBerakhir) - Total Time Elapsed), Up)))))), Top, 3, Color(Bianco), Color(Bianco), Globale.RGB, Visible To String and Color, Visible Never);
		Globale.PemainPemicu.HudEfekNasib = Last Text ID;
		Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu)] = Globale.PemainPemicu.HudEfekNasib;
	}
}

regola("19 - Teleportasi Jongkok: Buka lima halaman selama Jongkok ditahan")
{
	evento
	{
		Subroutine;
		Pengatur19;
	}

	azioni
	{
		Abort If(Not(And(Not(Globale.PemainPemicu.PindahTimDiproses), And(Not(Globale.PemainPemicu.SiklusPemainAktif), And(Not(Globale.PemainPemicu.MenuTerbuka), And(Not(Globale.PemainPemicu.KartuNasibAktif), And(Not(Globale.PemainPemicu.PrivasiNasibAktif), And(Not(Globale.PemainPemicu.TeleportasiJongkokAktif), And(Globale.PemainPemicu.TeleportasiJongkokDiaktifkan, And(Has Spawned(Globale.PemainPemicu), And(Is Alive(Globale.PemainPemicu), Is Button Held(Globale.PemainPemicu, Button(Crouch)))))))))))));
		Globale.PemainPemicu.TeleportasiJongkokAktif = True;
		Globale.PemainPemicu.PerintahTeleportasi = 0;
