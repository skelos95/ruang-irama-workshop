		Globale.PemainPemicu.KursorPilihan %= Count Of(Globale.PemainManusia);
		If((Globale.PemainPemicu.PemainDipilih != Globale.PemainManusia[Globale.PemainPemicu.KursorPilihan]));
		Globale.PemainPemicu.PemainDipilih = Globale.PemainManusia[Globale.PemainPemicu.KursorPilihan];
		Globale.PilihanPerluDihitung = True;
		End;
		End;
	}
}

