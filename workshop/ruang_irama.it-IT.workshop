	}
}

regola("00a1 - Umum: Mulai mode segera saat menunggu pemain")
{
	evento
	{
		Ongoing - Global;
	}

	condizioni
	{
		Globale.Siap == True;
		Globale.ModeMulaiDiminta == False;
		Is Game In Progress == False;
		Is Waiting For Players == True;
	}

	azioni
	{
		Globale.ModeMulaiDiminta = True;
		Start Game Mode;
	}
}

regola("00a2 - Umum: Lewati pemilihan pahlawan")
{
	evento
	{
		Ongoing - Global;
	}

	condizioni
	{
		Globale.Siap == True;
		Globale.PilihPahlawanDilewati == False;
		Count Of(Globale.PemainManusia) == 0;
		Globale.PemainSiklusGlobal == Null;
		Is Game In Progress == False;
		Is Assembling Heroes == True;
	}

	azioni
	{
		Globale.PilihPahlawanDilewati = True;
		Set Match Time(0);
	}
}

regola("00a3 - Umum: Lewati persiapan awal")
{
	evento
	{
		Ongoing - Global;
	}

	condizioni
	{
		Globale.Siap == True;
		Globale.PersiapanDilewati == False;
		Count Of(Globale.PemainManusia) == 0;
		Globale.PemainSiklusGlobal == Null;
		Is Game In Progress == False;
		Is In Setup == True;
	}

	azioni
	{
		Globale.PersiapanDilewati = True;
		Set Match Time(0);
	}
}

regola("00a4 - Umum: Kunci pelewatan fase awal setelah mode berjalan")
{
	evento
	{
		Ongoing - Global;
	}

	condizioni
	{
		Globale.Siap == True;
		Is Game In Progress == True;
		Or(Globale.PilihPahlawanDilewati == False, Globale.PersiapanDilewati == False) == True;
	}

	azioni
	{
		Globale.PilihPahlawanDilewati = True;
		Globale.PersiapanDilewati = True;
	}
}

regola("00c - Umum: Mulai ulang tepat sekali saat hitung mundur habis")
{
	evento
	{
		Ongoing - Global;
	}

	condizioni
	{
		Globale.Siap == True;
		Globale.MulaiUlangSudahDiminta == False;
		Globale.SisaWaktuServer <= 0;
	}

	azioni
	{
		Globale.MulaiUlangSudahDiminta = True;
		Globale.PilihPahlawanDilewati = False;
		Globale.PersiapanDilewati = False;
		Globale.ModeMulaiDiminta = False;
		Restart Match;
	}
}

regola("01a - Siklus tim: Karantina sebelum penyiapan ulang")
{
	evento
	{
		Subroutine;
		Pengatur01a;
	}

	azioni
	{
		Abort If(Not(And(Globale.Siap, And(Not(Is Dummy Bot(Globale.PemainPemicu)), And(Not(Globale.PemainPemicu.BotOtomatis), And(Array Contains(Globale.PemainManusia, Globale.PemainPemicu), (Globale.PemainPemicu.TimTerakhir != Team Of(Globale.PemainPemicu))))))));
		Globale.PemainPemicu.PembaruanDaftarTertunda = False;
		Globale.PemainPemicu.PindahTimDiproses = True;
		Globale.PemainPemicu.SiklusPemainAktif = True;
		Globale.PemainPemicu.SudahSiap = False;
		Globale.PemainPemicu.Manusia = False;
		Globale.PemainPukulanSuper = Remove From Array(Globale.PemainPukulanSuper, Globale.PemainPemicu);
		Globale.PemainPemicu.TimTerakhir = Team Of(Globale.PemainPemicu);
		Globale.PemainPemicu.TimSiklusTarget = Team Of(Globale.PemainPemicu);
		Globale.PemainPemicu.WaktuSiklusTim = (Total Time Elapsed + 0.500);
		If((Globale.PemainSiklusGlobal == Globale.PemainPemicu));
		Globale.PemainSiklusGlobal = Null;
		Globale.WaktuSiklusGlobal = (Total Time Elapsed + 0.250);
		End;
		Globale.PemainPemicu.WaktuPengatur[36] = Globale.PemainPemicu.StatusPengatur[36];
		Globale.PemainPemicu.StatusPengatur = Empty Array;
		Globale.PemainPemicu.StatusPengatur[36] = Globale.PemainPemicu.WaktuPengatur[36];
		Globale.PemainPemicu.WaktuPengatur = Empty Array;
		If((Globale.PemilikFaseSiklus == Globale.PemainPemicu));
		Globale.PemilikFaseSiklus = Null;
		Globale.FaseSiklusGlobal = 0;
		End;
	}
}

regola("01b - Siklus tim: Pekerja penyiapan dari penjadwal global")
{
	evento
	{
		Subroutine;
		Pengatur01b;
	}

	azioni
	{
		Abort If(Not(And(Globale.Siap, And(Entity Exists(Globale.PemainPemicu), And(Not(Globale.PemainPemicu.Manusia), And(Not(Is Dummy Bot(Globale.PemainPemicu)), And(Not(Globale.PemainPemicu.BotOtomatis), And(Globale.PemainPemicu.PindahTimDiproses, And((Globale.PemainSiklusGlobal == Globale.PemainPemicu), And((Globale.PemainPemicu.TimSiklusTarget == Team Of(Globale.PemainPemicu)), And(Has Spawned(Globale.PemainPemicu), And(Not(Globale.PemainPemicu.SudahSiap), (Total Time Elapsed >= Globale.PemainPemicu.WaktuSiklusTim)))))))))))));
		If((Globale.PemilikFaseSiklus != Globale.PemainPemicu));
		Globale.PemilikFaseSiklus = Globale.PemainPemicu;
		Globale.FaseSiklusGlobal = 0;
		Globale.WaktuFaseSiklusGlobal = 0;
		End;
		Abort If((Total Time Elapsed < Globale.WaktuFaseSiklusGlobal));
		If((Globale.FaseSiklusGlobal == 0));
		Call Subroutine(TenangkanPemain);
		Globale.FaseSiklusGlobal = 1;
		Globale.WaktuFaseSiklusGlobal = (Total Time Elapsed + 0.050);
		Else If((Globale.FaseSiklusGlobal == 1));
		Abort If(Not(Entity Exists(Globale.PemainPemicu)));
		Abort If(Globale.PemainPemicu.BotOtomatis);
		Abort If(Not(Globale.PemainPemicu.PindahTimDiproses));
		Abort If((Globale.PemainPemicu.TimSiklusTarget != Team Of(Globale.PemainPemicu)));
		Abort If(Globale.PemainPemicu.SudahSiap);
		If(Array Contains(Globale.PemainManusia, Globale.PemainPemicu));
		Call Subroutine(BersihkanPemain);
		End;
		Globale.FaseSiklusGlobal = 2;
		Globale.WaktuFaseSiklusGlobal = (Total Time Elapsed + 0.050);
		Else If((Globale.FaseSiklusGlobal == 2));
		Abort If(Not(Entity Exists(Globale.PemainPemicu)));
		Abort If(Globale.PemainPemicu.BotOtomatis);
		Abort If(Not(Globale.PemainPemicu.PindahTimDiproses));
		Abort If((Globale.PemainPemicu.TimSiklusTarget != Team Of(Globale.PemainPemicu)));
		Abort If(Globale.PemainPemicu.SudahSiap);
		Call Subroutine(SiapkanPemain);
		Globale.FaseSiklusGlobal = 3;
		End;
		If((Globale.FaseSiklusGlobal == 3));
		Globale.PemilikFaseSiklus = Null;
		Globale.FaseSiklusGlobal = 0;
		End;
	}
}

regola("02 - Pemain: Pisahkan manusia dari pasukan kaleng")
{
	evento
	{
		Subroutine;
		Pengatur02;
	}

	azioni
	{
		If((Globale.PemainPemicu.StatusPengatur[2] == 2));
		Abort If((Total Time Elapsed < Globale.PemainPemicu.WaktuPengatur[2]));
		If(Or((Globale.PemainPemicu.TimTerakhir != Team Of(Globale.PemainPemicu)), (Globale.PemainPemicu.TimSiklusTarget != Team Of(Globale.PemainPemicu))));
		Stop Forcing Dummy Bot Name(Globale.PemainPemicu);
		Globale.PemainPemicu.SudahDiperiksa = False;
		Globale.PemainPemicu.StatusPengatur[2] = 0;
		Abort;
		End;
		Globale.PemainPemicu.StatusPengatur[2] = 1;
		Abort If(Not(Entity Exists(Globale.PemainPemicu)));
		If(Or(Not(Globale.PemainPemicu.SudahSiap), Not(Has Spawned(Globale.PemainPemicu))));
		Stop Forcing Dummy Bot Name(Globale.PemainPemicu);
		Globale.PemainPemicu.SudahDiperiksa = False;
		Abort;
		End;
		If((Custom String("{0}", Globale.PemainPemicu) == Custom String("​")));
		Globale.PemainPemicu.BotOtomatis = True;
		End;
		Stop Forcing Dummy Bot Name(Globale.PemainPemicu);
		Globale.PemainPemicu.StatusPengatur[2] = 3;
		Else;
		Abort If(Not(And(Globale.Siap, And(Not(Is Dummy Bot(Globale.PemainPemicu)), And(Not(Globale.PemainPemicu.BotOtomatis), And(Not(Array Contains(Globale.PemainManusia, Globale.PemainPemicu)), And(Globale.PemainPemicu.SudahSiap, And(Not(Globale.PemainPemicu.SiklusPemainAktif), And(Has Spawned(Globale.PemainPemicu), And((Globale.PemainPemicu.TimTerakhir == Team Of(Globale.PemainPemicu)), And(Not(Globale.PemainPemicu.PembaruanDaftarTertunda), Not(Globale.PemainPemicu.SudahDiperiksa))))))))))));
		Globale.PemainPemicu.SudahDiperiksa = True;
		Globale.PemainPemicu.BotOtomatis = False;
		Globale.PemainPemicu.Manusia = False;
		Globale.PemainPemicu.WarnaNama = Color(Bianco);
		If(And(Globale.PemainPemicu.PernahDisiapkan, And((Globale.PemainPemicu.NamaTampilan != Null), (Globale.PemainPemicu.NamaTampilan != Custom String("")))));
		Globale.PemainPemicu.StatusPengatur[2] = 3;
		Else;
		Start Forcing Dummy Bot Name(Evaluate Once(Globale.PemainPemicu), Custom String("​"));
		Globale.PemainPemicu.StatusPengatur[2] = 2;
		Globale.PemainPemicu.WaktuPengatur[2] = (Total Time Elapsed + 0.016);
		End;
		End;
		If((Globale.PemainPemicu.StatusPengatur[2] == 3));
		Globale.PemainPemicu.StatusPengatur[2] = 0;
		If(Globale.PemainPemicu.BotOtomatis);
		Globale.PemainPemicu.PindahTimDiproses = False;
		Globale.PemainPemicu.SiklusPemainAktif = False;
		Globale.PemainPemicu.WaktuSiklusTim = 0;
		If((Globale.PemainSiklusGlobal == Globale.PemainPemicu));
		Globale.PemainSiklusGlobal = Null;
		Globale.WaktuSiklusGlobal = (Total Time Elapsed + 0.250);
		End;
		Cancel Primary Action(Globale.PemainPemicu);
		Call Subroutine(KunciBot);
		Abort;
		End;
		Abort If(Not(Entity Exists(Globale.PemainPemicu)));
		Abort If(Array Contains(Globale.PemainManusia, Globale.PemainPemicu));
		If((Count Of(Globale.SlotHUDTersedia) == 0));
		Globale.PemainPemicu.SudahDiperiksa = False;
		Globale.PemainPemicu.SudahSiap = False;
		Globale.PemainPemicu.PindahTimDiproses = False;
		Globale.PemainPemicu.SiklusPemainAktif = False;
		Globale.PemainPemicu.WaktuSiklusTim = (Total Time Elapsed + 0.250);
		If((Globale.PemainSiklusGlobal == Globale.PemainPemicu));
		Globale.PemainSiklusGlobal = Null;
		Globale.WaktuSiklusGlobal = (Total Time Elapsed + 0.250);
		End;
		Abort;
		End;
		If(Or(Not(Globale.PemainPemicu.PernahDisiapkan), Or((Globale.PemainPemicu.NamaTampilan == Null), (Globale.PemainPemicu.NamaTampilan == Custom String("")))));
		Globale.PemainPemicu.NamaTampilan = Evaluate Once(Custom String("{0}", Globale.PemainPemicu));
		End;
		If(Or((Globale.PemainPemicu.NamaTampilan == Null), (Globale.PemainPemicu.NamaTampilan == Custom String(""))));
		Globale.PemainPemicu.SudahDiperiksa = False;
		Globale.PemainPemicu.SudahSiap = False;
		Globale.PemainPemicu.WaktuSiklusTim = (Total Time Elapsed + 0.250);
		If((Globale.PemainSiklusGlobal == Globale.PemainPemicu));
		Globale.PemainSiklusGlobal = Null;
		Globale.WaktuSiklusGlobal = (Total Time Elapsed + 0.250);
		End;
		Abort;
		End;
		Disable Game Mode HUD(Globale.PemainPemicu);
		Disable Game Mode In-World UI(Globale.PemainPemicu);
		Globale.PemainPemicu.IndeksGenre = -1;
		Globale.PemainPemicu.IndeksWarna = 0;
		Globale.PemainPemicu.WarnaNama = Globale.DaftarWarna[Globale.PemainPemicu.IndeksWarna];
		If((Globale.PemainPemicu.NamaTampilan == Custom String("งูแรร์")));
		Globale.PemainPemicu.MusikKhusus = Custom String("Draconian");
		Globale.PemainPemicu.IndeksWarna = 2;
		Globale.PemainPemicu.KursorWarna = 2;
		Globale.PemainPemicu.WarnaNama = Globale.DaftarWarna[2];
		Globale.PemainPemicu.WarnaMenu = Globale.DaftarWarnaRGB[2];
		Globale.PemainPemicu.IndeksIkon = 23;
		Globale.PemainPemicu.KursorIkon = 23;
		End;
		Globale.PemainPemicu.UrutanHUD = First Of(Globale.SlotHUDTersedia);
		Globale.WaktuHilangHUD[Globale.PemainPemicu.UrutanHUD] = 0;
		Globale.WaktuPukulanSuper[Globale.PemainPemicu.UrutanHUD] = 0;
		Globale.SlotHUDTerakhir = Max(Globale.SlotHUDTerakhir, Globale.PemainPemicu.UrutanHUD);
		Modify Global Variable(SlotHUDTersedia, Remove From Array By Index, 0);
		Globale.PemainManusia = Append To Array(Globale.PemainManusia, Globale.PemainPemicu);
		Disable Nameplates(Globale.PemainPemicu, Filtered Array(Globale.PemainManusia, Player Variable(Current Array Element, PelatNamaDinonaktifkan)));
		Globale.HudKiriPemain = Append To Array(Globale.HudKiriPemain, 0);
		Globale.HudMenuPemain = Append To Array(Globale.HudMenuPemain, 0);
		Globale.TeksDuniaPemain = Append To Array(Globale.TeksDuniaPemain, 0);
		Globale.SlotHUDPemain = Append To Array(Globale.SlotHUDPemain, Globale.PemainPemicu.UrutanHUD);
		Globale.PemainPemicu.Manusia = True;
		Globale.PemainPemicu.PahlawanTerakhir = Hero Of(Globale.PemainPemicu);
		Globale.PilihanPerluDihitung = True;
		Create HUD Text(Globale.PemainManusia, Null, Custom String("{0} {1} {2}", Globale.DaftarIkon[Player Variable(Evaluate Once(Globale.PemainPemicu), IndeksIkon)], Hero Icon String((Is Duplicating(Evaluate Once(Globale.PemainPemicu)) ? Hero Being Duplicated(Evaluate Once(Globale.PemainPemicu)) : Hero Of(Evaluate Once(Globale.PemainPemicu)))), Custom String("{0} - {1}", Evaluate Once(Globale.PemainPemicu.NamaTampilan), ((Player Variable(Evaluate Once(Globale.PemainPemicu), MusikKhusus) != Null) ? Player Variable(Evaluate Once(Globale.PemainPemicu), MusikKhusus) : ((Player Variable(Evaluate Once(Globale.PemainPemicu), IndeksGenre) >= 0) ? Globale.DaftarGenre[Player Variable(Evaluate Once(Globale.PemainPemicu), IndeksGenre)] : ((Player Variable(Local Player, IndeksBahasa) == 0) ? Custom String("no soundtrack yet") : ((Player Variable(Local Player, IndeksBahasa) == 1) ? Custom String("belum pilih musik") : Custom String("ยังไม่เลือกเพลง"))))))), (And((Globale.DiagnostikPerforma == True), And((Local Player == Host Player), (Player Variable(Evaluate Once(Globale.PemainPemicu), UrutanHUD) == Globale.SlotHUDTerakhir))) ? Custom String("{0}\n{1}", ((Player Variable(Local Player, IndeksBahasa) == 2) ? Custom String("\n \nโหลด {0}% | เฉลี่ย {1}% | สูงสุด {2}%", Server Load, Server Load Average, Server Load Peak) : ((Player Variable(Local Player, IndeksBahasa) == 1) ? Custom String("\n \nBEBAN {0}% | RATA {1}% | PUNCAK {2}%", Server Load, Server Load Average, Server Load Peak) : Custom String("\n \nLOAD {0}% | AVG {1}% | MAX {2}%", Server Load, Server Load Average, Server Load Peak))), Custom String("HUD {0} | IWT {1}", (((9 + Count Of(Filtered Array(Globale.HudKiriPemain, (Current Array Element != 0)))) + Count Of(Filtered Array(Globale.HudMenuPemain, (Current Array Element != 0)))) + Count Of(Filtered Array(Globale.HudEfekSementara, (Current Array Element != 0)))), ((Count Of(Filtered Array(Globale.TeksDuniaPemain, (Current Array Element != 0))) + Count Of(Filtered Array(Globale.TeksTeleportasiSementara, (Current Array Element != 0)))) + Count Of(Filtered Array(Globale.TeksVisiSementara, (Current Array Element != 0)))))) : Custom String("")), Left, (1 + Player Variable(Evaluate Once(Globale.PemainPemicu), UrutanHUD)), Color(Bianco), Player Variable(Evaluate Once(Globale.PemainPemicu), WarnaNama), Color(Bianco), Visible To String and Color, Visible Never);
		Globale.PemainPemicu.HudKiri = Last Text ID;
		If(And((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) >= 0), (Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) < Count Of(Globale.HudKiriPemain))));
		Globale.HudKiriPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)] = Globale.PemainPemicu.HudKiri;
		End;
		Globale.PemainPemicu.HudPemainDibuat = True;
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Welcome to Cozywatch! Pick a vibe & color. Stay weird.") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Selamat datang di Cozywatch! Pilih musik & warna. Santai!") : Custom String("ยินดีต้อนรับสู่ Cozywatch เลือกเพลง เลือกสี แล้วกวนแบบพอดี ๆ"))));
		End;
	}
}

regola("03c - Bot: Kunci saat hidup kembali atau pahlawan berganti")
{
	evento
	{
		Subroutine;
		Pengatur03c;
	}

	azioni
	{
		Abort If(Not(And(Globale.Siap, And(Or(Is Dummy Bot(Globale.PemainPemicu), Globale.PemainPemicu.BotOtomatis), And(Has Spawned(Globale.PemainPemicu), And(Is Alive(Globale.PemainPemicu), Or(Not(Globale.PemainPemicu.KunciBotAktif), (Hero Of(Globale.PemainPemicu) != Globale.PemainPemicu.PahlawanTerakhir))))))));
		Call Subroutine(KunciBot);
		If(Is Dummy Bot(Globale.PemainPemicu));
		Globale.PemainPemicu.WaktuTeleportasiBotBuatan = (Total Time Elapsed + 1);
		Globale.PemainPemicu.KursorTeleportasiBotBuatan = 0;
		Set Respawn Max Time(Globale.PemainPemicu, 3);
		End;
	}
}

regola("03d - Subrutin: Rawat slot bot buatan kedua tim 1 Hz")
{
	evento
	{
		Subroutine;
		RawatBotBuatan;
	}

	azioni
	{
		Abort If(Not(Globale.Siap));
		Abort If(Not(Is Game In Progress));
		Abort If((Globale.PemainSiklusGlobal != Null));
		If((Number Of Players(Team 1) >= Number Of Slots(Team 1)));
		If((Count Of(Filtered Array(All Players(Team 1), Is Dummy Bot(Current Array Element))) > 0));
		Globale.TimBotBuatanAktif = Team 1;
		Globale.WaktuCobaBotBuatanTim1 = (Total Time Elapsed + 1);
		Call Subroutine(LepasBotBuatanTim);
		End;
		Else;
		If(And((Current Game Mode == Game Mode(Schermaglia)), And((Number Of Players(Team 1) < (Number Of Slots(Team 1) - 1)), And((Count Of(Spawn Points(Team 1)) > 0), And((Count Of(Filtered Array(All Players(Team 1), Is Dummy Bot(Current Array Element))) == 0), (Total Time Elapsed >= Globale.WaktuCobaBotBuatanTim1))))));
		Globale.TimBotBuatanAktif = Team 1;
		Globale.WaktuCobaBotBuatanTim1 = (Total Time Elapsed + 1);
		Call Subroutine(BuatBotBuatanTim);
		End;
		End;
		If((Number Of Players(Team 2) >= Number Of Slots(Team 2)));
		If((Count Of(Filtered Array(All Players(Team 2), Is Dummy Bot(Current Array Element))) > 0));
		Globale.TimBotBuatanAktif = Team 2;
		Globale.WaktuCobaBotBuatanTim2 = (Total Time Elapsed + 1);
		Call Subroutine(LepasBotBuatanTim);
		End;
		Else;
		If(And((Current Game Mode == Game Mode(Schermaglia)), And((Number Of Players(Team 2) < (Number Of Slots(Team 2) - 1)), And((Count Of(Spawn Points(Team 2)) > 0), And((Count Of(Filtered Array(All Players(Team 2), Is Dummy Bot(Current Array Element))) == 0), (Total Time Elapsed >= Globale.WaktuCobaBotBuatanTim2))))));
		Globale.TimBotBuatanAktif = Team 2;
		Globale.WaktuCobaBotBuatanTim2 = (Total Time Elapsed + 1);
		Call Subroutine(BuatBotBuatanTim);
		End;
		End;
	}
}

regola("03f - Bot: Teleportasi dari ruang muncul ke objektif")
{
	evento
	{
		Subroutine;
		Pengatur03f;
	}

	azioni
	{
		Abort If(Not(And(Globale.Siap, And(Is Dummy Bot(Globale.PemainPemicu), And((Current Game Mode == Game Mode(Schermaglia)), And(Has Spawned(Globale.PemainPemicu), And(Is Alive(Globale.PemainPemicu), And(Is In Spawn Room(Globale.PemainPemicu), And((Count Of(Spawn Points(Team Of(Globale.PemainPemicu))) > 0), Or((Globale.PemainPemicu.WaktuTeleportasiBotBuatan == 0), (Total Time Elapsed >= Globale.PemainPemicu.WaktuTeleportasiBotBuatan)))))))))));
		If((Globale.PemainPemicu.WaktuTeleportasiBotBuatan == 0));
		Globale.PemainPemicu.WaktuTeleportasiBotBuatan = (Total Time Elapsed + 1);
		Globale.PemainPemicu.KursorTeleportasiBotBuatan = 0;
		Abort;
		End;
		Globale.PemainPemicu.WaktuTeleportasiBotBuatan = (Total Time Elapsed + 1);
		Globale.PemainPemicu.PosisiMati = Objective Position(Objective Index);
		Globale.PemainPemicu.PosisiBangkitAman = Vector(0, 0, 0);
		If((Distance Between(Globale.PemainPemicu.PosisiMati, Vector(0, 0, 0)) > 0.100));
		Globale.PemainPemicu.PosisiBangkitAman = Nearest Walkable Position((Globale.PemainPemicu.PosisiMati + (Direction From Angles((Horizontal Angle From Direction(Direction Towards(Globale.PemainPemicu.PosisiMati, Position Of(First Of(Spawn Points(Team Of(Globale.PemainPemicu)))))) + ((Globale.PemainPemicu.KursorTeleportasiBotBuatan % 8) * 45)), 0) * ((Globale.PemainPemicu.KursorTeleportasiBotBuatan < 8) ? 8 : 12))));
		Globale.PemainPemicu.PosisiTujuanTeleportasi = Globale.PemainPemicu.PosisiBangkitAman;
		Globale.PemainPemicu.KursorTeleportasiBotBuatan = ((Globale.PemainPemicu.KursorTeleportasiBotBuatan + 1) % 16);
		Call Subroutine(CariPosisiTeleportasiAman);
		If((Distance Between(Globale.PemainPemicu.PosisiBangkitAman, Globale.PemainPemicu.PosisiMati) >= 6));
		If((Distance Between(Globale.PemainPemicu.PosisiBangkitAman, Globale.PemainPemicu.PosisiMati) <= 16));
		If((Distance Between(Ray Cast Hit Position((Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 5, 0)), (Globale.PemainPemicu.PosisiBangkitAman - Vector(0, 20, 0)), Empty Array, Empty Array, False), Globale.PemainPemicu.PosisiBangkitAman) <= 6));
		If((Distance Between(Globale.PemainPemicu.PosisiBangkitAman, Vector(0, 0, 0)) > 0.100));
		Teleport(Globale.PemainPemicu, Globale.PemainPemicu.PosisiBangkitAman);
		End;
		End;
		End;
		End;
		End;
	}
}

regola("03g - Bot: Hadap dan dekati manusia musuh hidup terdekat")
{
	evento
	{
		Subroutine;
		Pengatur03g;
	}

	azioni
	{
		If(Not(And(Globale.Siap, And(Is Dummy Bot(Globale.PemainPemicu), And(Has Spawned(Globale.PemainPemicu), And(Is Alive(Globale.PemainPemicu), And((Globale.PemainPemicu.TargetIkutiBotBuatan != Null), And(Entity Exists(Globale.PemainPemicu.TargetIkutiBotBuatan), And(Player Variable(Globale.PemainPemicu.TargetIkutiBotBuatan, Manusia), And(Player Variable(Globale.PemainPemicu.TargetIkutiBotBuatan, IzinkanBotBuatanMengikuti), And(Has Spawned(Globale.PemainPemicu.TargetIkutiBotBuatan), And(Is Alive(Globale.PemainPemicu.TargetIkutiBotBuatan), (Team Of(Globale.PemainPemicu.TargetIkutiBotBuatan) == Opposite Team Of(Team Of(Globale.PemainPemicu)))))))))))))));
		Globale.PemainPemicu.StatusPengatur[5] = 0;
		Abort;
		End;
		Abort If((Globale.PemainPemicu.StatusPengatur[5] == 1));
		Globale.PemainPemicu.StatusPengatur[5] = 1;
		Start Facing(Evaluate Once(Globale.PemainPemicu), Direction Towards(Eye Position(Evaluate Once(Globale.PemainPemicu)), Eye Position(Player Variable(Evaluate Once(Globale.PemainPemicu), TargetIkutiBotBuatan))), 1000, To World, Direction and Turn Rate);
		Start Throttle In Direction(Evaluate Once(Globale.PemainPemicu), Forward, (Or(Is In Spawn Room(Evaluate Once(Globale.PemainPemicu)), (Distance Between(Evaluate Once(Globale.PemainPemicu), Player Variable(Evaluate Once(Globale.PemainPemicu), TargetIkutiBotBuatan)) <= 4)) ? 0 : 1), To Player, Replace Existing Throttle, Direction and Magnitude);
	}
}

regola("03h - Bot: Hentikan gerak saat tidak ada manusia musuh hidup")
{
	evento
	{
		Subroutine;
		Pengatur03h;
	}

	azioni
	{
		If(Not(And(Globale.Siap, And(Is Dummy Bot(Globale.PemainPemicu), Or(Or(Or((Globale.PemainPemicu.TargetIkutiBotBuatan == Null), Not(Entity Exists(Globale.PemainPemicu.TargetIkutiBotBuatan))), Or(Not(Player Variable(Globale.PemainPemicu.TargetIkutiBotBuatan, Manusia)), Not(Player Variable(Globale.PemainPemicu.TargetIkutiBotBuatan, IzinkanBotBuatanMengikuti)))), Or(Or(Not(Has Spawned(Globale.PemainPemicu.TargetIkutiBotBuatan)), Not(Is Alive(Globale.PemainPemicu.TargetIkutiBotBuatan))), (Team Of(Globale.PemainPemicu.TargetIkutiBotBuatan) != Opposite Team Of(Team Of(Globale.PemainPemicu)))))))));
		Globale.PemainPemicu.StatusPengatur[6] = 0;
		Abort;
		End;
		Abort If((Globale.PemainPemicu.StatusPengatur[6] == 1));
		Globale.PemainPemicu.StatusPengatur[6] = 1;
		Stop Facing(Globale.PemainPemicu);
		Stop Throttle In Direction(Globale.PemainPemicu);
	}
}

regola("03i - Bot: Hentikan gerak saat bot mati")
{
	evento
	{
		Player Died;
		Tutti;
		Tutti;
		}

	condizioni
	{
		Is Dummy Bot(Event Player) == True;
		Is Alive(Event Player) == False;
		}

	azioni
	{
		If((Globale.JumlahPeristiwa < 256));
		Globale.AntreanPeristiwa[Globale.EkorPeristiwa] = Array(0, Event Player, Null, Null, Null, Null, Null, Total Time Elapsed, Null, Null, Null, Null, Null, Null, Null, Null, Null, Null, Hero Of(Event Player), Team Of(Event Player), Event Player.StatusPengatur[36], (Event Player.Manusia ? Event Player.NamaTampilan : Custom String("{0}", Event Player)));
		Globale.EkorPeristiwa = ((Globale.EkorPeristiwa + 1) % 256);
		Globale.JumlahPeristiwa += 1;
		Else;
		Globale.PeristiwaTerlewat += 1;
		End;
	}
}

regola("03i - Bot: Hentikan gerak saat bot mati global")
{
	evento
	{
		Subroutine;
		Peristiwa03i;
	}

	azioni
	{
		Abort If(Not(Entity Exists(Globale.PemainPemicu)));
		Abort If((Globale.PeristiwaAktif[20] != Globale.PemainPemicu.StatusPengatur[36]));
		Abort If((Globale.PeristiwaAktif[21] != (Globale.PemainPemicu.Manusia ? Globale.PemainPemicu.NamaTampilan : Custom String("{0}", Globale.PemainPemicu))));
		Abort If(Is Alive(Globale.PemainPemicu));
		Stop Facing(Globale.PemainPemicu);
		Stop Throttle In Direction(Globale.PemainPemicu);
		Globale.PemainPemicu.WaktuTeleportasiBotBuatan = 0;
		Globale.PemainPemicu.KursorTeleportasiBotBuatan = 0;
		Globale.PemainPemicu.TargetIkutiBotBuatan = Null;
	}
}

regola("04 - Pemain Keluar: Bersihkan hanya saat benar-benar keluar")
{
	evento
	{
		Player Left Match;
		Tutti;
		Tutti;
		}

	condizioni
	{
		Is Dummy Bot(Event Player) == False;
		Or(Event Player.BotOtomatis == True, Or(Event Player.Manusia == True, Array Contains(Globale.PemainManusia, Event Player))) == True;
		}

	azioni
	{
		If((Globale.JumlahPeristiwa < 256));
		Globale.AntreanPeristiwa[Globale.EkorPeristiwa] = Array(1, Event Player, Null, Null, Null, Null, Null, Total Time Elapsed, Null, Null, Null, Null, Event Player.BotOtomatis);
		Globale.EkorPeristiwa = ((Globale.EkorPeristiwa + 1) % 256);
		Globale.JumlahPeristiwa += 1;
		Else;
		Globale.PeristiwaTerlewat += 1;
		End;
	}
}

regola("04 - Pemain Keluar: Bersihkan hanya saat benar-benar keluar global")
{
	evento
	{
		Subroutine;
		Peristiwa04;
	}

	azioni
	{
		If(Globale.PeristiwaAktif[12]);
		Globale.PemainTeksPembersihan = Globale.PemainPemicu;
		Call Subroutine(BersihkanTeksYatim);
		Else;
		Globale.KursorKeluarTertunda = Index Of Array Value(Globale.KeluarTertunda, Null);
		If((Globale.KursorKeluarTertunda < 0));
		Globale.KursorKeluarTertunda = Count Of(Globale.KeluarTertunda);
		End;
		If((Globale.KursorKeluarTertunda < 24));
		Globale.KeluarTertunda[Globale.KursorKeluarTertunda] = Globale.PeristiwaAktif;
		Else;
		Globale.PeristiwaTerlewat += 1;
		End;
		End;
	}
}

regola("04g - Utama global: Penjadwal pusat 20 Hz")
{
	evento
	{
		Ongoing - Global;
	}

	condizioni
	{
		Globale.Siap == True;
	}

	azioni
	{
		Globale.SalinanDaftarPemain = All Players(All Teams);
		Call Subroutine(ProsesAntreanGlobal);
		Call Subroutine(ProsesKeluarGlobal);
		Globale.LangkahPenjadwal = ((Globale.LangkahPenjadwal + 1) % 200);
		If(((Globale.LangkahPenjadwal % 2) == 0));
		Globale.RGB = Custom Color((80 + (((Globale.RGBFase < 255) ? 255 : ((Globale.RGBFase < 510) ? (510 - Globale.RGBFase) : ((Globale.RGBFase < 1020) ? 0 : ((Globale.RGBFase < 1275) ? (Globale.RGBFase - 1020) : 255)))) * 0.686)), (80 + (((Globale.RGBFase < 255) ? Globale.RGBFase : ((Globale.RGBFase < 765) ? 255 : ((Globale.RGBFase < 1020) ? (1020 - Globale.RGBFase) : 0))) * 0.686)), (80 + (((Globale.RGBFase < 510) ? 0 : ((Globale.RGBFase < 765) ? (Globale.RGBFase - 510) : ((Globale.RGBFase < 1275) ? 255 : (1530 - Globale.RGBFase)))) * 0.686)), 255);
		Globale.RGBFase = ((Globale.RGBFase + 3) % 1530);
		End;
		If(And(((Globale.LangkahPenjadwal % 20) == 0), Not(Globale.MulaiUlangSudahDiminta)));
		Globale.SisaWaktuServer = Max(0, Round To Integer((Globale.WaktuAkhirServer - Total Time Elapsed), Up));
		Globale.TeksWaktuServer = (((Globale.SisaWaktuServer % 60) < 10) ? Custom String("{0}:0{1}", Round To Integer((Globale.SisaWaktuServer / 60), Down), (Globale.SisaWaktuServer % 60)) : Custom String("{0}:{1}", Round To Integer((Globale.SisaWaktuServer / 60), Down), (Globale.SisaWaktuServer % 60)));
		If(And(Is Game In Progress, (Globale.SisaWaktuServer > 0)));
		Disable Built-In Game Mode Completion;
		Set Match Time(Max(1, Globale.SisaWaktuServer));
		End;
		End;
		If(And((Globale.PemainSiklusGlobal != Null), Or(Not(Entity Exists(Globale.PemainSiklusGlobal)), Or(Not(Has Spawned(Globale.PemainSiklusGlobal)), Not(Array Contains(Globale.SalinanDaftarPemain, Globale.PemainSiklusGlobal))))));
		Globale.PemainSiklusGlobal = Null;
		Globale.PemilikFaseSiklus = Null;
		Globale.WaktuSiklusGlobal = (Total Time Elapsed + 0.250);
		End;
		If(Is True For Any(Globale.SalinanDaftarPemain, Player Variable(Current Array Element, PrivasiNasibAktif)));
		Globale.PenontonVisiNasib = Filtered Array(Globale.SalinanDaftarPemain, And(Entity Exists(Current Array Element), And(Player Variable(Current Array Element, Manusia), Player Variable(Current Array Element, PrivasiNasibAktif))));
		Else;
		If((Count Of(Globale.PenontonVisiNasib) > 0));
		Globale.PenontonVisiNasib = Empty Array;
		End;
		End;
		For Global Variable(IndeksPemainGlobal, 0, Count Of(Globale.SalinanDaftarPemain), 1);
		Globale.PemainAktif = Globale.SalinanDaftarPemain[Globale.IndeksPemainGlobal];
		Globale.PemainPemicu = Globale.PemainAktif;
		Call Subroutine(ProsesPengaturGlobal);
		If(And(Not(Is Dummy Bot(Globale.PemainAktif)), Not(Globale.PemainAktif.BotOtomatis)));
		Call Subroutine(ProsesCepatPemain);
		If(Array Contains(Globale.PemainPukulanSuper, Globale.PemainAktif));
		Call Subroutine(ProsesPukulanSuper);
		End;
		If(Globale.PemainAktif.ModeLompatGanda);
		Call Subroutine(ProsesLompatGanda);
		End;
		If(Or(Globale.PemainAktif.KartuNasibAktif, Or((Globale.PemainAktif.PutaranKartuNasib > 0), Or((Globale.PemainAktif.EfekNasib != 0), (Globale.PemainAktif.WaktuIkonNasibBerakhir > 0)))));
		Call Subroutine(ProsesNasibPemain);
		End;
		If(And(Globale.PemainAktif.Manusia, Globale.PemainAktif.ModeTerbangAktif));
		Call Subroutine(ProsesTerbangPemain);
		End;
		If(((Globale.LangkahPenjadwal % 2) == ((Globale.PemainAktif.Manusia ? Globale.PemainAktif.UrutanHUD : Slot Of(Globale.PemainAktif)) % 2)));
		Call Subroutine(ProsesSiklusPemain);
		End;
		If(((Globale.LangkahPenjadwal % 20) == ((Globale.PemainAktif.Manusia ? Globale.PemainAktif.UrutanHUD : Slot Of(Globale.PemainAktif)) % 20)));
		If(Not(Globale.PemainAktif.PilihanPahlawanSelesai));
		If(Has Spawned(Globale.PemainAktif));
		Globale.PemainAktif.PilihanPahlawanSelesai = True;
		Globale.PemainAktif.WaktuPilihPahlawan = 0;
		Else;
		If(Or((Team Of(Globale.PemainAktif) == Team 1), (Team Of(Globale.PemainAktif) == Team 2)));
		If(And((Globale.PemainAktif.WaktuPilihPahlawan > 0), (Total Time Elapsed >= Globale.PemainAktif.WaktuPilihPahlawan)));
		Globale.PemainAktif.PilihanPahlawanSelesai = True;
		Globale.PemainAktif.WaktuPilihPahlawan = 0;
		Start Forcing Player To Be Hero(Globale.PemainAktif, Hero(Shion));
		Stop Forcing Player To Be Hero(Globale.PemainAktif);
		End;
		Else;
		Globale.PemainAktif.WaktuPilihPahlawan = 0;
		End;
		End;
		End;
		If(And(Globale.PemainAktif.Manusia, Or(Globale.PemainAktif.IzinkanBotBuatanMengikuti, And(Globale.PemainAktif.MenuTerbuka, Or((Globale.PemainAktif.HalamanMenu == 1), (Globale.PemainAktif.HalamanMenu == 4))))));
		Call Subroutine(ProsesSimpananPemain);
		End;
		End;
		Else;
		If(((Globale.LangkahPenjadwal % 2) == (Slot Of(Globale.PemainAktif) % 2)));
		Call Subroutine(ProsesBotPemain);
		End;
		End;
		End;
		Globale.PemainPemicu = Null;
		Globale.PemainAktif = Null;
		Globale.SalinanDaftarPemain = Empty Array;
		If(((Globale.LangkahPenjadwal % 20) == 0));
		Call Subroutine(RawatBotBuatan);
		Call Subroutine(PerbaruiPilarSosial);
		Globale.PemainTeksPembersihan = Null;
		Call Subroutine(BersihkanTeksYatim);
		End;
		Call Subroutine(ProsesIkonTerlihat);
		If(Globale.PilihanPerluDihitung);
		Globale.PilihanPerluDihitung = False;
		Call Subroutine(HitungPilihan);
		End;
		Wait(0.050, Ignora condizione);
		Loop If Condition Is True;
	}
}

regola("05 - Menu: Tahan serangan jarak dekat 0,5 detik untuk buka atau tutup")
{
	evento
	{
		Subroutine;
		Pengatur05;
	}

	azioni
	{
		If(Not(And(Is Alive(Globale.PemainPemicu), And(Not(Globale.PemainPemicu.SeranganDekatDipakai), And(Not(Globale.PemainPemicu.TeleportasiJongkokAktif), And(Not(Globale.PemainPemicu.KartuNasibAktif), Is Button Held(Globale.PemainPemicu, Button(Melee))))))));
		Globale.PemainPemicu.WaktuPengatur[7] = 0;
		Abort;
		End;
		If((Globale.PemainPemicu.WaktuPengatur[7] == 0));
		Globale.PemainPemicu.WaktuPengatur[7] = (Total Time Elapsed + 0.500);
		Abort;
		End;
		Abort If((Total Time Elapsed < Globale.PemainPemicu.WaktuPengatur[7]));
		Globale.PemainPemicu.WaktuPengatur[7] = 0;
		Globale.PemainPemicu.SeranganDekatDipakai = True;
		If(Globale.PemainPemicu.MenuTerbuka);
		Call Subroutine(TutupMenu);
		Else;
		Globale.PemainPemicu.MenuTerbuka = True;
		Globale.PemainPemicu.HalamanMenu = -1;
		Call Subroutine(GambarMenu);
		End;
	}
}

regola("05b - Menu: Lepaskan serangan jarak dekat sebelum pakai lagi")
{
	evento
	{
		Subroutine;
		Pengatur05b;
	}

	azioni
	{
		Abort If(Not(And(Globale.PemainPemicu.SeranganDekatDipakai, Not(Is Button Held(Globale.PemainPemicu, Button(Melee))))));
		If(Not(Globale.PemainPemicu.MenuTerbuka));
		Allow Button(Globale.PemainPemicu, Button(Melee));
		End;
		Globale.PemainPemicu.SeranganDekatDipakai = False;
	}
}

regola("05c - Menu: Pengatur masukan dengan prioritas tetap")
{
	evento
	{
		Subroutine;
		Pengatur05c;
	}

	azioni
	{
		Abort If(Not(And(Is Alive(Globale.PemainPemicu), And(Globale.PemainPemicu.MenuTerbuka, And(Is Button Held(Globale.PemainPemicu, Button(Crouch)), And((Globale.PemainPemicu.PerintahMenu == 0), And(Not(Globale.PemainPemicu.InteraksiKameraDipakai), And(Not(Globale.PemainPemicu.KartuNasibAktif), Or(Or(Is Button Held(Globale.PemainPemicu, Button(Interact)), And(Is Button Held(Globale.PemainPemicu, Button(Reload)), (Globale.PemainPemicu.HalamanMenu != -1))), Or(Or(Is Button Held(Globale.PemainPemicu, Button(Primary Fire)), Is Button Held(Globale.PemainPemicu, Button(Secondary Fire))), And((Globale.PemainPemicu.HalamanMenu == 2), Or(Is Button Held(Globale.PemainPemicu, Button(Ability 1)), Is Button Held(Globale.PemainPemicu, Button(Ability 2))))))))))))));
		If(Is Button Held(Globale.PemainPemicu, Button(Interact)));
		Globale.PemainPemicu.InteraksiKameraDipakai = True;
		Globale.PemainPemicu.PerintahMenu = 1;
		Else If(And(Is Button Held(Globale.PemainPemicu, Button(Reload)), (Globale.PemainPemicu.HalamanMenu != -1)));
		Globale.PemainPemicu.PerintahMenu = 2;
		Else If(Is Button Held(Globale.PemainPemicu, Button(Primary Fire)));
		Globale.PemainPemicu.PerintahMenu = 3;
		Else If(Is Button Held(Globale.PemainPemicu, Button(Secondary Fire)));
		Globale.PemainPemicu.PerintahMenu = 4;
		Else If(And(Is Button Held(Globale.PemainPemicu, Button(Ability 1)), (Globale.PemainPemicu.HalamanMenu == 2)));
		Globale.PemainPemicu.PerintahMenu = 5;
		Else If(And(Is Button Held(Globale.PemainPemicu, Button(Ability 2)), (Globale.PemainPemicu.HalamanMenu == 2)));
		Globale.PemainPemicu.PerintahMenu = 6;
		End;
	}
}

regola("05d - Menu: Lepaskan pengatur setelah semua masukan dilepas")
{
	evento
	{
		Subroutine;
		Pengatur05d;
	}

	azioni
	{
		Abort If(Not(And((Globale.PemainPemicu.PerintahMenu != 0), And(And(Not(Is Button Held(Globale.PemainPemicu, Button(Interact))), Not(Is Button Held(Globale.PemainPemicu, Button(Reload)))), And(And(Not(Is Button Held(Globale.PemainPemicu, Button(Primary Fire))), Not(Is Button Held(Globale.PemainPemicu, Button(Secondary Fire)))), And(Not(Is Button Held(Globale.PemainPemicu, Button(Ability 1))), Not(Is Button Held(Globale.PemainPemicu, Button(Ability 2)))))))));
		Globale.PemainPemicu.PerintahMenu = 0;
	}
}

regola("05e - Menu: Jongkok mengunci masukan pahlawan hanya saat navigasi")
{
	evento
	{
		Subroutine;
		Pengatur05e;
	}

	azioni
	{
		Abort If(Not(And(Globale.PemainPemicu.MenuTerbuka, And(Not(Globale.PemainPemicu.MasukanMenuDikunci), Is Button Held(Globale.PemainPemicu, Button(Crouch))))));
		Globale.PemainPemicu.MasukanMenuDikunci = True;
		Disallow Button(Globale.PemainPemicu, Button(Primary Fire));
		Disallow Button(Globale.PemainPemicu, Button(Secondary Fire));
		Disallow Button(Globale.PemainPemicu, Button(Interact));
		Disallow Button(Globale.PemainPemicu, Button(Reload));
		Disallow Button(Globale.PemainPemicu, Button(Ability 1));
		Disallow Button(Globale.PemainPemicu, Button(Ability 2));
		Disallow Button(Globale.PemainPemicu, Button(Ultimate));
	}
}

regola("05f - Menu: Lepaskan Jongkok dan segera pulihkan masukan pahlawan")
{
	evento
	{
		Subroutine;
		Pengatur05f;
	}

	azioni
	{
		Abort If(Not(And(Not(Globale.PemainPemicu.PindahTimDiproses), And(Not(Globale.PemainPemicu.SiklusPemainAktif), And(Globale.PemainPemicu.MasukanMenuDikunci, Or(Not(Globale.PemainPemicu.MenuTerbuka), Not(Is Button Held(Globale.PemainPemicu, Button(Crouch)))))))));
		Allow Button(Globale.PemainPemicu, Button(Primary Fire));
		Allow Button(Globale.PemainPemicu, Button(Secondary Fire));
		Allow Button(Globale.PemainPemicu, Button(Interact));
		Allow Button(Globale.PemainPemicu, Button(Reload));
		Allow Button(Globale.PemainPemicu, Button(Ability 1));
		Allow Button(Globale.PemainPemicu, Button(Ability 2));
		Allow Button(Globale.PemainPemicu, Button(Ultimate));
		Globale.PemainPemicu.MasukanMenuDikunci = False;
		Globale.PemainPemicu.PerintahMenu = 0;
	}
}

regola("06 - Menu: Navigasi berikutnya dan sebelumnya")
{
	evento
	{
		Subroutine;
		Pengatur06;
	}

	azioni
	{
		If(Not(And(Is Alive(Globale.PemainPemicu), And(Globale.PemainPemicu.MenuTerbuka, Or((Globale.PemainPemicu.PerintahMenu == 3), (Globale.PemainPemicu.PerintahMenu == 4))))));
		Globale.PemainPemicu.StatusPengatur[13] = 0;
		Abort;
		End;
		Abort If((Globale.PemainPemicu.StatusPengatur[13] == 1));
		Globale.PemainPemicu.StatusPengatur[13] = 1;
		If((Globale.PemainPemicu.HalamanMenu == -1));
		Globale.PemainPemicu.KursorUtama = ((Globale.PemainPemicu.KursorUtama + ((Globale.PemainPemicu.PerintahMenu == 3) ? 1 : 15)) % 16);
		Else If((Globale.PemainPemicu.HalamanMenu == 0));
		Globale.PemainPemicu.KursorWarna = ((Globale.PemainPemicu.KursorWarna + ((Globale.PemainPemicu.PerintahMenu == 3) ? 1 : (Count Of(Globale.DaftarWarna) - 1))) % Count Of(Globale.DaftarWarna));
		Else If((Globale.PemainPemicu.HalamanMenu == 1));
		Call Subroutine(SegarkanTargetKamera);
		Globale.PemainPemicu.KursorKamera = ((Globale.PemainPemicu.KursorKamera + ((Globale.PemainPemicu.PerintahMenu == 3) ? 1 : (Count Of(Globale.PemainPemicu.DaftarTargetKamera) + 1))) % (Count Of(Globale.PemainPemicu.DaftarTargetKamera) + 2));
		Else If(And((Globale.PemainPemicu.HalamanMenu == 2), (Globale.PemainPemicu.MusikKhusus == Null)));
		Globale.PemainPemicu.KursorGenre = ((Globale.PemainPemicu.KursorGenre + ((Globale.PemainPemicu.PerintahMenu == 3) ? 1 : (Count Of(Globale.DaftarGenre) - 1))) % Count Of(Globale.DaftarGenre));
		Else If((Globale.PemainPemicu.HalamanMenu == 3));
		Globale.PemainPemicu.KursorBahasa = ((Globale.PemainPemicu.KursorBahasa + ((Globale.PemainPemicu.PerintahMenu == 3) ? 1 : 2)) % 3);
		Else If((Globale.PemainPemicu.HalamanMenu == 4));
		Call Subroutine(SegarkanTargetBalasDendam);
		If((Count Of(Globale.PemainPemicu.DaftarTargetBalasDendam) > 0));
		Globale.PemainPemicu.KursorBalasDendam = ((Globale.PemainPemicu.KursorBalasDendam + ((Globale.PemainPemicu.PerintahMenu == 3) ? 1 : (Count Of(Globale.PemainPemicu.DaftarTargetBalasDendam) - 1))) % Count Of(Globale.PemainPemicu.DaftarTargetBalasDendam));
		End;
		Else If((Globale.PemainPemicu.HalamanMenu == 5));
		Globale.PemainPemicu.KursorKebal = ((Globale.PemainPemicu.KursorKebal + ((Globale.PemainPemicu.PerintahMenu == 3) ? 1 : 2)) % 3);
		Else If((Globale.PemainPemicu.HalamanMenu == 6));
		Globale.PemainPemicu.KursorSuara = ((Globale.PemainPemicu.KursorSuara + ((Globale.PemainPemicu.PerintahMenu == 3) ? 1 : 4)) % 5);
		Else If((Globale.PemainPemicu.HalamanMenu == 7));
		Globale.PemainPemicu.KursorIkon = ((Globale.PemainPemicu.KursorIkon + ((Globale.PemainPemicu.PerintahMenu == 3) ? 1 : (Count Of(Globale.DaftarIkon) - 1))) % Count Of(Globale.DaftarIkon));
		Else If((Globale.PemainPemicu.HalamanMenu == 11));
		If((Count Of(Globale.PemainManusia) > 0));
		Globale.PemainPemicu.KursorPilihan = ((Globale.PemainPemicu.KursorPilihan + ((Globale.PemainPemicu.PerintahMenu == 3) ? 1 : (Count Of(Globale.PemainManusia) - 1))) % Count Of(Globale.PemainManusia));
		End;
		Else If((Globale.PemainPemicu.HalamanMenu == 13));
		Globale.PemainPemicu.KursorHantuTerbang = ((Globale.PemainPemicu.KursorHantuTerbang + 1) % 2);
		Else If((Globale.PemainPemicu.HalamanMenu == 14));
		Globale.PemainPemicu.KursorLompatGanda = ((Globale.PemainPemicu.KursorLompatGanda + ((Globale.PemainPemicu.PerintahMenu == 3) ? 1 : 10)) % 11);
		End;
		Call Subroutine(TransisiWarnaMenu);
	}
}

regola("08 - Menu musik: Lompat maju atau mundur sepuluh genre")
{
	evento
	{
		Subroutine;
		Pengatur08;
	}

	azioni
	{
		If(Not(And(Is Alive(Globale.PemainPemicu), And(Globale.PemainPemicu.MenuTerbuka, And((Globale.PemainPemicu.HalamanMenu == 2), And((Globale.PemainPemicu.MusikKhusus == Null), Or((Globale.PemainPemicu.PerintahMenu == 5), (Globale.PemainPemicu.PerintahMenu == 6))))))));
		Globale.PemainPemicu.StatusPengatur[14] = 0;
		Abort;
		End;
		Abort If((Globale.PemainPemicu.StatusPengatur[14] == 1));
		Globale.PemainPemicu.StatusPengatur[14] = 1;
		Globale.PemainPemicu.KursorGenre = ((Globale.PemainPemicu.KursorGenre + ((Globale.PemainPemicu.PerintahMenu == 5) ? 10 : (Count Of(Globale.DaftarGenre) - 10))) % Count Of(Globale.DaftarGenre));
	}
}

regola("10 - Menu: Terapkan halaman aktif")
{
	evento
	{
		Subroutine;
		Pengatur10;
	}

	azioni
	{
		If(Not(And(Is Alive(Globale.PemainPemicu), And(Globale.PemainPemicu.MenuTerbuka, (Globale.PemainPemicu.PerintahMenu == 1)))));
		Globale.PemainPemicu.StatusPengatur[15] = 0;
		Abort;
		End;
		Abort If((Globale.PemainPemicu.StatusPengatur[15] == 1));
		Globale.PemainPemicu.StatusPengatur[15] = 1;
		If((Globale.PemainPemicu.HalamanMenu == -1));
		If((Globale.PemainPemicu.KursorUtama == 8));
		Call Subroutine(TerapkanTeleportasiJongkok);
		Else If((Globale.PemainPemicu.KursorUtama == 9));
		Call Subroutine(TerapkanHalamanPrivasiInspeksi);
		Else If((Globale.PemainPemicu.KursorUtama == 12));
		Call Subroutine(TerapkanHalamanIkutiBotBuatan);
		Else If((Globale.PemainPemicu.KursorUtama == 15));
		Call Subroutine(TerapkanHalamanPukulanSuper);
		Else;
		Globale.PemainPemicu.HalamanMenu = Globale.PemainPemicu.KursorUtama;
		If((Globale.PemainPemicu.HalamanMenu == 1));
		Call Subroutine(SegarkanTargetKamera);
		Else If((Globale.PemainPemicu.HalamanMenu == 4));
		Call Subroutine(SegarkanTargetBalasDendam);
		Else If((Globale.PemainPemicu.HalamanMenu == 5));
		Globale.PemainPemicu.KursorKebal = Globale.PemainPemicu.ModeKebal;
		Else If((Globale.PemainPemicu.HalamanMenu == 11));
		Globale.PemainPemicu.KursorPilihan = (And((Globale.PemainPemicu.PemainDipilih != Null), Array Contains(Globale.PemainManusia, Globale.PemainPemicu.PemainDipilih)) ? Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu.PemainDipilih) : Min(Globale.PemainPemicu.KursorPilihan, Max(0, (Count Of(Globale.PemainManusia) - 1))));
		Else If((Globale.PemainPemicu.HalamanMenu == 13));
		Globale.PemainPemicu.KursorHantuTerbang %= 2;
		Else If((Globale.PemainPemicu.HalamanMenu == 14));
		Globale.PemainPemicu.KursorLompatGanda = (Globale.PemainPemicu.ModeLompatGanda ? Globale.PemainPemicu.TingkatLompatGanda : 0);
		End;
		Call Subroutine(GambarMenu);
		End;
		Else If((Globale.PemainPemicu.HalamanMenu == 0));
		Call Subroutine(TerapkanHalamanWarna);
		Else If((Globale.PemainPemicu.HalamanMenu == 1));
		Call Subroutine(TerapkanHalamanKamera);
		Else If((Globale.PemainPemicu.HalamanMenu == 2));
		Call Subroutine(TerapkanHalamanMusik);
		Else If((Globale.PemainPemicu.HalamanMenu == 3));
		Call Subroutine(TerapkanHalamanBahasa);
		Else If((Globale.PemainPemicu.HalamanMenu == 4));
		Call Subroutine(TerapkanHalamanBalasDendam);
		Else If((Globale.PemainPemicu.HalamanMenu == 5));
		Call Subroutine(TerapkanHalamanKebal);
		Else If((Globale.PemainPemicu.HalamanMenu == 6));
		Call Subroutine(TerapkanHalamanSuara);
		Else If((Globale.PemainPemicu.HalamanMenu == 7));
		Call Subroutine(TerapkanHalamanIkon);
		Else If((Globale.PemainPemicu.HalamanMenu == 10));
		Call Subroutine(TerapkanHalamanNasib);
		Else If((Globale.PemainPemicu.HalamanMenu == 11));
		Call Subroutine(TerapkanHalamanPilihan);
		Else If((Globale.PemainPemicu.HalamanMenu == 13));
		Call Subroutine(TerapkanHalamanHantuTerbang);
		Else If((Globale.PemainPemicu.HalamanMenu == 14));
		Call Subroutine(TerapkanHalamanLompatGanda);
		End;
	}
}

regola("99a - Subrutin: Terapkan halaman musik")
{
	evento
	{
		Subroutine;
		TerapkanHalamanMusik;
	}

	azioni
	{
		Abort If((Globale.PemainPemicu.MusikKhusus != Null));
		If((Globale.PemainPemicu.IndeksGenre != Globale.PemainPemicu.KursorGenre));
		Globale.PemainPemicu.IndeksGenre = Globale.PemainPemicu.KursorGenre;
		End;
	}
}

regola("99b - Subrutin: Terapkan halaman kamera")
{
	evento
	{
		Subroutine;
		TerapkanHalamanKamera;
	}

	azioni
	{
		Call Subroutine(SegarkanTargetKamera);
		Globale.PemainPemicu.KursorKamera %= (Count Of(Globale.PemainPemicu.DaftarTargetKamera) + 2);
		If((Globale.PemainPemicu.KursorKamera == 0));
		If((Globale.PemainPemicu.ModeKamera != 0));
		Stop Camera(Globale.PemainPemicu);
		Globale.PemainPemicu.ModeKamera = 0;
		Globale.PemainPemicu.TargetKamera = Null;
		End;
		Else If((Globale.PemainPemicu.KursorKamera == 1));
		If(Or((Globale.PemainPemicu.ModeKamera != 1), (Globale.PemainPemicu.TargetKamera != Globale.PemainPemicu)));
		Globale.PemainPemicu.TargetKamera = Globale.PemainPemicu;
		Globale.PemainPemicu.ModeKamera = 1;
		Call Subroutine(MulaiKamera);
		End;
		Else;
		If(((Globale.PemainPemicu.KursorKamera - 2) < Count Of(Globale.PemainPemicu.DaftarTargetKamera)));
		Globale.PemainPemicu.CalonTargetKamera = Globale.PemainPemicu.DaftarTargetKamera[(Globale.PemainPemicu.KursorKamera - 2)];
		Else;
		Globale.PemainPemicu.CalonTargetKamera = Null;
		End;
		If(And((Globale.PemainPemicu.CalonTargetKamera != Null), Entity Exists(Globale.PemainPemicu.CalonTargetKamera)));
		If(Or((Globale.PemainPemicu.ModeKamera != 2), (Globale.PemainPemicu.TargetKamera != Globale.PemainPemicu.CalonTargetKamera)));
		Globale.PemainPemicu.TargetKamera = Globale.PemainPemicu.CalonTargetKamera;
		Globale.PemainPemicu.ModeKamera = 2;
		Call Subroutine(MulaiKamera);
		End;
		Else;
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Camera target unavailable. Poof!") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Target kamera tak tersedia. Coba yang lain!") : Custom String("เป้าหมายกล้องหายไปแล้ว พักกล้องก่อน!"))));
		End;
		End;
	}
}

regola("99c - Subrutin: Terapkan halaman warna")
{
	evento
	{
		Subroutine;
		TerapkanHalamanWarna;
	}

	azioni
	{
		If((Globale.PemainPemicu.IndeksWarna != Globale.PemainPemicu.KursorWarna));
		Globale.PemainPemicu.IndeksWarna = Globale.PemainPemicu.KursorWarna;
		Globale.PemainPemicu.WarnaNama = Globale.DaftarWarna[Globale.PemainPemicu.IndeksWarna];
		If((Globale.PemimpinPilihan == Globale.PemainPemicu));
		Globale.WarnaPemimpinPilihan = Globale.PemainPemicu.WarnaNama;
		End;
		End;
	}
}

regola("99d - Subrutin: Terapkan halaman bahasa")
{
	evento
	{
		Subroutine;
		TerapkanHalamanBahasa;
	}

	azioni
	{
		If((Globale.PemainPemicu.IndeksBahasa != Globale.PemainPemicu.KursorBahasa));
		Globale.PemainPemicu.IndeksBahasa = Globale.PemainPemicu.KursorBahasa;
		End;
	}
}

regola("99e - Subrutin: Terapkan halaman balas dendam")
{
	evento
	{
		Subroutine;
		TerapkanHalamanBalasDendam;
	}

	azioni
	{
		If(And((Globale.PemainPemicu.TargetBalasDendamTerkunci != Null), And(Entity Exists(Globale.PemainPemicu.TargetBalasDendamTerkunci), (Player Variable(Globale.PemainPemicu.TargetBalasDendamTerkunci, PenagihBalasDendam) == Globale.PemainPemicu))));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Revenge pending. Debt drops when the target dies.") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Balas dendam diproses. Utang berkurang saat target mati.") : Custom String("ล้างแค้นอยู่ รอเป้าหมายตายจริงก่อนตัดหนี้"))));
		Else;
		Globale.PemainPemicu.TargetBalasDendamTerkunci = Null;
		Call Subroutine(SegarkanTargetBalasDendam);
		If((Count Of(Globale.PemainPemicu.DaftarTargetBalasDendam) == 0));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("No revenge targets. Peace wins!") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Tak ada target balas dendam. Damai dulu!") : Custom String("ไม่มีเป้าหมายล้างแค้น พักรบก่อน!"))));
		Else;
		Globale.PemainPemicu.KursorBalasDendam %= Count Of(Globale.PemainPemicu.DaftarTargetBalasDendam);
		Globale.PemainPemicu.TargetBalasDendamTerkunci = Globale.PemainPemicu.DaftarTargetBalasDendam[Globale.PemainPemicu.KursorBalasDendam];
		Globale.PemainPemicu.IndeksBalasDendam = Index Of Array Value(Globale.PemainPemicu.PembunuhBalasDendam, Globale.PemainPemicu.TargetBalasDendamTerkunci);
		If((Globale.PemainPemicu.IndeksBalasDendam < 0));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("No revenge debt on that player.") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Pemain itu tak punya utang. Damai, ya!") : Custom String("คนนี้ไม่มีหนี้แค้น พักรบก่อน!"))));
		Globale.PemainPemicu.TargetBalasDendamTerkunci = Null;
		Else If((Globale.PemainPemicu.JumlahBalasDendam[Globale.PemainPemicu.IndeksBalasDendam] <= 0));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Revenge debt cleared. Case closed!") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Utang balas dendam lunas. Beres!") : Custom String("หนี้แค้นหมดแล้ว ปิดคดี!"))));
		Globale.PemainPemicu.TargetBalasDendamTerkunci = Null;
		Else If(Or(Not(Entity Exists(Globale.PemainPemicu.TargetBalasDendamTerkunci)), Not(Is Alive(Globale.PemainPemicu.TargetBalasDendamTerkunci))));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Revenge target already down.") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Target sudah tumbang. Sabar dulu!") : Custom String("เป้าหมายล้มแล้ว ล้างแค้นพักก่อน!"))));
		Globale.PemainPemicu.TargetBalasDendamTerkunci = Null;
		Else If(Player Variable(Globale.PemainPemicu.TargetBalasDendamTerkunci, KematianBalasDendam));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Revenge pending on that target.") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Balas dendam ke target itu masih diproses.") : Custom String("เป้าหมายกำลังถูกล้างแค้นอยู่"))));
		Globale.PemainPemicu.TargetBalasDendamTerkunci = Null;
		Else If(Player Variable(Globale.PemainPemicu.TargetBalasDendamTerkunci, KartuNasibAktif));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Target busy with Try Your Luck.") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Target lagi Coba Nasib. Tunggu dulu!") : Custom String("เป้าหมายเสี่ยงโชคอยู่ รอจบก่อน"))));
		Globale.PemainPemicu.TargetBalasDendamTerkunci = Null;
		Else;
		Set Player Variable(Globale.PemainPemicu.TargetBalasDendamTerkunci, KematianBalasDendam, True);
		Set Player Variable(Globale.PemainPemicu.TargetBalasDendamTerkunci, PenagihBalasDendam, Globale.PemainPemicu);
		Set Player Variable(Globale.PemainPemicu.TargetBalasDendamTerkunci, WaktuPaksaBerikut, Total Time Elapsed);
		Set Player Variable(Globale.PemainPemicu.TargetBalasDendamTerkunci, WaktuPaksaBerakhir, (Total Time Elapsed + 5));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Revenge on {0}. Confirming the kill.", Globale.PemainPemicu.TargetBalasDendamTerkunci) : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Balas dendam ke {0}. Tunggu target mati.", Globale.PemainPemicu.TargetBalasDendamTerkunci) : Custom String("เริ่มล้างแค้น {0} รอให้ตายจริง", Globale.PemainPemicu.TargetBalasDendamTerkunci))));
		End;
		End;
		End;
	}
}

regola("99f - Subrutin: Terapkan halaman kebal")
{
	evento
	{
		Subroutine;
		TerapkanHalamanKebal;
	}

	azioni
	{
		If((Globale.PemainPemicu.ModeKebal != Globale.PemainPemicu.KursorKebal));
		If(And((Globale.PemainPemicu.KursorKebal == 1), Is In Spawn Room(Globale.PemainPemicu)));
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("1 HP is disabled in spawn. FULL HP works.") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Kebal 1 HP tak bisa di ruang muncul. HP PENUH bisa.") : Custom String("ห้องเกิด: 1 HP (ฮีลได้) ใช้ไม่ได้ แต่ HP เต็ม ใช้ได้"))));
		Else;
		Globale.PemainPemicu.ModeKebal = Globale.PemainPemicu.KursorKebal;
		Globale.PemainPemicu.KebalAktif = (Globale.PemainPemicu.ModeKebal != 0);
		If((Globale.PemainPemicu.ModeKebal == 0));
		Clear Status(Globale.PemainPemicu, Unkillable);
		Set Damage Received(Globale.PemainPemicu, 100);
		Set Knockback Received(Globale.PemainPemicu, 100);
		Enable Movement Collision With Players(Globale.PemainPemicu);
		If(Is Alive(Globale.PemainPemicu));
		Set Player Health(Globale.PemainPemicu, Max Health(Globale.PemainPemicu));
		End;
		If((Globale.PemainPemicu.IkonKebal != Null));
		Destroy Icon(Globale.PemainPemicu.IkonKebal);
		Globale.PemainPemicu.IkonKebal = Null;
		If(Array Contains(Globale.PemainManusia, Globale.PemainPemicu));
		Globale.IkonKebalPemain[Globale.SlotHUDPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)]] = 0;
		End;
		End;
		Else;
		Clear Status(Globale.PemainPemicu, Unkillable);
		Set Status(Globale.PemainPemicu, Null, Unkillable, 9999);
		If((Globale.PemainPemicu.ModeKebal == 1));
		Set Damage Received(Globale.PemainPemicu, 100);
		Set Knockback Received(Globale.PemainPemicu, 100);
		Enable Movement Collision With Players(Globale.PemainPemicu);
		If(Is Alive(Globale.PemainPemicu));
		Set Player Health(Globale.PemainPemicu, 1);
		End;
		Else;
		Set Damage Received(Globale.PemainPemicu, 0);
		Set Knockback Received(Globale.PemainPemicu, 0);
		Disable Movement Collision With Players(Globale.PemainPemicu);
		If(Is Alive(Globale.PemainPemicu));
		Set Player Health(Globale.PemainPemicu, Max Health(Globale.PemainPemicu));
		End;
		End;
		If((Globale.PemainPemicu.IkonKebal != Null));
		Destroy Icon(Globale.PemainPemicu.IkonKebal);
		Globale.PemainPemicu.IkonKebal = Null;
		If(Array Contains(Globale.PemainManusia, Globale.PemainPemicu));
		Globale.IkonKebalPemain[Globale.SlotHUDPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)]] = 0;
		End;
		End;
		If((Globale.PemainPemicu.ModeKebal == 1));
		Create Icon(All Players(All Teams), Evaluate Once(Globale.PemainPemicu), Warning, Visible To and Position, Custom Color(255, 80, 80, 255), True);
		Else;
		Create Icon(All Players(All Teams), Evaluate Once(Globale.PemainPemicu), Halo, Visible To and Position, Globale.RGB, True);
		End;
		Globale.PemainPemicu.IkonKebal = Last Created Entity;
		If(Array Contains(Globale.PemainManusia, Globale.PemainPemicu));
		Globale.IkonKebalPemain[Globale.SlotHUDPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)]] = Globale.PemainPemicu.IkonKebal;
		End;
		End;
		End;
		End;
	}
}

regola("99g - Subrutin: Terapkan halaman suara pahlawan")
{
	evento
	{
		Subroutine;
		TerapkanHalamanSuara;
	}

	azioni
	{
		If((Globale.PemainPemicu.IndeksSuara != Globale.PemainPemicu.KursorSuara));
		Globale.PemainPemicu.IndeksSuara = Globale.PemainPemicu.KursorSuara;
		If((Globale.PemainPemicu.IndeksSuara == 0));
		Stop Modifying Hero Voice Lines(Globale.PemainPemicu);
		Else If((Globale.PemainPemicu.IndeksSuara == 1));
		Start Modifying Hero Voice Lines(Globale.PemainPemicu, 0.500, False);
		Else If((Globale.PemainPemicu.IndeksSuara == 2));
		Start Modifying Hero Voice Lines(Globale.PemainPemicu, 0.750, False);
		Else If((Globale.PemainPemicu.IndeksSuara == 3));
		Start Modifying Hero Voice Lines(Globale.PemainPemicu, 1.250, False);
		Else;
		Start Modifying Hero Voice Lines(Globale.PemainPemicu, 1.500, False);
		End;
		End;
	}
}

