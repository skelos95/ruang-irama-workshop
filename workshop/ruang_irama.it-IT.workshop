regola("91g - Subrutin: Gambar menu teleportasi")
{
	evento
	{
		Subroutine;
		GambarTeleportasi;
	}

	azioni
	{
		If((Globale.PemainPemicu.HudMenu != Null));
		Destroy HUD Text(Globale.PemainPemicu.HudMenu);
		End;
		Globale.PemainPemicu.HudMenu = Null;
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) >= 0));
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) < Count Of(Globale.HudMenuPemain)));
		Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)] = 0;
		End;
		End;
		Globale.PemainPemicu.KursorTeleportasi %= 5;
		Create HUD Text(Evaluate Once(Globale.PemainPemicu), Null, ((Player Variable(Local Player, IndeksBahasa) == 0) ? Custom String("{0}
{1}", Custom String("HOLD {0} | {1}: NEXT | {2}: PREV", Input Binding String(Button(Crouch)), Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0} | {1}", Custom String("{0}: USE | RELEASE {1}: CLOSE", Input Binding String(Button(Interact)), Input Binding String(Button(Crouch))), Custom String("{0} + {1}: DETACH", Input Binding String(Button(Crouch)), Input Binding String(Button(Reload))))) : ((Player Variable(Local Player, IndeksBahasa) == 1) ? Custom String("{0}
{1}", Custom String("TAHAN {0} | {1}: MAJU | {2}: MUNDUR", Input Binding String(Button(Crouch)), Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0} | {1}", Custom String("{0}: PAKAI | LEPAS {1}: TUTUP", Input Binding String(Button(Interact)), Input Binding String(Button(Crouch))), Custom String("{0} + {1}: LEPAS", Input Binding String(Button(Crouch)), Input Binding String(Button(Reload))))) : Custom String("{0}
{1}", Custom String("กด {0} ค้าง | {1}: ถัดไป | {2}: ก่อนหน้า", Input Binding String(Button(Crouch)), Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0} | {1}", Custom String("{0}: ใช้ | ปล่อย {1}: ปิด", Input Binding String(Button(Interact)), Input Binding String(Button(Crouch))), Custom String("{0} + {1}: ปล่อย", Input Binding String(Button(Crouch)), Input Binding String(Button(Reload))))))), ((Player Variable(Local Player, IndeksBahasa) == 0) ? ((Player Variable(Local Player, KursorTeleportasi) == 0) ? Custom String("1/5 | TELEPORT: SPAWN ROOM
TEAM SPAWN") : ((Player Variable(Local Player, KursorTeleportasi) == 1) ? Custom String("2/5 | TELEPORT: OBJECTIVE") : ((Player Variable(Local Player, KursorTeleportasi) == 2) ? Custom String("3/5 | TELEPORT TO PLAYER/BOT
BESIDE: {0}", ((Player Variable(Local Player, CalonTargetTeleportasi) != Null) ? Player Variable(Local Player, CalonTargetTeleportasi) : Custom String("NO PUBLIC TARGET AVAILABLE"))) : ((Player Variable(Local Player, KursorTeleportasi) == 3) ? Custom String("4/5 | ATTACH TO PLAYER/BOT
ABOVE: {0}", ((Player Variable(Local Player, CalonTargetTeleportasi) != Null) ? Player Variable(Local Player, CalonTargetTeleportasi) : Custom String("NO PUBLIC TARGET AVAILABLE"))) : Custom String("5/5 | SELF ELIMINATION
CURRENT HERO FORM | COOLDOWN: 3s"))))) : ((Player Variable(Local Player, IndeksBahasa) == 1) ? ((Player Variable(Local Player, KursorTeleportasi) == 0) ? Custom String("1/5 | TELEPORT: RUANG MUNCUL
TIMMU") : ((Player Variable(Local Player, KursorTeleportasi) == 1) ? Custom String("2/5 | TELEPORT: OBJEKTIF") : ((Player Variable(Local Player, KursorTeleportasi) == 2) ? Custom String("3/5 | TELEPORT: PEMAIN/BOT
DI SAMPING: {0}", ((Player Variable(Local Player, CalonTargetTeleportasi) != Null) ? Player Variable(Local Player, CalonTargetTeleportasi) : Custom String("TAK ADA TARGET PUBLIK"))) : ((Player Variable(Local Player, KursorTeleportasi) == 3) ? Custom String("4/5 | TEMPEL: PEMAIN/BOT
DI ATAS: {0}", ((Player Variable(Local Player, CalonTargetTeleportasi) != Null) ? Player Variable(Local Player, CalonTargetTeleportasi) : Custom String("TAK ADA TARGET PUBLIK"))) : Custom String("5/5 | ELIMINASI DIRI
WUJUD PAHLAWAN AKTIF | JEDA: 3 DTK"))))) : ((Player Variable(Local Player, KursorTeleportasi) == 0) ? Custom String("1/5 | วาร์ป: ห้องเกิด
ทีมคุณ") : ((Player Variable(Local Player, KursorTeleportasi) == 1) ? Custom String("2/5 | วาร์ป: ภารกิจ") : ((Player Variable(Local Player, KursorTeleportasi) == 2) ? Custom String("3/5 | วาร์ป: ผู้เล่น / บอต
ไปข้างเป้าหมาย: {0}", ((Player Variable(Local Player, CalonTargetTeleportasi) != Null) ? Player Variable(Local Player, CalonTargetTeleportasi) : Custom String("ไม่มีเป้าหมายที่เปิดให้ใช้"))) : ((Player Variable(Local Player, KursorTeleportasi) == 3) ? Custom String("4/5 | เกาะ: ผู้เล่น / บอต
เกาะเหนือเป้าหมาย: {0}", ((Player Variable(Local Player, CalonTargetTeleportasi) != Null) ? Player Variable(Local Player, CalonTargetTeleportasi) : Custom String("ไม่มีเป้าหมายที่เปิดให้ใช้"))) : Custom String("5/5 | กำจัดตัวเอง
ร่างฮีโร่ปัจจุบัน | คูลดาวน์: 3 วิ"))))))), Top, 3, Color(Bianco), Custom Color((190 + (X Component Of(Player Variable(Local Player, WarnaMenu)) * 0.250)), (190 + (Y Component Of(Player Variable(Local Player, WarnaMenu)) * 0.250)), (190 + (Z Component Of(Player Variable(Local Player, WarnaMenu)) * 0.250)), 255), Custom Color(X Component Of(Player Variable(Local Player, WarnaMenu)), Y Component Of(Player Variable(Local Player, WarnaMenu)), Z Component Of(Player Variable(Local Player, WarnaMenu)), 255), Visible To String and Color, Visible Never);
		Globale.PemainPemicu.HudMenu = Last Text ID;
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) >= 0));
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) < Count Of(Globale.HudMenuPemain)));
		Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)] = Globale.PemainPemicu.HudMenu;
		End;
		End;
	}
}

