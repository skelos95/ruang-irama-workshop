{
	evento
	{
		Subroutine;
		Pengatur19h;
	}

	azioni
	{
		Abort If(Not(And(Not(Globale.PemainPemicu.PindahTimDiproses), And(Not(Globale.PemainPemicu.SiklusPemainAktif), And(Globale.PemainPemicu.LampiranTeleportasiAktif, Or(Or(Or(Not(Has Spawned(Globale.PemainPemicu)), Not(Is Alive(Globale.PemainPemicu))), Or((Globale.PemainPemicu.TargetLampiranTeleportasi == Null), Not(Entity Exists(Globale.PemainPemicu.TargetLampiranTeleportasi)))), Or(Or(Not(Has Spawned(Globale.PemainPemicu.TargetLampiranTeleportasi)), Not(Is Alive(Globale.PemainPemicu.TargetLampiranTeleportasi))), Or(Or((Hero Of(Globale.PemainPemicu) != Globale.PemainPemicu.PahlawanLampiranSendiri), (Hero Of(Globale.PemainPemicu.TargetLampiranTeleportasi) != Globale.PemainPemicu.PahlawanLampiranTarget)), Or(Player Variable(Globale.PemainPemicu.TargetLampiranTeleportasi, SiklusPemainAktif), And(Player Variable(Globale.PemainPemicu.TargetLampiranTeleportasi, Manusia), Player Variable(Globale.PemainPemicu.TargetLampiranTeleportasi, PrivasiInspeksiAktif)))))))))));
		Detach Players(Globale.PemainPemicu);
		Set Player Variable(Globale.PemainPemicu, LampiranTeleportasiAktif, False);
		Set Player Variable(Globale.PemainPemicu, TargetLampiranTeleportasi, Null);
		Set Player Variable(Globale.PemainPemicu, PahlawanLampiranSendiri, Null);
		Set Player Variable(Globale.PemainPemicu, PahlawanLampiranTarget, Null);
	}
}

regola("19g - Teleportasi Jongkok: Tutup saat Jongkok dilepas")
{
	evento
	{
		Subroutine;
		Pengatur19g;
	}

	azioni
	{
		Abort If(Not(And(Not(Globale.PemainPemicu.PindahTimDiproses), And(Not(Globale.PemainPemicu.SiklusPemainAktif), And(Globale.PemainPemicu.TeleportasiJongkokAktif, Or(Or(Or(Not(Is Button Held(Globale.PemainPemicu, Button(Crouch))), Globale.PemainPemicu.MenuTerbuka), Or(Not(Has Spawned(Globale.PemainPemicu)), Not(Is Alive(Globale.PemainPemicu)))), Globale.PemainPemicu.PrivasiNasibAktif))))));
		If((Globale.PemainPemicu.HudMenu != Null));
		Destroy HUD Text(Globale.PemainPemicu.HudMenu);
		End;
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) >= 0));
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) < Count Of(Globale.HudMenuPemain)));
		Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)] = 0;
		End;
		End;
		Globale.PemainPemicu.HudMenu = Null;
		Globale.PemainPemicu.TeleportasiJongkokAktif = False;
		Globale.PemainPemicu.PerintahTeleportasi = 0;
		Globale.PemainPemicu.DaftarTargetTeleportasi = Empty Array;
		Globale.PemainPemicu.CalonTargetTeleportasi = Null;
		If((Globale.PemainPemicu.TeksTeleportasi != Null));
		If((Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu) >= 0));
		If((Globale.TeksTeleportasiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu)] == Globale.PemainPemicu.TeksTeleportasi));
		Destroy In-World Text(Globale.PemainPemicu.TeksTeleportasi);
		Globale.TeksTeleportasiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPemicu)] = 0;
		End;
		End;
		End;
		Globale.PemainPemicu.TeksTeleportasi = Null;
		Globale.PemainPemicu.TargetTeleportasiTeks = Null;
		Globale.PemainPemicu.JenisTeleportasiTerkunci = -1;
		Globale.PemainPemicu.TargetTeleportasiTerkunci = Null;
		If(Globale.PemainPemicu.PelatNamaDinonaktifkan);
		Enable Nameplates(All Players(All Teams), Globale.PemainPemicu);
		Globale.PemainPemicu.PelatNamaDinonaktifkan = False;
		End;
		If((Globale.PemainPemicu.TeksDunia != Null));
		Destroy In-World Text(Globale.PemainPemicu.TeksDunia);
		End;
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) >= 0));
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) < Count Of(Globale.TeksDuniaPemain)));
		Globale.TeksDuniaPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)] = 0;
		End;
		End;
		Globale.PemainPemicu.TeksDunia = Null;
		Globale.PemainPemicu.TargetInspeksi = Null;
		Globale.PemainPemicu.DaftarTargetInspeksi = Empty Array;
		Globale.PemainPemicu.InspeksiAktif = False;
		Allow Button(Globale.PemainPemicu, Button(Primary Fire));
		Allow Button(Globale.PemainPemicu, Button(Secondary Fire));
		Allow Button(Globale.PemainPemicu, Button(Interact));
	}
}

regola("89a - Subrutin: Proses status cepat pemain")
{
	evento
	{
		Subroutine;
		ProsesCepatPemain;
	}

	azioni
	{
		If(And(Not(Globale.PemainAktif.PilihanPahlawanSelesai), (Globale.PemainAktif.WaktuPilihPahlawan == 0)));
		If(Or((Team Of(Globale.PemainAktif) == Team 1), (Team Of(Globale.PemainAktif) == Team 2)));
		Globale.PemainAktif.WaktuPilihPahlawan = (Total Time Elapsed + 60);
		End;
		End;
		If(And(Array Contains(Globale.PemainManusia, Globale.PemainAktif), And(Or((Globale.PemainAktif.NamaTampilan == Null), (Globale.PemainAktif.NamaTampilan == Custom String(""))), (Custom String("{0}", Globale.PemainAktif) != Custom String("")))));
		Globale.PemainAktif.NamaTampilan = Evaluate Once(Custom String("{0}", Globale.PemainAktif));
		End;
		If(And(Not(Globale.PemainAktif.SiklusPemainAktif), And(Not(Is Dummy Bot(Globale.PemainAktif)), And(Not(Globale.PemainAktif.BotOtomatis), And(Array Contains(Globale.PemainManusia, Globale.PemainAktif), Or(Not(Globale.PemainAktif.Manusia), Not(Globale.PemainAktif.PernahDisiapkan)))))));
		If((Globale.PemainAktif.NamaTampilan == Custom String("งูแรร์")));
		Globale.PemainAktif.MusikKhusus = Custom String("Draconian");
		If(Not(Globale.PemainAktif.PernahDisiapkan));
		Globale.PemainAktif.IndeksWarna = 2;
		Globale.PemainAktif.KursorWarna = 2;
		Globale.PemainAktif.WarnaNama = Globale.DaftarWarna[2];
		Globale.PemainAktif.WarnaMenu = Globale.DaftarWarnaRGB[2];
		Globale.PemainAktif.IndeksIkon = 23;
		Globale.PemainAktif.KursorIkon = 23;
		End;
		End;
		Globale.PemainAktif.Manusia = True;
		Globale.PemainAktif.SudahDiperiksa = True;
		Globale.PemainAktif.SudahSiap = True;
		Globale.PemainAktif.PernahDisiapkan = True;
		End;
		If(And(Not(Is Dummy Bot(Globale.PemainAktif)), And(Not(Globale.PemainAktif.BotOtomatis), And(Not(Array Contains(Globale.PemainManusia, Globale.PemainAktif)), Or(Not(Globale.PemainAktif.PindahTimDiproses), (Globale.PemainAktif.TimSiklusTarget != Team Of(Globale.PemainAktif)))))));
		Globale.PemainAktif.PindahTimDiproses = True;
		Globale.PemainAktif.SiklusPemainAktif = False;
		Globale.PemainAktif.SudahSiap = False;
		Globale.PemainAktif.Manusia = False;
		Globale.PemainAktif.TimSiklusTarget = Team Of(Globale.PemainAktif);
		Globale.PemainAktif.WaktuSiklusTim = (Total Time Elapsed + 0.250);
		If((Globale.PemainSiklusGlobal == Globale.PemainAktif));
		Globale.PemainSiklusGlobal = Null;
		Globale.PemilikFaseSiklus = Null;
		Globale.WaktuSiklusGlobal = (Total Time Elapsed + 0.250);
		End;
		End;
		If(And((Globale.PemainSiklusGlobal == Null), And(Globale.PemainAktif.PindahTimDiproses, And(Not(Globale.PemainAktif.BotOtomatis), And(Or(Not(Array Contains(Globale.PemainManusia, Globale.PemainAktif)), Globale.PemainAktif.SiklusPemainAktif), And((Globale.PemainAktif.TimSiklusTarget == Team Of(Globale.PemainAktif)), And(Entity Exists(Globale.PemainAktif), And(Has Spawned(Globale.PemainAktif), And((Total Time Elapsed >= Globale.WaktuSiklusGlobal), (Total Time Elapsed >= Globale.PemainAktif.WaktuSiklusTim))))))))));
		Globale.PemainSiklusGlobal = Globale.PemainAktif;
		End;
		If(And(Globale.PemainAktif.Manusia, Or(Globale.PemainAktif.KematianBalasDendam, And(Globale.PemainAktif.KartuNasibAktif, And((Globale.PemainAktif.EfekNasib == 3), And((Globale.PemainAktif.PutaranKartuNasib == 0), (Globale.PemainAktif.WaktuPaksaBerakhir > 0)))))));
		If(And(Globale.PemainAktif.KematianBalasDendam, Or((Globale.PemainAktif.PenagihBalasDendam == Null), Or(Not(Entity Exists(Globale.PemainAktif.PenagihBalasDendam)), Not(Player Variable(Globale.PemainAktif.PenagihBalasDendam, Manusia))))));
		Globale.PemainAktif.KematianBalasDendam = False;
		Globale.PemainAktif.PenagihBalasDendam = Null;
		Globale.PemainAktif.WaktuPaksaBerikut = 0;
		Globale.PemainAktif.WaktuPaksaBerakhir = 0;
		Else If(And((Globale.PemainAktif.WaktuPaksaBerakhir > 0), (Total Time Elapsed >= Globale.PemainAktif.WaktuPaksaBerakhir)));
		If(Globale.PemainAktif.KematianBalasDendam);
		Small Message(Globale.PemainAktif.PenagihBalasDendam, ((Player Variable(Globale.PemainAktif.PenagihBalasDendam, IndeksBahasa) == 0) ? Custom String("Revenge failed. Debt unchanged.") : ((Player Variable(Globale.PemainAktif.PenagihBalasDendam, IndeksBahasa) == 1) ? Custom String("Balas dendam gagal. Utang tetap utuh.") : Custom String("ล้างแค้นไม่สำเร็จ หนี้ยังเท่าเดิม"))));
		Set Player Variable(Globale.PemainAktif.PenagihBalasDendam, TargetBalasDendamTerkunci, Null);
		Globale.PemainAktif.KematianBalasDendam = False;
		Globale.PemainAktif.PenagihBalasDendam = Null;
		Else;
		Call Subroutine(PulihkanNasibAktif);
		Globale.PemainAktif.MenuNasibHarusDibuka = Not(Globale.PemainAktif.MenuTerbuka);
		Small Message(Globale.PemainAktif, ((Globale.PemainAktif.IndeksBahasa == 0) ? Custom String("SKULL failed. Menu restored.") : ((Globale.PemainAktif.IndeksBahasa == 1) ? Custom String("TENGKORAK gagal. Menu kembali.") : Custom String("กะโหลกไม่สำเร็จ คืนเมนูแล้ว"))));
		End;
		Globale.PemainAktif.WaktuPaksaBerikut = 0;
		Globale.PemainAktif.WaktuPaksaBerakhir = 0;
		Else If(And(Has Spawned(Globale.PemainAktif), And(Is Alive(Globale.PemainAktif), (Total Time Elapsed >= Globale.PemainAktif.WaktuPaksaBerikut))));
		Globale.PemainAktif.WaktuPaksaBerikut = (Total Time Elapsed + 0.250);
		Clear Status(Globale.PemainAktif, Unkillable);
		Set Damage Received(Globale.PemainAktif, 100);
		Kill(Globale.PemainAktif, (Globale.PemainAktif.KematianBalasDendam ? Globale.PemainAktif.PenagihBalasDendam : Null));
		End;
		End;
		If(And(Globale.PemainAktif.Manusia, And(Globale.PemainAktif.KebalAktif, And(Not(Globale.PemainAktif.KematianBalasDendam), And(Not(And(And(Globale.PemainAktif.KartuNasibAktif, (Globale.PemainAktif.PutaranKartuNasib == 0)), Or(And((Globale.PemainAktif.EfekNasib == 3), (Globale.PemainAktif.WaktuPaksaBerakhir > 0)), And((Globale.PemainAktif.EfekNasib == 5), (Globale.PemainAktif.EfekNasibBerakhir > Total Time Elapsed))))), And(Has Spawned(Globale.PemainAktif), Is Alive(Globale.PemainAktif)))))));
		If(And((Globale.PemainAktif.ModeKebal == 1), Not(Is In Spawn Room(Globale.PemainAktif))));
		If(Or(Not(Has Status(Globale.PemainAktif, Unkillable)), Or((Hero Of(Globale.PemainAktif) != Globale.PemainAktif.PahlawanTerakhir), ((Globale.LangkahPenjadwal % 20) == (Globale.PemainAktif.UrutanHUD % 20)))));
		If(Not(Has Status(Globale.PemainAktif, Unkillable)));
		Set Status(Globale.PemainAktif, Null, Unkillable, 9999);
		End;
		Set Damage Received(Globale.PemainAktif, 100);
		Set Knockback Received(Globale.PemainAktif, 100);
		Enable Movement Collision With Players(Globale.PemainAktif);
		End;
		If((Health(Globale.PemainAktif) >= Max Health(Globale.PemainAktif)));
		Set Player Health(Globale.PemainAktif, 1);
		End;
		Else If((Globale.PemainAktif.ModeKebal == 2));
		If(Or(Not(Has Status(Globale.PemainAktif, Unkillable)), Or((Hero Of(Globale.PemainAktif) != Globale.PemainAktif.PahlawanTerakhir), ((Globale.LangkahPenjadwal % 20) == (Globale.PemainAktif.UrutanHUD % 20)))));
		If(Not(Has Status(Globale.PemainAktif, Unkillable)));
		Set Status(Globale.PemainAktif, Null, Unkillable, 9999);
		End;
		Set Damage Received(Globale.PemainAktif, 0);
		Set Knockback Received(Globale.PemainAktif, 0);
		Disable Movement Collision With Players(Globale.PemainAktif);
		End;
		If((Health(Globale.PemainAktif) < Max Health(Globale.PemainAktif)));
		Set Player Health(Globale.PemainAktif, Max Health(Globale.PemainAktif));
		End;
		End;
		If(Or((Globale.PemainAktif.IkonKebal == Null), Not(Entity Exists(Globale.PemainAktif.IkonKebal))));
		If((Globale.PemainAktif.ModeKebal == 1));
		Create Icon(All Players(All Teams), Evaluate Once(Globale.PemainAktif), Warning, Visible To and Position, Custom Color(255, 80, 80, 255), True);
		Else;
		Create Icon(All Players(All Teams), Evaluate Once(Globale.PemainAktif), Halo, Visible To and Position, Globale.RGB, True);
		End;
		Globale.PemainAktif.IkonKebal = Last Created Entity;
		If(Array Contains(Globale.PemainManusia, Globale.PemainAktif));
		Globale.IkonKebalPemain[Globale.SlotHUDPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif)]] = Globale.PemainAktif.IkonKebal;
		End;
		End;
		End;
	}
}

regola("89a2 - Subrutin: Mesin terbang 3D per pemain 20 Hz")
{
	evento
	{
		Subroutine;
		ProsesTerbangPemain;
	}

	azioni
	{
		If(And(Globale.PemainAktif.Manusia, And(Not(Globale.PemainAktif.BotOtomatis), And(Not(Is Dummy Bot(Globale.PemainAktif)), And(Has Spawned(Globale.PemainAktif), And(Is Alive(Globale.PemainAktif), And(Globale.PemainAktif.ModeTerbangAktif, Globale.PemainAktif.FisikaHantuTerbangDiterapkan)))))));
		If(And((Globale.PemainAktif.EfekNasib == 2), (Globale.PemainAktif.EfekNasibBerakhir > Total Time Elapsed)));
		Globale.PemainAktif.WaktuMulaiTerbangMaju = -1;
		Globale.PemainAktif.PersenTerbang = 100;
		Globale.PemainAktif.ArahTerbang = Vector(0, 0, 0);
		Globale.PemainAktif.DeltaTerbang = Vector(0, 0, 0);
		Else;
		Set Move Speed(Globale.PemainAktif, 0);
		If((Magnitude Of(Vector(X Component Of(Throttle Of(Globale.PemainAktif)), 0, Z Component Of(Throttle Of(Globale.PemainAktif)))) > 0.050));
		If((Globale.PemainAktif.WaktuMulaiTerbangMaju < 0));
		Globale.PemainAktif.WaktuMulaiTerbangMaju = Total Time Elapsed;
		End;
		Globale.PemainAktif.PersenTerbang = Min(1000, (100 + (Max(0, (Total Time Elapsed - Globale.PemainAktif.WaktuMulaiTerbangMaju)) * 45)));
		Else;
		Globale.PemainAktif.WaktuMulaiTerbangMaju = -1;
		Globale.PemainAktif.PersenTerbang = 100;
		End;
		Globale.PemainAktif.ArahTerbang = (((Facing Direction Of(Globale.PemainAktif) * Max(0, Z Component Of(Throttle Of(Globale.PemainAktif)))) + (Direction From Angles(Horizontal Facing Angle Of(Globale.PemainAktif), 0) * Min(0, Z Component Of(Throttle Of(Globale.PemainAktif))))) + (Cross Product(Vector(0, 1, 0), Direction From Angles(Horizontal Facing Angle Of(Globale.PemainAktif), 0)) * X Component Of(Throttle Of(Globale.PemainAktif))));
		If((Magnitude Of(Globale.PemainAktif.ArahTerbang) > 0.050));
		Globale.PemainAktif.DeltaTerbang = (((((Normalize(Globale.PemainAktif.ArahTerbang) * 5.500) * Globale.PemainAktif.PersenTerbang) / 100) * Min(1, Magnitude Of(Throttle Of(Globale.PemainAktif)))) - Velocity Of(Globale.PemainAktif));
		Else;
		Globale.PemainAktif.DeltaTerbang = (Velocity Of(Globale.PemainAktif) * -1);
		End;
		If((Magnitude Of(Globale.PemainAktif.DeltaTerbang) > 0.010));
		Apply Impulse(Globale.PemainAktif, Globale.PemainAktif.DeltaTerbang, Magnitude Of(Globale.PemainAktif.DeltaTerbang), To World, Incorporate Contrary Motion);
		End;
		End;
		End;
	}
}

regola("89b - Subrutin: Proses siklus pemain 10 Hz")
{
	evento
	{
		Subroutine;
		ProsesSiklusPemain;
	}

	azioni
	{
		If(And(Globale.PemainAktif.Manusia, And(Not(Globale.PemainAktif.BotOtomatis), And(Not(Is Dummy Bot(Globale.PemainAktif)), Or(Not(Has Spawned(Globale.PemainAktif)), Not(Is Alive(Globale.PemainAktif)))))));
		Globale.PemainAktif.WaktuMulaiTerbangMaju = -1;
		If(Or((Globale.PemainAktif.EfekNasib != 2), (Globale.PemainAktif.EfekNasibBerakhir <= Total Time Elapsed)));
		Set Move Speed(Globale.PemainAktif, 100);
		End;
		If(Globale.PemainAktif.FisikaHantuTerbangDiterapkan);
		Stop Transforming Throttle(Globale.PemainAktif);
		Set Gravity(Globale.PemainAktif, 100);
		Enable Movement Collision With Environment(Globale.PemainAktif);
		Globale.PemainAktif.FisikaHantuTerbangDiterapkan = False;
		End;
		End;
		If(And(Globale.PemainAktif.Manusia, And(Not(Globale.PemainAktif.BotOtomatis), And(Not(Is Dummy Bot(Globale.PemainAktif)), And(Has Spawned(Globale.PemainAktif), Is Alive(Globale.PemainAktif))))));
		If(Not(Globale.PemainAktif.FisikaHantuTerbangDiterapkan));
		Globale.PemainAktif.WaktuMulaiTerbangMaju = -1;
		If(Or((Globale.PemainAktif.EfekNasib != 2), (Globale.PemainAktif.EfekNasibBerakhir <= Total Time Elapsed)));
		Set Move Speed(Globale.PemainAktif, (Globale.PemainAktif.ModeTerbangAktif ? 0 : 100));
		End;
		Stop Transforming Throttle(Globale.PemainAktif);
		Set Gravity(Globale.PemainAktif, 100);
		Enable Movement Collision With Environment(Globale.PemainAktif);
		If(Globale.PemainAktif.ModeHantuAktif);
		Disable Movement Collision With Environment(Globale.PemainAktif, False);
		End;
		If(Globale.PemainAktif.ModeTerbangAktif);
		Set Gravity(Globale.PemainAktif, 0);
		End;
		Globale.PemainAktif.FisikaHantuTerbangDiterapkan = True;
		End;
		End;
		If(And(Globale.PemainAktif.Manusia, And(Has Spawned(Globale.PemainAktif), Is Alive(Globale.PemainAktif))));
		If(And(Not(Globale.PemainAktif.MenuTerbuka), And(Not(Globale.PemainAktif.PrivasiNasibAktif), And(Not(Globale.PemainAktif.TeleportasiJongkokAktif), And(Not(Globale.PemainAktif.TeleportasiJongkokDiaktifkan), And((Globale.PemainAktif.ModeKamera != 2), Is Button Held(Globale.PemainAktif, Button(Crouch))))))));
		Call Subroutine(SegarkanTargetPublikAktif);
		Set Player Variable(Globale.PemainAktif, CalonTargetInspeksi, ((Count Of(Globale.PemainAktif.DaftarTargetInspeksi) == 0) ? Null : First Of(Sorted Array(Globale.PemainAktif.DaftarTargetInspeksi, Angle Between Vectors(Facing Direction Of(Globale.PemainAktif), Direction Towards(Eye Position(Globale.PemainAktif), Eye Position(Current Array Element)))))));
		Else;
		Set Player Variable(Globale.PemainAktif, CalonTargetInspeksi, Null);
		End;
		If(And(Globale.PemainAktif.TeleportasiJongkokAktif, And(Or((Globale.PemainAktif.KursorTeleportasi == 2), (Globale.PemainAktif.KursorTeleportasi == 3)), Is Button Held(Globale.PemainAktif, Button(Crouch)))));
		Call Subroutine(SegarkanTargetPublikAktif);
		Set Player Variable(Globale.PemainAktif, DaftarTargetTeleportasi, Globale.PemainAktif.DaftarTargetInspeksi);
		Set Player Variable(Globale.PemainAktif, CalonTargetTeleportasi, ((Count Of(Globale.PemainAktif.DaftarTargetTeleportasi) == 0) ? Null : First Of(Sorted Array(Globale.PemainAktif.DaftarTargetTeleportasi, Angle Between Vectors(Facing Direction Of(Globale.PemainAktif), Direction Towards(Eye Position(Globale.PemainAktif), Eye Position(Current Array Element)))))));
		End;
		End;
		If(And(Globale.PemainAktif.PindahTimDiproses, And(Globale.PemainAktif.Manusia, And(Has Spawned(Globale.PemainAktif), Globale.PemainAktif.HudPemainDibuat))));
		Globale.PemainAktif.PindahTimDiproses = False;
		Globale.PemainAktif.SiklusPemainAktif = False;
		Globale.PemainAktif.WaktuSiklusTim = 0;
		If((Globale.PemainSiklusGlobal == Globale.PemainAktif));
		Globale.PemainSiklusGlobal = Null;
		Globale.WaktuSiklusGlobal = (Total Time Elapsed + 0.250);
		End;
		End;
		If(And(Globale.PemainAktif.Manusia, And(Has Spawned(Globale.PemainAktif), (Hero Of(Globale.PemainAktif) != Globale.PemainAktif.PahlawanTerakhir))));
		Globale.PemainAktif.PahlawanTerakhir = Hero Of(Globale.PemainAktif);
		Globale.PemainAktif.FisikaHantuTerbangDiterapkan = False;
		Globale.PemainAktif.WaktuMulaiTerbangMaju = -1;
		If(Or((Globale.PemainAktif.EfekNasib != 2), (Globale.PemainAktif.EfekNasibBerakhir <= Total Time Elapsed)));
		Set Move Speed(Globale.PemainAktif, 100);
		End;
		If(Or(Globale.PemainAktif.KartuNasibAktif, Or((Globale.PemainAktif.PutaranKartuNasib > 0), (Globale.PemainAktif.EfekNasib != 0))));
		Call Subroutine(PulihkanNasibAktif);
		Globale.PemainAktif.MenuNasibHarusDibuka = Not(Globale.PemainAktif.MenuTerbuka);
		End;
		End;
		If((Globale.PemainAktif.ModeKamera == 2));
		If(Or(Globale.PemainAktif.TargetKamera.SiklusPemainAktif, Or(Or(Or((Globale.PemainAktif.TargetKamera == Null), Not(Entity Exists(Globale.PemainAktif.TargetKamera))), Or(Not(Has Spawned(Globale.PemainAktif.TargetKamera)), Not(Is Alive(Globale.PemainAktif.TargetKamera)))), And(Globale.PemainAktif.TargetKamera.Manusia, Globale.PemainAktif.TargetKamera.PrivasiInspeksiAktif))));
		Stop Camera(Globale.PemainAktif);
		Set Player Variable(Globale.PemainAktif, ModeKamera, 0);
		Set Player Variable(Globale.PemainAktif, TargetKamera, Null);
		Small Message(Globale.PemainAktif, ((Globale.PemainAktif.IndeksBahasa == 0) ? Custom String("Camera target unavailable/private.") : ((Globale.PemainAktif.IndeksBahasa == 1) ? Custom String("Target kamera tak tersedia / privat. Kamera normal.") : Custom String("เป้าหมายกล้องไม่พร้อม/ตั้งส่วนตัว กลับมุมมองปกติแล้ว"))));
		End;
		End;
		If(And(Globale.PemainAktif.InspeksiAktif, Or(Or(Or(Or(Or(Or(Not(Is Button Held(Globale.PemainAktif, Button(Crouch))), Globale.PemainAktif.MenuTerbuka), Not(Has Spawned(Globale.PemainAktif))), Not(Is Alive(Globale.PemainAktif))), (Globale.PemainAktif.ModeKamera == 2)), And(Globale.PemainAktif.TeleportasiJongkokAktif, And((Globale.PemainAktif.KursorTeleportasi != 2), (Globale.PemainAktif.KursorTeleportasi != 3)))), Globale.PemainAktif.PrivasiNasibAktif)));
		If(Globale.PemainAktif.PelatNamaDinonaktifkan);
		Enable Nameplates(All Players(All Teams), Globale.PemainAktif);
		Globale.PemainAktif.PelatNamaDinonaktifkan = False;
		End;
		If((Globale.PemainAktif.TeksDunia != Null));
		Destroy In-World Text(Globale.PemainAktif.TeksDunia);
		End;
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif) >= 0));
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif) < Count Of(Globale.TeksDuniaPemain)));
		Globale.TeksDuniaPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif)] = 0;
		End;
		End;
		Globale.PemainAktif.TeksDunia = Null;
		Globale.PemainAktif.TargetInspeksi = Null;
		Globale.PemainAktif.DaftarTargetInspeksi = Empty Array;
		Globale.PemainAktif.InspeksiAktif = False;
		End;
	}
}

regola("89b2 - Subrutin: Rawat bot 10 Hz dan target ikuti 5 Hz")
{
	evento
	{
		Subroutine;
		ProsesBotPemain;
	}

	azioni
	{
		If(((Globale.LangkahPenjadwal % 4) == (Slot Of(Globale.PemainAktif) % 4)));
		If(And(Is Dummy Bot(Globale.PemainAktif), And(Has Spawned(Globale.PemainAktif), Is Alive(Globale.PemainAktif))));
		Set Player Variable(Globale.PemainAktif, DaftarTargetInspeksi, Filtered Array(Globale.PemainManusia, And(Entity Exists(Current Array Element), And(Player Variable(Current Array Element, Manusia), And(Player Variable(Current Array Element, IzinkanBotBuatanMengikuti), And(Has Spawned(Current Array Element), And(Is Alive(Current Array Element), (Team Of(Current Array Element) == Opposite Team Of(Team Of(Globale.PemainAktif))))))))));
		If((Count Of(Globale.PemainAktif.DaftarTargetInspeksi) > 0));
		Set Player Variable(Globale.PemainAktif, TargetIkutiBotBuatan, First Of(Sorted Array(Globale.PemainAktif.DaftarTargetInspeksi, Distance Between(Globale.PemainAktif, Current Array Element))));
		Else;
		Set Player Variable(Globale.PemainAktif, TargetIkutiBotBuatan, Null);
		End;
		End;
		End;
		If(And(Globale.PemainAktif.PindahTimDiproses, And(Globale.PemainAktif.BotOtomatis, And(Globale.PemainAktif.SudahDiperiksa, And(Has Spawned(Globale.PemainAktif), And(Is Alive(Globale.PemainAktif), Globale.PemainAktif.KunciBotAktif))))));
		Globale.PemainAktif.PindahTimDiproses = False;
		Globale.PemainAktif.SiklusPemainAktif = False;
		Globale.PemainAktif.WaktuSiklusTim = 0;
		If((Globale.PemainSiklusGlobal == Globale.PemainAktif));
		Globale.PemainSiklusGlobal = Null;
		Globale.WaktuSiklusGlobal = (Total Time Elapsed + 0.250);
		End;
		End;
		If(And(Globale.Siap, And(Or(Is Dummy Bot(Globale.PemainAktif), Globale.PemainAktif.BotOtomatis), And(Globale.PemainAktif.KunciBotAktif, Or(Not(Has Spawned(Globale.PemainAktif)), Not(Is Alive(Globale.PemainAktif)))))));
		Globale.PemainAktif.KunciBotAktif = False;
		End;
	}
}

regola("89c - Subrutin: Proses simpanan pemain 1 Hz")
{
	evento
	{
		Subroutine;
		ProsesSimpananPemain;
	}

	azioni
	{
		If(And(Globale.PemainAktif.Manusia, Entity Exists(Globale.PemainAktif)));
		If(Globale.PemainAktif.IzinkanBotBuatanMengikuti);
		If(Not(Is True For Any(All Players(Opposite Team Of(Team Of(Globale.PemainAktif))), And(Entity Exists(Current Array Element), Is Dummy Bot(Current Array Element)))));
		Set Player Variable(Globale.PemainAktif, IzinkanBotBuatanMengikuti, False);
		End;
		End;
		If(And(Globale.PemainAktif.MenuTerbuka, (Globale.PemainAktif.HalamanMenu == 1)));
		If(And((Globale.PemainAktif.KursorKamera >= 2), ((Globale.PemainAktif.KursorKamera - 2) < Count Of(Globale.PemainAktif.DaftarTargetKamera))));
		Set Player Variable(Globale.PemainAktif, CalonTargetKamera, Globale.PemainAktif.DaftarTargetKamera[(Globale.PemainAktif.KursorKamera - 2)]);
		Else;
		Set Player Variable(Globale.PemainAktif, CalonTargetKamera, Null);
		End;
		Call Subroutine(SegarkanTargetPublikAktif);
		Set Player Variable(Globale.PemainAktif, DaftarTargetKamera, Globale.PemainAktif.DaftarTargetInspeksi);
		If(And((Globale.PemainAktif.CalonTargetKamera != Null), Array Contains(Globale.PemainAktif.DaftarTargetKamera, Globale.PemainAktif.CalonTargetKamera)));
		Set Player Variable(Globale.PemainAktif, KursorKamera, (Index Of Array Value(Globale.PemainAktif.DaftarTargetKamera, Globale.PemainAktif.CalonTargetKamera) + 2));
		Else If((Globale.PemainAktif.KursorKamera >= (Count Of(Globale.PemainAktif.DaftarTargetKamera) + 2)));
		Set Player Variable(Globale.PemainAktif, KursorKamera, 0);
		End;
		End;
		If(And(Globale.PemainAktif.MenuTerbuka, (Globale.PemainAktif.HalamanMenu == 4)));
		If((Globale.PemainAktif.KursorBalasDendam < Count Of(Globale.PemainAktif.DaftarTargetBalasDendam)));
		Set Player Variable(Globale.PemainAktif, TargetBalasDendamDipilih, Globale.PemainAktif.DaftarTargetBalasDendam[Globale.PemainAktif.KursorBalasDendam]);
		Else;
		Set Player Variable(Globale.PemainAktif, TargetBalasDendamDipilih, Null);
		End;
		Set Player Variable(Globale.PemainAktif, DaftarTargetBalasDendam, Filtered Array(Globale.PemainManusia, (Current Array Element != Globale.PemainAktif)));
		If((Count Of(Globale.PemainAktif.DaftarTargetBalasDendam) == 0));
		Set Player Variable(Globale.PemainAktif, KursorBalasDendam, 0);
		Else If(And((Globale.PemainAktif.TargetBalasDendamDipilih != Null), Array Contains(Globale.PemainAktif.DaftarTargetBalasDendam, Globale.PemainAktif.TargetBalasDendamDipilih)));
		Set Player Variable(Globale.PemainAktif, KursorBalasDendam, Index Of Array Value(Globale.PemainAktif.DaftarTargetBalasDendam, Globale.PemainAktif.TargetBalasDendamDipilih));
		Else If((Globale.PemainAktif.KursorBalasDendam >= Count Of(Globale.PemainAktif.DaftarTargetBalasDendam)));
		Set Player Variable(Globale.PemainAktif, KursorBalasDendam, 0);
		End;
		End;
		End;
	}
}

regola("89d - Subrutin: Proses mesin status Coba Nasib")
{
	evento
	{
		Subroutine;
		ProsesNasibPemain;
	}

	azioni
	{
		If(And(Globale.PemainAktif.Manusia, And(Globale.PemainAktif.KartuNasibAktif, And(Has Spawned(Globale.PemainAktif), Is Alive(Globale.PemainAktif)))));
		If(And(((Globale.LangkahPenjadwal % 4) == (Globale.PemainAktif.UrutanHUD % 4)), And((Globale.PemainAktif.PutaranKartuNasib > 0), (Total Time Elapsed >= Globale.PemainAktif.WaktuPutaranNasibBerikut))));
		If((Globale.PemainAktif.IkonKartuNasib != Null));
		Destroy Icon(Globale.PemainAktif.IkonKartuNasib);
		End;
		Globale.PemainAktif.EfekNasib = Random Integer(1, 6);
		If((Globale.PemainAktif.EfekNasib == 1));
		Create Icon(Globale.PemainManusia, Update Every Frame((Eye Position(Evaluate Once(Globale.PemainAktif)) + (Facing Direction Of(Evaluate Once(Globale.PemainAktif)) * 4))), Eye, Visible To and Position, Color(Aqua), True);
		Else If((Globale.PemainAktif.EfekNasib == 2));
		Create Icon(Globale.PemainManusia, Update Every Frame((Eye Position(Evaluate Once(Globale.PemainAktif)) + (Facing Direction Of(Evaluate Once(Globale.PemainAktif)) * 4))), Dizzy, Visible To and Position, Color(Violet), True);
		Else If((Globale.PemainAktif.EfekNasib == 3));
		Create Icon(Globale.PemainManusia, Update Every Frame((Eye Position(Evaluate Once(Globale.PemainAktif)) + (Facing Direction Of(Evaluate Once(Globale.PemainAktif)) * 4))), Skull, Visible To and Position, Custom Color(255, 70, 70, 255), True);
		Else If((Globale.PemainAktif.EfekNasib == 4));
		Create Icon(Globale.PemainManusia, Update Every Frame((Eye Position(Evaluate Once(Globale.PemainAktif)) + (Facing Direction Of(Evaluate Once(Globale.PemainAktif)) * 4))), Heart, Visible To and Position, Custom Color(70, 255, 110, 255), True);
		Else If((Globale.PemainAktif.EfekNasib == 5));
		Create Icon(Globale.PemainManusia, Update Every Frame((Eye Position(Evaluate Once(Globale.PemainAktif)) + (Facing Direction Of(Evaluate Once(Globale.PemainAktif)) * 4))), Fire, Visible To and Position, Color(Orange), True);
		Else;
		Create Icon(Globale.PemainManusia, Update Every Frame((Eye Position(Evaluate Once(Globale.PemainAktif)) + (Facing Direction Of(Evaluate Once(Globale.PemainAktif)) * 4))), Poison 2, Visible To and Position, Custom Color(170, 80, 255, 255), True);
		End;
		Globale.PemainAktif.IkonKartuNasib = Last Created Entity;
		If(Array Contains(Globale.PemainManusia, Globale.PemainAktif));
		Globale.IkonKartuNasibPemain[Globale.SlotHUDPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif)]] = Globale.PemainAktif.IkonKartuNasib;
		End;
		Modify Player Variable(Globale.PemainAktif, PutaranKartuNasib, Subtract, 1);
		Globale.PemainAktif.WaktuPutaranNasibBerikut = (Total Time Elapsed + Globale.PemainAktif.JedaKartuNasib);
		Modify Player Variable(Globale.PemainAktif, JedaKartuNasib, Add, 0.045);
		End;
		If(And((Globale.PemainAktif.PutaranKartuNasib == 0), And((Globale.PemainAktif.WaktuIkonNasibBerakhir == 0), And((Globale.PemainAktif.WaktuPutaranNasibBerikut > 0), (Total Time Elapsed >= Globale.PemainAktif.WaktuPutaranNasibBerikut)))));
		Globale.PemainAktif.EfekNasibBerakhir = 0;
		Globale.PemainAktif.WaktuBakarNasibBerikut = 0;
		Globale.PemainAktif.MenuNasibHarusDibuka = False;
		If(Or(Or((Globale.PemainAktif.EfekNasib == 1), (Globale.PemainAktif.EfekNasib == 2)), Or((Globale.PemainAktif.EfekNasib == 5), (Globale.PemainAktif.EfekNasib == 6))));
		If((Globale.PemainAktif.HudMenu != Null));
		Destroy HUD Text(Globale.PemainAktif.HudMenu);
		End;
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif) >= 0));
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif) < Count Of(Globale.HudMenuPemain)));
		Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif)] = 0;
		End;
		End;
		Globale.PemainAktif.HudMenu = Null;
		Globale.PemainAktif.MenuTerbuka = False;
		Globale.PemainAktif.MasukanMenuDikunci = False;
		Globale.PemainAktif.PerintahMenu = 0;
		Globale.PemainAktif.HalamanMenu = -1;
		Allow Button(Globale.PemainAktif, Button(Primary Fire));
		Allow Button(Globale.PemainAktif, Button(Secondary Fire));
		Allow Button(Globale.PemainAktif, Button(Interact));
		Allow Button(Globale.PemainAktif, Button(Reload));
		Allow Button(Globale.PemainAktif, Button(Ability 1));
		Allow Button(Globale.PemainAktif, Button(Ability 2));
		Allow Button(Globale.PemainAktif, Button(Ultimate));
		End;
		If((Globale.PemainAktif.EfekNasib == 1));
		Globale.PemainAktif.PrivasiNasibAktif = True;
		Globale.PemainAktif.EfekNasibBerakhir = (Total Time Elapsed + 15);
		Small Message(Globale.PemainAktif, ((Globale.PemainAktif.IndeksBahasa == 0) ? Custom String("TRY YOUR LUCK: ALL PLAYER/BOT NAMES — 15s") : ((Globale.PemainAktif.IndeksBahasa == 1) ? Custom String("COBA NASIB: NAMA SEMUA PEMAIN / BOT — 15 dtk") : Custom String("เสี่ยงโชค: เห็นชื่อผู้เล่น/บอตทั้งหมด — 15 วิ"))));
		Else If((Globale.PemainAktif.EfekNasib == 2));
		Set Move Speed(Globale.PemainAktif, 1000);
		Start Accelerating(Evaluate Once(Globale.PemainAktif), Facing Direction Of(Evaluate Once(Globale.PemainAktif)), 50, 25, To World, Direction Rate and Max Speed);
		Globale.PemainAktif.EfekNasibBerakhir = (Total Time Elapsed + 10);
		Small Message(Globale.PemainAktif, ((Globale.PemainAktif.IndeksBahasa == 0) ? (Globale.PemainAktif.ModeTerbangAktif ? Custom String("TRY YOUR LUCK: FLIGHT BOOST — 10s") : Custom String("TRY YOUR LUCK: AIM-STEERED ACCELERATION — 10s")) : ((Globale.PemainAktif.IndeksBahasa == 1) ? (Globale.PemainAktif.ModeTerbangAktif ? Custom String("COBA NASIB: TERBANG MAKIN NGEBUT — 10 dtk") : Custom String("COBA NASIB: AKSELERASI SESUAI BIDIKAN — 10 dtk")) : (Globale.PemainAktif.ModeTerbangAktif ? Custom String("เสี่ยงโชค: บินไวขึ้น! — 10 วิ") : Custom String("เสี่ยงโชค: เร่งตามทิศเล็ง — 10 วิ")))));
		Else If((Globale.PemainAktif.EfekNasib == 3));
		Small Message(Globale.PemainAktif, ((Globale.PemainAktif.IndeksBahasa == 0) ? Custom String("TRY YOUR LUCK: SKULL") : ((Globale.PemainAktif.IndeksBahasa == 1) ? Custom String("COBA NASIB: TENGKORAK") : Custom String("เสี่ยงโชค: กะโหลก"))));
		Globale.PemainAktif.WaktuPaksaBerikut = Total Time Elapsed;
		Globale.PemainAktif.WaktuPaksaBerakhir = (Total Time Elapsed + 5);
		Else If((Globale.PemainAktif.EfekNasib == 4));
		Set Player Health(All Living Players(Team Of(Globale.PemainAktif)), 9999);
		Small Message(Globale.PemainAktif, ((Globale.PemainAktif.IndeksBahasa == 0) ? Custom String("TRY YOUR LUCK: HEART — FULL TEAM HEAL") : ((Globale.PemainAktif.IndeksBahasa == 1) ? Custom String("COBA NASIB: HATI — HP TIM PENUH!") : Custom String("เสี่ยงโชค: หัวใจ — ฮีลเต็มทั้งทีม!"))));
		Globale.PemainAktif.EfekNasib = 0;
		Globale.PemainAktif.KartuNasibAktif = False;
		Else If((Globale.PemainAktif.EfekNasib == 5));
		Set Status(Globale.PemainAktif, Null, Burning, 10);
		Clear Status(Globale.PemainAktif, Unkillable);
		Set Damage Received(Globale.PemainAktif, 100);
		Globale.PemainAktif.EfekNasibBerakhir = (Total Time Elapsed + 10);
		Globale.PemainAktif.WaktuBakarNasibBerikut = Total Time Elapsed;
		Small Message(Globale.PemainAktif, ((Globale.PemainAktif.IndeksBahasa == 0) ? Custom String("TRY YOUR LUCK: BURNING — 5% MAX HP/s — 10s") : ((Globale.PemainAktif.IndeksBahasa == 1) ? Custom String("COBA NASIB: TERBAKAR — 5% HP MAKS / DTK — 10 dtk") : Custom String("เสี่ยงโชค: ไฟไหม้! — 5% HP สูงสุด/วิ — 10 วิ"))));
		Else;
		Set Status(Globale.PemainAktif, Null, Hacked, 5);
		Globale.PemainAktif.EfekNasibBerakhir = (Total Time Elapsed + 5);
		Small Message(Globale.PemainAktif, ((Globale.PemainAktif.IndeksBahasa == 0) ? Custom String("TRY YOUR LUCK: HACKED — 5s") : ((Globale.PemainAktif.IndeksBahasa == 1) ? Custom String("COBA NASIB: DIRETAS — 5 dtk") : Custom String("เสี่ยงโชค: โดนแฮ็ก! — 5 วิ"))));
		End;
		Globale.PemainAktif.WaktuPutaranNasibBerikut = 0;
		Globale.PemainAktif.WaktuIkonNasibBerakhir = (Total Time Elapsed + 1);
		End;
		End;
		If(Globale.PemainAktif.Manusia);
		If((Globale.PemainAktif.EfekNasib == 5));
		If((Globale.PemainAktif.EfekNasibBerakhir > Total Time Elapsed));
		If((Globale.PemainAktif.WaktuBakarNasibBerikut <= Total Time Elapsed));
		If(Has Spawned(Globale.PemainAktif));
		If(Is Alive(Globale.PemainAktif));
		Clear Status(Globale.PemainAktif, Unkillable);
		Set Damage Received(Globale.PemainAktif, 100);
		Damage(Globale.PemainAktif, Globale.PemainAktif, (Max Health(Globale.PemainAktif) * 0.050));
		Globale.PemainAktif.WaktuBakarNasibBerikut = (Total Time Elapsed + 1.000);
		End;
		End;
		End;
		End;
		End;
		End;
		If(Globale.PemainAktif.Manusia);
		If(Globale.PemainAktif.KartuNasibAktif);
		If((Globale.PemainAktif.PutaranKartuNasib == 0));
		If((Globale.PemainAktif.EfekNasibBerakhir > 0));
		If((Total Time Elapsed >= Globale.PemainAktif.EfekNasibBerakhir));
		Clear Status(Globale.PemainAktif, Burning);
		Clear Status(Globale.PemainAktif, Hacked);
		If((Globale.PemainAktif.EfekNasib == 2));
		Stop Accelerating(Globale.PemainAktif);
		Set Move Speed(Globale.PemainAktif, 100);
		End;
		If((Globale.PemainAktif.HudEfekNasib != Null));
		If((Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainAktif) >= 0));
		If((Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainAktif)] == Globale.PemainAktif.HudEfekNasib));
		Destroy HUD Text(Globale.PemainAktif.HudEfekNasib);
		Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainAktif)] = 0;
		End;
		End;
		End;
		Globale.PemainAktif.HudEfekNasib = Null;
		Globale.PemainAktif.PrivasiNasibAktif = False;
		Globale.PemainAktif.EfekNasib = 0;
		Globale.PemainAktif.EfekNasibBerakhir = 0;
		Globale.PemainAktif.WaktuBakarNasibBerikut = 0;
		Globale.PemainAktif.KartuNasibAktif = False;
		Globale.PemainAktif.MenuNasibHarusDibuka = True;
		End;
		End;
		End;
		End;
		End;
		If((Globale.PemainAktif.WaktuIkonNasibBerakhir > 0));
		If((Total Time Elapsed >= Globale.PemainAktif.WaktuIkonNasibBerakhir));
		If((Globale.PemainAktif.IkonKartuNasib != Null));
		Destroy Icon(Globale.PemainAktif.IkonKartuNasib);
		End;
		Globale.PemainAktif.IkonKartuNasib = Null;
		If(Array Contains(Globale.PemainManusia, Globale.PemainAktif));
		Globale.IkonKartuNasibPemain[Globale.SlotHUDPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif)]] = 0;
		End;
		Globale.PemainAktif.WaktuIkonNasibBerakhir = 0;
		If(Not(Globale.PemainAktif.KartuNasibAktif));
		If(Not(Globale.PemainAktif.MenuTerbuka));
		Globale.PemainAktif.MenuNasibHarusDibuka = True;
		End;
		End;
		End;
		End;
	}
}

regola("90 - Subrutin: Tutup menu dan pulihkan tombol")
{
	evento
	{
		Subroutine;
		TutupMenu;
	}

	azioni
	{
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) >= 0));
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) < Count Of(Globale.HudMenuPemain)));
		If((Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)] != 0));
		Destroy HUD Text(Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)]);
		If((Globale.PemainPemicu.HudMenu == Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)]));
		Globale.PemainPemicu.HudMenu = Null;
		End;
		End;
		Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)] = 0;
		End;
		End;
		If((Globale.PemainPemicu.HudMenu != Null));
		Destroy HUD Text(Globale.PemainPemicu.HudMenu);
		End;
		Globale.PemainPemicu.HudMenu = Null;
		Globale.PemainPemicu.MenuTerbuka = False;
		Globale.PemainPemicu.PerintahMenu = 0;
		Globale.PemainPemicu.HalamanMenu = -1;
		If(Is Button Held(Globale.PemainPemicu, Button(Melee)));
		Globale.PemainPemicu.SeranganDekatDipakai = True;
		Else;
		Allow Button(Globale.PemainPemicu, Button(Melee));
		Globale.PemainPemicu.SeranganDekatDipakai = False;
		End;
		Allow Button(Globale.PemainPemicu, Button(Jump));
		Allow Button(Globale.PemainPemicu, Button(Crouch));
		Allow Button(Globale.PemainPemicu, Button(Primary Fire));
		Allow Button(Globale.PemainPemicu, Button(Secondary Fire));
		Allow Button(Globale.PemainPemicu, Button(Interact));
		Allow Button(Globale.PemainPemicu, Button(Reload));
		Allow Button(Globale.PemainPemicu, Button(Ability 1));
		Allow Button(Globale.PemainPemicu, Button(Ability 2));
		Allow Button(Globale.PemainPemicu, Button(Ultimate));
	}
}

regola("91 - Subrutin: Gambar satu HUD menu aktif")
{
	evento
	{
		Subroutine;
		GambarMenu;
	}

	azioni
	{
		If((Globale.PemainPemicu.HudMenu != Null));
		Destroy HUD Text(Globale.PemainPemicu.HudMenu);
		Globale.PemainPemicu.HudMenu = Null;
		End;
		Call Subroutine(GambarHalamanAktif);
		Call Subroutine(TransisiWarnaMenu);
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) >= 0));
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) < Count Of(Globale.HudMenuPemain)));
		Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)] = Globale.PemainPemicu.HudMenu;
		End;
		End;
	}
}

