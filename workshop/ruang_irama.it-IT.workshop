		Disallow Button(Globale.PemainPemicu, Button(Interact));
		Call Subroutine(TransisiWarnaMenu);
		Call Subroutine(GambarTeleportasi);
	}
}

regola("19a - Teleportasi Jongkok: Tembak utama maju, sekunder mundur, Interaksi jalankan")
{
	evento
	{
		Subroutine;
		Pengatur19a;
	}

	azioni
	{
		Abort If(Not(And(Not(Globale.PemainPemicu.PindahTimDiproses), And(Not(Globale.PemainPemicu.SiklusPemainAktif), And(Globale.PemainPemicu.TeleportasiJongkokAktif, And((Globale.PemainPemicu.PerintahTeleportasi == 0), And(Is Button Held(Globale.PemainPemicu, Button(Crouch)), Or(Or(Is Button Held(Globale.PemainPemicu, Button(Primary Fire)), Is Button Held(Globale.PemainPemicu, Button(Secondary Fire))), Is Button Held(Globale.PemainPemicu, Button(Interact))))))))));
		If(Is Button Held(Globale.PemainPemicu, Button(Primary Fire)));
