		Event Giocatore.HudMenu = Last Text ID;
	}
}

regola("91n - Subrutin: Gambar kartu nasib")
{
	evento
	{
		Subroutine;
		GambarNasib;
	}

	azioni
	{
		Create HUD Text(Event Giocatore, Null, Event Giocatore.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String("Hold CROUCH + command\n{0}: create | {1}: back", Input Binding String(Button(Interagisci)), Input Binding String(Button(Reload))), Custom String("Hold {0} 0.5 sec: close", Input Binding String(Button(Melee)))) : Event Giocatore.IndeksBahasa == 1 ? Custom String("{0}\n{1}", Custom String("Tahan JONGKOK + perintah\n{0}: buat | {1}: kembali", Input Binding String(Button(Interagisci)), Input Binding String(Button(Reload))), Custom String("Tahan {0} 0,5 dtk: tutup", Input Binding String(Button(Melee)))) : Custom String("{0}\n{1}", Custom String("กด ย่อ + คำสั่ง\n{0}: สร้าง | {1}: กลับ", Input Binding String(Button(Interagisci)), Input Binding String(Button(Reload))), Custom String("กด {0} ค้าง 0.5 วิ: ปิด", Input Binding String(Button(Melee)))), Event Giocatore.IndeksBahasa == 0 ? Custom String("10 - TRY YOUR LUCK\nSTATUS: {0}\n> {1}", Event Giocatore.KartuNasibAktif ? Event Giocatore.PutaranKartuNasib > 0 ? Custom String("ROLLING") : Custom String("ACTIVE") : Custom String("READY"), Event Giocatore.KartuNasibAktif ? Custom String("WATCH THE ROULETTE") : Custom String("START ROULETTE")) : Event Giocatore.IndeksBahasa == 1 ? Custom String("10 - COBA NASIB\nSTATUS: {0}\n> {1}", Event Giocatore.KartuNasibAktif ? Event Giocatore.PutaranKartuNasib > 0 ? Custom String("BERPUTAR") : Custom String("AKTIF") : Custom String("SIAP"), Event Giocatore.KartuNasibAktif ? Custom String("LIHAT ROULETTE") : Custom String("MULAI ROULETTE")) : Custom String("10 - เสี่ยงโชค\nสถานะ: {0}\n> {1}", Event Giocatore.KartuNasibAktif ? Event Giocatore.PutaranKartuNasib > 0 ? Custom String("กำลังสุ่ม") : Custom String("ทำงาน") : Custom String("พร้อม"), Event Giocatore.KartuNasibAktif ? Custom String("ดูรูเล็ต") : Custom String("เริ่มรูเล็ต")), Top, 100, Color(Bianco), Custom Color(255, 240, 190, 255), Custom Color(X Component Of(Event Giocatore.WarnaMenu), Y Component Of(Event Giocatore.WarnaMenu), Z Component Of(Event Giocatore.WarnaMenu), 255), Visibile a  String and Color, Visibile Mai);
