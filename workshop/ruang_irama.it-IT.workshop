		Create HUD Text(Event Giocatore, Null, Event Giocatore.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String("Hold CROUCH + command\n{0}: next | {1}: previous", Input Binding String(Button(Fuoco Primario)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: apply | {1}: back", Input Binding String(Button(Interagisci)), Input Binding String(Button(Reload)))) : Event Giocatore.IndeksBahasa == 1 ? Custom String("{0}\n{1}", Custom String("Tahan JONGKOK + perintah\n{0}: berikutnya | {1}: sebelumnya", Input Binding String(Button(Fuoco Primario)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: pakai | {1}: kembali", Input Binding String(Button(Interagisci)), Input Binding String(Button(Reload)))) : Custom String("{0}\n{1}", Custom String("กด ย่อ + คำสั่ง\n{0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Fuoco Primario)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: ใช้ | {1}: กลับ", Input Binding String(Button(Interagisci)), Input Binding String(Button(Reload)))), Event Giocatore.IndeksBahasa == 0 ? Custom String("{0}\n> {1}", Custom String("9 - CROUCH PRIVACY {0}/2\nHIDE INFO + BLOCK CUSTOM CAMERA: {1}", Event Giocatore.KursorPrivasiInspeksi + 1, Event Giocatore.PrivasiInspeksiAktif ? Custom String("ON") : Custom String("OFF")), Event Giocatore.KursorPrivasiInspeksi == 1 ? Custom String("ON") : Custom String("OFF")) : Event Giocatore.IndeksBahasa == 1 ? Custom String("{0}\n> {1}", Custom String("9 - PRIVASI JONGKOK {0}/2\nSEMBUNYIKAN INFO + BLOKIR KAMERA KUSTOM: {1}", Event Giocatore.KursorPrivasiInspeksi + 1, Event Giocatore.PrivasiInspeksiAktif ? Custom String("AKTIF") : Custom String("MATI")), Event Giocatore.KursorPrivasiInspeksi == 1 ? Custom String("AKTIF") : Custom String("MATI")) : Custom String("{0}\n> {1}", Custom String("9 - ความเป็นส่วนตัวตอนย่อ {0}/2\nซ่อนข้อมูล + บล็อกกล้องกำหนดเอง: {1}", Event Giocatore.KursorPrivasiInspeksi + 1, Event Giocatore.PrivasiInspeksiAktif ? Custom String("เ