		If((Distance Between(Ray Cast Hit Position((Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 0.250, 0)), (Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 2.500, 0)), Empty Array, Empty Array, False), (Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 0.250, 0))) < 2.000));
		Globale.PemainPemicu.PosisiBangkitAman = Vector(0, 0, 0);
