		Abort If((Globale.PeristiwaAktif[20] != Globale.PemainPemicu.StatusPengatur[36]));
		Abort If((Globale.PeristiwaAktif[21] != (Globale.PemainPemicu.Manusia ? Globale.PemainPemicu.NamaTampilan : Custom String("{0}", Globale.PemainPemicu))));
		Abort If(Or(Globale.PemainPemicu.SiklusPemainAktif, (Globale.PemainPemicu.TimTerakhir != Team Of(Globale.PemainPemicu))));
		Abort If((Hero Of(Globale.PemainPemicu) != Globale.PeristiwaAktif[18]));
		Set Ultimate Charge(Globale.PemainPemicu, 100);
	}
}

regola("17 - Balas Dendam: Catat hanya pembunuh langsung")
{
	evento
	{
		Player Died;
		Tutti;
		Tutti;
		}

	condizioni
	{
		Event Player.Manusia == True;
		}

	azioni
	{
		If((Globale.JumlahPeristiwa < 256));
		Globale.AntreanPeristiwa[Globale.EkorPeristiwa] = Array(4, Event Player, Attacker, Null, Null, Null, Null, Total Time Elapsed, Event Player.KematianBalasDendam, Event Player.PenagihBalasDendam, And((Event Player.PenagihBalasDendam != Null), And(Entity Exists(Event Player.PenagihBalasDendam), Player Variable(Event Player.PenagihBalasDendam, Manusia))), Player Variable(Attacker, Manusia), Null, Null, Null, Null, Null, Not(Is Alive(Event Player)), Hero Of(Event Player), Team Of(Event Player), Event Player.StatusPengatur[36], (Event Player.Manusia ? Event Player.NamaTampilan : Custom String("{0}", Event Player)), Null, Player Variable(Event Player.PenagihBalasDendam, StatusPengatur)[36], Player Variable(Attacker, StatusPengatur)[36]);
		Globale.EkorPeristiwa = ((Globale.EkorPeristiwa + 1) % 256);
		Globale.JumlahPeristiwa += 1;
		Else;
		Globale.PeristiwaTerlewat += 1;
		End;
	}
}

regola("17 - Balas Dendam: Catat hanya pembunuh langsung global")
{
	evento
	{
		Subroutine;
		Peristiwa17;
	}

	azioni
	{
		Abort If(Not(Entity Exists(Globale.PemainPemicu)));
		Abort If((Globale.PeristiwaAktif[20] != Globale.PemainPemicu.StatusPengatur[36]));
		Abort If((Globale.PeristiwaAktif[21] != (Globale.PemainPemicu.Manusia ? Globale.PemainPemicu.NamaTampilan : Custom String("{0}", Globale.PemainPemicu))));
		Abort If(Or(Globale.PemainPemicu.SiklusPemainAktif, (Globale.PemainPemicu.TimTerakhir != Team Of(Globale.PemainPemicu))));
		If(Globale.PeristiwaAktif[8]);
		If(Globale.PeristiwaAktif[17]);
		If(And((Globale.PeristiwaAktif[9] != Null), And(And(Entity Exists(Globale.PeristiwaAktif[9]), (Player Variable(Globale.PeristiwaAktif[9], StatusPengatur)[36] == Globale.PeristiwaAktif[23])), And(Globale.PeristiwaAktif[10], (Globale.PeristiwaAktif[2] == Globale.PeristiwaAktif[9])))));
		Set Player Variable(Globale.PeristiwaAktif[9], IndeksBalasDendam, Index Of Array Value(Player Variable(Globale.PeristiwaAktif[9], PembunuhBalasDendam), Globale.PemainPemicu));
		If(And((Player Variable(Globale.PeristiwaAktif[9], IndeksBalasDendam) >= 0), (Player Variable(Globale.PeristiwaAktif[9], JumlahBalasDendam)[Player Variable(Globale.PeristiwaAktif[9], IndeksBalasDendam)] > 0)));
		Modify Player Variable At Index(Globale.PeristiwaAktif[9], JumlahBalasDendam, Player Variable(Globale.PeristiwaAktif[9], IndeksBalasDendam), Subtract, 1);
		Small Message(Globale.PeristiwaAktif[9], ((Player Variable(Globale.PeristiwaAktif[9], IndeksBahasa) == 0) ? Custom String("Revenge on {0}: paid! Still owed: {1}.", Globale.PemainPemicu, Player Variable(Globale.PeristiwaAktif[9], JumlahBalasDendam)[Player Variable(Globale.PeristiwaAktif[9], IndeksBalasDendam)]) : ((Player Variable(Globale.PeristiwaAktif[9], IndeksBahasa) == 1) ? Custom String("Balas dendam ke {0} beres! Sisa: {1}.", Globale.PemainPemicu, Player Variable(Globale.PeristiwaAktif[9], JumlahBalasDendam)[Player Variable(Globale.PeristiwaAktif[9], IndeksBalasDendam)]) : Custom String("ล้างแค้น {0} สำเร็จ! หนี้เหลือ: {1}", Globale.PemainPemicu, Player Variable(Globale.PeristiwaAktif[9], JumlahBalasDendam)[Player Variable(Globale.PeristiwaAktif[9], IndeksBalasDendam)]))));
		End;
		Set Player Variable(Globale.PeristiwaAktif[9], TargetBalasDendamTerkunci, Null);
		Globale.PemainPemicu.KematianBalasDendam = False;
		Globale.PemainPemicu.PenagihBalasDendam = Null;
		Globale.PemainPemicu.WaktuPaksaBerikut = 0;
		Globale.PemainPemicu.WaktuPaksaBerakhir = 0;
		Abort;
		End;
		If(And((Globale.PeristiwaAktif[9] != Null), And(Entity Exists(Globale.PeristiwaAktif[9]), (Player Variable(Globale.PeristiwaAktif[9], StatusPengatur)[36] == Globale.PeristiwaAktif[23]))));
		Set Player Variable(Globale.PeristiwaAktif[9], TargetBalasDendamTerkunci, Null);
		End;
		Globale.PemainPemicu.KematianBalasDendam = False;
		Globale.PemainPemicu.PenagihBalasDendam = Null;
		Globale.PemainPemicu.WaktuPaksaBerikut = 0;
		Globale.PemainPemicu.WaktuPaksaBerakhir = 0;
		Else;
		Abort;
		End;
		End;
		Abort If((Globale.PeristiwaAktif[2] == Null));
		Abort If((Globale.PeristiwaAktif[2] == Globale.PemainPemicu));
		Abort If(Not(Globale.PeristiwaAktif[11]));
		Abort If(Not(Entity Exists(Globale.PeristiwaAktif[2])));
		Abort If((Player Variable(Globale.PeristiwaAktif[2], StatusPengatur)[36] != Globale.PeristiwaAktif[24]));
		Globale.PemainPemicu.IndeksBalasDendam = Index Of Array Value(Globale.PemainPemicu.PembunuhBalasDendam, Globale.PeristiwaAktif[2]);
		If((Globale.PemainPemicu.IndeksBalasDendam < 0));
		Globale.PemainPemicu.PembunuhBalasDendam = Append To Array(Globale.PemainPemicu.PembunuhBalasDendam, Globale.PeristiwaAktif[2]);
		Globale.PemainPemicu.JumlahBalasDendam = Append To Array(Globale.PemainPemicu.JumlahBalasDendam, 1);
		Else;
		Modify Player Variable At Index(Globale.PemainPemicu, JumlahBalasDendam, Globale.PemainPemicu.IndeksBalasDendam, Add, 1);
		End;
	}
}

regola("18c - Kebal: Nonaktifkan hanya mode 1 HP di Ruang Muncul")
{
	evento
	{
		Subroutine;
		Pengatur18c;
	}

	azioni
	{
		Abort If(Not(And((Globale.PemainPemicu.ModeKebal == 1), Is In Spawn Room(Globale.PemainPemicu))));
		Globale.PemainPemicu.KebalAktif = False;
		Globale.PemainPemicu.ModeKebal = 0;
		Globale.PemainPemicu.KursorKebal = 1;
		Clear Status(Globale.PemainPemicu, Unkillable);
		Set Damage Received(Globale.PemainPemicu, 100);
		Set Knockback Received(Globale.PemainPemicu, 100);
		Enable Movement Collision With Players(Globale.PemainPemicu);
		If(Is Alive(Globale.PemainPemicu));
		Set Player Health(Globale.PemainPemicu, Max Health(Globale.PemainPemicu));
		End;
		If((Globale.PemainPemicu.IkonKebal != Null));
		Destroy Icon(Globale.PemainPemicu.IkonKebal);
		Globale.PemainPemicu.IkonKebal = Null;
		If(Array Contains(Globale.PemainManusia, Globale.PemainPemicu));
		Globale.IkonKebalPemain[Globale.SlotHUDPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)]] = 0;
		End;
		End;
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Unkillable: 1 HP (HEALABLE) off in Spawn Room.") : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Kebal 1 HP dimatikan di ruang muncul.") : Custom String("ปิดโหมด 1 HP (ฮีลได้) ในห้องเกิดแล้ว"))));
	}
}

