regola("91p - Subrutin: Gambar halaman aktif")
{
	evento
	{
		Subroutine;
		GambarHalamanAktif;
	}

	azioni
	{
		If((Globale.PemainPemicu.HalamanMenu == -1));
		Call Subroutine(GambarUtama);
		Else If((Globale.PemainPemicu.HalamanMenu == 0));
		Call Subroutine(GambarWarna);
		Else If((Globale.PemainPemicu.HalamanMenu == 1));
		Call Subroutine(GambarKamera);
		Else If((Globale.PemainPemicu.HalamanMenu == 2));
		Call Subroutine(GambarMusik);
		Else If((Globale.PemainPemicu.HalamanMenu == 3));
		Call Subroutine(GambarBahasa);
		Else If((Globale.PemainPemicu.HalamanMenu == 4));
		Call Subroutine(GambarBalasDendam);
		Else If((Globale.PemainPemicu.HalamanMenu == 5));
		Call Subroutine(GambarKebal);
		Else If((Globale.PemainPemicu.HalamanMenu == 6));
		Call Subroutine(GambarSuara);
		Else If((Globale.PemainPemicu.HalamanMenu == 7));
		Call Subroutine(GambarIkon);
		Else If((Globale.PemainPemicu.HalamanMenu == 10));
		Call Subroutine(GambarNasib);
		Else If((Globale.PemainPemicu.HalamanMenu == 11));
		Call Subroutine(GambarPilihan);
		Else If((Globale.PemainPemicu.HalamanMenu == 13));
		Call Subroutine(GambarHantuTerbang);
		Else If((Globale.PemainPemicu.HalamanMenu == 14));
		Call Subroutine(GambarLompatGanda);
		End;
	}
}

regola("91k - Subrutin: Transisi warna menu tanpa lompatan")
{
	evento
	{
		Subroutine;
		TransisiWarnaMenu;
	}

	azioni
	{
		If(Globale.PemainPemicu.TeleportasiJongkokAktif);
		Chase Player Variable Over Time(Evaluate Once(Globale.PemainPemicu), WarnaMenu, ((Player Variable(Evaluate Once(Globale.PemainPemicu), KursorTeleportasi) == 0) ? Vector(80, 255, 160) : ((Player Variable(Evaluate Once(Globale.PemainPemicu), KursorTeleportasi) == 1) ? Vector(65, 225, 255) : ((Player Variable(Evaluate Once(Globale.PemainPemicu), KursorTeleportasi) == 2) ? Vector(95, 150, 255) : ((Player Variable(Evaluate Once(Globale.PemainPemicu), KursorTeleportasi) == 3) ? Vector(195, 100, 255) : Vector(255, 85, 135))))), 0.180, Destination and Duration);
		Else;
		Chase Player Variable Over Time(Evaluate Once(Globale.PemainPemicu), WarnaMenu, ((((Player Variable(Evaluate Once(Globale.PemainPemicu), HalamanMenu) == -1) ? Player Variable(Evaluate Once(Globale.PemainPemicu), KursorUtama) : Player Variable(Evaluate Once(Globale.PemainPemicu), HalamanMenu)) == 0) ? Globale.DaftarWarnaRGB[Player Variable(Evaluate Once(Globale.PemainPemicu), KursorWarna)] : (And((((Player Variable(Evaluate Once(Globale.PemainPemicu), HalamanMenu) == -1) ? Player Variable(Evaluate Once(Globale.PemainPemicu), KursorUtama) : Player Variable(Evaluate Once(Globale.PemainPemicu), HalamanMenu)) >= 1), (((Player Variable(Evaluate Once(Globale.PemainPemicu), HalamanMenu) == -1) ? Player Variable(Evaluate Once(Globale.PemainPemicu), KursorUtama) : Player Variable(Evaluate Once(Globale.PemainPemicu), HalamanMenu)) <= 15)) ? ((Globale.DaftarWarnaRGB[Player Variable(Evaluate Once(Globale.PemainPemicu), IndeksWarna)] * 0.680) + (Array(Vector(0, 0, 0), Vector(190, 210, 230), Vector(100, 110, 120), Vector(0, 0, 0), Vector(255, 245, 215), Vector(255, 200, 70), Vector(236, 153, 0), Vector(255, 120, 105), Vector(255, 75, 75), Vector(255, 50, 145), Vector(205, 160, 255), Vector(100, 50, 255), Vector(70, 145, 255), Vector(0, 234, 234), Vector(70, 220, 110), Vector(65, 155, 110))[((Player Variable(Evaluate Once(Globale.PemainPemicu), HalamanMenu) == -1) ? Player Variable(Evaluate Once(Globale.PemainPemicu), KursorUtama) : Player Variable(Evaluate Once(Globale.PemainPemicu), HalamanMenu))] * 0.320)) : Globale.DaftarWarnaRGB[Player Variable(Evaluate Once(Globale.PemainPemicu), IndeksWarna)])), 0.180, Destination and Duration);
		End;
	}
}

regola("92 - Subrutin: Kunci bot, kaki tetap bisa bergerak")
{
	evento
	{
		Subroutine;
		KunciBot;
	}

	azioni
	{
		Abort If(Not(Entity Exists(Globale.PemainPemicu)));
		Abort If(Not(Is Alive(Globale.PemainPemicu)));
		Globale.PemainPemicu.MenuTerbuka = False;
		Globale.PemainPemicu.SeranganDekatDipakai = False;
		Globale.PemainPemicu.HalamanMenu = -1;
		Set Primary Fire Enabled(Globale.PemainPemicu, False);
		Set Secondary Fire Enabled(Globale.PemainPemicu, False);
		Set Ability 1 Enabled(Globale.PemainPemicu, False);
		Set Ability 2 Enabled(Globale.PemainPemicu, False);
		Set Ultimate Ability Enabled(Globale.PemainPemicu, False);
		Set Melee Enabled(Globale.PemainPemicu, False);
		Disallow Button(Globale.PemainPemicu, Button(Primary Fire));
		Disallow Button(Globale.PemainPemicu, Button(Secondary Fire));
		Disallow Button(Globale.PemainPemicu, Button(Ability 1));
		Disallow Button(Globale.PemainPemicu, Button(Ability 2));
		Disallow Button(Globale.PemainPemicu, Button(Ultimate));
		Disallow Button(Globale.PemainPemicu, Button(Melee));
		Disallow Button(Globale.PemainPemicu, Button(Jump));
		Disallow Button(Globale.PemainPemicu, Button(Reload));
		Disallow Button(Globale.PemainPemicu, Button(Interact));
		Set Damage Dealt(Globale.PemainPemicu, 0);
		Set Healing Dealt(Globale.PemainPemicu, 0);
		Set Knockback Dealt(Globale.PemainPemicu, 0);
		Set Damage Received(Globale.PemainPemicu, 100);
		Set Knockback Received(Globale.PemainPemicu, 100);
		Set Move Speed(Globale.PemainPemicu, 20);
		Globale.PemainPemicu.PahlawanTerakhir = Hero Of(Globale.PemainPemicu);
		Globale.PemainPemicu.TargetIkutiBotBuatan = Null;
		Globale.PemainPemicu.KunciBotAktif = True;
		Disable Nameplates(Globale.PemainPemicu, Filtered Array(Globale.PemainManusia, Player Variable(Current Array Element, PelatNamaDinonaktifkan)));
	}
}

