regola("18k - Nasib: HUD efek dan durasi saat menu tertutup")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.Manusia == True;
		Event Giocatore.KartuNasibAktif == True;
		Event Giocatore.PutaranKartuNasib == 0;
		Event Giocatore.EfekNasibBerakhir > 0;
		Event Giocatore.HudEfekNasib == Null;
		Is Vivo(Event Giocatore) == True;
	}

	azioni
	{
		Create HUD Text(Event Giocatore, Null, Null, Event Giocatore.IndeksBahasa == 0 ? Custom String("\n{0}\n{1}", Event Giocatore.EfekNasib == 1 ? Custom String("VISION: OTHER PLAYER / BOT NAMES") : Event Giocatore.EfekNasib == 2 ? Custom String("AIM-STEERED ACCELERATION") : Event Giocatore.EfekNasib == 5 ? Custom String("BURNING: 5% MAX HP / SEC") : Custom String("HACKED"), Custom String("{0}s REMAINING", Massimo(0, Round To Integer(Event Giocatore.EfekNasibBerakhir - Totale Tempo Elapsed, Su)))) : Event Giocatore.IndeksBahasa == 1 ? Custom String("\n{0}\n{1}", Event Giocatore.EfekNasib == 1 ? Custom String("VISI: NAMA PEMAIN / BOT LAIN") : Event Giocatore.EfekNasib == 2 ? Custom String("AKSELERASI MENGIKUTI BIDIKAN") : Event Giocatore.EfekNasib == 5 ? Custom String("TERBAKAR: 5% HP MAKS / DETIK") : Custom String("DIRETAS"), Custom String("TERSISA {0}dtk", Massimo(0, Round To Integer(Event Giocatore.EfekNasibBerakhir - Totale Tempo Elapsed, Su)))) : Custom String("\n{0}\n{1}", Event Giocatore.EfekNasib == 1 ? Custom String("วิสัยทัศน์: ชื่อผู้เล่น / บอตอื่น") : Event Giocatore.EfekNasib == 2 ? Custom String("เร่งความเร็วตามทิศเล็ง") : Event Giocatore.EfekNasib == 5 ? Custom String("ไฟไหม้: 5% HP สูงสุด / วินาที") : Custom String("ถูกแฮ็ก"), Custom String("เหลือ {0} วินาที", Massimo(0, Round To Integer(Event Giocatore.EfekNasibBerakhir - Totale Tempo Elapsed, Su)))), Top, -99, Color(Bianco), Color(Bianco), Globale.RGB, Visibile a  String and Color, Visibile Mai);
		Event Giocatore.HudEfekNasib = Last Text ID;
	}
}

regola("19 - Teleportasi Jongkok: Buka tiga halaman selama Jongkok ditahan")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.Manusia == True;
		Event Giocatore.BotOtomatis == False;
		Is Dummy Bot(Event Giocatore) == False;
		Event Giocatore.MenuTerbuka == False;
		Event Giocatore.KartuNasibAktif == False;
		Event Giocatore.TeleportasiJongkokAktif == False;
		Event Giocatore.TeleportasiJongkokDiaktifkan == True;
		Has Generato(Event Giocatore) == True;
		Is Vivo(Event Giocatore) == True;
		Is Button Held(Event Giocatore, Button(Accovacciati)) == True;
	}

	azioni
	{
		Event Giocatore.TeleportasiJongkokAktif = True;
		Event Giocatore.PerintahTeleportasi = 0;
		Event Giocatore.DaftarTargetTeleportasi = Empty Array;
		Event Giocatore.CalonTargetTeleportasi = Null;
		Event Giocatore.JenisTeleportasiTerkunci = -1;
		Event Giocatore.TargetTeleportasiTerkunci = Null;
		Disallow Button(Event Giocatore, Button(Fuoco Primario));
		Disallow Button(Event Giocatore, Button(Secondary Fire));
		Disallow Button(Event Giocatore, Button(Interagisci));
		Call Subroutine(GambarTeleportasi);
	}
}

regola("19a - Teleportasi Jongkok: Primary berpindah, Secondary mengganti halaman")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.TeleportasiJongkokAktif == True;
		Event Giocatore.PerintahTeleportasi == 0;
		Is Button Held(Event Giocatore, Button(Accovacciati)) == True;
		Or(Is Button Held(Event Giocatore, Button(Fuoco Primario)), Is Button Held(Event Giocatore, Button(Secondary Fire))) == True;
	}

	azioni
	{
		If(Is Button Held(Event Giocatore, Button(Fuoco Primario)));
			Event Giocatore.PerintahTeleportasi = 1;
		Else;
			Event Giocatore.PerintahTeleportasi = 2;
		End;
	}
}

regola("19b - Teleportasi Jongkok: Lepaskan pengunci Primary dan Secondary")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.TeleportasiJongkokAktif == True;
		Event Giocatore.PerintahTeleportasi != 0;
		Is Button Held(Event Giocatore, Button(Fuoco Primario)) == False;
		Is Button Held(Event Giocatore, Button(Secondary Fire)) == False;
	}

	azioni
	{
		Event Giocatore.PerintahTeleportasi = 0;
	}
}

regola("19c - Teleportasi Jongkok: Secondary Fire mengganti tiga halaman")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.TeleportasiJongkokAktif == True;
		Event Giocatore.PerintahTeleportasi == 2;
	}

	azioni
	{
		Event Giocatore.KursorTeleportasi = (Event Giocatore.KursorTeleportasi + 1) % 3;
		If(Event Giocatore.KursorTeleportasi != 2);
			Event Giocatore.CalonTargetTeleportasi = Null;
			If(Event Giocatore.TeksTeleportasi != Null);
				Distruggi In-World Text(Event Giocatore.TeksTeleportasi);
			End;
			Event Giocatore.TeksTeleportasi = Null;
			Event Giocatore.TargetTeleportasiTeks = Null;
			If(Event Giocatore.PelatNamaDinonaktifkan == True);
				Enable Nameplates(All Giocatori(All Squadre), Event Giocatore);
				Event Giocatore.PelatNamaDinonaktifkan = False;
			End;
		Else;
			If(Event Giocatore.TeksDunia != Null);
				Distruggi In-World Text(Event Giocatore.TeksDunia);
			End;
			If(Index Of Array Value(Globale.PemainManusia, Event Giocatore) >= 0);
				Globale.TeksDuniaPemain[Index Of Array Value(Globale.PemainManusia, Event Giocatore)] = 0;
			End;
			Event Giocatore.TeksDunia = Null;
			Event Giocatore.TargetInspeksi = Null;
			Event Giocatore.InspeksiAktif = False;
			If(Event Giocatore.TeksTeleportasi != Null);
				Distruggi In-World Text(Event Giocatore.TeksTeleportasi);
			End;
			Event Giocatore.TeksTeleportasi = Null;
			Event Giocatore.TargetTeleportasiTeks = Null;
			Call Subroutine(SegarkanTargetTeleportasi);
		End;
	}
}

regola("19d0 - Teleportasi Jongkok: Perbarui target bidikan tanpa Wait")
