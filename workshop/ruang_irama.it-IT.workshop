	azioni
	{
		If(Not(And(Not(Globale.PemainPemicu.PindahTimDiproses), And(Not(Globale.PemainPemicu.SiklusPemainAktif), And(Globale.PemainPemicu.TeleportasiJongkokAktif, Or((Globale.PemainPemicu.PerintahTeleportasi == 1), (Globale.PemainPemicu.PerintahTeleportasi == 2)))))));
