		Globale.GeserKamera = 0.550;
		Globale.BantalanDinding = 0.200;
		Globale.JarakBidik = 25;
		"Penghitung waktu server berdiri sendiri dari waktu mode bawaan. Pengelola lobi dapat memilih 30 sampai 90 menit."
		Globale.DurasiServerMenit = Workshop Setting Integer(Custom String("CHILL DEDICATED SERVER"), Custom String("Duration / Durasi / ระยะเวลา (min)"), 30, 30, 90, 0);
		Globale.IndeksLokasiServer = Workshop Setting Combo(Custom String("CHILL DEDICATED SERVER"), Custom String("Location / Lokasi / ตำแหน่ง (Asia)"), 6, Array(
			Custom String("Bangladesh"),
			Custom String("Bhutan"),
			Custom String("Brunei"),
			Custom String("Cambodia"),
			Custom String("Hong Kong"),
			Custom String("India"),
