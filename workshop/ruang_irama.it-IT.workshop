regola("93e - Subrutin: Lepas ikon tujuan saat keluar atau berganti tim")
{
	evento
	{
		Subroutine;
		BersihkanIkonPilar;
	}

	azioni
	{
		For Global Variable(IndeksIkonPilar, 0, 12, 1);
		If((Globale.PemilikIkonPilar[Globale.IndeksIkonPilar] == Globale.PemainPemicu));
		If((Globale.EntitasIkonPilar[Globale.IndeksIkonPilar] != 0));
		Destroy Icon(Globale.EntitasIkonPilar[Globale.IndeksIkonPilar]);
		End;
		If(Entity Exists(Globale.PemilikIkonPilar[Globale.IndeksIkonPilar]));
		Stop Chasing Player Variable(Globale.PemilikIkonPilar[Globale.IndeksIkonPilar], PosisiIkonPilar);
		Set Player Variable(Globale.PemilikIkonPilar[Globale.IndeksIkonPilar], PosisiIkonPilar, Vector(0, 0.500, 0));
		End;
		Globale.EntitasIkonPilar[Globale.IndeksIkonPilar] = 0;
		Globale.PilihanIkonPilar[Globale.IndeksIkonPilar] = 0;
		Globale.PemilikIkonPilar[Globale.IndeksIkonPilar] = Null;
		Globale.WaktuIkonPilar[Globale.IndeksIkonPilar] = 0;
		End;
		End;
	}
}

regola("04h - Subrutin: Pengatur pemain dari konteks global")
{
	evento
	{
		Subroutine;
		ProsesPengaturGlobal;
	}

	azioni
	{
		Abort If(Not(Entity Exists(Globale.PemainPemicu)));
		If((Count Of(Globale.PemainPemicu.StatusPengatur) < 37));
		Globale.GenerasiPengatur += 1;
		Globale.PemainPemicu.StatusPengatur = Empty Array;
		Globale.PemainPemicu.StatusPengatur[36] = Globale.GenerasiPengatur;
		Globale.PemainPemicu.WaktuPengatur = Empty Array;
		End;
		Call Subroutine(Pengatur01a);
		Call Subroutine(Pengatur01b);
		Call Subroutine(Pengatur02);
		If(Or(Is Dummy Bot(Globale.PemainPemicu), Globale.PemainPemicu.BotOtomatis));
		Call Subroutine(Pengatur03c);
		Call Subroutine(Pengatur03f);
		Call Subroutine(Pengatur03g);
		Call Subroutine(Pengatur03h);
		Call Subroutine(Pengatur18i);
		Call Subroutine(Pengatur18j);
		Else If(And(Globale.PemainPemicu.Manusia, And(Not(Is Dummy Bot(Globale.PemainPemicu)), Not(Globale.PemainPemicu.BotOtomatis))));
		Call Subroutine(Pengatur05);
		Call Subroutine(Pengatur05b);
		If(Or(Globale.PemainPemicu.MenuTerbuka, Or((Globale.PemainPemicu.PerintahMenu != 0), Globale.PemainPemicu.MasukanMenuDikunci)));
		Call Subroutine(Pengatur05c);
		Call Subroutine(Pengatur05d);
		Call Subroutine(Pengatur05e);
		Call Subroutine(Pengatur05f);
		Call Subroutine(Pengatur06);
		Call Subroutine(Pengatur08);
		Call Subroutine(Pengatur10);
		Call Subroutine(Pengatur11);
		Else;
		Globale.PemainPemicu.StatusPengatur[13] = 0;
		Globale.PemainPemicu.StatusPengatur[14] = 0;
		Globale.PemainPemicu.StatusPengatur[15] = 0;
		Globale.PemainPemicu.StatusPengatur[16] = 0;
		End;
		Call Subroutine(Pengatur12c);
		Call Subroutine(Pengatur12d);
		Call Subroutine(Pengatur12f);
		Call Subroutine(Pengatur12g);
		Call Subroutine(Pengatur13);
		Call Subroutine(Pengatur18c);
		Call Subroutine(Pengatur18g);
		If(Or((Count Of(Globale.PenontonVisiNasib) > 0), And((Globale.PemainPemicu.TeksVisiNasib != Null), (Globale.PemainPemicu.TeksVisiNasib != 0))));
		Call Subroutine(Pengatur18i);
		End;
		If(Or((Count Of(Globale.PenontonVisiNasib) > 0), And((Globale.PemainPemicu.TeksVisiNasib != Null), (Globale.PemainPemicu.TeksVisiNasib != 0))));
		Call Subroutine(Pengatur18j);
		End;
		Call Subroutine(Pengatur18k);
		Call Subroutine(Pengatur19);
		If(Globale.PemainPemicu.TeleportasiJongkokAktif);
		Call Subroutine(Pengatur19a);
		Call Subroutine(Pengatur19b);
		Call Subroutine(Pengatur19c);
		Call Subroutine(Pengatur19d);
		Call Subroutine(Pengatur19e);
		Call Subroutine(Pengatur19g);
		End;
		If(Not(Globale.PemainPemicu.TeleportasiJongkokAktif));
		Globale.PemainPemicu.StatusPengatur[30] = 0;
		Globale.PemainPemicu.StatusPengatur[32] = 0;
		End;
		If(Globale.PemainPemicu.LampiranTeleportasiAktif);
		Call Subroutine(Pengatur19f);
		End;
		If(Globale.PemainPemicu.LampiranTeleportasiAktif);
		Call Subroutine(Pengatur19h);
		End;
		End;
	}
}

regola("04i - Subrutin: Proses antrean peristiwa yang dibekukan")
{
	evento
	{
		Subroutine;
		ProsesAntreanGlobal;
	}

	azioni
	{
		Globale.JumlahPeristiwaAwal = Globale.JumlahPeristiwa;
		For Global Variable(KursorPeristiwa, 0, Globale.JumlahPeristiwaAwal, 1);
		Globale.PeristiwaAktif = Globale.AntreanPeristiwa[Globale.KepalaPeristiwa];
		Globale.AntreanPeristiwa[Globale.KepalaPeristiwa] = Null;
		Globale.KepalaPeristiwa = ((Globale.KepalaPeristiwa + 1) % 256);
		Globale.JumlahPeristiwa -= 1;
		Globale.PemainPemicu = Globale.PeristiwaAktif[1];
		If((Globale.PeristiwaAktif[0] == 0));
		Call Subroutine(Peristiwa03i);
		Else If((Globale.PeristiwaAktif[0] == 1));
		Call Subroutine(Peristiwa04);
		Else If((Globale.PeristiwaAktif[0] == 2));
		Call Subroutine(Peristiwa12e);
		Else If((Globale.PeristiwaAktif[0] == 3));
		Call Subroutine(Peristiwa16a);
		Else If((Globale.PeristiwaAktif[0] == 4));
		Call Subroutine(Peristiwa17);
		Else If((Globale.PeristiwaAktif[0] == 5));
		Call Subroutine(Peristiwa18f);
		Else If((Globale.PeristiwaAktif[0] == 6));
		Call Subroutine(Peristiwa89i1);
		End;
		End;
		Globale.PemainPemicu = Null;
		Globale.PeristiwaAktif = Null;
	}
}

regola("04j - Subrutin: Bersihkan keluar tertunda tanpa konteks pemain")
{
	evento
	{
		Subroutine;
		ProsesKeluarGlobal;
	}

	azioni
	{
		For Global Variable(KursorKeluarTertunda, 0, Count Of(Globale.KeluarTertunda), 1);
		If((Globale.KeluarTertunda[Globale.KursorKeluarTertunda] != Null));
		Globale.PeristiwaAktif = Globale.KeluarTertunda[Globale.KursorKeluarTertunda];
		If((Total Time Elapsed >= (Globale.PeristiwaAktif[7] + 0.500)));
		Globale.PemainPemicu = Globale.PeristiwaAktif[1];
		Globale.KeluarTertunda[Globale.KursorKeluarTertunda] = Null;
		If(Not(And(Entity Exists(Globale.PemainPemicu), Array Contains(Globale.SalinanDaftarPemain, Globale.PemainPemicu))));
		Call Subroutine(BersihkanPemain);
		End;
		End;
		End;
		End;
		If(((Globale.LangkahPenjadwal % 20) == 0));
		For Global Variable(KursorDaftarHilang, (Count Of(Globale.PemainManusia) - 1), -1, -1);
		Globale.PemainPemicu = Globale.PemainManusia[Globale.KursorDaftarHilang];
		If(And(Entity Exists(Globale.PemainPemicu), Array Contains(Globale.SalinanDaftarPemain, Globale.PemainPemicu)));
		Globale.WaktuHilangHUD[Globale.SlotHUDPemain[Globale.KursorDaftarHilang]] = 0;
		Else If((Globale.WaktuHilangHUD[Globale.SlotHUDPemain[Globale.KursorDaftarHilang]] == 0));
		Globale.WaktuHilangHUD[Globale.SlotHUDPemain[Globale.KursorDaftarHilang]] = (Total Time Elapsed + 0.500);
		Else If((Total Time Elapsed >= Globale.WaktuHilangHUD[Globale.SlotHUDPemain[Globale.KursorDaftarHilang]]));
		Call Subroutine(BersihkanPemain);
		End;
		End;
		End;
		Globale.PeristiwaAktif = Null;
		Globale.PemainPemicu = Null;
	}
}

regola("04k - Subrutin: Simpan visibilitas ikon setelah semua perintah")
{
	evento
	{
		Subroutine;
		ProsesIkonTerlihat;
	}

	azioni
	{
		For Global Variable(IndeksIkonPilar, 0, 12, 1);
		Globale.PemainIkonPilar = Globale.PemilikIkonPilar[Globale.IndeksIkonPilar];
		Globale.PilihanIkonTerlihat[Globale.IndeksIkonPilar] = (And(Entity Exists(Globale.PemainIkonPilar), And(Array Contains(Globale.PemainManusia, Globale.PemainIkonPilar), And(Globale.PemainIkonPilar.Manusia, (Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) > 0.100)))) ? Globale.PemainIkonPilar.IndeksIkon : 0);
		End;
		Globale.PemainIkonPilar = Null;
	}
}
