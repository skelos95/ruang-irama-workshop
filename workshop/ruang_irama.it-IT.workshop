เป้าหมาย: {0}
คำสั่ง: เทเลพอร์ตไปใกล้เป้าหมาย", Event Player.CalonTargetTeleportasi != Null ? Event Player.CalonTargetTeleportasi : Custom String("ไม่มีเป้าหมายสาธารณะที่พร้อมใช้")) : Event Player.KursorTeleportasi == 3 ? Custom String("4/5 | เกาะ: ผู้เล่น / บอต
ตำแหน่ง: เหนือเป้าหมายที่เลือก
เป้าหมาย: {0}
คำสั่ง: เกาะ", Event Player.CalonTargetTeleportasi != Null ? Event Player.CalonTargetTeleportasi : Custom String("ไม่มีเป้าหมายสาธารณะที่พร้อมใช้")) : Custom String("5/5 | กำจัดตัวเอง
ผล: กำจัดร่างฮีโร่ปัจจุบัน
คำสั่ง: กำจัดตัวเอง
คูลดาวน์: 3 วินาทีต่อผู้เล่น"), Top, 3, Custom Color(255, 255, 255, 255), Custom Color(190 + X Component Of(Event Player.WarnaMenu) * 0.250, 190 + Y Component Of(Event Player.WarnaMenu) * 0.250, 190 + Z Component Of(Event Player.WarnaMenu) * 0.250, 255), Custom Color(X Component Of(Event Player.WarnaMenu), Y Component Of(Event Player.WarnaMenu), Z Component Of(Event Player.WarnaMenu), 255), Visible To String and Color, Visible Never);
		Event Player.HudMenu = Last Text ID;
		If(Index Of Array Value(Globale.PemainManusia, Event Player) >= 0);
			Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Event Player)] = Event Player.HudMenu;
		End;
	}
}

