regola("91g - Subrutin: Gambar menu teleportasi")
{
	evento
	{
		Subroutine;
		GambarTeleportasi;
	}

	azioni
	{
		If(Event Player.HudMenu != Null);
			Destroy HUD Text(Event Player.HudMenu);
		End;
		Event Player.HudMenu = Null;
		If(Index Of Array Value(Globale.PemainManusia, Event Player) >= 0);
			Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Event Player)] = 0;
		End;
		Event Player.KursorTeleportasi %= 5;
		Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}
{1}", Custom String("HOLD {0} | {1}: NEXT | {2}: PREVIOUS", Input Binding String(Button(Crouch)), Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}
{1}", Custom String("{0}: EXECUTE | RELEASE {1}: CLOSE", Input Binding String(Button(Interact)), Input Binding String(Button(Crouch))), Custom String("{0} + {1}: DETACH (ATTACH PAGE)", Input Binding String(Button(Crouch)), Input Binding String(Button(Reload))))) : Event Player.IndeksBahasa == 1 ? Custom String("{0}
{1}", Custom String("TAHAN {0} | {1}: BERIKUTNYA | {2}: SEBELUMNYA", Input Binding String(Button(Crouch)), Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}
{1}", Custom String("{0}: JALANKAN | LEPAS {1}: TUTUP", Input Binding String(Button(Interact)), Input Binding String(Button(Crouch))), Custom String("{0} + {1}: LEPAS KAITAN (HALAMAN TEMPEL)", Input Binding String(Button(Crouch)), Input Binding String(Button(Reload))))) : Custom String("{0}
{1}", Custom String("กด {0} ค้าง | {1}: ถัดไป | {2}: ก่อนหน้า", Input Binding String(Button(Crouch)), Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}
{1}", Custom String("{0}: ดำเนินการ | ปล่อย {1}: ปิด", Input Binding String(Button(Interact)), Input Binding String(Button(Crouch))), Custom String("{0} + {1}: ยกเลิกการเกาะ (หน้าเกาะ)", Input Binding String(Button(Crouch)), Input Binding String(Button(Reload))))), Event Player.IndeksBahasa == 0 ? Event Player.KursorTeleportasi == 0 ? Custom String("1/5 | TELEPORT: SPAWN ROOM
DESTINATION: YOUR TEAM'S SPAWN ROOM
ACTION: TELEPORT") : Event Player.KursorTeleportasi == 1 ? Custom String("2/5 | TELEPORT: ACTIVE OBJECTIVE
DESTINATION: OBJECTIVE / ENEMY FLAG
ACTION: TELEPORT NEARBY") : Event Player.KursorTeleportasi == 2 ? Custom String("3/5 | TELEPORT: PLAYER / BOT
DESTINATION: BESIDE SELECTED TARGET
TARGET: {0}
ACTION: TELEPORT NEARBY", Event Player.CalonTargetTeleportasi != Null ? Event Player.CalonTargetTeleportasi : Custom String("NO AVAILABLE PUBLIC TARGET")) : Event Player.KursorTeleportasi == 3 ? Custom String("4/5 | ATTACH: PLAYER / BOT
POSITION: ABOVE SELECTED TARGET
TARGET: {0}
ACTION: ATTACH", Event Player.CalonTargetTeleportasi != Null ? Event Player.CalonTargetTeleportasi : Custom String("NO AVAILABLE PUBLIC TARGET")) : Custom String("5/5 | SELF ELIMINATION
EFFECT: ELIMINATE CURRENT HERO FORM
ACTION: ELIMINATE SELF
COOLDOWN: 3 SEC PER PLAYER") : Event Player.IndeksBahasa == 1 ? Event Player.KursorTeleportasi == 0 ? Custom String("1/5 | TELEPORT: RUANG MUNCUL
TUJUAN: RUANG MUNCUL TIMMU
AKSI: TELEPORT") : Event Player.KursorTeleportasi == 1 ? Custom String("2/5 | TELEPORT: OBJEKTIF AKTIF
TUJUAN: OBJEKTIF / BENDERA MUSUH
AKSI: TELEPORT KE DEKAT TUJUAN") : Event Player.KursorTeleportasi == 2 ? Custom String("3/5 | TELEPORT: PLAYER / BOT
TUJUAN: DI SAMPING TARGET TERPILIH
TARGET: {0}
AKSI: TELEPORT KE DEKAT TARGET", Event Player.CalonTargetTeleportasi != Null ? Event Player.CalonTargetTeleportasi : Custom String("TIDAK ADA TARGET PUBLIK TERSEDIA")) : Event Player.KursorTeleportasi == 3 ? Custom String("4/5 | KAITKAN: PLAYER / BOT
POSISI: DI ATAS TARGET TERPILIH
TARGET: {0}
AKSI: KAITKAN", Event Player.CalonTargetTeleportasi != Null ? Event Player.CalonTargetTeleportasi : Custom String("TIDAK ADA TARGET PUBLIK TERSEDIA")) : Custom String("5/5 | ELIMINASI DIRI
EFEK: ELIMINASI WUJUD HERO AKTIF
AKSI: ELIMINASI DIRI
COOLDOWN: 3 DTK PER PLAYER") : Event Player.KursorTeleportasi == 0 ? Custom String("1/5 | เทเลพอร์ต: ห้องเกิด
ปลายทาง: ห้องเกิดของทีมคุณ
คำสั่ง: เทเลพอร์ต") : Event Player.KursorTeleportasi == 1 ? Custom String("2/5 | เทเลพอร์ต: เป้าหมายภารกิจ
