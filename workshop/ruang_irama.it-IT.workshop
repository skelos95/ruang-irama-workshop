		Globale.PemainPemicu.InteraksiKameraDipakai = False;
	}
}

regola("12e - Bangkit Lompat: Simpan posisi kematian")
{
	evento
	{
		Player Died;
		Tutti;
		Tutti;
		}

	condizioni
	{
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Is Alive(Event Player) == False;
		}

	azioni
	{
		If((Globale.JumlahPeristiwa < 256));
		Globale.AntreanPeristiwa[Globale.EkorPeristiwa] = Array(2, Event Player, Null, Null, Null, Null, Position Of(Event Player), Total Time Elapsed, Null, Null, Null, Null, Null, Null, Null, Null, Null, Null, Hero Of(Event Player), Team Of(Event Player), Event Player.StatusPengatur[36], (Event Player.Manusia ? Event Player.NamaTampilan : Custom String("{0}", Event Player)));
		Globale.EkorPeristiwa = ((Globale.EkorPeristiwa + 1) % 256);
		Globale.JumlahPeristiwa += 1;
		Else;
		Globale.PeristiwaTerlewat += 1;
		End;
	}
}

regola("12e - Bangkit Lompat: Simpan posisi kematian global")
{
	evento
	{
		Subroutine;
		Peristiwa12e;
	}

	azioni
	{
		Abort If(Not(Entity Exists(Globale.PemainPemicu)));
		Abort If((Globale.PeristiwaAktif[20] != Globale.PemainPemicu.StatusPengatur[36]));
		Abort If((Globale.PeristiwaAktif[21] != (Globale.PemainPemicu.Manusia ? Globale.PemainPemicu.NamaTampilan : Custom String("{0}", Globale.PemainPemicu))));
		Abort If(Or(Globale.PemainPemicu.SiklusPemainAktif, (Globale.PemainPemicu.TimTerakhir != Team Of(Globale.PemainPemicu))));
		Abort If(Is Alive(Globale.PemainPemicu));
		Globale.PemainPemicu.PosisiMati = Globale.PeristiwaAktif[6];
		Stop Accelerating(Globale.PemainPemicu);
		Set Move Speed(Globale.PemainPemicu, 100);
		Stop Transforming Throttle(Globale.PemainPemicu);
		Set Gravity(Globale.PemainPemicu, 100);
		Enable Movement Collision With Environment(Globale.PemainPemicu);
		Globale.PemainPemicu.FisikaHantuTerbangDiterapkan = False;
		Globale.PemainPemicu.WaktuMulaiTerbangMaju = -1;
		Globale.PemainPemicu.PerintahMenu = 0;
		Globale.PemainPemicu.PerintahTeleportasi = 0;
		Small Message(Globale.PemainPemicu, ((Globale.PemainPemicu.IndeksBahasa == 0) ? Custom String("Press {0}: revive here. Void death? Back to walkable ground.", Input Binding String(Button(Jump))) : ((Globale.PemainPemicu.IndeksBahasa == 1) ? Custom String("Tekan {0}: bangkit di sini. Jatuh ke jurang? Kembali ke tanah aman.", Input Binding String(Button(Jump))) : Custom String("กด {0}: ฟื้นตรงนี้ | ตกเหว: ฟื้นบนพื้นที่เดินได้", Input Binding String(Button(Jump))))));
	}
}

regola("12f - Bangkit Lompat: Bangkit di posisi aman yang bisa dilalui")
{
	evento
	{
		Subroutine;
		Pengatur12f;
	}

	azioni
	{
		Abort If(Not(And(Not(Is Alive(Globale.PemainPemicu)), And(Not(Globale.PemainPemicu.BangkitLompatDipakai), Is Button Held(Globale.PemainPemicu, Button(Jump))))));
		Globale.PemainPemicu.BangkitLompatDipakai = True;
		Globale.PemainPemicu.PosisiBangkitAman = Nearest Walkable Position(Position Of(Globale.PemainPemicu));
		Globale.PemainPemicu.BangkitPerluTeleportasi = Or((Distance Between(Ray Cast Hit Position((Globale.PemainPemicu.PosisiMati + Vector(0, 1, 0)), (Globale.PemainPemicu.PosisiMati - Vector(0, 3, 0)), Empty Array, Empty Array, False), Globale.PemainPemicu.PosisiMati) > 2.500), (Distance Between(Globale.PemainPemicu.PosisiBangkitAman, Globale.PemainPemicu.PosisiMati) > 0.500));
		If(Globale.PemainPemicu.BangkitPerluTeleportasi);
		Teleport(Globale.PemainPemicu, (Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 0.500, 0)));
		End;
		Resurrect(Globale.PemainPemicu);
		If(Globale.PemainPemicu.BangkitPerluTeleportasi);
		Teleport(Globale.PemainPemicu, (Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 0.500, 0)));
		End;
		Globale.PemainPemicu.BangkitPerluTeleportasi = False;
		If(Is Alive(Globale.PemainPemicu));
		Globale.PemainPemicu.FisikaHantuTerbangDiterapkan = False;
		Call Subroutine(TerapkanFisikaHantuTerbang);
		End;
	}
}

regola("12g - Bangkit Lompat: Lepaskan Lompat sebelum mencoba lagi")
{
	evento
	{
		Subroutine;
		Pengatur12g;
	}

	azioni
	{
		Abort If(Not(And(Globale.PemainPemicu.BangkitLompatDipakai, Not(Is Button Held(Globale.PemainPemicu, Button(Jump))))));
		Globale.PemainPemicu.BangkitLompatDipakai = False;
	}
}

regola("13 - Intip Pahlawan: Nama mengikuti target bidikan")
{
	evento
	{
		Subroutine;
		Pengatur13;
	}

	azioni
	{
		Abort If(Not(And(Is Alive(Globale.PemainPemicu), And(Not(Globale.PemainPemicu.MenuTerbuka), And(Not(Globale.PemainPemicu.PrivasiNasibAktif), And(Not(Globale.PemainPemicu.TeleportasiJongkokAktif), And(Not(Globale.PemainPemicu.TeleportasiJongkokDiaktifkan), And((Globale.PemainPemicu.ModeKamera != 2), And(Is Button Held(Globale.PemainPemicu, Button(Crouch)), Or((Globale.PemainPemicu.TargetInspeksi != Globale.PemainPemicu.CalonTargetInspeksi), Or(And((Globale.PemainPemicu.TeksDunia != Null), Or(Not(Entity Exists(Globale.PemainPemicu.TargetInspeksi)), Or(Not(Has Spawned(Globale.PemainPemicu.TargetInspeksi)), Or(Not(Is Alive(Globale.PemainPemicu.TargetInspeksi)), And(And(Not(Is Dummy Bot(Globale.PemainPemicu.TargetInspeksi)), Not(Player Variable(Globale.PemainPemicu.TargetInspeksi, BotOtomatis))), Or(Not(Player Variable(Globale.PemainPemicu.TargetInspeksi, Manusia)), Or(Player Variable(Globale.PemainPemicu.TargetInspeksi, PrivasiInspeksiAktif), Player Variable(Globale.PemainPemicu.TargetInspeksi, PembaruanDaftarTertunda)))))))), And((Globale.PemainPemicu.TeksDunia == Null), And((Globale.PemainPemicu.CalonTargetInspeksi != Null), (Total Time Elapsed >= Globale.PemainPemicu.WaktuTeksTargetBerikut))))))))))))));
		If(Not(Globale.PemainPemicu.InspeksiAktif));
		Globale.PemainPemicu.InspeksiAktif = True;
		Disable Nameplates(All Players(All Teams), Globale.PemainPemicu);
		Globale.PemainPemicu.PelatNamaDinonaktifkan = True;
		End;
		If((Globale.PemainPemicu.TeksDunia != Null));
		Destroy In-World Text(Globale.PemainPemicu.TeksDunia);
		End;
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) >= 0));
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) < Count Of(Globale.TeksDuniaPemain)));
		Globale.TeksDuniaPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)] = 0;
		End;
		End;
		Globale.PemainPemicu.TeksDunia = Null;
		Call Subroutine(SegarkanTargetInspeksi);
		Abort If((Globale.PemainPemicu.TargetInspeksi == Null));
		Abort If((Total Time Elapsed < Globale.PemainPemicu.WaktuTeksTargetBerikut));
		Globale.PemainPemicu.WaktuTeksTargetBerikut = (Total Time Elapsed + 0.250);
		Create In-World Text(Evaluate Once(Globale.PemainPemicu), Custom String("{0} {1} | {2}", Hero Icon String((Is Duplicating(Evaluate Once(Globale.PemainPemicu.TargetInspeksi)) ? Hero Being Duplicated(Evaluate Once(Globale.PemainPemicu.TargetInspeksi)) : Hero Of(Evaluate Once(Globale.PemainPemicu.TargetInspeksi)))), Evaluate Once((Array Contains(Globale.PemainManusia, Globale.PemainPemicu.TargetInspeksi) ? Player Variable(Globale.PemainPemicu.TargetInspeksi, NamaTampilan) : Custom String("{0}", (Is Duplicating(Globale.PemainPemicu.TargetInspeksi) ? Hero Being Duplicated(Globale.PemainPemicu.TargetInspeksi) : Hero Of(Globale.PemainPemicu.TargetInspeksi))))), Round To Integer(Health(Evaluate Once(Globale.PemainPemicu.TargetInspeksi)), Down)), Update Every Frame((Eye Position(Evaluate Once(Globale.PemainPemicu.TargetInspeksi)) + Vector(0, 0.450, 0))), 1.100, Do Not Clip, Visible To Position String and Color, Evaluate Once((Array Contains(Globale.PemainManusia, Globale.PemainPemicu.TargetInspeksi) ? Player Variable(Globale.PemainPemicu.TargetInspeksi, WarnaNama) : Color(Orange))), Visible Never);
		Globale.PemainPemicu.TeksDunia = Last Text ID;
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) >= 0));
		If((Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu) < Count Of(Globale.TeksDuniaPemain)));
		Globale.TeksDuniaPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainPemicu)] = Globale.PemainPemicu.TeksDunia;
		End;
		End;
	}
}

