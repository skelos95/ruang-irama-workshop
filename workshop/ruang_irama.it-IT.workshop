regola("91q - Subrutin: Hitung ulang pilihan dan pemimpin tunggal")
{
	evento
	{
		Subroutine;
		HitungPilihan;
	}

	azioni
	{
		"Hitung dari pemilih yang masih terdaftar; jangan membaca variabel milik entitas yang sudah keluar."
		For Global Variable(IndeksPemilih, 0, Count Of(Globale.PemainManusia), 1);
			Set Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], JumlahPilihan, Count Of(Filtered Array(Globale.PemainManusia, Player Variable(Current Array Element, PemainDipilih) == Globale.PemainManusia[Globale.IndeksPemilih])));
		End;
		Globale.PemimpinPilihan = Null;
		Globale.PilihanTerbanyak = 0;
		Globale.PilihanSeri = False;
		Globale.NamaPemimpinPilihan = Custom String("");
		Globale.WarnaPemimpinPilihan = Custom Color(255, 255, 255, 255);
		If(Count Of(Globale.PemainManusia) > 0);
			Globale.PemimpinPilihan = First Of(Sorted Array(Globale.PemainManusia, 0 - Player Variable(Current Array Element, JumlahPilihan)));
			Globale.PilihanTerbanyak = Player Variable(Globale.PemimpinPilihan, JumlahPilihan);
			If(Globale.PilihanTerbanyak > 0);
				Globale.PilihanSeri = Count Of(Filtered Array(Globale.PemainManusia, Player Variable(Current Array Element, JumlahPilihan) == Globale.PilihanTerbanyak)) > 1;
				If(Globale.PilihanSeri == True);
					Globale.PemimpinPilihan = Null;
				End;
			Else;
				Globale.PemimpinPilihan = Null;
			End;
		End;
		If(Globale.PemimpinPilihan != Null);
			Globale.NamaPemimpinPilihan = Player Variable(Globale.PemimpinPilihan, NamaTampilan);
			Globale.WarnaPemimpinPilihan = Player Variable(Globale.PemimpinPilihan, WarnaNama);
		End;
	}
}

regola("93 - Subrutin: Mulai kamera dinamis di bahu kiri")
{
	evento
	{
		Subroutine;
		MulaiKamera;
	}

	azioni
	{
		Abort If(Event Player.TargetKamera == Null);
		Abort If(Entity Exists(Event Player.TargetKamera) == False);
		"Ikuti perpindahan target setiap bingkai tanpa penghalusan yang mengejar tujuan bergerak dan menimbulkan getaran."
		Start Camera(Event Player, Update Every Frame(First Of(Mapped Array(Array(Ray Cast Hit Position(Eye Position(Event Player.TargetKamera) + Vector(0, Min(0.750, Max(0.450, 0.450 + (Max Health(Event Player.TargetKamera) - 200) * 0.0006)), 0), Eye Position(Event Player.TargetKamera) + Vector(0, Min(0.750, Max(0.450, 0.450 + (Max Health(Event Player.TargetKamera) - 200) * 0.0006)), 0) - Facing Direction Of(Event Player.TargetKamera) * Min(4.500, Max(Globale.JarakKamera, Globale.JarakKamera + (Max Health(Event Player.TargetKamera) - 200) * 0.0055)) + Cross Product(Direction From Angles(Horizontal Facing Angle Of(Event Player.TargetKamera), 0), Vector(0, 1, 0)) * Min(1.350, Max(Globale.GeserKamera, Globale.GeserKamera + (Max Health(Event Player.TargetKamera) - 200) * 0.0016)), Empty Array, Empty Array, False)), Current Array Element + Direction Towards(Current Array Element, Eye Position(Event Player.TargetKamera) + Vector(0, Min(0.750, Max(0.450, 0.450 + (Max Health(Event Player.TargetKamera) - 200) * 0.0006)), 0)) * Min(Globale.BantalanDinding, Distance Between(Current Array Element, Eye Position(Event Player.TargetKamera) + Vector(0, Min(0.750, Max(0.450, 0.450 + (Max Health(Event Player.TargetKamera) - 200) * 0.0006)), 0)) * 0.250)))), Update Every Frame(Eye Position(Event Player.TargetKamera) + Facing Direction Of(Event Player.TargetKamera) * Globale.JarakBidik), 0);
	}
}

regola("93a - Subrutin: Efek perubahan diterapkan")
{
	evento
	{
		Subroutine;
		EfekTerapkan;
	}

	azioni
	{
		Play Effect(All Players(All Teams), Ring Explosion, Globale.RGB, Position Of(Event Player) + Vector(0, 1, 0), 3);
	}
}

regola("93b - Subrutin: Efek pengaturan dipulihkan")
{
	evento
	{
		Subroutine;
		EfekPulihkan;
	}

	azioni
	{
		Play Effect(All Players(All Teams), Ring Explosion, Globale.RGB, Position Of(Event Player) + Vector(0, 1, 0), 3);
	}
}

regola("93b2 - Subrutin: Tenangkan pemicu sebelum pembersihan")
{
	evento
	{
		Subroutine;
		TenangkanPemain;
	}

	azioni
	{
		"Pulihkan efek mesin sebelum penyiapan menghapus variabel; hanya dipanggil dari konteks pemain pemicu."
		Call Subroutine(TutupMenu);
		Allow Button(Event Player, Button(Melee));
		Stop Camera(Event Player);
		Stop Modifying Hero Voice Lines(Event Player);
		Stop Chasing Player Variable(Event Player, WarnaMenu);
		If(Event Player.LampiranTeleportasiAktif == True);
			Detach Players(Event Player);
		End;
		Event Player.LampiranTeleportasiAktif = False;
		Event Player.TargetLampiranTeleportasi = Null;
		Event Player.PahlawanLampiranSendiri = Null;
		Event Player.PahlawanLampiranTarget = Null;
		If(Event Player.PelatNamaDinonaktifkan == True);
			Enable Nameplates(All Players(All Teams), Event Player);
		End;
		Event Player.PelatNamaDinonaktifkan = False;
		Event Player.KebalAktif = False;
		Event Player.ModeKebal = 0;
		Event Player.KursorKebal = 0;
		Call Subroutine(PulihkanNasibPemain);
		Stop Accelerating(Event Player);
		Stop Transforming Throttle(Event Player);
		Set Move Speed(Event Player, 100);
		Set Gravity(Event Player, 100);
		Enable Movement Collision With Environment(Event Player);
		Event Player.WaktuPaksaBerikut = 0;
		Event Player.WaktuPaksaBerakhir = 0;
		Event Player.MenuNasibHarusDibuka = False;
		Event Player.KematianBalasDendam = False;
		Event Player.PenagihBalasDendam = Null;
		"Matikan semua pemicu sebelum acara keluar atau masuk menyelesaikan pembersihan dan pendaftaran baru."
		Event Player.SudahSiap = False;
		Event Player.Manusia = False;
		Event Player.PerintahMenu = 0;
		Event Player.MasukanMenuDikunci = False;
		Event Player.SeranganDekatDipakai = False;
		Event Player.MenuTerbuka = False;
		Event Player.TeleportasiJongkokAktif = False;
		Event Player.PerintahTeleportasi = 0;
		Event Player.InspeksiAktif = False;
		Event Player.WaktuTeksTargetBerikut = 0;
		Event Player.TargetInspeksi = Null;
		Event Player.InteraksiKameraDipakai = False;
		Event Player.IzinkanBotBuatanMengikuti = False;
		Event Player.WaktuTeleportasiBotBuatan = 0;
		Event Player.KursorTeleportasiBotBuatan = 0;
		Event Player.ModeHantuAktif = False;
		Event Player.ModeTerbangAktif = False;
		Event Player.KursorHantuTerbang = 0;
		Event Player.FisikaHantuTerbangDiterapkan = False;
		Event Player.WaktuBunuhDiriBerikut = 0;
		Event Player.WaktuMulaiTerbangMaju = -1;
		Event Player.PersenTerbang = 100;
		Event Player.ArahTerbang = Vector(0, 0, 0);
		Event Player.DeltaTerbang = Vector(0, 0, 0);
		Event Player.RantaiLampiran = Null;
		Event Player.IndeksRantaiLampiran = 0;
		Event Player.SiklusLampiran = False;
		Event Player.HudKiri = Null;
		Event Player.HudMenu = Null;
		Event Player.HudPemainDibuat = False;
		Event Player.SudahDiperiksa = False;
		Event Player.BotOtomatis = False;
	}
}

regola("93c - Subrutin: Bersihkan referensi pemain yang benar-benar keluar")
{
	evento
	{
		Subroutine;
		BersihkanPemain;
	}

	azioni
	{
		"Pembersihan keluar hanya menyentuh pengenal dan daftar pemain global; entitas yang sudah hilang tidak dinormalisasi ulang."
		Globale.PemainPembersihan = Event Player;
		Globale.IndeksKeluar = Index Of Array Value(Globale.PemainManusia, Globale.PemainPembersihan);
		If(Globale.IndeksKeluar > -1);
			If(Or(Globale.IndeksKeluar >= Count Of(Globale.SlotHUDPemain), Or(Globale.IndeksKeluar >= Count Of(Globale.HudKiriPemain), Or(Globale.IndeksKeluar >= Count Of(Globale.HudMenuPemain), Globale.IndeksKeluar >= Count Of(Globale.TeksDuniaPemain)))));
				"Perlindungan mogok: tandai jalur cadangan lalu jalankan pemulihan darurat setelah jalur utama."
				Globale.IndeksPembersihan = Globale.IndeksKeluar;
				Globale.IndeksKeluar = -2;
			End;
			If(Globale.IndeksKeluar >= 0);
				Globale.IndeksPembersihan = Globale.IndeksKeluar;
				Globale.IndeksUtangKeluar = Globale.SlotHUDPemain[Globale.IndeksPembersihan];
				If(Globale.IkonKartuNasibPemain[Globale.IndeksUtangKeluar] != 0);
					Destroy Icon(Globale.IkonKartuNasibPemain[Globale.IndeksUtangKeluar]);
				End;
				Globale.IkonKartuNasibPemain[Globale.IndeksUtangKeluar] = 0;
				If(Globale.IkonKebalPemain[Globale.IndeksUtangKeluar] != 0);
					Destroy Icon(Globale.IkonKebalPemain[Globale.IndeksUtangKeluar]);
				End;
				Globale.IkonKebalPemain[Globale.IndeksUtangKeluar] = 0;
				If(Globale.PemainPembersihan.HudEfekNasib != Null);
					If(Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan) >= 0);
						If(Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan)] == Globale.PemainPembersihan.HudEfekNasib);
							Destroy HUD Text(Globale.PemainPembersihan.HudEfekNasib);
							Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan)] = 0;
						End;
					End;
				End;
				If(Globale.PemainPembersihan.TeksVisiNasib != Null);
					If(Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan) >= 0);
						If(Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan)] == Globale.PemainPembersihan.TeksVisiNasib);
							Destroy In-World Text(Globale.PemainPembersihan.TeksVisiNasib);
							Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan)] = 0;
						End;
					End;
				End;
				If(Globale.PemainPembersihan.TeksTeleportasi != Null);
					If(Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan) >= 0);
						If(Globale.TeksTeleportasiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan)] == Globale.PemainPembersihan.TeksTeleportasi);
							Destroy In-World Text(Globale.PemainPembersihan.TeksTeleportasi);
							Globale.TeksTeleportasiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainPembersihan)] = 0;
						End;
					End;
				End;
				Globale.PemainPembersihan.IkonKartuNasib = Null;
				Globale.PemainPembersihan.IkonKebal = Null;
				Globale.PemainPembersihan.HudEfekNasib = Null;
				Globale.PemainPembersihan.TeksVisiNasib = Null;
				Globale.PemainPembersihan.TeksTeleportasi = Null;
				Globale.PemainPembersihan.HudKiri = Null;
				Globale.PemainPembersihan.HudMenu = Null;
				Globale.PemainPembersihan.TeksDunia = Null;
				Globale.PemainPembersihan.HudPemainDibuat = False;
				Globale.PemainPembersihan.SudahDiperiksa = False;
				"Hapus pilihan yang menunjuk pemain keluar sebelum slot entitas dapat dipakai ulang oleh orang lain."
				Set Player Variable(Filtered Array(Globale.PemainManusia, Player Variable(Current Array Element, PemainDipilih) == Globale.PemainPembersihan), PemainDipilih, Null);
				"Bersihkan pasangan utang dan klaim balas dendam sebelum referensi slot dapat dipakai ulang."
				For Global Variable(IndeksPemilih, 0, Count Of(Globale.PemainManusia), 1);
					If(Globale.PemainManusia[Globale.IndeksPemilih] != Globale.PemainPembersihan);
						Globale.IndeksDendamKeluar = Index Of Array Value(Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], PembunuhBalasDendam), Globale.PemainPembersihan);
						If(And(Globale.IndeksDendamKeluar >= 0, Globale.IndeksDendamKeluar < Count Of(Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], JumlahBalasDendam))));
							Modify Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], PembunuhBalasDendam, Remove From Array By Index, Globale.IndeksDendamKeluar);
							Modify Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], JumlahBalasDendam, Remove From Array By Index, Globale.IndeksDendamKeluar);
						End;
						If(Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], TargetBalasDendamTerkunci) == Globale.PemainPembersihan);
							Set Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], TargetBalasDendamTerkunci, Null);
						End;
						If(Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], TargetBalasDendamDipilih) == Globale.PemainPembersihan);
							Set Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], TargetBalasDendamDipilih, Null);
						End;
						If(Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], PenagihBalasDendam) == Globale.PemainPembersihan);
							Set Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], PenagihBalasDendam, Null);
							Set Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], KematianBalasDendam, False);
							Set Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], WaktuPaksaBerikut, 0);
							Set Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], WaktuPaksaBerakhir, 0);
						End;
					End;
				End;
				If(Globale.HudKiriPemain[Globale.IndeksPembersihan] != 0);
					Destroy HUD Text(Globale.HudKiriPemain[Globale.IndeksPembersihan]);
				End;
				If(Globale.HudMenuPemain[Globale.IndeksPembersihan] != 0);
					Destroy HUD Text(Globale.HudMenuPemain[Globale.IndeksPembersihan]);
				End;
				If(Globale.TeksDuniaPemain[Globale.IndeksPembersihan] != 0);
					Destroy In-World Text(Globale.TeksDuniaPemain[Globale.IndeksPembersihan]);
				End;
				Globale.SlotHUDTersedia = Sorted Array(Append To Array(Globale.SlotHUDTersedia, Globale.IndeksUtangKeluar), Current Array Element);
				Modify Global Variable(HudKiriPemain, Remove From Array By Index, Globale.IndeksPembersihan);
				Modify Global Variable(HudMenuPemain, Remove From Array By Index, Globale.IndeksPembersihan);
				Modify Global Variable(TeksDuniaPemain, Remove From Array By Index, Globale.IndeksPembersihan);
				Modify Global Variable(SlotHUDPemain, Remove From Array By Index, Globale.IndeksPembersihan);
				Modify Global Variable(PemainManusia, Remove From Array By Index, Globale.IndeksPembersihan);
				Globale.IndeksPemilih = Count Of(Globale.SlotHUDPemain);
				Globale.SlotHUDTerakhir = Globale.IndeksPemilih == 0 ? -1 : Last Of(Sorted Array(Globale.SlotHUDPemain, Current Array Element));
				Globale.PilihanPerluDihitung = True;
			End;
			If(Globale.IndeksKeluar == -2);
				If(Globale.IndeksPembersihan < Count Of(Globale.SlotHUDPemain));
					Destroy Icon(Globale.IkonKartuNasibPemain[Globale.SlotHUDPemain[Globale.IndeksPembersihan]]);
					Globale.IkonKartuNasibPemain[Globale.SlotHUDPemain[Globale.IndeksPembersihan]] = 0;
				End;
				If(Globale.IndeksPembersihan < Count Of(Globale.SlotHUDPemain));
					Destroy Icon(Globale.IkonKebalPemain[Globale.SlotHUDPemain[Globale.IndeksPembersihan]]);
					Globale.IkonKebalPemain[Globale.SlotHUDPemain[Globale.IndeksPembersihan]] = 0;
				End;
				If(Event Player.HudEfekNasib != Null);
					If(Index Of Array Value(Globale.PemilikTeksSementara, Event Player) >= 0);
						If(Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Event Player)] == Event Player.HudEfekNasib);
							Destroy HUD Text(Event Player.HudEfekNasib);
							Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Event Player)] = 0;
						End;
					End;
				End;
				If(Event Player.TeksVisiNasib != Null);
					If(Index Of Array Value(Globale.PemilikTeksSementara, Event Player) >= 0);
						If(Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Event Player)] == Event Player.TeksVisiNasib);
							Destroy In-World Text(Event Player.TeksVisiNasib);
							Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Event Player)] = 0;
						End;
					End;
				End;
				If(Event Player.TeksTeleportasi != Null);
					If(Index Of Array Value(Globale.PemilikTeksSementara, Event Player) >= 0);
						If(Globale.TeksTeleportasiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Event Player)] == Event Player.TeksTeleportasi);
							Destroy In-World Text(Event Player.TeksTeleportasi);
							Globale.TeksTeleportasiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Event Player)] = 0;
						End;
					End;
				End;
				Event Player.IkonKartuNasib = Null;
				Event Player.IkonKebal = Null;
				Event Player.HudEfekNasib = Null;
				Event Player.TeksVisiNasib = Null;
				Event Player.TeksTeleportasi = Null;
				Event Player.HudKiri = Null;
				Event Player.HudMenu = Null;
				Event Player.TeksDunia = Null;
				Event Player.HudPemainDibuat = False;
				Event Player.SudahDiperiksa = False;
				If(Globale.IndeksPembersihan < Count Of(Globale.HudKiriPemain));
					If(Globale.HudKiriPemain[Globale.IndeksPembersihan] != 0);
						Destroy HUD Text(Globale.HudKiriPemain[Globale.IndeksPembersihan]);
					End;
					Modify Global Variable(HudKiriPemain, Remove From Array By Index, Globale.IndeksPembersihan);
				End;
				If(Globale.IndeksPembersihan < Count Of(Globale.HudMenuPemain));
					If(Globale.HudMenuPemain[Globale.IndeksPembersihan] != 0);
						Destroy HUD Text(Globale.HudMenuPemain[Globale.IndeksPembersihan]);
					End;
					Modify Global Variable(HudMenuPemain, Remove From Array By Index, Globale.IndeksPembersihan);
				End;
				If(Globale.IndeksPembersihan < Count Of(Globale.TeksDuniaPemain));
					If(Globale.TeksDuniaPemain[Globale.IndeksPembersihan] != 0);
						Destroy In-World Text(Globale.TeksDuniaPemain[Globale.IndeksPembersihan]);
					End;
					Modify Global Variable(TeksDuniaPemain, Remove From Array By Index, Globale.IndeksPembersihan);
				End;
				If(Globale.IndeksPembersihan < Count Of(Globale.SlotHUDPemain));
					Globale.IndeksUtangKeluar = Globale.SlotHUDPemain[Globale.IndeksPembersihan];
					Modify Global Variable(SlotHUDPemain, Remove From Array By Index, Globale.IndeksPembersihan);
					Globale.SlotHUDTersedia = Append To Array(Globale.SlotHUDTersedia, Globale.IndeksUtangKeluar);
					Globale.SlotHUDTersedia = Sorted Array(Globale.SlotHUDTersedia, Current Array Element);
				End;
				Modify Global Variable(PemainManusia, Remove From Array By Index, Globale.IndeksPembersihan);
				Globale.IndeksPemilih = Count Of(Globale.SlotHUDPemain);
				Globale.SlotHUDTerakhir = Globale.IndeksPemilih == 0 ? -1 : Last Of(Sorted Array(Globale.SlotHUDPemain, Current Array Element));
				Globale.PilihanPerluDihitung = True;
			End;
		End;
		Globale.PemainTeksPembersihan = Event Player;
		Call Subroutine(BersihkanTeksYatim);
		Globale.IndeksKeluar = -1;
		Globale.IndeksPembersihan = -1;
		Globale.IndeksUtangKeluar = -1;
		Globale.IndeksDendamKeluar = -1;
		Globale.IndeksPemilih = 0;
		Globale.PemainPembersihan = Null;
	}
}

regola("93d - Subrutin: Bersihkan teks yatim")
{
	evento
	{
		Subroutine;
		BersihkanTeksYatim;
	}

	azioni
	{
		"Daftar tetap 24 slot meliputi manusia dan bot; ID tetap tersedia setelah entitas hilang."
		For Global Variable(KursorTeksPembersihan, 0, Count Of(Globale.PemilikTeksSementara), 1);
			If(Or(Globale.PemilikTeksSementara[Globale.KursorTeksPembersihan] != Null, Or(Globale.HudEfekSementara[Globale.KursorTeksPembersihan] != 0, Or(Globale.TeksTeleportasiSementara[Globale.KursorTeksPembersihan] != 0, Globale.TeksVisiSementara[Globale.KursorTeksPembersihan] != 0))));
			If(Or(Entity Exists(Globale.PemilikTeksSementara[Globale.KursorTeksPembersihan]) == False, And(Globale.PemainTeksPembersihan != Null, Globale.PemilikTeksSementara[Globale.KursorTeksPembersihan] == Globale.PemainTeksPembersihan)));
				If(Globale.HudEfekSementara[Globale.KursorTeksPembersihan] != 0);
					Destroy HUD Text(Globale.HudEfekSementara[Globale.KursorTeksPembersihan]);
				End;
				If(Globale.TeksTeleportasiSementara[Globale.KursorTeksPembersihan] != 0);
					Destroy In-World Text(Globale.TeksTeleportasiSementara[Globale.KursorTeksPembersihan]);
				End;
				If(Globale.TeksVisiSementara[Globale.KursorTeksPembersihan] != 0);
					Destroy In-World Text(Globale.TeksVisiSementara[Globale.KursorTeksPembersihan]);
				End;
				Globale.HudEfekSementara[Globale.KursorTeksPembersihan] = 0;
				Globale.TeksTeleportasiSementara[Globale.KursorTeksPembersihan] = 0;
				Globale.TeksVisiSementara[Globale.KursorTeksPembersihan] = 0;
				Globale.PemilikTeksSementara[Globale.KursorTeksPembersihan] = Null;
			End;
			End;
		End;
		Globale.PemainTeksPembersihan = Null;
		Globale.IndeksTeksPembersihan = -1;
		Globale.KursorTeksPembersihan = 0;
	}
}

regola("94 - Subrutin: Siapkan pemain dari ujung rambut sampai variabel")
{
	evento
	{
		Subroutine;
		SiapkanPemain;
	}

	azioni
	{
		Abort If(Is Dummy Bot(Event Player));
		Set Damage Received(Event Player, 100);
		Set Knockback Received(Event Player, 100);
		Enable Movement Collision With Players(Event Player);
		Stop Accelerating(Event Player);
		Stop Transforming Throttle(Event Player);
		Set Move Speed(Event Player, 100);
		Set Gravity(Event Player, 100);
		Enable Movement Collision With Environment(Event Player);
		Event Player.SudahDiperiksa = False;
		Event Player.BotOtomatis = False;
		Event Player.Manusia = False;
		Event Player.IndeksGenre = -1;
		Event Player.MusikKhusus = Null;
		Event Player.PembaruanDaftarTertunda = False;
		If(Or(Event Player.NamaTampilan == Null, Event Player.NamaTampilan == Custom String("")));
			Event Player.NamaTampilan = Null;
		End;
		Event Player.UrutanHUD = -1;
		Event Player.HudKiri = Null;
		Event Player.HudPemainDibuat = False;
		Event Player.MenuTerbuka = False;
		Event Player.KursorGenre = 0;
		Event Player.HudMenu = Null;
		Event Player.InspeksiAktif = False;
		Event Player.WaktuTeksTargetBerikut = 0;
		Event Player.TargetInspeksi = Null;
		Event Player.TeksDunia = Null;
		Event Player.ModeKamera = 0;
		Event Player.TargetKamera = Null;
		Event Player.SeranganDekatDipakai = False;
		Event Player.HalamanMenu = -1;
		Event Player.KursorUtama = 0;
		Event Player.KursorKamera = 0;
		Event Player.KursorWarna = 0;
		Event Player.IndeksWarna = 0;
		Event Player.WarnaNama = Custom Color(255, 255, 255, 255);
		Event Player.CalonTargetKamera = Null;
		Event Player.IndeksBahasa = 0;
		Event Player.KursorBahasa = 0;
		Event Player.DaftarTargetKamera = Empty Array;
		Event Player.KursorBalasDendam = 0;
		Event Player.DaftarTargetBalasDendam = Empty Array;
		Event Player.PembunuhBalasDendam = Empty Array;
		Event Player.JumlahBalasDendam = Empty Array;
		Event Player.IndeksBalasDendam = -1;
		Event Player.KematianBalasDendam = False;
		Event Player.PenagihBalasDendam = Null;
		Event Player.WaktuPaksaBerikut = 0;
		Event Player.WaktuPaksaBerakhir = 0;
		Event Player.KursorTeleportasi = 0;
		Event Player.DaftarTargetTeleportasi = Empty Array;
		Event Player.CalonTargetTeleportasi = Null;
		Event Player.TargetTeleportasiTeks = Null;
		Event Player.TeksTeleportasi = Null;
		Event Player.MasukanMenuDikunci = False;
		Event Player.TargetBalasDendamTerkunci = Null;
		Event Player.TargetBalasDendamDipilih = Null;
		Event Player.PelatNamaDinonaktifkan = False;
		Event Player.KunciBotAktif = False;
		Event Player.PahlawanTerakhir = Null;
		Event Player.DaftarTargetInspeksi = Empty Array;
		Event Player.PerintahMenu = 0;
		Event Player.JenisTeleportasiTerkunci = -1;
		Event Player.TargetTeleportasiTerkunci = Null;
		Event Player.KebalAktif = False;
		Event Player.KursorKebal = 0;
		Event Player.IndeksSuara = 0;
		Event Player.KursorSuara = 0;
		Event Player.TeleportasiJongkokAktif = False;
		Event Player.PerintahTeleportasi = 0;
		Event Player.InteraksiKameraDipakai = False;
		Event Player.PosisiMati = Vector(0, 0, 0);
		Event Player.PosisiBangkitAman = Vector(0, 0, 0);
		Event Player.BangkitLompatDipakai = False;
		Event Player.IndeksIkon = 0;
		Event Player.KursorIkon = 0;
		Event Player.WarnaMenu = Vector(255, 255, 255);
		Event Player.TeleportasiJongkokDiaktifkan = False;
		Event Player.KursorTeleportasiJongkok = 0;
		Event Player.PrivasiInspeksiAktif = False;
		Event Player.KursorPrivasiInspeksi = 0;
		Event Player.ModeKebal = 0;
		Event Player.IkonKebal = Null;
		If(Array Contains(Globale.PemainManusia, Event Player));
			Globale.IkonKebalPemain[Globale.SlotHUDPemain[Index Of Array Value(Globale.PemainManusia, Event Player)]] = 0;
		End;
		Event Player.KartuNasibAktif = False;
		Event Player.IkonKartuNasib = Null;
		If(Array Contains(Globale.PemainManusia, Event Player));
			Globale.IkonKartuNasibPemain[Globale.SlotHUDPemain[Index Of Array Value(Globale.PemainManusia, Event Player)]] = 0;
		End;
		Event Player.KursorPilihan = 0;
		Event Player.PemainDipilih = Null;
		Event Player.JumlahPilihan = 0;
		Event Player.PutaranKartuNasib = 0;
		Event Player.JedaKartuNasib = 0;
		Event Player.EfekNasib = 0;
		Event Player.EfekNasibBerakhir = 0;
		Event Player.PrivasiNasibAktif = False;
		Event Player.WaktuBakarNasibBerikut = 0;
		Event Player.WaktuPutaranNasibBerikut = 0;
		Event Player.WaktuIkonNasibBerakhir = 0;
		Event Player.MenuNasibHarusDibuka = False;
		Event Player.HudEfekNasib = Null;
		Event Player.TeksVisiNasib = Null;
		Event Player.TimTerakhir = Team Of(Event Player);
		Event Player.TimSiklusTarget = Team Of(Event Player);
		Event Player.WaktuTeleportasiBotBuatan = 0;
		Event Player.KursorTeleportasiBotBuatan = 0;
		Event Player.IzinkanBotBuatanMengikuti = False;
		Event Player.KursorIkutiBotBuatan = 0;
		Event Player.TargetIkutiBotBuatan = Null;
		Event Player.ModeHantuAktif = False;
		Event Player.ModeTerbangAktif = False;
		Event Player.KursorHantuTerbang = 0;
		Event Player.FisikaHantuTerbangDiterapkan = False;
		Event Player.WaktuBunuhDiriBerikut = 0;
		Event Player.WaktuMulaiTerbangMaju = -1;
		Event Player.PersenTerbang = 100;
		Event Player.ArahTerbang = Vector(0, 0, 0);
		Event Player.DeltaTerbang = Vector(0, 0, 0);
		Event Player.RantaiLampiran = Null;
		Event Player.IndeksRantaiLampiran = 0;
		Event Player.SiklusLampiran = False;
		Event Player.CalonTargetInspeksi = Null;
		Event Player.PosisiTujuanTeleportasi = Vector(0, 0, 0);
		Event Player.TargetLampiranTeleportasi = Null;
		Event Player.LampiranTeleportasiAktif = False;
		Event Player.PahlawanLampiranSendiri = Null;
		Event Player.PahlawanLampiranTarget = Null;
		Event Player.WaktuSiklusTim = 0;
		Event Player.PernahDisiapkan = True;
		Event Player.PindahTimDiproses = True;
		Event Player.SiklusPemainAktif = False;
		Event Player.SudahSiap = True;
	}
}

regola("95 - Subrutin: Segarkan daftar tontonan, termasuk para bot")
{
	evento
	{
		Subroutine;
		SegarkanTargetKamera;
	}

	azioni
	{
		If(And(Event Player.KursorKamera >= 2, Event Player.KursorKamera - 2 < Count Of(Event Player.DaftarTargetKamera)));
			Event Player.CalonTargetKamera = Event Player.DaftarTargetKamera[Event Player.KursorKamera - 2];
		Else;
			Event Player.CalonTargetKamera = Null;
		End;
		Call Subroutine(SegarkanTargetPublikPemain);
		Event Player.DaftarTargetKamera = Filtered Array(Event Player.DaftarTargetInspeksi, Has Spawned(Current Array Element) == True);
		If(And(Event Player.CalonTargetKamera != Null, Array Contains(Event Player.DaftarTargetKamera, Event Player.CalonTargetKamera)));
			Event Player.KursorKamera = Index Of Array Value(Event Player.DaftarTargetKamera, Event Player.CalonTargetKamera) + 2;
		Else If(Event Player.KursorKamera >= Count Of(Event Player.DaftarTargetKamera) + 2);
			Event Player.KursorKamera = 0;
		End;
	}
}

regola("96 - Subrutin: Cari target publik terdekat dari bidikan")
{
	evento
	{
		Subroutine;
		SegarkanTargetInspeksi;
	}

	azioni
	{
		If(Or(Event Player.CalonTargetInspeksi == Null, Or(Entity Exists(Event Player.CalonTargetInspeksi) == False, Or(Has Spawned(Event Player.CalonTargetInspeksi) == False, Or(Is Alive(Event Player.CalonTargetInspeksi) == False, And(And(Is Dummy Bot(Event Player.CalonTargetInspeksi) == False, Player Variable(Event Player.CalonTargetInspeksi, BotOtomatis) == False), Or(Player Variable(Event Player.CalonTargetInspeksi, Manusia) == False, Or(Player Variable(Event Player.CalonTargetInspeksi, PrivasiInspeksiAktif) == True, Player Variable(Event Player.CalonTargetInspeksi, PembaruanDaftarTertunda) == True))))))));
			Event Player.CalonTargetInspeksi = Null;
			Event Player.TargetInspeksi = Null;
		Else;
			Event Player.TargetInspeksi = Event Player.CalonTargetInspeksi;
		End;
	}
}

regola("97 - Subrutin: Segarkan daftar target balas dendam")
{
	evento
	{
		Subroutine;
		SegarkanTargetBalasDendam;
	}

	azioni
	{
		If(Event Player.KursorBalasDendam < Count Of(Event Player.DaftarTargetBalasDendam));
			Event Player.TargetBalasDendamDipilih = Event Player.DaftarTargetBalasDendam[Event Player.KursorBalasDendam];
		Else;
			Event Player.TargetBalasDendamDipilih = Null;
		End;
		Event Player.DaftarTargetBalasDendam = Filtered Array(Globale.PemainManusia, Current Array Element != Event Player);
		If(Count Of(Event Player.DaftarTargetBalasDendam) == 0);
			Event Player.KursorBalasDendam = 0;
		Else If(And(Event Player.TargetBalasDendamDipilih != Null, Array Contains(Event Player.DaftarTargetBalasDendam, Event Player.TargetBalasDendamDipilih)));
			Event Player.KursorBalasDendam = Index Of Array Value(Event Player.DaftarTargetBalasDendam, Event Player.TargetBalasDendamDipilih);
		Else If(Event Player.KursorBalasDendam >= Count Of(Event Player.DaftarTargetBalasDendam));
			Event Player.KursorBalasDendam = 0;
		End;
	}
}

regola("98 - Subrutin: Cari target teleportasi publik terdekat dari bidikan")
{
	evento
	{
		Subroutine;
		SegarkanTargetTeleportasi;
	}

	azioni
	{
		Call Subroutine(SegarkanTargetPublikPemain);
		Event Player.DaftarTargetTeleportasi = Event Player.DaftarTargetInspeksi;
		If(Count Of(Event Player.DaftarTargetTeleportasi) == 0);
			Event Player.CalonTargetTeleportasi = Null;
		Else;
			Event Player.CalonTargetTeleportasi = First Of(Sorted Array(Event Player.DaftarTargetTeleportasi, Angle Between Vectors(Facing Direction Of(Event Player), Direction Towards(Eye Position(Event Player), Eye Position(Current Array Element)))));
		End;
	}
}

regola("98a - Subrutin: Pulihkan status Nasib untuk pemain pemicu")
{
	evento
	{
		Subroutine;
		PulihkanNasibPemain;
	}

	azioni
	{
		If(Event Player.IkonKartuNasib != Null);
			Destroy Icon(Event Player.IkonKartuNasib);
		End;
		If(Event Player.HudEfekNasib != Null);
			If(Index Of Array Value(Globale.PemilikTeksSementara, Event Player) >= 0);
				If(Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Event Player)] == Event Player.HudEfekNasib);
					Destroy HUD Text(Event Player.HudEfekNasib);
					Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Event Player)] = 0;
				End;
			End;
		End;
		If(Event Player.TeksVisiNasib != Null);
			If(Index Of Array Value(Globale.PemilikTeksSementara, Event Player) >= 0);
				If(Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Event Player)] == Event Player.TeksVisiNasib);
					Destroy In-World Text(Event Player.TeksVisiNasib);
					Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Event Player)] = 0;
				End;
			End;
		End;
		Event Player.IkonKartuNasib = Null;
		If(Array Contains(Globale.PemainManusia, Event Player));
			Globale.IkonKartuNasibPemain[Globale.SlotHUDPemain[Index Of Array Value(Globale.PemainManusia, Event Player)]] = 0;
		End;
		Event Player.HudEfekNasib = Null;
		Event Player.TeksVisiNasib = Null;
		Clear Status(Event Player, Burning);
		Clear Status(Event Player, Hacked);
		Clear Status(Event Player, Unkillable);
		If(Event Player.EfekNasib == 2);
			Stop Accelerating(Event Player);
			Set Move Speed(Event Player, 100);
		End;
		Set Damage Received(Event Player, 100);
		Set Knockback Received(Event Player, 100);
		Enable Movement Collision With Players(Event Player);
		Set Jump Vertical Speed(Event Player, 100);
		Set Projectile Speed(Event Player, 100);
		Event Player.KartuNasibAktif = False;
		Event Player.PutaranKartuNasib = 0;
		Event Player.JedaKartuNasib = 0;
		Event Player.EfekNasib = 0;
		Event Player.EfekNasibBerakhir = 0;
		Event Player.PrivasiNasibAktif = False;
		Event Player.WaktuBakarNasibBerikut = 0;
		Event Player.WaktuPutaranNasibBerikut = 0;
		Event Player.WaktuIkonNasibBerakhir = 0;
		Event Player.WaktuPaksaBerikut = 0;
		Event Player.WaktuPaksaBerakhir = 0;
		Event Player.MenuNasibHarusDibuka = False;
		Event Player.KebalAktif = Event Player.ModeKebal != 0;
		Event Player.MasukanMenuDikunci = False;
		Event Player.PerintahMenu = 0;
		Allow Button(Event Player, Button(Primary Fire));
		Allow Button(Event Player, Button(Secondary Fire));
		Allow Button(Event Player, Button(Interact));
		Allow Button(Event Player, Button(Reload));
		Allow Button(Event Player, Button(Ability 1));
		Allow Button(Event Player, Button(Ability 2));
		Allow Button(Event Player, Button(Ultimate));
	}
}

regola("98b - Subrutin: Pulihkan status Nasib untuk pemain aktif global")
{
	evento
	{
		Subroutine;
		PulihkanNasibAktif;
	}

	azioni
	{
		Abort If(Or(Globale.PemainAktif == Null, Entity Exists(Globale.PemainAktif) == False));
		If(Globale.PemainAktif.IkonKartuNasib != Null);
			Destroy Icon(Globale.PemainAktif.IkonKartuNasib);
		End;
		If(Globale.PemainAktif.HudEfekNasib != Null);
			If(Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainAktif) >= 0);
				If(Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainAktif)] == Globale.PemainAktif.HudEfekNasib);
					Destroy HUD Text(Globale.PemainAktif.HudEfekNasib);
					Globale.HudEfekSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainAktif)] = 0;
				End;
			End;
		End;
		If(Globale.PemainAktif.TeksVisiNasib != Null);
			If(Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainAktif) >= 0);
				If(Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainAktif)] == Globale.PemainAktif.TeksVisiNasib);
					Destroy In-World Text(Globale.PemainAktif.TeksVisiNasib);
					Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, Globale.PemainAktif)] = 0;
				End;
			End;
		End;
		Globale.PemainAktif.IkonKartuNasib = Null;
		If(Array Contains(Globale.PemainManusia, Globale.PemainAktif));
			Globale.IkonKartuNasibPemain[Globale.SlotHUDPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif)]] = 0;
		End;
		Globale.PemainAktif.HudEfekNasib = Null;
		Globale.PemainAktif.TeksVisiNasib = Null;
		Clear Status(Globale.PemainAktif, Burning);
		Clear Status(Globale.PemainAktif, Hacked);
		If(Or(Globale.PemainAktif.ModeKebal == 0, Is Alive(Globale.PemainAktif) == False));
			Clear Status(Globale.PemainAktif, Unkillable);
			Set Damage Received(Globale.PemainAktif, 100);
			Set Knockback Received(Globale.PemainAktif, 100);
			Enable Movement Collision With Players(Globale.PemainAktif);
		End;
		If(Globale.PemainAktif.EfekNasib == 2);
			Stop Accelerating(Globale.PemainAktif);
			Set Move Speed(Globale.PemainAktif, 100);
		End;
		Set Jump Vertical Speed(Globale.PemainAktif, 100);
		Set Projectile Speed(Globale.PemainAktif, 100);
		Globale.PemainAktif.KartuNasibAktif = False;
		Globale.PemainAktif.PutaranKartuNasib = 0;
		Globale.PemainAktif.JedaKartuNasib = 0;
		Globale.PemainAktif.EfekNasib = 0;
		Globale.PemainAktif.EfekNasibBerakhir = 0;
		Globale.PemainAktif.PrivasiNasibAktif = False;
		Globale.PemainAktif.WaktuBakarNasibBerikut = 0;
		Globale.PemainAktif.WaktuPutaranNasibBerikut = 0;
		Globale.PemainAktif.WaktuIkonNasibBerakhir = 0;
		Globale.PemainAktif.WaktuPaksaBerikut = 0;
		Globale.PemainAktif.WaktuPaksaBerakhir = 0;
		Globale.PemainAktif.MenuNasibHarusDibuka = False;
		Globale.PemainAktif.KebalAktif = Globale.PemainAktif.ModeKebal != 0;
		Globale.PemainAktif.MasukanMenuDikunci = False;
		Globale.PemainAktif.PerintahMenu = 0;
		Allow Button(Globale.PemainAktif, Button(Primary Fire));
		Allow Button(Globale.PemainAktif, Button(Secondary Fire));
		Allow Button(Globale.PemainAktif, Button(Interact));
		Allow Button(Globale.PemainAktif, Button(Reload));
		Allow Button(Globale.PemainAktif, Button(Ability 1));
		Allow Button(Globale.PemainAktif, Button(Ability 2));
		Allow Button(Globale.PemainAktif, Button(Ultimate));
	}
}

regola("98c - Subrutin: Segarkan daftar target publik untuk pemain pemicu")
{
	evento
	{
		Subroutine;
		SegarkanTargetPublikPemain;
	}

	azioni
	{
		Event Player.DaftarTargetInspeksi = Filtered Array(All Players(All Teams), And(Current Array Element != Event Player, And(Entity Exists(Current Array Element), And(Is Alive(Current Array Element), Or(Is Dummy Bot(Current Array Element) == True, Or(Player Variable(Current Array Element, BotOtomatis) == True, And(Player Variable(Current Array Element, Manusia) == True, And(Player Variable(Current Array Element, PrivasiInspeksiAktif) == False, Player Variable(Current Array Element, PembaruanDaftarTertunda) == False))))))));
	}
}

regola("98d - Subrutin: Segarkan daftar target publik untuk pemain aktif global")
{
	evento
	{
		Subroutine;
		SegarkanTargetPublikAktif;
	}

	azioni
	{
		Abort If(Or(Globale.PemainAktif == Null, Entity Exists(Globale.PemainAktif) == False));
		Set Player Variable(Globale.PemainAktif, DaftarTargetInspeksi, Filtered Array(All Players(All Teams), And(Current Array Element != Globale.PemainAktif, And(Entity Exists(Current Array Element), And(Is Alive(Current Array Element), Or(Is Dummy Bot(Current Array Element) == True, Or(Player Variable(Current Array Element, BotOtomatis) == True, And(Player Variable(Current Array Element, Manusia) == True, And(Player Variable(Current Array Element, PrivasiInspeksiAktif) == False, Player Variable(Current Array Element, PembaruanDaftarTertunda) == False)))))))));
	}
}

regola("98e - Subrutin: Buat bot buatan sesuai tim aktif")
{
	evento
	{
		Subroutine;
		BuatBotBuatanTim;
	}

	azioni
	{
		Create Dummy Bot(Tutti gli eroi, Globale.TimBotBuatanAktif, -1, Position Of(First Of(Spawn Points(Globale.TimBotBuatanAktif))), Vector(0, 0, 1));
	}
}

regola("98f - Subrutin: Lepas bot buatan sesuai tim aktif")
{
	evento
	{
		Subroutine;
		LepasBotBuatanTim;
	}

	azioni
	{
		Abort If(Count Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element) == True)) == 0);
		If(Player Variable(First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element) == True)), TeksVisiNasib) != Null);
			If(Index Of Array Value(Globale.PemilikTeksSementara, First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element) == True))) >= 0);
				If(Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element) == True)))] == Player Variable(First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element) == True)), TeksVisiNasib));
					Destroy In-World Text(Player Variable(First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element) == True)), TeksVisiNasib));
					Globale.TeksVisiSementara[Index Of Array Value(Globale.PemilikTeksSementara, First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element) == True)))] = 0;
				End;
			End;
		End;
		Stop Facing(First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element) == True)));
		Stop Throttle In Direction(First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element) == True)));
		Destroy Dummy Bot(Globale.TimBotBuatanAktif, Slot Of(First Of(Filtered Array(All Players(Globale.TimBotBuatanAktif), Is Dummy Bot(Current Array Element) == True))));
	}
}

regola("98g - Subrutin: Teleportasi ke ruang muncul")
{
	evento
	{
		Subroutine;
		TeleportasiKeRuangMuncul;
	}

	azioni
	{
		If(Is In Spawn Room(Event Player) == True);
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Already in Spawn Room. Home sweet home!") : Event Player.IndeksBahasa == 1 ? Custom String("Sudah di ruang muncul. Beres!") : Custom String("อยู่ในห้องเกิดแล้ว ถึงที่หมาย!"));
		Else If(Count Of(Spawn Points(Team Of(Event Player))) == 0);
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Spawn Room unavailable.") : Event Player.IndeksBahasa == 1 ? Custom String("Ruang muncul belum tersedia di peta ini.") : Custom String("ห้องเกิดในแผนที่นี้ยังไม่พร้อม"));
		Else;
			Teleport(Event Player, Position Of(First Of(Spawn Points(Team Of(Event Player)))));
		End;
	}
}

regola("98h - Subrutin: Teleportasi ke objektif mode aktif")
{
	evento
	{
		Subroutine;
		TeleportasiKeObjektif;
	}

	azioni
	{
		Event Player.PosisiTujuanTeleportasi = Vector(0, 0, 0);
		If(Or(Current Game Mode == Game Mode(Trasporto), Current Game Mode == Game Mode(Ibrida)));
			If(Distance Between(Payload Position, Vector(0, 0, 0)) > 0.100);
				Event Player.PosisiTujuanTeleportasi = Payload Position + Vector(2, 0, 0);
			End;
		Else If(Current Game Mode == Game Mode(Cattura la Bandiera));
			If(Distance Between(Flag Position(Opposite Team Of(Team Of(Event Player))), Vector(0, 0, 0)) > 0.100);
				Event Player.PosisiTujuanTeleportasi = Flag Position(Opposite Team Of(Team Of(Event Player))) + Vector(2, 0, 0);
			End;
		Else If(Current Game Mode == Game Mode(Scorta));
			If(Count Of(Filtered Array(All Players(All Teams), And(Has Spawned(Current Array Element) == True, And(Is Alive(Current Array Element) == True, Is On Objective(Current Array Element) == True)))) > 0);
				Event Player.PosisiTujuanTeleportasi = Position Of(First Of(Filtered Array(All Players(All Teams), And(Has Spawned(Current Array Element) == True, And(Is Alive(Current Array Element) == True, Is On Objective(Current Array Element) == True))))) + Vector(2, 0, 0);
			Else If(Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) > 0.100);
				Event Player.PosisiTujuanTeleportasi = Objective Position(Objective Index);
			End;
		Else If(Or(Or(Current Game Mode == Game Mode(Punto Critico), Current Game Mode == Game Mode(Controllo)), Or(Current Game Mode == Game Mode(Scontro), Current Game Mode == Game Mode(Conquista))));
			If(Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) > 0.100);
				Event Player.PosisiTujuanTeleportasi = Objective Position(Objective Index);
			End;
		Else If(Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) > 0.100);
			Event Player.PosisiTujuanTeleportasi = Objective Position(Objective Index);
		End;
		If(Distance Between(Event Player.PosisiTujuanTeleportasi, Vector(0, 0, 0)) <= 0.100);
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Objective unavailable.") : Event Player.IndeksBahasa == 1 ? Custom String("Posisi objektif belum tersedia.") : Custom String("จุดภารกิจยังไม่พร้อม"));
			Abort;
		End;
		Call Subroutine(CariPosisiTeleportasiAman);
		If(Distance Between(Event Player.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100);
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("No safe walkable spot near the objective.") : Event Player.IndeksBahasa == 1 ? Custom String("Tak ada pijakan aman dekat objektif.") : Custom String("ไม่มีจุดเดินที่ปลอดภัยใกล้ภารกิจ"));
			Abort;
		End;
		Teleport(Event Player, Event Player.PosisiBangkitAman);
		If(Or(Current Game Mode == Game Mode(Trasporto), Current Game Mode == Game Mode(Ibrida)));
		Else If(Current Game Mode == Game Mode(Cattura la Bandiera));
		Else If(Current Game Mode == Game Mode(Scorta));
		Else;
		End;
	}
}

regola("98i - Subrutin: Teleportasi ke target pemain")
{
	evento
	{
		Subroutine;
		TeleportasiKeTarget;
	}

	azioni
	{
		If(Or(Or(Event Player.TargetTeleportasiTerkunci == Null, Entity Exists(Event Player.TargetTeleportasiTerkunci) == False), Or(Is Alive(Event Player.TargetTeleportasiTerkunci) == False, Array Contains(Event Player.DaftarTargetTeleportasi, Event Player.TargetTeleportasiTerkunci) == False)));
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Target unavailable. Teleport has standards.") : Event Player.IndeksBahasa == 1 ? Custom String("Target tak tersedia. Teleportasi ikut rehat!") : Custom String("เป้าหมายไม่พร้อม วาร์ปพักก่อน!"));
			Abort;
		End;
		Event Player.PosisiTujuanTeleportasi = Position Of(Event Player.TargetTeleportasiTerkunci) - Facing Direction Of(Event Player.TargetTeleportasiTerkunci) * 2.250;
		Call Subroutine(CariPosisiTeleportasiAman);
		If(Distance Between(Event Player.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100);
			Event Player.PosisiTujuanTeleportasi = Position Of(Event Player.TargetTeleportasiTerkunci) + Facing Direction Of(Event Player.TargetTeleportasiTerkunci) * 2.250;
			Call Subroutine(CariPosisiTeleportasiAman);
		End;
		If(Distance Between(Event Player.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100);
			Event Player.PosisiTujuanTeleportasi = Position Of(Event Player.TargetTeleportasiTerkunci) + Vector(2.250, 0, 0);
			Call Subroutine(CariPosisiTeleportasiAman);
		End;
		If(Distance Between(Event Player.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100);
			Event Player.PosisiTujuanTeleportasi = Position Of(Event Player.TargetTeleportasiTerkunci) + Vector(-2.250, 0, 0);
			Call Subroutine(CariPosisiTeleportasiAman);
		End;
		If(Distance Between(Event Player.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100);
			Event Player.PosisiTujuanTeleportasi = Position Of(Event Player.TargetTeleportasiTerkunci) + Vector(0, 0, 2.250);
			Call Subroutine(CariPosisiTeleportasiAman);
		End;
		If(Distance Between(Event Player.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100);
			Event Player.PosisiTujuanTeleportasi = Position Of(Event Player.TargetTeleportasiTerkunci) + Vector(0, 0, -2.250);
			Call Subroutine(CariPosisiTeleportasiAman);
		End;
		If(Distance Between(Event Player.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100);
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("No safe walkable spot near that target.") : Event Player.IndeksBahasa == 1 ? Custom String("Tak ada pijakan aman dekat target itu.") : Custom String("ไม่มีจุดเดินที่ปลอดภัยใกล้เป้าหมาย"));
			Abort;
		End;
		Teleport(Event Player, Event Player.PosisiBangkitAman);
	}
}

regola("98j - Subrutin: Cari posisi teleportasi aman")
{
	evento
	{
		Subroutine;
		CariPosisiTeleportasiAman;
	}

	azioni
	{
		Event Player.PosisiBangkitAman = Vector(0, 0, 0);
		Abort If(Distance Between(Event Player.PosisiTujuanTeleportasi, Vector(0, 0, 0)) <= 0.100);
		Event Player.PosisiBangkitAman = Nearest Walkable Position(Event Player.PosisiTujuanTeleportasi);
		If(Distance Between(Event Player.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100);
			Event Player.PosisiBangkitAman = Vector(0, 0, 0);
			Abort;
		End;
		"Jauhkan titik teleportasi dari dinding sebelum memeriksa tanah dan jalur akhir."
		If(Distance Between(Ray Cast Hit Position(Event Player.PosisiBangkitAman + Vector(0, 1, 0), Event Player.PosisiBangkitAman + Vector(1.500, 1, 0), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman + Vector(0, 1, 0)) < 1.250);
			Event Player.PosisiBangkitAman = Nearest Walkable Position(Event Player.PosisiBangkitAman + Vector(-1.500, 0, 0));
		End;
		If(Distance Between(Ray Cast Hit Position(Event Player.PosisiBangkitAman + Vector(0, 1, 0), Event Player.PosisiBangkitAman + Vector(-1.500, 1, 0), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman + Vector(0, 1, 0)) < 1.250);
			Event Player.PosisiBangkitAman = Nearest Walkable Position(Event Player.PosisiBangkitAman + Vector(1.500, 0, 0));
		End;
		If(Distance Between(Ray Cast Hit Position(Event Player.PosisiBangkitAman + Vector(0, 1, 0), Event Player.PosisiBangkitAman + Vector(0, 1, 1.500), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman + Vector(0, 1, 0)) < 1.250);
			Event Player.PosisiBangkitAman = Nearest Walkable Position(Event Player.PosisiBangkitAman + Vector(0, 0, -1.500));
		End;
		If(Distance Between(Ray Cast Hit Position(Event Player.PosisiBangkitAman + Vector(0, 1, 0), Event Player.PosisiBangkitAman + Vector(0, 1, -1.500), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman + Vector(0, 1, 0)) < 1.250);
			Event Player.PosisiBangkitAman = Nearest Walkable Position(Event Player.PosisiBangkitAman + Vector(0, 0, 1.500));
		End;
		If(Distance Between(Event Player.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100);
			Event Player.PosisiBangkitAman = Vector(0, 0, 0);
			Abort;
		End;
		If(Distance Between(Ray Cast Hit Position(Event Player.PosisiBangkitAman + Vector(0, 1, 0), Event Player.PosisiBangkitAman + Vector(1.000, 1, 0), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman + Vector(0, 1, 0)) < 0.850);
			Event Player.PosisiBangkitAman = Vector(0, 0, 0);
			Abort;
		End;
		If(Distance Between(Ray Cast Hit Position(Event Player.PosisiBangkitAman + Vector(0, 1, 0), Event Player.PosisiBangkitAman + Vector(-1.000, 1, 0), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman + Vector(0, 1, 0)) < 0.850);
			Event Player.PosisiBangkitAman = Vector(0, 0, 0);
			Abort;
		End;
		If(Distance Between(Ray Cast Hit Position(Event Player.PosisiBangkitAman + Vector(0, 1, 0), Event Player.PosisiBangkitAman + Vector(0, 1, 1.000), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman + Vector(0, 1, 0)) < 0.850);
			Event Player.PosisiBangkitAman = Vector(0, 0, 0);
			Abort;
		End;
		If(Distance Between(Ray Cast Hit Position(Event Player.PosisiBangkitAman + Vector(0, 1, 0), Event Player.PosisiBangkitAman + Vector(0, 1, -1.000), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman + Vector(0, 1, 0)) < 0.850);
			Event Player.PosisiBangkitAman = Vector(0, 0, 0);
			Abort;
		End;
		If(Distance Between(Ray Cast Hit Position(Event Player.PosisiBangkitAman + Vector(0, 0.250, 0), Event Player.PosisiBangkitAman + Vector(0, 2.500, 0), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman + Vector(0, 0.250, 0)) < 2.000);
			Event Player.PosisiBangkitAman = Vector(0, 0, 0);
			Abort;
		End;
		If(Distance Between(Event Player.PosisiBangkitAman, Event Player.PosisiTujuanTeleportasi) > 8);
			Event Player.PosisiBangkitAman = Vector(0, 0, 0);
			Abort;
		End;
		If(Distance Between(Ray Cast Hit Position(Event Player.PosisiBangkitAman + Vector(0, 5, 0), Event Player.PosisiBangkitAman - Vector(0, 20, 0), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman) > 6);
			Event Player.PosisiBangkitAman = Vector(0, 0, 0);
			Abort;
		End;
		If(Distance Between(Ray Cast Hit Position(Event Player.PosisiTujuanTeleportasi + Vector(0, 1, 0), Event Player.PosisiBangkitAman + Vector(0, 1, 0), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman + Vector(0, 1, 0)) > 0.750);
			Event Player.PosisiBangkitAman = Vector(0, 0, 0);
		End;
		If(Distance Between(Event Player.PosisiBangkitAman, Vector(0, 0, 0)) > 0.100);
			"Periksa lagi ruang badan dan kepala setelah semua koreksi dinding; titik sempit dibatalkan agar pemanggil mencoba posisi lain."
			If(Distance Between(Ray Cast Hit Position(Event Player.PosisiBangkitAman + Vector(0, 1.000, 0), Event Player.PosisiBangkitAman + Vector(1.500, 1.000, 0), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman + Vector(0, 1.000, 0)) < 1.250);
				Event Player.PosisiBangkitAman = Vector(0, 0, 0);
				Abort;
			End;
			If(Distance Between(Ray Cast Hit Position(Event Player.PosisiBangkitAman + Vector(0, 1.000, 0), Event Player.PosisiBangkitAman + Vector(-1.500, 1.000, 0), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman + Vector(0, 1.000, 0)) < 1.250);
				Event Player.PosisiBangkitAman = Vector(0, 0, 0);
				Abort;
			End;
			If(Distance Between(Ray Cast Hit Position(Event Player.PosisiBangkitAman + Vector(0, 1.000, 0), Event Player.PosisiBangkitAman + Vector(0, 1.000, 1.500), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman + Vector(0, 1.000, 0)) < 1.250);
				Event Player.PosisiBangkitAman = Vector(0, 0, 0);
				Abort;
			End;
			If(Distance Between(Ray Cast Hit Position(Event Player.PosisiBangkitAman + Vector(0, 1.000, 0), Event Player.PosisiBangkitAman + Vector(0, 1.000, -1.500), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman + Vector(0, 1.000, 0)) < 1.250);
				Event Player.PosisiBangkitAman = Vector(0, 0, 0);
				Abort;
			End;
			If(Distance Between(Ray Cast Hit Position(Event Player.PosisiBangkitAman + Vector(0, 0.500, 0), Event Player.PosisiBangkitAman + Vector(0, 2.750, 0), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman + Vector(0, 0.500, 0)) < 2.000);
				Event Player.PosisiBangkitAman = Vector(0, 0, 0);
				Abort;
			End;
			Event Player.PosisiBangkitAman += Vector(0, 0.500, 0);
		End;
	}
}
