	azioni
	{
		Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String("Hold CROUCH + command\n{0}: next | {1}: prev", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: apply | {1}: back", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))) : Event Player.IndeksBahasa == 1 ? Custom String("{0}\n{1}", Custom String("Tahan JONGKOK + tombol\n{0}: maju | {1}: mundur", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: pakai | {1}: kembali", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))) : Custom String("{0}\n{1}", Custom String("ย่อค้าง + ปุ่มคำสั่ง\n{0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: ใช้ | {1}: กลับ", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))), Event Player.IndeksBahasa == 0 ? Custom String("{0}\n> {1}", Custom String("9 - CROUCH PRIVACY {0}/2\nHIDE INFO + BLOCK CUSTOM CAM: {1}", Event Player.KursorPrivasiInspeksi + 1, Event Player.PrivasiInspeksiAktif ? Custom String("ON") : Custom String("OFF")), Event Player.KursorPrivasiInspeksi == 1 ? Custom String("ON") : Custom String("OFF")) : Event Player.IndeksBahasa == 1 ? Custom String("{0}\n> {1}", Custom String("9 - PRIVASI JONGKOK {0}/2\nSEMBUNYIKAN INFO + BLOKIR KAMERA KUSTOM: {1}", Event Player.KursorPrivasiInspeksi + 1, Event Player.PrivasiInspeksiAktif ? Custom String("AKTIF") : Custom String("MATI")), Event Player.KursorPrivasiInspeksi == 1 ? Custom String("AKTIF") : Custom String("MATI")) : Custom String("{0}\n> {1}", Custom String("9 - ย่อแบบส่วนตัว {0}/2\nซ่อนข้อมูล + กันกล้องกำหนดเอง: {1}", Event Player.KursorPrivasiInspeksi + 1, Event Player.PrivasiInspeksiAktif ? Custom String("เปิด") : Custom String("ปิด")), Event Player.KursorPrivasiInspeksi == 1 ? Custom String("เปิด") : Custom String("ปิด")), Top, 3, Custom Color(255, 255, 255, 255), Custom Color(255, 220, 238, 255), Custom Color(X Component Of(Event Player.WarnaMenu), Y Component Of(Event Player.WarnaMenu), Z Component Of(Event Player.WarnaMenu), 255), Visible To String and Color, Visible Never);
		Event Player.HudMenu = Last Text ID;
	}
}

regola("91n - Subrutin: Gambar kartu nasib")
{
	evento
	{
		Subroutine;
		GambarNasib;
	}

	azioni
	{
		Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String("Hold CROUCH + command\n{0}: spin | {1}: back", Input Binding String(Button(Interact)), Input Binding String(Button(Reload))), Custom String("Hold {0} 0.5s: close", Input Binding String(Button(Melee)))) : Event Player.IndeksBahasa == 1 ? Custom String("{0}\n{1}", Custom String("Tahan JONGKOK + tombol\n{0}: putar | {1}: kembali", Input Binding String(Button(Interact)), Input Binding String(Button(Reload))), Custom String("Tahan {0} 0,5 dtk: tutup", Input Binding String(Button(Melee)))) : Custom String("{0}\n{1}", Custom String("ย่อค้าง + ปุ่มคำสั่ง\n{0}: หมุน | {1}: กลับ", Input Binding String(Button(Interact)), Input Binding String(Button(Reload))), Custom String("กด {0} ค้าง 0.5 วิ: ปิด", Input Binding String(Button(Melee)))), Event Player.IndeksBahasa == 0 ? Custom String("10 - TRY YOUR LUCK\nSTATUS: {0}\n> {1}", Event Player.KartuNasibAktif ? Event Player.PutaranKartuNasib > 0 ? Custom String("ROLLING") : Custom String("ACTIVE") : Custom String("READY"), Event Player.KartuNasibAktif ? Custom String("WATCH IT SPIN") : Custom String("GIVE IT A SPIN")) : Event Player.IndeksBahasa == 1 ? Custom String("10 - COBA NASIB\nSTATUS: {0}\n> {1}", Event Player.KartuNasibAktif ? Event Player.PutaranKartuNasib > 0 ? Custom String("BERPUTAR") : Custom String("AKTIF") : Custom String("SIAP"), Event Player.KartuNasibAktif ? Custom String("LIHAT PUTARAN") : Custom String("PUTAR NASIB!")) : Custom String("10 - เสี่ยงโชค\nสถานะ: {0}\n> {1}", Event Player.KartuNasibAktif ? Event Player.PutaranKartuNasib > 0 ? Custom String("กำลังสุ่ม") : Custom String("มีผลอยู่") : Custom String("พร้อม"), Event Player.KartuNasibAktif ? Custom String("ดูรูเล็ต") : Custom String("เริ่มรูเล็ต")), Top, 3, Custom Color(255, 255, 255, 255), Custom Color(255, 240, 190, 255), Custom Color(X Component Of(Event Player.WarnaMenu), Y Component Of(Event Player.WarnaMenu), Z Component Of(Event Player.WarnaMenu), 255), Visible To String and Color, Visible Never);
		Event Player.HudMenu = Last Text ID;
	}
}

regola("91p - Subrutin: Gambar halaman aktif")
{
	evento
	{
		Subroutine;
		GambarHalamanAktif;
	}

	azioni
	{
		If(Event Player.HalamanMenu == -1);
			Call Subroutine(GambarUtama);
		Else If(Event Player.HalamanMenu == 0);
			Call Subroutine(GambarWarna);
		Else If(Event Player.HalamanMenu == 1);
			Call Subroutine(GambarKamera);
		Else If(Event Player.HalamanMenu == 2);
			Call Subroutine(GambarMusik);
		Else If(Event Player.HalamanMenu == 3);
			Call Subroutine(GambarBahasa);
		Else If(Event Player.HalamanMenu == 4);
			Call Subroutine(GambarBalasDendam);
		Else If(Event Player.HalamanMenu == 5);
			Call Subroutine(GambarKebal);
		Else If(Event Player.HalamanMenu == 6);
			Call Subroutine(GambarSuara);
		Else If(Event Player.HalamanMenu == 7);
			Call Subroutine(GambarIkon);
		Else If(Event Player.HalamanMenu == 8);
			Call Subroutine(GambarSakelarTeleportasi);
		Else If(Event Player.HalamanMenu == 9);
			Call Subroutine(GambarPrivasiInspeksi);
		Else If(Event Player.HalamanMenu == 10);
			Call Subroutine(GambarNasib);
		Else If(Event Player.HalamanMenu == 11);
			Call Subroutine(GambarPilihan);
		Else If(Event Player.HalamanMenu == 12);
			Call Subroutine(GambarIkutiBotBuatan);
		Else If(Event Player.HalamanMenu == 13);
			Call Subroutine(GambarHantuTerbang);
		End;
	}
}

regola("91k - Subrutin: Transisi warna menu tanpa lompatan")
{
	evento
	{
		Subroutine;
		TransisiWarnaMenu;
	}

	azioni
	{
		If(Event Player.TeleportasiJongkokAktif == True);
			Chase Player Variable Over Time(Event Player, WarnaMenu, Event Player.KursorTeleportasi == 0 ? Vector(80, 255, 160) : Event Player.KursorTeleportasi == 1 ? Vector(65, 225, 255) : Event Player.KursorTeleportasi == 2 ? Vector(95, 150, 255) : Event Player.KursorTeleportasi == 3 ? Vector(195, 100, 255) : Vector(255, 85, 135), 0.180, Destination and Duration);
		Else;
		"Setiap halaman punya nuansa sendiri, tetapi semuanya berangkat dari Warna Nama aktif."
		Chase Player Variable Over Time(Event Player, WarnaMenu, (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 0 ? Globale.DaftarWarnaRGB[Event Player.KursorWarna] : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 1 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.700 + Vector(70, 135, 255) * 0.300 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 2 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.680 + Vector(55, 235, 245) * 0.320 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 3 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.720 + Vector(185, 105, 255) * 0.280 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 4 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.690 + Vector(255, 75, 85) * 0.310 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 5 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.700 + Vector(255, 145, 55) * 0.300 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 6 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.680 + Vector(255, 80, 205) * 0.320 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 7 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.730 + Vector(170, 240, 85) * 0.270 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 8 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.700 + Vector(65, 225, 130) * 0.300 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 9 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.720 + Vector(55, 190, 170) * 0.280 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 10 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.660 + Vector(255, 210, 70) * 0.340 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 11 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.720 + Vector(255, 120, 155) * 0.280 : (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 12 ? Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.700 + Vector(70, 220, 175) * 0.300 : Globale.DaftarWarnaRGB[Event Player.IndeksWarna], 0.180, Destination and Duration);
		If((Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 13);
			Chase Player Variable Over Time(Event Player, WarnaMenu, Globale.DaftarWarnaRGB[Event Player.IndeksWarna] * 0.680 + Vector(110, 170, 255) * 0.320, 0.180, Destination and Duration);
		End;
		End;
	}
}

regola("92 - Subrutin: Kunci bot, kaki tetap bisa bergerak")
{
	evento
	{
		Subroutine;
		KunciBot;
	}

	azioni
	{
		Abort If(Entity Exists(Event Player) == False);
		Abort If(Is Alive(Event Player) == False);
		Event Player.MenuTerbuka = False;
		Event Player.SeranganDekatDipakai = False;
		Event Player.HalamanMenu = -1;
		Set Primary Fire Enabled(Event Player, False);
		Set Secondary Fire Enabled(Event Player, False);
		Set Ability 1 Enabled(Event Player, False);
		Set Ability 2 Enabled(Event Player, False);
		Set Ultimate Ability Enabled(Event Player, False);
		Set Melee Enabled(Event Player, False);
		Disallow Button(Event Player, Button(Primary Fire));
		Disallow Button(Event Player, Button(Secondary Fire));
		Disallow Button(Event Player, Button(Ability 1));
		Disallow Button(Event Player, Button(Ability 2));
		Disallow Button(Event Player, Button(Ultimate));
		Disallow Button(Event Player, Button(Melee));
		Disallow Button(Event Player, Button(Jump));
		Disallow Button(Event Player, Button(Reload));
		Disallow Button(Event Player, Button(Interact));
		Set Damage Dealt(Event Player, 0);
		Set Healing Dealt(Event Player, 0);
		Set Knockback Dealt(Event Player, 0);
		Set Damage Received(Event Player, 100);
		Set Knockback Received(Event Player, 100);
		Set Move Speed(Event Player, 20);
		Event Player.PahlawanTerakhir = Hero Of(Event Player);
		Event Player.TargetIkutiBotBuatan = Null;
		Event Player.KunciBotAktif = True;
		Disable Nameplates(Event Player, Filtered Array(Globale.PemainManusia, Player Variable(Current Array Element, PelatNamaDinonaktifkan) == True));
	}
}

regola("91o - Subrutin: Gambar menu pilihan pemain")
{
	evento
	{
		Subroutine;
		GambarPilihan;
	}

	azioni
	{
		Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String("Hold CROUCH + command\n{0}: next | {1}: prev", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: vote | {1}: back", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))) : Event Player.IndeksBahasa == 1 ? Custom String("{0}\n{1}", Custom String("Tahan JONGKOK + tombol\n{0}: maju | {1}: mundur", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: pilih | {1}: kembali", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))) : Custom String("{0}\n{1}", Custom String("ย่อค้าง + ปุ่มคำสั่ง\n{0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: โหวต | {1}: กลับ", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))), Event Player.IndeksBahasa == 0 ? Custom String("{0}\n> {1}", Custom String("11 - VOTE PLAYER {0}/{1}\nYOUR VOTE: {2}", Event Player.KursorPilihan + 1, Count Of(Globale.PemainManusia), Event Player.PemainDipilih != Null ? Event Player.PemainDipilih : Custom String("NONE")), Count Of(Globale.PemainManusia) > 0 ? Custom String("{0} - {1} VOTES", Globale.PemainManusia[Event Player.KursorPilihan], Globale.PemainManusia[Event Player.KursorPilihan].JumlahPilihan) : Custom String("NO PLAYERS")) : Event Player.IndeksBahasa == 1 ? Custom String("{0}\n> {1}", Custom String("11 - PILIH PEMAIN {0}/{1}\nPILIHANMU: {2}", Event Player.KursorPilihan + 1, Count Of(Globale.PemainManusia), Event Player.PemainDipilih != Null ? Event Player.PemainDipilih : Custom String("BELUM ADA")), Count Of(Globale.PemainManusia) > 0 ? Custom String("{0} - {1} SUARA", Globale.PemainManusia[Event Player.KursorPilihan], Globale.PemainManusia[Event Player.KursorPilihan].JumlahPilihan) : Custom String("TIDAK ADA PEMAIN")) : Custom String("{0}\n> {1}", Custom String("11 - โหวตผู้เล่น {0}/{1}\nเลือก: {2}", Event Player.KursorPilihan + 1, Count Of(Globale.PemainManusia), Event Player.PemainDipilih != Null ? Event Player.PemainDipilih : Custom String("ยังไม่โหวต")), Count Of(Globale.PemainManusia) > 0 ? Custom String("{0} - {1} โหวต", Globale.PemainManusia[Event Player.KursorPilihan], Globale.PemainManusia[Event Player.KursorPilihan].JumlahPilihan) : Custom String("ไม่มีผู้เล่น")), Top, 3, Custom Color(255, 255, 255, 255), Custom Color(235, 230, 190, 255), Custom Color(X Component Of(Event Player.WarnaMenu), Y Component Of(Event Player.WarnaMenu), Z Component Of(Event Player.WarnaMenu), 255), Visible To String and Color, Visible Never);
		Event Player.HudMenu = Last Text ID;
	}
}

