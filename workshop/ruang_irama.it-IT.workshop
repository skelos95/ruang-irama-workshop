") : Custom String("ปิด")), Top, 3, Custom Color(255, 255, 255, 255), Custom Color(215, 245, 235, 255), Custom Color(X Component Of(Event Player.WarnaMenu), Y Component Of(Event Player.WarnaMenu), Z Component Of(Event Player.WarnaMenu), 255), Visible To String and Color, Visible Never);
