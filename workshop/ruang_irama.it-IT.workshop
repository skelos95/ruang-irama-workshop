	}
}

regola("12e - Bangkit Lompat: Simpan posisi kematian")
{
	evento
	{
		Giocatore Died;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.Manusia == True;
		Event Giocatore.BotOtomatis == False;
		Is Dummy Bot(Event Giocatore) == False;
	}

	azioni
	{
		Event Giocatore.PosisiMati = Posizione Of(Event Giocatore);
		Event Giocatore.BangkitLompatDipakai = False;
		Event Giocatore.PerintahMenu = 0;
		Event Giocatore.PerintahTeleportasi = 0;
		Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Press {0}: respawn near your death spot.", Input Binding String(Button(Salta))) : Event Giocatore.IndeksBahasa == 1 ? Custom String("Tekan {0}: bangkit dekat lokasi mati.", Input Binding String(Button(Salta))) : Custom String("กด {0}: เกิดใหม่ใกล้จุดตาย", Input Binding String(Button(Salta))));
	}
}

regola("12f - Bangkit Lompat: Bangkit di posisi aman yang bisa dilalui")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.Manusia == True;
		Event Giocatore.BotOtomatis == False;
		Is Dummy Bot(Event Giocatore) == False;
		Is Vivo(Event Giocatore) == False;
		Event Giocatore.TeleportasiJongkokAktif == False;
		Event Giocatore.BangkitLompatDipakai == False;
		Is Button Held(Event Giocatore, Button(Salta)) == True;
	}

	azioni
	{
		Event Giocatore.BangkitLompatDipakai = True;
		Event Giocatore.PosisiBangkitAman = Nearest Walkable Posizione(Event Giocatore.PosisiMati + Vector(Casuale Real(-6, 6), 0, Casuale Real(-6, 6)));
		If(Distanza Between(Event Giocatore.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100);
			Event Giocatore.PosisiBangkitAman = Nearest Walkable Posizione(Event Giocatore.PosisiMati);
		End;
		Respawn(Event Giocatore);
		Attendi(0.016, Ignora condizione);
		Teleport(Event Giocatore, Event Giocatore.PosisiBangkitAman);
		Call Subroutine(EfekPulihkan);
		Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Respawned nearby. Try not to repeat that.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Bangkit dekat titik mati. Coba jangan ulangi.") : Custom String("เกิดใหม่ใกล้จุดตายแล้ว อย่าซ้ำอีกล่ะ"));
	}
}

regola("13 - Intip Pahlawan: Nama mengikuti target bidikan tanpa Wait")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.Manusia == True;
		Is Vivo(Event Giocatore) == True;
		Event Giocatore.MenuTerbuka == False;
		Event Giocatore.TeleportasiJongkokAktif == False;
		Event Giocatore.TeleportasiJongkokDiaktifkan == False;
		Event Giocatore.ModeKamera != 2;
		Is Button Held(Event Giocatore, Button(Accovacciati)) == True;
		Event Giocatore.TargetInspeksi != Primo Of(Sorted Array(Filtered Array(All Giocatori(All Squadre), And(Attuale Array Element != Event Giocatore, And(Entity Exists(Attuale Array Element), And(Is Vivo(Attuale Array Element), Or(Is Dummy Bot(Attuale Array Element) == True, Or(Giocatore Variable(Attuale Array Element, BotOtomatis) == True, Or(Event Giocatore.PrivasiNasibAktif == True, And(Giocatore Variable(Attuale Array Element, Manusia) == True, Giocatore Variable(Attuale Array Element, PrivasiInspeksiAktif) == False)))))))), Angolo Between Vectors(Sguardo in Corso Direction Of(Event Giocatore), Direction Towards(Eye Posizione(Event Giocatore), Eye Posizione(Attuale Array Element)))));
	}

	azioni
	{
		If(Event Giocatore.InspeksiAktif == False);
			Event Giocatore.InspeksiAktif = True;
			If(Event Giocatore.PrivasiNasibAktif == False);
				Disable Nameplates(All Giocatori(All Squadre), Event Giocatore);
				Event Giocatore.PelatNamaDinonaktifkan = True;
			Else;
				Enable Nameplates(All Giocatori(All Squadre), Event Giocatore);
				Event Giocatore.PelatNamaDinonaktifkan = False;
			End;
		End;
		Call Subroutine(SegarkanTargetInspeksi);
		If(Event Giocatore.TeksDunia != Null);
			Distruggi In-World Text(Event Giocatore.TeksDunia);
		End;
		If(Index Of Array Value(Globale.PemainManusia, Event Giocatore) >= 0);
			Globale.TeksDuniaPemain[Index Of Array Value(Globale.PemainManusia, Event Giocatore)] = 0;
		End;
		Event Giocatore.TeksDunia = Null;
		Abort If(Event Giocatore.TargetInspeksi == Null);
		Create In-World Text(Event Giocatore, Custom String("{0} {1} | {2}", Eroe Icon String(Is Duplicating(Event Giocatore.TargetInspeksi) ? Eroe Being Duplicated(Event Giocatore.TargetInspeksi) : Eroe Of(Event Giocatore.TargetInspeksi)), Custom String("{0}", Event Giocatore.TargetInspeksi), Round To Integer(Salute(Event Giocatore.TargetInspeksi), Giù)), Eye Posizione(Event Giocatore.TargetInspeksi) + Vector(0, 0.450, 0), 1.100, Do Not Clip, Visibile a Posizione  String and Color, Giocatore Variable(Event Giocatore.TargetInspeksi, Manusia) == True ? Giocatore Variable(Event Giocatore.TargetInspeksi, WarnaNama) : Color(Orange), Visibile Mai);
		Event Giocatore.TeksDunia = Last Text ID;
		If(Index Of Array Value(Globale.PemainManusia, Event Giocatore) >= 0);
			Globale.TeksDuniaPemain[Index Of Array Value(Globale.PemainManusia, Event Giocatore)] = Event Giocatore.TeksDunia;
		End;
	}
}

