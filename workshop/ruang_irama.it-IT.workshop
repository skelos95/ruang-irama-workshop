		If((Distance Between(Ray Cast Hit Position((Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 1, 0)), (Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 1, -1.000)), Empty Array, Empty Array, False), (Globale.PemainPemicu.PosisiBangkitAman + Vector(0, 1, 0))) < 0.850));
		Globale.PemainPemicu.PosisiBangkitAman = Vector(0, 0, 0);
