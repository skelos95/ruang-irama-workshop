regola("99p - Subrutin: Terapkan pilihan lompat ganda")
{
	evento
	{
		Subroutine;
		TerapkanHalamanLompatGanda;
	}

	azioni
	{
		Globale.PemainPemicu.KursorLompatGanda %= 11;
		Globale.PemainPemicu.ModeLompatGanda = (Globale.PemainPemicu.KursorLompatGanda != 0);
		If(Globale.PemainPemicu.ModeLompatGanda);
		Globale.PemainPemicu.TingkatLompatGanda = Globale.PemainPemicu.KursorLompatGanda;
		End;
		Globale.PemainPemicu.LompatGandaDipakai = Is Button Held(Globale.PemainPemicu, Button(Jump));
		Globale.PemainPemicu.LompatDiTanah = Is On Ground(Globale.PemainPemicu);
		Globale.PemainPemicu.WaktuLompatGandaBerikut = (Total Time Elapsed + 0.300);
	}
}

regola("91t - Subrutin: Gambar pilihan lompat ganda")
{
	evento
	{
		Subroutine;
		GambarLompatGanda;
	}

	azioni
	{
		Create HUD Text(Evaluate Once(Globale.PemainPemicu), Null, ((Player Variable(Local Player, IndeksBahasa) == 0) ? Custom String("{0}\n{1}", Custom String("Hold CROUCH | {0}: next | {1}: prev", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: apply | {1}: back", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))) : ((Player Variable(Local Player, IndeksBahasa) == 1) ? Custom String("{0}\n{1}", Custom String("Tahan JONGKOK | {0}: maju | {1}: mundur", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: pakai | {1}: kembali", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))) : Custom String("{0}\n{1}", Custom String("ย่อค้าง | {0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: ใช้ | {1}: กลับ", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))))), ((Player Variable(Local Player, IndeksBahasa) == 0) ? Custom String("{0}\n> {1}", Custom String("14 - MULTIJUMP {0}/11\nNOW: {1} | AIR BOOST: {2}%", (Player Variable(Local Player, KursorLompatGanda) + 1), (Player Variable(Local Player, ModeLompatGanda) ? Custom String("ON") : Custom String("OFF")), (Player Variable(Local Player, TingkatLompatGanda) * 100)), ((Player Variable(Local Player, KursorLompatGanda) == 0) ? Custom String("OFF") : Custom String("AIR BOOST: {0}%\nIN AIR: TAP / HOLD JUMP", (Player Variable(Local Player, KursorLompatGanda) * 100)))) : ((Player Variable(Local Player, IndeksBahasa) == 1) ? Custom String("{0}\n> {1}", Custom String("14 - LOMPAT BERULANG {0}/11\nKINI: {1} | DORONGAN UDARA: {2}%", (Player Variable(Local Player, KursorLompatGanda) + 1), (Player Variable(Local Player, ModeLompatGanda) ? Custom String("AKTIF") : Custom String("MATI")), (Player Variable(Local Player, TingkatLompatGanda) * 100)), ((Player Variable(Local Player, KursorLompatGanda) == 0) ? Custom String("MATI") : Custom String("DORONGAN UDARA: {0}%\nDI UDARA: TEKAN / TAHAN LOMPAT", (Player Variable(Local Player, KursorLompatGanda) * 100)))) : Custom String("{0}\n> {1}", Custom String("14 - กระโดดหลายครั้ง {0}/11\nสถานะ: {1} | แรงกลางอากาศ: {2}%", (Player Variable(Local Player, KursorLompatGanda) + 1), (Player Variable(Local Player, ModeLompatGanda) ? Custom String("เปิด") : Custom String("ปิด")), (Player Variable(Local Player, TingkatLompatGanda) * 100)), ((Player Variable(Local Player, KursorLompatGanda) == 0) ? Custom String("ปิด") : Custom String("แรงกลางอากาศ: {0}%\nกลางอากาศ: แตะ / กดกระโดดค้าง", (Player Variable(Local Player, KursorLompatGanda) * 100)))))), Top, 3, Color(Bianco), Custom Color(215, 235, 255, 255), Custom Color(X Component Of(Player Variable(Local Player, WarnaMenu)), Y Component Of(Player Variable(Local Player, WarnaMenu)), Z Component Of(Player Variable(Local Player, WarnaMenu)), 255), Visible To String and Color, Visible Never);
		Globale.PemainPemicu.HudMenu = Last Text ID;
	}
}

regola("89h - Subrutin: Lompat udara berulang dengan jeda")
{
	evento
	{
		Subroutine;
		ProsesLompatGanda;
	}

	azioni
	{
		If(Is Button Held(Globale.PemainAktif, Button(Jump)));
		If(Or(Not(Globale.PemainAktif.LompatGandaDipakai), (Total Time Elapsed >= Globale.PemainAktif.WaktuLompatGandaBerikut)));
		Globale.PemainAktif.WaktuLompatGandaBerikut = (Total Time Elapsed + 0.300);
		If(And(Globale.PemainAktif.Manusia, And(Has Spawned(Globale.PemainAktif), And(Is Alive(Globale.PemainAktif), And(Not(Globale.PemainAktif.ModeTerbangAktif), And(Not(Globale.PemainAktif.LampiranTeleportasiAktif), And(Not(Globale.PemainAktif.BangkitLompatDipakai), And(Or((Globale.PemainAktif.EfekNasib != 2), (Globale.PemainAktif.EfekNasibBerakhir <= Total Time Elapsed)), Or(Not(Globale.PemainAktif.LompatGandaDipakai), And(Not(Globale.PemainAktif.LompatDiTanah), Not(Is On Ground(Globale.PemainAktif))))))))))));
		Globale.PemainAktif.LompatGandaDipakai = True;
		If(And(Not(Globale.PemainAktif.LompatDiTanah), Not(Is On Ground(Globale.PemainAktif))));
		Apply Impulse(Globale.PemainAktif, ((((6 * Globale.PemainAktif.TingkatLompatGanda) - Y Component Of(Velocity Of(Globale.PemainAktif))) >= 0) ? Vector(0, 1, 0) : Vector(0, -1, 0)), Absolute Value(((6 * Globale.PemainAktif.TingkatLompatGanda) - Y Component Of(Velocity Of(Globale.PemainAktif)))), To World, Incorporate Contrary Motion);
		End;
		Play Effect(All Players(All Teams), Ring Explosion, Globale.RGB, (Position Of(Globale.PemainAktif) + Vector(0, 0.050, 0)), 1.500);
		Else;
		Globale.PemainAktif.LompatGandaDipakai = True;
		End;
		End;
		Else;
		Globale.PemainAktif.LompatGandaDipakai = False;
		Globale.PemainAktif.WaktuLompatGandaBerikut = 0;
		End;
		Globale.PemainAktif.LompatDiTanah = Is On Ground(Globale.PemainAktif);
	}
}

regola("99q - Subrutin: Terapkan sakelar pukulan super")
{
	evento
	{
		Subroutine;
		TerapkanHalamanPukulanSuper;
	}

	azioni
	{
		Abort If(Not(Array Contains(Globale.PemainManusia, Globale.PemainPemicu)));
		Abort If(Or((Globale.PemainPemicu.UrutanHUD < 0), (Globale.PemainPemicu.UrutanHUD >= 12)));
		If(Array Contains(Globale.PemainPukulanSuper, Globale.PemainPemicu));
		Modify Global Variable(PemainPukulanSuper, Remove From Array By Value, Globale.PemainPemicu);
		Globale.WaktuPukulanSuper[Globale.PemainPemicu.UrutanHUD] = 0;
		Else;
		Modify Global Variable(PemainPukulanSuper, Append To Array, Globale.PemainPemicu);
		Globale.WaktuPukulanSuper[Globale.PemainPemicu.UrutanHUD] = -1;
		End;
	}
}

regola("89i - Subrutin: Pukulan super sekali per ayunan")
{
	evento
	{
		Subroutine;
		ProsesPukulanSuper;
	}

	azioni
	{
		Abort If(Or((Globale.PemainAktif.UrutanHUD < 0), (Globale.PemainAktif.UrutanHUD >= Count Of(Globale.WaktuPukulanSuper))));
		If((Is Meleeing(Globale.PemainAktif) == False));
		Globale.WaktuPukulanSuper[Globale.PemainAktif.UrutanHUD] = 0;
		Abort;
		End;
		If(Or(Not(Globale.PemainAktif.Manusia), Or(Globale.PemainAktif.BotOtomatis, Or(Is Dummy Bot(Globale.PemainAktif), Or(Not(Entity Exists(Globale.PemainAktif)), Or(Not(Has Spawned(Globale.PemainAktif)), Or(Not(Is Alive(Globale.PemainAktif)), Or(Globale.PemainAktif.SiklusPemainAktif, Or(Globale.PemainAktif.PindahTimDiproses, Globale.PemainAktif.SeranganDekatDipakai)))))))));
		Globale.WaktuPukulanSuper[Globale.PemainAktif.UrutanHUD] = -1;
		Abort;
		End;
		If((Globale.WaktuPukulanSuper[Globale.PemainAktif.UrutanHUD] == 0));
		Globale.TargetPukulanSuper = First Of(Sorted Array(Filtered Array(All Players(All Teams), And((Current Array Element != Globale.PemainAktif), And(Entity Exists(Current Array Element), And(Has Spawned(Current Array Element), And(Is Alive(Current Array Element), And((Distance Between(Position Of(Globale.PemainAktif), Position Of(Current Array Element)) <= 2.500), And(Is In View Angle(Globale.PemainAktif, Eye Position(Current Array Element), 90), Is In Line Of Sight(Eye Position(Globale.PemainAktif), Eye Position(Current Array Element), Barriers Do Not Block LOS)))))))), Distance Between(Position Of(Globale.PemainAktif), Position Of(Current Array Element))));
		If((Globale.TargetPukulanSuper != Null));
		Globale.WaktuPukulanSuper[Globale.PemainAktif.UrutanHUD] = -1;
		End;
		If(And((Globale.TargetPukulanSuper != Null), And(Entity Exists(Globale.TargetPukulanSuper), And(Has Spawned(Globale.TargetPukulanSuper), And(Is Alive(Globale.TargetPukulanSuper), And(Not(Has Status(Globale.TargetPukulanSuper, Phased Out)), And(Not(Has Status(Globale.TargetPukulanSuper, Unkillable)), Or(Not(Player Variable(Globale.TargetPukulanSuper, KebalAktif)), (Player Variable(Globale.TargetPukulanSuper, ModeKebal) == 0)))))))));
		Kill(Globale.TargetPukulanSuper, Globale.PemainAktif);
		End;
		Globale.TargetPukulanSuper = Null;
		End;
	}
}

regola("89i1 - Pukulan super: Dampak jarak dekat asli")
{
	evento
	{
		Player Dealt Damage;
		Tutti;
		Tutti;
		}

	condizioni
	{
		Globale.Siap == True;
		Array Contains(Globale.PemainPukulanSuper, Event Player) == True;
		Event Ability == Button(Melee);
		Hero Of(Event Player) != Hero(Regina dei Junker);
		Event Damage > 0;
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Entity Exists(Event Player) == True;
		Has Spawned(Event Player) == True;
		Is Alive(Event Player) == True;
		Event Player.SiklusPemainAktif == False;
		Event Player.PindahTimDiproses == False;
		Event Player.SeranganDekatDipakai == False;
		Victim != Null;
		Victim != Event Player;
		Entity Exists(Victim) == True;
		Has Spawned(Victim) == True;
		Is Alive(Victim) == True;
		}

	azioni
	{
		If((Globale.JumlahPeristiwa < 192));
		Globale.AntreanPeristiwa[Globale.EkorPeristiwa] = Array(6, Event Player, Null, Victim, Event Ability, Event Damage, Null, Total Time Elapsed, Null, Null, Null, Null, Null, Null, Null, Or(Has Status(Victim, Phased Out), Or(Has Status(Victim, Unkillable), And(Player Variable(Victim, KebalAktif), (Player Variable(Victim, ModeKebal) != 0)))), Event Player.UrutanHUD, Null, Hero Of(Event Player), Team Of(Event Player), Event Player.StatusPengatur[36], (Event Player.Manusia ? Event Player.NamaTampilan : Custom String("{0}", Event Player)), Player Variable(Victim, StatusPengatur)[36]);
		Globale.EkorPeristiwa = ((Globale.EkorPeristiwa + 1) % 256);
		Globale.JumlahPeristiwa += 1;
		Else;
		Globale.PeristiwaTerlewat += 1;
		End;
	}
}

regola("89i1 - Pukulan super: Dampak jarak dekat asli global")
{
	evento
	{
		Subroutine;
		Peristiwa89i1;
	}

	azioni
	{
		Abort If(Not(Entity Exists(Globale.PemainPemicu)));
		Abort If((Globale.PeristiwaAktif[20] != Globale.PemainPemicu.StatusPengatur[36]));
		Abort If((Globale.PeristiwaAktif[21] != (Globale.PemainPemicu.Manusia ? Globale.PemainPemicu.NamaTampilan : Custom String("{0}", Globale.PemainPemicu))));
		Abort If(Or((Globale.PemainPemicu.TimTerakhir != Team Of(Globale.PemainPemicu)), (Globale.PemainPemicu.TimSiklusTarget != Team Of(Globale.PemainPemicu))));
		Abort If((Globale.PemainPemicu.UrutanHUD != Globale.PeristiwaAktif[16]));
		Abort If(Not(Array Contains(Globale.PemainPukulanSuper, Globale.PemainPemicu)));
		Abort If(Or((Globale.PeristiwaAktif[16] < 0), (Globale.PeristiwaAktif[16] >= Count Of(Globale.WaktuPukulanSuper))));
		Abort If((Globale.WaktuPukulanSuper[Globale.PeristiwaAktif[16]] < 0));
		Globale.WaktuPukulanSuper[Globale.PeristiwaAktif[16]] = -1;
		If(And(Not(Globale.PeristiwaAktif[15]), And(Entity Exists(Globale.PeristiwaAktif[3]), And(Has Spawned(Globale.PeristiwaAktif[3]), And(Is Alive(Globale.PeristiwaAktif[3]), And((Player Variable(Globale.PeristiwaAktif[3], StatusPengatur)[36] == Globale.PeristiwaAktif[22]), And(Not(Has Status(Globale.PeristiwaAktif[3], Phased Out)), And(Not(Has Status(Globale.PeristiwaAktif[3], Unkillable)), Or(Not(Player Variable(Globale.PeristiwaAktif[3], KebalAktif)), (Player Variable(Globale.PeristiwaAktif[3], ModeKebal) == 0))))))))));
		Kill(Globale.PeristiwaAktif[3], Globale.PemainPemicu);
		End;
	}
}

regola("89e - Subrutin: Rawat ikon mengambang di tujuan satu kali per detik")
{
	evento
	{
		Subroutine;
		PerbaruiPilarSosial;
	}

	azioni
	{
		For Global Variable(IndeksIkonPilar, 0, 12, 1);
		If(And((Globale.PemilikIkonPilar[Globale.IndeksIkonPilar] != Null), Not(And(Entity Exists(Globale.PemilikIkonPilar[Globale.IndeksIkonPilar]), And(Array Contains(Globale.PemainManusia, Globale.PemilikIkonPilar[Globale.IndeksIkonPilar]), And(Player Variable(Globale.PemilikIkonPilar[Globale.IndeksIkonPilar], Manusia), And(Not(Player Variable(Globale.PemilikIkonPilar[Globale.IndeksIkonPilar], PembaruanDaftarTertunda)), And(Not(Player Variable(Globale.PemilikIkonPilar[Globale.IndeksIkonPilar], PindahTimDiproses)), (Player Variable(Globale.PemilikIkonPilar[Globale.IndeksIkonPilar], IndeksIkon) > 0)))))))));
		If((Globale.EntitasIkonPilar[Globale.IndeksIkonPilar] != 0));
		Destroy Icon(Globale.EntitasIkonPilar[Globale.IndeksIkonPilar]);
		End;
		If(Entity Exists(Globale.PemilikIkonPilar[Globale.IndeksIkonPilar]));
		Stop Chasing Player Variable(Globale.PemilikIkonPilar[Globale.IndeksIkonPilar], PosisiIkonPilar);
		Set Player Variable(Globale.PemilikIkonPilar[Globale.IndeksIkonPilar], PosisiIkonPilar, Vector(0, 0.500, 0));
		End;
		Globale.EntitasIkonPilar[Globale.IndeksIkonPilar] = 0;
		Globale.PilihanIkonPilar[Globale.IndeksIkonPilar] = 0;
		Globale.PemilikIkonPilar[Globale.IndeksIkonPilar] = Null;
		Globale.WaktuIkonPilar[Globale.IndeksIkonPilar] = 0;
		End;
		If(And((Globale.PemilikIkonPilar[Globale.IndeksIkonPilar] == Null), (Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) > 0.100)));
		Globale.PemilikIkonPilar[Globale.IndeksIkonPilar] = First Of(Filtered Array(Globale.PemainManusia, And((Player Variable(Current Array Element, UrutanHUD) == Globale.IndeksIkonPilar), And(Entity Exists(Current Array Element), And(Array Contains(Globale.PemainManusia, Current Array Element), And(Player Variable(Current Array Element, Manusia), And(Not(Player Variable(Current Array Element, PembaruanDaftarTertunda)), And(Not(Player Variable(Current Array Element, PindahTimDiproses)), (Player Variable(Current Array Element, IndeksIkon) > 0)))))))));
		If((Globale.PemilikIkonPilar[Globale.IndeksIkonPilar] != Null));
