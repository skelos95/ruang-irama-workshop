		Globale.WaktuIkonPilar[Globale.IndeksIkonPilar] = Total Time Elapsed;
		Chase Player Variable Over Time(Globale.PemilikIkonPilar[Globale.IndeksIkonPilar], PosisiIkonPilar, ((Direction From Angles(Random Real(0, 360), 0) * Random Real(0, 10)) + Vector(0, Random Real(0.500, 8), 0)), 4.500, None);
