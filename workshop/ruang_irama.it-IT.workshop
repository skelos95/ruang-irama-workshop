	condizioni
	{
		Event Giocatore.Manusia == True;
		Event Giocatore.TeleportasiJongkokAktif == True;
		Event Giocatore.KursorTeleportasi == 2;
		Is Vivo(Event Giocatore) == True;
		Is Button Held(Event Giocatore, Button(Accovacciati)) == True;
		Event Giocatore.CalonTargetTeleportasi != Primo Of(Sorted Array(Filtered Array(All Giocatori(All Squadre), And(Attuale Array Element != Event Giocatore, And(Entity Exists(Attuale Array Element), And(Is Vivo(Attuale Array Element), Or(Is Dummy Bot(Attuale Array Element) == True, Or(Giocatore Variable(Attuale Array Element, BotOtomatis) == True, And(Giocatore Variable(Attuale Array Element, Manusia) == True, Giocatore Variable(Attuale Array Element, PrivasiInspeksiAktif) == False))))))), Angolo Between Vectors(Sguardo in Corso Direction Of(Event Giocatore), Direction Towards(Eye Posizione(Event Giocatore), Eye Posizione(Attuale Array Element)))));
	}

	azioni
	{
		Call Subroutine(SegarkanTargetTeleportasi);
	}
}

regola("19d - Teleportasi Jongkok: Buat ulang nama saat target berubah")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.Manusia == True;
		Event Giocatore.TeleportasiJongkokAktif == True;
		Event Giocatore.KursorTeleportasi == 2;
		Is Vivo(Event Giocatore) == True;
		Is Button Held(Event Giocatore, Button(Accovacciati)) == True;
		Event Giocatore.TargetTeleportasiTeks != Event Giocatore.CalonTargetTeleportasi;
	}

	azioni
	{
		If(Event Giocatore.TeksTeleportasi != Null);
			Distruggi In-World Text(Event Giocatore.TeksTeleportasi);
		End;
		Event Giocatore.TeksTeleportasi = Null;
		If(Event Giocatore.CalonTargetTeleportasi == Null);
			Event Giocatore.TargetTeleportasiTeks = Null;
			Abort;
		End;
		If(Event Giocatore.PrivasiNasibAktif == False);
			Disable Nameplates(All Giocatori(All Squadre), Event Giocatore);
			Event Giocatore.PelatNamaDinonaktifkan = True;
		Else;
			Enable Nameplates(All Giocatori(All Squadre), Event Giocatore);
			Event Giocatore.PelatNamaDinonaktifkan = False;
		End;
		Create In-World Text(Event Giocatore, Custom String("{0} {1} | {2}", Eroe Icon String(Is Duplicating(Event Giocatore.CalonTargetTeleportasi) ? Eroe Being Duplicated(Event Giocatore.CalonTargetTeleportasi) : Eroe Of(Event Giocatore.CalonTargetTeleportasi)), Custom String("{0}", Event Giocatore.CalonTargetTeleportasi), Round To Integer(Salute(Event Giocatore.CalonTargetTeleportasi), Giù)), Eye Posizione(Event Giocatore.CalonTargetTeleportasi) + Vector(0, 0.450, 0), 1.100, Do Not Clip, Visibile a Posizione  String and Color, Giocatore Variable(Event Giocatore.CalonTargetTeleportasi, Manusia) == True ? Giocatore Variable(Event Giocatore.CalonTargetTeleportasi, WarnaNama) : Color(Orange), Visibile Mai);
		Event Giocatore.TeksTeleportasi = Last Text ID;
		Event Giocatore.TargetTeleportasiTeks = Event Giocatore.CalonTargetTeleportasi;
	}
}

regola("19e - Teleportasi Jongkok: Primary Fire menjalankan halaman aktif")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.TeleportasiJongkokAktif == True;
		Event Giocatore.PerintahTeleportasi == 1;
	}

	azioni
	{
		Event Giocatore.JenisTeleportasiTerkunci = Event Giocatore.KursorTeleportasi;
		Event Giocatore.TargetTeleportasiTerkunci = Null;
		Call Subroutine(SegarkanTargetTeleportasi);
		If(Event Giocatore.JenisTeleportasiTerkunci == 2);
			Event Giocatore.TargetTeleportasiTerkunci = Event Giocatore.CalonTargetTeleportasi;
		End;
		If(Event Giocatore.JenisTeleportasiTerkunci == 0);
			If(Is In Genera Room(Event Giocatore) == True);
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("You are already in the Spawn Room. Mission accomplished.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Kamu sudah di ruang muncul. Misi selesai.") : Custom String("คุณอยู่ในห้องเกิดแล้ว ภารกิจสำเร็จ"));
			Else If(Count Of(Genera Punti(Squadra Of(Event Giocatore))) == 0);
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Spawn Room unavailable on this map right now.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Ruang muncul tidak tersedia di map ini saat ini.") : Custom String("ห้องเกิดยังไม่พร้อมใช้งานบนแผนที่นี้"));
			Else;
				Teleport(Event Giocatore, Posizione Of(Primo Of(Genera Punti(Squadra Of(Event Giocatore)))));
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Teleported to your Spawn Room.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Teleport ke ruang muncul timmu.") : Custom String("เทเลพอร์ตไปห้องเกิดของทีมแล้ว"));
			End;
		Else If(Event Giocatore.JenisTeleportasiTerkunci == 1);
			If(Or(Partita Attuale Mode == Partita Mode(Trasporto), Partita Attuale Mode == Partita Mode(Ibrida)));
				If(Distanza Between(Carico Posizione, Vector(0, 0, 0)) <= 0.100);
					Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Payload position unavailable right now.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Posisi payload belum tersedia saat ini.") : Custom String("ตำแหน่งเพย์โหลดยังไม่พร้อมใช้งานตอนนี้"));
				Else;
					Teleport(Event Giocatore, Nearest Walkable Posizione(Carico Posizione + Vector(2, 0, 0)));
					Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Teleported near the payload.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Teleport dekat payload.") : Custom String("เทเลพอร์ตใกล้เพย์โหลดแล้ว"));
				End;
			Else If(Partita Attuale Mode == Partita Mode(Cattura la Bandiera));
				If(Distanza Between(Flag Posizione(Opposite Squadra Of(Squadra Of(Event Giocatore))), Vector(0, 0, 0)) <= 0.100);
					Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Enemy flag position unavailable right now.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Posisi bendera musuh belum tersedia saat ini.") : Custom String("ตำแหน่งธงศัตรูยังไม่พร้อมใช้งานตอนนี้"));
				Else;
					Teleport(Event Giocatore, Nearest Walkable Posizione(Flag Posizione(Opposite Squadra Of(Squadra Of(Event Giocatore))) + Vector(2, 0, 0)));
					Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Teleported near the enemy flag.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Teleport dekat bendera musuh.") : Custom String("เทเลพอร์ตใกล้ธงของศัตรูแล้ว"));
				End;
			Else If(Partita Attuale Mode == Partita Mode(Scorta));
				If(Count Of(Filtered Array(All Giocatori(All Squadre), And(Has Generato(Attuale Array Element) == True, And(Is Vivo(Attuale Array Element) == True, Is On Obiettivo(Attuale Array Element) == True)))) > 0);
					Teleport(Event Giocatore, Nearest Walkable Posizione(Posizione Of(Primo Of(Filtered Array(All Giocatori(All Squadre), And(Has Generato(Attuale Array Element) == True, And(Is Vivo(Attuale Array Element) == True, Is On Obiettivo(Attuale Array Element) == True))))) + Vector(2, 0, 0)));
					Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Teleported near the Push robot.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Teleport dekat robot Push.") : Custom String("เทเลพอร์ตใกล้หุ่นยนต์ Push แล้ว"));
				Else If(Distanza Between(Obiettivo Posizione(Obiettivo Index), Vector(0, 0, 0)) > 0.100);
					Teleport(Event Giocatore, Nearest Walkable Posizione(Obiettivo Posizione(Obiettivo Index)));
					Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Robot position unavailable; using the current objective.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Posisi robot belum tersedia; memakai objektif saat ini.") : Custom String("ไม่พบตำแหน่งหุ่นยนต์ ใช้เป้าหมายปัจจุบันแทน"));
				Else;
					Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Push robot position unavailable right now.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Posisi robot Push belum tersedia saat ini.") : Custom String("ตำแหน่งหุ่นยนต์ Push ยังไม่พร้อมใช้งานตอนนี้"));
				End;
			Else If(Or(Or(Partita Attuale Mode == Partita Mode(Punto Critico), Partita Attuale Mode == Partita Mode(Controllo)), Or(Partita Attuale Mode == Partita Mode(Scontro), Partita Attuale Mode == Partita Mode(Conquista))));
				If(Distanza Between(Obiettivo Posizione(Obiettivo Index), Vector(0, 0, 0)) <= 0.100);
					Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Current objective position is unavailable.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Posisi objektif saat ini belum tersedia.") : Custom String("ตำแหน่งเป้าหมายปัจจุบันยังไม่พร้อมใช้งาน"));
				Else;
					Teleport(Event Giocatore, Nearest Walkable Posizione(Obiettivo Posizione(Obiettivo Index)));
					Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Teleported near the current objective.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Teleport dekat objektif saat ini.") : Custom String("เทเลพอร์ตใกล้เป้าหมายปัจจุบันแล้ว"));
				End;
			Else If(Distanza Between(Obiettivo Posizione(Obiettivo Index), Vector(0, 0, 0)) <= 0.100);
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Objective position unavailable in this mode. The objective is being mysterious.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Posisi objektif tidak tersedia di mode ini. Objektifnya sedang misterius.") : Custom String("ตำแหน่งเป้าหมายใช้ไม่ได้ในโหมดนี้ เป้าหมายกำลังเล่นซ่อนหา"));
			Else;
				Teleport(Event Giocatore, Nearest Walkable Posizione(Obiettivo Posizione(Obiettivo Index)));
				Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Teleported near the current objective.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Teleport dekat objektif saat ini.") : Custom String("เทเลพอร์ตใกล้เป้าหมายปัจจุบันแล้ว"));
			End;
		Else If(Or(Or(Event Giocatore.TargetTeleportasiTerkunci == Null, Entity Exists(Event Giocatore.TargetTeleportasiTerkunci) == False), Or(Is Vivo(Event Giocatore.TargetTeleportasiTerkunci) == False, Array Contains(Event Giocatore.DaftarTargetTeleportasi, Event Giocatore.TargetTeleportasiTerkunci) == False)));
			Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Target unavailable. Even teleportation has standards.") : Event Giocatore.IndeksBahasa == 1 ? Custom String("Target sedang tidak tersedia. Teleportasi juga punya standar.") : Custom String("เป้าหมายไม่พร้อมใช้งาน แม้แต่เทเลพอร์ตก็มีมาตรฐาน"));
		Else;
			Teleport(Event Giocatore, Nearest Walkable Posizione(Posizione Of(Event Giocatore.TargetTeleportasiTerkunci) - Sguardo in Corso Direction Of(Event Giocatore.TargetTeleportasiTerkunci) * 1.500));
			Small Message(Event Giocatore, Event Giocatore.IndeksBahasa == 0 ? Custom String("Teleported near {0}. Personal space sold separately.", Event Giocatore.TargetTeleportasiTerkunci) : Event Giocatore.IndeksBahasa == 1 ? Custom String("Teleport dekat {0}. Jarak pribadi dijual terpisah.", Event Giocatore.TargetTeleportasiTerkunci) : Custom String("เทเลพอร์ตไปใกล้ {0} แล้ว พื้นที่ส่วนตัวไม่ได้รวมในแพ็กเกจ", Event Giocatore.TargetTeleportasiTerkunci));
		End;
		Event Giocatore.JenisTeleportasiTerkunci = -1;
		Event Giocatore.TargetTeleportasiTerkunci = Null;
	}
}

regola("19g - Teleportasi Jongkok: Tutup saat Jongkok dilepas")
{
	evento
	{
		Ongoing - Each Giocatore;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Event Giocatore.TeleportasiJongkokAktif == True;
		Or(Or(Is Button Held(Event Giocatore, Button(Accovacciati)) == False, Event Giocatore.MenuTerbuka == True), Or(Has Generato(Event Giocatore) == False, Is Vivo(Event Giocatore) == False)) == True;
	}

	azioni
	{
		If(Event Giocatore.HudMenu != Null);
			Distruggi HUD Text(Event Giocatore.HudMenu);
		End;
		If(Index Of Array Value(Globale.PemainManusia, Event Giocatore) >= 0);
			Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Event Giocatore)] = 0;
		End;
		Event Giocatore.HudMenu = Null;
		Event Giocatore.TeleportasiJongkokAktif = False;
		Event Giocatore.PerintahTeleportasi = 0;
		Event Giocatore.DaftarTargetTeleportasi = Empty Array;
		Event Giocatore.CalonTargetTeleportasi = Null;
		If(Event Giocatore.TeksTeleportasi != Null);
			Distruggi In-World Text(Event Giocatore.TeksTeleportasi);
		End;
		Event Giocatore.TeksTeleportasi = Null;
		Event Giocatore.TargetTeleportasiTeks = Null;
		Event Giocatore.JenisTeleportasiTerkunci = -1;
		Event Giocatore.TargetTeleportasiTerkunci = Null;
		If(Event Giocatore.PelatNamaDinonaktifkan == True);
			Enable Nameplates(All Giocatori(All Squadre), Event Giocatore);
			Event Giocatore.PelatNamaDinonaktifkan = False;
		End;
		If(Event Giocatore.TeksDunia != Null);
			Distruggi In-World Text(Event Giocatore.TeksDunia);
		End;
		If(Index Of Array Value(Globale.PemainManusia, Event Giocatore) >= 0);
			Globale.TeksDuniaPemain[Index Of Array Value(Globale.PemainManusia, Event Giocatore)] = 0;
		End;
		Event Giocatore.TeksDunia = Null;
		Event Giocatore.TargetInspeksi = Null;
		Event Giocatore.DaftarTargetInspeksi = Empty Array;
		Event Giocatore.InspeksiAktif = False;
		Allow Button(Event Giocatore, Button(Fuoco Primario));
		Allow Button(Event Giocatore, Button(Secondary Fire));
		Allow Button(Event Giocatore, Button(Interagisci));
	}
}

regola("89a - Subrutin: Proses status cepat pemain")
{
	evento
	{
		Subroutine;
		ProsesCepatPemain;
	}

	azioni
	{
		If(And(Globale.PemainAktif.Manusia == True, And(Globale.PemainAktif.KebalAktif == True, And(Has Generato(Globale.PemainAktif) == True, Is Vivo(Globale.PemainAktif) == True))));
			If(And(Globale.PemainAktif.ModeKebal == 1, Is In Genera Room(Globale.PemainAktif) == False));
				If(Has Stato(Globale.PemainAktif, Unkillable) == False);
					Set Stato(Globale.PemainAktif, Null, Unkillable, 9999);
				End;
				Set Danni subiti(Globale.PemainAktif, 100);
				If(Salute(Globale.PemainAktif) >= Massimo Salute(Globale.PemainAktif));
					Set Giocatore Salute(Globale.PemainAktif, 1);
				End;
			Else If(Globale.PemainAktif.ModeKebal == 2);
				If(Has Stato(Globale.PemainAktif, Unkillable) == False);
					Set Stato(Globale.PemainAktif, Null, Unkillable, 9999);
				End;
				Set Danni subiti(Globale.PemainAktif, 0);
				If(Salute(Globale.PemainAktif) < Massimo Salute(Globale.PemainAktif));
					Set Giocatore Salute(Globale.PemainAktif, Massimo Salute(Globale.PemainAktif));
				End;
			End;
		End;
	}
}

regola("89b - Subrutin: Proses siklus pemain 10 Hz")
{
	evento
	{
		Subroutine;
		ProsesSiklusPemain;
	}

	azioni
	{
		If(And(Globale.PemainAktif.PindahTimDiproses == True, Or(And(Globale.PemainAktif.Manusia == True, And(Has Generato(Globale.PemainAktif) == True, Globale.PemainAktif.HudPemainDibuat == True)), And(Globale.PemainAktif.BotOtomatis == True, And(Globale.PemainAktif.SudahDiperiksa == True, And(Has Generato(Globale.PemainAktif) == True, And(Is Vivo(Globale.PemainAktif) == True, Globale.PemainAktif.KunciBotAktif == True)))))));
			"Pendaftaran manusia dilepas setelah HUD stabil; bot otomatis dilepas hanya setelah klasifikasi dan penguncian selesai."
			Globale.PemainAktif.PindahTimDiproses = False;
		End;
		If(And(Globale.Siap == True, And(Or(Is Dummy Bot(Globale.PemainAktif), Globale.PemainAktif.BotOtomatis) == True, And(Globale.PemainAktif.KunciBotAktif == True, Or(Has Generato(Globale.PemainAktif) == False, Is Vivo(Globale.PemainAktif) == False)))));
			Globale.PemainAktif.KunciBotAktif = False;
		End;
		If(Globale.PemainAktif.ModeKamera == 2);
			If(Or(Or(Or(Globale.PemainAktif.TargetKamera == Null, Entity Exists(Globale.PemainAktif.TargetKamera) == False), Or(Has Generato(Globale.PemainAktif.TargetKamera) == False, Is Vivo(Globale.PemainAktif.TargetKamera) == False)), And(Globale.PemainAktif.TargetKamera.Manusia == True, Globale.PemainAktif.TargetKamera.PrivasiInspeksiAktif == True)));
				Interrompi Camera(Globale.PemainAktif);
				Set Giocatore Variable(Globale.PemainAktif, ModeKamera, 0);
				Set Giocatore Variable(Globale.PemainAktif, TargetKamera, Null);
				Gioca Effect(All Giocatori(All Squadre), Ring Explosion, Globale.RGB, Posizione Of(Globale.PemainAktif) + Vector(0, 1, 0), 3);
				Small Message(Globale.PemainAktif, Globale.PemainAktif.IndeksBahasa == 0 ? Custom String("Camera target unavailable or private. Back to normal.") : Globale.PemainAktif.IndeksBahasa == 1 ? Custom String("Target kamera tidak tersedia atau privat. Kembali normal.") : Custom String("เป้าหมายกล้องไม่พร้อมใช้งานหรือเป็นส่วนตัว กลับมุมมองปกติแล้ว"));
			End;
		End;
		If(And(Globale.PemainAktif.InspeksiAktif == True, Or(Or(Or(Or(Or(Is Button Held(Globale.PemainAktif, Button(Accovacciati)) == False, Globale.PemainAktif.MenuTerbuka == True), Has Generato(Globale.PemainAktif) == False), Is Vivo(Globale.PemainAktif) == False), Globale.PemainAktif.ModeKamera == 2), And(Globale.PemainAktif.TeleportasiJongkokAktif == True, Globale.PemainAktif.KursorTeleportasi != 2))));
			If(Globale.PemainAktif.PelatNamaDinonaktifkan == True);
				Enable Nameplates(All Giocatori(All Squadre), Globale.PemainAktif);
				Globale.PemainAktif.PelatNamaDinonaktifkan = False;
			End;
			If(Globale.PemainAktif.TeksDunia != Null);
				Distruggi In-World Text(Globale.PemainAktif.TeksDunia);
			End;
			If(Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif) >= 0);
				Globale.TeksDuniaPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif)] = 0;
			End;
			Globale.PemainAktif.TeksDunia = Null;
			Globale.PemainAktif.TargetInspeksi = Null;
			Globale.PemainAktif.DaftarTargetInspeksi = Empty Array;
			Globale.PemainAktif.InspeksiAktif = False;
		End;
	}
}

regola("89c - Subrutin: Proses simpanan pemain 1 Hz")
{
	evento
	{
		Subroutine;
		ProsesCachePemain;
	}

	azioni
	{
		If(And(Globale.PemainAktif.Manusia == True, Entity Exists(Globale.PemainAktif)));
			If(And(Globale.PemainAktif.MenuTerbuka == True, Globale.PemainAktif.HalamanMenu == 1));
				If(And(Globale.PemainAktif.KursorKamera >= 2, Globale.PemainAktif.KursorKamera - 2 < Count Of(Globale.PemainAktif.DaftarTargetKamera)));
					Set Giocatore Variable(Globale.PemainAktif, CalonTargetKamera, Globale.PemainAktif.DaftarTargetKamera[Globale.PemainAktif.KursorKamera - 2]);
				Else;
					Set Giocatore Variable(Globale.PemainAktif, CalonTargetKamera, Null);
				End;
				Set Giocatore Variable(Globale.PemainAktif, DaftarTargetKamera, Filtered Array(All Giocatori(All Squadre), And(Attuale Array Element != Globale.PemainAktif, And(Entity Exists(Attuale Array Element), And(Has Generato(Attuale Array Element), And(Is Vivo(Attuale Array Element), Or(Is Dummy Bot(Attuale Array Element) == True, Or(Giocatore Variable(Attuale Array Element, BotOtomatis) == True, And(Giocatore Variable(Attuale Array Element, Manusia) == True, Giocatore Variable(Attuale Array Element, PrivasiInspeksiAktif) == False)))))))));
				If(And(Globale.PemainAktif.CalonTargetKamera != Null, Array Contains(Globale.PemainAktif.DaftarTargetKamera, Globale.PemainAktif.CalonTargetKamera)));
					Set Giocatore Variable(Globale.PemainAktif, KursorKamera, Index Of Array Value(Globale.PemainAktif.DaftarTargetKamera, Globale.PemainAktif.CalonTargetKamera) + 2);
				Else If(Globale.PemainAktif.KursorKamera >= Count Of(Globale.PemainAktif.DaftarTargetKamera) + 2);
					Set Giocatore Variable(Globale.PemainAktif, KursorKamera, 0);
				End;
			End;
			If(And(Globale.PemainAktif.MenuTerbuka == True, Globale.PemainAktif.HalamanMenu == 4));
				If(Globale.PemainAktif.KursorBalasDendam < Count Of(Globale.PemainAktif.DaftarTargetBalasDendam));
					Set Giocatore Variable(Globale.PemainAktif, TargetBalasDendamDipilih, Globale.PemainAktif.DaftarTargetBalasDendam[Globale.PemainAktif.KursorBalasDendam]);
				Else;
					Set Giocatore Variable(Globale.PemainAktif, TargetBalasDendamDipilih, Null);
				End;
				Set Giocatore Variable(Globale.PemainAktif, DaftarTargetBalasDendam, Filtered Array(Globale.PemainManusia, Attuale Array Element != Globale.PemainAktif));
				If(Count Of(Globale.PemainAktif.DaftarTargetBalasDendam) == 0);
					Set Giocatore Variable(Globale.PemainAktif, KursorBalasDendam, 0);
				Else If(And(Globale.PemainAktif.TargetBalasDendamDipilih != Null, Array Contains(Globale.PemainAktif.DaftarTargetBalasDendam, Globale.PemainAktif.TargetBalasDendamDipilih)));
					Set Giocatore Variable(Globale.PemainAktif, KursorBalasDendam, Index Of Array Value(Globale.PemainAktif.DaftarTargetBalasDendam, Globale.PemainAktif.TargetBalasDendamDipilih));
				Else If(Globale.PemainAktif.KursorBalasDendam >= Count Of(Globale.PemainAktif.DaftarTargetBalasDendam));
					Set Giocatore Variable(Globale.PemainAktif, KursorBalasDendam, 0);
				End;
			End;
		End;
	}
}

regola("89d - Subrutin: Proses mesin status Coba Nasib")
{
	evento
	{
		Subroutine;
		ProsesNasibPemain;
	}

	azioni
	{
		If(And(Globale.PemainAktif.Manusia == True, And(Globale.PemainAktif.KartuNasibAktif == True, And(Has Generato(Globale.PemainAktif) == True, Is Vivo(Globale.PemainAktif) == True))));
			If(And(Globale.PemainAktif.PutaranKartuNasib > 0, Totale Tempo Elapsed >= Globale.PemainAktif.WaktuPutaranNasibBerikut));
				If(Globale.PemainAktif.IkonKartuNasib != Null);
					Distruggi Icon(Globale.PemainAktif.IkonKartuNasib);
				End;
				Globale.PemainAktif.EfekNasib = Casuale Integer(1, 6);
				If(Globale.PemainAktif.EfekNasib == 1);
					Create Icon(Globale.PemainManusia, Update Every Frame(Eye Posizione(Evaluate Once(Globale.PemainAktif)) + Sguardo in Corso Direction Of(Evaluate Once(Globale.PemainAktif)) * 4), Eye, Posizione, Color(Aqua), True);
				Else If(Globale.PemainAktif.EfekNasib == 2);
					Create Icon(Globale.PemainManusia, Update Every Frame(Eye Posizione(Evaluate Once(Globale.PemainAktif)) + Sguardo in Corso Direction Of(Evaluate Once(Globale.PemainAktif)) * 4), Dizzy, Posizione, Color(Violet), True);
				Else If(Globale.PemainAktif.EfekNasib == 3);
					Create Icon(Globale.PemainManusia, Update Every Frame(Eye Posizione(Evaluate Once(Globale.PemainAktif)) + Sguardo in Corso Direction Of(Evaluate Once(Globale.PemainAktif)) * 4), Skull, Posizione, Custom Color(255, 70, 70, 255), True);
				Else If(Globale.PemainAktif.EfekNasib == 4);
					Create Icon(Globale.PemainManusia, Update Every Frame(Eye Posizione(Evaluate Once(Globale.PemainAktif)) + Sguardo in Corso Direction Of(Evaluate Once(Globale.PemainAktif)) * 4), Cuore, Posizione, Custom Color(70, 255, 110, 255), True);
				Else If(Globale.PemainAktif.EfekNasib == 5);
					Create Icon(Globale.PemainManusia, Update Every Frame(Eye Posizione(Evaluate Once(Globale.PemainAktif)) + Sguardo in Corso Direction Of(Evaluate Once(Globale.PemainAktif)) * 4), Fire, Posizione, Color(Orange), True);
				Else;
					Create Icon(Globale.PemainManusia, Update Every Frame(Eye Posizione(Evaluate Once(Globale.PemainAktif)) + Sguardo in Corso Direction Of(Evaluate Once(Globale.PemainAktif)) * 4), Poison 2, Posizione, Custom Color(170, 80, 255, 255), True);
				End;
				Globale.PemainAktif.IkonKartuNasib = Last Created Entity;
				Modify Giocatore Variable(Globale.PemainAktif, PutaranKartuNasib, Subtract, 1);
				Globale.PemainAktif.WaktuPutaranNasibBerikut = Totale Tempo Elapsed + Globale.PemainAktif.JedaKartuNasib;
				Modify Giocatore Variable(Globale.PemainAktif, JedaKartuNasib, Add, 0.045);
			End;
			If(And(Globale.PemainAktif.PutaranKartuNasib == 0, And(Globale.PemainAktif.WaktuIkonNasibBerakhir == 0, And(Globale.PemainAktif.WaktuPutaranNasibBerikut > 0, Totale Tempo Elapsed >= Globale.PemainAktif.WaktuPutaranNasibBerikut))));
				"Hasil akhir diterapkan satu kali setelah ikon terakhir selesai, tanpa Wait per pemain."
				Globale.PemainAktif.EfekNasibBerakhir = 0;
				Globale.PemainAktif.WaktuBakarNasibBerikut = 0;
				Globale.PemainAktif.MenuNasibHarusDibuka = False;
				If(Or(Or(Globale.PemainAktif.EfekNasib == 1, Globale.PemainAktif.EfekNasib == 2), Or(Globale.PemainAktif.EfekNasib == 5, Globale.PemainAktif.EfekNasib == 6)));
					If(Globale.PemainAktif.HudMenu != Null);
						Distruggi HUD Text(Globale.PemainAktif.HudMenu);
					End;
					If(Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif) >= 0);
						Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Globale.PemainAktif)] = 0;
					End;
					Globale.PemainAktif.HudMenu = Null;
					Globale.PemainAktif.MenuTerbuka = False;
					Globale.PemainAktif.InputMenuDikunci = False;
					Globale.PemainAktif.PerintahMenu = 0;
					Globale.PemainAktif.HalamanMenu = -1;
					Allow Button(Globale.PemainAktif, Button(Fuoco Primario));
					Allow Button(Globale.PemainAktif, Button(Secondary Fire));
					Allow Button(Globale.PemainAktif, Button(Interagisci));
					Allow Button(Globale.PemainAktif, Button(Reload));
					Allow Button(Globale.PemainAktif, Button(Abilità 1));
					Allow Button(Globale.PemainAktif, Button(Abilità 2));
					Allow Button(Globale.PemainAktif, Button(Ultimate));
				End;
				If(Globale.PemainAktif.EfekNasib == 1);
					Globale.PemainAktif.PrivasiNasibAktif = True;
					Globale.PemainAktif.EfekNasibBerakhir = Totale Tempo Elapsed + 15;
					Small Message(Globale.PemainAktif, Globale.PemainAktif.IndeksBahasa == 0 ? Custom String("TRY YOUR LUCK: OTHER PLAYER / BOT NAMES — 15s") : Globale.PemainAktif.IndeksBahasa == 1 ? Custom String("COBA NASIB: NAMA PEMAIN / BOT LAIN — 15dtk") : Custom String("เสี่ยงโชค: ชื่อผู้เล่น / บอตอื่น — 15 วินาที"));
				Else If(Globale.PemainAktif.EfekNasib == 2);
					Set Move Velocità Non Direzionale(Globale.PemainAktif, 1000);
					Avvio Accelerating(Globale.PemainAktif, Sguardo in Corso Direction Of(Evaluate Once(Globale.PemainAktif)), 50, 25, To World, Direction Rate and Massimo Velocità Non Direzionale);
					Globale.PemainAktif.EfekNasibBerakhir = Totale Tempo Elapsed + 10;
					Small Message(Globale.PemainAktif, Globale.PemainAktif.IndeksBahasa == 0 ? Custom String("TRY YOUR LUCK: AIM-STEERED ACCELERATION — 10s") : Globale.PemainAktif.IndeksBahasa == 1 ? Custom String("COBA NASIB: AKSELERASI MENGIKUTI BIDIKAN — 10dtk") : Custom String("เสี่ยงโชค: เร่งความเร็วตามทิศเล็ง — 10 วินาที"));
				Else If(Globale.PemainAktif.EfekNasib == 3);
					Small Message(Globale.PemainAktif, Globale.PemainAktif.IndeksBahasa == 0 ? Custom String("TRY YOUR LUCK: SKULL") : Globale.PemainAktif.IndeksBahasa == 1 ? Custom String("COBA NASIB: TENGKORAK") : Custom String("เสี่ยงโชค: กะโหลก"));
					Uccisione(Globale.PemainAktif, Null);
				Else If(Globale.PemainAktif.EfekNasib == 4);
					Set Giocatore Salute(Filtered Array(All Living Giocatori(Squadra Of(Globale.PemainAktif)), Giocatore Variable(Attuale Array Element, Manusia) == True), 9999);
					Small Message(Filtered Array(All Living Giocatori(Squadra Of(Globale.PemainAktif)), Giocatore Variable(Attuale Array Element, Manusia) == True), Giocatore Variable(Local Giocatore, IndeksBahasa) == 0 ? Custom String("TRY YOUR LUCK: HEART — TEAM FULL HEAL") : Giocatore Variable(Local Giocatore, IndeksBahasa) == 1 ? Custom String("COBA NASIB: HATI — TIM SEMBUH PENUH") : Custom String("เสี่ยงโชค: หัวใจ — รักษาทีมเต็มพลัง"));
					Globale.PemainAktif.EfekNasib = 0;
					Globale.PemainAktif.KartuNasibAktif = False;
				Else If(Globale.PemainAktif.EfekNasib == 5);
					Set Stato(Globale.PemainAktif, Null, Bruciatura in Corso, 10);
					Globale.PemainAktif.EfekNasibBerakhir = Totale Tempo Elapsed + 10;
					Globale.PemainAktif.WaktuBakarNasibBerikut = Totale Tempo Elapsed;
					Small Message(Globale.PemainAktif, Globale.PemainAktif.IndeksBahasa == 0 ? Custom String("TRY YOUR LUCK: BURNING — 5% MAX HP / SEC — 10s") : Globale.PemainAktif.IndeksBahasa == 1 ? Custom String("COBA NASIB: TERBAKAR — 5% HP MAKS / DETIK — 10dtk") : Custom String("เสี่ยงโชค: ไฟไหม้ — 5% HP สูงสุด / วินาที — 10 วินาที"));
				Else;
					Set Stato(Globale.PemainAktif, Null, Sabotato, 5);
					Globale.PemainAktif.EfekNasibBerakhir = Totale Tempo Elapsed + 5;
					Small Message(Globale.PemainAktif, Globale.PemainAktif.IndeksBahasa == 0 ? Custom String("TRY YOUR LUCK: HACKED — 5s") : Globale.PemainAktif.IndeksBahasa == 1 ? Custom String("COBA NASIB: DIRETAS — 5dtk") : Custom String("เสี่ยงโชค: ถูกแฮ็ก — 5 วินาที"));
				End;
				Globale.PemainAktif.WaktuPutaranNasibBerikut = 0;
				Globale.PemainAktif.WaktuIkonNasibBerakhir = Totale Tempo Elapsed + 1;
			End;
		End;
		If(And(Globale.PemainAktif.Manusia == True, And(Globale.PemainAktif.EfekNasib == 5, And(Globale.PemainAktif.EfekNasibBerakhir > Totale Tempo Elapsed, And(Globale.PemainAktif.WaktuBakarNasibBerikut <= Totale Tempo Elapsed, And(Has Generato(Globale.PemainAktif) == True, Is Vivo(Globale.PemainAktif) == True))))));
			Danneggia(Globale.PemainAktif, Globale.PemainAktif, Massimo Salute(Globale.PemainAktif) * 0.025);
			Globale.PemainAktif.WaktuBakarNasibBerikut = Totale Tempo Elapsed + 0.500;
		End;
		If(And(Globale.PemainAktif.Manusia == True, And(Globale.PemainAktif.KartuNasibAktif == True, And(Globale.PemainAktif.PutaranKartuNasib == 0, And(Globale.PemainAktif.EfekNasibBerakhir > 0, Totale Tempo Elapsed >= Globale.PemainAktif.EfekNasibBerakhir)))));
			Clear Stato(Globale.PemainAktif, Bruciatura in Corso);
			Clear Stato(Globale.PemainAktif, Sabotato);
			Interrompi Accelerating(Globale.PemainAktif);
			If(Globale.PemainAktif.HudEfekNasib != Null);
				Distruggi HUD Text(Globale.PemainAktif.HudEfekNasib);
			End;
			Globale.PemainAktif.HudEfekNasib = Null;
			Set Move Velocità Non Direzionale(Globale.PemainAktif, 100);
			Globale.PemainAktif.PrivasiNasibAktif = False;
			Globale.PemainAktif.EfekNasib = 0;
			Globale.PemainAktif.EfekNasibBerakhir = 0;
			Globale.PemainAktif.WaktuBakarNasibBerikut = 0;
			Globale.PemainAktif.KartuNasibAktif = False;
			Globale.PemainAktif.MenuNasibHarusDibuka = True;
		End;
		If(And(Globale.PemainAktif.WaktuIkonNasibBerakhir > 0, Totale Tempo Elapsed >= Globale.PemainAktif.WaktuIkonNasibBerakhir));
			If(Globale.PemainAktif.IkonKartuNasib != Null);
				Distruggi Icon(Globale.PemainAktif.IkonKartuNasib);
			End;
			Globale.PemainAktif.IkonKartuNasib = Null;
			Globale.PemainAktif.WaktuIkonNasibBerakhir = 0;
			If(And(Globale.PemainAktif.KartuNasibAktif == False, Globale.PemainAktif.MenuTerbuka == False));
				Globale.PemainAktif.MenuNasibHarusDibuka = True;
			End;
		End;
	}
}

regola("90 - Subrutin: Tutup menu dan pulihkan tombol")
{
	evento
	{
		Subroutine;
		TutupMenu;
	}

	azioni
	{
		If(Event Giocatore.HudMenu != Null);
			Distruggi HUD Text(Event Giocatore.HudMenu);
		End;
		If(Index Of Array Value(Globale.PemainManusia, Event Giocatore) >= 0);
			Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Event Giocatore)] = 0;
		End;
		Event Giocatore.HudMenu = Null;
		Event Giocatore.MenuTerbuka = False;
		Event Giocatore.PerintahMenu = 0;
		Event Giocatore.HalamanMenu = -1;
		If(Is Button Held(Event Giocatore, Button(Melee)));
			Event Giocatore.SeranganDekatDipakai = True;
		Else;
			Allow Button(Event Giocatore, Button(Melee));
			Event Giocatore.SeranganDekatDipakai = False;
		End;
		Allow Button(Event Giocatore, Button(Salta));
		Allow Button(Event Giocatore, Button(Accovacciati));
		Allow Button(Event Giocatore, Button(Fuoco Primario));
		Allow Button(Event Giocatore, Button(Secondary Fire));
		Allow Button(Event Giocatore, Button(Interagisci));
		Allow Button(Event Giocatore, Button(Reload));
		Allow Button(Event Giocatore, Button(Abilità 1));
		Allow Button(Event Giocatore, Button(Abilità 2));
		Allow Button(Event Giocatore, Button(Ultimate));
	}
}

regola("91 - Subrutin: Gambar satu HUD menu aktif")
{
	evento
	{
		Subroutine;
		GambarMenu;
	}

	azioni
	{
		If(Event Giocatore.HudMenu != Null);
			Distruggi HUD Text(Event Giocatore.HudMenu);
			Event Giocatore.HudMenu = Null;
		End;
		Call Subroutine(GambarHalamanAktif);
		Call Subroutine(TransisiWarnaMenu);
		If(Index Of Array Value(Globale.PemainManusia, Event Giocatore) >= 0);
			Globale.HudMenuPemain[Index Of Array Value(Globale.PemainManusia, Event Giocatore)] = Event Giocatore.HudMenu;
		End;
	}
}

regola("91a - Subrutin: Gambar menu utama")
{
	evento
	{
		Subroutine;
		GambarUtama;
	}

	azioni
	{
		Create HUD Text(Event Giocatore, Null, Event Giocatore.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String("Hold CROUCH + command\n{0}: next | {1}: previous", Input Binding String(Button(Fuoco Primario)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: open | hold {1} 0.5 sec: close", Input Binding String(Button(Interagisci)), Input Binding String(Button(Melee)))) : Event Giocatore.IndeksBahasa == 1 ? Custom String("{0}\n{1}", Custom String("Tahan JONGKOK + perintah\n{0}: berikutnya | {1}: sebelumnya", Input Binding String(Button(Fuoco Primario)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: buka | tahan {1} 0,5 dtk: tutup", Input Binding String(Button(Interagisci)), Input Binding String(Button(Melee)))) : Custom String("{0}\n{1}", Custom String("กด ย่อ + คำสั่ง\n{0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Fuoco Primario)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: เปิด | กด {1} ค้างเพื่อปิด", Input Binding String(Button(Interagisci)), Input Binding String(Button(Melee)))), Event Giocatore.IndeksBahasa == 0 ? Event Giocatore.KursorUtama == 0 ? Custom String("0 - SOUNDTRACK\nCURRENT: {0}", Event Giocatore.IndeksGenre >= 0 ? Globale.DaftarGenre[Event Giocatore.IndeksGenre] : Custom String("no soundtrack yet")) : Event Giocatore.KursorUtama == 1 ? Custom String("1 - THIRD-PERSON\nCURRENT: {0}", Event Giocatore.ModeKamera == 0 ? Custom String("off") : Event Giocatore.ModeKamera == 1 ? Custom String("your hero") : Custom String("watching {0}", Event Giocatore.TargetKamera)) : Event Giocatore.KursorUtama == 2 ? Custom String("2 - NAME COLOR\nCURRENT: {0}", Globale.NamaWarnaInggris[Event Giocatore.IndeksWarna]) : Event Giocatore.KursorUtama == 3 ? Custom String("3 - LANGUAGE\nCURRENT: {0}", Globale.NamaBahasa[Event Giocatore.IndeksBahasa]) : Event Giocatore.KursorUtama == 4 ? Custom String("4 - REVENGE\nSETTLE YOUR SCORE") : Event Giocatore.KursorUtama == 5 ? Custom String("5 - UNKILLABLE\nCURRENT: {0}", Event Giocatore.ModeKebal == 0 ? Custom String("OFF") : Event Giocatore.ModeKebal == 1 ? Custom String("1 HP (HEALABLE)") : Custom String("FULL HP")) : Event Giocatore.KursorUtama == 6 ? Custom String("6 - HERO VOICE\nCURRENT: {0}", Event Giocatore.IndeksSuara == 0 ? Custom String("NORMAL") : Event Giocatore.IndeksSuara == 1 ? Custom String("LOW 0.50x") : Event Giocatore.IndeksSuara == 2 ? Custom String("LOW 0.75x") : Event Giocatore.IndeksSuara == 3 ? Custom String("HIGH 1.25x") : Custom String("HIGH 1.50x")) : Event Giocatore.KursorUtama == 7 ? Event Giocatore.IndeksIkon == 0 ? Custom String("7 - ICON\nCURRENT: NOTHING") : Custom String("7 - ICON\nCURRENT: {0} {1}", Globale.DaftarIkon[Event Giocatore.IndeksIkon], Globale.NamaIkonInggris[Event Giocatore.IndeksIkon]) : Event Giocatore.KursorUtama == 8 ? Custom String("8 - CROUCH TELEPORT\nCURRENT: {0}", Event Giocatore.TeleportasiJongkokDiaktifkan ? Custom String("ON") : Custom String("OFF")) : Event Giocatore.KursorUtama == 9 ? Custom String("9 - CROUCH PRIVACY\nCURRENT: {0}", Event Giocatore.PrivasiInspeksiAktif ? Custom String("ON") : Custom String("OFF")) : Event Giocatore.KursorUtama == 10 ? Custom String("10 - TRY YOUR LUCK\nSTATUS: {0}", Event Giocatore.KartuNasibAktif ? Event Giocatore.PutaranKartuNasib > 0 ? Custom String("ROLLING") : Custom String("ACTIVE") : Custom String("READY")) : Custom String("11 - VOTE PLAYER\nYOUR VOTE: {0}", Event Giocatore.PemainDipilih != Null ? Event Giocatore.PemainDipilih : Custom String("NONE")) : Event Giocatore.IndeksBahasa == 1 ? Event Giocatore.KursorUtama == 0 ? Custom String("0 - MUSIK\nSAAT INI: {0}", Event Giocatore.IndeksGenre >= 0 ? Globale.DaftarGenre[Event Giocatore.IndeksGenre] : Custom String("belum pilih musik")) : Event Giocatore.KursorUtama == 1 ? Custom String("1 - KAMERA 3P\nSAAT INI: {0}", Event Giocatore.ModeKamera == 0 ? Custom String("mati") : Event Giocatore.ModeKamera == 1 ? Custom String("hero sendiri") : Custom String("menonton 