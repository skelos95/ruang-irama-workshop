			Custom String("Kyrgyzstan"),
			Custom String("Laos"),
			Custom String("Malaysia"),
			Custom String("Maldives"),
			Custom String("Myanmar"),
			Custom String("Mongolia"),
			Custom String("Nepal"),
			Custom String("Pakistan"),
			Custom String("Philippines"),
			Custom String("Singapore"),
			Custom String("South Korea"),
			Custom String("Sri Lanka"),
			Custom String("Tajikistan"),
			Custom String("Taiwan"),
			Custom String("Thailand"),
			Custom String("Uzbekistan"),
			Custom String("Vietnam")
		), 1);
		Globale.DiagnostikPerforma = Workshop Setting Toggle(Custom String("CHILL DEDICATED SERVER"), Custom String("Diagnostics / Diagnostik / การวินิจฉัย"), False, 2);
		Globale.WaktuAkhirServer = Total Time Elapsed + Globale.DurasiServerMenit * 60;
		Globale.SisaWaktuServer = Max(0, Round To Integer(Globale.WaktuAkhirServer - Total Time Elapsed, Up));
		Globale.TeksWaktuServer = Globale.SisaWaktuServer % 60 < 10 ? Custom String("{0}:0{1}", Round To Integer(Globale.SisaWaktuServer / 60, Down),
			Globale.SisaWaktuServer % 60) : Custom String("{0}:{1}", Round To Integer(Globale.SisaWaktuServer / 60, Down), Globale.SisaWaktuServer % 60);
		Globale.MulaiUlangSudahDiminta = False;
		Globale.ModeMulaiDiminta = False;
		Globale.PemainAktif = Null;
		Globale.IndeksPemainGlobal = 0;
		Globale.LangkahPenjadwal = 0;
		Globale.PemainSiklusGlobal = Null;
		Globale.WaktuSiklusGlobal = 0;
		Globale.TimDummyAktif = Team 1;
		Globale.RGBFase = 0;
		Globale.RGB = Custom Color(255, 80, 80, 255);
		"Skor dan objektif tetap milik mode asli; penyelesaian pertandingan ditahan sampai penghitung waktu CHILL habis."
		"Mode dibuat tenang dan bersih tanpa penyiar serta musik bawaan mode."
		Disable Built-In Game Mode Announcer;
		Disable Built-In Game Mode Music;
		If(Globale.DiagnostikPerforma == False);
			Disable Inspector Recording;
		End;

		Create HUD Text(Globale.PemainManusia, Null, Null,
			Custom String("{0} [{1}]", Custom String("CHILL DEDICATED SERVER"), Globale.TeksWaktuServer), Top, 0,
			Custom Color(255, 255, 255, 255), Custom Color(255, 255, 255, 255), Globale.RGB,
			Visible To String and Color, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null,
			Player Variable(Local Player, IndeksBahasa) == 0 ? Custom String("SERVER LOCATION: {0}", Globale.NamaLokasiInggris[Globale.IndeksLokasiServer]) : Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String("LOKASI SERVER: {0}", Globale.NamaLokasiIndonesia[Globale.IndeksLokasiServer]) : Custom String("ตำแหน่งเซิร์ฟเวอร์: {0}", Globale.NamaLokasiThai[Globale.IndeksLokasiServer]),
			Null, Top, 1, Custom Color(255, 255, 255, 255), Custom Color(255, 205, 110, 255), Globale.RGB,
			Visible To String and Color, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null, Null, Custom String("  "), Top, 2,
			Custom Color(255, 255, 255, 255), Custom Color(255, 255, 255, 255), Globale.RGB,
			Visible To String and Color, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null, Player Variable(Local Player, IndeksBahasa) == 0 ? Custom String(
			"Hold {0}: inspect hero + HP", Input Binding String(Button(Crouch))) : Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String(
			"Tahan {0}: cek pahlawan + HP", Input Binding String(Button(Crouch))) : Custom String("กด {0} ค้าง: ดูฮีโร่ + HP", Input Binding String(Button(Crouch))), Null,
			Left, -2, Custom Color(255, 255, 255, 255), Custom Color(185, 225, 255, 255), Custom Color(70, 225, 255, 255),
			Visible To and String, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null, Custom String(" "), Null, Left, -1,
			Custom Color(255, 255, 255, 255), Custom Color(185, 225, 255, 255), Custom Color(70, 225, 255, 255),
			Visible To and String, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null, Null, Player Variable(Local Player, IndeksBahasa) == 0 ? Custom String(
			"LOBBY & CHILL TIME") : Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String("LOBI & WAKTU SANTAI") : Custom String("ล็อบบี้ & เวลาชิล"),
			Left, 0, Custom Color(255, 255, 255, 255), Custom Color(185, 225, 255, 255), Custom Color(70, 225, 255, 255),
			Visible To and String, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null, Player Variable(Local Player, IndeksBahasa) == 0 ? Custom String(
			"Hold {0} 0.5s: Arcade Menu | Hold {1} 0.5s: Camera", Input Binding String(Button(Melee)), Input Binding String(Button(Interact))) : Player Variable(Local Player,
			IndeksBahasa) == 1 ? Custom String("Tahan {0} 0,5dtk: Menu Arcade | Tahan {1} 0,5dtk: Kamera", Input Binding String(Button(Melee)), Input Binding String(Button(Interact))) : Custom String(
			"กด {0} ค้าง 0.5วิ: เมนูอาร์เคด | กด {1} ค้าง 0.5วิ: กล้อง", Input Binding String(Button(Melee)), Input Binding String(Button(Interact))), Null,
			Right, -16, Custom Color(255, 255, 255, 255), Custom Color(235, 195, 255, 255), Custom Color(210, 110, 255, 255),
			Visible To and String, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null, Null, Custom String("  "), Right, -15,
			Custom Color(255, 255, 255, 255), Custom Color(235, 195, 255, 255), Custom Color(210, 110, 255, 255),
			Visible To and String, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null, Null, Player Variable(Local Player, IndeksBahasa) == 0 ? Custom String(
			"PLAYER VIBES") : Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String("MUSIK PEMAIN") : Custom String("เพลงของผู้เล่น"),
			Right, -14, Custom Color(255, 255, 255, 255), Custom Color(235, 195, 255, 255), Custom Color(210, 110, 255, 255),
			Visible To and String, Visible Never);
		Create HUD Text(Globale.PemainManusia, Null, Null, Custom String("  "), Right, -1,
			Custom Color(255, 255, 255, 255), Custom Color(235, 195, 255, 255), Custom Color(210, 110, 255, 255),
			Visible To and String, Visible Never);
		Globale.Siap = True;
	}
}

regola("00a1 - Umum: Mulai mode segera saat menunggu pemain")
{
	evento
	{
		Ongoing - Global;
	}

	condizioni
	{
		Globale.Siap == True;
		Globale.ModeMulaiDiminta == False;
		Is Game In Progress == False;
		Is Waiting For Players == True;
	}

	azioni
	{
		"Permintaan mulai hanya boleh dikirim sekali sampai pertandingan berikutnya."
		Globale.ModeMulaiDiminta = True;
		Start Game Mode;
	}
}

regola("00a2 - Umum: Lewati pemilihan pahlawan")
{
	evento
	{
		Ongoing - Global;
	}

	condizioni
	{
		Globale.Siap == True;
		Globale.PilihPahlawanDilewati == False;
		Is Game In Progress == False;
		Is Assembling Heroes == True;
	}

	azioni
	{
		"Jalankan satu kali hanya pada fase awal; pindah tim saat pertandingan berjalan tidak boleh memanggil Set Match Time berulang kali."
		Globale.PilihPahlawanDilewati = True;
		Set Match Time(0);
	}
}

regola("00a3 - Umum: Lewati persiapan awal")
{
	evento
	{
		Ongoing - Global;
	}

	condizioni
	{
		Globale.Siap == True;
		Globale.PersiapanDilewati == False;
		Is Game In Progress == False;
		Is In Setup == True;
	}

	azioni
	{
		"Lewati persiapan sekali saja agar aturan global tidak menembak Set Match Time terus-menerus."
		Globale.PersiapanDilewati = True;
		Set Match Time(0);
	}
}

regola("00c - Umum: Mulai ulang tepat sekali saat hitung mundur habis")
{
	evento
	{
		Ongoing - Global;
	}

	condizioni
	{
		Globale.Siap == True;
		Globale.MulaiUlangSudahDiminta == False;
		Globale.SisaWaktuServer <= 0;
	}

	azioni
	{
		"Kunci mencegah beberapa aksi mulai ulang pada langkah yang sama; tidak ada pemenang atau skor yang diumumkan."
		Globale.MulaiUlangSudahDiminta = True;
		Globale.PilihPahlawanDilewati = False;
		Globale.PersiapanDilewati = False;
		Globale.ModeMulaiDiminta = False;
		Restart Match;
	}
}

regola("01b - Siklus tim: Pekerja penyiapan dari penjadwal global")
{
	evento
	{
		Ongoing - Each Player;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.BotOtomatis == False;
		Array Contains(Globale.PemainManusia, Event Player) == False;
		Event Player.PindahTimDiproses == True;
		Globale.PemainSiklusGlobal == Event Player;
		Event Player.TimSiklusTarget == Team Of(Event Player);
		Has Spawned(Event Player) == True;
		Event Player.SiklusPemainAktif == False;
		Event Player.SudahSiap == False;
		Total Time Elapsed >= Event Player.WaktuSiklusTim;
	}

	azioni
	{
		Call Subroutine(TenangkanPemain);
		Call Subroutine(SiapkanPemain);
	}
}

regola("02 - Pemain: Pisahkan manusia dari pasukan kaleng")
{
	evento
	{
		Ongoing - Each Player;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Globale.Siap == True;
		Is Dummy Bot(Event Player) == False;
		Array Contains(Globale.PemainManusia, Event Player) == False;
		Event Player.SudahSiap == True;
		Event Player.SiklusPemainAktif == False;
		Has Spawned(Event Player) == True;
		Event Player.SudahDiperiksa == False;
	}

	azioni
	{
		Event Player.SudahDiperiksa = True;
		Event Player.BotOtomatis = False;
		Event Player.Manusia = False;
		Event Player.WarnaNama = Custom Color(255, 255, 255, 255);
		If(And(Event Player.PernahDisiapkan == True, And(Event Player.NamaTampilan != Null, Event Player.NamaTampilan != Custom String(""))));
			"Gunakan nama cache saat pindah tim agar pemain manusia terdaftar tidak terjebak probe iBot."
			Event Player.BotOtomatis = False;
		Else;
			Start Forcing Dummy Bot Name(Event Player, Custom String("​"));
			Wait(0.016, Ignora condizione);
			Abort If(Entity Exists(Event Player) == False);
			If(Or(Event Player.SudahSiap == False, Has Spawned(Event Player) == False));
				Stop Forcing Dummy Bot Name(Event Player);
				Event Player.SudahDiperiksa = False;
				Abort;
			End;
			If(Custom String("{0}", Event Player) == Custom String("​"));
				Event Player.BotOtomatis = True;
			Else;
				Event Player.BotOtomatis = False;
			End;
			Stop Forcing Dummy Bot Name(Event Player);
		End;
		If(Event Player.BotOtomatis == True);
			Cancel Primary Action(Event Player);
			Call Subroutine(KunciBot);
			Abort;
		End;

		Abort If(Entity Exists(Event Player) == False);
		Abort If(Array Contains(Globale.PemainManusia, Event Player));
		If(Count Of(Globale.SlotHUDTersedia) == 0);
			Event Player.SudahDiperiksa = False;
			Event Player.SudahSiap = False;
			Event Player.PindahTimDiproses = False;
			Event Player.SiklusPemainAktif = False;
			Event Player.WaktuSiklusTim = Total Time Elapsed + 0.250;
			If(Globale.PemainSiklusGlobal == Event Player);
				Globale.PemainSiklusGlobal = Null;
				Globale.WaktuSiklusGlobal = Total Time Elapsed + 0.250;
			End;
			Abort;
		End;
		"Bekukan nama manusia sekali saat identitasnya valid. HUD roster dan teks dunia memakai salinan ini agar token player tidak kosong setelah pindah tim."
		Event Player.NamaTampilan = Evaluate Once(Custom String("{0}", Event Player));
		If(Or(Event Player.NamaTampilan == Null, Event Player.NamaTampilan == Custom String("")));
			"Nama manusia yang masih kosong belum merupakan identitas stabil: jangan pakai slot roster dan jadwalkan ulang setup ringan."
			Event Player.SudahDiperiksa = False;
			Event Player.SudahSiap = False;
			Event Player.WaktuSiklusTim = Total Time Elapsed + 0.250;
			If(Globale.PemainSiklusGlobal == Event Player);
				Globale.PemainSiklusGlobal = Null;
				Globale.WaktuSiklusGlobal = Total Time Elapsed + 0.250;
			End;
			Abort;
		End;
		"Sembunyikan bilah, objektif, dan ikon mode tanpa mengganggu HUD pahlawan serta HUD buatan kita."
		Disable Game Mode HUD(Event Player);
		Disable Game Mode In-World UI(Event Player);
		Event Player.IndeksGenre = -1;
		Event Player.IndeksWarna = 0;
		Event Player.WarnaNama = Globale.DaftarWarna[Event Player.IndeksWarna];
		If(Custom String("{0}", Event Player) == Custom String("งูแท้"));
			Event Player.MusikKhusus = Custom String("Caladan Brood");
			Event Player.IndeksWarna = 1;
			Event Player.KursorWarna = 1;
			Event Player.WarnaNama = Globale.DaftarWarna[1];
			Event Player.WarnaMenu = Globale.DaftarWarnaRGB[1];
			Event Player.IndeksIkon = 23;
			Event Player.KursorIkon = 23;
		End;
		Event Player.MenitLobi = 0;
		Event Player.UrutanHUD = First Of(Globale.SlotHUDTersedia);
		Globale.SlotHUDTerakhir = Max(Globale.SlotHUDTerakhir, Event Player.UrutanHUD);
		Modify Global Variable(SlotHUDTersedia, Remove From Array By Index, 0);
		Globale.PemainManusia = Append To Array(Globale.PemainManusia, Event Player);
		Disable Nameplates(Event Player, Filtered Array(Globale.PemainManusia, Player Variable(Current Array Element, InspeksiAktif) == True));

		Globale.HudKiriPemain = Append To Array(Globale.HudKiriPemain, 0);
		Globale.HudKananPemain = Append To Array(Globale.HudKananPemain, 0);
		Globale.HudMenuPemain = Append To Array(Globale.HudMenuPemain, 0);
		Globale.TeksDuniaPemain = Append To Array(Globale.TeksDuniaPemain, 0);
		Globale.SlotHUDPemain = Append To Array(Globale.SlotHUDPemain, Event Player.UrutanHUD);
		Event Player.Manusia = True;
		Event Player.PahlawanTerakhir = Hero Of(Event Player);
		Call Subroutine(HitungPilihan);
	}
}

regola("02b - HUD Pemain: Buat segera setelah klasifikasi selesai")
{
	evento
	{
		Ongoing - Each Player;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Globale.Siap == True;
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Array Contains(Globale.PemainManusia, Event Player) == True;
		Has Spawned(Event Player) == True;
		Event Player.TimTerakhir == Team Of(Event Player);
		Event Player.SegarkanRosterTertunda == False;
		Event Player.NamaTampilan != Null;
		Event Player.NamaTampilan != Custom String("");
		Event Player.HudPemainDibuat == False;
		Event Player.HudKiri == Null;
		Event Player.HudKanan == Null;
	}

	azioni
	{
		"Klasifikasi manusia dan bot sudah selesai. HUD pemain dibuat sekali pada keadaan muncul yang stabil."
		Create HUD Text(Globale.PemainManusia, Null, Custom String("{0}{1}{2}", Custom String("{0} {1} {2}",
			Globale.DaftarIkon[Event Player.IndeksIkon], Hero Icon String(Is Duplicating(Event Player) ? Hero Being Duplicated(Event Player) : Hero Of(Event Player)),
			Player Variable(Local Player, IndeksBahasa) == 0 ? Custom String("{0} - {1} MIN", Event Player.NamaTampilan, Event Player.MenitLobi) : Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String("{0} - {1} MENIT", Event Player.NamaTampilan, Event Player.MenitLobi) : Custom String("{0} - {1} นาที", Event Player.NamaTampilan, Event Player.MenitLobi)), Event Player.UrutanHUD == Globale.SlotHUDTerakhir ? Globale.PemimpinPilihan != Null
			? Player Variable(Local Player, IndeksBahasa) == 2 ? Custom String("\n \nดาวสายชิล: {0}", Globale.PemimpinPilihan)
			: Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String("\n \nBINTANG CHILL: {0}", Globale.PemimpinPilihan)
			: Custom String("\n \nCHILL STAR: {0}", Globale.PemimpinPilihan) : Custom String("") : Custom String(""),
			And(Globale.DiagnostikPerforma == True, And(Local Player == Host Player, Event Player.UrutanHUD == Globale.SlotHUDTerakhir)) ? Custom String("{0}\n{1}",
			Player Variable(Local Player, IndeksBahasa) == 2 ? Custom String("\n \nโหลด {0}% | เฉลี่ย {1}% | สูงสุด {2}%", Server Load,
			Server Load Average, Server Load Peak) : Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String(
			"\n \nBEBAN {0}% | RATA {1}% | PUNCAK {2}%", Server Load, Server Load Average, Server Load Peak) : Custom String(
			"\n \nLOAD {0}% | AVG {1}% | MAX {2}%", Server Load, Server Load Average, Server Load Peak), Custom String("HUD {0} | IWT {1}",
			10 + Count Of(Filtered Array(Globale.HudKiriPemain, Current Array Element != 0)) + Count Of(Filtered Array(Globale.HudKananPemain,
			Current Array Element != 0)) + Count Of(Filtered Array(Globale.HudMenuPemain, Current Array Element != 0)) + Count Of(
			Filtered Array(Globale.PemainManusia, And(Player Variable(Current Array Element, HudEfekNasib) != Null, Player Variable(
			Current Array Element, HudEfekNasib) != 0))), Count Of(Filtered Array(Globale.TeksDuniaPemain, Current Array Element != 0)) + Count Of(
			Filtered Array(Globale.PemainManusia, And(Player Variable(Current Array Element, TeksTeleportasi) != Null, Player Variable(
			Current Array Element, TeksTeleportasi) != 0))) + Count Of(Filtered Array(All Players(All Teams), And(Player Variable(
			Current Array Element, TeksVisiNasib) != Null, Player Variable(Current Array Element, TeksVisiNasib) != 0))))) : Custom String("")), Null, Left,
			1 + Event Player.UrutanHUD, Custom Color(255, 255, 255, 255), Event Player.WarnaNama, Custom Color(255, 255, 255, 255),
			Visible To String and Color, Visible Never);
		Event Player.HudKiri = Last Text ID;
		Globale.HudKiriPemain[Index Of Array Value(Globale.PemainManusia, Event Player)] = Event Player.HudKiri;
		Create HUD Text(Globale.PemainManusia, Null, Custom String("{0} {1} {2}", Globale.DaftarIkon[Event Player.IndeksIkon],
			Hero Icon String(Is Duplicating(Event Player) ? Hero Being Duplicated(Event Player) : Hero Of(Event Player)), Custom String("{0} - {1}", Event Player.NamaTampilan,
			Event Player.MusikKhusus != Null ? Event Player.MusikKhusus : Event Player.IndeksGenre >= 0 ? Globale.DaftarGenre[Event Player.IndeksGenre] : Player Variable(Local Player, IndeksBahasa) == 0 ? Custom String("no soundtrack yet")
			: Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String("belum pilih musik") : Custom String("ยังไม่ได้เลือกเพลง"))), Null, Right, -13 + Event Player.UrutanHUD,
			Custom Color(255, 255, 255, 255), Event Player.WarnaNama, Custom Color(255, 255, 255, 255), Visible To String and Color, Visible Never);
		Event Player.HudKanan = Last Text ID;
		Globale.HudKananPemain[Index Of Array Value(Globale.PemainManusia, Event Player)] = Event Player.HudKanan;
		Event Player.HudPemainDibuat = True;
		Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
			"Welcome to CHILL. Pick a vibe, pick a color, stay weird.") : Event Player.IndeksBahasa == 1 ? Custom String(
			"Selamat datang di CHILL. Pilih vibe, pilih warna, tetap aneh.") : Custom String(
			"ยินดีต้อนรับสู่ CHILL เลือกเพลง เลือกสี แล้วกวนแบบพอดี ๆ"));
	}
}

regola("03c - Bot/Dummy: Kunci saat hidup kembali atau pahlawan berganti")
{
	evento
	{
		Ongoing - Each Player;
		Tutti;
		Tutti;
	}

	condizioni
	{
		Globale.Siap == True;
		Or(Is Dummy Bot(Event Player), Event Player.BotOtomatis) == True;
		Has Spawned(Event Player) == True;
		Is Alive(Event Player) == True;
		Or(Event Player.KunciBotAktif == False, Hero Of(Event Player) != Event Player.PahlawanTerakhir) == True;
	}

	azioni
	{
		Call Subroutine(KunciBot);
		If(Is Dummy Bot(Event Player) == True);
			Enable Movement Collision With Players(Event Player);
			Disable Movement Collision With Environment(Event Player, False);
			Event Player.WaktuTeleportasiDummy = Total Time Elapsed + 1;
			Set Respawn Max Time(Event Player, 3);
		End;
	}
}

regola("03d - Bot/Dummy: Buat satu bot acak untuk Tim 1")
{
	evento
	{
		Ongoing - Global;
	}

	condizioni
	{
		Globale.Siap == True;
		Is Game In Progress == True;
		Number Of Players(Team 1) < Number Of Slots(Team 1) - 1;
		Count Of(Spawn Points(Team 1)) > 0;
		Count Of(Filtered Array(All Players(Team 1), Is Dummy Bot(Current Array Element) == True)) == 0;
	}

	azioni
	{
		Globale.TimDummyAktif = Team 1;
		Call Subroutine(BuatDummyTim);
	}
}

