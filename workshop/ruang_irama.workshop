variables
{
	global:
		0: DaftarGenre
		1: NamaHalaman
		2: PemainManusia
		3: NomorUrut
		4: Siap
		5: HudInfoKiri
		6: HudInfoKanan
		7: DaftarWarna
		8: JarakKamera
		9: GeserKamera
		10: BantalanDinding
		11: JarakBidik
		12: HudKiriPemain
		13: HudKananPemain
		14: HudMenuPemain
		15: TeksDuniaPemain
		16: IndeksKeluar
		17: KodeMenu
		18: NamaWarna
		19: NamaWarnaEN
		20: NamaBahasa
		21: NamaHalamanEN
		22: TeksDiriPemain

	player:
		0: WaktuMasuk
		1: WaktuTercatat
		2: SudahDiperiksa
		3: BotAI
		4: Manusia
		5: MenitLobby
		6: IndeksGenre
		7: UrutanHUD
		8: HudKiri
		9: HudKanan
		10: MenuTerbuka
		11: KursorGenre
		12: HudMenu
		13: InspeksiAktif
		14: TargetInspeksi
		15: TeksDunia
		16: ModeKamera
		17: TargetKamera
		18: MeleeDipakai
		19: HalamanMenu
		20: KursorUtama
		21: KursorKamera
		22: KursorWarna
		23: IndeksWarna
		24: WarnaNama
		25: CalonTargetKamera
		26: IndeksBahasa
		27: KursorBahasa
		28: DaftarTargetKamera
		29: SudahSiap
		30: TeksDiri
}

subroutines
{
	0: TutupMenu
	1: MulaiKamera
	2: GambarMenu
	3: KunciBot
	4: SiapkanPemain
	5: SegarkanTargetKamera
	6: GambarUtama
	7: GambarMusik
	8: GambarKamera
	9: GambarWarna
	10: GambarBahasa
	11: SegarkanTargetInspeksi
}

