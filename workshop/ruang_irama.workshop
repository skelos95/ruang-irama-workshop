			Custom String("Sri Lanka"),
			Custom String("Tajikistan"),
			Custom String("Taiwan"),
			Custom String("Thailand"),
			Custom String("Uzbekistan"),
			Custom String("Vietnam")
		), 1);
		Global.DiagnostikPerforma = Workshop Setting Toggle(Custom String("CHILL DEDICATED SERVER"), Custom String("Performance diagnostics"), False, 2);
		Global.WaktuMulaiServer = Total Time Elapsed;
		Global.WaktuAkhirServer = Global.WaktuMulaiServer + Global.DurasiServerMenit * 60;
		Global.SisaWaktuServer = Max(0, Round To Integer(Global.WaktuAkhirServer - Total Time Elapsed, Up));
		Global.TeksWaktuServer = Global.SisaWaktuServer % 60 < 10 ? Custom String("{0}:0{1}", Round To Integer(Global.SisaWaktuServer / 60, Down),
			Global.SisaWaktuServer % 60) : Custom String("{0}:{1}", Round To Integer(Global.SisaWaktuServer / 60, Down), Global.SisaWaktuServer % 60);
		Global.MulaiUlangSudahDiminta = False;
		Global.RGBFase = 0;
		Global.RGB = Custom Color(255, 80, 80, 255);
		"Tidak ada mode yang boleh mengakhiri pertandingan atau memberi skor; keenam mode inti 6v6 tetap berjalan sampai timer server habis."
		Disable Built-In Game Mode Completion;
		Disable Built-In Game Mode Scoring;
		"Mode dibuat tenang dan bersih tanpa penyiar serta musik bawaan mode."
		Disable Built-In Game Mode Announcer;
		Disable Built-In Game Mode Music;
		If(Global.DiagnostikPerforma == False);
			Disable Inspector Recording;
		End;

		Create HUD Text(Global.PemainManusia, Null,
			Player Variable(Local Player, IndeksBahasa) == 0 ? Custom String("SERVER LOCATION: {0}", Global.DaftarLokasiServer[Global.IndeksLokasiServer]) : Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String("LOKASI SERVER: {0}", Global.DaftarLokasiServer[Global.IndeksLokasiServer]) : Custom String("ตำแหน่งเซิร์ฟเวอร์: {0}", Global.DaftarLokasiServer[Global.IndeksLokasiServer]),
			Custom String("{0}    {1}", Custom String("CHILL DEDICATED SERVER"), Global.TeksWaktuServer),
			Top, -100, Color(White), Custom Color(80, 235, 255, 255), Global.RGB, Visible To String and Color, Visible Never);
		Create HUD Text(Global.PemainManusia, Null, Player Variable(Local Player, IndeksBahasa) == 0 ? Custom String(
			"Hold {0}: inspect hero + HP", Input Binding String(Button(Crouch))) : Player Variable(Local Player,
			IndeksBahasa) == 1 ? Custom String("Tahan {0}: cek pahlawan + HP", Input Binding String(Button(Crouch))) : Custom String(
			"กด {0} ค้าง: ดูฮีโร่ + HP", Input Binding String(Button(Crouch))), Player Variable(Local Player,
			IndeksBahasa) == 0 ? Custom String("LOBBY & CHILL TIME\n ") : Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String(
			"LOBI & WAKTU SANTAI\n ") : Custom String("ล็อบบี้ & เวลาชิล\n "), Left, -100,
			Color(White), Custom Color(185, 225, 255, 255), Custom Color(70, 225, 255, 255),
			Visible To and String, Visible Never);
		Create HUD Text(Global.PemainManusia, Null, Player Variable(Local Player, IndeksBahasa) == 0 ? Custom String(
			"Hold {0} 0.5 sec: Arcade Menu", Input Binding String(Button(Melee))) : Player Variable(Local Player,
			IndeksBahasa) == 1 ? Custom String("Tahan {0} 0,5 dtk: Menu Arcade", Input Binding String(Button(Melee))) : Custom String(
			"กด {0} ค้าง 0.5 วิ: เมนูอาร์เคด", Input Binding String(Button(Melee))), Player Variable(Local Player,
			IndeksBahasa) == 0 ? Custom String("PLAYER VIBES\n ") : Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String(
			"MUSIK PEMAIN\n ") : Custom String("เพลงของผู้เล่น\n "),
			Right, -100, Color(White), Custom Color(235, 195, 255, 255), Custom Color(210, 110, 255, 255),
			Visible To and String, Visible Never);
		Global.Siap = True;
	}
}

rule("00a - Umum: Blokir penyelesaian saat permainan dimulai")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.Siap == True;
		Is Game In Progress == True;
	}

	actions
	{
		"Terapkan sekali lagi saat permainan benar-benar dimulai."
		Disable Built-In Game Mode Completion;
		Disable Built-In Game Mode Scoring;
	}
}

rule("00r - Umum: RGB pastel neon lambat untuk judul, waktu, dan efek")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.Siap == True;
	}

	actions
	{
		Global.RGB = Custom Color(
			80 + (Global.RGBFase < 255 ? 255 : Global.RGBFase < 510 ? 510 - Global.RGBFase : Global.RGBFase < 1020 ? 0 : Global.RGBFase < 1275 ? Global.RGBFase - 1020 : 255) * 0.686,
			80 + (Global.RGBFase < 255 ? Global.RGBFase : Global.RGBFase < 765 ? 255 : Global.RGBFase < 1020 ? 1020 - Global.RGBFase : 0) * 0.686,
			80 + (Global.RGBFase < 510 ? 0 : Global.RGBFase < 765 ? Global.RGBFase - 510 : Global.RGBFase < 1275 ? 255 : 1530 - Global.RGBFase) * 0.686,
			255);
		Wait(0.125, Ignore Condition);
		Global.RGBFase = (Global.RGBFase + 3.750) % 1530;
		Loop If Condition Is True;
	}
}

rule("00a1 - Umum: Mulai mode segera saat menunggu pemain")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.Siap == True;
		Is Waiting For Players == True;
	}

	actions
	{
		Start Game Mode;
	}
}

rule("00a2 - Umum: Lewati pemilihan pahlawan")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.Siap == True;
		Is Assembling Heroes == True;
	}

	actions
	{
		Set Match Time(0);
	}
}

rule("00a3 - Umum: Lewati persiapan awal")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.Siap == True;
		Is In Setup == True;
	}

	actions
	{
		Set Match Time(0);
	}
}

rule("00b - Umum: Perbarui hitung mundur server")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.Siap == True;
		Global.MulaiUlangSudahDiminta == False;
	}

	actions
	{
		Global.SisaWaktuServer = Max(0, Round To Integer(Global.WaktuAkhirServer - Total Time Elapsed, Up));
		Global.TeksWaktuServer = Global.SisaWaktuServer % 60 < 10 ? Custom String("{0}:0{1}", Round To Integer(Global.SisaWaktuServer / 60, Down),
			Global.SisaWaktuServer % 60) : Custom String("{0}:{1}", Round To Integer(Global.SisaWaktuServer / 60, Down), Global.SisaWaktuServer % 60);
		Wait(1, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("00c - Umum: Mulai ulang tepat sekali saat hitung mundur habis")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.Siap == True;
		Global.MulaiUlangSudahDiminta == False;
		Global.SisaWaktuServer <= 0;
	}

	actions
	{
		"Kunci mencegah beberapa aksi mulai ulang pada tick yang sama; tidak ada pemenang atau skor yang diumumkan."
		Global.MulaiUlangSudahDiminta = True;
		Restart Match;
	}
}

rule("01 - Pemain Masuk atau Pindah Tim: Bersihkan lalu siapkan ulang")
{
	event
	{
		Player Joined Match;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
	}

	actions
	{
		If(Array Contains(Global.PemainManusia, Event Player));
			Call Subroutine(BersihkanPemain);
		End;
		Call Subroutine(SiapkanPemain);
	}
}

rule("01b - Pemain Lama: Siapkan juga yang sudah telanjur ada")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.Siap == True;
		Is Dummy Bot(Event Player) == False;
		Event Player.SudahSiap == False;
	}

	actions
	{
		Call Subroutine(SiapkanPemain);
	}
}

rule("02 - Pemain: Pisahkan manusia dari pasukan kaleng")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.Siap == True;
		Event Player.SudahSiap == True;
		Has Spawned(Event Player) == True;
		Event Player.SudahDiperiksa == False;
	}

	actions
	{
		Event Player.SudahDiperiksa = True;
		Event Player.BotOtomatis = False;
		Event Player.Manusia = False;
		Event Player.WarnaNama = Color(White);
		Start Forcing Dummy Bot Name(Event Player, Custom String("​"));
		Wait(0.016, Ignore Condition);
		Abort If(Entity Exists(Event Player) == False);
		If(Custom String("{0}", Event Player) == Custom String("​"));
			Event Player.BotOtomatis = True;
		Else;
			Event Player.BotOtomatis = False;
		End;
		Wait(0.016, Ignore Condition);
		Abort If(Entity Exists(Event Player) == False);
		Stop Forcing Dummy Bot Name(Event Player);
		If(Event Player.BotOtomatis == True);
			Cancel Primary Action(Event Player);
			Call Subroutine(KunciBot);
			Abort;
		End;

		Abort If(Entity Exists(Event Player) == False);
		Abort If(Array Contains(Global.PemainManusia, Event Player));
		Abort If(Count Of(Global.SlotHUDTersedia) == 0);
		Event Player.Manusia = True;
		"Sembunyikan bilah, objektif, dan ikon mode tanpa mengganggu HUD pahlawan serta HUD buatan kita."
		Disable Game Mode HUD(Event Player);
		Disable Game Mode In-World UI(Event Player);
		Event Player.IndeksGenre = -1;
		Event Player.IndeksWarna = 0;
		Event Player.WarnaNama = Global.DaftarWarna[Event Player.IndeksWarna];
		Event Player.MenitLobi = 0;
		Event Player.UrutanHUD = First Of(Global.SlotHUDTersedia);
		Global.SlotHUDTerakhir = Max(Global.SlotHUDTerakhir, Event Player.UrutanHUD);
		Modify Global Variable(SlotHUDTersedia, Remove From Array By Index, 0);
		Global.PemainManusia = Append To Array(Global.PemainManusia, Event Player);
		Disable Nameplates(Event Player, Filtered Array(Global.PemainManusia, Player Variable(Current Array Element, InspeksiAktif) == True));

		Create HUD Text(Global.PemainManusia, Null, Custom String("{0}{1}", Custom String("{0} {1} {2}",
			Global.DaftarIkon[Event Player.IndeksIkon], Hero Icon String(Is Duplicating(Event Player) ? Hero Being Duplicated(Event Player) : Hero Of(Event Player)),
			Player Variable(Local Player, IndeksBahasa) == 0 ? Custom String("{0} - {1} MIN", Event Player, Event Player.MenitLobi) : Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String("{0} - {1} MENIT", Event Player, Event Player.MenitLobi) : Custom String("{0} - {1} นาที", Event Player, Event Player.MenitLobi)), Event Player.UrutanHUD == Global.SlotHUDTerakhir ? Global.PemimpinSuara != Null
			? Player Variable(Local Player, IndeksBahasa) == 2 ? Custom String("\n \nดาวสายชิล: {0}", Global.PemimpinSuara)
			: Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String("\n \nBINTANG CHILL: {0}", Global.PemimpinSuara)
			: Custom String("\n \nCHILL STAR: {0}", Global.PemimpinSuara) : Custom String("\n ") : Custom String("")),
			And(Global.DiagnostikPerforma == True, And(Local Player == Host Player, Event Player.UrutanHUD == Global.SlotHUDTerakhir)) ? Player Variable(Local Player, IndeksBahasa) == 2 ? Custom String("{0}\n{1}",
			Custom String("\n \nโหลด {0}% | เฉลี่ย {1}% | สูงสุด {2}%", Server Load, Server Load Average, Server Load Peak), Custom String("HUD {0} | IWT {1}",
			3 + Count Of(Global.HudKiriPemain) * 2 + Count Of(Filtered Array(Global.HudMenuPemain, Current Array Element != 0)), Count Of(Filtered Array(
			Global.TeksDuniaPemain, Current Array Element != 0)) + Count Of(Filtered Array(Global.TeksDiriPemain, Current Array Element != 0)))) : Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String("{0}\n{1}",
			Custom String("\n \nBEBAN {0}% | RATA {1}% | PUNCAK {2}%", Server Load, Server Load Average, Server Load Peak), Custom String("HUD {0} | IWT {1}",
			3 + Count Of(Global.HudKiriPemain) * 2 + Count Of(Filtered Array(Global.HudMenuPemain, Current Array Element != 0)), Count Of(Filtered Array(
			Global.TeksDuniaPemain, Current Array Element != 0)) + Count Of(Filtered Array(Global.TeksDiriPemain, Current Array Element != 0)))) : Custom String("{0}\n{1}",
			Custom String("\n \nLOAD {0}% | AVG {1}% | MAX {2}%", Server Load, Server Load Average, Server Load Peak), Custom String("HUD {0} | IWT {1}",
			3 + Count Of(Global.HudKiriPemain) * 2 + Count Of(Filtered Array(Global.HudMenuPemain, Current Array Element != 0)), Count Of(Filtered Array(
			Global.TeksDuniaPemain, Current Array Element != 0)) + Count Of(Filtered Array(Global.TeksDiriPemain, Current Array Element != 0)))) : Custom String(" "), Left, -99 + Event Player.UrutanHUD, Color(White), Event Player.WarnaNama, Color(White),
			Visible To String and Color, Visible Never);
		Event Player.HudKiri = Last Text ID;
		Global.HudKiriPemain = Append To Array(Global.HudKiriPemain, Event Player.HudKiri);
		Create HUD Text(Global.PemainManusia, Null, Custom String("{0}{1}", Custom String("{0} {1} {2}", Global.DaftarIkon[Event Player.IndeksIkon],
			Hero Icon String(Is Duplicating(Event Player) ? Hero Being Duplicated(Event Player) : Hero Of(Event Player)), Custom String("{0} - {1}", Event Player,
			Event Player.IndeksGenre >= 0 ? Global.DaftarGenre[Event Player.IndeksGenre] : Player Variable(Local Player, IndeksBahasa) == 0 ? Custom String("no soundtrack yet")
			: Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String("belum pilih musik") : Custom String("ยังไม่ได้เลือกเพลง"))), Event Player.UrutanHUD == Global.SlotHUDTerakhir ? Custom String("\n ") : Custom String("")), Null, Right, -99 + Event Player.UrutanHUD,
			Color(White), Event Player.WarnaNama, Color(White), Visible To String and Color, Visible Never);
		Event Player.HudKanan = Last Text ID;
		Global.HudKananPemain = Append To Array(Global.HudKananPemain, Event Player.HudKanan);
		Global.HudMenuPemain = Append To Array(Global.HudMenuPemain, 0);
		Global.TeksDuniaPemain = Append To Array(Global.TeksDuniaPemain, 0);
		Global.TeksDiriPemain = Append To Array(Global.TeksDiriPemain, 0);
		Global.SlotHUDPemain = Append To Array(Global.SlotHUDPemain, Event Player.UrutanHUD);
		Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
			"Welcome to CHILL. Pick a vibe, pick a color, stay weird.") : Event Player.IndeksBahasa == 1 ? Custom String(
			"Selamat datang di CHILL. Pilih vibe, pilih warna, tetap aneh.") : Custom String(
			"ยินดีต้อนรับสู่ CHILL เลือกเพลง เลือกสี แล้วกวนแบบพอดี ๆ"));
	}
}

rule("02c - Ruang Muncul: Perbarui posisi aman setiap kali masuk")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Has Spawned(Event Player) == True;
		Is In Spawn Room(Event Player) == True;
	}

	actions
	{
		Event Player.PosisiRuangMuncul = Position Of(Event Player);
		Event Player.PunyaPosisiMuncul = True;
		Wait(1, Abort When False);
		Loop If Condition Is True;
	}
}

rule("03 - Waktu: Hitung menit nongkrong tanpa bikin server ngos-ngosan")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
	}

	actions
	{
		Event Player.MenitLobi = Max(0, Round To Integer((Total Time Elapsed - Event Player.WaktuMasuk) / 60, Down));
		Wait(10, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("03b - Bot: Tandai kunci untuk dipasang ulang setelah mati atau hilang")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.Siap == True;
		Or(Is Dummy Bot(Event Player), Event Player.BotOtomatis) == True;
		Event Player.KunciBotAktif == True;
		Or(Has Spawned(Event Player) == False, Is Alive(Event Player) == False) == True;
	}

	actions
	{
		Event Player.KunciBotAktif = False;
	}
}

rule("03c - Bot: Kunci saat hidup kembali atau pahlawan berganti")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.Siap == True;
		Or(Is Dummy Bot(Event Player), Event Player.BotOtomatis) == True;
		Has Spawned(Event Player) == True;
		Is Alive(Event Player) == True;
		Or(Event Player.KunciBotAktif == False, Hero Of(Event Player) != Event Player.PahlawanBotTerakhir) == True;
	}

	actions
	{
		Call Subroutine(KunciBot);
	}
}

rule("04 - Pemain Keluar: Bersihkan pendaftaran dan semua referensi")
{
	event
	{
		Player Left Match;
		All;
		All;
	}

	actions
	{
		Call Subroutine(BersihkanPemain);
	}
}

rule("05 - Menu: Tahan serangan jarak dekat 0,5 detik untuk buka atau tutup")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Is Alive(Event Player) == True;
		Event Player.SeranganDekatDipakai == False;
		Event Player.TeleportasiJongkokAktif == False;
		Event Player.KartuNasibAktif == False;
		Is Button Held(Event Player, Button(Melee)) == True;
	}

	actions
	{
		Wait(0.500, Abort When False);
		Event Player.SeranganDekatDipakai = True;
		If(Event Player.MenuTerbuka == True);
			Call Subroutine(TutupMenu);
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
				"Arcade Menu closed. Back to professionally doing nothing.") : Event Player.IndeksBahasa == 1 ? Custom String(
				"Menu Arcade ditutup. Kembali CHILL dengan penuh tanggung jawab.") : Custom String(
				"ปิดเมนูอาร์เคดแล้ว กลับไป CHILL อย่างมืออาชีพได้"));
		Else;
			Event Player.MenuTerbuka = True;
			Event Player.HalamanMenu = -1;
			Disallow Button(Event Player, Button(Melee));
			Disallow Button(Event Player, Button(Jump));
			Disallow Button(Event Player, Button(Crouch));
			Disallow Button(Event Player, Button(Primary Fire));
			Disallow Button(Event Player, Button(Secondary Fire));
			Disallow Button(Event Player, Button(Interact));
			Disallow Button(Event Player, Button(Reload));
			Disallow Button(Event Player, Button(Ability 1));
			Disallow Button(Event Player, Button(Ability 2));
			Disallow Button(Event Player, Button(Ultimate));
			Call Subroutine(GambarMenu);
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
				"Arcade Menu online. Twelve extremely important decisions await.") : Event Player.IndeksBahasa == 1 ? Custom String(
				"Menu Arcade online. Dua belas keputusan yang sangat penting menunggu.") : Custom String(
				"เปิดเมนูอาร์เคดแล้ว มีสิบสองตัวเลือกสำคัญรอคุณอยู่"));
		End;
	}
}

rule("05b - Menu: Lepaskan serangan jarak dekat sebelum pakai lagi")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Event Player.SeranganDekatDipakai == True;
		Is Button Held(Event Player, Button(Melee)) == False;
	}

	actions
	{
		If(Event Player.MenuTerbuka == False);
			Allow Button(Event Player, Button(Melee));
		End;
		Event Player.SeranganDekatDipakai = False;
	}
}

rule("05c - Menu: Pengatur masukan dengan prioritas tetap")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.MenuTerbuka == True;
		Event Player.PerintahMenu == 0;
		Or(Or(Is Button Held(Event Player, Button(Interact)), And(Is Button Held(Event Player, Button(Reload)), Event Player.HalamanMenu
			!= -1)), Or(Or(Is Button Held(Event Player, Button(Primary Fire)), Is Button Held(Event Player, Button(Secondary Fire))), And(
			Event Player.HalamanMenu == 0, Or(Is Button Held(Event Player, Button(Jump)), Is Button Held(Event Player, Button(Crouch)))))) == True;
	}

	actions
	{
		If(Is Button Held(Event Player, Button(Interact)));
			Event Player.PerintahMenu = 1;
		Else If(And(Is Button Held(Event Player, Button(Reload)), Event Player.HalamanMenu != -1));
			Event Player.PerintahMenu = 2;
		Else If(Is Button Held(Event Player, Button(Primary Fire)));
			Event Player.PerintahMenu = 3;
		Else If(Is Button Held(Event Player, Button(Secondary Fire)));
			Event Player.PerintahMenu = 4;
		Else If(And(Is Button Held(Event Player, Button(Jump)), Event Player.HalamanMenu == 0));
			Event Player.PerintahMenu = 5;
		Else If(And(Is Button Held(Event Player, Button(Crouch)), Event Player.HalamanMenu == 0));
			Event Player.PerintahMenu = 6;
		End;
	}
}

rule("05d - Menu: Lepaskan pengatur setelah semua masukan dilepas")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.PerintahMenu != 0;
		And(And(Is Button Held(Event Player, Button(Interact)) == False, Is Button Held(Event Player, Button(Reload)) == False), And(And(
			Is Button Held(Event Player, Button(Primary Fire)) == False, Is Button Held(Event Player, Button(Secondary Fire)) == False), And(
			Is Button Held(Event Player, Button(Jump)) == False, Is Button Held(Event Player, Button(Crouch)) == False))) == True;
	}

	actions
	{
		"Tunda satu bingkai agar pengendali menyelesaikan perintah sebelum pengatur masukan diaktifkan kembali."
		Wait(0.016, Ignore Condition);
		Event Player.PerintahMenu = 0;
	}
}

rule("06 - Menu: Tembakan utama memilih berikutnya")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Event Player.MenuTerbuka == True;
		Event Player.PerintahMenu == 3;
	}

	actions
	{
		If(Event Player.HalamanMenu == -1);
			Event Player.KursorUtama = (Event Player.KursorUtama + 1) % 12;
		Else If(Event Player.HalamanMenu == 0);
			Event Player.KursorGenre = (Event Player.KursorGenre + 1) % 100;
		Else If(Event Player.HalamanMenu == 1);
			Call Subroutine(SegarkanTargetKamera);
			Event Player.KursorKamera = (Event Player.KursorKamera + 1) % (Count Of(Event Player.DaftarTargetKamera) + 2);
		Else If(Event Player.HalamanMenu == 2);
			Event Player.KursorWarna = (Event Player.KursorWarna + 1) % Count Of(Global.DaftarWarna);
		Else If(Event Player.HalamanMenu == 3);
			Event Player.KursorBahasa = (Event Player.KursorBahasa + 1) % 3;
		Else If(Event Player.HalamanMenu == 4);
			Call Subroutine(SegarkanTargetBalasDendam);
			If(Count Of(Event Player.DaftarTargetBalasDendam) > 0);
				Event Player.KursorBalasDendam = (Event Player.KursorBalasDendam + 1) % Count Of(Event Player.DaftarTargetBalasDendam);
			End;
		Else If(Event Player.HalamanMenu == 5);
			Event Player.KursorKebal = (Event Player.KursorKebal + 1) % 3;
		Else If(Event Player.HalamanMenu == 6);
			Event Player.KursorSuara = (Event Player.KursorSuara + 1) % 5;
		Else If(Event Player.HalamanMenu == 7);
			Event Player.KursorIkon = (Event Player.KursorIkon + 1) % Count Of(Global.DaftarIkon);
		Else If(Event Player.HalamanMenu == 8);
			Event Player.KursorTeleportasiJongkok = (Event Player.KursorTeleportasiJongkok + 1) % 2;
		Else If(Event Player.HalamanMenu == 9);
			Event Player.KursorPrivasiInspeksi = (Event Player.KursorPrivasiInspeksi + 1) % 2;
		Else If(Event Player.HalamanMenu == 11);
			If(Count Of(Global.PemainManusia) > 0);
				Event Player.KursorPilihan = (Event Player.KursorPilihan + 1) % Count Of(Global.PemainManusia);
			End;
		End;
		Call Subroutine(GambarMenu);
	}
}

rule("07 - Menu: Tembakan sekunder memilih sebelumnya")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Event Player.MenuTerbuka == True;
		Event Player.PerintahMenu == 4;
	}

	actions
	{
		If(Event Player.HalamanMenu == -1);
			Event Player.KursorUtama = (Event Player.KursorUtama + 11) % 12;
		Else If(Event Player.HalamanMenu == 0);
			Event Player.KursorGenre = (Event Player.KursorGenre + 99) % 100;
		Else If(Event Player.HalamanMenu == 1);
			Call Subroutine(SegarkanTargetKamera);
			Event Player.KursorKamera = (Event Player.KursorKamera + Count Of(Event Player.DaftarTargetKamera) + 1) % (Count Of(
				Event Player.DaftarTargetKamera) + 2);
		Else If(Event Player.HalamanMenu == 2);
			Event Player.KursorWarna = (Event Player.KursorWarna + Count Of(Global.DaftarWarna) - 1) % Count Of(Global.DaftarWarna);
		Else If(Event Player.HalamanMenu == 3);
			Event Player.KursorBahasa = (Event Player.KursorBahasa + 2) % 3;
		Else If(Event Player.HalamanMenu == 4);
			Call Subroutine(SegarkanTargetBalasDendam);
			If(Count Of(Event Player.DaftarTargetBalasDendam) > 0);
				Event Player.KursorBalasDendam = (Event Player.KursorBalasDendam + Count Of(Event Player.DaftarTargetBalasDendam) - 1) % Count Of(
					Event Player.DaftarTargetBalasDendam);
			End;
		Else If(Event Player.HalamanMenu == 5);
			Event Player.KursorKebal = (Event Player.KursorKebal + 2) % 3;
		Else If(Event Player.HalamanMenu == 6);
			Event Player.KursorSuara = (Event Player.KursorSuara + 4) % 5;
		Else If(Event Player.HalamanMenu == 7);
			Event Player.KursorIkon = (Event Player.KursorIkon + Count Of(Global.DaftarIkon) - 1) % Count Of(Global.DaftarIkon);
		Else If(Event Player.HalamanMenu == 8);
			Event Player.KursorTeleportasiJongkok = (Event Player.KursorTeleportasiJongkok + 1) % 2;
		Else If(Event Player.HalamanMenu == 9);
			Event Player.KursorPrivasiInspeksi = (Event Player.KursorPrivasiInspeksi + 1) % 2;
		Else If(Event Player.HalamanMenu == 11);
			If(Count Of(Global.PemainManusia) > 0);
				Event Player.KursorPilihan = (Event Player.KursorPilihan + Count Of(Global.PemainManusia) - 1) % Count Of(Global.PemainManusia);
			End;
		End;
		Call Subroutine(GambarMenu);
	}
}

rule("07b - Menu kamera: Segarkan pemain dan bot yang bisa ditonton")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Event Player.MenuTerbuka == True;
		Event Player.HalamanMenu == 1;
	}

	actions
	{
		Call Subroutine(SegarkanTargetKamera);
		Wait(1, Abort When False);
		Loop If Condition Is True;
	}
}

rule("07c - Menu Balas Dendam: Segarkan data tanpa menggambar ulang")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Event Player.MenuTerbuka == True;
		Event Player.HalamanMenu == 4;
	}

	actions
	{
		Call Subroutine(SegarkanTargetBalasDendam);
		Wait(1, Abort When False);
		Loop If Condition Is True;
	}
}

rule("08 - Menu 0: Lompat mundur sepuluh genre")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Event Player.MenuTerbuka == True;
		Event Player.HalamanMenu == 0;
		Event Player.PerintahMenu == 5;
	}

	actions
	{
		Event Player.KursorGenre = (Event Player.KursorGenre + 90) % 100;
		Call Subroutine(GambarMenu);
	}
}

rule("09 - Menu 0: Jongkok maju sepuluh genre")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Event Player.MenuTerbuka == True;
		Event Player.HalamanMenu == 0;
		Event Player.PerintahMenu == 6;
	}

	actions
	{
		Event Player.KursorGenre = (Event Player.KursorGenre + 10) % 100;
		Call Subroutine(GambarMenu);
	}
}

rule("10 - Menu: Interaksi membuka atau menerapkan pilihan")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Event Player.MenuTerbuka == True;
		Event Player.PerintahMenu == 1;
	}

	actions
	{
		If(Event Player.HalamanMenu == -1);
			Event Player.HalamanMenu = Global.KodeMenu[Event Player.KursorUtama];
			If(Event Player.HalamanMenu == 0);
				Event Player.KursorGenre = Event Player.KursorGenre;
			Else If(Event Player.HalamanMenu == 1);
				Call Subroutine(SegarkanTargetKamera);
			Else If(Event Player.HalamanMenu == 2);
				Event Player.KursorWarna = Event Player.KursorWarna;
			Else If(Event Player.HalamanMenu == 3);
				Event Player.KursorBahasa = Event Player.KursorBahasa;
			Else If(Event Player.HalamanMenu == 4);
				Event Player.KursorBalasDendam = Event Player.KursorBalasDendam;
				Call Subroutine(SegarkanTargetBalasDendam);
			Else If(Event Player.HalamanMenu == 5);
				Event Player.KursorKebal = Event Player.ModeKebal;
			Else If(Event Player.HalamanMenu == 6);
				Event Player.KursorSuara = Event Player.KursorSuara;
			Else If(Event Player.HalamanMenu == 7);
				Event Player.KursorIkon = Event Player.KursorIkon;
			Else If(Event Player.HalamanMenu == 8);
				Event Player.KursorTeleportasiJongkok = Event Player.KursorTeleportasiJongkok;
			Else If(Event Player.HalamanMenu == 9);
				Event Player.KursorPrivasiInspeksi = Event Player.KursorPrivasiInspeksi;
			Else If(Event Player.HalamanMenu == 11);
				Event Player.KursorPilihan = And(Event Player.PemainDipilih != Null, Array Contains(Global.PemainManusia, Event Player.PemainDipilih)) ? Index Of Array Value(Global.PemainManusia, Event Player.PemainDipilih) : Min(Event Player.KursorPilihan, Count Of(Global.PemainManusia) - 1);
			End;
			Call Subroutine(GambarMenu);
		Else If(Event Player.HalamanMenu == 0);
			If(Event Player.IndeksGenre != Event Player.KursorGenre);
				Event Player.IndeksGenre = Event Player.KursorGenre;
				Call Subroutine(EfekTerapkan);
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
					"Soundtrack: {0}. Great taste. Probably.", Global.DaftarGenre[Event Player.IndeksGenre]) : Event Player.IndeksBahasa == 1
					? Custom String("Musik: {0}. Selera bagus. Mungkin.", Global.DaftarGenre[Event Player.IndeksGenre]) : Custom String(
					"เลือกเพลง: {0} รสนิยมดี...น่าจะนะ", Global.DaftarGenre[Event Player.IndeksGenre]));
			End;
			Call Subroutine(GambarMenu);
		Else If(Event Player.HalamanMenu == 1);
			Call Subroutine(SegarkanTargetKamera);
			Event Player.KursorKamera %= Count Of(Event Player.DaftarTargetKamera) + 2;
			If(Event Player.KursorKamera == 0);
				If(Event Player.ModeKamera != 0);
					Stop Camera(Event Player);
					Event Player.ModeKamera = 0;
					Event Player.TargetKamera = Null;
					Call Subroutine(EfekPulihkan);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"First person restored. Nobody saw that.") : Event Player.IndeksBahasa == 1 ? Custom String(
						"Kamera normal lagi. Anggap tak terjadi.") : Custom String(
						"กลับมุมมองปกติแล้ว ไม่มีใครเห็นหรอก"));
				End;
			Else If(Event Player.KursorKamera == 1);
				If(Or(Event Player.ModeKamera != 1, Event Player.TargetKamera != Event Player));
					Event Player.TargetKamera = Event Player;
					"Biarkan satu bingkai Interact selesai sebelum mengganti tampilan kamera."
					Wait(0.016, Ignore Condition);
					Event Player.ModeKamera = 1;
					Call Subroutine(MulaiKamera);
					Call Subroutine(EfekTerapkan);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"Third person on. Ego responsibly.") : Event Player.IndeksBahasa == 1 ? Custom String(
						"Kamera 3P aktif. Jangan narsis berlebihan.") : Custom String(
						"เปิดกล้องบุคคลที่สามแล้ว อย่าหลงตัวเองเกินไป"));
				End;
			Else;
				If(Event Player.KursorKamera - 2 < Count Of(Event Player.DaftarTargetKamera));
					Event Player.CalonTargetKamera = Event Player.DaftarTargetKamera[Event Player.KursorKamera - 2];
				Else;
					Event Player.CalonTargetKamera = Null;
				End;
				If(And(Event Player.CalonTargetKamera != Null, Entity Exists(Event Player.CalonTargetKamera)));
					If(Or(Event Player.ModeKamera != 2, Event Player.TargetKamera != Event Player.CalonTargetKamera));
						Event Player.TargetKamera = Event Player.CalonTargetKamera;
						"Gunakan jeda satu bingkai yang sama saat mulai menonton dari orang pertama."
						Wait(0.016, Ignore Condition);
						Event Player.ModeKamera = 2;
						Call Subroutine(MulaiKamera);
						Call Subroutine(EfekTerapkan);
						Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
							"Watching {0}. Definitely not stalking.", Event Player.TargetKamera) : Event Player.IndeksBahasa == 1 ? Custom String(
							"Menonton {0}. Bukan stalking. Serius.", Event Player.TargetKamera) : Custom String(
							"กำลังดู {0} อยู่ ไม่ได้สะกดรอยนะ จริง ๆ", Event Player.TargetKamera));
					End;
				Else;
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"That player disappeared. Very on-brand for CHILL.") : Event Player.IndeksBahasa == 1 ? Custom String(
						"Pemainnya menghilang. Sangat sesuai tema CHILL.") : Custom String(
						"ผู้เล่นคนนั้นหายไปแล้ว สมกับเป็นห้อง CHILL จริง ๆ"));
				End;
			End;
			Call Subroutine(GambarMenu);
		Else If(Event Player.HalamanMenu == 2);
			If(Event Player.IndeksWarna != Event Player.KursorWarna);
				Event Player.IndeksWarna = Event Player.KursorWarna;
				Event Player.WarnaNama = Global.DaftarWarna[Event Player.IndeksWarna];
				If(Event Player.IndeksWarna == 0);
					Call Subroutine(EfekPulihkan);
				Else;
					Call Subroutine(EfekTerapkan);
				End;
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
					"Name color: {0}. Subtlety optional.", Global.NamaWarnaInggris[Event Player.IndeksWarna]) : Event Player.IndeksBahasa == 1 ? Custom String(
					"Warna nama: {0}. Boleh norak.", Global.NamaWarna[Event Player.IndeksWarna]) : Custom String(
					"สีชื่อ: {0} เด่นได้ตามใจ", Global.NamaWarnaThai[Event Player.IndeksWarna]));
			End;
			Call Subroutine(GambarMenu);
		Else If(Event Player.HalamanMenu == 3);
			If(Event Player.IndeksBahasa != Event Player.KursorBahasa);
				Event Player.IndeksBahasa = Event Player.KursorBahasa;
				Call Subroutine(EfekTerapkan);
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
					"HUD language: English.") : Event Player.IndeksBahasa == 1 ? Custom String(
					"Bahasa HUD: Bahasa Indonesia.") : Custom String("ภาษา HUD: ไทย"));
			End;
			Call Subroutine(GambarMenu);
		Else If(Event Player.HalamanMenu == 4);
			Call Subroutine(SegarkanTargetBalasDendam);
			If(Count Of(Event Player.DaftarTargetBalasDendam) == 0);
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
					"No revenge targets. Peace has won, temporarily.") : Event Player.IndeksBahasa == 1 ? Custom String(
					"Tidak ada target balas dendam. Damai menang... sementara.") : Custom String(
					"ไม่มีเป้าหมายล้างแค้น ความสงบชนะแล้ว...ชั่วคราว"));
			Else;
				Event Player.KursorBalasDendam %= Count Of(Event Player.DaftarTargetBalasDendam);
				Event Player.TargetBalasDendamTerkunci = Event Player.DaftarTargetBalasDendam[Event Player.KursorBalasDendam];
				Event Player.IndeksBalasDendam = Index Of Array Value(Event Player.PembunuhBalasDendam,
					Event Player.TargetBalasDendamTerkunci);
				If(Event Player.IndeksBalasDendam < 0);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"That player owes you nothing. Suspiciously peaceful.") : Event Player.IndeksBahasa == 1 ? Custom String(
						"Pemain itu tidak punya utang. Damainya mencurigakan sekali.") : Custom String(
						"ผู้เล่นคนนั้นไม่ได้ติดหนี้คุณ สงบเกินจนน่าสงสัย"));
				Else If(Event Player.JumlahBalasDendam[Event Player.IndeksBalasDendam] <= 0);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"Revenge debt cleared. Case closed.") : Event Player.IndeksBahasa == 1 ? Custom String(
						"Utang balas dendam lunas. Kasus ditutup.") : Custom String(
						"ชำระหนี้ล้างแค้นหมดแล้ว ปิดคดี"));
				Else If(Or(Entity Exists(Event Player.TargetBalasDendamTerkunci) == False,
					Is Alive(Event Player.TargetBalasDendamTerkunci) == False));
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"Target is already down. Revenge has office hours.") : Event Player.IndeksBahasa == 1 ? Custom String(
						"Target sudah tumbang. Balas dendam juga punya jam kerja.") : Custom String(
						"เป้าหมายล้มอยู่แล้ว การล้างแค้นก็มีเวลาทำการนะ"));
				Else;
					Set Player Variable(Event Player.TargetBalasDendamTerkunci, KematianBalasDendam, True);
					Kill(Event Player.TargetBalasDendamTerkunci, Event Player);
					Modify Player Variable At Index(Event Player, JumlahBalasDendam, Event Player.IndeksBalasDendam, Subtract, 1);
					Call Subroutine(EfekTerapkan);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Revenge claimed on {0}. Remaining: {1}.",
						Event Player.TargetBalasDendamTerkunci, Event Player.JumlahBalasDendam[Event Player.IndeksBalasDendam]) : Event Player.IndeksBahasa == 1 ? Custom String(
						"Balas dendam dibayar pada {0}. Sisa: {1}.", Event Player.TargetBalasDendamTerkunci,
						Event Player.JumlahBalasDendam[Event Player.IndeksBalasDendam]) : Custom String("ล้างแค้น {0} สำเร็จ เหลือ: {1}",
						Event Player.TargetBalasDendamTerkunci, Event Player.JumlahBalasDendam[Event Player.IndeksBalasDendam]));
					Event Player.TargetBalasDendamTerkunci = Null;
					Call Subroutine(GambarMenu);
				End;
			End;
		Else If(Event Player.HalamanMenu == 5);
			If(Event Player.ModeKebal != Event Player.KursorKebal);
				If(And(Event Player.KursorKebal == 1, Is In Spawn Room(Event Player) == True));
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Unkillable: 1 HP is unavailable in Spawn Room. FULL HP is still available.") : Event Player.IndeksBahasa == 1 ? Custom String("Kebal: 1 HP tidak tersedia di ruang muncul. FULL HP tetap tersedia.") : Custom String("ใช้โหมดฆ่าไม่ตาย: 1 HP ในห้องเกิดไม่ได้ แต่ FULL HP ยังใช้ได้"));
				Else;
					Event Player.ModeKebal = Event Player.KursorKebal;
					Event Player.KebalAktif = Event Player.ModeKebal != 0;
					If(Event Player.ModeKebal == 0);
						Call Subroutine(EfekPulihkan);
						Clear Status(Event Player, Unkillable);
						Set Damage Received(Event Player, 100);
						If(Is Alive(Event Player) == True);
							Set Player Health(Event Player, Max Health(Event Player));
						End;
						If(Event Player.IkonKebal != Null);
							Destroy Icon(Event Player.IkonKebal);
							Event Player.IkonKebal = Null;
						End;
						Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Unkillable disabled.") : Event Player.IndeksBahasa == 1 ? Custom String("Mode Kebal nonaktif.") : Custom String("ปิดโหมดฆ่าไม่ตายแล้ว"));
					Else;
						Call Subroutine(EfekTerapkan);
						Clear Status(Event Player, Unkillable);
						Set Status(Event Player, Null, Unkillable, 9999);
						If(Event Player.ModeKebal == 1);
							Set Damage Received(Event Player, 100);
							If(Is Alive(Event Player) == True);
								Set Player Health(Event Player, 1);
							End;
							Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Unkillable: 1 HP enabled.") : Event Player.IndeksBahasa == 1 ? Custom String("Kebal: 1 HP aktif.") : Custom String("เปิดโหมดฆ่าไม่ตาย: 1 HP แล้ว"));
						Else;
							Set Damage Received(Event Player, 0);
							If(Is Alive(Event Player) == True);
								Set Player Health(Event Player, Max Health(Event Player));
							End;
							Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Unkillable: FULL HP enabled.") : Event Player.IndeksBahasa == 1 ? Custom String("Kebal: FULL HP aktif.") : Custom String("เปิดโหมดฆ่าไม่ตาย: FULL HP แล้ว"));
						End;
						If(Event Player.IkonKebal != Null);
							Destroy Icon(Event Player.IkonKebal);
							Event Player.IkonKebal = Null;
						End;
						If(Event Player.ModeKebal == 1);
							Create Icon(All Players(All Teams), Event Player, Warning, Visible To and Position, Custom Color(255, 80, 80, 255), True);
						Else;
							Create Icon(All Players(All Teams), Event Player, Halo, Visible To and Position, Global.RGB, True);
						End;
						Event Player.IkonKebal = Last Created Entity;
					End;
				End;
			End;
			Call Subroutine(GambarMenu);
		Else If(Event Player.HalamanMenu == 6);
			If(Event Player.IndeksSuara != Event Player.KursorSuara);
				Event Player.IndeksSuara = Event Player.KursorSuara;
				If(Event Player.IndeksSuara == 0);
					Call Subroutine(EfekPulihkan);
				Else;
					Call Subroutine(EfekTerapkan);
				End;
				If(Event Player.IndeksSuara == 0);
					Stop Modifying Hero Voice Lines(Event Player);
				Else If(Event Player.IndeksSuara == 1);
					Start Modifying Hero Voice Lines(Event Player, 0.500, False);
				Else If(Event Player.IndeksSuara == 2);
					Start Modifying Hero Voice Lines(Event Player, 0.750, False);
				Else If(Event Player.IndeksSuara == 3);
					Start Modifying Hero Voice Lines(Event Player, 1.250, False);
				Else;
					Start Modifying Hero Voice Lines(Event Player, 1.500, False);
				End;
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Hero voice updated. Science!") : Event Player.IndeksBahasa == 1 ? Custom String(
					"Suara pahlawan diubah. Demi sains!") : Custom String("ปรับเสียงฮีโร่แล้ว วิทยาศาสตร์!"));
			End;
			Call Subroutine(GambarMenu);
		Else If(Event Player.HalamanMenu == 7);
			If(Event Player.IndeksIkon != Event Player.KursorIkon);
				Event Player.IndeksIkon = Event Player.KursorIkon;
				Call Subroutine(EfekTerapkan);
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Player icon: {0}.", Event Player.IndeksIkon == 0 ? Custom String("NOTHING") : Global.NamaIkon[Event Player.IndeksIkon])
					: Event Player.IndeksBahasa == 1 ? Custom String("Ikon pemain: {0}.", Event Player.IndeksIkon == 0 ? Custom String("TIDAK ADA") : Global.NamaIkon[Event Player.IndeksIkon])
					: Custom String("ไอคอนผู้เล่น: {0}", Event Player.IndeksIkon == 0 ? Custom String("ไม่มี") : Global.NamaIkon[Event Player.IndeksIkon]));
			End;
			Call Subroutine(GambarMenu);
		Else If(Event Player.HalamanMenu == 8);
			If(Event Player.TeleportasiJongkokDiaktifkan != (Event Player.KursorTeleportasiJongkok == 1));
				Event Player.TeleportasiJongkokDiaktifkan = Event Player.KursorTeleportasiJongkok == 1;
				If(Event Player.TeleportasiJongkokDiaktifkan == True);
					Call Subroutine(EfekTerapkan);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Crouch Teleport enabled.") : Event Player.IndeksBahasa == 1 ? Custom String("Teleport Jongkok aktif.") : Custom String("เปิดเทเลพอร์ตตอนย่อแล้ว"));
				Else;
					Call Subroutine(EfekPulihkan);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Crouch Teleport disabled.") : Event Player.IndeksBahasa == 1 ? Custom String("Teleport Jongkok nonaktif.") : Custom String("ปิดเทเลพอร์ตตอนย่อแล้ว"));
				End;
			End;
			Call Subroutine(GambarMenu);
		Else If(Event Player.HalamanMenu == 9);
			If(Event Player.PrivasiInspeksiAktif != (Event Player.KursorPrivasiInspeksi == 1));
				Event Player.PrivasiInspeksiAktif = Event Player.KursorPrivasiInspeksi == 1;
				If(Event Player.PrivasiInspeksiAktif == True);
					Call Subroutine(EfekTerapkan);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Crouch privacy enabled. Enemies see nothing.") : Event Player.IndeksBahasa == 1 ? Custom String("Privasi Jongkok aktif. Musuh tidak melihat apa pun.") : Custom String("เปิดความเป็นส่วนตัวตอนย่อ ศัตรูจะไม่เห็นอะไรเลย"));
				Else;
					Call Subroutine(EfekPulihkan);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Crouch privacy disabled. HUD visible to everyone.") : Event Player.IndeksBahasa == 1 ? Custom String("Privasi Jongkok nonaktif. HUD terlihat oleh semua.") : Custom String("ปิดความเป็นส่วนตัวตอนย่อ ทุกคนเห็น HUD ได้"));
				End;
			End;
			Call Subroutine(GambarMenu);
		Else If(Event Player.HalamanMenu == 10);
			If(Event Player.KartuNasibAktif == True);
				Call Subroutine(TutupMenu);
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("The luck card is already rolling. Wait for the result.") : Event Player.IndeksBahasa == 1 ? Custom String("Kartu nasib sedang berputar. Tunggu hasilnya.") : Custom String("การ์ดเสี่ยงโชคกำลังสุ่มอยู่ รอผลก่อน"));
			Else;
				Event Player.KebalAktif = False;
				Event Player.ModeKebal = 0;
				Event Player.KursorKebal = 0;
				Clear Status(Event Player, Unkillable);
				Set Damage Received(Event Player, 100);
				If(Event Player.IkonKebal != Null);
					Destroy Icon(Event Player.IkonKebal);
					Event Player.IkonKebal = Null;
				End;
				Event Player.KartuNasibAktif = True;
				Event Player.KartuNasibMerah = Random Integer(0, 1) == 0;
				Event Player.PutaranKartuNasib = Random Integer(20, 24);
				Event Player.JedaKartuNasib = 0.080;
				Create In-World Text(All Players(All Teams), Custom String("["), Update Every Frame(Eye Position(Event Player) + Facing Direction Of(Event Player) * 4 - Cross Product(Direction From Angles(Horizontal Facing Angle Of(Event Player), 0), Vector(0, 1, 0)) * 0.300), 2.200, Do Not Clip, Visible To Position String and Color, Event Player.KartuNasibMerah ? Custom Color(255, 70, 70, 255) : Custom Color(70, 255, 110, 255), Visible Never);
				Event Player.TeksKartuNasib = Last Text ID;
				Create In-World Text(All Players(All Teams), Custom String("]"), Update Every Frame(Eye Position(Event Player) + Facing Direction Of(Event Player) * 4 + Cross Product(Direction From Angles(Horizontal Facing Angle Of(Event Player), 0), Vector(0, 1, 0)) * 0.300), 2.200, Do Not Clip, Visible To Position String and Color, Event Player.KartuNasibMerah ? Custom Color(255, 70, 70, 255) : Custom Color(70, 255, 110, 255), Visible Never);
				Event Player.TeksKartuNasibKanan = Last Text ID;
				Create Icon(Event Player.KartuNasibMerah ? All Players(All Teams) : Empty Array, Update Every Frame(Eye Position(Event Player) + Facing Direction Of(Event Player) * 4 - Vector(0, 0.450, 0)), Skull, Visible To and Position, Custom Color(255, 70, 70, 255), False);
				Event Player.IkonKartuNasib = Last Created Entity;
				Create Icon(Event Player.KartuNasibMerah ? Empty Array : All Players(All Teams), Update Every Frame(Eye Position(Event Player) + Facing Direction Of(Event Player) * 4 - Vector(0, 0.450, 0)), Heart, Visible To and Position, Custom Color(70, 255, 110, 255), False);
				Event Player.IkonKartuNasibHijau = Last Created Entity;
				Call Subroutine(TutupMenu);
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Luck roulette started. Red or green?") : Event Player.IndeksBahasa == 1 ? Custom String("Roulette nasib dimulai. Merah atau hijau?") : Custom String("เริ่มรูเล็ตเสี่ยงโชคแล้ว แดงหรือเขียว?"));
			End;
		Else;
			If(Count Of(Global.PemainManusia) > 0);
				Event Player.KursorPilihan %= Count Of(Global.PemainManusia);
				If(Event Player.PemainDipilih != Global.PemainManusia[Event Player.KursorPilihan]);
					Event Player.PemainDipilih = Null;
					Event Player.PemainDipilih = Global.PemainManusia[Event Player.KursorPilihan];
					Call Subroutine(HitungPilihan);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Vote registered for {0}.", Event Player.PemainDipilih) : Event Player.IndeksBahasa == 1 ? Custom String("Pilihan untuk {0} tersimpan.", Event Player.PemainDipilih) : Custom String("โหวตให้ {0} แล้ว", Event Player.PemainDipilih));
				End;
			End;
			Call Subroutine(GambarMenu);
		End;
	}
}

rule("11 - Menu: Isi ulang kembali dari submenu ke menu utama")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Event Player.MenuTerbuka == True;
		Event Player.HalamanMenu != -1;
		Event Player.PerintahMenu == 2;
	}

	actions
	{
		Event Player.HalamanMenu = -1;
		Call Subroutine(GambarMenu);
	}
}

rule("12 - Menu: Kematian juga menutup warung")
{
	event
	{
		Player Died;
		All;
		All;
	}

	conditions
	{
		Event Player.MenuTerbuka == True;
	}

	actions
	{
		Call Subroutine(TutupMenu);
	}
}

rule("12b - Menu: Tutup juga saat pemain tidak aktif atau tidak muncul")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.MenuTerbuka == True;
		Or(Has Spawned(Event Player) == False, Is Alive(Event Player) == False) == True;
	}

	actions
	{
		Call Subroutine(TutupMenu);
	}
}

rule("12c - Kamera: Tahan Interact setengah detik untuk beralih di luar menu")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Has Spawned(Event Player) == True;
		Is Alive(Event Player) == True;
		Event Player.MenuTerbuka == False;
		Event Player.TeleportasiJongkokAktif == False;
		Event Player.InteraksiKameraDipakai == False;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	actions
	{
		Wait(0.500, Abort When False);
		Event Player.InteraksiKameraDipakai = True;
		If(Event Player.ModeKamera == 0);
			Event Player.TargetKamera = Event Player;
			Wait(0.016, Ignore Condition);
			Event Player.ModeKamera = 1;
			Call Subroutine(MulaiKamera);
			Call Subroutine(EfekTerapkan);
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Third person enabled.") : Event Player.IndeksBahasa == 1 ? Custom String("Kamera orang ketiga aktif.") : Custom String("เปิดมุมมองบุคคลที่สามแล้ว"));
		Else;
			Stop Camera(Event Player);
			Event Player.ModeKamera = 0;
			Event Player.TargetKamera = Null;
			Call Subroutine(EfekPulihkan);
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("First person restored.") : Event Player.IndeksBahasa == 1 ? Custom String("Kamera orang pertama kembali.") : Custom String("กลับสู่มุมมองบุคคลที่หนึ่งแล้ว"));
		End;
	}
}

rule("12d - Kamera: Lepaskan Interact sebelum pakai lagi")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.InteraksiKameraDipakai == True;
		Is Button Held(Event Player, Button(Interact)) == False;
	}

	actions
	{
		Event Player.InteraksiKameraDipakai = False;
	}
}

rule("12e - Bangkit Lompat: Simpan posisi kematian")
{
	event
	{
		Player Died;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
	}

	actions
	{
		Event Player.PosisiMati = Position Of(Event Player);
		Event Player.BangkitLompatDipakai = False;
		Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Press {0}: respawn near your death spot.", Input Binding String(Button(Jump))) : Event Player.IndeksBahasa == 1 ? Custom String("Tekan {0}: bangkit dekat lokasi mati.", Input Binding String(Button(Jump))) : Custom String("กด {0}: เกิดใหม่ใกล้จุดตาย", Input Binding String(Button(Jump))));
	}
}

rule("12f - Bangkit Lompat: Bangkit di posisi aman yang bisa dilalui")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Is Alive(Event Player) == False;
		Event Player.MenuTerbuka == False;
		Event Player.TeleportasiJongkokAktif == False;
		Event Player.BangkitLompatDipakai == False;
		Is Button Held(Event Player, Button(Jump)) == True;
	}

	actions
	{
		Event Player.BangkitLompatDipakai = True;
		Event Player.PosisiBangkitAman = Nearest Walkable Position(Event Player.PosisiMati + Vector(Random Real(-6, 6), 0, Random Real(-6, 6)));
		If(Distance Between(Event Player.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100);
			Event Player.PosisiBangkitAman = Nearest Walkable Position(Event Player.PosisiMati);
		End;
		Respawn(Event Player);
		Wait(0.016, Ignore Condition);
		Teleport(Event Player, Event Player.PosisiBangkitAman);
		Call Subroutine(EfekPulihkan);
		Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Respawned nearby. Try not to repeat that.") : Event Player.IndeksBahasa == 1 ? Custom String("Bangkit dekat titik mati. Coba jangan ulangi.") : Custom String("เกิดใหม่ใกล้จุดตายแล้ว อย่าซ้ำอีกล่ะ"));
	}
}

rule("13 - Intip Pahlawan: Tampilkan ikon, nama, dan kesehatan saat ini")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Is Alive(Event Player) == True;
		Event Player.MenuTerbuka == False;
		Event Player.ModeKamera != 2;
		Event Player.InspeksiAktif == False;
		Is Button Held(Event Player, Button(Crouch)) == True;
	}

	actions
	{
		Event Player.InspeksiAktif = True;
		Disable Nameplates(All Players(All Teams), Event Player);
		Event Player.PelatNamaDinonaktifkan = True;
		Call Subroutine(SegarkanTargetInspeksi);
		Create In-World Text(Event Player, Event Player.TargetInspeksi == Null ? Custom String("") : And(Player Variable(Event Player.TargetInspeksi, Manusia) == True, And(
			Player Variable(Event Player.TargetInspeksi, PrivasiInspeksiAktif) == True, Team Of(Event Player.TargetInspeksi) != Team Of(Event Player))) ? Custom String("")
			: Custom String("{0} {1} | {2}", Hero Icon String(Is Duplicating(Event Player.TargetInspeksi) ? Hero Being Duplicated(Event Player.TargetInspeksi) : Hero Of(
			Event Player.TargetInspeksi)), Custom String("{0}", Event Player.TargetInspeksi), Round To Integer(Health(Event Player.TargetInspeksi), Down)), Event Player.TargetInspeksi == Null ? Eye Position(Event Player) : Eye Position(
			Event Player.TargetInspeksi) + Vector(0, 0.450, 0), 1.100, Do Not Clip, Visible To Position String and Color, Event Player.TargetInspeksi == Null
			? Color(White) : Player Variable(Event Player.TargetInspeksi, Manusia) == True ? Player Variable(Event Player.TargetInspeksi, WarnaNama)
			: Color(Orange), Visible Never);
		Event Player.TeksDunia = Last Text ID;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.TeksDuniaPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = Event Player.TeksDunia;
		End;
		Event Player.TeksDiri = Null;
		If(Event Player.ModeKamera == 1);
			Create In-World Text(Event Player, Custom String("{0} {1} | {2}", Hero Icon String(Is Duplicating(Event Player) ? Hero Being Duplicated(
				Event Player) : Hero Of(Event Player)), Custom String("{0}", Event Player), Round To Integer(Health(Event Player), Down)),
				Update Every Frame(Eye Position(Event Player) + Vector(0, 0.450, 0)), 1.100, Do Not Clip, Visible To Position String and Color, Event Player.WarnaNama,
				Visible Never);
			Event Player.TeksDiri = Last Text ID;
			If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
				Global.TeksDiriPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = Event Player.TeksDiri;
			End;
		End;
	}
}

rule("14 - Intip Pahlawan: Perbarui target meski terhalang dinding")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.InspeksiAktif == True;
		Is Alive(Event Player) == True;
		Event Player.MenuTerbuka == False;
		Is Button Held(Event Player, Button(Crouch)) == True;
	}

	actions
	{
		Call Subroutine(SegarkanTargetInspeksi);
		Wait(0.250, Abort When False);
		Loop If Condition Is True;
	}
}

rule("15 - Intip Pahlawan: Hapus tulisan saat berdiri atau membuka menu")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.InspeksiAktif == True;
		Or(Or(Or(Or(Is Button Held(Event Player, Button(Crouch)) == False, Event Player.MenuTerbuka == True), Has Spawned(Event Player) == False),
			Is Alive(Event Player) == False),
			Event Player.ModeKamera == 2) == True;
	}

	actions
	{
		If(Event Player.PelatNamaDinonaktifkan == True);
			Enable Nameplates(All Players(All Teams), Event Player);
			Event Player.PelatNamaDinonaktifkan = False;
		End;
		If(Event Player.TeksDunia != Null);
			Destroy In-World Text(Event Player.TeksDunia);
		End;
		If(Event Player.TeksDiri != Null);
			Destroy In-World Text(Event Player.TeksDiri);
		End;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.TeksDuniaPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = 0;
			Global.TeksDiriPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = 0;
		End;
		Event Player.TeksDunia = Null;
		Event Player.TeksDiri = Null;
		Event Player.TargetInspeksi = Null;
		Event Player.DaftarTargetInspeksi = Empty Array;
		Event Player.InspeksiAktif = False;
	}
}

rule("16 - Kamera: Target pergi, pulangkan pandangan")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.ModeKamera == 2;
		Or(Event Player.TargetKamera == Null, Entity Exists(Event Player.TargetKamera) == False) == True;
	}

	actions
	{
		Stop Camera(Event Player);
		Event Player.ModeKamera = 0;
		Event Player.TargetKamera = Null;
		Call Subroutine(EfekPulihkan);
		Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
			"Camera target left. Back to normal.") : Event Player.IndeksBahasa == 1 ? Custom String(
			"Target kamera keluar. Kembali normal.") : Custom String(
			"เป้าหมายกล้องหายไป กลับมุมมองปกติแล้ว"));
	}
}

rule("17 - Balas Dendam: Catat hanya pembunuh langsung")
{
	event
	{
		Player Died;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
	}

	actions
	{
		If(Event Player.KematianBalasDendam == True);
			Event Player.KematianBalasDendam = False;
			Abort;
		End;
		Abort If(Attacker == Null);
		Abort If(Attacker == Event Player);
		Abort If(Player Variable(Attacker, Manusia) == False);
		Event Player.IndeksBalasDendam = Index Of Array Value(Event Player.PembunuhBalasDendam, Attacker);
		If(Event Player.IndeksBalasDendam < 0);
			Event Player.PembunuhBalasDendam = Append To Array(Event Player.PembunuhBalasDendam, Attacker);
			Event Player.JumlahBalasDendam = Append To Array(Event Player.JumlahBalasDendam, 1);
		Else;
			Modify Player Variable At Index(Event Player, JumlahBalasDendam, Event Player.IndeksBalasDendam, Add, 1);
		End;
	}
}

rule("18 - Kebal: Pasang kembali status setelah muncul kembali")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.KebalAktif == True;
		Or(Event Player.ModeKebal == 2, Is In Spawn Room(Event Player) == False) == True;
		Has Spawned(Event Player) == True;
		Is Alive(Event Player) == True;
		Has Status(Event Player, Unkillable) == False;
	}

	actions
	{
		Set Status(Event Player, Null, Unkillable, 9999);
		If(Event Player.ModeKebal == 1);
			Set Damage Received(Event Player, 100);
			Set Player Health(Event Player, 1);
		Else;
			Set Damage Received(Event Player, 0);
			Set Player Health(Event Player, Max Health(Event Player));
		End;
	}
}

rule("18b - Kebal: Mode 1 HP kembali ke satu saat penuh")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.KebalAktif == True;
		Event Player.ModeKebal == 1;
		Is In Spawn Room(Event Player) == False;
		Has Spawned(Event Player) == True;
		Is Alive(Event Player) == True;
		Health(Event Player) >= Max Health(Event Player);
	}

	actions
	{
		Set Player Health(Event Player, 1);
	}
}

rule("18d - Kebal: Mode HP PENUH selalu kembali penuh")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.KebalAktif == True;
		Event Player.ModeKebal == 2;
		Has Spawned(Event Player) == True;
		Is Alive(Event Player) == True;
		Health(Event Player) < Max Health(Event Player);
	}

	actions
	{
		Set Player Health(Event Player, Max Health(Event Player));
	}
}

rule("18c - Kebal: Nonaktifkan hanya mode 1 HP di Ruang Muncul")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.ModeKebal == 1;
		Is In Spawn Room(Event Player) == True;
	}

	actions
	{
		Event Player.KebalAktif = False;
		Event Player.ModeKebal = 0;
		Event Player.KursorKebal = 1;
		Call Subroutine(EfekPulihkan);
		Clear Status(Event Player, Unkillable);
		Set Damage Received(Event Player, 100);
		If(Is Alive(Event Player) == True);
			Set Player Health(Event Player, Max Health(Event Player));
		End;
		If(Event Player.IkonKebal != Null);
			Destroy Icon(Event Player.IkonKebal);
			Event Player.IkonKebal = Null;
		End;
		Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Unkillable: 1 HP disabled in Spawn Room.") : Event Player.IndeksBahasa == 1 ? Custom String("Kebal: 1 HP dimatikan di ruang muncul.") : Custom String("ปิดโหมดฆ่าไม่ตาย: 1 HP ในห้องเกิดแล้ว"));
		If(And(Event Player.MenuTerbuka == True, Event Player.HalamanMenu == 5));
			Call Subroutine(GambarMenu);
		End;
	}
}



rule("18e - Nasib: Undian merah hijau makin lambat")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.KartuNasibAktif == True;
		Event Player.PutaranKartuNasib > 0;
		Has Spawned(Event Player) == True;
		Is Alive(Event Player) == True;
	}

	actions
	{
		Wait(Event Player.JedaKartuNasib, Abort When False);
		Event Player.KartuNasibMerah = Event Player.KartuNasibMerah == False;
		Modify Player Variable(Event Player, PutaranKartuNasib, Subtract, 1);
		Modify Player Variable(Event Player, JedaKartuNasib, Add, 0.055);
		Loop If Condition Is True;
		If(Event Player.KartuNasibMerah == True);
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("RED! Death in 3...") : Event Player.IndeksBahasa == 1 ? Custom String("MERAH! Mati dalam 3...") : Custom String("แดง! ตายใน 3..."));
			Wait(1, Ignore Condition);
			Abort If(Event Player.KartuNasibAktif == False);
			Abort If(Event Player.PutaranKartuNasib > 0);
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("RED! Death in 2...") : Event Player.IndeksBahasa == 1 ? Custom String("MERAH! Mati dalam 2...") : Custom String("แดง! ตายใน 2..."));
			Wait(1, Ignore Condition);
			Abort If(Event Player.KartuNasibAktif == False);
			Abort If(Event Player.PutaranKartuNasib > 0);
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("RED! Death in 1...") : Event Player.IndeksBahasa == 1 ? Custom String("MERAH! Mati dalam 1...") : Custom String("แดง! ตายใน 1..."));
			Wait(1, Ignore Condition);
			Abort If(Event Player.KartuNasibAktif == False);
			Abort If(Event Player.PutaranKartuNasib > 0);
			Clear Status(Event Player, Unkillable);
			Kill(Event Player, Null);
		Else;
			Set Player Health(Event Player, Max Health(Event Player));
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("GREEN! Full health restored.") : Event Player.IndeksBahasa == 1 ? Custom String("HIJAU! Kesehatan penuh dipulihkan.") : Custom String("เขียว! ฟื้นพลังชีวิตเต็มแล้ว"));
			Wait(1.500, Ignore Condition);
			Abort If(Event Player.KartuNasibAktif == False);
			Abort If(Event Player.PutaranKartuNasib > 0);
		End;
		If(Event Player.TeksKartuNasib != Null);
			Destroy In-World Text(Event Player.TeksKartuNasib);
		End;
		If(Event Player.TeksKartuNasibKanan != Null);
			Destroy In-World Text(Event Player.TeksKartuNasibKanan);
		End;
		If(Event Player.IkonKartuNasib != Null);
			Destroy Icon(Event Player.IkonKartuNasib);
		End;
		If(Event Player.IkonKartuNasibHijau != Null);
			Destroy Icon(Event Player.IkonKartuNasibHijau);
		End;
		Event Player.TeksKartuNasib = Null;
		Event Player.TeksKartuNasibKanan = Null;
		Event Player.IkonKartuNasib = Null;
		Event Player.IkonKartuNasibHijau = Null;
		Event Player.KartuNasibAktif = False;
		Event Player.PutaranKartuNasib = 0;
		Event Player.JedaKartuNasib = 0;
	}
}

rule("18f - Nasib: Hapus kartu saat pemilik mati")
{
	event
	{
		Player Died;
		All;
		All;
	}

	conditions
	{
		Event Player.KartuNasibAktif == True;
	}

	actions
	{
		If(Event Player.TeksKartuNasib != Null);
			Destroy In-World Text(Event Player.TeksKartuNasib);
		End;
		If(Event Player.TeksKartuNasibKanan != Null);
			Destroy In-World Text(Event Player.TeksKartuNasibKanan);
		End;
		If(Event Player.IkonKartuNasib != Null);
			Destroy Icon(Event Player.IkonKartuNasib);
		End;
		If(Event Player.IkonKartuNasibHijau != Null);
			Destroy Icon(Event Player.IkonKartuNasibHijau);
		End;
		Event Player.TeksKartuNasib = Null;
		Event Player.TeksKartuNasibKanan = Null;
		Event Player.IkonKartuNasib = Null;
		Event Player.IkonKartuNasibHijau = Null;
		Event Player.KartuNasibAktif = False;
		Event Player.KartuNasibMerah = False;
		Event Player.PutaranKartuNasib = 0;
		Event Player.JedaKartuNasib = 0;
	}
}


rule("19 - Teleportasi Jongkok: Buka tampilan selama Jongkok ditahan")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotOtomatis == False;
		Is Dummy Bot(Event Player) == False;
		Event Player.MenuTerbuka == False;
		Event Player.TeleportasiJongkokAktif == False;
		Event Player.TeleportasiJongkokDiaktifkan == True;
		Has Spawned(Event Player) == True;
		Is Alive(Event Player) == True;
		Is Button Held(Event Player, Button(Crouch)) == True;
	}

	actions
	{
		Event Player.TeleportasiJongkokAktif = True;
		Event Player.PerintahTeleportasi = 0;
		Event Player.JenisTeleportasiTerkunci = -1;
		Event Player.TargetTeleportasiTerkunci = Null;
		Disallow Button(Event Player, Button(Primary Fire));
		Disallow Button(Event Player, Button(Secondary Fire));
		Disallow Button(Event Player, Button(Interact));
		Call Subroutine(GambarTeleportasi);
	}
}

rule("19a - Teleportasi Jongkok: Pengatur masukan terpisah dari Menu Arkade")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.TeleportasiJongkokAktif == True;
		Event Player.PerintahTeleportasi == 0;
		Is Button Held(Event Player, Button(Crouch)) == True;
		Or(Is Button Held(Event Player, Button(Interact)), Or(Is Button Held(Event Player, Button(Primary Fire)), Is Button Held(Event Player, Button(Secondary Fire)))) == True;
	}

	actions
	{
		If(Is Button Held(Event Player, Button(Interact)));
			Event Player.PerintahTeleportasi = 1;
		Else If(Is Button Held(Event Player, Button(Primary Fire)));
			Event Player.PerintahTeleportasi = 2;
		Else;
			Event Player.PerintahTeleportasi = 3;
		End;
	}
}

rule("19b - Teleportasi Jongkok: Aktifkan lagi pengatur setelah tombol dilepas")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.TeleportasiJongkokAktif == True;
		Event Player.PerintahTeleportasi != 0;
		Is Button Held(Event Player, Button(Interact)) == False;
		Is Button Held(Event Player, Button(Primary Fire)) == False;
		Is Button Held(Event Player, Button(Secondary Fire)) == False;
	}

	actions
	{
		Wait(0.016, Ignore Condition);
		Event Player.PerintahTeleportasi = 0;
	}
}

rule("19c - Teleportasi Jongkok: Tembakan utama memilih tujuan berikutnya")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.TeleportasiJongkokAktif == True;
		Event Player.PerintahTeleportasi == 2;
	}

	actions
	{
		Call Subroutine(SegarkanTargetTeleportasi);
		If(Count Of(Event Player.DaftarTargetTeleportasi) > 0);
			Event Player.KursorTeleportasi = (Event Player.KursorTeleportasi + 1) % Count Of(Event Player.DaftarTargetTeleportasi);
		End;
		Call Subroutine(GambarTeleportasi);
	}
}

rule("19d - Teleportasi Jongkok: Tembakan sekunder memilih tujuan sebelumnya")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.TeleportasiJongkokAktif == True;
		Event Player.PerintahTeleportasi == 3;
	}

	actions
	{
		Call Subroutine(SegarkanTargetTeleportasi);
		If(Count Of(Event Player.DaftarTargetTeleportasi) > 0);
			Event Player.KursorTeleportasi = (Event Player.KursorTeleportasi + Count Of(Event Player.DaftarTargetTeleportasi) - 1) % Count Of(Event Player.DaftarTargetTeleportasi);
		End;
		Call Subroutine(GambarTeleportasi);
	}
}

rule("19e - Teleportasi Jongkok: Interact menjalankan teleportasi")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.TeleportasiJongkokAktif == True;
		Event Player.PerintahTeleportasi == 1;
	}

	actions
	{
		Event Player.JenisTeleportasiTerkunci = Event Player.KursorTeleportasi < 2 ? Event Player.KursorTeleportasi : 2;
		Event Player.TargetTeleportasiTerkunci = Null;
		If(And(Event Player.JenisTeleportasiTerkunci == 2, And(Event Player.KursorTeleportasi >= 0, Event Player.KursorTeleportasi < Count Of(Event Player.DaftarTargetTeleportasi))));
			Event Player.TargetTeleportasiTerkunci = Event Player.DaftarTargetTeleportasi[Event Player.KursorTeleportasi];
		End;
		Call Subroutine(SegarkanTargetTeleportasi);
		If(Event Player.JenisTeleportasiTerkunci == 0);
			If(Is In Spawn Room(Event Player) == True);
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("You are already in the Spawn Room. Mission accomplished.") : Event Player.IndeksBahasa == 1 ? Custom String("Kamu sudah di ruang muncul. Misi selesai.") : Custom String("คุณอยู่ในห้องเกิดแล้ว ภารกิจสำเร็จ"));
			Else If(Event Player.PunyaPosisiMuncul == False);
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Spawn Room not registered yet. Visit spawn first.") : Event Player.IndeksBahasa == 1 ? Custom String("Posisi ruang muncul belum tersimpan. Masuk ke sana dulu.") : Custom String("ยังไม่ได้บันทึกห้องเกิด กรุณาไปที่ห้องเกิดก่อน"));
			Else;
				Teleport(Event Player, Event Player.PosisiRuangMuncul);
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Back to the Spawn Room. Tactical retreat complete.") : Event Player.IndeksBahasa == 1 ? Custom String("Kembali ke ruang muncul. Mundur taktis selesai.") : Custom String("กลับสู่ห้องเกิดแล้ว การถอยเชิงกลยุทธ์เสร็จสิ้น"));
			End;
		Else If(Event Player.JenisTeleportasiTerkunci == 1);
			If(Or(Current Game Mode == Game Mode(Escort), Current Game Mode == Game Mode(Hybrid)));
				If(Distance Between(Payload Position, Vector(0, 0, 0)) <= 0.100);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Payload position unavailable right now.") : Event Player.IndeksBahasa == 1 ? Custom String("Posisi payload belum tersedia saat ini.") : Custom String("ตำแหน่งเพย์โหลดยังไม่พร้อมใช้งานตอนนี้"));
				Else;
					Teleport(Event Player, Nearest Walkable Position(Payload Position + Vector(2, 0, 0)));
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Teleported near the payload.") : Event Player.IndeksBahasa == 1 ? Custom String("Teleport dekat payload.") : Custom String("เทเลพอร์ตใกล้เพย์โหลดแล้ว"));
				End;
			Else If(Current Game Mode == Game Mode(Capture The Flag));
				Teleport(Event Player, Nearest Walkable Position(Flag Position(Opposite Team Of(Team Of(Event Player))) + Vector(2, 0, 0)));
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Teleported near the enemy flag.") : Event Player.IndeksBahasa == 1 ? Custom String("Teleport dekat bendera musuh.") : Custom String("เทเลพอร์ตใกล้ธงของศัตรูแล้ว"));
			Else If(Current Game Mode == Game Mode(Push));
				If(Count Of(Filtered Array(All Players(All Teams), And(Has Spawned(Current Array Element) == True, And(Is Alive(Current Array Element) == True, Is On Objective(Current Array Element) == True)))) > 0);
					Teleport(Event Player, Nearest Walkable Position(Position Of(First Of(Filtered Array(All Players(All Teams), And(Has Spawned(Current Array Element) == True, And(Is Alive(Current Array Element) == True, Is On Objective(Current Array Element) == True))))) + Vector(2, 0, 0)));
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Teleported near the Push robot.") : Event Player.IndeksBahasa == 1 ? Custom String("Teleport dekat robot Push.") : Custom String("เทเลพอร์ตใกล้หุ่นยนต์ Push แล้ว"));
				Else If(Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) > 0.100);
					Teleport(Event Player, Nearest Walkable Position(Objective Position(Objective Index)));
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Robot position unavailable; using the current objective.") : Event Player.IndeksBahasa == 1 ? Custom String("Posisi robot belum tersedia; memakai objektif saat ini.") : Custom String("ไม่พบตำแหน่งหุ่นยนต์ ใช้เป้าหมายปัจจุบันแทน"));
				Else;
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Push robot position unavailable right now.") : Event Player.IndeksBahasa == 1 ? Custom String("Posisi robot Push belum tersedia saat ini.") : Custom String("ตำแหน่งหุ่นยนต์ Push ยังไม่พร้อมใช้งานตอนนี้"));
				End;
			Else If(Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) <= 0.100);
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Objective position unavailable in this mode. The objective is being mysterious.") : Event Player.IndeksBahasa == 1 ? Custom String("Posisi objektif tidak tersedia di mode ini. Objektifnya sedang misterius.") : Custom String("ตำแหน่งเป้าหมายใช้ไม่ได้ในโหมดนี้ เป้าหมายกำลังเล่นซ่อนหา"));
			Else;
				Teleport(Event Player, Nearest Walkable Position(Objective Position(Objective Index)));
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Teleported near the current objective.") : Event Player.IndeksBahasa == 1 ? Custom String("Teleport dekat objektif saat ini.") : Custom String("เทเลพอร์ตใกล้เป้าหมายปัจจุบันแล้ว"));
			End;
		Else If(Or(Or(Event Player.TargetTeleportasiTerkunci == Null, Entity Exists(Event Player.TargetTeleportasiTerkunci) == False), Or(Is Alive(Event Player.TargetTeleportasiTerkunci) == False, Array Contains(Event Player.DaftarTargetTeleportasi, Event Player.TargetTeleportasiTerkunci) == False)));
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Target unavailable. Even teleportation has standards.") : Event Player.IndeksBahasa == 1 ? Custom String("Target sedang tidak tersedia. Teleportasi juga punya standar.") : Custom String("เป้าหมายไม่พร้อมใช้งาน แม้แต่เทเลพอร์ตก็มีมาตรฐาน"));
		Else;
			Teleport(Event Player, Nearest Walkable Position(Position Of(Event Player.TargetTeleportasiTerkunci) - Facing Direction Of(Event Player.TargetTeleportasiTerkunci) * 1.500));
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Teleported near {0}. Personal space sold separately.", Event Player.TargetTeleportasiTerkunci) : Event Player.IndeksBahasa == 1 ? Custom String("Teleport dekat {0}. Jarak pribadi dijual terpisah.", Event Player.TargetTeleportasiTerkunci) : Custom String("เทเลพอร์ตไปใกล้ {0} แล้ว พื้นที่ส่วนตัวไม่ได้รวมในแพ็กเกจ", Event Player.TargetTeleportasiTerkunci));
		End;
		Event Player.JenisTeleportasiTerkunci = -1;
		Event Player.TargetTeleportasiTerkunci = Null;
		If(Event Player.TeleportasiJongkokAktif == True);
			Call Subroutine(GambarTeleportasi);
		End;
	}
}

rule("19f - Teleportasi Jongkok: Segarkan daftar target tanpa menggambar ulang berkala")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.TeleportasiJongkokAktif == True;
	}

	actions
	{
		Call Subroutine(SegarkanTargetTeleportasi);
		Wait(1, Abort When False);
		Loop If Condition Is True;
	}
}

rule("19g - Teleportasi Jongkok: Tutup saat Jongkok dilepas")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.TeleportasiJongkokAktif == True;
		Or(Or(Is Button Held(Event Player, Button(Crouch)) == False, Event Player.MenuTerbuka == True), Or(Has Spawned(Event Player) == False, Is Alive(Event Player) == False)) == True;
	}

	actions
	{
		If(Event Player.HudMenu != Null);
			Destroy HUD Text(Event Player.HudMenu);
		End;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.HudMenuPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = 0;
		End;
		Event Player.HudMenu = Null;
		Event Player.TeleportasiJongkokAktif = False;
		Event Player.PerintahTeleportasi = 0;
		Event Player.JenisTeleportasiTerkunci = -1;
		Event Player.TargetTeleportasiTerkunci = Null;
		Allow Button(Event Player, Button(Primary Fire));
		Allow Button(Event Player, Button(Secondary Fire));
		Allow Button(Event Player, Button(Interact));
	}
}

rule("90 - Subrutin: Tutup menu dan kembalikan semua tombol")
{
	event
	{
		Subroutine;
		TutupMenu;
	}

	actions
	{
		If(Event Player.HudMenu != Null);
			Destroy HUD Text(Event Player.HudMenu);
		End;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.HudMenuPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = 0;
		End;
		Event Player.HudMenu = Null;
		Event Player.MenuTerbuka = False;
		Event Player.PerintahMenu = 0;
		Event Player.HalamanMenu = -1;
		If(Is Button Held(Event Player, Button(Melee)));
			Event Player.SeranganDekatDipakai = True;
		Else;
			Allow Button(Event Player, Button(Melee));
			Event Player.SeranganDekatDipakai = False;
		End;
		Allow Button(Event Player, Button(Jump));
		Allow Button(Event Player, Button(Crouch));
		Allow Button(Event Player, Button(Primary Fire));
		Allow Button(Event Player, Button(Secondary Fire));
		Allow Button(Event Player, Button(Interact));
		Allow Button(Event Player, Button(Reload));
		Allow Button(Event Player, Button(Ability 1));
		Allow Button(Event Player, Button(Ability 2));
		Allow Button(Event Player, Button(Ultimate));
	}
}

rule("91 - Subrutin: Pilih gambar menu yang sedang dibuka")
{
	event
	{
		Subroutine;
		GambarMenu;
	}

	actions
	{
		If(Event Player.HudMenu != Null);
			Destroy HUD Text(Event Player.HudMenu);
		End;
		Event Player.HudMenu = Null;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.HudMenuPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = 0;
		End;
		Call Subroutine(TransisiWarnaMenu);
		If(Event Player.HalamanMenu == -1);
			Call Subroutine(GambarUtama);
		Else If(Event Player.HalamanMenu == 0);
			Call Subroutine(GambarMusik);
		Else If(Event Player.HalamanMenu == 1);
			Call Subroutine(GambarKamera);
		Else If(Event Player.HalamanMenu == 2);
			Call Subroutine(GambarWarna);
		Else If(Event Player.HalamanMenu == 3);
			Call Subroutine(GambarBahasa);
		Else If(Event Player.HalamanMenu == 4);
			Call Subroutine(GambarBalasDendam);
		Else If(Event Player.HalamanMenu == 5);
			Call Subroutine(GambarKebal);
		Else If(Event Player.HalamanMenu == 6);
			Call Subroutine(GambarSuara);
		Else If(Event Player.HalamanMenu == 7);
			Call Subroutine(GambarIkon);
		Else If(Event Player.HalamanMenu == 8);
			Call Subroutine(GambarSakelarTeleportasi);
		Else If(Event Player.HalamanMenu == 9);
			Call Subroutine(GambarPrivasiInspeksi);
		Else If(Event Player.HalamanMenu == 10);
			Call Subroutine(GambarNasib);
		Else;
			Call Subroutine(GambarPilihan);
		End;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.HudMenuPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = Event Player.HudMenu;
		End;
	}
}

rule("91a - Subrutin: Gambar menu utama")
{
	event
	{
		Subroutine;
		GambarUtama;
	}

	actions
	{
		Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String("\n{0}: next | {1}: previous",
			Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: open | hold {1} 0.5 sec: close",
			Input Binding String(Button(Interact)), Input Binding String(Button(Melee)))) : Event Player.IndeksBahasa == 1 ? Custom String("{0}\n{1}",
			Custom String("\n{0}: berikutnya | {1}: sebelumnya", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String(
			"{0}: buka | tahan {1} 0,5 dtk: tutup", Input Binding String(Button(Interact)), Input Binding String(Button(Melee)))) : Custom String("{0}\n{1}",
			Custom String("\n{0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String(
			"{0}: เปิด | กด {1} ค้างเพื่อปิด", Input Binding String(Button(Interact)), Input Binding String(Button(Melee)))),
			Event Player.IndeksBahasa == 0 ? Event Player.KursorUtama == 0 ? Custom String("0 - SOUNDTRACK\nCURRENT: {0}", Event Player.IndeksGenre >= 0 ? Global.DaftarGenre[Event Player.IndeksGenre] : Custom String("no soundtrack yet"))
			: Event Player.KursorUtama == 1 ? Custom String("1 - THIRD-PERSON\nCURRENT: {0}", Event Player.ModeKamera == 0 ? Custom String("off") : Event Player.ModeKamera == 1 ? Custom String("your hero") : Custom String("watching {0}", Event Player.TargetKamera))
			: Event Player.KursorUtama == 2 ? Custom String("2 - NAME COLOR\nCURRENT: {0}", Global.NamaWarnaInggris[Event Player.IndeksWarna])
			: Event Player.KursorUtama == 3 ? Custom String("3 - LANGUAGE\nCURRENT: {0}", Global.NamaBahasa[Event Player.IndeksBahasa])
			: Event Player.KursorUtama == 4 ? Custom String("4 - REVENGE\nSETTLE YOUR SCORE")
			: Event Player.KursorUtama == 5 ? Custom String("5 - UNKILLABLE\nCURRENT: {0}", Event Player.ModeKebal == 0 ? Custom String("OFF") : Event Player.ModeKebal == 1 ? Custom String("1 HP") : Custom String("FULL HP"))
			: Event Player.KursorUtama == 6 ? Custom String("6 - HERO VOICE\nCURRENT: {0}", Event Player.IndeksSuara == 0 ? Custom String("NORMAL") : Event Player.IndeksSuara == 1 ? Custom String("LOW 0.50x") : Event Player.IndeksSuara == 2 ? Custom String("LOW 0.75x") : Event Player.IndeksSuara == 3 ? Custom String("HIGH 1.25x") : Custom String("HIGH 1.50x"))
			: Event Player.KursorUtama == 7 ? Event Player.IndeksIkon == 0 ? Custom String("7 - ICON\nCURRENT: NOTHING") : Custom String("7 - ICON\nCURRENT: {0} {1}", Global.DaftarIkon[Event Player.IndeksIkon], Global.NamaIkon[Event Player.IndeksIkon])
			: Event Player.KursorUtama == 8 ? Custom String("8 - CROUCH TELEPORT\nCURRENT: {0}", Event Player.TeleportasiJongkokDiaktifkan ? Custom String("ON") : Custom String("OFF"))
			: Event Player.KursorUtama == 9 ? Custom String("9 - CROUCH PRIVACY\nCURRENT: {0}", Event Player.PrivasiInspeksiAktif ? Custom String("ON") : Custom String("OFF"))
			: Event Player.KursorUtama == 10 ? Custom String("10 - TRY YOUR LUCK\nSTATUS: {0}", Event Player.KartuNasibAktif ? Custom String("ACTIVE") : Custom String("READY"))
			: Custom String("11 - VOTE PLAYER\nYOUR VOTE: {0}", Event Player.PemainDipilih != Null ? Event Player.PemainDipilih : Custom String("NONE"))
			: Event Player.IndeksBahasa == 1 ? Event Player.KursorUtama == 0 ? Custom String("0 - MUSIK\nSAAT INI: {0}", Event Player.IndeksGenre >= 0 ? Global.DaftarGenre[Event Player.IndeksGenre] : Custom String("belum pilih musik"))
			: Event Player.KursorUtama == 1 ? Custom String("1 - KAMERA 3P\nSAAT INI: {0}", Event Player.ModeKamera == 0 ? Custom String("mati") : Event Player.ModeKamera == 1 ? Custom String("hero sendiri") : Custom String("menonton {0}", Event Player.TargetKamera))
			: Event Player.KursorUtama == 2 ? Custom String("2 - WARNA NAMA\nSAAT INI: {0}", Global.NamaWarna[Event Player.IndeksWarna])
			: Event Player.KursorUtama == 3 ? Custom String("3 - BAHASA\nSAAT INI: {0}", Global.NamaBahasa[Event Player.IndeksBahasa])
			: Event Player.KursorUtama == 4 ? Custom String("4 - BALAS DENDAM\nTAGIH UTANG KILL")
			: Event Player.KursorUtama == 5 ? Custom String("5 - KEBAL\nSAAT INI: {0}", Event Player.ModeKebal == 0 ? Custom String("MATI") : Event Player.ModeKebal == 1 ? Custom String("1 HP") : Custom String("FULL HP"))
			: Event Player.KursorUtama == 6 ? Custom String("6 - SUARA PAHLAWAN\nSAAT INI: {0}", Event Player.IndeksSuara == 0 ? Custom String("NORMAL") : Event Player.IndeksSuara == 1 ? Custom String("RENDAH 0.50x") : Event Player.IndeksSuara == 2 ? Custom String("RENDAH 0.75x") : Event Player.IndeksSuara == 3 ? Custom String("TINGGI 1.25x") : Custom String("TINGGI 1.50x"))
			: Event Player.KursorUtama == 7 ? Event Player.IndeksIkon == 0 ? Custom String("7 - IKON\nSAAT INI: TIDAK ADA") : Custom String("7 - IKON\nSAAT INI: {0} {1}", Global.DaftarIkon[Event Player.IndeksIkon], Global.NamaIkon[Event Player.IndeksIkon])
			: Event Player.KursorUtama == 8 ? Custom String("8 - TELEPORT JONGKOK\nSAAT INI: {0}", Event Player.TeleportasiJongkokDiaktifkan ? Custom String("AKTIF") : Custom String("MATI"))
			: Event Player.KursorUtama == 9 ? Custom String("9 - PRIVASI JONGKOK\nSAAT INI: {0}", Event Player.PrivasiInspeksiAktif ? Custom String("AKTIF") : Custom String("MATI"))
			: Event Player.KursorUtama == 10 ? Custom String("10 - COBA NASIB\nSTATUS: {0}", Event Player.KartuNasibAktif ? Custom String("AKTIF") : Custom String("SIAP"))
			: Custom String("11 - PILIH PEMAIN\nPILIHAN KAMU: {0}", Event Player.PemainDipilih != Null ? Event Player.PemainDipilih : Custom String("BELUM ADA"))
			: Event Player.KursorUtama == 0 ? Custom String("0 - เพลงประกอบ\nปัจจุบัน: {0}", Event Player.IndeksGenre >= 0 ? Global.DaftarGenre[Event Player.IndeksGenre] : Custom String("ยังไม่ได้เลือกเพลง"))
			: Event Player.KursorUtama == 1 ? Custom String("1 - กล้องบุคคลที่สาม\nสถานะ: {0}", Event Player.ModeKamera == 0 ? Custom String("ปิด") : Event Player.ModeKamera == 1 ? Custom String("ฮีโร่ของคุณ") : Custom String("กำลังดู {0}", Event Player.TargetKamera))
			: Event Player.KursorUtama == 2 ? Custom String("2 - สีชื่อ\nปัจจุบัน: {0}", Global.NamaWarnaThai[Event Player.IndeksWarna])
			: Event Player.KursorUtama == 3 ? Custom String("3 - ภาษา\nปัจจุบัน: {0}", Global.NamaBahasa[Event Player.IndeksBahasa])
			: Event Player.KursorUtama == 4 ? Custom String("4 - ล้างแค้น\nทวงหนี้กันหน่อย")
			: Event Player.KursorUtama == 5 ? Custom String("5 - ฆ่าไม่ตาย\nสถานะ: {0}", Event Player.ModeKebal == 0 ? Custom String("ปิด") : Event Player.ModeKebal == 1 ? Custom String("1 HP") : Custom String("FULL HP"))
			: Event Player.KursorUtama == 6 ? Custom String("6 - เสียงฮีโร่\nสถานะ: {0}", Event Player.IndeksSuara == 0 ? Custom String("ปกติ") : Event Player.IndeksSuara == 1 ? Custom String("ต่ำ 0.50x") : Event Player.IndeksSuara == 2 ? Custom String("ต่ำ 0.75x") : Event Player.IndeksSuara == 3 ? Custom String("สูง 1.25x") : Custom String("สูง 1.50x"))
			: Event Player.KursorUtama == 7 ? Event Player.IndeksIkon == 0 ? Custom String("7 - ไอคอน\nปัจจุบัน: ไม่มี") : Custom String("7 - ไอคอน\nปัจจุบัน: {0} {1}", Global.DaftarIkon[Event Player.IndeksIkon], Global.NamaIkon[Event Player.IndeksIkon])
			: Event Player.KursorUtama == 8 ? Custom String("8 - เทเลพอร์ตตอนย่อ\nสถานะ: {0}", Event Player.TeleportasiJongkokDiaktifkan ? Custom String("เปิด") : Custom String("ปิด"))
			: Event Player.KursorUtama == 9 ? Custom String("9 - ความเป็นส่วนตัวตอนย่อ\nสถานะ: {0}", Event Player.PrivasiInspeksiAktif ? Custom String("เปิด") : Custom String("ปิด"))
			: Event Player.KursorUtama == 10 ? Custom String("10 - เสี่ยงโชค\nสถานะ: {0}", Event Player.KartuNasibAktif ? Custom String("ทำงาน") : Custom String("พร้อม"))
			: Custom String("11 - โหวตผู้เล่น\nโหวตของคุณ: {0}", Event Player.PemainDipilih != Null ? Event Player.PemainDipilih : Custom String("ยังไม่ได้โหวต")), Top, 100,
			Color(White), Custom Color(210, 230, 255, 255), Custom Color(X Component Of(Event Player.WarnaMenu), Y Component Of(Event Player.WarnaMenu), Z Component Of(Event Player.WarnaMenu), 255), Visible To String and Color, Visible Never);
		Event Player.HudMenu = Last Text ID;
	}
}

rule("91b - Subrutin: Gambar menu musik")
{
	event
	{
		Subroutine;
		GambarMusik;
	}

	actions
	{
		Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String("{0}\n{1}",
			Custom String("\n{0}: next | {1}: previous", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))),
			Custom String("{0}: back 10 | {1}: forward 10", Input Binding String(Button(Jump)), Input Binding String(Button(Crouch)))),
			Custom String("{0}\n{1}", Custom String("{0}: apply | {1}: back", Input Binding String(Button(Interact)), Input Binding String(Button(Reload))),
			Custom String("Hold {0} 0.5 sec: close", Input Binding String(Button(Melee))))) : Event Player.IndeksBahasa == 1 ? Custom String("{0}\n{1}",
			Custom String("{0}\n{1}", Custom String("\n{0}: berikutnya | {1}: sebelumnya", Input Binding String(Button(Primary Fire)),
			Input Binding String(Button(Secondary Fire))), Custom String("{0}: mundur 10 | {1}: maju 10", Input Binding String(Button(Jump)),
			Input Binding String(Button(Crouch)))), Custom String("{0}\n{1}", Custom String("{0}: pakai | {1}: kembali", Input Binding String(Button(Interact)),
			Input Binding String(Button(Reload))), Custom String("Tahan {0} 0,5 dtk: tutup", Input Binding String(Button(Melee))))) : Custom String("{0}\n{1}",
			Custom String("{0}\n{1}", Custom String("\n{0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Primary Fire)),
			Input Binding String(Button(Secondary Fire))), Custom String("{0}: ย้อน 10 | {1}: เดินหน้า 10", Input Binding String(Button(Jump)),
			Input Binding String(Button(Crouch)))), Custom String("{0}\n{1}", Custom String("{0}: ใช้ | {1}: กลับ", Input Binding String(Button(Interact)),
			Input Binding String(Button(Reload))), Custom String("กด {0} ค้าง 0.5 วินาที: ปิด", Input Binding String(Button(Melee))))),
			Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}\n> {2}", Custom String("0 - SOUNDTRACK {0}/100\nCURRENT: {1}",
			Event Player.KursorGenre + 1, Event Player.IndeksGenre >= 0 ? Global.DaftarGenre[Event Player.IndeksGenre] : Custom String("no soundtrack yet")),
			Global.NamaHalamanInggris[Round To Integer(Event Player.KursorGenre / 10, Down)], Global.DaftarGenre[Event Player.KursorGenre]) : Event Player.IndeksBahasa == 1 ? Custom String(
			"{0}\n{1}\n> {2}", Custom String("0 - MUSIK {0}/100\nSAAT INI: {1}", Event Player.KursorGenre + 1, Event Player.IndeksGenre >= 0
			? Global.DaftarGenre[Event Player.IndeksGenre] : Custom String("belum pilih musik")), Global.NamaHalaman[Round To Integer(Event Player.KursorGenre / 10, Down)],
			Global.DaftarGenre[Event Player.KursorGenre]) : Custom String("{0}\n{1}\n> {2}", Custom String("0 - เพลงประกอบ {0}/100\nปัจจุบัน: {1}",
			Event Player.KursorGenre + 1, Event Player.IndeksGenre >= 0 ? Global.DaftarGenre[Event Player.IndeksGenre] : Custom String("ยังไม่ได้เลือกเพลง")),
			Global.NamaHalamanThai[Round To Integer(Event Player.KursorGenre / 10, Down)], Global.DaftarGenre[Event Player.KursorGenre]), Top, 100,
			Color(White), Custom Color(205, 235, 255, 255), Custom Color(X Component Of(Event Player.WarnaMenu), Y Component Of(Event Player.WarnaMenu), Z Component Of(Event Player.WarnaMenu), 255), Visible To String and Color, Visible Never);
		Event Player.HudMenu = Last Text ID;
	}
}

