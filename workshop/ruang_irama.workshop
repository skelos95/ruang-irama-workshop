}

rule("01 - Pemain Masuk: Mulai jam nongkrong")
{
	event
	{
		Player Joined Match;
		All;
		All;
	}

	actions
	{
		Call Subroutine(SiapkanPemain);
	}
}

rule("01b - Pemain Lama: Siapkan juga yang sudah telanjur ada")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.Siap == True;
		Event Player.SudahSiap == False;
	}

	actions
	{
		Call Subroutine(SiapkanPemain);
	}
}

rule("02 - Pemain: Pisahkan manusia dari pasukan kaleng")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.Siap == True;
		Event Player.SudahSiap == True;
		Has Spawned(Event Player) == True;
		Event Player.SudahDiperiksa == False;
	}

	actions
	{
		Event Player.SudahDiperiksa = True;
		Event Player.BotAI = False;
		Event Player.Manusia = False;
		Event Player.WarnaNama = Color(White);
		If(Event Player.WaktuTercatat == False);
			Event Player.WaktuMasuk = Total Time Elapsed;
			Event Player.WaktuTercatat = True;
		End;
		"Dummy bot jelas bukan manusia. Silakan duduk manis."
		If(Is Dummy Bot(Event Player));
			Cancel Primary Action(Event Player);
			Call Subroutine(KunciBot);
			Abort;
		End;
		"Dua string ini berisi U+200B, bukan string kosong. Ia mengenali bot AI tanpa memamerkan nama uji."
		Start Forcing Dummy Bot Name(Event Player, Custom String("​"));
		Wait(0.016, Ignore Condition);
		If(Custom String("{0}", Event Player) == Custom String("​"));
			Event Player.BotAI = True;
		Else;
			Event Player.BotAI = False;
		End;
		Wait(0.016, Ignore Condition);
		Stop Forcing Dummy Bot Name(Event Player);
		If(Event Player.BotAI == True);
			Cancel Primary Action(Event Player);
			Call Subroutine(KunciBot);
			Abort;
		End;

		Event Player.Manusia = True;
		Event Player.IndeksGenre = -1;
		Event Player.IndeksWarna = 0;
		Event Player.WarnaNama = Global.DaftarWarna[Event Player.IndeksWarna];
		Event Player.MenitLobby = 0;
		Event Player.UrutanHUD = Global.NomorUrut;
		Global.NomorUrut += 1;
		Global.PemainManusia = Append To Array(Global.PemainManusia, Event Player);

		Create HUD Text(Global.PemainManusia, Null, Null, Player Variable(Local Player, IndeksBahasa) == 0 ? Custom String(
			"{0} - hanging out {1} min", Event Player, Event Player.MenitLobby) : Custom String("{0} - nongkrong {1} mnt",
			Event Player, Event Player.MenitLobby), Left, -99 + Event Player.UrutanHUD, Color(White), Color(White), Event Player.WarnaNama,
			Visible To String and Color, Default Visibility);
		Event Player.HudKiri = Last Text ID;
		Global.HudKiriPemain = Append To Array(Global.HudKiriPemain, Event Player.HudKiri);
		Create HUD Text(Global.PemainManusia, Null, Null, Player Variable(Local Player, IndeksBahasa) == 0 ? Custom String("{0} - vibe: {1}",
			Event Player, Event Player.IndeksGenre >= 0 ? Global.DaftarGenre[Event Player.IndeksGenre] : Custom String("not picked yet"))
			: Custom String("{0} - selera: {1}", Event Player, Event Player.IndeksGenre >= 0 ? Global.DaftarGenre[Event Player.IndeksGenre]
			: Custom String("belum pilih")), Right, -99 + Event Player.UrutanHUD, Color(White), Color(White), Event Player.WarnaNama,
			Visible To String and Color, Default Visibility);
		Event Player.HudKanan = Last Text ID;
		Global.HudKananPemain = Append To Array(Global.HudKananPemain, Event Player.HudKanan);
		Global.HudMenuPemain = Append To Array(Global.HudMenuPemain, 0);
		Global.TeksDuniaPemain = Append To Array(Global.TeksDuniaPemain, 0);
		Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
			"Welcome, verified human. The machines failed the vibe check.") : Custom String(
			"Selamat datang, manusia terverifikasi. Mesin gagal lolos cek suasana."));
	}
}

rule("03 - Waktu: Hitung menit nongkrong tanpa bikin server ngos-ngosan")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
	}

	actions
	{
		Event Player.MenitLobby = Max(0, Round To Integer((Total Time Elapsed - Event Player.WaktuMasuk) / 60, Down));
		Wait(1, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("03b - Bot: Senjata libur, kaki tetap boleh jalan")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Global.Siap == True;
		Is Alive(Event Player) == True;
		Or(Is Dummy Bot(Event Player), Event Player.BotAI) == True;
	}

	actions
	{
		"Kunci diulang agar respawn dan pergantian hero tidak menghidupkan senjata lagi."
		Call Subroutine(KunciBot);
		Wait(0.500, Ignore Condition);
		Loop If Condition Is True;
	}
}

rule("04 - Pemain Keluar: Rapikan HUD dan tulisan dunia")
{
	event
	{
		Player Left Match;
		All;
		All;
	}

	actions
	{
		"Semua ID disimpan di daftar global sejajar karena data pemain yang keluar bisa cepat menghilang."
		Global.IndeksKeluar = Index Of Array Value(Global.PemainManusia, Event Player);
		Abort If(Global.IndeksKeluar < 0);
		Destroy HUD Text(Global.HudKiriPemain[Global.IndeksKeluar]);
		Destroy HUD Text(Global.HudKananPemain[Global.IndeksKeluar]);
		If(Global.HudMenuPemain[Global.IndeksKeluar] != 0);
			Destroy HUD Text(Global.HudMenuPemain[Global.IndeksKeluar]);
		End;
		If(Global.TeksDuniaPemain[Global.IndeksKeluar] != 0);
			Destroy In-World Text(Global.TeksDuniaPemain[Global.IndeksKeluar]);
		End;
		Modify Global Variable(HudKiriPemain, Remove From Array By Index, Global.IndeksKeluar);
		Modify Global Variable(HudKananPemain, Remove From Array By Index, Global.IndeksKeluar);
		Modify Global Variable(HudMenuPemain, Remove From Array By Index, Global.IndeksKeluar);
		Modify Global Variable(TeksDuniaPemain, Remove From Array By Index, Global.IndeksKeluar);
		Modify Global Variable(PemainManusia, Remove From Array By Index, Global.IndeksKeluar);
		Global.IndeksKeluar = -1;
	}
}

rule("05 - Menu: Tahan serangan jarak dekat 1,5 detik untuk buka atau tutup")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Is Alive(Event Player) == True;
		Event Player.MeleeDipakai == False;
		Is Button Held(Event Player, Button(Melee)) == True;
	}

	actions
	{
		Wait(1.500, Abort When False);
		Event Player.MeleeDipakai = True;
		If(Event Player.MenuTerbuka == True);
			Call Subroutine(TutupMenu);
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Menu closed. Back to the lobby.") : Custom String(
				"Menu ditutup. Balik nongkrong."));
		Else;
			Event Player.MenuTerbuka = True;
			Event Player.HalamanMenu = -1;
			Event Player.KursorUtama = 0;
			Event Player.KursorGenre = Event Player.IndeksGenre >= 0 ? Event Player.IndeksGenre : 0;
			Event Player.KursorKamera = 0;
			Call Subroutine(SegarkanTargetKamera);
			If(Event Player.ModeKamera == 1);
				Event Player.KursorKamera = 1;
			Else If(And(Event Player.ModeKamera == 2, Array Contains(Event Player.DaftarTargetKamera, Event Player.TargetKamera)));
				Event Player.KursorKamera = Index Of Array Value(Event Player.DaftarTargetKamera, Event Player.TargetKamera) + 2;
			End;
			Event Player.KursorWarna = Event Player.IndeksWarna;
			Event Player.KursorBahasa = Event Player.IndeksBahasa;
			Disallow Button(Event Player, Button(Melee));
			Disallow Button(Event Player, Button(Jump));
			Disallow Button(Event Player, Button(Crouch));
			Disallow Button(Event Player, Button(Primary Fire));
			Disallow Button(Event Player, Button(Secondary Fire));
			Disallow Button(Event Player, Button(Interact));
			Disallow Button(Event Player, Button(Reload));
			Disallow Button(Event Player, Button(Ability 1));
			Disallow Button(Event Player, Button(Ability 2));
			Disallow Button(Event Player, Button(Ultimate));
			Call Subroutine(GambarMenu);
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Menu open. Four choices, zero paperwork.") : Custom String(
				"Menu terbuka. Empat pilihan, nol formulir."));
		End;
	}
}

rule("05b - Menu: Lepaskan serangan jarak dekat sebelum pakai lagi")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.MeleeDipakai == True;
		Is Button Held(Event Player, Button(Melee)) == False;
	}

	actions
	{
		If(Event Player.MenuTerbuka == False);
			Allow Button(Event Player, Button(Melee));
		End;
		Event Player.MeleeDipakai = False;
	}
}

rule("06 - Menu: Tembakan utama memilih sebelumnya")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.MenuTerbuka == True;
		Is Button Held(Event Player, Button(Primary Fire)) == True;
	}

	actions
	{
		If(Event Player.HalamanMenu == -1);
			Event Player.KursorUtama = (Event Player.KursorUtama + 3) % 4;
		Else If(Event Player.HalamanMenu == 0);
			Event Player.KursorGenre = (Event Player.KursorGenre + 99) % 100;
		Else If(Event Player.HalamanMenu == 1);
			Call Subroutine(SegarkanTargetKamera);
			Event Player.KursorKamera = (Event Player.KursorKamera + Count Of(Event Player.DaftarTargetKamera) + 1) % (Count Of(
				Event Player.DaftarTargetKamera) + 2);
		Else If(Event Player.HalamanMenu == 2);
			Event Player.KursorWarna = (Event Player.KursorWarna + Count Of(Global.DaftarWarna) - 1) % Count Of(Global.DaftarWarna);
		Else;
			Event Player.KursorBahasa = (Event Player.KursorBahasa + 1) % 2;
		End;
		Wait Until(Is Button Held(Event Player, Button(Primary Fire)) == False, 99999);
	}
}

rule("07 - Menu: Tembakan sekunder memilih berikutnya")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.MenuTerbuka == True;
		Is Button Held(Event Player, Button(Secondary Fire)) == True;
	}

	actions
	{
		If(Event Player.HalamanMenu == -1);
			Event Player.KursorUtama = (Event Player.KursorUtama + 1) % 4;
		Else If(Event Player.HalamanMenu == 0);
			Event Player.KursorGenre = (Event Player.KursorGenre + 1) % 100;
		Else If(Event Player.HalamanMenu == 1);
			Call Subroutine(SegarkanTargetKamera);
			Event Player.KursorKamera = (Event Player.KursorKamera + 1) % (Count Of(Event Player.DaftarTargetKamera) + 2);
		Else If(Event Player.HalamanMenu == 2);
			Event Player.KursorWarna = (Event Player.KursorWarna + 1) % Count Of(Global.DaftarWarna);
		Else;
			Event Player.KursorBahasa = (Event Player.KursorBahasa + 1) % 2;
		End;
		Wait Until(Is Button Held(Event Player, Button(Secondary Fire)) == False, 99999);
	}
}

rule("07b - Menu kamera: Segarkan pemain dan bot yang bisa ditonton")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.MenuTerbuka == True;
		Event Player.HalamanMenu == 1;
	}

	actions
	{
		Call Subroutine(SegarkanTargetKamera);
		Wait(0.500, Abort When False);
		Loop If Condition Is True;
	}
}

rule("08 - Menu 0: Lompat mundur sepuluh genre")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.MenuTerbuka == True;
		Event Player.HalamanMenu == 0;
		Is Button Held(Event Player, Button(Jump)) == True;
	}

	actions
	{
		Event Player.KursorGenre = (Event Player.KursorGenre + 90) % 100;
		Wait Until(Is Button Held(Event Player, Button(Jump)) == False, 99999);
	}
}

rule("09 - Menu 0: Jongkok maju sepuluh genre")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.MenuTerbuka == True;
		Event Player.HalamanMenu == 0;
		Is Button Held(Event Player, Button(Crouch)) == True;
	}

	actions
	{
		Event Player.KursorGenre = (Event Player.KursorGenre + 10) % 100;
		Wait Until(Is Button Held(Event Player, Button(Crouch)) == False, 99999);
	}
}

rule("10 - Menu: Interaksi membuka atau menerapkan pilihan")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.MenuTerbuka == True;
		Is Button Held(Event Player, Button(Interact)) == True;
	}

	actions
	{
		If(Event Player.HalamanMenu == -1);
			Event Player.HalamanMenu = Global.KodeMenu[Event Player.KursorUtama];
			If(Event Player.HalamanMenu == 0);
				Event Player.KursorGenre = Event Player.IndeksGenre >= 0 ? Event Player.IndeksGenre : 0;
			Else If(Event Player.HalamanMenu == 1);
				Event Player.KursorKamera = 0;
				Call Subroutine(SegarkanTargetKamera);
				If(Event Player.ModeKamera == 1);
					Event Player.KursorKamera = 1;
				Else If(And(Event Player.ModeKamera == 2, Array Contains(Event Player.DaftarTargetKamera, Event Player.TargetKamera)));
					Event Player.KursorKamera = Index Of Array Value(Event Player.DaftarTargetKamera, Event Player.TargetKamera) + 2;
				End;
			Else If(Event Player.HalamanMenu == 2);
				Event Player.KursorWarna = Event Player.IndeksWarna;
			Else;
				Event Player.KursorBahasa = Event Player.IndeksBahasa;
			End;
			Call Subroutine(GambarMenu);
		Else If(Event Player.HalamanMenu == 0);
			Event Player.IndeksGenre = Event Player.KursorGenre;
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
				"Music picked: {0}. Your ears have a plan now.", Global.DaftarGenre[Event Player.IndeksGenre]) : Custom String(
				"Musik dipilih: {0}. Kupingmu sekarang punya arah.", Global.DaftarGenre[Event Player.IndeksGenre]));
		Else If(Event Player.HalamanMenu == 1);
			Call Subroutine(SegarkanTargetKamera);
			Event Player.KursorKamera %= Count Of(Event Player.DaftarTargetKamera) + 2;
			If(Event Player.KursorKamera == 0);
				Stop Camera(Event Player);
				Event Player.ModeKamera = 0;
				Event Player.TargetKamera = Null;
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
					"Back to first person. Drama over.") : Custom String("Kembali ke orang pertama. Dramanya selesai."));
			Else If(Event Player.KursorKamera == 1);
				Event Player.TargetKamera = Event Player;
				Event Player.ModeKamera = 1;
				Call Subroutine(MulaiKamera);
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
					"Third person is on you. Strike a pose.") : Custom String("Kamera orang ketiga aktif untukmu. Silakan bergaya."));
			Else;
				If(Event Player.KursorKamera - 2 < Count Of(Event Player.DaftarTargetKamera));
					Event Player.CalonTargetKamera = Event Player.DaftarTargetKamera[Event Player.KursorKamera - 2];
				Else;
					Event Player.CalonTargetKamera = Null;
				End;
				If(And(Event Player.CalonTargetKamera != Null, Entity Exists(Event Player.CalonTargetKamera)));
					Event Player.TargetKamera = Event Player.CalonTargetKamera;
					Event Player.ModeKamera = 2;
					Call Subroutine(MulaiKamera);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"Now watching {0}. Totally professional spectating.", Event Player.TargetKamera) : Custom String(
						"Sekarang menonton {0}. Mengintip secara profesional.", Event Player.TargetKamera));
				Else;
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"That player vanished. Pick another star.") : Custom String("Pemain itu keburu hilang. Pilih bintang lain."));
				End;
			End;
		Else If(Event Player.HalamanMenu == 2);
			Event Player.IndeksWarna = Event Player.KursorWarna;
			Event Player.WarnaNama = Global.DaftarWarna[Event Player.IndeksWarna];
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
				"Your name is now {0}. Subtlety took the day off.", Global.NamaWarnaEN[Event Player.IndeksWarna]) : Custom String(
				"Warna namamu sekarang {0}. Kalem? Tidak kenal.", Global.NamaWarna[Event Player.IndeksWarna]));
		Else;
			Event Player.IndeksBahasa = Event Player.KursorBahasa;
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
				"HUD language set to English. The lobby speaks fluent vibes now.") : Custom String(
				"Bahasa HUD diubah ke Bahasa Indonesia. Lobi ini sekarang fasih nongkrong."));
			Call Subroutine(GambarMenu);
		End;
		Wait Until(Is Button Held(Event Player, Button(Interact)) == False, 99999);
	}
}

rule("11 - Menu: Isi ulang menutup menu dari halaman mana pun")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.MenuTerbuka == True;
		Is Button Held(Event Player, Button(Reload)) == True;
	}

	actions
	{
		Event Player.MeleeDipakai = True;
		Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Menu closed with Reload. Quick and tidy.") : Custom String(
			"Menu ditutup lewat Isi Ulang. Cepat dan rapi."));
		Call Subroutine(TutupMenu);
		Wait Until(Is Button Held(Event Player, Button(Reload)) == False, 99999);
	}
}

rule("12 - Menu: Kematian juga menutup warung")
{
	event
	{
		Player Died;
		All;
		All;
	}

	conditions
	{
		Event Player.MenuTerbuka == True;
	}

	actions
	{
		Call Subroutine(TutupMenu);
	}
}

rule("13 - Intip Pahlawan: Tempel nama, ikon, dan panah pada sasaran")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Is Alive(Event Player) == True;
		Event Player.MenuTerbuka == False;
		Event Player.ModeKamera != 2;
		Event Player.InspeksiAktif == False;
		Is Button Held(Event Player, Button(Crouch)) == True;
	}

	actions
	{
		Event Player.InspeksiAktif = True;
		Event Player.TargetInspeksi = Ray Cast Hit Player(Eye Position(Event Player), Eye Position(Event Player) + Facing Direction Of(
			Event Player) * Global.JarakBidik, All Players(All Teams), Event Player, False);
		"Bukan HUD: viewer selalu tetap aktif; string kosong hanya menyembunyikan penanda saat bidikan kosong."
		Create In-World Text(Event Player, Event Player.TargetInspeksi == Null ? Custom String("") : Custom String("{0}\n{1}  {2}",
			Icon String(Arrow: Down), Custom String("{0}", Event Player.TargetInspeksi), Hero Icon String(Is Duplicating(
			Event Player.TargetInspeksi) ? Hero Being Duplicated(Event Player.TargetInspeksi) : Hero Of(Event Player.TargetInspeksi))),
			Event Player.TargetInspeksi == Null ? Event Player : Event Player.TargetInspeksi, 1.500, Clip Against Surfaces,
			Visible To Position String and Color, Event Player.TargetInspeksi == Null ? Color(White) : Player Variable(
			Event Player.TargetInspeksi, Manusia) == True ? Player Variable(Event Player.TargetInspeksi, WarnaNama) : Color(Orange),
			Default Visibility);
		Event Player.TeksDunia = Last Text ID;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.TeksDuniaPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = Event Player.TeksDunia;
		End;
	}
}

rule("14 - Intip Pahlawan: Perbarui garis pandang dengan sopan")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.InspeksiAktif == True;
		Is Alive(Event Player) == True;
		Event Player.MenuTerbuka == False;
		Is Button Held(Event Player, Button(Crouch)) == True;
	}

	actions
	{
		Event Player.TargetInspeksi = Ray Cast Hit Player(Eye Position(Event Player), Eye Position(Event Player) + Facing Direction Of(
			Event Player) * Global.JarakBidik, All Players(All Teams), Event Player, False);
		Wait(0.050, Abort When False);
		Loop If Condition Is True;
	}
}

rule("15 - Intip Pahlawan: Hapus tulisan saat berdiri atau buka menu")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.InspeksiAktif == True;
		Or(Or(Is Button Held(Event Player, Button(Crouch)) == False, Event Player.MenuTerbuka == True), Is Dead(Event Player)) == True;
	}

	actions
	{
		Destroy In-World Text(Event Player.TeksDunia);
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.TeksDuniaPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = 0;
		End;
		Event Player.TeksDunia = Null;
		Event Player.TargetInspeksi = Null;
		Event Player.InspeksiAktif = False;
	}
}

rule("16 - Kamera: Target pergi, pulangkan pandangan")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.ModeKamera == 2;
		Or(Event Player.TargetKamera == Null, Entity Exists(Event Player.TargetKamera) == False) == True;
	}

	actions
	{
		Stop Camera(Event Player);
		Event Player.ModeKamera = 0;
		Event Player.TargetKamera = Null;
		Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
			"Your camera target left. Returning to first person.") : Custom String(
			"Target kameramu keluar. Kembali ke orang pertama sebelum nyasar."));
	}
}

rule("90 - Subrutin: Tutup menu dan kembalikan semua tombol")
{
	event
	{
		Subroutine;
		TutupMenu;
	}

	actions
	{
		If(Event Player.HudMenu != Null);
			Destroy HUD Text(Event Player.HudMenu);
		End;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.HudMenuPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = 0;
		End;
		Event Player.HudMenu = Null;
		Event Player.MenuTerbuka = False;
		Event Player.HalamanMenu = -1;
		If(Is Button Held(Event Player, Button(Melee)) == False);
			Allow Button(Event Player, Button(Melee));
		End;
		Allow Button(Event Player, Button(Jump));
		Allow Button(Event Player, Button(Crouch));
		Allow Button(Event Player, Button(Primary Fire));
		Allow Button(Event Player, Button(Secondary Fire));
		Allow Button(Event Player, Button(Interact));
		Allow Button(Event Player, Button(Reload));
		Allow Button(Event Player, Button(Ability 1));
		Allow Button(Event Player, Button(Ability 2));
		Allow Button(Event Player, Button(Ultimate));
	}
}

rule("91 - Subrutin: Gambar menu tanpa judul, biar lega")
{
	event
	{
		Subroutine;
		GambarMenu;
	}

	actions
	{
		If(Event Player.HudMenu != Null);
			Destroy HUD Text(Event Player.HudMenu);
		End;
		Event Player.HudMenu = Null;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.HudMenuPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = 0;
		End;
		If(Event Player.HalamanMenu == -1);
			Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String(
				"{0}: previous  |  {1}: next", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))),
				Custom String("{0}\n{1}", Custom String("{0}: open  |  {1}: close", Input Binding String(Button(Interact)), Input Binding String(
				Button(Reload))), Custom String("Hold {0} 1.5 sec: close", Input Binding String(Button(Melee))))) : Custom String("{0}\n{1}",
				Custom String("{0}: sebelumnya  |  {1}: berikutnya", Input Binding String(Button(Primary Fire)), Input Binding String(Button(
				Secondary Fire))), Custom String("{0}\n{1}", Custom String("{0}: buka  |  {1}: tutup", Input Binding String(Button(Interact)),
				Input Binding String(Button(Reload))), Custom String("Tahan {0} 1,5 dtk: tutup", Input Binding String(Button(Melee))))),
				Event Player.IndeksBahasa == 0 ? Event Player.KursorUtama == 0 ? Custom String("0 - MUSIC GENRE\n\nCURRENT: {0}",
				Event Player.IndeksGenre >= 0 ? Global.DaftarGenre[Event Player.IndeksGenre] : Custom String("not picked yet")) : Event Player.KursorUtama
				== 1 ? Custom String("1 - THIRD-PERSON CAMERA\n\nCURRENT: {0}", Event Player.ModeKamera == 0 ? Custom String("off") :
				Event Player.ModeKamera == 1 ? Custom String("on yourself") : Custom String("watching {0}", Event Player.TargetKamera)) : Event Player.KursorUtama
				== 2 ? Custom String("2 - NAME COLOR\n\nCURRENT: {0}", Global.NamaWarnaEN[Event Player.IndeksWarna]) : Custom String(
				"3 - HUD LANGUAGE\n\nCURRENT: {0}", Global.NamaBahasa[Event Player.IndeksBahasa]) : Event Player.KursorUtama == 0 ? Custom String(
				"0 - GENRE MUSIK\n\nSAAT INI: {0}", Event Player.IndeksGenre >= 0 ? Global.DaftarGenre[Event Player.IndeksGenre] : Custom String(
				"belum pilih")) : Event Player.KursorUtama == 1 ? Custom String("1 - KAMERA ORANG KETIGA\n\nSAAT INI: {0}", Event Player.ModeKamera
				== 0 ? Custom String("mati") : Event Player.ModeKamera == 1 ? Custom String("diri sendiri") : Custom String("menonton {0}",
				Event Player.TargetKamera)) : Event Player.KursorUtama == 2 ? Custom String("2 - WARNA NAMA\n\nSAAT INI: {0}", Global.NamaWarna[
				Event Player.IndeksWarna]) : Custom String("3 - BAHASA HUD\n\nSAAT INI: {0}", Global.NamaBahasa[Event Player.IndeksBahasa]), Top,
				-200, Color(White), Color(Gray), Color(Orange), Visible To and String, Default Visibility);
		Else If(Event Player.HalamanMenu == 0);
			Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String("{0}\n{1}",
				Custom String("{0}: previous  |  {1}: next", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))),
				Custom String("{0}: back 10  |  {1}: forward 10", Input Binding String(Button(Jump)), Input Binding String(Button(Crouch)))),
				Custom String("{0}\n{1}", Custom String("{0}: apply  |  {1}: close", Input Binding String(Button(Interact)), Input Binding String(
				Button(Reload))), Custom String("Hold {0} 1.5 sec: close", Input Binding String(Button(Melee))))) : Custom String("{0}\n{1}",
				Custom String("{0}\n{1}", Custom String("{0}: sebelumnya  |  {1}: berikutnya", Input Binding String(Button(Primary Fire)), Input Binding String(
				Button(Secondary Fire))), Custom String("{0}: mundur 10  |  {1}: maju 10", Input Binding String(Button(Jump)), Input Binding String(
				Button(Crouch)))), Custom String("{0}\n{1}", Custom String("{0}: pakai  |  {1}: tutup", Input Binding String(Button(Interact)),
				Input Binding String(Button(Reload))), Custom String("Tahan {0} 1,5 dtk: tutup", Input Binding String(Button(Melee))))),
				Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String("0 - MUSIC GENRE  {0}/100",
				Event Player.KursorGenre + 1), Custom String("{0}\n\n> {1}", Global.NamaHalamanEN[Round To Integer(Event Player.KursorGenre / 10,
				Down)], Global.DaftarGenre[Event Player.KursorGenre])) : Custom String("{0}\n{1}", Custom String("0 - GENRE MUSIK  {0}/100",
				Event Player.KursorGenre + 1), Custom String("{0}\n\n> {1}", Global.NamaHalaman[Round To Integer(Event Player.KursorGenre / 10, Down)],
				Global.DaftarGenre[Event Player.KursorGenre])), Top, -200, Color(White), Color(Gray), Color(Aqua), Visible To and String,
				Default Visibility);
		Else If(Event Player.HalamanMenu == 1);
			Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String(
				"{0}: previous  |  {1}: next", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))),
				Custom String("{0}\n{1}", Custom String("{0}: apply  |  {1}: close", Input Binding String(Button(Interact)), Input Binding String(
				Button(Reload))), Custom String("Hold {0} 1.5 sec: close", Input Binding String(Button(Melee))))) : Custom String("{0}\n{1}",
				Custom String("{0}: sebelumnya  |  {1}: berikutnya", Input Binding String(Button(Primary Fire)), Input Binding String(Button(
				Secondary Fire))), Custom String("{0}\n{1}", Custom String("{0}: pakai  |  {1}: tutup", Input Binding String(Button(Interact)),
				Input Binding String(Button(Reload))), Custom String("Tahan {0} 1,5 dtk: tutup", Input Binding String(Button(Melee))))),
				Event Player.IndeksBahasa == 0 ? Custom String("1 - THIRD-PERSON CAMERA  {0}/{1}\n\n> {2}", Event Player.KursorKamera
				+ 1, Count Of(Event Player.DaftarTargetKamera) + 2, Event Player.KursorKamera == 0 ? Custom String("TURN CAMERA OFF") :
				Event Player.KursorKamera == 1 ? Custom String("ON YOURSELF") : Custom String("WATCH {0}  {1}", Event Player.DaftarTargetKamera[
				Event Player.KursorKamera - 2], Hero Icon String(Is Duplicating(Event Player.DaftarTargetKamera[Event Player.KursorKamera - 2])
				? Hero Being Duplicated(Event Player.DaftarTargetKamera[Event Player.KursorKamera - 2]) : Hero Of(Event Player.DaftarTargetKamera[
				Event Player.KursorKamera - 2])))) : Custom String("1 - KAMERA ORANG KETIGA  {0}/{1}\n\n> {2}", Event Player.KursorKamera
				+ 1, Count Of(Event Player.DaftarTargetKamera) + 2, Event Player.KursorKamera == 0 ? Custom String("MATIKAN KAMERA") :
				Event Player.KursorKamera == 1 ? Custom String("DIRI SENDIRI") : Custom String("TONTON {0}  {1}", Event Player.DaftarTargetKamera[
				Event Player.KursorKamera - 2], Hero Icon String(Is Duplicating(Event Player.DaftarTargetKamera[Event Player.KursorKamera - 2])
				? Hero Being Duplicated(Event Player.DaftarTargetKamera[Event Player.KursorKamera - 2]) : Hero Of(Event Player.DaftarTargetKamera[
				Event Player.KursorKamera - 2])))), Top, -200, Color(White), Color(Gray), Color(Sky Blue), Visible To and String,
				Default Visibility);
		Else If(Event Player.HalamanMenu == 2);
			Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String(
				"{0}: previous  |  {1}: next", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))),
				Custom String("{0}\n{1}", Custom String("{0}: apply  |  {1}: close", Input Binding String(Button(Interact)), Input Binding String(
				Button(Reload))), Custom String("Hold {0} 1.5 sec: close", Input Binding String(Button(Melee))))) : Custom String("{0}\n{1}",
				Custom String("{0}: sebelumnya  |  {1}: berikutnya", Input Binding String(Button(Primary Fire)), Input Binding String(Button(
				Secondary Fire))), Custom String("{0}\n{1}", Custom String("{0}: pakai  |  {1}: tutup", Input Binding String(Button(Interact)),
				Input Binding String(Button(Reload))), Custom String("Tahan {0} 1,5 dtk: tutup", Input Binding String(Button(Melee))))),
				Event Player.IndeksBahasa == 0 ? Custom String("2 - NAME COLOR  {0}/{1}\n\n> {2}", Event Player.KursorWarna + 1,
				Count Of(Global.DaftarWarna), Global.NamaWarnaEN[Event Player.KursorWarna]) : Custom String("2 - WARNA NAMA  {0}/{1}\n\n> {2}",
				Event Player.KursorWarna + 1, Count Of(Global.DaftarWarna), Global.NamaWarna[Event Player.KursorWarna]), Top, -200, Color(White),
				Color(Gray), Global.DaftarWarna[Event Player.KursorWarna], Visible To String and Color, Default Visibility);
		Else;
			Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String(
				"{0}: previous  |  {1}: next", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))),
				Custom String("{0}\n{1}", Custom String("{0}: apply  |  {1}: close", Input Binding String(Button(Interact)), Input Binding String(
				Button(Reload))), Custom String("Hold {0} 1.5 sec: close", Input Binding String(Button(Melee))))) : Custom String("{0}\n{1}",
				Custom String("{0}: sebelumnya  |  {1}: berikutnya", Input Binding String(Button(Primary Fire)), Input Binding String(Button(
				Secondary Fire))), Custom String("{0}\n{1}", Custom String("{0}: pakai  |  {1}: tutup", Input Binding String(Button(Interact)),
				Input Binding String(Button(Reload))), Custom String("Tahan {0} 1,5 dtk: tutup", Input Binding String(Button(Melee))))),
				Event Player.IndeksBahasa == 0 ? Custom String("3 - HUD LANGUAGE  {0}/2\n\n> {1}", Event Player.KursorBahasa + 1,
				Global.NamaBahasa[Event Player.KursorBahasa]) : Custom String("3 - BAHASA HUD  {0}/2\n\n> {1}", Event Player.KursorBahasa + 1,
				Global.NamaBahasa[Event Player.KursorBahasa]), Top, -200, Color(White), Color(Gray), Color(Violet), Visible To and String,
				Default Visibility);
		End;
		Event Player.HudMenu = Last Text ID;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.HudMenuPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = Event Player.HudMenu;
		End;
	}
}

rule("92 - Subrutin: Kunci bot agar cuma kaki yang sibuk")
{
	event
	{
		Subroutine;
		KunciBot;
	}

	actions
	{
		Set Primary Fire Enabled(Event Player, False);
		Set Secondary Fire Enabled(Event Player, False);
		Set Ability 1 Enabled(Event Player, False);
		Set Ability 2 Enabled(Event Player, False);
		Set Ultimate Ability Enabled(Event Player, False);
		Set Melee Enabled(Event Player, False);
		Disallow Button(Event Player, Button(Primary Fire));
		Disallow Button(Event Player, Button(Secondary Fire));
		Disallow Button(Event Player, Button(Ability 1));
		Disallow Button(Event Player, Button(Ability 2));
		Disallow Button(Event Player, Button(Ultimate));
		Disallow Button(Event Player, Button(Melee));
		Disallow Button(Event Player, Button(Reload));
		Disallow Button(Event Player, Button(Interact));
		Set Damage Dealt(Event Player, 0);
		Set Healing Dealt(Event Player, 0);
		Set Knockback Dealt(Event Player, 0);
	}
}

rule("93 - Subrutin: Mulai kamera orang ketiga yang tahu tembok")
{
	event
	{
		Subroutine;
		MulaiKamera;
	}

	actions
	{
		Abort If(Event Player.TargetKamera == Null);
		Stop Camera(Event Player);
		"Ray cast kamera berjalan di Update Every Frame; dinding tetap tidak boleh ditembus."
		Start Camera(Event Player, Update Every Frame(Ray Cast Hit Position(Eye Position(Event Player.TargetKamera) + Vector(0, 0.650, 0),
			Eye Position(Event Player.TargetKamera) + Vector(0, 0.650, 0) + World Vector Of(Vector(Global.GeserKamera, 0,
			0 - Global.JarakKamera), Event Player.TargetKamera, Rotation), Empty Array, Empty Array, False) + Direction Towards(Eye Position(
			Event Player.TargetKamera) + Vector(0, 0.650, 0) + World Vector Of(Vector(Global.GeserKamera, 0, 0 - Global.JarakKamera),
			Event Player.TargetKamera, Rotation), Eye Position(Event Player.TargetKamera) + Vector(0, 0.650, 0)) * Global.BantalanDinding),
			Update Every Frame(Eye Position(Event Player.TargetKamera) + Vector(0, 0.650, 0) + Facing Direction Of(Event Player.TargetKamera)
			* 20), 0);
	}
}

rule("94 - Subrutin: Siapkan pemain dari ujung rambut sampai variabel")
{
	event
	{
		Subroutine;
		SiapkanPemain;
	}

	actions
	{
		Event Player.WaktuMasuk = Total Time Elapsed;
		Event Player.WaktuTercatat = True;
		Event Player.SudahDiperiksa = False;
		Event Player.BotAI = False;
		Event Player.Manusia = False;
		Event Player.MenitLobby = 0;
		Event Player.IndeksGenre = -1;
		Event Player.UrutanHUD = -1;
		Event Player.HudKiri = Null;
		Event Player.HudKanan = Null;
		Event Player.MenuTerbuka = False;
		Event Player.KursorGenre = 0;
		Event Player.HudMenu = Null;
		Event Player.InspeksiAktif = False;
		Event Player.TargetInspeksi = Null;
		Event Player.TeksDunia = Null;
		Event Player.ModeKamera = 0;
		Event Player.TargetKamera = Null;
		Event Player.MeleeDipakai = False;
		Event Player.HalamanMenu = -1;
		Event Player.KursorUtama = 0;
		Event Player.KursorKamera = 0;
		Event Player.KursorWarna = 0;
		Event Player.IndeksWarna = 0;
		Event Player.WarnaNama = Color(White);
		Event Player.CalonTargetKamera = Null;
		Event Player.IndeksBahasa = 0;
		Event Player.KursorBahasa = 0;
		Event Player.DaftarTargetKamera = Empty Array;
		Event Player.SudahSiap = True;
	}
}

rule("95 - Subrutin: Segarkan daftar tontonan, termasuk para bot")
{
	event
	{
		Subroutine;
		SegarkanTargetKamera;
	}

	actions
	{
		If(And(Event Player.KursorKamera >= 2, Event Player.KursorKamera - 2 < Count Of(Event Player.DaftarTargetKamera)));
			Event Player.CalonTargetKamera = Event Player.DaftarTargetKamera[Event Player.KursorKamera - 2];
		Else;
			Event Player.CalonTargetKamera = Null;
		End;
		Event Player.DaftarTargetKamera = Filtered Array(All Players(All Teams), And(Current Array Element != Event Player, Has Spawned(
			Current Array Element)));
		If(And(Event Player.CalonTargetKamera != Null, Array Contains(Event Player.DaftarTargetKamera, Event Player.CalonTargetKamera)));
			Event Player.KursorKamera = Index Of Array Value(Event Player.DaftarTargetKamera, Event Player.CalonTargetKamera) + 2;
		Else If(Event Player.KursorKamera >= Count Of(Event Player.DaftarTargetKamera) + 2);
			Event Player.KursorKamera = 0;
		End;
	}
}
