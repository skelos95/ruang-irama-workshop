rule("91p - Subrutin: Hitung ulang pilihan dan pemimpin tunggal")
{
	event
	{
		Subroutine;
		HitungPilihan;
	}

	actions
	{
		Global.PemimpinSuara = Null;
		Global.SuaraTerbanyak = 0;
		Global.SuaraSeri = False;
		For Global Variable(IndeksVote, 0, Count Of(Global.PemainManusia), 1);
			Set Player Variable(Global.PemainManusia[Global.IndeksVote], JumlahSuara, Count Of(Filtered Array(Global.PemainManusia, Player Variable(Current Array Element, PemainDipilih) == Global.PemainManusia[Global.IndeksVote])));
			If(Global.PemainManusia[Global.IndeksVote].JumlahSuara > Global.SuaraTerbanyak);
				Global.SuaraTerbanyak = Global.PemainManusia[Global.IndeksVote].JumlahSuara;
				Global.PemimpinSuara = Global.PemainManusia[Global.IndeksVote];
				Global.SuaraSeri = False;
			Else If(And(Global.PemainManusia[Global.IndeksVote].JumlahSuara == Global.SuaraTerbanyak, Global.SuaraTerbanyak > 0));
				Global.SuaraSeri = True;
			End;
		End;
		If(Or(Global.SuaraTerbanyak <= 0, Global.SuaraSeri == True));
			Global.PemimpinSuara = Null;
		End;
	}
}

rule("93 - Subrutin: Mulai kamera dinamis di bahu kiri")
{
	event
	{
		Subroutine;
		MulaiKamera;
	}

	actions
	{
		Abort If(Event Player.TargetKamera == Null);
		Abort If(Entity Exists(Event Player.TargetKamera) == False);
		"Ganti kamera langsung tanpa Stop Camera agar perpindahan target tidak berkedip satu bingkai."
		Start Camera(Event Player, Update Every Frame(First Of(Mapped Array(Array(Ray Cast Hit Position(Eye Position(Event Player.TargetKamera)
			+ Vector(0, Min(0.750, Max(0.450, 0.450 + (Max Health(Event Player.TargetKamera) - 200) * 0.0006)), 0), Eye Position(
			Event Player.TargetKamera) + Vector(0, Min(0.750, Max(0.450, 0.450 + (Max Health(Event Player.TargetKamera) - 200) * 0.0006)), 0)
			- Facing Direction Of(Event Player.TargetKamera) * Min(4.500, Max(
			Global.JarakKamera, Global.JarakKamera + (Max Health(Event Player.TargetKamera) - 200) * 0.0055)) + Cross Product(Direction From Angles(
			Horizontal Facing Angle Of(Event Player.TargetKamera), 0), Vector(0, 1, 0)) * Min(1.350, Max(
			Global.GeserKamera, Global.GeserKamera + (Max Health(Event Player.TargetKamera) - 200) * 0.0016)), Empty Array, Empty Array, False)),
			Current Array Element + Direction Towards(Current Array Element, Eye Position(Event Player.TargetKamera) + Vector(0, Min(0.750, Max(
			0.450, 0.450 + (Max Health(Event Player.TargetKamera) - 200) * 0.0006)), 0)) * Min(Global.BantalanDinding, Distance Between(
			Current Array Element, Eye Position(Event Player.TargetKamera) + Vector(0, Min(0.750, Max(0.450, 0.450 + (Max Health(
			Event Player.TargetKamera) - 200) * 0.0006)), 0)) * 0.250)))), Update Every Frame(Eye Position(Event Player.TargetKamera)
			+ Facing Direction Of(Event Player.TargetKamera) * Global.JarakBidik), 0);
	}
}

rule("93a - Subrutin: Efek perubahan diterapkan")
{
	event
	{
		Subroutine;
		EfekTerapkan;
	}

	actions
	{
		Play Effect(All Players(All Teams), Ring Explosion, Global.RGB, Position Of(Event Player) + Vector(0, 1, 0), 3);
	}
}

rule("93b - Subrutin: Efek pengaturan dipulihkan")
{
	event
	{
		Subroutine;
		EfekPulihkan;
	}

	actions
	{
		Play Effect(All Players(All Teams), Ring Explosion, Global.RGB, Position Of(Event Player) + Vector(0, 1, 0), 3);
	}
}

rule("93c - Subrutin: Bersihkan pemain saat keluar atau pindah tim")
{
	event
	{
		Subroutine;
		BersihkanPemain;
	}

	actions
	{
		"Pulihkan keadaan runtime sebelum data roster dihapus; ini membuat pindah tim setara dengan keluar lalu masuk lagi."
		Stop Camera(Event Player);
		Allow Button(Event Player, Button(Melee));
		Allow Button(Event Player, Button(Jump));
		Allow Button(Event Player, Button(Crouch));
		Allow Button(Event Player, Button(Primary Fire));
		Allow Button(Event Player, Button(Secondary Fire));
		Allow Button(Event Player, Button(Interact));
		Allow Button(Event Player, Button(Reload));
		Allow Button(Event Player, Button(Ability 1));
		Allow Button(Event Player, Button(Ability 2));
		Allow Button(Event Player, Button(Ultimate));
		Set Primary Fire Enabled(Event Player, True);
		Set Secondary Fire Enabled(Event Player, True);
		Set Ability 1 Enabled(Event Player, True);
		Set Ability 2 Enabled(Event Player, True);
		Set Ultimate Ability Enabled(Event Player, True);
		Set Melee Enabled(Event Player, True);
		Set Damage Dealt(Event Player, 100);
		Set Healing Dealt(Event Player, 100);
		Set Knockback Dealt(Event Player, 100);
		Set Damage Received(Event Player, 100);
		Set Move Speed(Event Player, 100);
		Clear Status(Event Player, Unkillable);
		Stop Modifying Hero Voice Lines(Event Player);
		Enable Game Mode HUD(Event Player);
		Enable Game Mode In-World UI(Event Player);
		Event Player.PemainDipilih = Null;
		Event Player.JumlahSuara = 0;
		Event Player.SudahSiap = False;
		Event Player.SudahDiperiksa = False;
		Event Player.Manusia = False;

		If(Event Player.TeksKartuNasib != Null);
			Destroy In-World Text(Event Player.TeksKartuNasib);
		End;
		If(Event Player.TeksKartuNasibKanan != Null);
			Destroy In-World Text(Event Player.TeksKartuNasibKanan);
		End;
		If(Event Player.IkonKartuNasib != Null);
			Destroy Icon(Event Player.IkonKartuNasib);
		End;
		If(Event Player.IkonKartuNasibHijau != Null);
			Destroy Icon(Event Player.IkonKartuNasibHijau);
		End;
		Event Player.TeksKartuNasib = Null;
		Event Player.TeksKartuNasibKanan = Null;
		Event Player.IkonKartuNasib = Null;
		Event Player.IkonKartuNasibHijau = Null;
		Event Player.KartuNasibAktif = False;
		Event Player.KartuNasibMerah = False;
		Event Player.PutaranKartuNasib = 0;
		Event Player.JedaKartuNasib = 0;
		Global.PemainPembersihan = Event Player;
		Global.IndeksKeluar = Index Of Array Value(Global.PemainManusia, Event Player);
		If(Global.IndeksKeluar >= 0);
			If(Event Player.IkonKebal != Null);
				Destroy Icon(Event Player.IkonKebal);
				Event Player.IkonKebal = Null;
			End;
			If(Event Player.PelatNamaDinonaktifkan == True);
				Enable Nameplates(All Players(All Teams), Event Player);
			End;
			Destroy HUD Text(Global.HudKiriPemain[Global.IndeksKeluar]);
			Destroy HUD Text(Global.HudKananPemain[Global.IndeksKeluar]);
			If(Global.HudMenuPemain[Global.IndeksKeluar] != 0);
				Destroy HUD Text(Global.HudMenuPemain[Global.IndeksKeluar]);
			End;
			If(Global.TeksDuniaPemain[Global.IndeksKeluar] != 0);
				Destroy In-World Text(Global.TeksDuniaPemain[Global.IndeksKeluar]);
			End;
			If(Global.TeksDiriPemain[Global.IndeksKeluar] != 0);
				Destroy In-World Text(Global.TeksDiriPemain[Global.IndeksKeluar]);
			End;
			Global.SlotHUDTersedia = Sorted Array(Append To Array(Global.SlotHUDTersedia, Global.SlotHUDPemain[Global.IndeksKeluar]), Current Array Element);
			Modify Global Variable(HudKiriPemain, Remove From Array By Index, Global.IndeksKeluar);
			Modify Global Variable(HudKananPemain, Remove From Array By Index, Global.IndeksKeluar);
			Modify Global Variable(HudMenuPemain, Remove From Array By Index, Global.IndeksKeluar);
			Modify Global Variable(TeksDuniaPemain, Remove From Array By Index, Global.IndeksKeluar);
			Modify Global Variable(TeksDiriPemain, Remove From Array By Index, Global.IndeksKeluar);
			Modify Global Variable(SlotHUDPemain, Remove From Array By Index, Global.IndeksKeluar);
			Modify Global Variable(PemainManusia, Remove From Array By Index, Global.IndeksKeluar);
			Global.SlotHUDTerakhir = Count Of(Global.SlotHUDPemain) == 0 ? -1 : Last Of(Sorted Array(Global.SlotHUDPemain, Current Array Element));
		End;
		For Global Variable(IndeksVote, 0, Count Of(Global.PemainManusia), 1);
			If(Global.PemainManusia[Global.IndeksVote].PemainDipilih == Global.PemainPembersihan);
				Set Player Variable(Global.PemainManusia[Global.IndeksVote], PemainDipilih, Null);
			End;
			Set Player Variable(Global.PemainManusia[Global.IndeksVote], KursorPilihan, Count Of(Global.PemainManusia) == 0 ? 0 : Min(Player Variable(Global.PemainManusia[Global.IndeksVote], KursorPilihan), Count Of(Global.PemainManusia) - 1));
		End;
		Call Subroutine(HitungPilihan);
		"Bersihkan semua referensi pemain yang keluar dari utang balas dendam milik pemain yang masih ada."
		For Global Variable(IndeksPembersihan, 0, Count Of(Global.PemainManusia), 1);
			Global.IndeksUtangKeluar = Index Of Array Value(Global.PemainManusia[Global.IndeksPembersihan].PembunuhBalasDendam,
				Global.PemainPembersihan);
			If(Global.IndeksUtangKeluar >= 0);
				Modify Player Variable(Global.PemainManusia[Global.IndeksPembersihan], PembunuhBalasDendam, Remove From Array By Index,
					Global.IndeksUtangKeluar);
				Modify Player Variable(Global.PemainManusia[Global.IndeksPembersihan], JumlahBalasDendam, Remove From Array By Index,
					Global.IndeksUtangKeluar);
			End;
			If(Global.PemainManusia[Global.IndeksPembersihan].TargetKamera == Global.PemainPembersihan);
				Stop Camera(Global.PemainManusia[Global.IndeksPembersihan]);
				Set Player Variable(Global.PemainManusia[Global.IndeksPembersihan], ModeKamera, 0);
				Set Player Variable(Global.PemainManusia[Global.IndeksPembersihan], TargetKamera, Null);
			End;
			If(Global.PemainManusia[Global.IndeksPembersihan].TargetInspeksi == Global.PemainPembersihan);
				Set Player Variable(Global.PemainManusia[Global.IndeksPembersihan], TargetInspeksi, Null);
			End;
			Set Player Variable(Global.PemainManusia[Global.IndeksPembersihan], DaftarTargetKamera, Filtered Array(Player Variable(
				Global.PemainManusia[Global.IndeksPembersihan], DaftarTargetKamera), Current Array Element != Global.PemainPembersihan));
			Set Player Variable(Global.PemainManusia[Global.IndeksPembersihan], DaftarTargetBalasDendam, Filtered Array(Player Variable(
				Global.PemainManusia[Global.IndeksPembersihan], DaftarTargetBalasDendam), Current Array Element != Global.PemainPembersihan));
			Set Player Variable(Global.PemainManusia[Global.IndeksPembersihan], DaftarTargetTeleportasi, Filtered Array(Player Variable(
				Global.PemainManusia[Global.IndeksPembersihan], DaftarTargetTeleportasi), Current Array Element != Global.PemainPembersihan));
			Set Player Variable(Global.PemainManusia[Global.IndeksPembersihan], DaftarTargetInspeksi, Filtered Array(Player Variable(
				Global.PemainManusia[Global.IndeksPembersihan], DaftarTargetInspeksi), Current Array Element != Global.PemainPembersihan));
			Set Player Variable(Global.PemainManusia[Global.IndeksPembersihan], KursorKamera, Min(Player Variable(Global.PemainManusia[
				Global.IndeksPembersihan], KursorKamera), Count Of(Player Variable(Global.PemainManusia[Global.IndeksPembersihan],
				DaftarTargetKamera)) + 1));
			Set Player Variable(Global.PemainManusia[Global.IndeksPembersihan], KursorBalasDendam, Count Of(Player Variable(
				Global.PemainManusia[Global.IndeksPembersihan], DaftarTargetBalasDendam)) == 0 ? 0 : Player Variable(Global.PemainManusia[
				Global.IndeksPembersihan], KursorBalasDendam) % Count Of(Player Variable(Global.PemainManusia[Global.IndeksPembersihan],
				DaftarTargetBalasDendam)));
			Set Player Variable(Global.PemainManusia[Global.IndeksPembersihan], KursorTeleportasi, Count Of(Player Variable(
				Global.PemainManusia[Global.IndeksPembersihan], DaftarTargetTeleportasi)) == 0 ? 0 : Player Variable(Global.PemainManusia[
				Global.IndeksPembersihan], KursorTeleportasi) % Count Of(Player Variable(Global.PemainManusia[Global.IndeksPembersihan],
				DaftarTargetTeleportasi)));
			If(Global.PemainManusia[Global.IndeksPembersihan].CalonTargetKamera == Global.PemainPembersihan);
				Set Player Variable(Global.PemainManusia[Global.IndeksPembersihan], CalonTargetKamera, Null);
			End;
			If(Global.PemainManusia[Global.IndeksPembersihan].CalonTargetTeleportasi == Global.PemainPembersihan);
				Set Player Variable(Global.PemainManusia[Global.IndeksPembersihan], CalonTargetTeleportasi, Null);
			End;
			If(Global.PemainManusia[Global.IndeksPembersihan].TargetTeleportasiTerkunci == Global.PemainPembersihan);
				Set Player Variable(Global.PemainManusia[Global.IndeksPembersihan], TargetTeleportasiTerkunci, Null);
			End;
			If(Global.PemainManusia[Global.IndeksPembersihan].TargetBalasDendamDipilih == Global.PemainPembersihan);
				Set Player Variable(Global.PemainManusia[Global.IndeksPembersihan], TargetBalasDendamDipilih, Null);
			End;
			If(Global.PemainManusia[Global.IndeksPembersihan].TargetBalasDendamTerkunci == Global.PemainPembersihan);
				Set Player Variable(Global.PemainManusia[Global.IndeksPembersihan], TargetBalasDendamTerkunci, Null);
			End;
		End;
		Global.IndeksKeluar = -1;
		Global.PemainPembersihan = Null;

	}
}

rule("94 - Subrutin: Siapkan pemain dari ujung rambut sampai variabel")
{
	event
	{
		Subroutine;
		SiapkanPemain;
	}

	actions
	{
		Abort If(Is Dummy Bot(Event Player));
		Event Player.WaktuMasuk = Total Time Elapsed;
		Event Player.SudahDiperiksa = False;
		Event Player.BotOtomatis = False;
		Event Player.Manusia = False;
		Event Player.MenitLobi = 0;
		Event Player.IndeksGenre = -1;
		Event Player.UrutanHUD = -1;
		Event Player.HudKiri = Null;
		Event Player.HudKanan = Null;
		Event Player.MenuTerbuka = False;
		Event Player.KursorGenre = 0;
		Event Player.HudMenu = Null;
		Event Player.InspeksiAktif = False;
		Event Player.TargetInspeksi = Null;
		Event Player.TeksDunia = Null;
		Event Player.TeksDiri = Null;
		Event Player.ModeKamera = 0;
		Event Player.TargetKamera = Null;
		Event Player.SeranganDekatDipakai = False;
		Event Player.HalamanMenu = -1;
		Event Player.KursorUtama = 0;
		Event Player.KursorKamera = 0;
		Event Player.KursorWarna = 0;
		Event Player.IndeksWarna = 0;
		Event Player.WarnaNama = Color(White);
		Event Player.CalonTargetKamera = Null;
		Event Player.IndeksBahasa = 0;
		Event Player.KursorBahasa = 0;
		Event Player.DaftarTargetKamera = Empty Array;
		Event Player.SudahSiap = True;
		Event Player.KursorBalasDendam = 0;
		Event Player.DaftarTargetBalasDendam = Empty Array;
		Event Player.PembunuhBalasDendam = Empty Array;
		Event Player.JumlahBalasDendam = Empty Array;
		Event Player.IndeksBalasDendam = -1;
		Event Player.KematianBalasDendam = False;
		Event Player.KursorTeleportasi = 0;
		Event Player.DaftarTargetTeleportasi = Empty Array;
		Event Player.PosisiRuangMuncul = Vector(0, 0, 0);
		Event Player.PunyaPosisiMuncul = False;
		Event Player.CalonTargetTeleportasi = Null;
		Event Player.TargetBalasDendamTerkunci = Null;
		Event Player.TargetBalasDendamDipilih = Null;
		Event Player.PelatNamaDinonaktifkan = False;
		Event Player.KunciBotAktif = False;
		Event Player.PahlawanBotTerakhir = Null;
		Event Player.DaftarTargetInspeksi = Empty Array;
		Event Player.PerintahMenu = 0;
		Event Player.JenisTeleportasiTerkunci = -1;
		Event Player.TargetTeleportasiTerkunci = Null;
		Event Player.KebalAktif = False;
		Event Player.KursorKebal = 0;
		Event Player.IndeksSuara = 0;
		Event Player.KursorSuara = 0;
		Event Player.TeleportasiJongkokAktif = False;
		Event Player.PerintahTeleportasi = 0;
		Event Player.InteraksiKameraDipakai = False;
		Event Player.PosisiMati = Vector(0, 0, 0);
		Event Player.PosisiBangkitAman = Vector(0, 0, 0);
		Event Player.BangkitLompatDipakai = False;
		Event Player.IndeksIkon = 0;
		Event Player.KursorIkon = 0;
		Event Player.WarnaMenu = Vector(55, 235, 245);
		Event Player.TeleportasiJongkokDiaktifkan = False;
		Event Player.KursorTeleportasiJongkok = 0;
		Event Player.PrivasiInspeksiAktif = False;
		Event Player.KursorPrivasiInspeksi = 0;
		Event Player.ModeKebal = 0;
		Event Player.IkonKebal = Null;
		Event Player.KartuNasibAktif = False;
		Event Player.TeksKartuNasib = Null;
		Event Player.TeksKartuNasibKanan = Null;
		Event Player.IkonKartuNasib = Null;
		Event Player.IkonKartuNasibHijau = Null;
		Event Player.KursorPilihan = 0;
		Event Player.PemainDipilih = Null;
		Event Player.JumlahSuara = 0;
		Event Player.KartuNasibMerah = False;
		Event Player.PutaranKartuNasib = 0;
		Event Player.JedaKartuNasib = 0;
	}
}

rule("95 - Subrutin: Segarkan daftar tontonan, termasuk para bot")
{
	event
	{
		Subroutine;
		SegarkanTargetKamera;
	}

	actions
	{
		If(And(Event Player.KursorKamera >= 2, Event Player.KursorKamera - 2 < Count Of(Event Player.DaftarTargetKamera)));
			Event Player.CalonTargetKamera = Event Player.DaftarTargetKamera[Event Player.KursorKamera - 2];
		Else;
			Event Player.CalonTargetKamera = Null;
		End;
		Event Player.DaftarTargetKamera = Filtered Array(All Players(All Teams), And(Current Array Element != Event Player, Has Spawned(
			Current Array Element)));
		If(And(Event Player.CalonTargetKamera != Null, Array Contains(Event Player.DaftarTargetKamera, Event Player.CalonTargetKamera)));
			Event Player.KursorKamera = Index Of Array Value(Event Player.DaftarTargetKamera, Event Player.CalonTargetKamera) + 2;
		Else If(Event Player.KursorKamera >= Count Of(Event Player.DaftarTargetKamera) + 2);
			Event Player.KursorKamera = 0;
		End;
	}
}

rule("96 - Subrutin: Cari pemain terdekat dari bidikan")
{
	event
	{
		Subroutine;
		SegarkanTargetInspeksi;
	}

	actions
	{
		Event Player.DaftarTargetInspeksi = Filtered Array(All Players(All Teams), And(Current Array Element != Event Player, And(Entity Exists(
			Current Array Element), And(Has Spawned(Current Array Element), Is Alive(Current Array Element)))));
		If(Count Of(Event Player.DaftarTargetInspeksi) == 0);
			Event Player.TargetInspeksi = Null;
		Else;
			Event Player.TargetInspeksi = First Of(Sorted Array(Event Player.DaftarTargetInspeksi, Angle Between Vectors(Facing Direction Of(Event Player),
				Direction Towards(Eye Position(Event Player), Eye Position(Current Array Element)))));
		End;
	}
}

rule("97 - Subrutin: Segarkan daftar target balas dendam")
{
	event
	{
		Subroutine;
		SegarkanTargetBalasDendam;
	}

	actions
	{
		If(Event Player.KursorBalasDendam < Count Of(Event Player.DaftarTargetBalasDendam));
			Event Player.TargetBalasDendamDipilih = Event Player.DaftarTargetBalasDendam[Event Player.KursorBalasDendam];
		Else;
			Event Player.TargetBalasDendamDipilih = Null;
		End;
		Event Player.DaftarTargetBalasDendam = Filtered Array(Global.PemainManusia, Current Array Element != Event Player);
		If(Count Of(Event Player.DaftarTargetBalasDendam) == 0);
			Event Player.KursorBalasDendam = 0;
		Else If(And(Event Player.TargetBalasDendamDipilih != Null, Array Contains(Event Player.DaftarTargetBalasDendam,
			Event Player.TargetBalasDendamDipilih)));
			Event Player.KursorBalasDendam = Index Of Array Value(Event Player.DaftarTargetBalasDendam,
				Event Player.TargetBalasDendamDipilih);
		Else If(Event Player.KursorBalasDendam >= Count Of(Event Player.DaftarTargetBalasDendam));
			Event Player.KursorBalasDendam = 0;
		End;
	}
}

rule("98 - Subrutin: Segarkan ruang muncul, objektif, dan target teleportasi")
{
	event
	{
		Subroutine;
		SegarkanTargetTeleportasi;
	}

	actions
	{
		If(And(Event Player.KursorTeleportasi >= 0, Event Player.KursorTeleportasi < Count Of(Event Player.DaftarTargetTeleportasi)));
			Event Player.CalonTargetTeleportasi = Event Player.DaftarTargetTeleportasi[Event Player.KursorTeleportasi];
		Else;
			Event Player.CalonTargetTeleportasi = Null;
		End;
		"Indeks 0 adalah ruang muncul, indeks 1 adalah objektif, lalu semua manusia dan bot. Null hanya penanda objektif."
		Event Player.DaftarTargetTeleportasi = Append To Array(Array(Event Player, Null), Filtered Array(All Players(All Teams),
			And(Current Array Element != Event Player, Has Spawned(Current Array Element))));
		If(Event Player.KursorTeleportasi == 1);
			"Pertahankan objektif yang dipilih; penanda Null tidak perlu dicari di dalam array."
		Else If(And(Event Player.CalonTargetTeleportasi != Null, Array Contains(Event Player.DaftarTargetTeleportasi, Event Player.CalonTargetTeleportasi)));
			Event Player.KursorTeleportasi = Index Of Array Value(Event Player.DaftarTargetTeleportasi, Event Player.CalonTargetTeleportasi);
		Else If(Event Player.KursorTeleportasi >= Count Of(Event Player.DaftarTargetTeleportasi));
			Event Player.KursorTeleportasi = 0;
		End;
	}
}
