			Custom String("Psybient"),
			Custom String("Trip-Hop"),
			Custom String("Vaporwave"),
			Custom String("Lovers Rock"),
			Custom String("Roots Reggae"),
			Custom String("Dub"),
			Custom String("Soft Rock"),
			Custom String("Neo-Soul"),
			Custom String("Soul"),
			Custom String("Contemporary R&B"),
			Custom String("Acid Jazz"),
			Custom String("City Pop"),
			Custom String("Jazz-Funk"),
			Custom String("Funk"),
			Custom String("Indie Pop"),
			Custom String("Art Pop"),
			Custom String("Synthpop"),
			Custom String("Electropop"),
			Custom String("Tropical House"),
			Custom String("Deep House"),
			Custom String("Nu-Disco"),
			Custom String("Disco"),
			Custom String("French House"),
			Custom String("Progressive House"),
			Custom String("UK Garage"),
			Custom String("Eurodance"),
			Custom String("Electro House"),
			Custom String("Acid House"),
			Custom String("Detroit Techno"),
			Custom String("Tech House"),
			Custom String("Trance"),
			Custom String("Psytrance"),
			Custom String("Indie Rock"),
			Custom String("Britpop"),
			Custom String("Shoegaze"),
			Custom String("Alternative Rock"),
			Custom String("Garage Rock"),
			Custom String("Grunge"),
			Custom String("Pop Punk"),
			Custom String("Hard Rock"),
