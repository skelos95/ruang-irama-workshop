variables
{
	global:
		0: DaftarGenre
		1: NamaHalaman
		2: PemainManusia
		3: NomorUrut
		4: Siap
		5: HudJudulKiri
		6: HudJudulKanan
		7: HudPetunjuk
		8: JarakKamera
		9: GeserKamera
		10: BantalanDinding
		11: JarakBidik
		12: HudKiriPemain
		13: HudKananPemain
		14: HudMenuPemain
		15: HudInspeksiPemain
		16: IndeksKeluar

	player:
		0: WaktuMasuk
		1: WaktuTercatat
		2: SudahDiperiksa
		3: BotAI
		4: Manusia
		5: MenitLobby
		6: IndeksGenre
		7: UrutanHUD
		8: HudKiri
		9: HudKanan
		10: MenuTerbuka
		11: KursorGenre
		12: HudMenu
		13: InspeksiAktif
		14: TargetInspeksi
		15: HudInspeksi
		16: ModeKamera
		17: TargetKamera
		18: MeleeDipakai
}

subroutines
{
	0: TutupMenu
	1: MulaiKamera
}

rule("00 - Global: Siapkan 100 genre, dari rebahan sampai kiamat")
{
	event
	{
		Ongoing - Global;
	}

	conditions
	{
		Global.Siap == False;
	}

	actions
	{
		"Urutan ini sengaja bergerak dari paling tenang ke paling kacau. Jangan diacak tanpa alasan yang sangat musikal."
		Global.DaftarGenre = Array(
			Custom String("Lowercase"),
			Custom String("Nature Ambient"),
			Custom String("Meditation Ambient"),
			Custom String("Drone Ambient"),
			Custom String("Space Ambient"),
			Custom String("Minimal Ambient"),
			Custom String("Ambient Piano"),
			Custom String("New Age"),
			Custom String("Neoclassical Ambient"),
			Custom String("Ethereal Ambient"),
			Custom String("Solo Piano"),
			Custom String("Classical Guitar"),
			Custom String("Chamber Music"),
			Custom String("Neoclassical"),
			Custom String("Acoustic Folk"),
			Custom String("Indie Folk"),
			Custom String("Easy Listening"),
			Custom String("Bossa Nova"),
			Custom String("Smooth Jazz"),
			Custom String("Cool Jazz"),
			Custom String("Lounge"),
			Custom String("Downtempo"),
