			: Event Player.IndeksBahasa == 1 ? Custom String("{0}\n{1}", Custom String("\nTahan JONGKOK + perintah\n{0}: berikutnya | {1}: sebelumnya", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: pakai | {1}: kembali", Input Binding String(Button(Interact)), Input Binding String(Button(Reload))))
			: Custom String("{0}\n{1}", Custom String("\nกด ย่อ + คำสั่ง\n{0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: ใช้ | {1}: กลับ", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))),
			Event Player.IndeksBahasa == 0 ? Custom String("{0}\n> {1}", Custom String("9 - CROUCH PRIVACY {0}/2\nHIDE HUD FROM ENEMIES: {1}", Event Player.KursorPrivasiInspeksi + 1, Event Player.PrivasiInspeksiAktif ? Custom String("ON") : Custom String("OFF")), Event Player.KursorPrivasiInspeksi == 1 ? Custom String("ON") : Custom String("OFF"))
			: Event Player.IndeksBahasa == 1 ? Custom String("{0}\n> {1}", Custom String("9 - PRIVASI JONGKOK {0}/2\nSEMBUNYIKAN HUD DARI MUSUH: {1}", Event Player.KursorPrivasiInspeksi + 1, Event Player.PrivasiInspeksiAktif ? Custom String("AKTIF") : Custom String("MATI")), Event Player.KursorPrivasiInspeksi == 1 ? Custom String("AKTIF") : Custom String("MATI"))
			: Custom String("{0}\n> {1}", Custom String("9 - ความเป็นส่วนตัวตอนย่อ {0}/2\nซ่อน HUD จากศัตรู: {1}", Event Player.KursorPrivasiInspeksi + 1, Event Player.PrivasiInspeksiAktif ? Custom String("เปิด") : Custom String("ปิด")), Event Player.KursorPrivasiInspeksi == 1 ? Custom String("เปิด") : Custom String("ปิด")), Top, 100,
			Color(White), Custom Color(255, 220, 238, 255), Custom Color(X Component Of(Event Player.WarnaMenu), Y Component Of(Event Player.WarnaMenu), Z Component Of(Event Player.WarnaMenu), 255), Visible To String and Color, Visible Never);
		Event Player.HudMenu = Last Text ID;
	}
}


rule("91n - Subrutin: Gambar kartu nasib")
{
	event
	{
		Subroutine;
		GambarNasib;
	}

	actions
	{
		Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}", Custom String("\nHold CROUCH + command\n{0}: create | {1}: back", Input Binding String(Button(Interact)), Input Binding String(Button(Reload))), Custom String("Hold {0} 0.5 sec: close", Input Binding String(Button(Melee))))
			: Event Player.IndeksBahasa == 1 ? Custom String("{0}\n{1}", Custom String("\nTahan JONGKOK + perintah\n{0}: buat | {1}: kembali", Input Binding String(Button(Interact)), Input Binding String(Button(Reload))), Custom String("Tahan {0} 0,5 dtk: tutup", Input Binding String(Button(Melee))))
			: Custom String("{0}\n{1}", Custom String("\nกด ย่อ + คำสั่ง\n{0}: สร้าง | {1}: กลับ", Input Binding String(Button(Interact)), Input Binding String(Button(Reload))), Custom String("กด {0} ค้าง 0.5 วิ: ปิด", Input Binding String(Button(Melee)))),
			Event Player.IndeksBahasa == 0 ? Custom String("10 - TRY YOUR LUCK\nSTATUS: {0}\n> {1}", Event Player.KartuNasibAktif ? Event Player.PutaranKartuNasib > 0 ? Custom String("ROLLING") : Custom String("ACTIVE") : Custom String("READY"), Event Player.KartuNasibAktif ? Custom String("WATCH THE ROULETTE") : Custom String("START ROULETTE"))
			: Event Player.IndeksBahasa == 1 ? Custom String("10 - COBA NASIB\nSTATUS: {0}\n> {1}", Event Player.KartuNasibAktif ? Event Player.PutaranKartuNasib > 0 ? Custom String("BERPUTAR") : Custom String("AKTIF") : Custom String("SIAP"), Event Player.KartuNasibAktif ? Custom String("LIHAT ROULETTE") : Custom String("MULAI ROULETTE"))
			: Custom String("10 - เสี่ยงโชค\nสถานะ: {0}\n> {1}", Event Player.KartuNasibAktif ? Event Player.PutaranKartuNasib > 0 ? Custom String("กำลังสุ่ม") : Custom String("ทำงาน") : Custom String("พร้อม"), Event Player.KartuNasibAktif ? Custom String("ดูรูเล็ต") : Custom String("เริ่มรูเล็ต")), Top, 100,
			Color(White), Custom Color(255, 240, 190, 255), Custom Color(X Component Of(Event Player.WarnaMenu), Y Component Of(Event Player.WarnaMenu), Z Component Of(Event Player.WarnaMenu), 255), Visible To String and Color, Visible Never);
		Event Player.HudMenu = Last Text ID;
	}
}

rule("91p - Subrutin: Gambar halaman aktif")
{
	event
	{
		Subroutine;
		GambarHalamanAktif;
	}

	actions
	{
		If(Event Player.HalamanMenu == -1);
			Call Subroutine(GambarUtama);
		Else If(Event Player.HalamanMenu == 0);
			Call Subroutine(GambarMusik);
		Else If(Event Player.HalamanMenu == 1);
			Call Subroutine(GambarKamera);
		Else If(Event Player.HalamanMenu == 2);
			Call Subroutine(GambarWarna);
		Else If(Event Player.HalamanMenu == 3);
			Call Subroutine(GambarBahasa);
		Else If(Event Player.HalamanMenu == 4);
			Call Subroutine(GambarBalasDendam);
		Else If(Event Player.HalamanMenu == 5);
			Call Subroutine(GambarKebal);
		Else If(Event Player.HalamanMenu == 6);
			Call Subroutine(GambarSuara);
		Else If(Event Player.HalamanMenu == 7);
			Call Subroutine(GambarIkon);
		Else If(Event Player.HalamanMenu == 8);
			Call Subroutine(GambarSakelarTeleportasi);
		Else If(Event Player.HalamanMenu == 9);
			Call Subroutine(GambarPrivasiInspeksi);
		Else If(Event Player.HalamanMenu == 10);
			Call Subroutine(GambarNasib);
		Else If(Event Player.HalamanMenu == 11);
			Call Subroutine(GambarPilihan);
		End;
	}
}

rule("91k - Subrutin: Transisi warna menu tanpa lompatan")
{
	event
	{
		Subroutine;
		TransisiWarnaMenu;
	}

	actions
	{
		"Setiap menu memiliki warna identitas sendiri. Hanya Warna Nama mengikuti warna yang sedang dipilih; semuanya berubah secara bertahap."
		Chase Player Variable Over Time(Event Player, WarnaMenu,
			(Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 0 ? Vector(55, 235, 245)
			: (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 1 ? Vector(70, 135, 255)
			: (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 2 ? Global.DaftarWarnaRGB[Event Player.KursorWarna]
			: (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 3 ? Vector(185, 105, 255)
			: (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 4 ? Vector(255, 75, 85)
			: (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 5 ? Vector(255, 145, 55)
			: (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 6 ? Vector(255, 80, 205)
			: (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 7 ? Vector(170, 240, 85)
			: (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 8 ? Vector(65, 225, 130)
			: (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 9 ? Vector(55, 190, 170)
			: (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 10 ? Vector(255, 210, 70)
			: (Event Player.HalamanMenu == -1 ? Event Player.KursorUtama : Event Player.HalamanMenu) == 11 ? Vector(255, 120, 155)
			: Vector(55, 235, 245), 0.180, Destination and Duration);
	}
}

rule("92 - Subrutin: Kunci bot/dummy, kaki tetap bisa bergerak")
{
	event
	{
		Subroutine;
		KunciBot;
	}

	actions
	{
		Abort If(Entity Exists(Event Player) == False);
		Abort If(Is Alive(Event Player) == False);
		Event Player.MenuTerbuka = False;
		Event Player.SeranganDekatDipakai = False;
		Event Player.HalamanMenu = -1;
		Set Primary Fire Enabled(Event Player, False);
		Set Secondary Fire Enabled(Event Player, False);
		Set Ability 1 Enabled(Event Player, False);
		Set Ability 2 Enabled(Event Player, False);
		Set Ultimate Ability Enabled(Event Player, False);
		Set Melee Enabled(Event Player, False);
		Disallow Button(Event Player, Button(Primary Fire));
		Disallow Button(Event Player, Button(Secondary Fire));
		Disallow Button(Event Player, Button(Ability 1));
		Disallow Button(Event Player, Button(Ability 2));
		Disallow Button(Event Player, Button(Ultimate));
		Disallow Button(Event Player, Button(Melee));
		Disallow Button(Event Player, Button(Reload));
		Disallow Button(Event Player, Button(Interact));
		Set Damage Dealt(Event Player, 0);
		Set Healing Dealt(Event Player, 0);
		Set Knockback Dealt(Event Player, 0);
		Set Move Speed(Event Player, 10);
		Event Player.PahlawanBotTerakhir = Hero Of(Event Player);
		Event Player.KunciBotAktif = True;
		Disable Nameplates(Event Player, Filtered Array(Global.PemainManusia, Player Variable(Current Array Element, InspeksiAktif) == True));
	}
}

