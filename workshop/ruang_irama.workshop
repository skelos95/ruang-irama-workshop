			Custom String("Putih Bersih"),
			Custom String("Kuning Ceria"),
			Custom String("Hijau Limau"),
			Custom String("Hijau Segar"),
			Custom String("Toska Santai"),
			Custom String("Aqua Adem"),
			Custom String("Biru Langit"),
			Custom String("Jingga Hangat"),
			Custom String("Merah Mawar"),
			Custom String("Ungu Neon")
		);
