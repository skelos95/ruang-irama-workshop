		Event Player.HudMenu = Last Text ID;
	}
}

rule("91g - Subrutin: Gambar menu teleportasi")
{
	event
	{
		Subroutine;
		GambarTeleportasi;
	}

	actions
	{
		Call Subroutine(SegarkanTargetTeleportasi);
		Event Player.KursorTeleportasi %= Count Of(Event Player.DaftarTargetTeleportasi);
		Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}",
			Custom String("\n{0}: next | {1}: previous", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))),
			Custom String("{0}\n{1}", Custom String("{0}: teleport | {1}: back", Input Binding String(Button(Interact)), Input Binding String(Button(Reload))),
			Custom String("Hold {0} 0.5 sec: close", Input Binding String(Button(Melee))))) : Event Player.IndeksBahasa == 1 ? Custom String("{0}\n{1}",
			Custom String("\n{0}: berikutnya | {1}: sebelumnya", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))),
			Custom String("{0}\n{1}", Custom String("{0}: teleport | {1}: kembali", Input Binding String(Button(Interact)), Input Binding String(Button(Reload))),
			Custom String("Tahan {0} 0,5 dtk: tutup", Input Binding String(Button(Melee))))) : Custom String("{0}\n{1}", Custom String(
			"\n{0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}\n{1}",
			Custom String("{0}: เทเลพอร์ต | {1}: กลับ", Input Binding String(Button(Interact)), Input Binding String(Button(Reload))), Custom String(
			"กด {0} ค้าง 0.5 วินาที: ปิด", Input Binding String(Button(Melee))))), Event Player.IndeksBahasa == 0
			? Event Player.KursorTeleportasi == 0 ? Custom String("{0}\n> SPAWN ROOM\n{1}",
				Custom String("5 - TELEPORT {0}/{1}", Event Player.KursorTeleportasi + 1, Count Of(Event Player.DaftarTargetTeleportasi)),
				Is In Spawn Room(Event Player) ? Custom String("YOU ARE ALREADY HERE") : Event Player.PunyaPosisiMuncul ? Custom String("READY FOR TACTICAL RETREAT")
				: Custom String("VISIT SPAWN TO REGISTER IT")) : Event Player.KursorTeleportasi == 1 ? Custom String("{0}\n> CURRENT OBJECTIVE\n{1}",
				Custom String("5 - TELEPORT {0}/{1}", Event Player.KursorTeleportasi + 1, Count Of(Event Player.DaftarTargetTeleportasi)),
				Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) <= 0.100 ? Custom String("UNAVAILABLE IN THIS MODE")
				: Custom String("READY - NEAREST WALKABLE POSITION")) : Custom String("5 - TELEPORT {0}/{1}\n> {2}", Event Player.KursorTeleportasi + 1,
				Count Of(Event Player.DaftarTargetTeleportasi), Event Player.DaftarTargetTeleportasi[Event Player.KursorTeleportasi])
			: Event Player.IndeksBahasa == 1 ? Event Player.KursorTeleportasi == 0 ? Custom String("{0}\n> RUANG MUNCUL\n{1}",
				Custom String("5 - TELEPORT {0}/{1}", Event Player.KursorTeleportasi + 1, Count Of(Event Player.DaftarTargetTeleportasi)),
				Is In Spawn Room(Event Player) ? Custom String("KAMU SUDAH DI SINI") : Event Player.PunyaPosisiMuncul ? Custom String("SIAP UNTUK MUNDUR TAKTIS")
				: Custom String("MASUK KE RUANG MUNCUL UNTUK MENYIMPANNYA")) : Event Player.KursorTeleportasi == 1 ? Custom String("{0}\n> OBJEKTIF SAAT INI\n{1}",
				Custom String("5 - TELEPORT {0}/{1}", Event Player.KursorTeleportasi + 1, Count Of(Event Player.DaftarTargetTeleportasi)),
				Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) <= 0.100 ? Custom String("TIDAK TERSEDIA DI MODE INI")
				: Custom String("SIAP - POSISI TERDEKAT YANG BISA DILALUI")) : Custom String("5 - TELEPORT {0}/{1}\n> {2}", Event Player.KursorTeleportasi + 1,
				Count Of(Event Player.DaftarTargetTeleportasi), Event Player.DaftarTargetTeleportasi[Event Player.KursorTeleportasi])
			: Event Player.KursorTeleportasi == 0 ? Custom String("{0}\n> ห้องเกิด\n{1}", Custom String("5 - เทเลพอร์ต {0}/{1}",
				Event Player.KursorTeleportasi + 1, Count Of(Event Player.DaftarTargetTeleportasi)), Is In Spawn Room(Event Player) ? Custom String(
				"คุณอยู่ที่นี่แล้ว") : Event Player.PunyaPosisiMuncul ? Custom String("พร้อมถอยอย่างมีกลยุทธ์") : Custom String(
				"ไปห้องเกิดเพื่อบันทึกตำแหน่ง")) : Event Player.KursorTeleportasi == 1 ? Custom String("{0}\n> เป้าหมายปัจจุบัน\n{1}",
				Custom String("5 - เทเลพอร์ต {0}/{1}", Event Player.KursorTeleportasi + 1, Count Of(Event Player.DaftarTargetTeleportasi)),
				Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) <= 0.100 ? Custom String("ใช้ไม่ได้ในโหมดนี้")
				: Custom String("พร้อม - ตำแหน่งที่เดินถึงใกล้ที่สุด")) : Custom String("5 - เทเลพอร์ต {0}/{1}\n> {2}",
				Event Player.KursorTeleportasi + 1, Count Of(Event Player.DaftarTargetTeleportasi), Event Player.DaftarTargetTeleportasi[
				Event Player.KursorTeleportasi]), Top, 100,
			Color(White), Custom Color(205, 255, 225, 255), Custom Color(80, 255, 160, 255), Visible To and String, Visible Never);
		Event Player.HudMenu = Last Text ID;
	}
}

rule("92 - Subrutin: Kunci bot, kaki tetap bisa bergerak")
{
	event
	{
		Subroutine;
		KunciBot;
	}

	actions
	{
		Abort If(Entity Exists(Event Player) == False);
		Abort If(Is Alive(Event Player) == False);
		Event Player.MenuTerbuka = False;
		Event Player.SeranganDekatDipakai = False;
		Event Player.HalamanMenu = -1;
		Set Primary Fire Enabled(Event Player, False);
		Set Secondary Fire Enabled(Event Player, False);
		Set Ability 1 Enabled(Event Player, False);
		Set Ability 2 Enabled(Event Player, False);
		Set Ultimate Ability Enabled(Event Player, False);
		Set Melee Enabled(Event Player, False);
		Disallow Button(Event Player, Button(Primary Fire));
		Disallow Button(Event Player, Button(Secondary Fire));
		Disallow Button(Event Player, Button(Ability 1));
		Disallow Button(Event Player, Button(Ability 2));
		Disallow Button(Event Player, Button(Ultimate));
		Disallow Button(Event Player, Button(Melee));
		Disallow Button(Event Player, Button(Reload));
		Disallow Button(Event Player, Button(Interact));
		Set Damage Dealt(Event Player, 0);
		Set Healing Dealt(Event Player, 0);
		Set Knockback Dealt(Event Player, 0);
		Event Player.PahlawanBotTerakhir = Hero Of(Event Player);
		Event Player.KunciBotAktif = True;
		Start Forcing Player Outlines(Event Player, Filtered Array(Global.PemainManusia, Player Variable(Current Array Element,
			InspeksiAktif) == True), True, Color(Orange), Always);
	}
}

rule("93 - Subrutin: Mulai kamera dinamis di bahu kiri")
{
	event
	{
		Subroutine;
		MulaiKamera;
	}

	actions
	{
		Abort If(Event Player.TargetKamera == Null);
		Abort If(Entity Exists(Event Player.TargetKamera) == False);
		Stop Camera(Event Player);
		"Satu ekspresi visual memakai satu waktu client: tanpa cache posisi server yang dapat membuat model bergetar."
		Start Camera(Event Player, Update Every Frame(First Of(Mapped Array(Array(Ray Cast Hit Position(Eye Position(Event Player.TargetKamera)
			+ Vector(0, Min(0.750, Max(0.450, 0.450 + (Max Health(Event Player.TargetKamera) - 200) * 0.0006)), 0), Eye Position(
			Event Player.TargetKamera) + Vector(0, Min(0.750, Max(0.450, 0.450 + (Max Health(Event Player.TargetKamera) - 200) * 0.0006)), 0)
			- Direction From Angles(Horizontal Angle From Direction(Facing Direction Of(Event Player.TargetKamera)), 0) * Min(4.500, Max(
			Global.JarakKamera, Global.JarakKamera + (Max Health(Event Player.TargetKamera) - 200) * 0.0055)) + Cross Product(Direction From Angles(
			Horizontal Angle From Direction(Facing Direction Of(Event Player.TargetKamera)), 0), Vector(0, 1, 0)) * Min(1.350, Max(
			Global.GeserKamera, Global.GeserKamera + (Max Health(Event Player.TargetKamera) - 200) * 0.0016)), Empty Array, Empty Array, False)),
			Current Array Element + Direction Towards(Current Array Element, Eye Position(Event Player.TargetKamera) + Vector(0, Min(0.750, Max(
			0.450, 0.450 + (Max Health(Event Player.TargetKamera) - 200) * 0.0006)), 0)) * Min(Global.BantalanDinding, Distance Between(
			Current Array Element, Eye Position(Event Player.TargetKamera) + Vector(0, Min(0.750, Max(0.450, 0.450 + (Max Health(
			Event Player.TargetKamera) - 200) * 0.0006)), 0)) * 0.250)))), Update Every Frame(Eye Position(Event Player.TargetKamera)
			+ Facing Direction Of(Event Player.TargetKamera) * Global.JarakBidik), 0);
	}
}

rule("94 - Subrutin: Siapkan pemain dari ujung rambut sampai variabel")
{
	event
	{
		Subroutine;
		SiapkanPemain;
	}

	actions
	{
		Abort If(Is Dummy Bot(Event Player));
		Event Player.WaktuMasuk = Total Time Elapsed;
		Event Player.WaktuTercatat = True;
		Event Player.SudahDiperiksa = False;
		Event Player.BotAI = False;
		Event Player.Manusia = False;
		Event Player.MenitLobby = 0;
		Event Player.IndeksGenre = -1;
		Event Player.UrutanHUD = -1;
		Event Player.HudKiri = Null;
		Event Player.HudKanan = Null;
		Event Player.MenuTerbuka = False;
		Event Player.KursorGenre = 0;
		Event Player.HudMenu = Null;
		Event Player.InspeksiAktif = False;
		Event Player.TargetInspeksi = Null;
		Event Player.TeksDunia = Null;
		Event Player.TeksDiri = Null;
		Event Player.ModeKamera = 0;
		Event Player.TargetKamera = Null;
		Event Player.SeranganDekatDipakai = False;
		Event Player.HalamanMenu = -1;
		Event Player.KursorUtama = 0;
		Event Player.KursorKamera = 0;
		Event Player.KursorWarna = 0;
		Event Player.IndeksWarna = 0;
		Event Player.WarnaNama = Color(White);
		Event Player.CalonTargetKamera = Null;
		Event Player.IndeksBahasa = 0;
		Event Player.KursorBahasa = 0;
		Event Player.DaftarTargetKamera = Empty Array;
		Event Player.SudahSiap = True;
		Event Player.KursorBalasDendam = 0;
		Event Player.DaftarTargetBalasDendam = Empty Array;
		Event Player.PembunuhBalasDendam = Empty Array;
		Event Player.JumlahBalasDendam = Empty Array;
		Event Player.IndeksBalasDendam = -1;
		Event Player.KematianBalasDendam = False;
		Event Player.KursorTeleportasi = 0;
		Event Player.DaftarTargetTeleportasi = Empty Array;
		Event Player.PosisiRuangMuncul = Vector(0, 0, 0);
		Event Player.PunyaPosisiMuncul = False;
		Event Player.CalonTargetTeleportasi = Null;
		Event Player.TargetBalasDendamTerkunci = Null;
		Event Player.TargetBalasDendamDipilih = Null;
		Event Player.PelatNamaDinonaktifkan = False;
		Event Player.KunciBotAktif = False;
		Event Player.PahlawanBotTerakhir = Null;
		Event Player.IndeksGarisLuar = 0;
		Event Player.PerintahMenu = 0;
	}
}

rule("95 - Subrutin: Segarkan daftar tontonan, termasuk para bot")
{
	event
	{
		Subroutine;
		SegarkanTargetKamera;
	}

	actions
	{
		If(And(Event Player.KursorKamera >= 2, Event Player.KursorKamera - 2 < Count Of(Event Player.DaftarTargetKamera)));
			Event Player.CalonTargetKamera = Event Player.DaftarTargetKamera[Event Player.KursorKamera - 2];
		Else;
			Event Player.CalonTargetKamera = Null;
		End;
		Event Player.DaftarTargetKamera = Filtered Array(All Players(All Teams), And(Current Array Element != Event Player, Has Spawned(
			Current Array Element)));
		If(And(Event Player.CalonTargetKamera != Null, Array Contains(Event Player.DaftarTargetKamera, Event Player.CalonTargetKamera)));
			Event Player.KursorKamera = Index Of Array Value(Event Player.DaftarTargetKamera, Event Player.CalonTargetKamera) + 2;
		Else If(Event Player.KursorKamera >= Count Of(Event Player.DaftarTargetKamera) + 2);
			Event Player.KursorKamera = 0;
		End;
	}
}

rule("96 - Subrutin: Cari pemain terdekat dari bidikan")
{
	event
	{
		Subroutine;
		SegarkanTargetInspeksi;
	}

	actions
	{
		Event Player.TargetInspeksi = Player Closest To Reticle(Event Player, All Teams);
		If(Event Player.TargetInspeksi == Event Player);
			Event Player.TargetInspeksi = Null;
		End;
		If(Event Player.TargetInspeksi != Null);
			If(Entity Exists(Event Player.TargetInspeksi) == False);
				Event Player.TargetInspeksi = Null;
			End;
		End;
		If(Event Player.TargetInspeksi != Null);
			If(Has Spawned(Event Player.TargetInspeksi) == False);
				Event Player.TargetInspeksi = Null;
			End;
		End;
		If(Event Player.TargetInspeksi != Null);
			If(Is Alive(Event Player.TargetInspeksi) == False);
				Event Player.TargetInspeksi = Null;
			End;
		End;
	}
}

rule("97 - Subrutin: Segarkan daftar target balas dendam")
{
	event
	{
		Subroutine;
		SegarkanTargetBalasDendam;
	}

	actions
	{
		If(Event Player.KursorBalasDendam < Count Of(Event Player.DaftarTargetBalasDendam));
			Event Player.TargetBalasDendamDipilih = Event Player.DaftarTargetBalasDendam[Event Player.KursorBalasDendam];
		Else;
			Event Player.TargetBalasDendamDipilih = Null;
		End;
		Event Player.DaftarTargetBalasDendam = Filtered Array(Global.PemainManusia, Current Array Element != Event Player);
		If(Count Of(Event Player.DaftarTargetBalasDendam) == 0);
			Event Player.KursorBalasDendam = 0;
		Else If(And(Event Player.TargetBalasDendamDipilih != Null, Array Contains(Event Player.DaftarTargetBalasDendam,
			Event Player.TargetBalasDendamDipilih)));
			Event Player.KursorBalasDendam = Index Of Array Value(Event Player.DaftarTargetBalasDendam,
				Event Player.TargetBalasDendamDipilih);
		Else If(Event Player.KursorBalasDendam >= Count Of(Event Player.DaftarTargetBalasDendam));
			Event Player.KursorBalasDendam = 0;
		End;
	}
}

rule("98 - Subrutin: Segarkan ruang muncul, objektif, dan target teleportasi")
{
	event
	{
		Subroutine;
		SegarkanTargetTeleportasi;
	}

	actions
	{
		If(And(Event Player.KursorTeleportasi >= 0, Event Player.KursorTeleportasi < Count Of(Event Player.DaftarTargetTeleportasi)));
			Event Player.CalonTargetTeleportasi = Event Player.DaftarTargetTeleportasi[Event Player.KursorTeleportasi];
		Else;
			Event Player.CalonTargetTeleportasi = Null;
		End;
		"Indeks 0 adalah ruang muncul, indeks 1 adalah objektif, lalu semua manusia dan bot. Null hanya penanda objektif."
		Event Player.DaftarTargetTeleportasi = Append To Array(Array(Event Player, Null), Filtered Array(All Players(All Teams),
			And(Current Array Element != Event Player, Has Spawned(Current Array Element))));
		If(Event Player.KursorTeleportasi == 1);
			"Pertahankan objektif yang dipilih; penanda Null tidak perlu dicari di dalam array."
		Else If(And(Event Player.CalonTargetTeleportasi != Null, Array Contains(Event Player.DaftarTargetTeleportasi, Event Player.CalonTargetTeleportasi)));
			Event Player.KursorTeleportasi = Index Of Array Value(Event Player.DaftarTargetTeleportasi, Event Player.CalonTargetTeleportasi);
		Else If(Event Player.KursorTeleportasi >= Count Of(Event Player.DaftarTargetTeleportasi));
			Event Player.KursorTeleportasi = 0;
		End;
	}
}
