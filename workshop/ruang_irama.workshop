rule("91g - Subrutin: Gambar menu teleportasi")
{
	event
	{
		Subroutine;
		GambarTeleportasi;
	}

	actions
	{
		If(Event Player.HudMenu != Null);
			Destroy HUD Text(Event Player.HudMenu);
		End;
		Event Player.HudMenu = Null;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.HudMenuPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = 0;
		End;
		Call Subroutine(SegarkanTargetTeleportasi);
		Event Player.KursorTeleportasi %= Count Of(Event Player.DaftarTargetTeleportasi);
		Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}",
			Custom String("\n{0}: next | {1}: previous", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))),
			Custom String("{0}: teleport | release {1}: close", Input Binding String(Button(Interact)), Input Binding String(Button(Crouch))))
			: Event Player.IndeksBahasa == 1 ? Custom String("{0}\n{1}", Custom String("\n{0}: berikutnya | {1}: sebelumnya",
			Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: teleport | lepas {1}: tutup",
			Input Binding String(Button(Interact)), Input Binding String(Button(Crouch)))) : Custom String("{0}\n{1}", Custom String(
			"\n{0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String(
			"{0}: เทเลพอร์ต | ปล่อย {1}: ปิด", Input Binding String(Button(Interact)), Input Binding String(Button(Crouch)))), Event Player.IndeksBahasa == 0
			? Event Player.KursorTeleportasi == 0 ? Custom String("{0}\n> SPAWN ROOM\n{1}",
				Custom String("TELEPORT {0}/{1}", Event Player.KursorTeleportasi + 1, Count Of(Event Player.DaftarTargetTeleportasi)),
				Is In Spawn Room(Event Player) ? Custom String("YOU ARE ALREADY HERE") : Event Player.PunyaPosisiMuncul ? Custom String("READY FOR TACTICAL RETREAT")
				: Custom String("VISIT SPAWN TO REGISTER IT")) : Event Player.KursorTeleportasi == 1 ? Custom String("{0}\n> CURRENT OBJECTIVE\n{1}",
				Custom String("TELEPORT {0}/{1}", Event Player.KursorTeleportasi + 1, Count Of(Event Player.DaftarTargetTeleportasi)),
				And(Current Game Mode != Game Mode(Capture The Flag), Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) <= 0.100) ? Custom String("UNAVAILABLE IN THIS MODE")
				: Custom String("READY - NEAREST WALKABLE POSITION")) : Custom String("TELEPORT {0}/{1}\n> {2}", Event Player.KursorTeleportasi + 1,
				Count Of(Event Player.DaftarTargetTeleportasi), Event Player.DaftarTargetTeleportasi[Event Player.KursorTeleportasi])
			: Event Player.IndeksBahasa == 1 ? Event Player.KursorTeleportasi == 0 ? Custom String("{0}\n> RUANG MUNCUL\n{1}",
				Custom String("TELEPORT {0}/{1}", Event Player.KursorTeleportasi + 1, Count Of(Event Player.DaftarTargetTeleportasi)),
				Is In Spawn Room(Event Player) ? Custom String("KAMU SUDAH DI SINI") : Event Player.PunyaPosisiMuncul ? Custom String("SIAP UNTUK MUNDUR TAKTIS")
				: Custom String("MASUK KE RUANG MUNCUL UNTUK MENYIMPANNYA")) : Event Player.KursorTeleportasi == 1 ? Custom String("{0}\n> OBJEKTIF SAAT INI\n{1}",
				Custom String("TELEPORT {0}/{1}", Event Player.KursorTeleportasi + 1, Count Of(Event Player.DaftarTargetTeleportasi)),
				And(Current Game Mode != Game Mode(Capture The Flag), Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) <= 0.100) ? Custom String("TIDAK TERSEDIA DI MODE INI")
				: Custom String("SIAP - POSISI TERDEKAT YANG BISA DILALUI")) : Custom String("TELEPORT {0}/{1}\n> {2}", Event Player.KursorTeleportasi + 1,
				Count Of(Event Player.DaftarTargetTeleportasi), Event Player.DaftarTargetTeleportasi[Event Player.KursorTeleportasi])
			: Event Player.KursorTeleportasi == 0 ? Custom String("{0}\n> ห้องเกิด\n{1}", Custom String("เทเลพอร์ต {0}/{1}",
				Event Player.KursorTeleportasi + 1, Count Of(Event Player.DaftarTargetTeleportasi)), Is In Spawn Room(Event Player) ? Custom String(
				"คุณอยู่ที่นี่แล้ว") : Event Player.PunyaPosisiMuncul ? Custom String("พร้อมถอยอย่างมีกลยุทธ์") : Custom String(
				"ไปห้องเกิดเพื่อบันทึกตำแหน่ง")) : Event Player.KursorTeleportasi == 1 ? Custom String("{0}\n> เป้าหมายปัจจุบัน\n{1}",
				Custom String("เทเลพอร์ต {0}/{1}", Event Player.KursorTeleportasi + 1, Count Of(Event Player.DaftarTargetTeleportasi)),
				And(Current Game Mode != Game Mode(Capture The Flag), Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) <= 0.100) ? Custom String("ใช้ไม่ได้ในโหมดนี้")
				: Custom String("พร้อม - ตำแหน่งที่เดินถึงใกล้ที่สุด")) : Custom String("เทเลพอร์ต {0}/{1}\n> {2}",
				Event Player.KursorTeleportasi + 1, Count Of(Event Player.DaftarTargetTeleportasi), Event Player.DaftarTargetTeleportasi[
				Event Player.KursorTeleportasi]), Top, 100,
			Color(White), Custom Color(205, 255, 225, 255), Custom Color(80, 255, 160, 255), Visible To and String, Visible Never);
		Event Player.HudMenu = Last Text ID;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.HudMenuPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = Event Player.HudMenu;
		End;
	}
