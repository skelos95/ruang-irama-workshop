		"Header sengaja Null: fungsi ada di Text, input ada di Subheader. Lebih lega, lebih waras."
		Create HUD Text(Global.PemainManusia, Null, Player Variable(Local Player, IndeksBahasa) == 0 ? Custom String(
			"Hold {0}: inspect a player's name and hero", Input Binding String(Button(Crouch))) : Custom String(
			"Tahan {0}: intip nama dan hero pemain", Input Binding String(Button(Crouch))), Player Variable(Local Player, IndeksBahasa) == 0
			? Custom String("PLAYER NAMES AND LOBBY TIME\n ") : Custom String("NAMA PEMAIN DAN MENIT NONGKRONG\n "), Left, -100,
			Color(White), Color(Gray), Color(Aqua),
			Visible To and String, Default Visibility);
		Global.HudInfoKiri = Last Text ID;
