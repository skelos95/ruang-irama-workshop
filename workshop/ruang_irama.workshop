	}
}

rule("08 - Menu 0: Lompat mundur sepuluh genre")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotAI == False;
		Is Dummy Bot(Event Player) == False;
		Event Player.MenuTerbuka == True;
		Event Player.HalamanMenu == 0;
		Event Player.PerintahMenu == 5;
	}

	actions
	{
		Event Player.KursorGenre = (Event Player.KursorGenre + 90) % 100;
		Call Subroutine(GambarMenu);
	}
}

rule("09 - Menu 0: Jongkok maju sepuluh genre")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotAI == False;
		Is Dummy Bot(Event Player) == False;
		Event Player.MenuTerbuka == True;
		Event Player.HalamanMenu == 0;
		Event Player.PerintahMenu == 6;
	}

	actions
	{
		Event Player.KursorGenre = (Event Player.KursorGenre + 10) % 100;
		Call Subroutine(GambarMenu);
	}
}

rule("10 - Menu: Interaksi membuka atau menerapkan pilihan")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotAI == False;
		Is Dummy Bot(Event Player) == False;
		Event Player.MenuTerbuka == True;
		Event Player.PerintahMenu == 1;
	}

	actions
	{
		If(Event Player.HalamanMenu == -1);
			Event Player.HalamanMenu = Global.KodeMenu[Event Player.KursorUtama];
			If(Event Player.HalamanMenu == 0);
				Event Player.KursorGenre = Event Player.IndeksGenre >= 0 ? Event Player.IndeksGenre : 0;
			Else If(Event Player.HalamanMenu == 1);
				Event Player.KursorKamera = 0;
				Call Subroutine(SegarkanTargetKamera);
				If(Event Player.ModeKamera == 1);
					Event Player.KursorKamera = 1;
				Else If(And(Event Player.ModeKamera == 2, Array Contains(Event Player.DaftarTargetKamera, Event Player.TargetKamera)));
					Event Player.KursorKamera = Index Of Array Value(Event Player.DaftarTargetKamera, Event Player.TargetKamera) + 2;
				End;
			Else If(Event Player.HalamanMenu == 2);
				Event Player.KursorWarna = Event Player.IndeksWarna;
			Else If(Event Player.HalamanMenu == 3);
				Event Player.KursorBahasa = Event Player.IndeksBahasa;
			Else If(Event Player.HalamanMenu == 4);
				Event Player.KursorBalasDendam = 0;
				Call Subroutine(SegarkanTargetBalasDendam);
			Else;
				Event Player.KursorTeleportasi = 0;
				Call Subroutine(SegarkanTargetTeleportasi);
			End;
			Call Subroutine(GambarMenu);
		Else If(Event Player.HalamanMenu == 0);
			Event Player.IndeksGenre = Event Player.KursorGenre;
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
				"Soundtrack locked: {0}. Excellent taste, probably.", Global.DaftarGenre[Event Player.IndeksGenre]) : Event Player.IndeksBahasa == 1
				? Custom String("Soundtrack dipilih: {0}. Selera bagus. Mungkin.", Global.DaftarGenre[Event Player.IndeksGenre]) : Custom String(
				"เลือกเพลงประกอบแล้ว: {0} รสนิยมดี...น่าจะนะ", Global.DaftarGenre[Event Player.IndeksGenre]));
		Else If(Event Player.HalamanMenu == 1);
			Call Subroutine(SegarkanTargetKamera);
			Event Player.KursorKamera %= Count Of(Event Player.DaftarTargetKamera) + 2;
			If(Event Player.KursorKamera == 0);
				Stop Camera(Event Player);
				Event Player.ModeKamera = 0;
				Event Player.TargetKamera = Null;
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
					"First person restored. You may pretend that never happened.") : Event Player.IndeksBahasa == 1 ? Custom String(
					"Kamera orang pertama kembali. Tidak ada yang melihat tadi.") : Custom String(
					"กลับสู่มุมมองบุคคลที่หนึ่งแล้ว ทำเป็นว่าเมื่อกี้ไม่เกิดขึ้นก็ได้"));
			Else If(Event Player.KursorKamera == 1);
				Event Player.TargetKamera = Event Player;
				"Biarkan frame Interact selesai sebelum mengganti render kamera."
				Wait(0.016, Ignore Condition);
				Event Player.ModeKamera = 1;
				Call Subroutine(MulaiKamera);
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
					"Third person enabled. Admire responsibly.") : Event Player.IndeksBahasa == 1 ? Custom String(
					"Orang ketiga aktif. Silakan mengagumi diri secukupnya.") : Custom String(
					"เปิดมุมมองบุคคลที่สามแล้ว ชื่นชมตัวเองแต่พอดี"));
			Else;
				If(Event Player.KursorKamera - 2 < Count Of(Event Player.DaftarTargetKamera));
					Event Player.CalonTargetKamera = Event Player.DaftarTargetKamera[Event Player.KursorKamera - 2];
				Else;
					Event Player.CalonTargetKamera = Null;
				End;
				If(And(Event Player.CalonTargetKamera != Null, Entity Exists(Event Player.CalonTargetKamera)));
					Event Player.TargetKamera = Event Player.CalonTargetKamera;
					"Gunakan jeda satu frame yang sama saat mulai menonton dari orang pertama."
					Wait(0.016, Ignore Condition);
					Event Player.ModeKamera = 2;
					Call Subroutine(MulaiKamera);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"Now spectating {0}. Definitely not stalking.", Event Player.TargetKamera) : Event Player.IndeksBahasa == 1 ? Custom String(
						"Sekarang menonton {0}. Sama sekali bukan menguntit.", Event Player.TargetKamera) : Custom String(
						"กำลังชม {0} อยู่ นี่ไม่ใช่การสะกดรอยแน่นอน", Event Player.TargetKamera));
				Else;
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"That player disappeared. Very on-brand for AFK.") : Event Player.IndeksBahasa == 1 ? Custom String(
						"Pemainnya menghilang. Sangat sesuai tema AFK.") : Custom String(
						"ผู้เล่นคนนั้นหายไปแล้ว สมกับเป็นห้อง AFK จริง ๆ"));
				End;
			End;
		Else If(Event Player.HalamanMenu == 2);
			Event Player.IndeksWarna = Event Player.KursorWarna;
			Event Player.WarnaNama = Global.DaftarWarna[Event Player.IndeksWarna];
			Start Forcing Player Outlines(Event Player, Filtered Array(Global.PemainManusia, Player Variable(Current Array Element,
				InspeksiAktif) == True), True, Event Player.WarnaNama, Always);
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
				"Name color set to {0}. Subtlety is optional.", Global.NamaWarnaEN[Event Player.IndeksWarna]) : Event Player.IndeksBahasa == 1 ? Custom String(
				"Warna nama: {0}. Kalem itu opsional.", Global.NamaWarna[Event Player.IndeksWarna]) : Custom String(
				"ตั้งสีชื่อเป็น {0} แล้ว จะเด่นแค่ไหนก็ได้", Global.NamaWarnaTH[Event Player.IndeksWarna]));
		Else If(Event Player.HalamanMenu == 3);
			Event Player.IndeksBahasa = Event Player.KursorBahasa;
			Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
				"HUD language: English.") : Event Player.IndeksBahasa == 1 ? Custom String(
				"Bahasa HUD: Bahasa Indonesia.") : Custom String("ภาษา HUD: ไทย"));
			Call Subroutine(GambarMenu);
		Else If(Event Player.HalamanMenu == 4);
			Call Subroutine(SegarkanTargetBalasDendam);
			If(Count Of(Event Player.DaftarTargetBalasDendam) == 0);
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
					"No revenge targets. Peace has won, temporarily.") : Event Player.IndeksBahasa == 1 ? Custom String(
					"Tidak ada target balas dendam. Damai menang... sementara.") : Custom String(
					"ไม่มีเป้าหมายล้างแค้น ความสงบชนะแล้ว...ชั่วคราว"));
			Else;
				Event Player.KursorBalasDendam %= Count Of(Event Player.DaftarTargetBalasDendam);
				Event Player.TargetBalasDendamTerkunci = Event Player.DaftarTargetBalasDendam[Event Player.KursorBalasDendam];
				Event Player.IndeksBalasDendam = Index Of Array Value(Event Player.PembunuhBalasDendam,
					Event Player.TargetBalasDendamTerkunci);
				If(Event Player.IndeksBalasDendam < 0);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"That player owes you nothing. Suspiciously peaceful.") : Event Player.IndeksBahasa == 1 ? Custom String(
						"Pemain itu tidak punya utang. Damainya mencurigakan sekali.") : Custom String(
						"ผู้เล่นคนนั้นไม่ได้ติดหนี้คุณ สงบเกินจนน่าสงสัย"));
				Else If(Event Player.JumlahBalasDendam[Event Player.IndeksBalasDendam] <= 0);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"Revenge debt cleared. Case closed.") : Event Player.IndeksBahasa == 1 ? Custom String(
						"Utang balas dendam lunas. Kasus ditutup.") : Custom String(
						"ชำระหนี้ล้างแค้นหมดแล้ว ปิดคดี"));
				Else If(Or(Entity Exists(Event Player.TargetBalasDendamTerkunci) == False,
					Is Alive(Event Player.TargetBalasDendamTerkunci) == False));
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"Target is already down. Revenge has office hours.") : Event Player.IndeksBahasa == 1 ? Custom String(
						"Target sudah tumbang. Balas dendam juga punya jam kerja.") : Custom String(
						"เป้าหมายล้มอยู่แล้ว การล้างแค้นก็มีเวลาทำการนะ"));
				Else;
					Set Player Variable(Event Player.TargetBalasDendamTerkunci, KematianBalasDendam, True);
					Kill(Event Player.TargetBalasDendamTerkunci, Event Player);
					Modify Player Variable At Index(Event Player, JumlahBalasDendam, Event Player.IndeksBalasDendam, Subtract, 1);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Revenge claimed on {0}. Remaining: {1}.",
						Event Player.TargetBalasDendamTerkunci, Event Player.JumlahBalasDendam[Event Player.IndeksBalasDendam]) : Event Player.IndeksBahasa == 1 ? Custom String(
						"Balas dendam dibayar pada {0}. Sisa: {1}.", Event Player.TargetBalasDendamTerkunci,
						Event Player.JumlahBalasDendam[Event Player.IndeksBalasDendam]) : Custom String("ล้างแค้น {0} สำเร็จ เหลือ: {1}",
						Event Player.TargetBalasDendamTerkunci, Event Player.JumlahBalasDendam[Event Player.IndeksBalasDendam]));
					Event Player.TargetBalasDendamTerkunci = Null;
					Call Subroutine(GambarMenu);
				End;
			End;
		Else;
			Call Subroutine(SegarkanTargetTeleportasi);
			Event Player.KursorTeleportasi %= Count Of(Event Player.DaftarTargetTeleportasi);
			Event Player.CalonTargetTeleportasi = Event Player.DaftarTargetTeleportasi[Event Player.KursorTeleportasi];
			If(Event Player.KursorTeleportasi == 0);
				If(Is In Spawn Room(Event Player) == True);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"You are already in the Spawn Room. Mission accomplished.") : Event Player.IndeksBahasa == 1 ? Custom String(
						"Kamu sudah di ruang muncul. Misi selesai.") : Custom String(
						"คุณอยู่ในห้องเกิดแล้ว ภารกิจสำเร็จ"));
				Else If(Event Player.PunyaPosisiMuncul == False);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"Spawn Room not registered yet. Visit spawn first.") : Event Player.IndeksBahasa == 1 ? Custom String(
						"Posisi ruang muncul belum tersimpan. Masuk ke sana dulu.") : Custom String(
						"ยังไม่ได้บันทึกห้องเกิด กรุณาไปที่ห้องเกิดก่อน"));
				Else;
					Teleport(Event Player, Event Player.PosisiRuangMuncul);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"Back to the Spawn Room. Tactical retreat complete.") : Event Player.IndeksBahasa == 1 ? Custom String(
						"Kembali ke ruang muncul. Mundur taktis selesai.") : Custom String(
						"กลับสู่ห้องเกิดแล้ว การถอยเชิงกลยุทธ์เสร็จสิ้น"));
				End;
			Else If(Event Player.KursorTeleportasi == 1);
				If(Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) <= 0.100);
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"Objective position unavailable in this mode. The objective is being mysterious.") : Event Player.IndeksBahasa == 1 ? Custom String(
						"Posisi objektif tidak tersedia di mode ini. Objektifnya sedang misterius.") : Custom String(
						"ตำแหน่งเป้าหมายใช้ไม่ได้ในโหมดนี้ เป้าหมายกำลังเล่นซ่อนหา"));
				Else;
					Teleport(Event Player, Nearest Walkable Position(Objective Position(Objective Index)));
					Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
						"Teleported near the current objective. Heroic entrance not included.") : Event Player.IndeksBahasa == 1 ? Custom String(
						"Teleport dekat objektif saat ini. Pose heroik tidak termasuk.") : Custom String(
						"เทเลพอร์ตใกล้เป้าหมายปัจจุบันแล้ว ไม่มีท่าเปิดตัวฮีโร่แถมให้"));
				End;
			Else If(Or(Entity Exists(Event Player.CalonTargetTeleportasi) == False, Is Alive(Event Player.CalonTargetTeleportasi) == False));
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
					"Target unavailable. Even teleportation has standards.") : Event Player.IndeksBahasa == 1 ? Custom String(
					"Target sedang tidak tersedia. Teleportasi juga punya standar.") : Custom String(
					"เป้าหมายไม่พร้อมใช้งาน แม้แต่เทเลพอร์ตก็มีมาตรฐาน"));
			Else;
				Teleport(Event Player, Nearest Walkable Position(Position Of(Event Player.CalonTargetTeleportasi)
					- Facing Direction Of(Event Player.CalonTargetTeleportasi) * 1.500));
				Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
					"Teleported near {0}. Personal space sold separately.", Event Player.CalonTargetTeleportasi) : Event Player.IndeksBahasa == 1 ? Custom String(
					"Teleport dekat {0}. Jarak pribadi dijual terpisah.", Event Player.CalonTargetTeleportasi) : Custom String(
					"เทเลพอร์ตไปใกล้ {0} แล้ว พื้นที่ส่วนตัวไม่ได้รวมในแพ็กเกจ", Event Player.CalonTargetTeleportasi));
			End;
			Call Subroutine(GambarMenu);
		End;
	}
}

rule("11 - Menu: Isi ulang kembali dari submenu ke menu utama")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Event Player.BotAI == False;
		Is Dummy Bot(Event Player) == False;
		Event Player.MenuTerbuka == True;
		Event Player.HalamanMenu != -1;
		Event Player.PerintahMenu == 2;
	}

	actions
	{
		Event Player.HalamanMenu = -1;
		Call Subroutine(GambarMenu);
	}
}

rule("12 - Menu: Kematian juga menutup warung")
{
	event
	{
		Player Died;
		All;
		All;
	}

	conditions
	{
		Event Player.MenuTerbuka == True;
	}

	actions
	{
		Call Subroutine(TutupMenu);
	}
}

rule("13 - Intip Pahlawan: Tampilkan nama, ikon, dan daya ultimate")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
		Is Alive(Event Player) == True;
		Event Player.MenuTerbuka == False;
		Event Player.ModeKamera != 2;
		Event Player.InspeksiAktif == False;
		Is Button Held(Event Player, Button(Crouch)) == True;
	}

	actions
	{
		Event Player.InspeksiAktif = True;
		Disable Nameplates(All Players(All Teams), Event Player);
		Event Player.PelatNamaDinonaktifkan = True;
		"Saat jongkok, iterasikan hanya entitas yang hadir: manusia memakai warna pilihannya dan bot memakai jingga."
		For Player Variable(Event Player, IndeksGarisLuar, 0, Count Of(All Players(All Teams)), 1);
			If(Or(Is Dummy Bot(All Players(All Teams)[Event Player.IndeksGarisLuar]), Player Variable(All Players(All Teams)[
				Event Player.IndeksGarisLuar], BotAI)));
				Start Forcing Player Outlines(All Players(All Teams)[Event Player.IndeksGarisLuar], Event Player, True, Color(Orange), Always);
			Else;
				Start Forcing Player Outlines(All Players(All Teams)[Event Player.IndeksGarisLuar], Event Player, True, Player Variable(
					All Players(All Teams)[Event Player.IndeksGarisLuar], WarnaNama), Always);
			End;
		End;
		Call Subroutine(SegarkanTargetInspeksi);
		Create In-World Text(Event Player, Event Player.TargetInspeksi == Null ? Custom String("") : Event Player.IndeksBahasa == 2 ? Custom String(
			"{0} {1}  อัลติ {2}%", Custom String("{0}", Event Player.TargetInspeksi), Hero Icon String(Is Duplicating(Event Player.TargetInspeksi)
			? Hero Being Duplicated(Event Player.TargetInspeksi) : Hero Of(Event Player.TargetInspeksi)), Round To Integer(Ultimate Charge Percent(
			Event Player.TargetInspeksi), Down)) : Custom String("{0} {1}  ULT {2}%",
			Custom String("{0}", Event Player.TargetInspeksi), Hero Icon String(Is Duplicating(Event Player.TargetInspeksi)
			? Hero Being Duplicated(Event Player.TargetInspeksi) : Hero Of(Event Player.TargetInspeksi)), Round To Integer(Ultimate Charge Percent(
			Event Player.TargetInspeksi), Down)), Event Player.TargetInspeksi == Null
			? Eye Position(Event Player) : Eye Position(Event Player.TargetInspeksi) + Vector(0, 0.450, 0), 0.750, Do Not Clip,
			Visible To Position String and Color, Event Player.TargetInspeksi == Null ? Color(White) : Player Variable(
			Event Player.TargetInspeksi, Manusia) == True ? Player Variable(Event Player.TargetInspeksi, WarnaNama) : Color(Orange),
			Visible Never);
		Event Player.TeksDunia = Last Text ID;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.TeksDuniaPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = Event Player.TeksDunia;
		End;
		Event Player.TeksDiri = Null;
		If(Event Player.ModeKamera == 1);
			Create In-World Text(Event Player, Event Player.IndeksBahasa == 2 ? Custom String("{0} {1}  อัลติ {2}%", Custom String("{0}", Event Player),
				Hero Icon String(Is Duplicating(Event Player) ? Hero Being Duplicated(Event Player) : Hero Of(Event Player)), Round To Integer(
				Ultimate Charge Percent(Event Player), Down)) : Custom String("{0} {1}  ULT {2}%", Custom String("{0}", Event Player), Hero Icon String(Is Duplicating(
				Event Player) ? Hero Being Duplicated(Event Player) : Hero Of(Event Player)), Round To Integer(Ultimate Charge Percent(Event Player),
				Down)), Update Every Frame(Eye Position(Event Player) + Vector(0, 0.450, 0)), 0.750, Do Not Clip,
				Visible To Position String and Color, Event Player.WarnaNama, Visible Never);
			Event Player.TeksDiri = Last Text ID;
			If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
				Global.TeksDiriPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = Event Player.TeksDiri;
			End;
		End;
	}
}

rule("14 - Intip Pahlawan: Perbarui garis pandang dengan sopan")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.InspeksiAktif == True;
		Is Alive(Event Player) == True;
		Event Player.MenuTerbuka == False;
		Is Button Held(Event Player, Button(Crouch)) == True;
	}

	actions
	{
		Call Subroutine(SegarkanTargetInspeksi);
		Wait(0.100, Abort When False);
		Loop If Condition Is True;
	}
}

rule("15 - Intip Pahlawan: Hapus tulisan saat berdiri atau membuka menu")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.InspeksiAktif == True;
		Or(Or(Or(Is Button Held(Event Player, Button(Crouch)) == False, Event Player.MenuTerbuka == True), Is Dead(Event Player)),
			Event Player.ModeKamera == 2) == True;
	}

	actions
	{
		If(Event Player.PelatNamaDinonaktifkan == True);
			Enable Nameplates(All Players(All Teams), Event Player);
			Event Player.PelatNamaDinonaktifkan = False;
		End;
		Stop Forcing Player Outlines(All Players(All Teams), Event Player);
		If(Event Player.TeksDunia != Null);
			Destroy In-World Text(Event Player.TeksDunia);
		End;
		If(Event Player.TeksDiri != Null);
			Destroy In-World Text(Event Player.TeksDiri);
		End;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.TeksDuniaPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = 0;
			Global.TeksDiriPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = 0;
		End;
		Event Player.TeksDunia = Null;
		Event Player.TeksDiri = Null;
		Event Player.TargetInspeksi = Null;
		Event Player.InspeksiAktif = False;
	}
}

rule("16 - Kamera: Target pergi, pulangkan pandangan")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Event Player.ModeKamera == 2;
		Or(Event Player.TargetKamera == Null, Entity Exists(Event Player.TargetKamera) == False) == True;
	}

	actions
	{
		Stop Camera(Event Player);
		Event Player.ModeKamera = 0;
		Event Player.TargetKamera = Null;
		Small Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(
			"Camera target left. First person has reclaimed you.") : Event Player.IndeksBahasa == 1 ? Custom String(
			"Target kamera keluar. Orang pertama mengambilmu kembali.") : Custom String(
			"เป้าหมายกล้องออกไปแล้ว กลับสู่มุมมองบุคคลที่หนึ่ง"));
	}
}

rule("17 - Balas Dendam: Catat hanya pembunuh langsung")
{
	event
	{
		Player Died;
		All;
		All;
	}

	conditions
	{
		Event Player.Manusia == True;
	}

	actions
	{
		If(Event Player.KematianBalasDendam == True);
			Event Player.KematianBalasDendam = False;
			Abort;
		End;
		Abort If(Attacker == Null);
		Abort If(Attacker == Event Player);
		Abort If(Player Variable(Attacker, Manusia) == False);
		Event Player.IndeksBalasDendam = Index Of Array Value(Event Player.PembunuhBalasDendam, Attacker);
		If(Event Player.IndeksBalasDendam < 0);
			Event Player.PembunuhBalasDendam = Append To Array(Event Player.PembunuhBalasDendam, Attacker);
			Event Player.JumlahBalasDendam = Append To Array(Event Player.JumlahBalasDendam, 1);
		Else;
			Modify Player Variable At Index(Event Player, JumlahBalasDendam, Event Player.IndeksBalasDendam, Add, 1);
		End;
	}
}

rule("90 - Subrutin: Tutup menu dan kembalikan semua tombol")
{
	event
	{
		Subroutine;
		TutupMenu;
	}

	actions
	{
		If(Event Player.HudMenu != Null);
			Destroy HUD Text(Event Player.HudMenu);
		End;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.HudMenuPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = 0;
		End;
		Event Player.HudMenu = Null;
		Event Player.MenuTerbuka = False;
		Event Player.PerintahMenu = 0;
		Event Player.HalamanMenu = -1;
		If(Is Button Held(Event Player, Button(Melee)) == False);
			Allow Button(Event Player, Button(Melee));
		End;
		Allow Button(Event Player, Button(Jump));
		Allow Button(Event Player, Button(Crouch));
		Allow Button(Event Player, Button(Primary Fire));
		Allow Button(Event Player, Button(Secondary Fire));
		Allow Button(Event Player, Button(Interact));
		Allow Button(Event Player, Button(Reload));
		Allow Button(Event Player, Button(Ability 1));
		Allow Button(Event Player, Button(Ability 2));
		Allow Button(Event Player, Button(Ultimate));
	}
}

rule("91 - Subrutin: Pilih gambar menu yang sedang dibuka")
{
	event
	{
		Subroutine;
		GambarMenu;
	}

	actions
	{
		If(Event Player.HudMenu != Null);
			Destroy HUD Text(Event Player.HudMenu);
		End;
		Event Player.HudMenu = Null;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.HudMenuPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = 0;
		End;
		If(Event Player.HalamanMenu == -1);
			Call Subroutine(GambarUtama);
		Else If(Event Player.HalamanMenu == 0);
			Call Subroutine(GambarMusik);
		Else If(Event Player.HalamanMenu == 1);
			Call Subroutine(GambarKamera);
		Else If(Event Player.HalamanMenu == 2);
			Call Subroutine(GambarWarna);
		Else If(Event Player.HalamanMenu == 3);
			Call Subroutine(GambarBahasa);
		Else If(Event Player.HalamanMenu == 4);
			Call Subroutine(GambarBalasDendam);
		Else;
			Call Subroutine(GambarTeleportasi);
		End;
		If(Index Of Array Value(Global.PemainManusia, Event Player) >= 0);
			Global.HudMenuPemain[Index Of Array Value(Global.PemainManusia, Event Player)] = Event Player.HudMenu;
		End;
	}
}

rule("91a - Subrutin: Gambar menu utama")
{
	event
	{
		Subroutine;
		GambarUtama;
	}

	actions
	{
		Create HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\n{1}",
			Custom String("\n{0}: next | {1}: previous", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))),
			Custom String("{0}: open | hold {1} 0.5 sec: close", Input Binding String(Button(Interact)), Input Binding String(Button(Melee))))
			: Event Player.IndeksBahasa == 1 ? Custom String("{0}\n{1}", Custom String("\n{0}: berikutnya | {1}: sebelumnya", Input Binding String(Button(Primary Fire)),
			Input Binding String(Button(Secondary Fire))), Custom String("{0}: buka | tahan {1} 0,5 dtk: tutup", Input Binding String(Button(Interact)),
			Input Binding String(Button(Melee)))) : Custom String("{0}\n{1}", Custom String("\n{0}: ถัดไป | {1}: ก่อนหน้า",
			Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: เปิด | กด {1} ค้างเพื่อปิด",
			Input Binding String(Button(Interact)), Input Binding String(Button(Melee)))), Event Player.IndeksBahasa == 0 ? Event Player.KursorUtama == 0 ? Custom String(
			"0 - SOUNDTRACK\nCURRENT: {0}", Event Player.IndeksGenre >= 0 ? Global.DaftarGenre[Event Player.IndeksGenre] : Custom String("no soundtrack yet"))
			: Event Player.KursorUtama == 1 ? Custom String("1 - THIRD-PERSON CAMERA\nCURRENT: {0}", Event Player.ModeKamera == 0 ? Custom String("off")
			: Event Player.ModeKamera == 1 ? Custom String("your hero") : Custom String("watching {0}", Event Player.TargetKamera))
			: Event Player.KursorUtama == 2 ? Custom String("2 - NAME COLOR\nCURRENT: {0}", Global.NamaWarnaEN[Event Player.IndeksWarna])
			: Event Player.KursorUtama == 3 ? Custom String("3 - HUD LANGUAGE\nCURRENT: {0}", Global.NamaBahasa[Event Player.IndeksBahasa])
			: Event Player.KursorUtama == 4 ? Custom String("4 - REVENGE\nDIRECT KILLS OWED TO YOU") : Custom String(
			"5 - TELEPORT\nSPAWN ROOM, OBJECTIVE, PLAYERS & BOTS") : Event Player.IndeksBahasa == 1 ? Event Player.KursorUtama == 0 ? Custom String(
			"0 - SOUNDTRACK\nSAAT INI: {0}", Event Player.IndeksGenre >= 0 ? Global.DaftarGenre[Event Player.IndeksGenre] : Custom String("belum pilih soundtrack"))
			: Event Player.KursorUtama == 1 ? Custom String("1 - KAMERA ORANG KETIGA\nSAAT INI: {0}", Event Player.ModeKamera == 0 ? Custom String("mati")
			: Event Player.ModeKamera == 1 ? Custom String("hero sendiri") : Custom String("menonton {0}", Event Player.TargetKamera))
			: Event Player.KursorUtama == 2 ? Custom String("2 - WARNA NAMA\nSAAT INI: {0}", Global.NamaWarna[Event Player.IndeksWarna])
			: Event Player.KursorUtama == 3 ? Custom String("3 - BAHASA HUD\nSAAT INI: {0}", Global.NamaBahasa[Event Player.IndeksBahasa])
			: Event Player.KursorUtama == 4 ? Custom String("4 - BALAS DENDAM\nUTANG KILL LANGSUNG") : Custom String(
			"5 - TELEPORTASI\nRUANG MUNCUL, OBJEKTIF, PEMAIN & BOT") : Event Player.KursorUtama == 0 ? Custom String(
			"0 - เพลงประกอบ\nปัจจุบัน: {0}", Event Player.IndeksGenre >= 0 ? Global.DaftarGenre[Event Player.IndeksGenre] : Custom String("ยังไม่ได้เลือกเพลง"))
			: Event Player.KursorUtama == 1 ? Custom String("1 - กล้องบุคคลที่สาม\nสถานะ: {0}", Event Player.ModeKamera == 0 ? Custom String("ปิด")
			: Event Player.ModeKamera == 1 ? Custom String("ฮีโร่ของคุณ") : Custom String("กำลังดู {0}", Event Player.TargetKamera))
			: Event Player.KursorUtama == 2 ? Custom String("2 - สีชื่อ\nปัจจุบัน: {0}", Global.NamaWarnaTH[Event Player.IndeksWarna])
			: Event Player.KursorUtama == 3 ? Custom String("3 - ภาษา HUD\nปัจจุบัน: {0}", Global.NamaBahasa[Event Player.IndeksBahasa])
			: Event Player.KursorUtama == 4 ? Custom String("4 - ล้างแค้น\nศัตรูที่ติดหนี้คุณ") : Custom String(
			"5 - เทเลพอร์ต\nห้องเกิด เป้าหมาย ผู้เล่น และบอต"), Top, 100, Color(White), Custom Color(210, 230, 255, 255),
			Custom Color(255, 185, 65, 255), Visible To and String, Visible Never);
		Event Player.HudMenu = Last Text ID;
	}
}

