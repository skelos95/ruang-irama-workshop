		Global.BantalanDinding = 0.200;
		Global.JarakBidik = 25;
		"Timer server berdiri sendiri dari timer mode bawaan. Host lobi dapat memilih 30 sampai 90 menit."
		Global.DurasiServerMenit = Workshop Setting Integer(Custom String("CHILL DEDICATED SERVER"), Custom String("Server duration (minutes)"), 30, 30, 90, 0);
		Global.IndeksLokasiServer = Workshop Setting Combo(Custom String("CHILL DEDICATED SERVER"), Custom String("Server location (Asia)"), 6, Array(
			Custom String("Bangladesh"),
			Custom String("Bhutan"),
			Custom String("Brunei"),
			Custom String("Cambodia"),
			Custom String("Hong Kong"),
			Custom String("India"),
			Custom String("Indonesia"),
			Custom String("Japan"),
			Custom String("Kazakhstan"),
			Custom String("Kyrgyzstan"),
			Custom String("Laos"),
