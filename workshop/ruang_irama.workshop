			Custom String("Slowcore"),
			Custom String("Psybient"),
			Custom String("Trip-Hop"),
			Custom String("Vaporwave"),
			Custom String("Lovers Rock"),
			Custom String("Roots Reggae"),
			Custom String("Dub"),
			Custom String("Soft Rock"),
			Custom String("Neo-Soul"),
			Custom String("Soul"),
