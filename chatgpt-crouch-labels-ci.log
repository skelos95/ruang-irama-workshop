se;\n\t\tIs Alive(Event Player) == False;\n\t\tEvent Player.TeleportasiJongkokAktif == False;\n\t\tEvent Player.BangkitLompatDipakai == False;\n\t\tIs Button Held(Event Player, Button(Jump)) == True;\n\t}\n\n\tazioni\n\t{\n\t\tEvent Player.BangkitLompatDipakai = True;\n\t\tEvent Player.PosisiTeleportTujuan = Event Player.PosisiMati + Vector(Random Real(-6, 6), 0, Random Real(-6, 6));\n\t\tCall Subroutine(CariPosisiTeleportAman);\n\t\tIf(Distance Between(Event Player.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100);\n\t\t\tEvent Player.PosisiTeleportTujuan = Event Player.PosisiMati;\n\t\t\tCall Subroutine(CariPosisiTeleportAman);\n\t\tEnd;\n\t\tIf(Distance Between(Event Player.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100);\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("No safe resurrection position was found. Release Jump and try again.") : Event Player.IndeksBahasa == 1 ? Custom String("Tidak ada posisi bangkit yang aman. Lepaskan Jump lalu coba lagi.") : Custom String("ไม่พบตำแหน่งฟื้นคืนชีพที่ปลอดภัย ปล่อยปุ่มกระโดดแล้วลองอีกครั้ง"));\n\t\t\tAbort;\n\t\tEnd;\n\t\tResurrect(Event Player);\n\t\tTeleport(Event Player, Event Player.PosisiBangkitAman);\n\t\tIf(Is Alive(Event Player) == True);\n\t\t\tCall Subroutine(EfekPulihkan);\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Resurrected nearby. Try not to repeat that.") : Event Player.IndeksBahasa == 1 ? Custom String("Bangkit kembali dekat titik mati. Coba jangan ulangi.") : Custom String("ฟื้นคืนชีพใกล้จุดตายแล้ว อย่าซ้ำอีกล่ะ"));\n\t\tEnd;\n\t}\n}\n\nregola("12g - Bangkit Lompat: Lepaskan Jump sebelum mencoba lagi")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.Manusia == True;\n\t\tEvent Player.BotOtomatis == False;\n\t\tIs Dummy Bot(Event Player) == False;\n\t\tIs Alive(Event Player) == False;\n\t\tEvent Player.BangkitLompatDipakai == True;\n\t\tIs Button Held(Event Player, Button(Jump)) == False;\n\t}\n\n\tazioni\n\t{\n\t\tEvent Player.BangkitLompatDipakai = False;\n\t}\n}\n\nregola("13 - Intip Pahlawan: Nama mengikuti target bidikan tanpa Wait")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.Manusia == True;\n\t\tIs Alive(Event Player) == True;\n\t\tEvent Player.MenuTerbuka == False;\n\t\tEvent Player.PrivasiNasibAktif == False;\n\t\tEvent Player.TeleportasiJongkokAktif == False;\n\t\tEvent Player.TeleportasiJongkokDiaktifkan == False;\n\t\tEvent Player.ModeKamera != 2;\n\t\tIs Button Held(Event Player, Button(Crouch)) == True;\n\t\tEvent Player.TargetInspeksi != Event Player.CalonTargetInspeksi;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.InspeksiAktif == False);\n\t\t\tEvent Player.InspeksiAktif = True;\n\t\t\tDisable Nameplates(All Players(All Teams), Event Player);\n\t\t\tEvent Player.PelatNamaDinonaktifkan = True;\n\t\tEnd;\n\t\tIf(Event Player.TeksDunia != Null);\n\t\t\tDestroy In-World Text(Event Player.TeksDunia);\n\t\tEnd;\n\t\tIf(Index Of Array Value(Globale.PemainManusia, Event Player) >= 0);\n\t\t\tGlobale.TeksDuniaPemain[Index Of Array Value(Globale.PemainManusia, Event Player)] = 0;\n\t\tEnd;\n\t\tEvent Player.TeksDunia = Null;\n\t\tCall Subroutine(SegarkanTargetInspeksi);\n\t\tAbort If(Event Player.TargetInspeksi == Null);\n\t\tCreate In-World Text(Event Player, Custom String("{0} {1} | {2}", Hero Icon String(Is Duplicating(Event Player.TargetInspeksi) ? Hero Being Duplicated(Event Player.TargetInspeksi) : Hero Of(Event Player.TargetInspeksi)), Custom String("{0}", Event Player.TargetInspeksi), Round To Integer(Health(Event Player.TargetInspeksi), Down)), Eye Position(Event Player.TargetInspeksi) + Vector(0, 0.450, 0), 1.100, Do Not Clip, Visible To Position String and Color, Player Variable(Event Player.TargetInspeksi, Manusia) == True ? Player Variable(Event Player.TargetInspeksi, WarnaNama) : Custom Color(236, 153, 0, 255), Visible Never);\n\t\tEvent Player.TeksDunia = Last Text ID;\n\t\tIf(Index Of Array Value(Globale.PemainManusia, Event Player) >= 0);\n\t\t\tGlobale.TeksDuniaPemain[Index Of Array Value(Globale.PemainManusia, Event Player)] = Event Player.TeksDunia;\n\t\tEnd;\n\t}\n}\n\nregola("16a - Anran: Ultimate menjadi 100 persen setiap kali mati")\n{\n\tevento\n\t{\n\t\tPlayer Died;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.Manusia == True;\n\t\tEvent Player.BotOtomatis == False;\n\t\tIs Dummy Bot(Event Player) == False;\n\t\tHero Of(Event Player) == Hero(Anran);\n\t}\n\n\tazioni\n\t{\n\t\tSet Ultimate Charge(Event Player, 100);\n\t}\n}\n\nregola("17 - Balas Dendam: Catat hanya pembunuh langsung")\n{\n\tevento\n\t{\n\t\tPlayer Died;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.Manusia == True;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.KematianBalasDendam == True);\n\t\t\tIf(Is Alive(Event Player) == False);\n\t\t\t\tIf(And(Event Player.PenagihBalasDendam != Null, And(Entity Exists(Event Player.PenagihBalasDendam), And(Player Variable(Event Player.PenagihBalasDendam, Manusia) == True, Attacker == Event Player.PenagihBalasDendam))));\n\t\t\t\t\tSet Player Variable(Event Player.PenagihBalasDendam, IndeksBalasDendam, Index Of Array Value(Player Variable(Event Player.PenagihBalasDendam, PembunuhBalasDendam), Event Player));\n\t\t\t\t\tIf(And(Player Variable(Event Player.PenagihBalasDendam, IndeksBalasDendam) >= 0, Player Variable(Event Player.PenagihBalasDendam, JumlahBalasDendam)[Player Variable(Event Player.PenagihBalasDendam, IndeksBalasDendam)] > 0));\n\t\t\t\t\t\tModify Player Variable At Index(Event Player.PenagihBalasDendam, JumlahBalasDendam, Player Variable(Event Player.PenagihBalasDendam, IndeksBalasDendam), Subtract, 1);\n\t\t\t\t\t\tPlay Effect(All Players(All Teams), Ring Explosion, Globale.RGB, Position Of(Event Player.PenagihBalasDendam) + Vector(0, 1, 0), 3);\n\t\t\t\t\t\tSmall Message(Event Player.PenagihBalasDendam, Player Variable(Event Player.PenagihBalasDendam, IndeksBahasa) == 0 ? Custom String("Revenge claimed on {0}. Remaining: {1}.", Event Player, Player Variable(Event Player.PenagihBalasDendam, JumlahBalasDendam)[Player Variable(Event Player.PenagihBalasDendam, IndeksBalasDendam)]) : Player Variable(Event Player.PenagihBalasDendam, IndeksBahasa) == 1 ? Custom String("Balas dendam dibayar pada {0}. Sisa: {1}.", Event Player, Player Variable(Event Player.PenagihBalasDendam, JumlahBalasDendam)[Player Variable(Event Player.PenagihBalasDendam, IndeksBalasDendam)]) : Custom String("ล้างแค้น {0} สำเร็จ เหลือ: {1}", Event Player, Player Variable(Event Player.PenagihBalasDendam, JumlahBalasDendam)[Player Variable(Event Player.PenagihBalasDendam, IndeksBalasDendam)]));\n\t\t\t\t\tEnd;\n\t\t\t\t\tSet Player Variable(Event Player.PenagihBalasDendam, TargetBalasDendamTerkunci, Null);\n\t\t\t\t\tEvent Player.KematianBalasDendam = False;\n\t\t\t\t\tEvent Player.PenagihBalasDendam = Null;\n\t\t\t\t\tEvent Player.WaktuPaksaBerikut = 0;\n\t\t\t\t\tEvent Player.WaktuPaksaBerakhir = 0;\n\t\t\t\t\tAbort;\n\t\t\t\tEnd;\n\t\t\t\tIf(And(Event Player.PenagihBalasDendam != Null, Entity Exists(Event Player.PenagihBalasDendam)));\n\t\t\t\t\tSet Player Variable(Event Player.PenagihBalasDendam, TargetBalasDendamTerkunci, Null);\n\t\t\t\tEnd;\n\t\t\t\tEvent Player.KematianBalasDendam = False;\n\t\t\t\tEvent Player.PenagihBalasDendam = Null;\n\t\t\t\tEvent Player.WaktuPaksaBerikut = 0;\n\t\t\t\tEvent Player.WaktuPaksaBerakhir = 0;\n\t\t\tElse;\n\t\t\t\tAbort;\n\t\t\tEnd;\n\t\tEnd;\n\t\tAbort If(Attacker == Null);\n\t\tAbort If(Attacker == Event Player);\n\t\tAbort If(Player Variable(Attacker, Manusia) == False);\n\t\tEvent Player.IndeksBalasDendam = Index Of Array Value(Event Player.PembunuhBalasDendam, Attacker);\n\t\tIf(Event Player.IndeksBalasDendam < 0);\n\t\t\tEvent Player.PembunuhBalasDendam = Append To Array(Event Player.PembunuhBalasDendam, Attacker);\n\t\t\tEvent Player.JumlahBalasDendam = Append To Array(Event Player.JumlahBalasDendam, 1);\n\t\tElse;\n\t\t\tModify Player Variable At Index(Event Player, JumlahBalasDendam, Event Player.IndeksBalasDendam, Add, 1);\n\t\tEnd;\n\t}\n}\n\nregola("18c - Kebal: Nonaktifkan hanya mode 1 HP di Ruang Muncul")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.Manusia == True;\n\t\tEvent Player.ModeKebal == 1;\n\t\tIs In Spawn Room(Event Player) == True;\n\t}\n\n\tazioni\n\t{\n\t\tEvent Player.KebalAktif = False;\n\t\tEvent Player.ModeKebal = 0;\n\t\tEvent Player.KursorKebal = 1;\n\t\tCall Subroutine(EfekPulihkan);\n\t\tClear Status(Event Player, Unkillable);\n\t\tSet Damage Received(Event Player, 100);\n\t\tSet Knockback Received(Event Player, 100);\n\t\tEnable Movement Collision With Players(Event Player);\n\t\tIf(Is Alive(Event Player) == True);\n\t\t\tSet Player Health(Event Player, Max Health(Event Player));\n\t\tEnd;\n\t\tIf(Event Player.IkonKebal != Null);\n\t\t\tDestroy Icon(Event Player.IkonKebal);\n\t\t\tEvent Player.IkonKebal = Null;\n\t\tEnd;\n\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Unkillable: 1 HP (HEALABLE) disabled in Spawn Room.") : Event Player.IndeksBahasa == 1 ? Custom String("Kebal: 1 HP (BISA SEMBUH) dimatikan di ruang muncul.") : Custom String("ปิดโหมดฆ่าไม่ตาย: 1 HP (รักษาได้) ในห้องเกิดแล้ว"));\n\t}\n}\n\nregola("18f - Nasib: Bersihkan efek saat mati")\n{\n\tevento\n\t{\n\t\tPlayer Died;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tOr(Event Player.KartuNasibAktif == True, Or(Event Player.PutaranKartuNasib > 0, Event Player.EfekNasib != 0)) == True;\n\t\tIs Alive(Event Player) == False;\n\t}\n\n\tazioni\n\t{\n\t\tCall Subroutine(PulihkanNasibPemain);\n\t\tEvent Player.MenuNasibHarusDibuka = Event Player.MenuTerbuka == False;\n\t}\n}\n\nregola("18g - Nasib: Buka kembali menu setelah efek selesai")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.Manusia == True;\n\t\tEvent Player.MenuNasibHarusDibuka == True;\n\t\tEvent Player.KartuNasibAktif == False;\n\t\tHas Spawned(Event Player) == True;\n\t\tIs Alive(Event Player) == True;\n\t}\n\n\tazioni\n\t{\n\t\tEvent Player.InputMenuDikunci = False;\n\t\tEvent Player.PerintahMenu = 0;\n\t\tEvent Player.MenuTerbuka = True;\n\t\tEvent Player.HalamanMenu = 10;\n\t\tCall Subroutine(GambarMenu);\n\t\tEvent Player.MenuNasibHarusDibuka = False;\n\t}\n}\n\nregola("18i - Nasib: Visi menampilkan nama publik dan bot")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tOr(Event Player.TeksVisiNasib == Null, Event Player.TeksVisiNasib == 0) == True;\n\t\tIs Alive(Event Player) == True;\n\t\tOr(Is Dummy Bot(Event Player) == True, Or(Event Player.BotOtomatis == True, And(Event Player.Manusia == True, Event Player.PrivasiInspeksiAktif == False))) == True;\n\t\tCount Of(Filtered Array(All Players(All Teams), And(Current Array Element != Event Player, And(Player Variable(Current Array Element, Manusia) == True, Player Variable(Current Array Element, PrivasiNasibAktif) == True)))) > 0;\n\t}\n\n\tazioni\n\t{\n\t\tCreate In-World Text(Filtered Array(All Players(All Teams), And(Current Array Element != Event Player, And(Player Variable(Current Array Element, Manusia) == True, Player Variable(Current Array Element, PrivasiNasibAktif) == True))), Custom String("{0} {1} | {2}", Hero Icon String(Is Duplicating(Event Player) ? Hero Being Duplicated(Event Player) : Hero Of(Event Player)), Custom String("{0}", Event Player), Round To Integer(Health(Event Player), Down)), Eye Position(Event Player) + Vector(0, 0.450, 0), 1.100, Do Not Clip, Visible To Position String and Color, Event Player.Manusia == True ? Event Player.WarnaNama : Custom Color(236, 153, 0, 255), Visible Never);\n\t\tEvent Player.TeksVisiNasib = Last Text ID;\n\t}\n}\n\nregola("18j - Nasib: Bersihkan nama visi saat tidak diperlukan")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tAnd(Event Player.TeksVisiNasib != Null, Event Player.TeksVisiNasib != 0) == True;\n\t\tOr(Or(Is Alive(Event Player) == False, And(Event Player.Manusia == True, Event Player.PrivasiInspeksiAktif == True)), Count Of(Filtered Array(All Players(All Teams), And(Current Array Element != Event Player, And(Player Variable(Current Array Element, Manusia) == True, Player Variable(Current Array Element, PrivasiNasibAktif) == True)))) == 0) == True;\n\t}\n\n\tazioni\n\t{\n\t\tDestroy In-World Text(Event Player.TeksVisiNasib);\n\t\tEvent Player.TeksVisiNasib = Null;\n\t}\n}\n\nregola("18k - Nasib: HUD efek dan durasi saat menu tertutup")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.Manusia == True;\n\t\tEvent Player.KartuNasibAktif == True;\n\t\tEvent Player.PutaranKartuNasib == 0;\n\t\tEvent Player.EfekNasibBerakhir > 0;\n\t\tEvent Player.HudEfekNasib == Null;\n\t\tIs Alive(Event Player) == True;\n\t}\n\n\tazioni\n\t{\n\t\tCreate HUD Text(Event Player, Null, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\\n{1}", Event Player.EfekNasib == 1 ? Custom String("VISION: PUBLIC PLAYER / BOT NAMES") : Event Player.EfekNasib == 2 ? Custom String("AIM-STEERED ACCELERATION") : Event Player.EfekNasib == 5 ? Custom String("BURNING: 5% MAX HP / SEC") : Custom String("HACKED"), Custom String("{0}s REMAINING", Max(0, Round To Integer(Event Player.EfekNasibBerakhir - Total Time Elapsed, Up)))) : Event Player.IndeksBahasa == 1 ? Custom String("{0}\\n{1}", Event Player.EfekNasib == 1 ? Custom String("VISI: NAMA PLAYER PUBLIK / BOT") : Event Player.EfekNasib == 2 ? Custom String("AKSELERASI MENGIKUTI BIDIKAN") : Event Player.EfekNasib == 5 ? Custom String("TERBAKAR: 5% HP MAKS / DETIK") : Custom String("DIRETAS"), Custom String("TERSISA {0}dtk", Max(0, Round To Integer(Event Player.EfekNasibBerakhir - Total Time Elapsed, Up)))) : Custom String("{0}\\n{1}", Event Player.EfekNasib == 1 ? Custom String("วิสัยทัศน์: ชื่อผู้เล่นสาธารณะ / บอต") : Event Player.EfekNasib == 2 ? Custom String("เร่งความเร็วตามทิศเล็ง") : Event Player.EfekNasib == 5 ? Custom String("ไฟไหม้: 5% HP สูงสุด / วินาที") : Custom String("ถูกแฮ็ก"), Custom String("เหลือ {0} วินาที", Max(0, Round To Integer(Event Player.EfekNasibBerakhir - Total Time Elapsed, Up)))), Top, 3, Custom Color(255, 255, 255, 255), Custom Color(255, 255, 255, 255), Globale.RGB, Visible To String and Color, Visible Never);\n\t\tEvent Player.HudEfekNasib = Last Text ID;\n\t}\n}\n\nregola("19 - Teleportasi Jongkok: Buka empat halaman selama Jongkok ditahan")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.Manusia == True;\n\t\tEvent Player.BotOtomatis == False;\n\t\tIs Dummy Bot(Event Player) == False;\n\t\tEvent Player.MenuTerbuka == False;\n\t\tEvent Player.KartuNasibAktif == False;\n\t\tEvent Player.PrivasiNasibAktif == False;\n\t\tEvent Player.TeleportasiJongkokAktif == False;\n\t\tEvent Player.TeleportasiJongkokDiaktifkan == True;\n\t\tHas Spawned(Event Player) == True;\n\t\tIs Alive(Event Player) == True;\n\t\tIs Button Held(Event Player, Button(Crouch)) == True;\n\t}\n\n\tazioni\n\t{\n\t\tEvent Player.TeleportasiJongkokAktif = True;\n\t\tEvent Player.PerintahTeleportasi = 0;\n\t\tEvent Player.DaftarTargetTeleportasi = Empty Array;\n\t\tEvent Player.CalonTargetTeleportasi = Null;\n\t\tEvent Player.JenisTeleportasiTerkunci = -1;\n\t\tEvent Player.TargetTeleportasiTerkunci = Null;\n\t\tDisallow Button(Event Player, Button(Primary Fire));\n\t\tDisallow Button(Event Player, Button(Secondary Fire));\n\t\tDisallow Button(Event Player, Button(Interact));\n\t\tCall Subroutine(GambarTeleportasi);\n\t}\n}\n\nregola("19a - Teleportasi Jongkok: Primary maju, Secondary mundur, Interact jalankan")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.TeleportasiJongkokAktif == True;\n\t\tEvent Player.PerintahTeleportasi == 0;\n\t\tIs Button Held(Event Player, Button(Crouch)) == True;\n\t\tOr(Or(Is Button Held(Event Player, Button(Primary Fire)), Is Button Held(Event Player, Button(Secondary Fire))), Is Button Held(Event Player, Button(Interact))) == True;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Is Button Held(Event Player, Button(Primary Fire)));\n\t\t\tEvent Player.PerintahTeleportasi = 1;\n\t\tElse If(Is Button Held(Event Player, Button(Secondary Fire)));\n\t\t\tEvent Player.PerintahTeleportasi = 2;\n\t\tElse;\n\t\t\tEvent Player.PerintahTeleportasi = 3;\n\t\tEnd;\n\t}\n}\n\nregola("19b - Teleportasi Jongkok: Lepaskan pengunci navigasi dan aksi")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.TeleportasiJongkokAktif == True;\n\t\tEvent Player.PerintahTeleportasi != 0;\n\t\tIs Button Held(Event Player, Button(Primary Fire)) == False;\n\t\tIs Button Held(Event Player, Button(Secondary Fire)) == False;\n\t\tIs Button Held(Event Player, Button(Interact)) == False;\n\t}\n\n\tazioni\n\t{\n\t\tEvent Player.PerintahTeleportasi = 0;\n\t}\n}\n\nregola("19c - Teleportasi Jongkok: Primary maju dan Secondary mundur empat halaman")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.TeleportasiJongkokAktif == True;\n\t\tOr(Event Player.PerintahTeleportasi == 1, Event Player.PerintahTeleportasi == 2) == True;\n\t}\n\n\tazioni\n\t{\n\t\tEvent Player.KursorTeleportasi = (Event Player.KursorTeleportasi + (Event Player.PerintahTeleportasi == 1 ? 1 : 3)) % 4;\n\t\tIf(And(Event Player.KursorTeleportasi != 2, Event Player.KursorTeleportasi != 3));\n\t\t\tEvent Player.CalonTargetTeleportasi = Null;\n\t\t\tIf(Event Player.TeksTeleportasi != Null);\n\t\t\t\tDestroy In-World Text(Event Player.TeksTeleportasi);\n\t\t\tEnd;\n\t\t\tEvent Player.TeksTeleportasi = Null;\n\t\t\tEvent Player.TargetTeleportasiTeks = Null;\n\t\t\tIf(Event Player.PelatNamaDinonaktifkan == True);\n\t\t\t\tEnable Nameplates(All Players(All Teams), Event Player);\n\t\t\t\tEvent Player.PelatNamaDinonaktifkan = False;\n\t\t\tEnd;\n\t\tElse;\n\t\t\tIf(Event Player.TeksDunia != Null);\n\t\t\t\tDestroy In-World Text(Event Player.TeksDunia);\n\t\t\tEnd;\n\t\t\tIf(Index Of Array Value(Globale.PemainManusia, Event Player) >= 0);\n\t\t\t\tGlobale.TeksDuniaPemain[Index Of Array Value(Globale.PemainManusia, Event Player)] = 0;\n\t\t\tEnd;\n\t\t\tEvent Player.TeksDunia = Null;\n\t\t\tEvent Player.TargetInspeksi = Null;\n\t\t\tEvent Player.InspeksiAktif = False;\n\t\t\tIf(Event Player.TeksTeleportasi != Null);\n\t\t\t\tDestroy In-World Text(Event Player.TeksTeleportasi);\n\t\t\tEnd;\n\t\t\tEvent Player.TeksTeleportasi = Null;\n\t\t\tEvent Player.TargetTeleportasiTeks = Null;\n\t\t\tCall Subroutine(SegarkanTargetTeleportasi);\n\t\tEnd;\n\t\tCall Subroutine(GambarTeleportasi);\n\t}\n}\n\nregola("19d - Teleportasi Jongkok: Buat ulang nama saat target berubah")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.Manusia == True;\n\t\tEvent Player.TeleportasiJongkokAktif == True;\n\t\tOr(Event Player.KursorTeleportasi == 2, Event Player.KursorTeleportasi == 3) == True;\n\t\tIs Alive(Event Player) == True;\n\t\tIs Button Held(Event Player, Button(Crouch)) == True;\n\t\tEvent Player.TargetTeleportasiTeks != Event Player.CalonTargetTeleportasi;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.TeksTeleportasi != Null);\n\t\t\tDestroy In-World Text(Event Player.TeksTeleportasi);\n\t\tEnd;\n\t\tEvent Player.TeksTeleportasi = Null;\n\t\tIf(Event Player.CalonTargetTeleportasi == Null);\n\t\t\tEvent Player.TargetTeleportasiTeks = Null;\n\t\t\tAbort;\n\t\tEnd;\n\t\tDisable Nameplates(All Players(All Teams), Event Player);\n\t\tEvent Player.PelatNamaDinonaktifkan = True;\n\t\tCreate In-World Text(Event Player, Custom String("{0} {1} | {2}", Hero Icon String(Is Duplicating(Event Player.CalonTargetTeleportasi) ? Hero Being Duplicated(Event Player.CalonTargetTeleportasi) : Hero Of(Event Player.CalonTargetTeleportasi)), Custom String("{0}", Event Player.CalonTargetTeleportasi), Round To Integer(Health(Event Player.CalonTargetTeleportasi), Down)), Eye Position(Event Player.CalonTargetTeleportasi) + Vector(0, 0.450, 0), 1.100, Do Not Clip, Visible To Position String and Color, Player Variable(Event Player.CalonTargetTeleportasi, Manusia) == True ? Player Variable(Event Player.CalonTargetTeleportasi, WarnaNama) : Custom Color(236, 153, 0, 255), Visible Never);\n\t\tEvent Player.TeksTeleportasi = Last Text ID;\n\t\tEvent Player.TargetTeleportasiTeks = Event Player.CalonTargetTeleportasi;\n\t}\n}\n\nregola("19e - Teleportasi Jongkok: Interact menjalankan halaman aktif")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.TeleportasiJongkokAktif == True;\n\t\tEvent Player.PerintahTeleportasi == 3;\n\t}\n\n\tazioni\n\t{\n\t\tEvent Player.JenisTeleportasiTerkunci = Event Player.KursorTeleportasi;\n\t\tEvent Player.TargetTeleportasiTerkunci = Null;\n\t\tIf(Or(Event Player.JenisTeleportasiTerkunci == 2, Event Player.JenisTeleportasiTerkunci == 3));\n\t\t\tCall Subroutine(SegarkanTargetTeleportasi);\n\t\t\tEvent Player.TargetTeleportasiTerkunci = Event Player.CalonTargetTeleportasi;\n\t\tEnd;\n\t\tIf(Event Player.JenisTeleportasiTerkunci == 0);\n\t\t\tCall Subroutine(TeleportKeSpawn);\n\t\tElse If(Event Player.JenisTeleportasiTerkunci == 1);\n\t\t\tCall Subroutine(TeleportKeObjektif);\n\t\tElse If(Event Player.JenisTeleportasiTerkunci == 2);\n\t\t\tCall Subroutine(TeleportKeTarget);\n\t\tElse;\n\t\t\tIf(Or(Or(Event Player.TargetTeleportasiTerkunci == Null, Entity Exists(Event Player.TargetTeleportasiTerkunci) == False), Or(Has Spawned(Event Player.TargetTeleportasiTerkunci) == False, Is Alive(Event Player.TargetTeleportasiTerkunci) == False)));\n\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Attach target unavailable.") : Event Player.IndeksBahasa == 1 ? Custom String("Target tempel tidak tersedia.") : Custom String("เป้าหมายสำหรับเกาะไม่พร้อมใช้งาน"));\n\t\t\tElse If(And(Player Variable(Event Player.TargetTeleportasiTerkunci, LampiranTeleportasiAktif) == True, Player Variable(Event Player.TargetTeleportasiTerkunci, TargetLampiranTeleportasi) == Event Player));\n\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Attach refused: that would create a loop.") : Event Player.IndeksBahasa == 1 ? Custom String("Tempel ditolak: itu akan membuat lingkaran.") : Custom String("ไม่สามารถเกาะได้ เพราะจะเกิดวงวน"));\n\t\t\tElse;\n\t\t\t\tIf(Event Player.LampiranTeleportasiAktif == True);\n\t\t\t\t\tDetach Players(Event Player);\n\t\t\t\tEnd;\n\t\t\t\tEvent Player.TargetLampiranTeleportasi = Event Player.TargetTeleportasiTerkunci;\n\t\t\t\tEvent Player.PahlawanLampiranSendiri = Hero Of(Event Player);\n\t\t\t\tEvent Player.PahlawanLampiranTarget = Hero Of(Event Player.TargetLampiranTeleportasi);\n\t\t\t\tEvent Player.LampiranTeleportasiAktif = True;\n\t\t\t\tAttach Players(Event Player, Event Player.TargetLampiranTeleportasi, Vector(0, Y Component Of(Eye Position(Event Player.TargetLampiranTeleportasi)) - Y Component Of(Position Of(Event Player.TargetLampiranTeleportasi)) + 0.750, 0));\n\t\t\t\tDisallow Button(Event Player, Button(Reload));\n\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Attached above {0}. CROUCH + RELOAD detaches.", Event Player.TargetLampiranTeleportasi) : Event Player.IndeksBahasa == 1 ? Custom String("Menempel di atas {0}. JONGKOK + RELOAD untuk lepas.", Event Player.TargetLampiranTeleportasi) : Custom String("เกาะอยู่เหนือ {0} กดย่อ + รีโหลดเพื่อปล่อย", Event Player.TargetLampiranTeleportasi));\n\t\t\tEnd;\n\t\tEnd;\n\t\tEvent Player.JenisTeleportasiTerkunci = -1;\n\t\tEvent Player.TargetTeleportasiTerkunci = Null;\n\t}\n}\n\nregola("19f - Teleportasi Jongkok: Reload melepas lampiran")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.LampiranTeleportasiAktif == True;\n\t\tIs Button Held(Event Player, Button(Crouch)) == True;\n\t\tIs Button Held(Event Player, Button(Reload)) == True;\n\t}\n\n\tazioni\n\t{\n\t\tDetach Players(Event Player);\n\t\tSet Player Variable(Event Player, LampiranTeleportasiAktif, False);\n\t\tSet Player Variable(Event Player, TargetLampiranTeleportasi, Null);\n\t\tSet Player Variable(Event Player, PahlawanLampiranSendiri, Null);\n\t\tSet Player Variable(Event Player, PahlawanLampiranTarget, Null);\n\t\tAllow Button(Event Player, Button(Reload));\n\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Detached.") : Event Player.IndeksBahasa == 1 ? Custom String("Sudah lepas.") : Custom String("ปล่อยแล้ว"));\n\t}\n}\n\nregola("19h - Teleportasi Jongkok: Lepas lampiran saat state berubah")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.LampiranTeleportasiAktif == True;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Or(Has Spawned(Event Player) == False, Is Alive(Event Player) == False));\n\t\tDetach Players(Event Player);\n\t\tSet Player Variable(Event Player, LampiranTeleportasiAktif, False);\n\t\tSet Player Variable(Event Player, TargetLampiranTeleportasi, Null);\n\t\tSet Player Variable(Event Player, PahlawanLampiranSendiri, Null);\n\t\tSet Player Variable(Event Player, PahlawanLampiranTarget, Null);\n\t\tAllow Button(Event Player, Button(Reload));\n\t\t\tAbort;\n\t\tEnd;\n\t\tIf(Or(Event Player.TargetLampiranTeleportasi == Null, Entity Exists(Event Player.TargetLampiranTeleportasi) == False));\n\t\tDetach Players(Event Player);\n\t\tSet Player Variable(Event Player, LampiranTeleportasiAktif, False);\n\t\tSet Player Variable(Event Player, TargetLampiranTeleportasi, Null);\n\t\tSet Player Variable(Event Player, PahlawanLampiranSendiri, Null);\n\t\tSet Player Variable(Event Player, PahlawanLampiranTarget, Null);\n\t\tAllow Button(Event Player, Button(Reload));\n\t\t\tAbort;\n\t\tEnd;\n\t\tIf(Or(Has Spawned(Event Player.TargetLampiranTeleportasi) == False, Is Alive(Event Player.TargetLampiranTeleportasi) == False));\n\t\tDetach Players(Event Player);\n\t\tSet Player Variable(Event Player, LampiranTeleportasiAktif, False);\n\t\tSet Player Variable(Event Player, TargetLampiranTeleportasi, Null);\n\t\tSet Player Variable(Event Player, PahlawanLampiranSendiri, Null);\n\t\tSet Player Variable(Event Player, PahlawanLampiranTarget, Null);\n\t\tAllow Button(Event Player, Button(Reload));\n\t\t\tAbort;\n\t\tEnd;\n\t\tIf(Or(Hero Of(Event Player) != Event Player.PahlawanLampiranSendiri, Hero Of(Event Player.TargetLampiranTeleportasi) != Event Player.PahlawanLampiranTarget));\n\t\tDetach Players(Event Player);\n\t\tSet Player Variable(Event Player, LampiranTeleportasiAktif, False);\n\t\tSet Player Variable(Event Player, TargetLampiranTeleportasi, Null);\n\t\tSet Player Variable(Event Player, PahlawanLampiranSendiri, Null);\n\t\tSet Player Variable(Event Player, PahlawanLampiranTarget, Null);\n\t\tAllow Button(Event Player, Button(Reload));\n\t\t\tAbort;\n\t\tEnd;\n\t\tIf(And(Player Variable(Event Player.TargetLampiranTeleportasi, Manusia) == True, Player Variable(Event Player.TargetLampiranTeleportasi, PrivasiInspeksiAktif) == True));\n\t\tDetach Players(Event Player);\n\t\tSet Player Variable(Event Player, LampiranTeleportasiAktif, False);\n\t\tSet Player Variable(Event Player, TargetLampiranTeleportasi, Null);\n\t\tSet Player Variable(Event Player, PahlawanLampiranSendiri, Null);\n\t\tSet Player Variable(Event Player, PahlawanLampiranTarget, Null);\n\t\tAllow Button(Event Player, Button(Reload));\n\t\tEnd;\n\t}\n}\n\nregola("19g - Teleportasi Jongkok: Tutup saat Jongkok dilepas")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.TeleportasiJongkokAktif == True;\n\t\tOr(Or(Or(Is