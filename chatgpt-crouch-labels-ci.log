ent Player.MenitLobi = 0;\n\t\tEvent Player.UrutanHUD = First Of(Globale.SlotHUDTersedia);\n\t\tGlobale.SlotHUDTerakhir = Max(Globale.SlotHUDTerakhir, Event Player.UrutanHUD);\n\t\tModify Global Variable(SlotHUDTersedia, Remove From Array By Index, 0);\n\t\tGlobale.PemainManusia = Append To Array(Globale.PemainManusia, Event Player);\n\t\tDisable Nameplates(Event Player, Filtered Array(Globale.PemainManusia, Player Variable(Current Array Element, InspeksiAktif) == True));\n\n\t\tGlobale.HudKiriPemain = Append To Array(Globale.HudKiriPemain, 0);\n\t\tGlobale.HudKananPemain = Append To Array(Globale.HudKananPemain, 0);\n\t\tGlobale.HudMenuPemain = Append To Array(Globale.HudMenuPemain, 0);\n\t\tGlobale.TeksDuniaPemain = Append To Array(Globale.TeksDuniaPemain, 0);\n\t\tGlobale.SlotHUDPemain = Append To Array(Globale.SlotHUDPemain, Event Player.UrutanHUD);\n\t\tEvent Player.Manusia = True;\n\t\tEvent Player.PahlawanTerakhir = Hero Of(Event Player);\n\t\tCall Subroutine(HitungPilihan);\n\t}\n}\n\nregola("02b - HUD Pemain: Buat segera setelah klasifikasi selesai")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tGlobale.Siap == True;\n\t\tEvent Player.Manusia == True;\n\t\tEvent Player.BotOtomatis == False;\n\t\tIs Dummy Bot(Event Player) == False;\n\t\tArray Contains(Globale.PemainManusia, Event Player) == True;\n\t\tHas Spawned(Event Player) == True;\n\t\tEvent Player.HudPemainDibuat == False;\n\t\tEvent Player.HudKiri == Null;\n\t\tEvent Player.HudKanan == Null;\n\t}\n\n\tazioni\n\t{\n\t\t"Klasifikasi manusia dan bot sudah selesai. HUD pemain dibuat sekali pada keadaan muncul yang stabil."\n\t\tEvent Player.HudPemainDibuat = True;\n\t\tCreate HUD Text(Globale.PemainManusia, Null, Custom String("{0}{1}{2}", Custom String("{0} {1} {2}",\n\t\t\tGlobale.DaftarIkon[Event Player.IndeksIkon], Hero Icon String(Is Duplicating(Event Player) ? Hero Being Duplicated(Event Player) : Hero Of(Event Player)),\n\t\t\tPlayer Variable(Local Player, IndeksBahasa) == 0 ? Custom String("{0} - {1} MIN", Event Player, Event Player.MenitLobi) : Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String("{0} - {1} MENIT", Event Player, Event Player.MenitLobi) : Custom String("{0} - {1} นาที", Event Player, Event Player.MenitLobi)), Event Player.UrutanHUD == Globale.SlotHUDTerakhir ? Globale.PemimpinPilihan != Null\n\t\t\t? Player Variable(Local Player, IndeksBahasa) == 2 ? Custom String("\\n \\nดาวสายชิล: {0}", Globale.PemimpinPilihan)\n\t\t\t: Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String("\\n \\nBINTANG CHILL: {0}", Globale.PemimpinPilihan)\n\t\t\t: Custom String("\\n \\nCHILL STAR: {0}", Globale.PemimpinPilihan) : Custom String("") : Custom String(""),\n\t\t\tAnd(Globale.DiagnostikPerforma == True, And(Local Player == Host Player, Event Player.UrutanHUD == Globale.SlotHUDTerakhir)) ? Custom String("{0}\\n{1}",\n\t\t\tPlayer Variable(Local Player, IndeksBahasa) == 2 ? Custom String("\\n \\nโหลด {0}% | เฉลี่ย {1}% | สูงสุด {2}%", Server Load,\n\t\t\tServer Load Average, Server Load Peak) : Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String(\n\t\t\t"\\n \\nBEBAN {0}% | RATA {1}% | PUNCAK {2}%", Server Load, Server Load Average, Server Load Peak) : Custom String(\n\t\t\t"\\n \\nLOAD {0}% | AVG {1}% | MAX {2}%", Server Load, Server Load Average, Server Load Peak), Custom String("HUD {0} | IWT {1}",\n\t\t\t10 + Count Of(Filtered Array(Globale.HudKiriPemain, Current Array Element != 0)) + Count Of(Filtered Array(Globale.HudKananPemain,\n\t\t\tCurrent Array Element != 0)) + Count Of(Filtered Array(Globale.HudMenuPemain, Current Array Element != 0)) + Count Of(\n\t\t\tFiltered Array(Globale.PemainManusia, And(Player Variable(Current Array Element, HudEfekNasib) != Null, Player Variable(\n\t\t\tCurrent Array Element, HudEfekNasib) != 0))), Count Of(Filtered Array(Globale.TeksDuniaPemain, Current Array Element != 0)) + Count Of(\n\t\t\tFiltered Array(Globale.PemainManusia, And(Player Variable(Current Array Element, TeksTeleportasi) != Null, Player Variable(\n\t\t\tCurrent Array Element, TeksTeleportasi) != 0))) + Count Of(Filtered Array(All Players(All Teams), And(Player Variable(\n\t\t\tCurrent Array Element, TeksVisiNasib) != Null, Player Variable(Current Array Element, TeksVisiNasib) != 0))))) : Custom String("")), Null, Left,\n\t\t\t1 + Event Player.UrutanHUD, Custom Color(255, 255, 255, 255), Event Player.WarnaNama, Custom Color(255, 255, 255, 255),\n\t\t\tVisible To String and Color, Visible Never);\n\t\tEvent Player.HudKiri = Last Text ID;\n\t\tGlobale.HudKiriPemain[Index Of Array Value(Globale.PemainManusia, Event Player)] = Event Player.HudKiri;\n\t\tCreate HUD Text(Globale.PemainManusia, Null, Custom String("{0} {1} {2}", Globale.DaftarIkon[Event Player.IndeksIkon],\n\t\t\tHero Icon String(Is Duplicating(Event Player) ? Hero Being Duplicated(Event Player) : Hero Of(Event Player)), Custom String("{0} - {1}", Event Player,\n\t\t\tEvent Player.IndeksGenre >= 0 ? Globale.DaftarGenre[Event Player.IndeksGenre] : Player Variable(Local Player, IndeksBahasa) == 0 ? Custom String("no soundtrack yet")\n\t\t\t: Player Variable(Local Player, IndeksBahasa) == 1 ? Custom String("belum pilih musik") : Custom String("ยังไม่ได้เลือกเพลง"))), Null, Right, -13 + Event Player.UrutanHUD,\n\t\t\tCustom Color(255, 255, 255, 255), Event Player.WarnaNama, Custom Color(255, 255, 255, 255), Visible To String and Color, Visible Never);\n\t\tEvent Player.HudKanan = Last Text ID;\n\t\tGlobale.HudKananPemain[Index Of Array Value(Globale.PemainManusia, Event Player)] = Event Player.HudKanan;\n\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String(\n\t\t\t"Welcome to CHILL. Pick a vibe, pick a color, stay weird.") : Event Player.IndeksBahasa == 1 ? Custom String(\n\t\t\t"Selamat datang di CHILL. Pilih vibe, pilih warna, tetap aneh.") : Custom String(\n\t\t\t"ยินดีต้อนรับสู่ CHILL เลือกเพลง เลือกสี แล้วกวนแบบพอดี ๆ"));\n\t}\n}\n\nregola("03c - Bot/Dummy: Kunci saat hidup kembali atau pahlawan berganti")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tGlobale.Siap == True;\n\t\tOr(Is Dummy Bot(Event Player), Event Player.BotOtomatis) == True;\n\t\tHas Spawned(Event Player) == True;\n\t\tIs Alive(Event Player) == True;\n\t\tOr(Event Player.KunciBotAktif == False, Hero Of(Event Player) != Event Player.PahlawanTerakhir) == True;\n\t}\n\n\tazioni\n\t{\n\t\tCall Subroutine(KunciBot);\n\t\tIf(Is Dummy Bot(Event Player) == True);\n\t\t\tEnable Movement Collision With Players(Event Player);\n\t\t\tDisable Movement Collision With Environment(Event Player, False);\n\t\t\tEvent Player.WaktuTeleportasiDummy = Total Time Elapsed + 1;\n\t\t\tSet Respawn Max Time(Event Player, 30);\n\t\tEnd;\n\t}\n}\n\nregola("03d - Bot/Dummy: Buat satu bot acak untuk Tim 1")\n{\n\tevento\n\t{\n\t\tOngoing - Global;\n\t}\n\n\tcondizioni\n\t{\n\t\tGlobale.Siap == True;\n\t\tIs Game In Progress == True;\n\t\tNumber Of Players(Team 1) < Number Of Slots(Team 1) - 1;\n\t\tCount Of(Spawn Points(Team 1)) > 0;\n\t\tCount Of(Filtered Array(All Players(Team 1), Is Dummy Bot(Current Array Element) == True)) == 0;\n\t}\n\n\tazioni\n\t{\n\t\tGlobale.TimDummyAktif = Team 1;\n\t\tCall Subroutine(BuatDummyTim);\n\t}\n}\n\nregola("03d1 - Bot/Dummy: Kosongkan slot Tim 1 untuk pemain")\n{\n\tevento\n\t{\n\t\tOngoing - Global;\n\t}\n\n\tcondizioni\n\t{\n\t\tGlobale.Siap == True;\n\t\tIs Game In Progress == True;\n\t\tNumber Of Players(Team 1) >= Number Of Slots(Team 1);\n\t\tCount Of(Filtered Array(All Players(Team 1), Is Dummy Bot(Current Array Element) == True)) > 0;\n\t}\n\n\tazioni\n\t{\n\t\tGlobale.TimDummyAktif = Team 1;\n\t\tCall Subroutine(LepasDummyTim);\n\t}\n}\n\nregola("03e - Bot/Dummy: Buat satu bot acak untuk Tim 2")\n{\n\tevento\n\t{\n\t\tOngoing - Global;\n\t}\n\n\tcondizioni\n\t{\n\t\tGlobale.Siap == True;\n\t\tIs Game In Progress == True;\n\t\tNumber Of Players(Team 2) < Number Of Slots(Team 2) - 1;\n\t\tCount Of(Spawn Points(Team 2)) > 0;\n\t\tCount Of(Filtered Array(All Players(Team 2), Is Dummy Bot(Current Array Element) == True)) == 0;\n\t}\n\n\tazioni\n\t{\n\t\tGlobale.TimDummyAktif = Team 2;\n\t\tCall Subroutine(BuatDummyTim);\n\t}\n}\n\nregola("03e1 - Bot/Dummy: Kosongkan slot Tim 2 untuk pemain")\n{\n\tevento\n\t{\n\t\tOngoing - Global;\n\t}\n\n\tcondizioni\n\t{\n\t\tGlobale.Siap == True;\n\t\tIs Game In Progress == True;\n\t\tNumber Of Players(Team 2) >= Number Of Slots(Team 2);\n\t\tCount Of(Filtered Array(All Players(Team 2), Is Dummy Bot(Current Array Element) == True)) > 0;\n\t}\n\n\tazioni\n\t{\n\t\tGlobale.TimDummyAktif = Team 2;\n\t\tCall Subroutine(LepasDummyTim);\n\t}\n}\n\nregola("03f - Bot/Dummy: Teleport dari ruang spawn ke objektif")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tGlobale.Siap == True;\n\t\tIs Dummy Bot(Event Player) == True;\n\t\tHas Spawned(Event Player) == True;\n\t\tIs Alive(Event Player) == True;\n\t\tIs In Spawn Room(Event Player) == True;\n\t\tCount Of(Spawn Points(Team Of(Event Player))) > 0;\n\t\tOr(Event Player.WaktuTeleportasiDummy == 0, Total Time Elapsed >= Event Player.WaktuTeleportasiDummy) == True;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.WaktuTeleportasiDummy == 0);\n\t\t\tEvent Player.WaktuTeleportasiDummy = Total Time Elapsed + 1;\n\t\t\tAbort;\n\t\tEnd;\n\t\tEvent Player.PosisiMati = Vector(0, 0, 0);\n\t\tEvent Player.PosisiBangkitAman = Vector(0, 0, 0);\n\t\tIf(Or(Current Game Mode == Game Mode(Trasporto), Current Game Mode == Game Mode(Ibrida)));\n\t\t\tIf(Distance Between(Payload Position, Vector(0, 0, 0)) > 0.100);\n\t\t\t\tEvent Player.PosisiMati = Payload Position;\n\t\t\tEnd;\n\t\tElse If(Current Game Mode == Game Mode(Cattura la Bandiera));\n\t\t\tIf(Distance Between(Flag Position(Opposite Team Of(Team Of(Event Player))), Vector(0, 0, 0)) > 0.100);\n\t\t\t\tEvent Player.PosisiMati = Flag Position(Opposite Team Of(Team Of(Event Player)));\n\t\t\tEnd;\n\t\tElse If(Current Game Mode == Game Mode(Scorta));\n\t\t\tIf(Count Of(Filtered Array(All Players(All Teams), And(Has Spawned(Current Array Element) == True, And(Is Alive(Current Array Element) == True, Is On Objective(Current Array Element) == True)))) > 0);\n\t\t\t\tEvent Player.PosisiMati = Position Of(First Of(Filtered Array(All Players(All Teams), And(Has Spawned(Current Array Element) == True, And(Is Alive(Current Array Element) == True, Is On Objective(Current Array Element) == True)))));\n\t\t\tElse If(Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) > 0.100);\n\t\t\t\tEvent Player.PosisiMati = Objective Position(Objective Index);\n\t\t\tEnd;\n\t\tElse If(Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) > 0.100);\n\t\t\tEvent Player.PosisiMati = Objective Position(Objective Index);\n\t\tEnd;\n\t\tIf(Distance Between(Event Player.PosisiMati, Vector(0, 0, 0)) > 0.100);\n\t\t\tEvent Player.PosisiBangkitAman = Nearest Walkable Position(Event Player.PosisiMati + Direction Towards(Event Player.PosisiMati, Position Of(First Of(Spawn Points(Team Of(Event Player))))) * 10);\n\t\t\tIf(Distance Between(Event Player.PosisiBangkitAman, Event Player.PosisiMati) >= 6);\n\t\t\t\tIf(Distance Between(Event Player.PosisiBangkitAman, Event Player.PosisiMati) <= 16);\n\t\t\t\t\tIf(Distance Between(Ray Cast Hit Position(Event Player.PosisiBangkitAman + Vector(0, 5, 0), Event Player.PosisiBangkitAman - Vector(0, 20, 0), Empty Array, Empty Array, False), Event Player.PosisiBangkitAman) <= 6);\n\t\t\t\t\t\tIf(Distance Between(Event Player.PosisiBangkitAman, Vector(0, 0, 0)) > 0.100);\n\t\t\t\t\t\t\tTeleport(Event Player, Event Player.PosisiBangkitAman);\n\t\t\t\t\t\tEnd;\n\t\t\t\t\tEnd;\n\t\t\t\tEnd;\n\t\t\tEnd;\n\t\tEnd;\n\t\tEvent Player.WaktuTeleportasiDummy = Total Time Elapsed + 1;\n\t}\n}\n\nregola("03g - Bot/Dummy: Hadap dan dekati manusia musuh hidup terdekat")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tGlobale.Siap == True;\n\t\tIs Dummy Bot(Event Player) == True;\n\t\tHas Spawned(Event Player) == True;\n\t\tIs Alive(Event Player) == True;\n\t\tEvent Player.TargetDummyIkuti != Null;\n\t\tEntity Exists(Event Player.TargetDummyIkuti) == True;\n\t\tPlayer Variable(Event Player.TargetDummyIkuti, Manusia) == True;\n\t\tPlayer Variable(Event Player.TargetDummyIkuti, IzinkanDummyMengikuti) == True;\n\t\tHas Spawned(Event Player.TargetDummyIkuti) == True;\n\t\tIs Alive(Event Player.TargetDummyIkuti) == True;\n\t\tTeam Of(Event Player.TargetDummyIkuti) == Opposite Team Of(Team Of(Event Player));\n\t}\n\n\tazioni\n\t{\n\t\tStart Facing(Event Player, Direction Towards(Eye Position(Event Player), Eye Position(Event Player.TargetDummyIkuti)), 1000, To World, Direction and Turn Rate);\n\t\tStart Throttle In Direction(Event Player, Forward, Or(Is In Spawn Room(Event Player), Distance Between(Event Player, Event Player.TargetDummyIkuti) <= 4) ? 0 : 1, To Player, Replace Existing Throttle, Direction and Magnitude);\n\t}\n}\n\nregola("03h - Bot/Dummy: Hentikan gerak saat tidak ada manusia musuh hidup")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tGlobale.Siap == True;\n\t\tIs Dummy Bot(Event Player) == True;\n\t\tOr(Or(Or(Event Player.TargetDummyIkuti == Null, Entity Exists(Event Player.TargetDummyIkuti) == False), Or(Player Variable(Event Player.TargetDummyIkuti, Manusia) == False, Player Variable(Event Player.TargetDummyIkuti, IzinkanDummyMengikuti) == False)), Or(Or(Has Spawned(Event Player.TargetDummyIkuti) == False, Is Alive(Event Player.TargetDummyIkuti) == False), Team Of(Event Player.TargetDummyIkuti) != Opposite Team Of(Team Of(Event Player)))) == True;\n\t}\n\n\tazioni\n\t{\n\t\tStop Facing(Event Player);\n\t\tStop Throttle In Direction(Event Player);\n\t}\n}\n\nregola("03i - Bot/Dummy: Hentikan gerak saat bot mati")\n{\n\tevento\n\t{\n\t\tPlayer Died;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tIs Dummy Bot(Event Player) == True;\n\t\tIs Alive(Event Player) == False;\n\t}\n\n\tazioni\n\t{\n\t\tStop Facing(Event Player);\n\t\tStop Throttle In Direction(Event Player);\n\t\tEvent Player.WaktuTeleportasiDummy = 0;\n\t\tEvent Player.TargetDummyIkuti = Null;\n\t}\n}\n\nregola("04 - Pemain Keluar: Tenangkan lalu bersihkan pendaftaran")\n{\n\tevento\n\t{\n\t\tPlayer Left Match;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tIs Dummy Bot(Event Player) == False;\n\t\tOr(Event Player.BotOtomatis == True, Or(Event Player.Manusia == True, Array Contains(Globale.PemainManusia, Event Player))) == True;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.BotOtomatis == True);\n\t\t\tIf(Event Player.TeksVisiNasib != Null);\n\t\t\t\tDestroy In-World Text(Event Player.TeksVisiNasib);\n\t\t\tEnd;\n\t\t\tEvent Player.TeksVisiNasib = Null;\n\t\t\tAbort;\n\t\tEnd;\n\t\tCall Subroutine(TenangkanPemain);\n\t\tWait(0.050, Ignora condizione);\n\t\tCall Subroutine(BersihkanPemain);\n\t}\n}\n\nregola("04g - Utama global: Penjadwal pusat 20 Hz")\n{\n\tevento\n\t{\n\t\tOngoing - Global;\n\t}\n\n\tcondizioni\n\t{\n\t\tGlobale.Siap == True;\n\t}\n\n\tazioni\n\t{\n\t\t"Langkah 0,05 detik adalah satu-satunya sumber tick dan satu-satunya Loop di seluruh skrip."\n\t\tGlobale.LangkahPenjadwal = (Globale.LangkahPenjadwal + 1) % 200;\n\t\tIf(Globale.LangkahPenjadwal % 2 == 0);\n\t\t\tGlobale.RGB = Custom Color(\n\t\t\t\t80 + (Globale.RGBFase < 255 ? 255 : Globale.RGBFase < 510 ? 510 - Globale.RGBFase : Globale.RGBFase < 1020 ? 0 : Globale.RGBFase < 1275 ? Globale.RGBFase - 1020 : 255) * 0.686,\n\t\t\t\t80 + (Globale.RGBFase < 255 ? Globale.RGBFase : Globale.RGBFase < 765 ? 255 : Globale.RGBFase < 1020 ? 1020 - Globale.RGBFase : 0) * 0.686,\n\t\t\t\t80 + (Globale.RGBFase < 510 ? 0 : Globale.RGBFase < 765 ? Globale.RGBFase - 510 : Globale.RGBFase < 1275 ? 255 : 1530 - Globale.RGBFase) * 0.686,\n\t\t\t\t255);\n\t\t\tGlobale.RGBFase = (Globale.RGBFase + 3) % 1530;\n\t\tEnd;\n\t\tIf(And(Globale.LangkahPenjadwal % 20 == 0, Globale.MulaiUlangSudahDiminta == False));\n\t\t\tGlobale.SisaWaktuServer = Max(0, Round To Integer(Globale.WaktuAkhirServer - Total Time Elapsed, Up));\n\t\t\tGlobale.TeksWaktuServer = Globale.SisaWaktuServer % 60 < 10 ? Custom String("{0}:0{1}", Round To Integer(Globale.SisaWaktuServer / 60, Down),\n\t\t\t\tGlobale.SisaWaktuServer % 60) : Custom String("{0}:{1}", Round To Integer(Globale.SisaWaktuServer / 60, Down), Globale.SisaWaktuServer % 60);\n\t\tEnd;\n\t\t"Indeks dan pemain aktif hanya dimiliki penjadwal; tidak ada jeda selama pemindaian."\n\t\tFor Global Variable(IndeksPemainGlobal, 0, Count Of(All Players(All Teams)), 1);\n\t\t\tGlobale.PemainAktif = All Players(All Teams)[Globale.IndeksPemainGlobal];\n\t\t\tCall Subroutine(ProsesCepatPemain);\n\t\t\tCall Subroutine(ProsesNasibPemain);\n\t\t\tIf(Globale.LangkahPenjadwal % 2 == 0);\n\t\t\t\tCall Subroutine(ProsesSiklusPemain);\n\t\t\tEnd;\n\t\t\tIf(Globale.LangkahPenjadwal % 20 == 0);\n\t\t\t\tCall Subroutine(ProsesCachePemain);\n\t\t\tEnd;\n\t\t\tIf(And(Globale.LangkahPenjadwal == 0, And(Globale.PemainAktif.Manusia == True, Entity Exists(Globale.PemainAktif))));\n\t\t\t\tSet Player Variable(Globale.PemainAktif, MenitLobi, Max(0, Round To Integer((Total Time Elapsed - Globale.PemainAktif.WaktuMasuk) / 60, Down)));\n\t\t\tEnd;\n\t\tEnd;\n\t\tGlobale.PemainAktif = Null;\n\t\tWait(0.050, Ignora condizione);\n\t\tLoop If Condition Is True;\n\t}\n}\n\nregola("05 - Menu: Tahan serangan jarak dekat 0,5 detik untuk buka atau tutup")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.Manusia == True;\n\t\tEvent Player.BotOtomatis == False;\n\t\tIs Dummy Bot(Event Player) == False;\n\t\tIs Alive(Event Player) == True;\n\t\tEvent Player.SeranganDekatDipakai == False;\n\t\tEvent Player.TeleportasiJongkokAktif == False;\n\t\tEvent Player.KartuNasibAktif == False;\n\t\tIs Button Held(Event Player, Button(Melee)) == True;\n\t}\n\n\tazioni\n\t{\n\t\tWait(0.500, Annulla quando è False);\n\t\tEvent Player.SeranganDekatDipakai = True;\n\t\tIf(Event Player.MenuTerbuka == True);\n\t\t\tCall Subroutine(TutupMenu);\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Arcade Menu closed. Back to professionally doing nothing.") : Event Player.IndeksBahasa == 1 ? Custom String("Menu Arcade ditutup. Kembali CHILL dengan penuh tanggung jawab.") : Custom String("ปิดเมนูอาร์เคดแล้ว กลับไป CHILL อย่างมืออาชีพได้"));\n\t\tElse;\n\t\t\tEvent Player.MenuTerbuka = True;\n\t\t\tEvent Player.HalamanMenu = -1;\n\t\t\tCall Subroutine(GambarMenu);\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Arcade Menu online. Thirteen extremely important decisions await.") : Event Player.IndeksBahasa == 1 ? Custom String("Menu Arcade online. Tiga belas keputusan yang sangat penting menunggu.") : Custom String("เปิดเมนูอาร์เคดแล้ว มีสิบสามตัวเลือกสำคัญรอคุณอยู่"));\n\t\tEnd;\n\t}\n}\n\nregola("05b - Menu: Lepaskan serangan jarak dekat sebelum pakai lagi")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.Manusia == True;\n\t\tEvent Player.BotOtomatis == False;\n\t\tIs Dummy Bot(Event Player) == False;\n\t\tEvent Player.SeranganDekatDipakai == True;\n\t\tIs Button Held(Event Player, Button(Melee)) == False;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.MenuTerbuka == False);\n\t\t\tAllow Button(Event Player, Button(Melee));\n\t\tEnd;\n\t\tEvent Player.SeranganDekatDipakai = False;\n\t}\n}\n\nregola("05c - Menu: Pengatur masukan dengan prioritas tetap")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tIs Alive(Event Player) == True;\n\t\tEvent Player.Manusia == True;\n\t\tEvent Player.MenuTerbuka == True;\n\t\tIs Button Held(Event Player, Button(Crouch)) == True;\n\t\tEvent Player.PerintahMenu == 0;\n\t\tEvent Player.InteraksiKameraDipakai == False;\n\t\tEvent Player.KartuNasibAktif == False;\n\t\tOr(Or(Is Button Held(Event Player, Button(Interact)), And(Is Button Held(Event Player, Button(Reload)), Event Player.HalamanMenu != -1)), Or(Or(Is Button Held(Event Player, Button(Primary Fire)), Is Button Held(Event Player, Button(Secondary Fire))), And(Event Player.HalamanMenu == 2, Or(Is Button Held(Event Player, Button(Ability 1)), Is Button Held(Event Player, Button(Ability 2)))))) == True;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Is Button Held(Event Player, Button(Interact)));\n\t\t\tEvent Player.InteraksiKameraDipakai = True;\n\t\t\tEvent Player.PerintahMenu = 1;\n\t\tElse If(And(Is Button Held(Event Player, Button(Reload)), Event Player.HalamanMenu != -1));\n\t\t\tEvent Player.PerintahMenu = 2;\n\t\tElse If(Is Button Held(Event Player, Button(Primary Fire)));\n\t\t\tEvent Player.PerintahMenu = 3;\n\t\tElse If(Is Button Held(Event Player, Button(Secondary Fire)));\n\t\t\tEvent Player.PerintahMenu = 4;\n\t\tElse If(And(Is Button Held(Event Player, Button(Ability 1)), Event Player.HalamanMenu == 2));\n\t\t\tEvent Player.PerintahMenu = 5;\n\t\tElse If(And(Is Button Held(Event Player, Button(Ability 2)), Event Player.HalamanMenu == 2));\n\t\t\tEvent Player.PerintahMenu = 6;\n\t\tEnd;\n\t}\n}\n\nregola("05d - Menu: Lepaskan pengatur setelah semua masukan dilepas")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.Manusia == True;\n\t\tEvent Player.PerintahMenu != 0;\n\t\tAnd(And(Is Button Held(Event Player, Button(Interact)) == False, Is Button Held(Event Player, Button(Reload)) == False), And(And(Is Button Held(Event Player, Button(Primary Fire)) == False, Is Button Held(Event Player, Button(Secondary Fire)) == False), And(Is Button Held(Event Player, Button(Ability 1)) == False, Is Button Held(Event Player, Button(Ability 2)) == False))) == True;\n\t}\n\n\tazioni\n\t{\n\t\t"Aktifkan kembali pengatur segera setelah semua tombol dilepas; pengunci tetap mencegah pengulangan saat tombol ditahan."\n\t\tEvent Player.PerintahMenu = 0;\n\t}\n}\n\nregola("05e - Menu: Crouch mengunci masukan pahlawan hanya saat navigasi")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.Manusia == True;\n\t\tEvent Player.MenuTerbuka == True;\n\t\tEvent Player.InputMenuDikunci == False;\n\t\tIs Button Held(Event Player, Button(Crouch)) == True;\n\t}\n\n\tazioni\n\t{\n\t\tEvent Player.InputMenuDikunci = True;\n\t\tDisallow Button(Event Player, Button(Primary Fire));\n\t\tDisallow Button(Event Player, Button(Secondary Fire));\n\t\tDisallow Button(Event Player, Button(Interact));\n\t\tDisallow Button(Event Player, Button(Reload));\n\t\tDisallow Button(Event Player, Button(Ability 1));\n\t\tDisallow Button(Event Player, Button(Ability 2));\n\t\tDisallow Button(Event Player, Button(Ultimate));\n\t}\n}\n\nregola("05f - Menu: Lepaskan Crouch dan segera pulihkan masukan pahlawan")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tEvent Player.InputMenuDikunci == True;\n\t\tOr(Event Player.MenuTerbuka == False, Is Button Held(Event Player, Button(Crouch)) == False) == True;\n\t}\n\n\tazioni\n\t{\n\t\tAllow Button(Event Player, Button(Primary Fire));\n\t\tAllow Button(Event Player, Button(Secondary Fire));\n\t\tAllow Button(Event Player, Button(Interact));\n\t\tAllow Button(Event Player, Button(Reload));\n\t\tAllow Button(Event Player, Button(Ability 1));\n\t\tAllow Button(Event Player, Button(Ability 2));\n\t\tAllow Button(Event Player, Button(Ultimate));\n\t\tEvent Player.InputMenuDikunci = False;\n\t\tEvent Player.PerintahMenu = 0;\n\t}\n}\n\nregola("06 - Menu: Navigasi berikutnya dan sebelumnya")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tIs Alive(Event Player) == True;\n\t\tEvent Player.Manusia == True;\n\t\tEvent Player.BotOtomatis == False;\n\t\tIs Dummy Bot(Event Player) == False;\n\t\tEvent Player.MenuTerbuka == True;\n\t\tOr(Event Player.PerintahMenu == 3, Event Player.PerintahMenu == 4) == True;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.HalamanMenu == -1);\n\t\t\tEvent Player.KursorUtama = (Event Player.KursorUtama + (Event Player.PerintahMenu == 3 ? 1 : 12)) % 13;\n\t\tElse If(Event Player.HalamanMenu == 0);\n\t\t\tEvent Player.KursorWarna = (Event Player.KursorWarna + (Event Player.PerintahMenu == 3 ? 1 : Count Of(Globale.DaftarWarna) - 1)) % Count Of(Globale.DaftarWarna);\n\t\tElse If(Event Player.HalamanMenu == 1);\n\t\t\tCall Subroutine(SegarkanTargetKamera);\n\t\t\tEvent Player.KursorKamera = (Event Player.KursorKamera + (Event Player.PerintahMenu == 3 ? 1 : Count Of(Event Player.DaftarTargetKamera) + 1)) % (Count Of(Event Player.DaftarTargetKamera) + 2);\n\t\tElse If(Event Player.HalamanMenu == 2);\n\t\t\tEvent Player.KursorGenre = (Event Player.KursorGenre + (Event Player.PerintahMenu == 3 ? 1 : 99)) % 100;\n\t\tElse If(Event Player.HalamanMenu == 3);\n\t\t\tEvent Player.KursorBahasa = (Event Player.KursorBahasa + (Event Player.PerintahMenu == 3 ? 1 : 2)) % 3;\n\t\tElse If(Event Player.HalamanMenu == 4);\n\t\t\tCall Subroutine(SegarkanTargetBalasDendam);\n\t\t\tIf(Count Of(Event Player.DaftarTargetBalasDendam) > 0);\n\t\t\t\tEvent Player.KursorBalasDendam = (Event Player.KursorBalasDendam + (Event Player.PerintahMenu == 3 ? 1 : Count Of(Event Player.DaftarTargetBalasDendam) - 1)) % Count Of(Event Player.DaftarTargetBalasDendam);\n\t\t\tEnd;\n\t\tElse If(Event Player.HalamanMenu == 5);\n\t\t\tEvent Player.KursorKebal = (Event Player.KursorKebal + (Event Player.PerintahMenu == 3 ? 1 : 2)) % 3;\n\t\tElse If(Event Player.HalamanMenu == 6);\n\t\t\tEvent Player.KursorSuara = (Event Player.KursorSuara + (Event Player.PerintahMenu == 3 ? 1 : 4)) % 5;\n\t\tElse If(Event Player.HalamanMenu == 7);\n\t\t\tEvent Player.KursorIkon = (Event Player.KursorIkon + (Event Player.PerintahMenu == 3 ? 1 : Count Of(Globale.DaftarIkon) - 1)) % Count Of(Globale.DaftarIkon);\n\t\tElse If(Event Player.HalamanMenu == 8);\n\t\t\tEvent Player.KursorTeleportasiJongkok = (Event Player.KursorTeleportasiJongkok + 1) % 2;\n\t\tElse If(Event Player.HalamanMenu == 9);\n\t\t\tEvent Player.KursorPrivasiInspeksi = (Event Player.KursorPrivasiInspeksi + 1) % 2;\n\t\tElse If(Event Player.HalamanMenu == 11);\n\t\t\tIf(Count Of(Globale.PemainManusia) > 0);\n\t\t\t\tEvent Player.KursorPilihan = (Event Player.KursorPilihan + (Event Player.PerintahMenu == 3 ? 1 : Count Of(Globale.PemainManusia) - 1)) % Count Of(Globale.PemainManusia);\n\t\t\tEnd;\n\t\tElse If(Event Player.HalamanMenu == 12);\n\t\t\tEvent Player.KursorIkutiDummy = (Event Player.KursorIkutiDummy + 1) % 2;\n\t\tEnd;\n\t\tCall Subroutine(TransisiWarnaMenu);\n\t}\n}\n\nregola("08 - Menu musik: Lompat maju atau mundur sepuluh genre")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tIs Alive(Event Player) == True;\n\t\tEvent Player.Manusia == True;\n\t\tEvent Player.BotOtomatis == False;\n\t\tIs Dummy Bot(Event Player) == False;\n\t\tEvent Player.MenuTerbuka == True;\n\t\tEvent Player.HalamanMenu == 2;\n\t\tOr(Event Player.PerintahMenu == 5, Event Player.PerintahMenu == 6) == True;\n\t}\n\n\tazioni\n\t{\n\t\tEvent Player.KursorGenre = (Event Player.KursorGenre + (Event Player.PerintahMenu == 5 ? 10 : 90)) % 100;\n\t}\n}\n\nregola("10 - Menu: Terapkan halaman aktif")\n{\n\tevento\n\t{\n\t\tOngoing - Each Player;\n\t\tTutti;\n\t\tTutti;\n\t}\n\n\tcondizioni\n\t{\n\t\tIs Alive(Event Player) == True;\n\t\tEvent Player.Manusia == True;\n\t\tEvent Player.BotOtomatis == False;\n\t\tIs Dummy Bot(Event Player) == False;\n\t\tEvent Player.MenuTerbuka == True;\n\t\tEvent Player.PerintahMenu == 1;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.HalamanMenu == -1);\n\t\t\tEvent Player.HalamanMenu = Event Player.KursorUtama;\n\t\t\tIf(Event Player.HalamanMenu == 1);\n\t\t\t\tCall Subroutine(SegarkanTargetKamera);\n\t\t\tElse If(Event Player.HalamanMenu == 4);\n\t\t\t\tCall Subroutine(SegarkanTargetBalasDendam);\n\t\t\tElse If(Event Player.HalamanMenu == 5);\n\t\t\t\tEvent Player.KursorKebal = Event Player.ModeKebal;\n\t\t\tElse If(Event Player.HalamanMenu == 11);\n\t\t\t\tEvent Player.KursorPilihan = And(Event Player.PemainDipilih != Null, Array Contains(Globale.PemainManusia, Event Player.PemainDipilih)) ? Index Of Array Value(Globale.PemainManusia, Event Player.PemainDipilih) : Min(Event Player.KursorPilihan, Max(0, Count Of(Globale.PemainManusia) - 1));\n\t\t\tElse If(Event Player.HalamanMenu == 12);\n\t\t\t\tEvent Player.KursorIkutiDummy = Event Player.IzinkanDummyMengikuti ? 1 : 0;\n\t\t\tEnd;\n\t\t\tCall Subroutine(GambarMenu);\n\t\t\tCall Subroutine(TransisiWarnaMenu);\n\t\tElse If(Event Player.HalamanMenu == 0);\n\t\t\tCall Subroutine(TerapkanHalamanWarna);\n\t\tElse If(Event Player.HalamanMenu == 1);\n\t\t\tCall Subroutine(TerapkanHalamanKamera);\n\t\tElse If(Event Player.HalamanMenu == 2);\n\t\t\tCall Subroutine(TerapkanHalamanMusik);\n\t\tElse If(Event Player.HalamanMenu == 3);\n\t\t\tCall Subroutine(TerapkanHalamanBahasa);\n\t\tElse If(Event Player.HalamanMenu == 4);\n\t\t\tCall Subroutine(TerapkanHalamanBalasDendam);\n\t\tElse If(Event Player.HalamanMenu == 5);\n\t\t\tCall Subroutine(TerapkanHalamanKebal);\n\t\tElse If(Event Player.HalamanMenu == 6);\n\t\t\tCall Subroutine(TerapkanHalamanSuara);\n\t\tElse If(Event Player.HalamanMenu == 7);\n\t\t\tCall Subroutine(TerapkanHalamanIkon);\n\t\tElse If(Event Player.HalamanMenu == 8);\n\t\t\tCall Subroutine(TerapkanTeleportasiJongkok);\n\t\tElse If(Event Player.HalamanMenu == 9);\n\t\t\tCall Subroutine(TerapkanHalamanPrivasiInspeksi);\n\t\tElse If(Event Player.HalamanMenu == 10);\n\t\t\tCall Subroutine(TerapkanHalamanNasib);\n\t\tElse If(Event Player.HalamanMenu == 11);\n\t\t\tCall Subroutine(TerapkanHalamanPilihan);\n\t\tElse If(Event Player.HalamanMenu == 12);\n\t\t\tCall Subroutine(TerapkanHalamanIkutiDummy);\n\t\tEnd;\n\t}\n}\n\nregola("99a - Subrutin: Terapkan halaman musik")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tTerapkanHalamanMusik;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.IndeksGenre != Event Player.KursorGenre);\n\t\t\tEvent Player.IndeksGenre = Event Player.KursorGenre;\n\t\t\tCall Subroutine(EfekTerapkan);\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Soundtrack: {0}. Great taste. Probably.", Globale.DaftarGenre[Event Player.IndeksGenre]) : Event Player.IndeksBahasa == 1 ? Custom String("Musik: {0}. Selera bagus. Mungkin.", Globale.DaftarGenre[Event Player.IndeksGenre]) : Custom String("เลือกเพลง: {0} รสนิยมดี...น่าจะนะ", Globale.DaftarGenre[Event Player.IndeksGenre]));\n\t\tEnd;\n\t}\n}\n\nregola("99b - Subrutin: Terapkan halaman kamera")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tTerapkanHalamanKamera;\n\t}\n\n\tazioni\n\t{\n\t\tCall Subroutine(SegarkanTargetKamera);\n\t\tEvent Player.KursorKamera %= Count Of(Event Player.DaftarTargetKamera) + 2;\n\t\tIf(Event Player.KursorKamera == 0);\n\t\t\tIf(Event Player.ModeKamera != 0);\n\t\t\t\tStop Camera(Event Player);\n\t\t\t\tEvent Player.ModeKamera = 0;\n\t\t\t\tEvent Player.TargetKamera = Null;\n\t\t\t\tCall Subroutine(EfekPulihkan);\n\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("First person restored. Nobody saw that.") : Event Player.IndeksBahasa == 1 ? Custom String("Kamera normal lagi. Anggap tak terjadi.") : Custom String("กลับมุมมองปกติแล้ว ไม่มีใครเห็นหรอก"));\n\t\t\tEnd;\n\t\tElse If(Event Player.KursorKamera == 1);\n\t\t\tIf(Or(Event Player.ModeKamera != 1, Event Player.TargetKamera != Event Player));\n\t\t\t\tEvent Player.TargetKamera = Event Player;\n\t\t\t\tEvent Player.ModeKamera = 1;\n\t\t\t\tCall Subroutine(MulaiKamera);\n\t\t\t\tCall Subroutine(EfekTerapkan);\n\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Third person on. Ego responsibly.") : Event Player.IndeksBahasa == 1 ? Custom String("Kamera 3P aktif. Jangan narsis berlebihan.") : Custom String("เปิดกล้องบุคคลที่สามแล้ว อย่าหลงตัวเองเกินไป"));\n\t\t\tEnd;\n\t\tElse;\n\t\t\tIf(Event Player.KursorKamera - 2 < Count Of(Event Player.DaftarTargetKamera));\n\t\t\t\tEvent Player.CalonTargetKamera = Event Player.DaftarTargetKamera[Event Player.KursorKamera - 2];\n\t\t\tElse;\n\t\t\t\tEvent Player.CalonTargetKamera = Null;\n\t\t\tEnd;\n\t\t\tIf(And(Event Player.CalonTargetKamera != Null, Entity Exists(Event Player.CalonTargetKamera)));\n\t\t\t\tIf(Or(Event Player.ModeKamera != 2, Event Player.TargetKamera != Event Player.CalonTargetKamera));\n\t\t\t\t\tEvent Player.TargetKamera = Event Player.CalonTargetKamera;\n\t\t\t\t\tEvent Player.ModeKamera = 2;\n\t\t\t\t\tCall Subroutine(MulaiKamera);\n\t\t\t\t\tCall Subroutine(EfekTerapkan);\n\t\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Watching {0}. Definitely not stalking.", Event Player.TargetKamera) : Event Player.IndeksBahasa == 1 ? Custom String("Menonton {0}. Bukan stalking. Serius.", Event Player.TargetKamera) : Custom String("กำลังดู {0} อยู่ ไม่ได้สะกดรอยนะ จริง ๆ", Event Player.TargetKamera));\n\t\t\t\tEnd;\n\t\t\tElse;\n\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("That player disappeared. Very on-brand for CHILL.") : Event Player.IndeksBahasa == 1 ? Custom String("Pemainnya menghilang. Sangat sesuai tema CHILL.") : Custom String("ผู้เล่นคนนั้นหายไปแล้ว สมกับเป็นห้อง CHILL จริง ๆ"));\n\t\t\tEnd;\n\t\tEnd;\n\t}\n}\n\nregola("99c - Subrutin: Terapkan halaman warna")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tTerapkanHalamanWarna;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.IndeksWarna != Event Player.KursorWarna);\n\t\t\tEvent Player.IndeksWarna = Event Player.KursorWarna;\n\t\t\tEvent Player.WarnaNama = Globale.DaftarWarna[Event Player.IndeksWarna];\n\t\t\tIf(Event Player.IndeksWarna == 0);\n\t\t\t\tCall Subroutine(EfekPulihkan);\n\t\t\tElse;\n\t\t\t\tCall Subroutine(EfekTerapkan);\n\t\t\tEnd;\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Name color: {0}. Subtlety optional.", Globale.NamaWarnaInggris[Event Player.IndeksWarna]) : Event Player.IndeksBahasa == 1 ? Custom String("Warna nama: {0}. Boleh norak.", Globale.NamaWarna[Event Player.IndeksWarna]) : Custom String("สีชื่อ: {0} เด่นได้ตามใจ", Globale.NamaWarnaThai[Event Player.IndeksWarna]));\n\t\tEnd;\n\t}\n}\n\nregola("99d - Subrutin: Terapkan halaman bahasa")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tTerapkanHalamanBahasa;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.IndeksBahasa != Event Player.KursorBahasa);\n\t\t\tEvent Player.IndeksBahasa = Event Player.KursorBahasa;\n\t\t\tCall Subroutine(EfekTerapkan);\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("HUD language: English.") : Event Player.IndeksBahasa == 1 ? Custom String("Bahasa HUD: Bahasa Indonesia.") : Custom String("ภาษา HUD: ไทย"));\n\t\tEnd;\n\t}\n}\n\nregola("99e - Subrutin: Terapkan halaman balas dendam")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tTerapkanHalamanBalasDendam;\n\t}\n\n\tazioni\n\t{\n\t\tIf(And(Event Player.TargetBalasDendamTerkunci != Null, And(Entity Exists(Event Player.TargetBalasDendamTerkunci), Player Variable(Event Player.TargetBalasDendamTerkunci, PenagihBalasDendam) == Event Player)));\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Revenge is still resolving. The debt changes only after full death.") : Event Player.IndeksBahasa == 1 ? Custom String("Balas dendam masih diproses. Utang berubah hanya setelah mati penuh.") : Custom String("กำลังดำเนินการล้างแค้น หนี้จะเปลี่ยนเมื่อเสียชีวิตอย่างสมบูรณ์เท่านั้น"));\n\t\tElse;\n\t\t\tEvent Player.TargetBalasDendamTerkunci = Null;\n\t\t\tCall Subroutine(SegarkanTargetBalasDendam);\n\t\t\tIf(Count Of(Event Player.DaftarTargetBalasDendam) == 0);\n\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("No revenge targets. Peace has won, temporarily.") : Event Player.IndeksBahasa == 1 ? Custom String("Tidak ada target balas dendam. Damai menang... sementara.") : Custom String("ไม่มีเป้าหมายล้างแค้น ความสงบชนะแล้ว...ชั่วคราว"));\n\t\t\tElse;\n\t\t\t\tEvent Player.KursorBalasDendam %= Count Of(Event Player.DaftarTargetBalasDendam);\n\t\t\t\tEvent Player.TargetBalasDendamTerkunci = Event Player.DaftarTargetBalasDendam[Event Player.KursorBalasDendam];\n\t\t\t\tEvent Player.IndeksBalasDendam = Index Of Array Value(Event Player.PembunuhBalasDendam, Event Player.TargetBalasDendamTerkunci);\n\t\t\t\tIf(Event Player.IndeksBalasDendam < 0);\n\t\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("That player owes you nothing. Suspiciously peaceful.") : Event Player.IndeksBahasa == 1 ? Custom String("Pemain itu tidak punya utang. Damainya mencurigakan sekali.") : Custom String("ผู้เล่นคนนั้นไม่ได้ติดหนี้คุณ สงบเกินจนน่าสงสัย"));\n\t\t\t\t\tEvent Player.TargetBalasDendamTerkunci = Null;\n\t\t\t\tElse If(Event Player.JumlahBalasDendam[Event Player.IndeksBalasDendam] <= 0);\n\t\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Revenge debt cleared. Case closed.") : Event Player.IndeksBahasa == 1 ? Custom String("Utang balas dendam lunas. Kasus ditutup.") : Custom String("ชำระหนี้ล้างแค้นหมดแล้ว ปิดคดี"));\n\t\t\t\t\tEvent Player.TargetBalasDendamTerkunci = Null;\n\t\t\t\tElse If(Or(Entity Exists(Event Player.TargetBalasDendamTerkunci) == False, Is Alive(Event Player.TargetBalasDendamTerkunci) == False));\n\t\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Target is already down. Revenge has office hours.") : Event Player.IndeksBahasa == 1 ? Custom String("Target sudah tumbang. Balas dendam juga punya jam kerja.") : Custom String("เป้าหมายล้มอยู่แล้ว การล้างแค้นก็มีเวลาทำการนะ"));\n\t\t\t\t\tEvent Player.TargetBalasDendamTerkunci = Null;\n\t\t\t\tElse If(Player Variable(Event Player.TargetBalasDendamTerkunci, KematianBalasDendam) == True);\n\t\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("That target already has a revenge in progress.") : Event Player.IndeksBahasa == 1 ? Custom String("Target itu sudah memiliki balas dendam yang sedang diproses.") : Custom String("เป้าหมายนั้นมีการล้างแค้นที่กำลังดำเนินอยู่แล้ว"));\n\t\t\t\t\tEvent Player.TargetBalasDendamTerkunci = Null;\n\t\t\t\tElse If(Player Variable(Event Player.TargetBalasDendamTerkunci, KartuNasibAktif) == True);\n\t\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("That target is using Try Your Luck. Wait until it finishes.") : Event Player.IndeksBahasa == 1 ? Custom String("Target itu sedang memakai Coba Nasib. Tunggu sampai selesai.") : Custom String("เป้าหมายนั้นกำลังใช้เสี่ยงโชค รอให้จบก่อน"));\n\t\t\t\t\tEvent Player.TargetBalasDendamTerkunci = Null;\n\t\t\t\tElse;\n\t\t\t\t\tSet Player Variable(Event Player.TargetBalasDendamTerkunci, KematianBalasDendam, True);\n\t\t\t\t\tSet Player Variable(Event Player.TargetBalasDendamTerkunci, PenagihBalasDendam, Event Player);\n\t\t\t\t\tSet Player Variable(Event Player.TargetBalasDendamTerkunci, WaktuPaksaBerikut, Total Time Elapsed);\n\t\t\t\t\tSet Player Variable(Event Player.TargetBalasDendamTerkunci, WaktuPaksaBerakhir, Total Time Elapsed + 5);\n\t\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Revenge armed on {0}. Waiting for full death.", Event Player.TargetBalasDendamTerkunci) : Event Player.IndeksBahasa == 1 ? Custom String("Balas dendam diarahkan ke {0}. Menunggu mati penuh.", Event Player.TargetBalasDendamTerkunci) : Custom String("เริ่มล้างแค้น {0} แล้ว กำลังรอการเสียชีวิตอย่างสมบูรณ์", Event Player.TargetBalasDendamTerkunci));\n\t\t\t\tEnd;\n\t\t\tEnd;\n\t\tEnd;\n\t}\n}\n\nregola("99f - Subrutin: Terapkan halaman kebal")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tTerapkanHalamanKebal;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.ModeKebal != Event Player.KursorKebal);\n\t\t\tIf(And(Event Player.KursorKebal == 1, Is In Spawn Room(Event Player) == True));\n\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Unkillable: 1 HP (HEALABLE) is unavailable in Spawn Room. FULL HP is still available.") : Event Player.IndeksBahasa == 1 ? Custom String("Kebal: 1 HP (BISA SEMBUH) tidak tersedia di ruang muncul. FULL HP tetap tersedia.") : Custom String("ใช้โหมดฆ่าไม่ตาย: 1 HP (รักษาได้) ในห้องเกิดไม่ได้ แต่ FULL HP ยังใช้ได้"));\n\t\t\tElse;\n\t\t\t\tEvent Player.ModeKebal = Event Player.KursorKebal;\n\t\t\t\tEvent Player.KebalAktif = Event Player.ModeKebal != 0;\n\t\t\t\tIf(Event Player.ModeKebal == 0);\n\t\t\t\t\tCall Subroutine(EfekPulihkan);\n\t\t\t\t\tClear Status(Event Player, Unkillable);\n\t\t\t\t\tSet Damage Received(Event Player, 100);\n\t\t\t\t\tSet Knockback Received(Event Player, 100);\n\t\t\t\t\tEnable Movement Collision With Players(Event Player);\n\t\t\t\t\tIf(Is Alive(Event Player) == True);\n\t\t\t\t\t\tSet Player Health(Event Player, Max Health(Event Player));\n\t\t\t\t\tEnd;\n\t\t\t\t\tIf(Event Player.IkonKebal != Null);\n\t\t\t\t\t\tDestroy Icon(Event Player.IkonKebal);\n\t\t\t\t\t\tEvent Player.IkonKebal = Null;\n\t\t\t\t\tEnd;\n\t\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Unkillable disabled.") : Event Player.IndeksBahasa == 1 ? Custom String("Mode Kebal nonaktif.") : Custom String("ปิดโหมดฆ่าไม่ตายแล้ว"));\n\t\t\t\tElse;\n\t\t\t\t\tCall Subroutine(EfekTerapkan);\n\t\t\t\t\tClear Status(Event Player, Unkillable);\n\t\t\t\t\tSet Status(Event Player, Null, Unkillable, 9999);\n\t\t\t\t\tIf(Event Player.ModeKebal == 1);\n\t\t\t\t\t\tSet Damage Received(Event Player, 100);\n\t\t\t\t\t\tSet Knockback Received(Event Player, 100);\n\t\t\t\t\t\tEnable Movement Collision With Players(Event Player);\n\t\t\t\t\t\tIf(Is Alive(Event Player) == True);\n\t\t\t\t\t\t\tSet Player Health(Event Player, 1);\n\t\t\t\t\t\tEnd;\n\t\t\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Unkillable: 1 HP (HEALABLE) enabled.") : Event Player.IndeksBahasa == 1 ? Custom String("Kebal: 1 HP (BISA SEMBUH) aktif.") : Custom String("เปิดโหมดฆ่าไม่ตาย: 1 HP (รักษาได้) แล้ว"));\n\t\t\t\t\tElse;\n\t\t\t\t\t\tSet Damage Received(Event Player, 0);\n\t\t\t\t\t\tSet Knockback Received(Event Player, 0);\n\t\t\t\t\t\tDisable Movement Collision With Players(Event Player);\n\t\t\t\t\t\tIf(Is Alive(Event Player) == True);\n\t\t\t\t\t\t\tSet Player Health(Event Player, Max Health(Event Player));\n\t\t\t\t\t\tEnd;\n\t\t\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Unkillable: FULL HP enabled.") : Event Player.IndeksBahasa == 1 ? Custom String("Kebal: FULL HP aktif.") : Custom String("เปิดโหมดฆ่าไม่ตาย: FULL HP แล้ว"));\n\t\t\t\t\tEnd;\n\t\t\t\t\tIf(Event Player.IkonKebal != Null);\n\t\t\t\t\t\tDestroy Icon(Event Player.IkonKebal);\n\t\t\t\t\t\tEvent Player.IkonKebal = Null;\n\t\t\t\t\tEnd;\n\t\t\t\t\tIf(Event Player.ModeKebal == 1);\n\t\t\t\t\t\tCreate Icon(All Players(All Teams), Event Player, Warning, Visible To and Position, Custom Color(255, 80, 80, 255), True);\n\t\t\t\t\tElse;\n\t\t\t\t\t\tCreate Icon(All Players(All Teams), Event Player, Halo, Visible To and Position, Globale.RGB, True);\n\t\t\t\t\tEnd;\n\t\t\t\t\tEvent Player.IkonKebal = Last Created Entity;\n\t\t\t\tEnd;\n\t\t\tEnd;\n\t\tEnd;\n\t}\n}\n\nregola("99g - Subrutin: Terapkan halaman suara pahlawan")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tTerapkanHalamanSuara;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.IndeksSuara != Event Player.KursorSuara);\n\t\t\tEvent Player.IndeksSuara = Event Player.KursorSuara;\n\t\t\tIf(Event Player.IndeksSuara == 0);\n\t\t\t\tCall Subroutine(EfekPulihkan);\n\t\t\tElse;\n\t\t\t\tCall Subroutine(EfekTerapkan);\n\t\t\tEnd;\n\t\t\tIf(Event Player.IndeksSuara == 0);\n\t\t\t\tStop Modifying Hero Voice Lines(Event Player);\n\t\t\tElse If(Event Player.IndeksSuara == 1);\n\t\t\t\tStart Modifying Hero Voice Lines(Event Player, 0.500, False);\n\t\t\tElse If(Event Player.IndeksSuara == 2);\n\t\t\t\tStart Modifying Hero Voice Lines(Event Player, 0.750, False);\n\t\t\tElse If(Event Player.IndeksSuara == 3);\n\t\t\t\tStart Modifying Hero Voice Lines(Event Player, 1.250, False);\n\t\t\tElse;\n\t\t\t\tStart Modifying Hero Voice Lines(Event Player, 1.500, False);\n\t\t\tEnd;\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Hero voice updated. Science!") : Event Player.IndeksBahasa == 1 ? Custom String("Suara pahlawan diubah. Demi sains!") : Custom String("ปรับเสียงฮีโร่แล้ว วิทยาศาสตร์!"));\n\t\tEnd;\n\t}\n}\n\nregola("99h - Subrutin: Terapkan halaman ikon pemain")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tTerapkanHalamanIkon;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.IndeksIkon != Event Player.KursorIkon);\n\t\t\tEvent Player.IndeksIkon = Event Player.KursorIkon;\n\t\t\tCall Subroutine(EfekTerapkan);\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Player icon: {0}.", Globale.NamaIkonInggris[Event Player.IndeksIkon]) : Event Player.IndeksBahasa == 1 ? Custom String("Ikon pemain: {0}.", Globale.NamaIkonIndonesia[Event Player.IndeksIkon]) : Custom String("ไอคอนผู้เล่น: {0}", Globale.NamaIkonThai[Event Player.IndeksIkon]));\n\t\tEnd;\n\t}\n}\n\nregola("99i - Subrutin: Terapkan halaman teleportasi Jongkok")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tTerapkanTeleportasiJongkok;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.TeleportasiJongkokDiaktifkan != (Event Player.KursorTeleportasiJongkok == 1));\n\t\t\tEvent Player.TeleportasiJongkokDiaktifkan = Event Player.KursorTeleportasiJongkok == 1;\n\t\t\tIf(Event Player.TeleportasiJongkokDiaktifkan == True);\n\t\t\t\tCall Subroutine(EfekTerapkan);\n\t\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Crouch Teleport enabled.") : Event Player.IndeksBahasa == 1 ? Custom String("Teleport Jongkok aktif.") : Custom String("เปิดเทเล