ckback Received(Event Player, 100);\n\t\tSet Move Speed(Event Player, 20);\n\t\tEvent Player.PahlawanTerakhir = Hero Of(Event Player);\n\t\tEvent Player.TargetDummyIkuti = Null;\n\t\tEvent Player.KunciBotAktif = True;\n\t\tDisable Nameplates(Event Player, Filtered Array(Globale.PemainManusia, Player Variable(Current Array Element, InspeksiAktif) == True));\n\t}\n}\n\nregola("91o - Subrutin: Gambar menu pilihan pemain")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tGambarPilihan;\n\t}\n\n\tazioni\n\t{\n\t\tCreate HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\\n{1}", Custom String("Hold CROUCH + command\\n{0}: next | {1}: previous", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: vote | {1}: back", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))) : Event Player.IndeksBahasa == 1 ? Custom String("{0}\\n{1}", Custom String("Tahan JONGKOK + perintah\\n{0}: berikutnya | {1}: sebelumnya", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: pilih | {1}: kembali", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))) : Custom String("{0}\\n{1}", Custom String("กด ย่อ + คำสั่ง\\n{0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: โหวต | {1}: กลับ", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))), Event Player.IndeksBahasa == 0 ? Custom String("{0}\\n> {1}", Custom String("11 - VOTE PLAYER {0}/{1}\\nYOUR VOTE: {2}", Event Player.KursorPilihan + 1, Count Of(Globale.PemainManusia), Event Player.PemainDipilih != Null ? Event Player.PemainDipilih : Custom String("NONE")), Count Of(Globale.PemainManusia) > 0 ? Custom String("{0} - {1} VOTES", Globale.PemainManusia[Event Player.KursorPilihan], Globale.PemainManusia[Event Player.KursorPilihan].JumlahPilihan) : Custom String("NO PLAYERS")) : Event Player.IndeksBahasa == 1 ? Custom String("{0}\\n> {1}", Custom String("11 - PILIH PEMAIN {0}/{1}\\nPILIHAN KAMU: {2}", Event Player.KursorPilihan + 1, Count Of(Globale.PemainManusia), Event Player.PemainDipilih != Null ? Event Player.PemainDipilih : Custom String("BELUM ADA")), Count Of(Globale.PemainManusia) > 0 ? Custom String("{0} - {1} SUARA", Globale.PemainManusia[Event Player.KursorPilihan], Globale.PemainManusia[Event Player.KursorPilihan].JumlahPilihan) : Custom String("TIDAK ADA PEMAIN")) : Custom String("{0}\\n> {1}", Custom String("11 - โหวตผู้เล่น {0}/{1}\\nโหวตของคุณ: {2}", Event Player.KursorPilihan + 1, Count Of(Globale.PemainManusia), Event Player.PemainDipilih != Null ? Event Player.PemainDipilih : Custom String("ยังไม่ได้โหวต")), Count Of(Globale.PemainManusia) > 0 ? Custom String("{0} - {1} โหวต", Globale.PemainManusia[Event Player.KursorPilihan], Globale.PemainManusia[Event Player.KursorPilihan].JumlahPilihan) : Custom String("ไม่มีผู้เล่น")), Top, 3, Custom Color(255, 255, 255, 255), Custom Color(235, 230, 190, 255), Custom Color(X Component Of(Event Player.WarnaMenu), Y Component Of(Event Player.WarnaMenu), Z Component Of(Event Player.WarnaMenu), 255), Visible To String and Color, Visible Never);\n\t\tEvent Player.HudMenu = Last Text ID;\n\t}\n}\n\nregola("91r - Subrutin: Gambar izin dummy mengikuti")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tGambarIkutiDummy;\n\t}\n\n\tazioni\n\t{\n\t\tCreate HUD Text(Event Player, Null, Event Player.IndeksBahasa == 0 ? Custom String("{0}\\n{1}", Custom String("Hold CROUCH + command\\n{0}: next | {1}: previous", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: apply | {1}: back", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))) : Event Player.IndeksBahasa == 1 ? Custom String("{0}\\n{1}", Custom String("Tahan JONGKOK + perintah\\n{0}: berikutnya | {1}: sebelumnya", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: pakai | {1}: kembali", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))) : Custom String("{0}\\n{1}", Custom String("กด ย่อ + คำสั่ง\\n{0}: ถัดไป | {1}: ก่อนหน้า", Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))), Custom String("{0}: ใช้ | {1}: กลับ", Input Binding String(Button(Interact)), Input Binding String(Button(Reload)))), Event Player.IndeksBahasa == 0 ? Custom String("{0}\\n> {1}", Custom String("12 - DUMMY FOLLOW {0}/2\\nALLOW ENEMY DUMMY TO FOLLOW YOU: {1}", Event Player.KursorIkutiDummy + 1, Event Player.IzinkanDummyMengikuti ? Custom String("ON") : Custom String("OFF")), Event Player.KursorIkutiDummy == 1 ? Custom String("ON") : Custom String("OFF")) : Event Player.IndeksBahasa == 1 ? Custom String("{0}\\n> {1}", Custom String("12 - DUMMY MENGIKUTI {0}/2\\nIZINKAN DUMMY MUSUH MENGIKUTIMU: {1}", Event Player.KursorIkutiDummy + 1, Event Player.IzinkanDummyMengikuti ? Custom String("AKTIF") : Custom String("MATI")), Event Player.KursorIkutiDummy == 1 ? Custom String("AKTIF") : Custom String("MATI")) : Custom String("{0}\\n> {1}", Custom String("12 - ดัมมี่ติดตาม {0}/2\\nอนุญาตให้ดัมมี่ศัตรูติดตามคุณ: {1}", Event Player.KursorIkutiDummy + 1, Event Player.IzinkanDummyMengikuti ? Custom String("เปิด") : Custom String("ปิด")), Event Player.KursorIkutiDummy == 1 ? Custom String("เปิด") : Custom String("ปิด")), Top, 3, Custom Color(255, 255, 255, 255), Custom Color(215, 245, 235, 255), Custom Color(X Component Of(Event Player.WarnaMenu), Y Component Of(Event Player.WarnaMenu), Z Component Of(Event Player.WarnaMenu), 255), Visible To String and Color, Visible Never);\n\t\tEvent Player.HudMenu = Last Text ID;\n\t}\n}\n\nregola("91q - Subrutin: Hitung ulang pilihan dan pemimpin tunggal")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tHitungPilihan;\n\t}\n\n\tazioni\n\t{\n\t\t"JumlahPilihan tidak dihitung ulang di sini; nilainya diperbarui secara transaksional tepat saat pilihan diterapkan."\n\t\tGlobale.PemimpinPilihan = Null;\n\t\tGlobale.PilihanTerbanyak = 0;\n\t\tGlobale.PilihanSeri = False;\n\t\tIf(Count Of(Globale.PemainManusia) > 0);\n\t\t\tGlobale.PemimpinPilihan = First Of(Sorted Array(Globale.PemainManusia, 0 - Player Variable(Current Array Element, JumlahPilihan)));\n\t\t\tGlobale.PilihanTerbanyak = Player Variable(Globale.PemimpinPilihan, JumlahPilihan);\n\t\t\tIf(Globale.PilihanTerbanyak > 0);\n\t\t\t\tGlobale.PilihanSeri = Count Of(Filtered Array(Globale.PemainManusia, Player Variable(Current Array Element, JumlahPilihan) == Globale.PilihanTerbanyak)) > 1;\n\t\t\t\tIf(Globale.PilihanSeri == True);\n\t\t\t\t\tGlobale.PemimpinPilihan = Null;\n\t\t\t\tEnd;\n\t\t\tElse;\n\t\t\t\tGlobale.PemimpinPilihan = Null;\n\t\t\tEnd;\n\t\tEnd;\n\t}\n}\n\nregola("93 - Subrutin: Mulai kamera dinamis di bahu kiri")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tMulaiKamera;\n\t}\n\n\tazioni\n\t{\n\t\tAbort If(Event Player.TargetKamera == Null);\n\t\tAbort If(Entity Exists(Event Player.TargetKamera) == False);\n\t\t"Ganti kamera langsung tanpa Stop Camera agar perpindahan target tidak berkedip satu bingkai."\n\t\tStart Camera(Event Player, Update Every Frame(First Of(Mapped Array(Array(Ray Cast Hit Position(Eye Position(Event Player.TargetKamera) + Vector(0, Min(0.750, Max(0.450, 0.450 + (Max Health(Event Player.TargetKamera) - 200) * 0.0006)), 0), Eye Position(Event Player.TargetKamera) + Vector(0, Min(0.750, Max(0.450, 0.450 + (Max Health(Event Player.TargetKamera) - 200) * 0.0006)), 0) - Facing Direction Of(Event Player.TargetKamera) * Min(4.500, Max(Globale.JarakKamera, Globale.JarakKamera + (Max Health(Event Player.TargetKamera) - 200) * 0.0055)) + Cross Product(Direction From Angles(Horizontal Facing Angle Of(Event Player.TargetKamera), 0), Vector(0, 1, 0)) * Min(1.350, Max(Globale.GeserKamera, Globale.GeserKamera + (Max Health(Event Player.TargetKamera) - 200) * 0.0016)), Empty Array, Empty Array, False)), Current Array Element + Direction Towards(Current Array Element, Eye Position(Event Player.TargetKamera) + Vector(0, Min(0.750, Max(0.450, 0.450 + (Max Health(Event Player.TargetKamera) - 200) * 0.0006)), 0)) * Min(Globale.BantalanDinding, Distance Between(Current Array Element, Eye Position(Event Player.TargetKamera) + Vector(0, Min(0.750, Max(0.450, 0.450 + (Max Health(Event Player.TargetKamera) - 200) * 0.0006)), 0)) * 0.250)))), Update Every Frame(Eye Position(Event Player.TargetKamera) + Facing Direction Of(Event Player.TargetKamera) * Globale.JarakBidik), 0);\n\t}\n}\n\nregola("93a - Subrutin: Efek perubahan diterapkan")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tEfekTerapkan;\n\t}\n\n\tazioni\n\t{\n\t\tPlay Effect(All Players(All Teams), Ring Explosion, Globale.RGB, Position Of(Event Player) + Vector(0, 1, 0), 3);\n\t}\n}\n\nregola("93b - Subrutin: Efek pengaturan dipulihkan")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tEfekPulihkan;\n\t}\n\n\tazioni\n\t{\n\t\tPlay Effect(All Players(All Teams), Ring Explosion, Globale.RGB, Position Of(Event Player) + Vector(0, 1, 0), 3);\n\t}\n}\n\nregola("93b2 - Subrutin: Tenangkan pemicu sebelum pembersihan")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tTenangkanPemain;\n\t}\n\n\tazioni\n\t{\n\t\t"Bersihkan Coba Nasib segera sebelum pendaftaran tim baru; bagian ini tidak pernah menjeda pemindaian."\n\t\tEvent Player.KebalAktif = False;\n\t\tEvent Player.ModeKebal = 0;\n\t\tEvent Player.KursorKebal = 0;\n\t\tCall Subroutine(PulihkanNasibPemain);\n\t\tEvent Player.MenuNasibHarusDibuka = False;\n\t\tEvent Player.KematianBalasDendam = False;\n\t\tEvent Player.PenagihBalasDendam = Null;\n\t\t"Matikan semua pemicu sebelum acara keluar atau masuk menyelesaikan pembersihan dan pendaftaran baru."\n\t\tEvent Player.SudahSiap = False;\n\t\tEvent Player.Manusia = False;\n\t\tEvent Player.PerintahMenu = 0;\n\t\tEvent Player.InputMenuDikunci = False;\n\t\tEvent Player.SeranganDekatDipakai = False;\n\t\tEvent Player.MenuTerbuka = False;\n\t\tEvent Player.TeleportasiJongkokAktif = False;\n\t\tEvent Player.PerintahTeleportasi = 0;\n\t\tEvent Player.InspeksiAktif = False;\n\t\tEvent Player.TargetInspeksi = Null;\n\t\tEvent Player.InteraksiKameraDipakai = False;\n\t\tEvent Player.IzinkanDummyMengikuti = False;\n\t}\n}\n\nregola("93c - Subrutin: Bersihkan pemain saat keluar atau pindah tim")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tBersihkanPemain;\n\t}\n\n\tazioni\n\t{\n\t\t"Pemicu sudah mati; pulihkan sistem dalam kelompok kecil lalu lakukan pembersihan atomik."\n\t\tStop Camera(Event Player);\n\t\tDetach Players(Event Player);\n\t\tEvent Player.LampiranTeleportasiAktif = False;\n\t\tEvent Player.TargetLampiranTeleportasi = Null;\n\t\tEvent Player.PahlawanLampiranSendiri = Null;\n\t\tEvent Player.PahlawanLampiranTarget = Null;\n\t\tStop Chasing Player Variable(Event Player, WarnaMenu);\n\t\tClear Status(Event Player, Unkillable);\n\t\tSet Damage Received(Event Player, 100);\n\t\tSet Knockback Received(Event Player, 100);\n\t\tEnable Movement Collision With Players(Event Player);\n\t\tSet Move Speed(Event Player, 100);\n\t\tSet Jump Vertical Speed(Event Player, 100);\n\t\tSet Projectile Speed(Event Player, 100);\n\t\tSet Gravity(Event Player, 100);\n\t\tStop Accelerating(Event Player);\n\t\tStop Forcing Player Outlines(All Players(All Teams), Event Player);\n\t\tEnable Movement Collision With Environment(Event Player);\n\t\tClear Status(Event Player, Burning);\n\t\tClear Status(Event Player, Hacked);\n\t\tStop Modifying Hero Voice Lines(Event Player);\n\t\tAllow Button(Event Player, Button(Melee));\n\t\tAllow Button(Event Player, Button(Jump));\n\t\tAllow Button(Event Player, Button(Crouch));\n\t\tAllow Button(Event Player, Button(Primary Fire));\n\t\tAllow Button(Event Player, Button(Secondary Fire));\n\t\tAllow Button(Event Player, Button(Interact));\n\t\tAllow Button(Event Player, Button(Reload));\n\t\tAllow Button(Event Player, Button(Ability 1));\n\t\tAllow Button(Event Player, Button(Ability 2));\n\t\tAllow Button(Event Player, Button(Ultimate));\n\t\tSet Primary Fire Enabled(Event Player, True);\n\t\tSet Secondary Fire Enabled(Event Player, True);\n\t\tSet Ability 1 Enabled(Event Player, True);\n\t\tSet Ability 2 Enabled(Event Player, True);\n\t\tSet Ultimate Ability Enabled(Event Player, True);\n\t\tSet Melee Enabled(Event Player, True);\n\t\tEnable Game Mode HUD(Event Player);\n\t\tEnable Game Mode In-World UI(Event Player);\n\t\tIf(And(Event Player.PemainDipilih != Null, And(Event Player.PemainDipilih != Event Player, Array Contains(Globale.PemainManusia, Event Player.PemainDipilih))));\n\t\t\tModify Player Variable(Globale.PemainManusia[Index Of Array Value(Globale.PemainManusia, Event Player.PemainDipilih)], JumlahPilihan, Subtract, 1);\n\t\t\tIf(Globale.PemainManusia[Index Of Array Value(Globale.PemainManusia, Event Player.PemainDipilih)].JumlahPilihan < 0);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Index Of Array Value(Globale.PemainManusia, Event Player.PemainDipilih)], JumlahPilihan, 0);\n\t\t\tEnd;\n\t\tEnd;\n\t\tEvent Player.PemainDipilih = Null;\n\t\tEvent Player.JumlahPilihan = 0;\n\t\tEvent Player.SudahSiap = False;\n\t\tEvent Player.SudahDiperiksa = False;\n\t\tEvent Player.Manusia = False;\n\t\tEvent Player.MenuTerbuka = False;\n\t\tEvent Player.InputMenuDikunci = False;\n\t\tEvent Player.HudPemainDibuat = False;\n\t\tEvent Player.KebalAktif = False;\n\t\tEvent Player.ModeKebal = 0;\n\t\tEvent Player.KursorKebal = 0;\n\t\tCall Subroutine(PulihkanNasibPemain);\n\t\tEvent Player.KematianBalasDendam = False;\n\t\tEvent Player.PenagihBalasDendam = Null;\n\t\tIf(Event Player.TeksTeleportasi != Null);\n\t\t\tDestroy In-World Text(Event Player.TeksTeleportasi);\n\t\tEnd;\n\t\tEvent Player.TeksTeleportasi = Null;\n\t\tEvent Player.TargetTeleportasiTeks = Null;\n\t\t"Seluruh pembersihan berjalan atomik tanpa Wait sebelum atau sesudah variabel kerja Global dipakai."\n\t\tGlobale.IndeksKeluar = Index Of Array Value(Globale.PemainManusia, Event Player);\n\t\tIf(And(Globale.IndeksKeluar < 0, Event Player.UrutanHUD >= 0));\n\t\t\tGlobale.IndeksKeluar = Index Of Array Value(Globale.SlotHUDPemain, Event Player.UrutanHUD);\n\t\tEnd;\n\t\tGlobale.PemainPembersihan = Globale.IndeksKeluar >= 0 ? Globale.PemainManusia[Globale.IndeksKeluar] : Event Player;\n\t\tIf(Globale.IndeksKeluar >= 0);\n\t\t\tIf(Event Player.IkonKebal != Null);\n\t\t\t\tDestroy Icon(Event Player.IkonKebal);\n\t\t\t\tEvent Player.IkonKebal = Null;\n\t\t\tEnd;\n\t\t\tIf(Event Player.PelatNamaDinonaktifkan == True);\n\t\t\t\tEnable Nameplates(All Players(All Teams), Event Player);\n\t\t\tEnd;\n\t\t\tDestroy HUD Text(Globale.HudKiriPemain[Globale.IndeksKeluar]);\n\t\t\tDestroy HUD Text(Globale.HudKananPemain[Globale.IndeksKeluar]);\n\t\t\tIf(Player Variable(Globale.PemainPembersihan, HudMenu) != Null);\n\t\t\t\tDestroy HUD Text(Player Variable(Globale.PemainPembersihan, HudMenu));\n\t\t\tEnd;\n\t\t\tGlobale.PemainPembersihan.HudMenu = Null;\n\t\t\tIf(Globale.TeksDuniaPemain[Globale.IndeksKeluar] != 0);\n\t\t\t\tDestroy In-World Text(Globale.TeksDuniaPemain[Globale.IndeksKeluar]);\n\t\t\tEnd;\n\t\t\tGlobale.SlotHUDTersedia = Sorted Array(Append To Array(Globale.SlotHUDTersedia, Globale.SlotHUDPemain[Globale.IndeksKeluar]), Current Array Element);\n\t\t\tModify Global Variable(HudKiriPemain, Remove From Array By Index, Globale.IndeksKeluar);\n\t\t\tModify Global Variable(HudKananPemain, Remove From Array By Index, Globale.IndeksKeluar);\n\t\t\tModify Global Variable(HudMenuPemain, Remove From Array By Index, Globale.IndeksKeluar);\n\t\t\tModify Global Variable(TeksDuniaPemain, Remove From Array By Index, Globale.IndeksKeluar);\n\t\t\tModify Global Variable(SlotHUDPemain, Remove From Array By Index, Globale.IndeksKeluar);\n\t\t\tModify Global Variable(PemainManusia, Remove From Array By Index, Globale.IndeksKeluar);\n\t\t\tGlobale.SlotHUDTerakhir = Count Of(Globale.SlotHUDPemain) == 0 ? -1 : Last Of(Sorted Array(Globale.SlotHUDPemain, Current Array Element));\n\t\tEnd;\n\t\tFor Global Variable(IndeksPemilih, 0, Count Of(Globale.PemainManusia), 1);\n\t\t\tIf(Globale.PemainManusia[Globale.IndeksPemilih].PemainDipilih == Globale.PemainPembersihan);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], PemainDipilih, Null);\n\t\t\tEnd;\n\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], KursorPilihan, Count Of(Globale.PemainManusia) == 0 ? 0 : Min(Player Variable(Globale.PemainManusia[Globale.IndeksPemilih], KursorPilihan), Count Of(Globale.PemainManusia) - 1));\n\t\tEnd;\n\t\tCall Subroutine(HitungPilihan);\n\t\t"Bersihkan semua referensi pemain yang keluar dari utang balas dendam milik pemain yang masih ada."\n\t\tFor Global Variable(IndeksPembersihan, 0, Count Of(Globale.PemainManusia), 1);\n\t\t\tIf(Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], TargetLampiranTeleportasi) == Globale.PemainPembersihan);\n\t\t\t\tDetach Players(Globale.PemainManusia[Globale.IndeksPembersihan]);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], LampiranTeleportasiAktif, False);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], TargetLampiranTeleportasi, Null);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], PahlawanLampiranSendiri, Null);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], PahlawanLampiranTarget, Null);\n\t\t\t\tAllow Button(Globale.PemainManusia[Globale.IndeksPembersihan], Button(Reload));\n\t\t\tEnd;\n\t\t\tGlobale.IndeksUtangKeluar = Index Of Array Value(Globale.PemainManusia[Globale.IndeksPembersihan].PembunuhBalasDendam, Globale.PemainPembersihan);\n\t\t\tIf(Globale.IndeksUtangKeluar >= 0);\n\t\t\t\tModify Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], PembunuhBalasDendam, Remove From Array By Index, Globale.IndeksUtangKeluar);\n\t\t\t\tModify Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], JumlahBalasDendam, Remove From Array By Index, Globale.IndeksUtangKeluar);\n\t\t\tEnd;\n\t\t\tIf(Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], PenagihBalasDendam) == Globale.PemainPembersihan);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], KematianBalasDendam, False);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], PenagihBalasDendam, Null);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], WaktuPaksaBerikut, 0);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], WaktuPaksaBerakhir, 0);\n\t\t\tEnd;\n\t\t\tIf(Globale.PemainManusia[Globale.IndeksPembersihan].TargetKamera == Globale.PemainPembersihan);\n\t\t\t\tStop Camera(Globale.PemainManusia[Globale.IndeksPembersihan]);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], ModeKamera, 0);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], TargetKamera, Null);\n\t\t\tEnd;\n\t\t\tIf(Globale.PemainManusia[Globale.IndeksPembersihan].TargetInspeksi == Globale.PemainPembersihan);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], TargetInspeksi, Null);\n\t\t\tEnd;\n\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetKamera, Filtered Array(Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetKamera), Current Array Element != Globale.PemainPembersihan));\n\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetBalasDendam, Filtered Array(Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetBalasDendam), Current Array Element != Globale.PemainPembersihan));\n\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetTeleportasi, Filtered Array(Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetTeleportasi), Current Array Element != Globale.PemainPembersihan));\n\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetInspeksi, Filtered Array(Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetInspeksi), Current Array Element != Globale.PemainPembersihan));\n\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], KursorKamera, Min(Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], KursorKamera), Count Of(Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetKamera)) + 1));\n\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], KursorBalasDendam, Count Of(Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetBalasDendam)) == 0 ? 0 : Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], KursorBalasDendam) % Count Of(Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetBalasDendam)));\n\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], KursorTeleportasi, Count Of(Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetTeleportasi)) == 0 ? 0 : Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], KursorTeleportasi) % Count Of(Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], DaftarTargetTeleportasi)));\n\t\t\tIf(Globale.PemainManusia[Globale.IndeksPembersihan].CalonTargetKamera == Globale.PemainPembersihan);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], CalonTargetKamera, Null);\n\t\t\tEnd;\n\t\t\tIf(Globale.PemainManusia[Globale.IndeksPembersihan].CalonTargetTeleportasi == Globale.PemainPembersihan);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], CalonTargetTeleportasi, Null);\n\t\t\tEnd;\n\t\t\tIf(Globale.PemainManusia[Globale.IndeksPembersihan].TargetTeleportasiTerkunci == Globale.PemainPembersihan);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], TargetTeleportasiTerkunci, Null);\n\t\t\tEnd;\n\t\t\tIf(Globale.PemainManusia[Globale.IndeksPembersihan].TargetBalasDendamDipilih == Globale.PemainPembersihan);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], TargetBalasDendamDipilih, Null);\n\t\t\tEnd;\n\t\t\tIf(Globale.PemainManusia[Globale.IndeksPembersihan].TargetBalasDendamTerkunci == Globale.PemainPembersihan);\n\t\t\t\tSet Player Variable(Globale.PemainManusia[Globale.IndeksPembersihan], TargetBalasDendamTerkunci, Null);\n\t\t\tEnd;\n\t\tEnd;\n\t\tGlobale.IndeksKeluar = -1;\n\t\tGlobale.PemainPembersihan = Null;\n\t}\n}\n\nregola("94 - Subrutin: Siapkan pemain dari ujung rambut sampai variabel")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tSiapkanPemain;\n\t}\n\n\tazioni\n\t{\n\t\tAbort If(Is Dummy Bot(Event Player));\n\t\tSet Damage Received(Event Player, 100);\n\t\tSet Knockback Received(Event Player, 100);\n\t\tEnable Movement Collision With Players(Event Player);\n\t\tEvent Player.WaktuMasuk = Total Time Elapsed;\n\t\tEvent Player.SudahDiperiksa = False;\n\t\tEvent Player.BotOtomatis = False;\n\t\tEvent Player.Manusia = False;\n\t\tEvent Player.MenitLobi = 0;\n\t\tEvent Player.IndeksGenre = -1;\n\t\tEvent Player.UrutanHUD = -1;\n\t\tEvent Player.HudKiri = Null;\n\t\tEvent Player.HudKanan = Null;\n\t\tEvent Player.HudPemainDibuat = False;\n\t\tEvent Player.MenuTerbuka = False;\n\t\tEvent Player.KursorGenre = 0;\n\t\tEvent Player.HudMenu = Null;\n\t\tEvent Player.InspeksiAktif = False;\n\t\tEvent Player.TargetInspeksi = Null;\n\t\tEvent Player.TeksDunia = Null;\n\t\tEvent Player.ModeKamera = 0;\n\t\tEvent Player.TargetKamera = Null;\n\t\tEvent Player.SeranganDekatDipakai = False;\n\t\tEvent Player.HalamanMenu = -1;\n\t\tEvent Player.KursorUtama = 0;\n\t\tEvent Player.KursorKamera = 0;\n\t\tEvent Player.KursorWarna = 0;\n\t\tEvent Player.IndeksWarna = 0;\n\t\tEvent Player.WarnaNama = Custom Color(255, 255, 255, 255);\n\t\tEvent Player.CalonTargetKamera = Null;\n\t\tEvent Player.IndeksBahasa = 0;\n\t\tEvent Player.KursorBahasa = 0;\n\t\tEvent Player.DaftarTargetKamera = Empty Array;\n\t\tEvent Player.KursorBalasDendam = 0;\n\t\tEvent Player.DaftarTargetBalasDendam = Empty Array;\n\t\tEvent Player.PembunuhBalasDendam = Empty Array;\n\t\tEvent Player.JumlahBalasDendam = Empty Array;\n\t\tEvent Player.IndeksBalasDendam = -1;\n\t\tEvent Player.KematianBalasDendam = False;\n\t\tEvent Player.PenagihBalasDendam = Null;\n\t\tEvent Player.WaktuPaksaBerikut = 0;\n\t\tEvent Player.WaktuPaksaBerakhir = 0;\n\t\tEvent Player.KursorTeleportasi = 0;\n\t\tEvent Player.DaftarTargetTeleportasi = Empty Array;\n\t\tEvent Player.CalonTargetTeleportasi = Null;\n\t\tEvent Player.TargetTeleportasiTeks = Null;\n\t\tEvent Player.TeksTeleportasi = Null;\n\t\tEvent Player.InputMenuDikunci = False;\n\t\tEvent Player.TargetBalasDendamTerkunci = Null;\n\t\tEvent Player.TargetBalasDendamDipilih = Null;\n\t\tEvent Player.PelatNamaDinonaktifkan = False;\n\t\tEvent Player.KunciBotAktif = False;\n\t\tEvent Player.PahlawanTerakhir = Null;\n\t\tEvent Player.DaftarTargetInspeksi = Empty Array;\n\t\tEvent Player.PerintahMenu = 0;\n\t\tEvent Player.JenisTeleportasiTerkunci = -1;\n\t\tEvent Player.TargetTeleportasiTerkunci = Null;\n\t\tEvent Player.KebalAktif = False;\n\t\tEvent Player.KursorKebal = 0;\n\t\tEvent Player.IndeksSuara = 0;\n\t\tEvent Player.KursorSuara = 0;\n\t\tEvent Player.TeleportasiJongkokAktif = False;\n\t\tEvent Player.PerintahTeleportasi = 0;\n\t\tEvent Player.InteraksiKameraDipakai = False;\n\t\tEvent Player.PosisiMati = Vector(0, 0, 0);\n\t\tEvent Player.PosisiBangkitAman = Vector(0, 0, 0);\n\t\tEvent Player.BangkitLompatDipakai = False;\n\t\tEvent Player.IndeksIkon = 0;\n\t\tEvent Player.KursorIkon = 0;\n\t\tEvent Player.WarnaMenu = Vector(255, 255, 255);\n\t\tEvent Player.TeleportasiJongkokDiaktifkan = False;\n\t\tEvent Player.KursorTeleportasiJongkok = 0;\n\t\tEvent Player.PrivasiInspeksiAktif = False;\n\t\tEvent Player.KursorPrivasiInspeksi = 0;\n\t\tEvent Player.ModeKebal = 0;\n\t\tEvent Player.IkonKebal = Null;\n\t\tEvent Player.KartuNasibAktif = False;\n\t\tEvent Player.IkonKartuNasib = Null;\n\t\tEvent Player.KursorPilihan = 0;\n\t\tEvent Player.PemainDipilih = Null;\n\t\tEvent Player.JumlahPilihan = 0;\n\t\tEvent Player.PutaranKartuNasib = 0;\n\t\tEvent Player.JedaKartuNasib = 0;\n\t\tEvent Player.EfekNasib = 0;\n\t\tEvent Player.EfekNasibBerakhir = 0;\n\t\tEvent Player.PrivasiNasibAktif = False;\n\t\tEvent Player.WaktuBakarNasibBerikut = 0;\n\t\tEvent Player.WaktuPutaranNasibBerikut = 0;\n\t\tEvent Player.WaktuIkonNasibBerakhir = 0;\n\t\tEvent Player.MenuNasibHarusDibuka = False;\n\t\tEvent Player.HudEfekNasib = Null;\n\t\tEvent Player.TeksVisiNasib = Null;\n\t\tEvent Player.TimTerakhir = Team Of(Event Player);\n\t\tEvent Player.WaktuTeleportasiDummy = 0;\n\t\tEvent Player.IzinkanDummyMengikuti = False;\n\t\tEvent Player.KursorIkutiDummy = 0;\n\t\tEvent Player.TargetDummyIkuti = Null;\n\t\tEvent Player.CalonTargetInspeksi = Null;\n\t\tEvent Player.PosisiTeleportTujuan = Vector(0, 0, 0);\n\t\tEvent Player.TargetLampiranTeleportasi = Null;\n\t\tEvent Player.LampiranTeleportasiAktif = False;\n\t\tEvent Player.PahlawanLampiranSendiri = Null;\n\t\tEvent Player.PahlawanLampiranTarget = Null;\n\t\tEvent Player.PernahDisiapkan = True;\n\t\tEvent Player.PindahTimDiproses = True;\n\t\tEvent Player.SiklusPemainAktif = False;\n\t\tEvent Player.SudahSiap = True;\n\t}\n}\n\nregola("95 - Subrutin: Segarkan daftar tontonan, termasuk para bot")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tSegarkanTargetKamera;\n\t}\n\n\tazioni\n\t{\n\t\tIf(And(Event Player.KursorKamera >= 2, Event Player.KursorKamera - 2 < Count Of(Event Player.DaftarTargetKamera)));\n\t\t\tEvent Player.CalonTargetKamera = Event Player.DaftarTargetKamera[Event Player.KursorKamera - 2];\n\t\tElse;\n\t\t\tEvent Player.CalonTargetKamera = Null;\n\t\tEnd;\n\t\tCall Subroutine(SegarkanTargetPublikPemain);\n\t\tEvent Player.DaftarTargetKamera = Filtered Array(Event Player.DaftarTargetInspeksi, Has Spawned(Current Array Element) == True);\n\t\tIf(And(Event Player.CalonTargetKamera != Null, Array Contains(Event Player.DaftarTargetKamera, Event Player.CalonTargetKamera)));\n\t\t\tEvent Player.KursorKamera = Index Of Array Value(Event Player.DaftarTargetKamera, Event Player.CalonTargetKamera) + 2;\n\t\tElse If(Event Player.KursorKamera >= Count Of(Event Player.DaftarTargetKamera) + 2);\n\t\t\tEvent Player.KursorKamera = 0;\n\t\tEnd;\n\t}\n}\n\nregola("96 - Subrutin: Cari target publik terdekat dari bidikan")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tSegarkanTargetInspeksi;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Or(Event Player.CalonTargetInspeksi == Null, Or(Entity Exists(Event Player.CalonTargetInspeksi) == False, Is Alive(Event Player.CalonTargetInspeksi) == False)));\n\t\t\tEvent Player.TargetInspeksi = Null;\n\t\tElse;\n\t\t\tEvent Player.TargetInspeksi = Event Player.CalonTargetInspeksi;\n\t\tEnd;\n\t}\n}\n\nregola("97 - Subrutin: Segarkan daftar target balas dendam")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tSegarkanTargetBalasDendam;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.KursorBalasDendam < Count Of(Event Player.DaftarTargetBalasDendam));\n\t\t\tEvent Player.TargetBalasDendamDipilih = Event Player.DaftarTargetBalasDendam[Event Player.KursorBalasDendam];\n\t\tElse;\n\t\t\tEvent Player.TargetBalasDendamDipilih = Null;\n\t\tEnd;\n\t\tEvent Player.DaftarTargetBalasDendam = Filtered Array(Globale.PemainManusia, Current Array Element != Event Player);\n\t\tIf(Count Of(Event Player.DaftarTargetBalasDendam) == 0);\n\t\t\tEvent Player.KursorBalasDendam = 0;\n\t\tElse If(And(Event Player.TargetBalasDendamDipilih != Null, Array Contains(Event Player.DaftarTargetBalasDendam, Event Player.TargetBalasDendamDipilih)));\n\t\t\tEvent Player.KursorBalasDendam = Index Of Array Value(Event Player.DaftarTargetBalasDendam, Event Player.TargetBalasDendamDipilih);\n\t\tElse If(Event Player.KursorBalasDendam >= Count Of(Event Player.DaftarTargetBalasDendam));\n\t\t\tEvent Player.KursorBalasDendam = 0;\n\t\tEnd;\n\t}\n}\n\nregola("98 - Subrutin: Cari target teleport publik terdekat dari bidikan")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tSegarkanTargetTeleportasi;\n\t}\n\n\tazioni\n\t{\n\t\tCall Subroutine(SegarkanTargetPublikPemain);\n\t\tEvent Player.DaftarTargetTeleportasi = Event Player.DaftarTargetInspeksi;\n\t\tIf(Count Of(Event Player.DaftarTargetTeleportasi) == 0);\n\t\t\tEvent Player.CalonTargetTeleportasi = Null;\n\t\tElse;\n\t\t\tEvent Player.CalonTargetTeleportasi = First Of(Sorted Array(Event Player.DaftarTargetTeleportasi, Angle Between Vectors(Facing Direction Of(Event Player), Direction Towards(Eye Position(Event Player), Eye Position(Current Array Element)))));\n\t\tEnd;\n\t}\n}\n\nregola("98a - Subrutin: Pulihkan status Nasib untuk Event Player")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tPulihkanNasibPemain;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Event Player.IkonKartuNasib != Null);\n\t\t\tDestroy Icon(Event Player.IkonKartuNasib);\n\t\tEnd;\n\t\tIf(Event Player.HudEfekNasib != Null);\n\t\t\tDestroy HUD Text(Event Player.HudEfekNasib);\n\t\tEnd;\n\t\tIf(Event Player.TeksVisiNasib != Null);\n\t\t\tDestroy In-World Text(Event Player.TeksVisiNasib);\n\t\tEnd;\n\t\tEvent Player.IkonKartuNasib = Null;\n\t\tEvent Player.HudEfekNasib = Null;\n\t\tEvent Player.TeksVisiNasib = Null;\n\t\tClear Status(Event Player, Burning);\n\t\tClear Status(Event Player, Hacked);\n\t\tClear Status(Event Player, Unkillable);\n\t\tStop Accelerating(Event Player);\n\t\tSet Damage Received(Event Player, 100);\n\t\tSet Knockback Received(Event Player, 100);\n\t\tEnable Movement Collision With Players(Event Player);\n\t\tSet Move Speed(Event Player, 100);\n\t\tSet Jump Vertical Speed(Event Player, 100);\n\t\tSet Projectile Speed(Event Player, 100);\n\t\tSet Gravity(Event Player, 100);\n\t\tEvent Player.KartuNasibAktif = False;\n\t\tEvent Player.PutaranKartuNasib = 0;\n\t\tEvent Player.JedaKartuNasib = 0;\n\t\tEvent Player.EfekNasib = 0;\n\t\tEvent Player.EfekNasibBerakhir = 0;\n\t\tEvent Player.PrivasiNasibAktif = False;\n\t\tEvent Player.WaktuBakarNasibBerikut = 0;\n\t\tEvent Player.WaktuPutaranNasibBerikut = 0;\n\t\tEvent Player.WaktuIkonNasibBerakhir = 0;\n\t\tEvent Player.WaktuPaksaBerikut = 0;\n\t\tEvent Player.WaktuPaksaBerakhir = 0;\n\t\tEvent Player.MenuNasibHarusDibuka = False;\n\t\tEvent Player.KebalAktif = Event Player.ModeKebal != 0;\n\t\tEvent Player.InputMenuDikunci = False;\n\t\tEvent Player.PerintahMenu = 0;\n\t\tAllow Button(Event Player, Button(Primary Fire));\n\t\tAllow Button(Event Player, Button(Secondary Fire));\n\t\tAllow Button(Event Player, Button(Interact));\n\t\tAllow Button(Event Player, Button(Reload));\n\t\tAllow Button(Event Player, Button(Ability 1));\n\t\tAllow Button(Event Player, Button(Ability 2));\n\t\tAllow Button(Event Player, Button(Ultimate));\n\t}\n}\n\nregola("98b - Subrutin: Pulihkan status Nasib untuk pemain aktif global")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tPulihkanNasibAktif;\n\t}\n\n\tazioni\n\t{\n\t\tAbort If(Or(Globale.PemainAktif == Null, Entity Exists(Globale.PemainAktif) == False));\n\t\tIf(Globale.PemainAktif.IkonKartuNasib != Null);\n\t\t\tDestroy Icon(Globale.PemainAktif.IkonKartuNasib);\n\t\tEnd;\n\t\tIf(Globale.PemainAktif.HudEfekNasib != Null);\n\t\t\tDestroy HUD Text(Globale.PemainAktif.HudEfekNasib);\n\t\tEnd;\n\t\tIf(Globale.PemainAktif.TeksVisiNasib != Null);\n\t\t\tDestroy In-World Text(Globale.PemainAktif.TeksVisiNasib);\n\t\tEnd;\n\t\tGlobale.PemainAktif.IkonKartuNasib = Null;\n\t\tGlobale.PemainAktif.HudEfekNasib = Null;\n\t\tGlobale.PemainAktif.TeksVisiNasib = Null;\n\t\tClear Status(Globale.PemainAktif, Burning);\n\t\tClear Status(Globale.PemainAktif, Hacked);\n\t\tIf(Or(Globale.PemainAktif.ModeKebal == 0, Is Alive(Globale.PemainAktif) == False));\n\t\t\tClear Status(Globale.PemainAktif, Unkillable);\n\t\t\tSet Damage Received(Globale.PemainAktif, 100);\n\t\t\tSet Knockback Received(Globale.PemainAktif, 100);\n\t\t\tEnable Movement Collision With Players(Globale.PemainAktif);\n\t\tEnd;\n\t\tStop Accelerating(Globale.PemainAktif);\n\t\tSet Move Speed(Globale.PemainAktif, 100);\n\t\tSet Jump Vertical Speed(Globale.PemainAktif, 100);\n\t\tSet Projectile Speed(Globale.PemainAktif, 100);\n\t\tSet Gravity(Globale.PemainAktif, 100);\n\t\tGlobale.PemainAktif.KartuNasibAktif = False;\n\t\tGlobale.PemainAktif.PutaranKartuNasib = 0;\n\t\tGlobale.PemainAktif.JedaKartuNasib = 0;\n\t\tGlobale.PemainAktif.EfekNasib = 0;\n\t\tGlobale.PemainAktif.EfekNasibBerakhir = 0;\n\t\tGlobale.PemainAktif.PrivasiNasibAktif = False;\n\t\tGlobale.PemainAktif.WaktuBakarNasibBerikut = 0;\n\t\tGlobale.PemainAktif.WaktuPutaranNasibBerikut = 0;\n\t\tGlobale.PemainAktif.WaktuIkonNasibBerakhir = 0;\n\t\tGlobale.PemainAktif.WaktuPaksaBerikut = 0;\n\t\tGlobale.PemainAktif.WaktuPaksaBerakhir = 0;\n\t\tGlobale.PemainAktif.MenuNasibHarusDibuka = False;\n\t\tGlobale.PemainAktif.KebalAktif = Globale.PemainAktif.ModeKebal != 0;\n\t\tGlobale.PemainAktif.InputMenuDikunci = False;\n\t\tGlobale.PemainAktif.PerintahMenu = 0;\n\t\tAllow Button(Globale.PemainAktif, Button(Primary Fire));\n\t\tAllow Button(Globale.PemainAktif, Button(Secondary Fire));\n\t\tAllow Button(Globale.PemainAktif, Button(Interact));\n\t\tAllow Button(Globale.PemainAktif, Button(Reload));\n\t\tAllow Button(Globale.PemainAktif, Button(Ability 1));\n\t\tAllow Button(Globale.PemainAktif, Button(Ability 2));\n\t\tAllow Button(Globale.PemainAktif, Button(Ultimate));\n\t}\n}\n\nregola("98c - Subrutin: Segarkan daftar target publik untuk Event Player")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tSegarkanTargetPublikPemain;\n\t}\n\n\tazioni\n\t{\n\t\tEvent Player.DaftarTargetInspeksi = Filtered Array(All Players(All Teams), And(Current Array Element != Event Player, And(Entity Exists(Current Array Element), And(Is Alive(Current Array Element), Or(Is Dummy Bot(Current Array Element) == True, Or(Player Variable(Current Array Element, BotOtomatis) == True, And(Player Variable(Current Array Element, Manusia) == True, Player Variable(Current Array Element, PrivasiInspeksiAktif) == False)))))));\n\t}\n}\n\nregola("98d - Subrutin: Segarkan daftar target publik untuk pemain aktif global")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tSegarkanTargetPublikAktif;\n\t}\n\n\tazioni\n\t{\n\t\tAbort If(Or(Globale.PemainAktif == Null, Entity Exists(Globale.PemainAktif) == False));\n\t\tSet Player Variable(Globale.PemainAktif, DaftarTargetInspeksi, Filtered Array(All Players(All Teams), And(Current Array Element != Globale.PemainAktif, And(Entity Exists(Current Array Element), And(Is Alive(Current Array Element), Or(Is Dummy Bot(Current Array Element) == True, Or(Player Variable(Current Array Element, BotOtomatis) == True, And(Player Variable(Current Array Element, Manusia) == True, Player Variable(Current Array Element, PrivasiInspeksiAktif) == False))))))));\n\t}\n}\n\nregola("98e - Subrutin: Buat dummy sesuai tim aktif")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tBuatDummyTim;\n\t}\n\n\tazioni\n\t{\n\t\tCreate Dummy Bot(Tutti gli eroi, Globale.TimDummyAktif, -1, Position Of(First Of(Spawn Points(Globale.TimDummyAktif))), Vector(0, 0, 1));\n\t}\n}\n\nregola("98f - Subrutin: Lepas dummy sesuai tim aktif")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tLepasDummyTim;\n\t}\n\n\tazioni\n\t{\n\t\tAbort If(Count Of(Filtered Array(All Players(Globale.TimDummyAktif), Is Dummy Bot(Current Array Element) == True)) == 0);\n\t\tIf(Player Variable(First Of(Filtered Array(All Players(Globale.TimDummyAktif), Is Dummy Bot(Current Array Element) == True)), TeksVisiNasib) != Null);\n\t\t\tDestroy In-World Text(Player Variable(First Of(Filtered Array(All Players(Globale.TimDummyAktif), Is Dummy Bot(Current Array Element) == True)), TeksVisiNasib));\n\t\tEnd;\n\t\tStop Facing(First Of(Filtered Array(All Players(Globale.TimDummyAktif), Is Dummy Bot(Current Array Element) == True)));\n\t\tStop Throttle In Direction(First Of(Filtered Array(All Players(Globale.TimDummyAktif), Is Dummy Bot(Current Array Element) == True)));\n\t\tDestroy Dummy Bot(Globale.TimDummyAktif, Slot Of(First Of(Filtered Array(All Players(Globale.TimDummyAktif), Is Dummy Bot(Current Array Element) == True))));\n\t}\n}\n\nregola("98g - Subrutin: Teleportasi ke Spawn Room")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tTeleportKeSpawn;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Is In Spawn Room(Event Player) == True);\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("You are already in the Spawn Room. Mission accomplished.") : Event Player.IndeksBahasa == 1 ? Custom String("Kamu sudah di ruang muncul. Misi selesai.") : Custom String("คุณอยู่ในห้องเกิดแล้ว ภารกิจสำเร็จ"));\n\t\tElse If(Count Of(Spawn Points(Team Of(Event Player))) == 0);\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Spawn Room unavailable on this map right now.") : Event Player.IndeksBahasa == 1 ? Custom String("Ruang muncul tidak tersedia di map ini saat ini.") : Custom String("ห้องเกิดยังไม่พร้อมใช้งานบนแผนที่นี้"));\n\t\tElse;\n\t\t\tTeleport(Event Player, Position Of(First Of(Spawn Points(Team Of(Event Player)))));\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Teleported to your Spawn Room.") : Event Player.IndeksBahasa == 1 ? Custom String("Teleport ke ruang muncul timmu.") : Custom String("เทเลพอร์ตไปห้องเกิดของทีมแล้ว"));\n\t\tEnd;\n\t}\n}\n\nregola("98h - Subrutin: Teleportasi ke objektif mode aktif")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tTeleportKeObjektif;\n\t}\n\n\tazioni\n\t{\n\t\tEvent Player.PosisiTeleportTujuan = Vector(0, 0, 0);\n\t\tIf(Or(Current Game Mode == Game Mode(Trasporto), Current Game Mode == Game Mode(Ibrida)));\n\t\t\tIf(Distance Between(Payload Position, Vector(0, 0, 0)) > 0.100);\n\t\t\t\tEvent Player.PosisiTeleportTujuan = Payload Position + Vector(2, 0, 0);\n\t\t\tEnd;\n\t\tElse If(Current Game Mode == Game Mode(Cattura la Bandiera));\n\t\t\tIf(Distance Between(Flag Position(Opposite Team Of(Team Of(Event Player))), Vector(0, 0, 0)) > 0.100);\n\t\t\t\tEvent Player.PosisiTeleportTujuan = Flag Position(Opposite Team Of(Team Of(Event Player))) + Vector(2, 0, 0);\n\t\t\tEnd;\n\t\tElse If(Current Game Mode == Game Mode(Scorta));\n\t\t\tIf(Count Of(Filtered Array(All Players(All Teams), And(Has Spawned(Current Array Element) == True, And(Is Alive(Current Array Element) == True, Is On Objective(Current Array Element) == True)))) > 0);\n\t\t\t\tEvent Player.PosisiTeleportTujuan = Position Of(First Of(Filtered Array(All Players(All Teams), And(Has Spawned(Current Array Element) == True, And(Is Alive(Current Array Element) == True, Is On Objective(Current Array Element) == True))))) + Vector(2, 0, 0);\n\t\t\tElse If(Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) > 0.100);\n\t\t\t\tEvent Player.PosisiTeleportTujuan = Objective Position(Objective Index);\n\t\t\tEnd;\n\t\tElse If(Or(Or(Current Game Mode == Game Mode(Punto Critico), Current Game Mode == Game Mode(Controllo)), Or(Current Game Mode == Game Mode(Scontro), Current Game Mode == Game Mode(Conquista))));\n\t\t\tIf(Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) > 0.100);\n\t\t\t\tEvent Player.PosisiTeleportTujuan = Objective Position(Objective Index);\n\t\t\tEnd;\n\t\tElse If(Distance Between(Objective Position(Objective Index), Vector(0, 0, 0)) > 0.100);\n\t\t\tEvent Player.PosisiTeleportTujuan = Objective Position(Objective Index);\n\t\tEnd;\n\t\tIf(Distance Between(Event Player.PosisiTeleportTujuan, Vector(0, 0, 0)) <= 0.100);\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Objective position unavailable right now.") : Event Player.IndeksBahasa == 1 ? Custom String("Posisi objektif belum tersedia saat ini.") : Custom String("ตำแหน่งเป้าหมายยังไม่พร้อมใช้งานตอนนี้"));\n\t\t\tAbort;\n\t\tEnd;\n\t\tCall Subroutine(CariPosisiTeleportAman);\n\t\tIf(Distance Between(Event Player.PosisiBangkitAman, Vector(0, 0, 0)) <= 0.100);\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("No safe walkable position was found near the objective.") : Event Player.IndeksBahasa == 1 ? Custom String("Tidak ada posisi aman yang bisa dilalui dekat objektif.") : Custom String("ไม่พบตำแหน่งที่ปลอดภัยและเดินได้ใกล้เป้าหมาย"));\n\t\t\tAbort;\n\t\tEnd;\n\t\tTeleport(Event Player, Event Player.PosisiBangkitAman);\n\t\tIf(Or(Current Game Mode == Game Mode(Trasporto), Current Game Mode == Game Mode(Ibrida)));\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Teleported near the payload.") : Event Player.IndeksBahasa == 1 ? Custom String("Teleport dekat payload.") : Custom String("เทเลพอร์ตใกล้เพย์โหลดแล้ว"));\n\t\tElse If(Current Game Mode == Game Mode(Cattura la Bandiera));\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Teleported near the enemy flag.") : Event Player.IndeksBahasa == 1 ? Custom String("Teleport dekat bendera musuh.") : Custom String("เทเลพอร์ตใกล้ธงของศัตรูแล้ว"));\n\t\tElse If(Current Game Mode == Game Mode(Scorta));\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Teleported near the Push objective.") : Event Player.IndeksBahasa == 1 ? Custom String("Teleport dekat objektif Push.") : Custom String("เทเลพอร์ตใกล้เป้าหมาย Push แล้ว"));\n\t\tElse;\n\t\t\tSmall Message(Event Player, Event Player.IndeksBahasa == 0 ? Custom String("Teleported near the current objective.") : Event Player.IndeksBahasa == 1 ? Custom String("Teleport dekat objektif saat ini.") : Custom String("เทเลพอร์ตใกล้เป้าหมายปัจจุบันแล้ว"));\n\t\tEnd;\n\t}\n}\n\nregola("98i - Subrutin: Teleportasi ke target pemain")\n{\n\tevento\n\t{\n\t\tSubroutine;\n\t\tTeleportKeTarget;\n\t}\n\n\tazioni\n\t{\n\t\tIf(Or(Or(Event Player.TargetTeleportasiTerkunci == Null, Entity Exists(Event Player.TargetTeleportasiTerkunci) == False), Or(Is Alive(Event Player.TargetTeleportasiTerkunci) == False, Array Contains(Event Player.Da